 namespace dxmt {
 
+/* Ember S2 (10-27): UpdateSubresource into a STAGING resource.  Upstream
+ * blits the data into the staging buffer on the GPU timeline; d11check 26
+ * (STAGING + UpdateSubresource + Map(READ)) reads 0 through Neptune with
+ * it.  Ember's Wine DXMT writes it on the CPU through Map(WRITE) instead
+ * (48/48 there): Map waits for / renames around earlier GPU use, so the
+ * result is ordered the same way.  Default = CPU path;
+ * DXMT_STAGING_UPDATE_BLIT=1 restores the upstream blit for A/B.  A context
+ * whose Map refuses (deferred) still takes the blit. */
+static inline bool
+ember_staging_update_cpu() {
+  static int v = -1;
+  if (v < 0) {
+    const char *e = std::getenv("DXMT_STAGING_UPDATE_BLIT");
+    v = !(e && e[0] == '1');
+  }
+  return v != 0;
+}
