+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "dxn_private.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+
+static dxn_log_fn log_fn;
+static void *log_user;
+
+void
+dxn_set_log_callback(dxn_log_fn fn, void *user)
+{
+    log_user = user;
+    log_fn = fn;
+}
