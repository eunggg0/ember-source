@@ -0,0 +1,53 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Descriptor prefix validation and the version query.
+ */
+
+#include "directx-native/directx_native.h"
+
+#include <string.h>
+
+#include "dxn_test.h"
+
+int
+main(void)
+{
+    CHECK(dxn_abi_version() == DXN_ABI_VERSION);
+
+    dxn_shared_texture t;
+    memset(&t, 0, sizeof(t));
+    DXN_SHARED_INIT(&t, DXN_SHARED_TEXTURE_MAGIC);
+    t.fd = -1;
+    CHECK(t.struct_size == sizeof(t));
+    CHECK(dxn_shared_check(&t, DXN_SHARED_TEXTURE_MAGIC, sizeof(t)));
+    CHECK(!dxn_shared_check(&t, DXN_SHARED_FENCE_MAGIC, sizeof(t)));
+    CHECK(!dxn_shared_check(NULL, DXN_SHARED_TEXTURE_MAGIC, sizeof(t)));
+    CHECK(dxn_shared_type(&t) == DXN_SHARED_TEXTURE_MAGIC);
+
+    t.version = DXN_SHARED_VERSION + 1;
+    CHECK(!dxn_shared_check(&t, DXN_SHARED_TEXTURE_MAGIC, sizeof(t)));
+    CHECK(dxn_shared_type(&t) == 0);
+    t.version = DXN_SHARED_VERSION;
+    t.struct_size -= 8;
+    CHECK(!dxn_shared_check(&t, DXN_SHARED_TEXTURE_MAGIC, sizeof(t)));
+    CHECK(dxn_shared_type(&t) == 0);
+
+    dxn_shared_fence f;
+    memset(&f, 0, sizeof(f));
+    DXN_SHARED_INIT(&f, DXN_SHARED_FENCE_MAGIC);
+    CHECK(dxn_shared_type(&f) == DXN_SHARED_FENCE_MAGIC);
+    /* A fence must not pass as a texture even with the right magic. */
+    f.magic = DXN_SHARED_TEXTURE_MAGIC;
+    CHECK(dxn_shared_type(&f) == 0);
+
+    dxn_shared_buffer b;
+    memset(&b, 0, sizeof(b));
+    DXN_SHARED_INIT(&b, DXN_SHARED_BUFFER_MAGIC);
+    CHECK(dxn_shared_type(&b) == DXN_SHARED_BUFFER_MAGIC);
+
+    uint32_t junk[4] = { 0x12345678u, DXN_SHARED_VERSION, 16, 0 };
+    CHECK(dxn_shared_type(junk) == 0);
+    return 0;
+}
diff --git a/subprojects/directx-native/tests/test_shm.c b/subprojects/directx-native/tests/test_shm.c
new file mode 100644
index 0000000..0fb0f2f
--- /dev/null
+++ b/subprojects/directx-native/tests/test_shm.c
@@ -0,0 +1,78 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Anonymous shm creation, page granularity and windowed mapping.
+ */
+
+#include "directx-native/dxn_shm.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "dxn_test.h"
+
+int
+main(void)
+{
+    const size_t page = dxn_shm_page_size();
+    CHECK(page >= 4096 && (page & (page - 1)) == 0);
+#ifdef __APPLE__
+    CHECK(page >= 16384);
+#endif
+    CHECK(dxn_shm_page_align(0) == 0);
+    CHECK(dxn_shm_page_align(1) == page);
+    CHECK(dxn_shm_page_align(page) == page);
+    CHECK(dxn_shm_page_align(page + 1) == 2 * page);
+
+    const uint64_t size = 3 * page;
+    int fd = dxn_shm_create(size);
+    CHECK(fd >= 0);
+    CHECK(fcntl(fd, F_GETFD) & FD_CLOEXEC);
+    struct stat st;
+    CHECK(fstat(fd, &st) == 0 && (uint64_t)st.st_size == size);
+
+    /* Two creates never collide. */
+    int fd2 = dxn_shm_create(page);
+    CHECK(fd2 >= 0 && fd2 != fd);
+
+    dxn_shm_mapping whole, window;
+    CHECK(dxn_shm_map(fd, 0, size, &whole) == 0);
+    CHECK(whole.ptr == whole.base && whole.length == size);
+    for (uint64_t i = 0; i < size; i++)
+        CHECK(((uint8_t *)whole.ptr)[i] == 0);
+    memset(whole.ptr, 0xab, size);
+    ((uint8_t *)whole.ptr)[page + 100] = 0x5a;
+
+    /* An unaligned window maps from its page floor. */
+    CHECK(dxn_shm_map(fd, page + 100, 16, &window) == 0);
+    CHECK((uint8_t *)window.ptr - (uint8_t *)window.base == 100);
+    CHECK(window.length == page);
+    CHECK(*(uint8_t *)window.ptr == 0x5a);
+    *(uint8_t *)window.ptr = 0x33;
+    CHECK(((uint8_t *)whole.ptr)[page + 100] == 0x33);
+    dxn_shm_unmap(&window);
+    CHECK(window.base == NULL);
+    dxn_shm_unmap(&window); /* no-op */
+
+    /* Windows past the object fail instead of faulting later. */
+    errno = 0;
+    CHECK(dxn_shm_map(fd, 2 * page, page + 1, &window) == -1 &&
+          errno == EINVAL);
+    CHECK(dxn_shm_map(fd, 0, 0, &window) == -1);
+    CHECK(dxn_shm_map(fd, UINT64_MAX - 1, 4, &window) == -1);
+    CHECK(dxn_shm_map(-1, 0, 4, &window) == -1);
+
+#ifdef __linux__
+    /* The memfd is sealed against shrinking (udmabuf requirement). */
+    CHECK(ftruncate(fd, page) != 0);
+#endif
+
+    dxn_shm_unmap(&whole);
+    close(fd2);
+    close(fd);
+    return 0;
+}
