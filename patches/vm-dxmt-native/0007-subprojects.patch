diff --git a/subprojects/directx-native/src/dxn_shm.c b/subprojects/directx-native/src/dxn_shm.c
new file mode 100644
index 0000000..b2602ed
--- /dev/null
+++ b/subprojects/directx-native/src/dxn_shm.c
@@ -0,0 +1,61 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Platform-neutral half of dxn_shm.h: alignment and mapping.
+ */
+
+#include "directx-native/dxn_shm.h"
+
+#include <errno.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+uint64_t
+dxn_shm_page_align(uint64_t n)
+{
+    const uint64_t page = (uint64_t)dxn_shm_page_size();
+    return (n + page - 1) & ~(page - 1);
+}
+
+int
+dxn_shm_map(int fd, uint64_t offset, uint64_t size, dxn_shm_mapping *out)
+{
+    memset(out, 0, sizeof(*out));
+    if (fd < 0 || size == 0 || offset + size < offset) {
+        errno = EINVAL;
+        return -1;
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0)
+        return -1;
+    if (st.st_size < 0 || offset + size > (uint64_t)st.st_size) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    const uint64_t page = (uint64_t)dxn_shm_page_size();
+    const uint64_t floor = offset & ~(page - 1);
+    const uint64_t length = dxn_shm_page_align(offset - floor + size);
+    if (length > (uint64_t)SIZE_MAX) {
+        errno = EINVAL;
+        return -1;
+    }
+    void *base = mmap(NULL, (size_t)length, PROT_READ | PROT_WRITE, MAP_SHARED,
+                      fd, (off_t)floor);
+    if (base == MAP_FAILED)
+        return -1;
+    out->base = base;
+    out->length = (size_t)length;
+    out->ptr = (uint8_t *)base + (offset - floor);
+    return 0;
+}
+
+void
+dxn_shm_unmap(dxn_shm_mapping *mapping)
+{
+    if (mapping->base)
+        munmap(mapping->base, mapping->length);
+    memset(mapping, 0, sizeof(*mapping));
+}
diff --git a/subprojects/directx-native/src/dxn_shm_darwin.c b/subprojects/directx-native/src/dxn_shm_darwin.c
new file mode 100644
index 0000000..b5a3da0
--- /dev/null
+++ b/subprojects/directx-native/src/dxn_shm_darwin.c
@@ -0,0 +1,100 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Anonymous POSIX shm objects (macOS).
+ */
+
+#include "directx-native/dxn_shm.h"
+
+#include "dxn_private.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+/* PSHMNAMLEN (the shm name limit) lives in <sys/posix_shm.h>, which only
+ * the macOS SDK ships; the iOS-family SDKs share the same kernel limit. */
+#if __has_include(<sys/posix_shm.h>)
+#include <sys/posix_shm.h>
+#endif
+#ifndef PSHMNAMLEN
+#define PSHMNAMLEN 31
+#endif
+
+/* Apple Silicon pages are 16 KiB; see dxn_shm.h for Rosetta. */
+#define MIN_PAGE_SIZE 16384u
+
+/* An app group prefix must leave room for "/", a slot digit and one nonce
+ * digit within PSHMNAMLEN. */
+#define APP_SANDBOX_GROUP_ID_MAX (PSHMNAMLEN - 3)
+
+size_t
+dxn_shm_page_size(void)
+{
+    size_t pg = (size_t)getpagesize();
+    return pg < MIN_PAGE_SIZE ? MIN_PAGE_SIZE : pg;
+}
+
+int
+dxn_shm_create(uint64_t size)
+{
+    if (size > (uint64_t)INT64_MAX) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    /* Under App Sandbox a shm name must live in the app group container,
+     * i.e. be prefixed with the group identifier instead of '/'; anything
+     * else is denied.  The PSHMNAMLEN budget then leaves no room for a tag
+     * or the pid, so the name is just a slot digit plus as much of the
+     * nonce as fits. */
+    const char *group = getenv("APP_SANDBOX_GROUP_ID");
+    if (group && !group[0])
+        group = NULL;
+    if (group && strlen(group) > APP_SANDBOX_GROUP_ID_MAX) {
+        DXN_ERROR("shm: APP_SANDBOX_GROUP_ID is %zu chars, at most %d fit",
+                  strlen(group), (int)APP_SANDBOX_GROUP_ID_MAX);
+        errno = EINVAL;
+        return -1;
+    }
+
+    const size_t nonce_room = group ? PSHMNAMLEN - strlen(group) - 2 : 8;
+    const unsigned nonce_digits = (unsigned)(nonce_room < 8 ? nonce_room : 8);
+    const unsigned nonce = arc4random() >> (32 - 4 * nonce_digits);
+    int fd = -1;
+    /* A sandboxed slot must stay a single hex digit to fit the name. */
+    const unsigned slots = group ? 16 : 32;
+    for (unsigned i = 0; i < slots; i++) {
+        char name[PSHMNAMLEN + 1];
+        if (group)
+            snprintf(name, sizeof(name), "%s/%x%0*x", group, i,
+                     (int)nonce_digits, nonce);
+        else
+            snprintf(name, sizeof(name), "/dxn-%d-%x-%x", (int)getpid(),
+                     nonce, i);
+        fd = shm_open(name, O_CREAT | O_EXCL | O_RDWR, 0600);
+        if (fd >= 0) {
+            shm_unlink(name); /* anonymous from here on */
+            break;
+        }
+        if (errno != EEXIST)
+            return -1;
+    }
+    if (fd < 0)
+        return -1;
+
+    int fdflags = fcntl(fd, F_GETFD);
+    if (fdflags < 0 || fcntl(fd, F_SETFD, fdflags | FD_CLOEXEC) < 0 ||
+        ftruncate(fd, (off_t)size) != 0) {
+        const int saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    return fd;
+}
diff --git a/subprojects/directx-native/src/dxn_shm_linux.c b/subprojects/directx-native/src/dxn_shm_linux.c
new file mode 100644
index 0000000..6478627
--- /dev/null
+++ b/subprojects/directx-native/src/dxn_shm_linux.c
@@ -0,0 +1,41 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Anonymous shared memory (Linux): sealed memfds.
+ */
+
+#include "directx-native/dxn_shm.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+size_t
+dxn_shm_page_size(void)
+{
+    return (size_t)sysconf(_SC_PAGESIZE);
+}
+
+int
+dxn_shm_create(uint64_t size)
+{
+    if (size > (uint64_t)INT64_MAX) {
+        errno = EINVAL;
+        return -1;
+    }
+    int fd = memfd_create("dxn-shm", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    if (fd < 0)
+        return -1;
+    /* udmabuf refuses a memfd that could shrink under its pages. */
+    if (ftruncate(fd, (off_t)size) != 0 ||
+        fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK) != 0) {
+        const int saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    return fd;
+}
