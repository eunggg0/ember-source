+
+/* libsystem_kernel; the same calls libc++ uses for std::atomic::wait.  The
+ * SHARED variant keys the wait on the VM object, so it works across
+ * processes on a MAP_SHARED mapping. */
+extern "C" int __ulock_wait(uint32_t operation, void *addr, uint64_t value, uint32_t timeout_us);
+extern "C" int __ulock_wake(uint32_t operation, void *addr, uint64_t wake_value);
+#define XSYNC_UL_COMPARE_AND_WAIT_SHARED 3u
+#define XSYNC_ULF_WAKE_ALL 0x00000100u
+#define XSYNC_ULF_NO_ERRNO 0x01000000u
+#define XSYNC_ENABLED 1
+#else
+#define XSYNC_ENABLED 0
+#endif
+
+namespace dxmt {
+
+uint64_t
+XSyncNowNs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+int
+XSyncPid() {
+#if XSYNC_ENABLED
+  return (int)getpid();
+#else
+  return 0;
+#endif
+}
+
+static std::atomic<XSyncGpuErrorCallback> g_gpu_error_cb{nullptr};
+static std::atomic<void *> g_gpu_error_user{nullptr};
+
+void
+XSyncSetGpuErrorCallback(XSyncGpuErrorCallback cb, void *user) {
+  g_gpu_error_user.store(user, std::memory_order_release);
+  g_gpu_error_cb.store(cb, std::memory_order_release);
+}
+
+/* This process's attached slots (cycle check, GPU-error quarantine). */
+static std::mutex g_slots_mutex;
+static std::vector<XSyncSlot *> g_slots;
+
+static void xsync_quarantine(XSyncPageShm *page, uint64_t until_ns);
+
+void
+XSyncReportGpuError(uint64_t frame, const char *description) {
+  /* A GPU error (hang, victim, ignored) makes this process's completion
+   * timing meaningless for a while: stop others (and us) from GPU-waiting on
+   * our textures so a recovering GPU cannot cascade into the guest. */
+  const uint32_t q = XSyncGetConfig().gpu_error_quarantine_ms;
+  if (q && XSyncGetConfig().mode != XSyncOff) {
+    const uint64_t until = XSyncNowNs() + (uint64_t)q * 1000000ull;
+    std::lock_guard<std::mutex> lock(g_slots_mutex);
+    for (auto *slot : g_slots)
+      xsync_quarantine(slot->page, until);
+  }
+  auto cb = g_gpu_error_cb.load(std::memory_order_acquire);
+  if (cb)
+    cb(g_gpu_error_user.load(std::memory_order_acquire), frame, description ? description : "");
+}
+
+bool
+XSyncGpuErrorSignalEnabled() {
+  static const bool enabled = env::getEnvVar("NPT_GPU_ERROR_SIGNAL") != "0";
+  return enabled;
+}
+
+static uint32_t
+xsync_env_u32(const char *name, uint32_t def, uint32_t lo, uint32_t hi) {
+  std::string v = env::getEnvVar(name);
+  if (v.empty())
+    return def;
+  char *end = nullptr;
+  unsigned long x = strtoul(v.c_str(), &end, 10);
+  if (end == v.c_str())
+    return def;
+  return (uint32_t)std::clamp<unsigned long>(x, lo, hi);
+}
+
+const XSyncConfig &
+XSyncGetConfig() {
+  static const XSyncConfig config = []() {
+    XSyncConfig c{};
+    std::string m = env::getEnvVar("NPT_SHARED_ORDER");
+    if (m.empty() || m == "1" || m == "on" || m == "both")
+      c.mode = XSyncBoth;
+    else if (m == "war")
+      c.mode = XSyncWAR;
+    else if (m == "raw")
+      c.mode = XSyncRAW;
+    else
+      c.mode = XSyncOff;
+#if !XSYNC_ENABLED
+    c.mode = XSyncOff;
+#endif
+    c.timeout_ms = xsync_env_u32("NPT_SHARED_ORDER_TIMEOUT_MS", 100, 5, 5000);
+    c.quarantine_ms = xsync_env_u32("NPT_SHARED_ORDER_QUARANTINE_MS", 1000, 0, 60000);
+    c.gpu_error_quarantine_ms = xsync_env_u32("NPT_SHARED_ORDER_GPUERR_MS", 2000, 0, 60000);
+    c.log_s = xsync_env_u32("NPT_SHARED_ORDER_LOG_S", 10, 0, 3600);
+    WARN("Ember sharedorder-1030: pid=", XSyncPid(), " mode=",
+         c.mode == XSyncBoth  ? "war+raw"
+         : c.mode == XSyncWAR ? "war"
+         : c.mode == XSyncRAW ? "raw"
+                              : "off",
+         " timeout_ms=", c.timeout_ms, " quarantine_ms=", c.quarantine_ms, " gpuerr_ms=",
+         c.gpu_error_quarantine_ms, " log_s=", c.log_s, " (v2)");
+    return c;
+  }();
+  return config;
+}
+
+uint64_t
+XSyncExporterExtraBytes(uint64_t page_size) {
+  if (XSyncGetConfig().mode == XSyncOff)
+    return 0;
+  return page_size;
+}
+
+#if XSYNC_ENABLED
+
+static std::atomic<uint32_t> g_owner_serial{0};
+
+static void
+xsync_quarantine(XSyncPageShm *page, uint64_t until_ns) {
+  uint64_t cur = page->quarantine_until_ns.load(std::memory_order_relaxed);
+  while (cur < until_ns &&
+         !page->quarantine_until_ns.compare_exchange_weak(cur, until_ns, std::memory_order_relaxed)) {
+  }
+}
+
+static inline bool
+xsync_owner_dead(uint64_t owner) {
+  pid_t pid = (pid_t)(owner >> 32);
+  if (pid <= 0)
+    return true;
+  if (pid == getpid())
+    return false;
+  return kill(pid, 0) != 0 && errno == ESRCH;
+}
+
+static inline void
+xsync_wake(XSyncPageShm *page) {
+  if (page->waiters.load(std::memory_order_seq_cst) == 0)
+    return;
+  page->wake.fetch_add(1, std::memory_order_seq_cst);
+  __ulock_wake(XSYNC_UL_COMPARE_AND_WAIT_SHARED | XSYNC_ULF_WAKE_ALL | XSYNC_ULF_NO_ERRNO, &page->wake, 0);
+}
+
+/* Mark every issued command buffer of the lane done (released or dead owner). */
+static inline void
+xsync_lane_settle(XSyncLaneShm &lane) {
+  lane.r_done.store(lane.r_issued.load(std::memory_order_acquire), std::memory_order_release);
+  lane.w_done.store(lane.w_issued.load(std::memory_order_acquire), std::memory_order_release);
+}
+
+XSyncSlot *
+XSyncAttach(int fd, uint64_t surface_map_size, uint64_t page_size, bool exporter, uint32_t width, uint32_t height,
+            uint32_t stride, uint32_t format) {
+  if (XSyncGetConfig().mode == XSyncOff || fd < 0 || !page_size || (surface_map_size % page_size))
+    return nullptr;
+
+  struct stat st;
+  if (fstat(fd, &st) != 0 || (uint64_t)st.st_size < surface_map_size + page_size) {
+    /* An exporter without the feature (or an older library): no sync page. */
+    return nullptr;
+  }
+
+  void *base = mmap(nullptr, page_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, (off_t)surface_map_size);
+  if (base == MAP_FAILED) {
+    WARN("sharedorder: sync page mmap failed: ", errno);
+    return nullptr;
+  }
+  auto page = reinterpret_cast<XSyncPageShm *>(base);
+
+  if (exporter) {
+    /* Fresh shm is zero-filled; lanes start free with zero counters. */
+    page->version = kXSyncVersion;
+    page->surface_bytes = surface_map_size;
+    page->width = width;
+    page->height = height;
+    page->stride = stride;
+    page->format = format;
+    page->creator_pid = (uint32_t)getpid();
+    page->page_id = ((uint64_t)(uint32_t)getpid() << 32) ^ XSyncNowNs() ^ (uint64_t)(uintptr_t)base;
+    if (!page->page_id)
+      page->page_id = 1;
+    page->magic.store(kXSyncMagic, std::memory_order_release);
+  } else {
+    if (page->magic.load(std::memory_order_acquire) != kXSyncMagic || page->version != kXSyncVersion ||
+        page->surface_bytes != surface_map_size || page->width != width || page->height != height ||
+        page->stride != stride) {
+      WARN("sharedorder: shm object has no matching sync page (", width, "x", height, " stride=", stride,
+           "); texture stays unordered");
+      munmap(base, page_size);
+      return nullptr;
+    }
+  }
+
+  const uint64_t owner = ((uint64_t)(uint32_t)getpid() << 32) |
+                         (uint64_t)(g_owner_serial.fetch_add(1, std::memory_order_relaxed) + 1);
+  int lane = -1;
+  for (unsigned pass = 0; pass < 2 && lane < 0; pass++) {
+    for (unsigned i = 0; i < kXSyncLanes; i++) {
+      auto &l = page->lanes[i];
+      uint64_t cur = l.owner.load(std::memory_order_acquire);
+      if (pass == 0) {
+        if (cur != 0)
+          continue;
+        if (l.owner.compare_exchange_strong(cur, owner, std::memory_order_acq_rel)) {
+          lane = (int)i;
+          break;
+        }
+      } else {
+        /* Second pass: reclaim lanes whose owner process is gone. */
+        if (cur == 0 || !xsync_owner_dead(cur))
+          continue;
+        if (l.owner.compare_exchange_strong(cur, owner, std::memory_order_acq_rel)) {
+          xsync_lane_settle(l);
+          lane = (int)i;
+          WARN("sharedorder: reclaimed lane ", i, " of dead pid ", (int)(cur >> 32));
+          break;
+        }
+      }
+    }
+  }
+  if (lane < 0) {
+    WARN("sharedorder: no free lane (", kXSyncLanes, "), texture stays unordered");
+    munmap(base, page_size);
+    return nullptr;
+  }
+
+  auto slot = new XSyncSlot();
+  slot->page = page;
+  slot->map_base = base;
+  slot->map_len = page_size;
+  slot->lane = (unsigned)lane;
+  slot->owner = owner;
+  slot->exporter = exporter;
+  {
+    std::lock_guard<std::mutex> lock(g_slots_mutex);
+    g_slots.push_back(slot);
+  }
+  return slot;
+}
+
+void
+XSyncRelease(XSyncSlot *slot) {
+  if (!slot)
+    return;
+  {
+    std::lock_guard<std::mutex> lock(g_slots_mutex);
+    std::erase(g_slots, slot);
+  }
+  auto &l = slot->page->lanes[slot->lane];
+  l.blk_since_ns.store(0, std::memory_order_release);
+  xsync_lane_settle(l);
+  uint64_t expect = slot->owner;
+  l.owner.compare_exchange_strong(expect, 0, std::memory_order_acq_rel);
+  xsync_wake(slot->page);
+  munmap(slot->map_base, slot->map_len);
+  delete slot;
+}
+
+void
+XSyncPublish(std::vector<XSyncTicket> &tickets) {
+  XSyncPageShm *last_page = nullptr;
+  for (auto &t : tickets) {
+    auto &l = t.slot->page->lanes[t.slot->lane];
+    auto &done = t.write ? l.w_done : l.r_done;
+    /* Single writer per lane (its queue's finish thread), commit order. */
+    if (done.load(std::memory_order_relaxed) < t.value)
+      done.store(t.value, std::memory_order_release);
+    l.last_publish_ns.store(XSyncNowNs(), std::memory_order_relaxed);
+    if (t.slot->page != last_page) {
+      if (last_page)
+        xsync_wake(last_page);
+      last_page = t.slot->page;
+    }
+  }
+  if (last_page)
+    xsync_wake(last_page);
+  tickets.clear();
+}
+
+int
+XSyncCollectWaits(const XSyncAccess &access, int mode, std::vector<XSyncWaitItem> &out) {
+  auto page = access.slot->page;
+  if (XSyncPageQuarantined(page, XSyncNowNs()))
+    return 1;
+  for (unsigned i = 0; i < kXSyncLanes; i++) {
+    if (i == access.slot->lane)
+      continue;
+    auto &l = page->lanes[i];
+    uint64_t owner = l.owner.load(std::memory_order_acquire);
+    if (!owner)
+      continue;
+    for (int kind = 0; kind < 2; kind++) {
+      /* kind 0: WAR (we write, wait their reads); kind 1: RAW (we read, wait their writes) */
+      if (kind == 0 && !((access.rw & 2) && (mode & XSyncWAR)))
+        continue;
+      if (kind == 1 && !((access.rw & 1) && (mode & XSyncRAW)))
+        continue;
+      auto &issued = kind == 0 ? l.r_issued : l.w_issued;
+      auto &done = kind == 0 ? l.r_done : l.w_done;
+      uint64_t target = issued.load(std::memory_order_seq_cst);
+      if (done.load(std::memory_order_acquire) >= target)
+        continue;
+      bool merged = false;
+      for (auto &it : out) {
+        if (it.page == page && it.lane == i && it.write == (uint8_t)kind) {
+          it.target = std::max(it.target, target);
+          merged = true;
+          break;
+        }
+      }
+      if (!merged)
+        out.push_back({page, i, (uint8_t)kind, owner, target});
+    }
+  }
+  return 0;
+}
+
+void
+XSyncAssignTickets(const XSyncAccess &access, std::vector<XSyncTicket> &out) {
+  auto &l = access.slot->page->lanes[access.slot->lane];
+  if (access.rw & 1)
+    out.push_back({access.slot, 0, l.r_issued.fetch_add(1, std::memory_order_seq_cst) + 1});
+  if (access.rw & 2)
+    out.push_back({access.slot, 1, l.w_issued.fetch_add(1, std::memory_order_seq_cst) + 1});
+}
