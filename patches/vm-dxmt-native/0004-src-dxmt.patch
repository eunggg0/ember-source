+
+/* ---- vmzero-1031 ---------------------------------------------------- */
+
+static int
+xsync_env_int(const char *name, int def) {
+  const char *v = getenv(name);
+  return v && *v ? atoi(v) : def;
+}
+
+bool
+XSyncDeadCopyEnabled() {
+  static std::atomic<int> on{-1};
+  static std::atomic<uint64_t> next_ns{0};
+  static const char *ctl = getenv("EMBER_VMZ_CTL");
+  int v = on.load(std::memory_order_relaxed);
+  if (v < 0) {
+    v = xsync_env_int("EMBER_VMZ_DEADCOPY", 0) != 0;
+    on.store(v, std::memory_order_relaxed);
+  }
+  if (ctl && *ctl) {
+    const uint64_t now = XSyncNowNs();
+    if (now >= next_ns.load(std::memory_order_relaxed)) {
+      next_ns.store(now + 1000000000ull, std::memory_order_relaxed);
+      if (FILE *f = fopen(ctl, "r")) {
+        char line[128];
+        while (fgets(line, sizeof(line), f)) {
+          if (!strncmp(line, "EMBER_VMZ_DEADCOPY=", 19)) {
+            int nv = atoi(line + 19) != 0;
+            if (nv != v) {
+              WARN("Ember vmzero: pid=", XSyncPid(), " dead copy skip ", nv ? "on" : "off");
+              v = nv;
+              on.store(nv, std::memory_order_relaxed);
+            }
+          }
+        }
+        fclose(f);
+      }
+    }
+  }
+  return v != 0;
+}
+
+bool
+XSyncCopyIsDead(const XSyncSlot *dst, const XSyncSlot *src) {
+  /* The ring's source is itself a shared swap chain buffer.  Any local read of
+   * the destination means it is a real texture, whatever else it looks like. */
+  if (!dst || !src || !dst->exporter || dst->local_read)
+    return false;
+  for (unsigned i = 0; i < kXSyncLanes; i++) {
+    if (i != dst->lane && dst->page->lanes[i].owner.load(std::memory_order_acquire))
+      return false;
+  }
+  return true;
+}
+
+bool
+XSyncSurfaceWanted(uint32_t width, uint32_t height, bool bgra8, bool render_target) {
+  static const int on = xsync_env_int("EMBER_SCANOUT_SURF", 0);
+  return on && bgra8 && render_target && width >= 640 && height >= 480;
+}
+
+void *
+XSyncSurfaceCreate(uint32_t width, uint32_t height, uint32_t stride, uint64_t need_bytes, uint32_t *out_id,
+                   void **out_base) {
+  const int w = (int)width, h = (int)height, bpe = 4, bpr = (int)stride;
+  const uint32_t fmt = 'BGRA';
+  const void *keys[] = {kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfaceBytesPerRow,
+                        kIOSurfacePixelFormat, kIOSurfaceIsGlobal};
+  CFNumberRef nw = CFNumberCreate(nullptr, kCFNumberIntType, &w), nh = CFNumberCreate(nullptr, kCFNumberIntType, &h),
+              ne = CFNumberCreate(nullptr, kCFNumberIntType, &bpe), nb = CFNumberCreate(nullptr, kCFNumberIntType, &bpr),
+              nf = CFNumberCreate(nullptr, kCFNumberSInt32Type, &fmt);
+  const void *values[] = {nw, nh, ne, nb, nf, kCFBooleanTrue};
+  CFDictionaryRef props = CFDictionaryCreate(nullptr, keys, values, 6, &kCFTypeDictionaryKeyCallBacks,
+                                             &kCFTypeDictionaryValueCallBacks);
+  IOSurfaceRef s = IOSurfaceCreate(props);
+  CFRelease(props);
+  CFRelease(nw);
+  CFRelease(nh);
+  CFRelease(ne);
+  CFRelease(nb);
+  CFRelease(nf);
+  if (!s)
+    return nullptr;
+  IOSurfaceLock(s, 0, nullptr);
+  void *base = IOSurfaceGetBaseAddress(s);
+  IOSurfaceUnlock(s, 0, nullptr);
+  if (!base || IOSurfaceGetBytesPerRow(s) != stride || IOSurfaceGetAllocSize(s) < need_bytes ||
+      ((uintptr_t)base & (getpagesize() - 1))) {
+    WARN("Ember vmzero: IOSurface ", width, "x", height, " stride ", stride, " unusable (bpr ",
+         (uint64_t)IOSurfaceGetBytesPerRow(s), " alloc ", (uint64_t)IOSurfaceGetAllocSize(s), ")");
+    CFRelease(s);
+    return nullptr;
+  }
+  *out_id = IOSurfaceGetID(s);
+  *out_base = base;
+  return (void *)s;
+}
+
+void *
+XSyncSurfaceLookup(uint32_t id, uint32_t width, uint32_t height, uint32_t stride, uint64_t need_bytes,
+                   void **out_base) {
+  IOSurfaceRef s = IOSurfaceLookup(id);
+  if (!s)
+    return nullptr;
+  IOSurfaceLock(s, 0, nullptr);
+  void *base = IOSurfaceGetBaseAddress(s);
+  IOSurfaceUnlock(s, 0, nullptr);
+  if (!base || IOSurfaceGetWidth(s) != width || IOSurfaceGetHeight(s) != height ||
+      IOSurfaceGetBytesPerRow(s) != stride || IOSurfaceGetAllocSize(s) < need_bytes) {
+    CFRelease(s);
+    return nullptr;
+  }
+  *out_base = base;
+  return (void *)s;
+}
+
+void
+XSyncSurfaceReleaseLater(void *surface) {
+  if (!surface)
+    return;
+  dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0),
+                   surface, [](void *s) { CFRelease((IOSurfaceRef)s); });
+}
+
+uint32_t
+XSyncPeekSurfaceId(int fd, uint64_t surface_map_size, uint64_t page_size) {
+  struct stat st;
+  if (fd < 0 || fstat(fd, &st) != 0 || (uint64_t)st.st_size < surface_map_size + page_size)
+    return 0;
+  void *base = mmap(nullptr, page_size, PROT_READ, MAP_SHARED, fd, (off_t)surface_map_size);
+  if (base == MAP_FAILED)
+    return 0;
+  auto page = reinterpret_cast<XSyncPageShm *>(base);
+  uint32_t id = 0;
+  if (page->magic.load(std::memory_order_acquire) == kXSyncMagic && page->version == kXSyncVersion &&
+      page->surface_bytes == surface_map_size)
+    id = page->surface_id;
+  munmap(base, page_size);
+  return id;
+}
+
+void
+XSyncBridge::noteGpuStart(uint64_t wait_value, uint64_t gpu_start_ns) {
+  const uint64_t sig = signaledAtRawNs(wait_value);
+  if (!sig || !gpu_start_ns || sig <= gpu_start_ns)
+    return;
+  const uint64_t us = (sig - gpu_start_ns) / 1000;
+  stats.gpu_stall_n.fetch_add(1, std::memory_order_relaxed);
+  stats.gpu_stall_us_total.fetch_add(us, std::memory_order_relaxed);
+  uint64_t prev = stats.gpu_stall_us_max.load(std::memory_order_relaxed);
+  while (us > prev && !stats.gpu_stall_us_max.compare_exchange_weak(prev, us, std::memory_order_relaxed)) {
+  }
+}
+
+XSyncBridge::XSyncBridge(WMT::Device device) : event_(device.newSharedEvent()) {
+  event_.signalValue(0);
+  thread_ = std::thread([this]() { run(); });
+}
+
+XSyncBridge::~XSyncBridge() {
+  shutdown();
+}
+
+uint64_t
+XSyncBridge::submit(std::vector<XSyncWaitItem> &&items, const std::vector<XSyncTicket> &own) {
+  const uint64_t now = XSyncNowNs();
+  std::lock_guard<std::mutex> lock(mutex_);
+  uint64_t value = ++next_value_;
+  if (stop_) {
+    event_.signalValue(value);
+    return value;
+  }
+  jobs_.push_back({value, now, now + (uint64_t)XSyncGetConfig().timeout_ms * 1000000ull, std::move(items), own});
+  cv_.notify_one();
+  return value;
+}
+
+void
+XSyncBridge::shutdown() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (stop_ && !thread_.joinable())
+      return;
+    stop_ = true;
+    cv_.notify_one();
+  }
+  if (thread_.joinable())
+    thread_.join();
+  std::lock_guard<std::mutex> lock(mutex_);
+  /* Whatever is left must not keep a command buffer waiting forever. */
+  event_.signalValue(next_value_);
+  jobs_.clear();
+}
+
+/* Mark/clear "this chunk is GPU-blocked" on the chunk's own lanes. */
+static void
+xsync_mark_blocked(const std::vector<XSyncTicket> &own, const XSyncWaitItem &on, uint64_t now) {
+  for (auto &t : own) {
+    auto &l = t.slot->page->lanes[t.slot->lane];
+    l.blk_since_ns.store(0, std::memory_order_release);
+    l.blk_target.store(on.target, std::memory_order_relaxed);
+    l.blk_page_id.store(on.page->page_id, std::memory_order_relaxed);
+    l.blk_lane.store(on.lane, std::memory_order_relaxed);
+    l.blk_kind.store(on.write, std::memory_order_relaxed);
+    /* the chunk may hold an r and a w ticket on the same lane */
+    if (t.write) {
+      l.blk_from_w.store(t.value, std::memory_order_relaxed);
+    } else {
+      l.blk_from_r.store(t.value, std::memory_order_relaxed);
+    }
+  }
+  for (auto &t : own) {
+    auto &l = t.slot->page->lanes[t.slot->lane];
+    /* tickets of the other kind not held by this chunk: none blocked */
+    bool has_r = false, has_w = false;
+    for (auto &u : own)
+      if (u.slot == t.slot)
+        (u.write ? has_w : has_r) = true;
+    if (!has_r)
+      l.blk_from_r.store(0, std::memory_order_relaxed);
+    if (!has_w)
+      l.blk_from_w.store(0, std::memory_order_relaxed);
+    l.blk_since_ns.store(now ? now : 1, std::memory_order_release);
+  }
+}
+
+static void
+xsync_clear_blocked(const std::vector<XSyncTicket> &own) {
+  for (auto &t : own) {
+    auto &l = t.slot->page->lanes[t.slot->lane];
+    uint64_t from = t.write ? l.blk_from_w.load(std::memory_order_relaxed)
+                            : l.blk_from_r.load(std::memory_order_relaxed);
+    if (from == t.value)
+      l.blk_since_ns.store(0, std::memory_order_release);
+  }
+}
+
+/* Is the partner lane we wait for blocked (in the very command buffer that
+ * holds our target ticket, or a later one) on one of *this process's*
+ * lanes, at a ticket our own blocked command buffer holds?  Then neither
+ * side can ever finish: a 2-party cycle.  Should not happen with
+ * snapshot-before-assign; when an outside dependency (a D3D11 Wait, the GPU,
+ * the guest) closes the loop it is broken here at once instead of after the
+ * timeout.  Writes a description into `why` when true. */
+static bool
+xsync_two_party_cycle(const XSyncWaitItem &it, std::string &why) {
+  auto &pl = it.page->lanes[it.lane];
+  const uint64_t since = pl.blk_since_ns.load(std::memory_order_acquire);
+  if (!since)
+    return false;
+  const uint64_t from = it.write ? pl.blk_from_w.load(std::memory_order_relaxed)
+                                 : pl.blk_from_r.load(std::memory_order_relaxed);
+  if (!from || from > it.target)
+    return false; /* our target lies before the partner's blocked command buffer */
+  const uint64_t on_page = pl.blk_page_id.load(std::memory_order_relaxed);
+  const uint32_t on_lane = pl.blk_lane.load(std::memory_order_relaxed);
+  const uint32_t on_kind = pl.blk_kind.load(std::memory_order_relaxed);
+  const uint64_t on_target = pl.blk_target.load(std::memory_order_relaxed);
+  std::lock_guard<std::mutex> lock(g_slots_mutex);
+  for (auto *slot : g_slots) {
+    if (slot->page->page_id != on_page || slot->lane != on_lane)
+      continue;
+    auto &ml = slot->page->lanes[slot->lane];
+    if (!ml.blk_since_ns.load(std::memory_order_acquire))
+      return false;
+    const uint64_t my_from = on_kind ? ml.blk_from_w.load(std::memory_order_relaxed)
+                                     : ml.blk_from_r.load(std::memory_order_relaxed);
+    if (!my_from || my_from > on_target)
+      return false;
+    why = str::format(
+        "partner lane ", it.lane, " (pid ", (int)(it.owner >> 32), ") is blocked since ",
+        (XSyncNowNs() - since) / 1000, " us at its ticket ", from, " <= our target ", it.target,
+        ", waiting for our lane ", on_lane, on_kind ? " w_done " : " r_done ", on_target, " >= our blocked ticket ", my_from
+    );
+    return true;
+  }
+  return false;
+}
+
+void
+XSyncBridge::run() {
+  pthread_setname_np("dxmt-xsync-bridge");
+  pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+  const auto &cfg = XSyncGetConfig();
+
+  std::unique_lock<std::mutex> lock(mutex_);
+  for (;;) {
+    cv_.wait(lock, [&]() { return stop_ || !jobs_.empty(); });
+    if (jobs_.empty())
+      break; /* stop_ and nothing pending */
+    Job *job = &jobs_.front();
+    lock.unlock();
+
+    bool timed_out = false, cycle = false, marked = false;
+    std::string cycle_why;
+    uint64_t dead = 0, quarantined = 0;
+    uint64_t next_liveness_ns = job->submit_ns + 50000000ull;
+    uint64_t next_cycle_check_ns = job->submit_ns + 2000000ull;
+    int unsat = -1;
+    for (;;) {
+      unsat = -1;
+      const uint64_t now = XSyncNowNs();
+      for (size_t i = 0; i < job->items.size(); i++) {
+        auto &it = job->items[i];
+        auto &l = it.page->lanes[it.lane];
+        if (l.owner.load(std::memory_order_acquire) != it.owner)
+          continue; /* released or reclaimed: settled */
+        auto &done = it.write ? l.w_done : l.r_done;
+        if (done.load(std::memory_order_acquire) >= it.target)
+          continue;
+        if (XSyncPageQuarantined(it.page, now)) {
+          it.owner = ~0ull;
+          quarantined++;
+          continue;
+        }
+        unsat = (int)i;
+        break;
+      }
+      if (unsat < 0)
+        break;
+
+      auto &it = job->items[unsat];
+      if (!marked) {
+        xsync_mark_blocked(job->own, it, now);
+        marked = true;
+      }
+      if (now >= next_liveness_ns) {
+        next_liveness_ns = now + 50000000ull;
+        if (xsync_owner_dead(it.owner)) {
+          it.owner = ~0ull; /* never matches again -> settled */
+          dead++;
+          continue;
+        }
+      }
+      if (now >= next_cycle_check_ns) {
+        next_cycle_check_ns = now + 1000000ull;
+        if (xsync_two_party_cycle(it, cycle_why)) {
+          cycle = true;
+          break;
+        }
+      }
+      {
+        std::lock_guard<std::mutex> g(mutex_);
+        if (stop_)
+          break;
+      }
+      if (now >= job->deadline_ns) {
+        timed_out = true;
+        break;
+      }
+
+      XSyncPageShm *page = it.page;
+      uint32_t w = page->wake.load(std::memory_order_seq_cst);
+      page->waiters.fetch_add(1, std::memory_order_seq_cst);
+      /* Re-check after announcing ourselves: a publish that happened before
+       * `waiters` became visible did not bump `wake`. */
+      auto &l = page->lanes[it.lane];
+      auto &done = it.write ? l.w_done : l.r_done;
+      if (l.owner.load(std::memory_order_seq_cst) == it.owner && done.load(std::memory_order_seq_cst) < it.target) {
+        uint64_t left_us = (job->deadline_ns - now) / 1000;
+        uint32_t slice_us = (uint32_t)std::min<uint64_t>(std::max<uint64_t>(left_us, 50), 1000);
+        __ulock_wait(XSYNC_UL_COMPARE_AND_WAIT_SHARED | XSYNC_ULF_NO_ERRNO, &page->wake, w, slice_us);
+      }
+      page->waiters.fetch_sub(1, std::memory_order_seq_cst);
+    }
+
+    /* Timeout / cycle: stop ordering this texture for a while so one stuck
+     * partner costs one bounded wait, not one per frame. */
+    if ((timed_out || cycle) && unsat >= 0 && cfg.quarantine_ms)
+      xsync_quarantine(job->items[unsat].page, XSyncNowNs() + (uint64_t)cfg.quarantine_ms * 1000000ull);
+
+    const uint64_t waited_us = (XSyncNowNs() - job->submit_ns) / 1000;
+    {
+      auto &st = signal_raw_ns_[job->value % kSignalTimes];
+      st.raw_ns.store(clock_gettime_nsec_np(CLOCK_UPTIME_RAW), std::memory_order_relaxed);
+      st.value.store(job->value, std::memory_order_release);
+    }
+    event_.signalValue(job->value);
+    if (marked)
+      xsync_clear_blocked(job->own);
+
+    stats.waits_done.fetch_add(1, std::memory_order_relaxed);
+    stats.wait_us_total.fetch_add(waited_us, std::memory_order_relaxed);
+    uint64_t prev = stats.wait_us_max.load(std::memory_order_relaxed);
+    while (waited_us > prev &&
+           !stats.wait_us_max.compare_exchange_weak(prev, waited_us, std::memory_order_relaxed)) {
+    }
+    if (dead)
+      stats.dead_owner.fetch_add(dead, std::memory_order_relaxed);
+    if (quarantined)
+      stats.quarantine_skips.fetch_add(quarantined, std::memory_order_relaxed);
+    if (cycle) {
+      uint64_t n = stats.cycles.fetch_add(1, std::memory_order_relaxed) + 1;
+      if (n <= 5 || (n & (n - 1)) == 0)
+        WARN("sharedorder: pid=", XSyncPid(), " wait ", job->value, " CYCLE broken after ", waited_us, " us (cycles=",
+             n, "): ", cycle_why);
+    }
+    if (timed_out) {
+      uint64_t n = stats.timeouts.fetch_add(1, std::memory_order_relaxed) + 1;
+      if (n <= 5 || (n & (n - 1)) == 0) {
+        std::string what;
+        const uint64_t now = XSyncNowNs();
+        for (auto &it : job->items) {
+          if (it.owner == ~0ull)
+            continue;
+          auto &l = it.page->lanes[it.lane];
+          auto &done = it.write ? l.w_done : l.r_done;
+          const uint64_t pub = l.last_publish_ns.load(std::memory_order_relaxed);
+          const uint64_t bs = l.blk_since_ns.load(std::memory_order_relaxed);
+          what += str::format(
+              " [lane ", it.lane, " pid ", (int)(it.owner >> 32), it.write ? " w_done " : " r_done ",
+              done.load(std::memory_order_relaxed), "/", it.target, " last_progress_ms_ago ",
+              pub && now > pub ? (now - pub) / 1000000 : 0
+          );
+          if (bs)
+            what += str::format(
+                " partner_blocked_ms ", now > bs ? (now - bs) / 1000000 : 0, " on lane ",
+                l.blk_lane.load(std::memory_order_relaxed), l.blk_kind.load(std::memory_order_relaxed) ? " w>=" : " r>=",
+                l.blk_target.load(std::memory_order_relaxed),
+                l.blk_page_id.load(std::memory_order_relaxed) == it.page->page_id ? " (same texture)" : " (other texture)"
+            );
+          else
+            what += " partner_not_blocked";
+          what += "]";
+        }
+        WARN("sharedorder: pid=", XSyncPid(), " wait ", job->value, " timed out after ", waited_us,
+             " us; forcing, texture quarantined ", cfg.quarantine_ms, " ms (timeouts=", n, ")", what);
+      }
+    }
+
+    lock.lock();
+    jobs_.pop_front();
+  }
+}
+
+
+#else /* !XSYNC_ENABLED */
+
+XSyncSlot *
+XSyncAttach(int, uint64_t, uint64_t, bool, uint32_t, uint32_t, uint32_t, uint32_t) {
+  return nullptr;
+}
+static void
+xsync_quarantine(XSyncPageShm *, uint64_t) {}
+void
+XSyncRelease(XSyncSlot *) {}
+void
+XSyncPublish(std::vector<XSyncTicket> &tickets) {
+  tickets.clear();
+}
+int
+XSyncCollectWaits(const XSyncAccess &, int, std::vector<XSyncWaitItem> &) {
+  return 0;
+}
+void
+XSyncAssignTickets(const XSyncAccess &, std::vector<XSyncTicket> &) {}
+bool
+XSyncDeadCopyEnabled() {
+  return false;
+}
+bool
+XSyncCopyIsDead(const XSyncSlot *, const XSyncSlot *) {
+  return false;
+}
+bool
+XSyncSurfaceWanted(uint32_t, uint32_t, bool, bool) {
+  return false;
+}
+void *
+XSyncSurfaceCreate(uint32_t, uint32_t, uint32_t, uint64_t, uint32_t *, void **) {
+  return nullptr;
+}
+void *
+XSyncSurfaceLookup(uint32_t, uint32_t, uint32_t, uint32_t, uint64_t, void **) {
+  return nullptr;
+}
+void
+XSyncSurfaceReleaseLater(void *) {}
+uint32_t
+XSyncPeekSurfaceId(int, uint64_t, uint64_t) {
+  return 0;
+}
+void
+XSyncBridge::noteGpuStart(uint64_t, uint64_t) {}
+XSyncBridge::XSyncBridge(WMT::Device device) : event_(device.newSharedEvent()) {}
+XSyncBridge::~XSyncBridge() {}
+uint64_t
+XSyncBridge::submit(std::vector<XSyncWaitItem> &&, const std::vector<XSyncTicket> &) {
+  uint64_t v = ++next_value_;
+  event_.signalValue(v);
+  return v;
+}
+void
+XSyncBridge::shutdown() {}
+void
+XSyncBridge::run() {}
+
+#endif
+
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_xsync.hpp b/src/dxmt/dxmt_xsync.hpp
new file mode 100644
index 0000000..47ba430
--- /dev/null
+++ b/src/dxmt/dxmt_xsync.hpp
@@ -0,0 +1,317 @@
+/*
+ * Ember sharedorder-1030: cross-process GPU ordering for shared (shm) textures.
+ *
+ * Problem: a native shared texture is one linear plane of anonymous POSIX shm
+ * that several *processes* (Neptune render workers: the game, the guest DWM)
+ * map and hand to their own MTLDevice/MTLCommandQueue.  Metal orders nothing
+ * across queues, the textures are HazardTrackingModeUntracked, and DXMT's own
+ * fence tracking is per process.  So once the guest stops CPU-waiting for its
+ * own frame (present gate), the game can render frame k+3 into a buffer that
+ * the DWM's (late) composition of frame k is still sampling (WAR), and a read
+ * can overtake a write (RAW).
+ *
+ * Fix: every shm texture gets one extra page at the end of its shm object (the
+ * "sync page"), visible to every process that maps the texture.  The page
+ * holds up to kXSyncLanes lanes; each TextureAllocation (one per process/
+ * device/open) owns one lane with monotonic counters:
+ *
+ *   r_issued / r_done : command buffers of that lane that read the texture
+ *   w_issued / w_done : command buffers of that lane that write the texture
+ *
+ * issued is bumped on the encode thread when DXMT turns a chunk into a
+ * MTLCommandBuffer; done is published by the finish thread (in commit order)
+ * once that command buffer completed (or failed).  A chunk that writes the
+ * texture snapshots every *other* lane's r_issued (WAR) and a chunk that reads
+ * it snapshots every other lane's w_issued (RAW); if a snapshot is not done
+ * yet, the command buffer gets an encodeWaitForEvent on a process-local
+ * MTLSharedEvent right before the first encoder touching the texture.  A
+ * per-queue bridge thread waits (ulock on the shared page, no busy spin) for
+ * the other lane's done counter and then signals the local event.  The game's
+ * submit thread never blocks; only the GPU waits, and only when the other
+ * process really is behind.
+ *
+ * Deadlock guards: snapshot-before-assign makes same-texture cycles
+ * impossible; a released / stolen / dead lane counts as done; every wait has a
+ * deadline (NPT_SHARED_ORDER_TIMEOUT_MS) after which the event is forced.
+ *
+ * Env (read once per process):
+ *   NPT_SHARED_ORDER            1|on (default) = WAR+RAW, war, raw, 0|off
+ *   NPT_SHARED_ORDER_TIMEOUT_MS bridge deadline per wait (default 100, 5..5000)
+ *   NPT_SHARED_ORDER_QUARANTINE_MS  after a timeout, skip waits on that texture (default 1000)
+ *   NPT_SHARED_ORDER_GPUERR_MS  after a GPU error here, skip waits on our textures (default 2000)
+ *   NPT_SHARED_ORDER_LOG_S      stats line period in seconds (default 10, 0=off)
+ */
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "Metal.hpp"
+
+namespace dxmt {
+
+constexpr uint32_t kXSyncMagic = 0x4f54504eu; /* 'NPTO' */
+constexpr uint32_t kXSyncVersion = 2; /* v2: lane blocked-state, page id, quarantine */
+constexpr unsigned kXSyncLanes = 16;
+
+enum XSyncMode : int {
+  XSyncOff = 0,
+  XSyncWAR = 1, /* writer waits for other lanes' earlier reads */
+  XSyncRAW = 2, /* reader waits for other lanes' earlier writes */
+  XSyncBoth = 3,
+};
+
+struct XSyncConfig {
+  int mode;
+  uint32_t timeout_ms;    /* per wait; below the guest present-gate stall cap (~50-100 ms) */
+  uint32_t quarantine_ms; /* after a timeout: no waits on that texture for this long */
+  uint32_t gpu_error_quarantine_ms; /* after a GPU error in this process: no waits on its textures */
+  uint32_t log_s;
+};
+
+const XSyncConfig &XSyncGetConfig();
+
+struct alignas(64) XSyncLaneShm {
+  std::atomic<uint64_t> owner; /* 0 = free, else (pid << 32) | serial */
+  std::atomic<uint64_t> r_issued;
+  std::atomic<uint64_t> r_done;
+  std::atomic<uint64_t> w_issued;
+  std::atomic<uint64_t> w_done;
+  std::atomic<uint64_t> last_publish_ns;
+  /* v2 blocked state: this lane's tickets >= blk_from_{r,w} belong to a
+   * command buffer that is GPU-waiting (bridge) for lane blk_lane of page
+   * blk_page_id to reach blk_target (blk_kind 0 = r_done, 1 = w_done).
+   * blk_since_ns == 0: not blocked.  Diagnostics + 2-party cycle break. */
+  std::atomic<uint64_t> blk_since_ns;
+  std::atomic<uint64_t> blk_target;
+  std::atomic<uint64_t> blk_page_id;
+  std::atomic<uint32_t> blk_lane;
+  std::atomic<uint32_t> blk_kind;
+  std::atomic<uint64_t> blk_from_r;
+  std::atomic<uint64_t> blk_from_w;
+  uint64_t reserved[4];
+};
+
+struct XSyncPageShm {
+  std::atomic<uint32_t> magic;
+  uint32_t version;
+  uint64_t surface_bytes; /* page-aligned surface mapping size; this page follows it */
+  uint32_t width;
+  uint32_t height;
+  uint32_t stride;
+  uint32_t format;
+  std::atomic<uint32_t> wake;    /* ulock word, bumped on every publish with waiters */
+  std::atomic<uint32_t> waiters; /* bridge threads currently sleeping on `wake` */
+  uint32_t creator_pid;
+  uint32_t surface_id; /* vmzero-1031: global IOSurface holding the pixels, 0 = the shm object */
+  uint64_t page_id;                          /* random, set by the exporter */
+  std::atomic<uint64_t> quarantine_until_ns; /* CLOCK_MONOTONIC; waits skipped until then */
+  uint64_t reserved[1];
+  XSyncLaneShm lanes[kXSyncLanes];
+};
+
+static_assert(std::atomic<uint64_t>::is_always_lock_free, "shm atomics must be address-free");
+static_assert(std::atomic<uint32_t>::is_always_lock_free, "shm atomics must be address-free");
+static_assert(sizeof(XSyncPageShm) <= 4096, "sync page layout must fit one 4K page");
+
+/* One lane of one sync page, owned by one TextureAllocation. */
+struct XSyncSlot {
+  XSyncPageShm *page;
+  void *map_base;
+  size_t map_len;
+  unsigned lane;
+  uint64_t owner;
+  bool exporter;
+  bool local_read = false; /* vmzero-1031: this process read it: copies to it are not dead */
+};
+
+/* Bytes an exporter must add after its page-aligned surface (0 = feature off). */
+uint64_t XSyncExporterExtraBytes(uint64_t page_size);
+
+/* Map and join the sync page of a shm texture.  exporter: initialise the page
+ * (the object was created with XSyncExporterExtraBytes() extra).  Returns
+ * nullptr when the feature is off, the object has no (valid) sync page, or no
+ * lane is free -- the texture then simply runs unordered, as before. */
+XSyncSlot *XSyncAttach(int fd, uint64_t surface_map_size, uint64_t page_size, bool exporter, uint32_t width,
+                       uint32_t height, uint32_t stride, uint32_t format);
+
+/* Mark the lane fully done, free it and unmap.  Call only when no command
+ * buffer that references the owning allocation is still in flight. */
+void XSyncRelease(XSyncSlot *slot);
+
+/* --- per-chunk bookkeeping (encode thread -> finish thread) --- */
+
+struct XSyncAccess {
+  XSyncSlot *slot;
+  int rw; /* 1 read, 2 write, 3 both */
+};
+
+struct XSyncTicket {
+  XSyncSlot *slot;
+  uint8_t write; /* 0: r_done, 1: w_done */
+  uint64_t value;
+};
+
+struct XSyncWaitItem {
+  XSyncPageShm *page;
+  unsigned lane;
+  uint8_t write; /* waiting for w_done (RAW) vs r_done (WAR) */
+  uint64_t owner;
+  uint64_t target;
+};
+
+static inline bool
+XSyncPageQuarantined(const XSyncPageShm *page, uint64_t now_ns) {
+  return now_ns < page->quarantine_until_ns.load(std::memory_order_relaxed);
+}
+
+struct XSyncSignal {
+  obj_handle_t event; /* MTLSharedEvent (retained) */
+  uint64_t value;
+};
+
+/* What a committed chunk must do when its command buffer finishes. */
+struct XSyncChunkResult {
+  std::vector<XSyncTicket> tickets;
+  std::vector<XSyncSignal> signals; /* CPU fallback when the command buffer fails */
+  uint64_t wait_value = 0; /* vmzero-1031: this chunk's bridge wait, 0 none */
+
+  void
+  clear() {
+    tickets.clear();
+    for (auto &s : signals)
+      NSObject_release(s.event);
+    signals.clear();
+    wait_value = 0;
+  }
+};
+
+/* Store done counters and wake waiters (finish thread, in commit order). */
+void XSyncPublish(std::vector<XSyncTicket> &tickets);
+
+/* Snapshot targets other lanes must reach before this access may run.  Items
+ * whose target is already done are dropped. */
+/* Returns 1 when the texture is quarantined (no waits collected). */
+int XSyncCollectWaits(const XSyncAccess &access, int mode, std::vector<XSyncWaitItem> &out);
+
+/* Assign this chunk's own tickets (after all snapshots). */
+void XSyncAssignTickets(const XSyncAccess &access, std::vector<XSyncTicket> &out);
+
+struct XSyncStats {
+  std::atomic<uint64_t> chunks{0};      /* chunks touching a synced texture */
+  std::atomic<uint64_t> wait_chunks{0}; /* chunks that got a GPU wait */
+  std::atomic<uint64_t> war_items{0};
+  std::atomic<uint64_t> raw_items{0};
+  std::atomic<uint64_t> waits_done{0};
+  std::atomic<uint64_t> wait_us_total{0};
+  std::atomic<uint64_t> wait_us_max{0};
+  std::atomic<uint64_t> timeouts{0};
+  std::atomic<uint64_t> dead_owner{0};
+  std::atomic<uint64_t> cycles{0};           /* 2-party cycles broken at once */
+  std::atomic<uint64_t> quarantine_skips{0}; /* waits skipped on quarantined textures */
+  /* vmzero-1031: wait_us counts from the encode thread, not from when the GPU
+   * reached the wait.  gpu_stall = bridge signal - GPUStartTime of the waiting
+   * command buffer, > 0 only: an upper bound of the time the GPU really sat in
+   * that wait (the wait is at the first touching encoder, not always first). */
+  std::atomic<uint64_t> gpu_stall_n{0};
+  std::atomic<uint64_t> gpu_stall_us_total{0};
+  std::atomic<uint64_t> gpu_stall_us_max{0};
+  std::atomic<uint64_t> dead_copies{0};
+};
+
+/* Per-CommandQueue bridge: one local MTLSharedEvent + one thread. */
+class XSyncBridge {
+public:
+  explicit XSyncBridge(WMT::Device device);
+  ~XSyncBridge();
+
+  WMT::SharedEvent
+  event() const {
+    return event_;
+  }
+
+  /* Queue a wait job; returns the event value the command buffer must wait for.
+   * own: the chunk's own tickets (marked "blocked" while the job waits). */
+  uint64_t submit(std::vector<XSyncWaitItem> &&items, const std::vector<XSyncTicket> &own);
+
+  /* Force-signal everything submitted and stop the thread (idempotent). */
+  void shutdown();
+
+  /* vmzero-1031: CLOCK_UPTIME_RAW ns of the signal of `value`, 0 unknown. */
+  uint64_t
+  signaledAtRawNs(uint64_t value) const {
+    auto &e = signal_raw_ns_[value % kSignalTimes];
+    return e.value.load(std::memory_order_acquire) == value ? e.raw_ns.load(std::memory_order_relaxed) : 0;
+  }
+  void noteGpuStart(uint64_t wait_value, uint64_t gpu_start_ns);
+
+  XSyncStats stats;
+
+private:
+  struct Job {
+    uint64_t value;
+    uint64_t submit_ns;
+    uint64_t deadline_ns;
+    std::vector<XSyncWaitItem> items;
+    std::vector<XSyncTicket> own;
+  };
+
+  void run();
+
+  WMT::Reference<WMT::SharedEvent> event_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<Job> jobs_;
+  static constexpr unsigned kSignalTimes = 256;
+  struct SignalTime {
+    std::atomic<uint64_t> value{0};
+    std::atomic<uint64_t> raw_ns{0};
+  };
+  SignalTime signal_raw_ns_[kSignalTimes];
+  uint64_t next_value_ = 0;
+  bool stop_ = false;
+  std::thread thread_;
+};
+
+uint64_t XSyncNowNs();
+int XSyncPid();
+
+/* vmzero-1031 (host only, nothing below changes without its switch).
+ *
+ * EMBER_VMZ_DEADCOPY=1 (env or EMBER_VMZ_CTL file, re-read every second):
+ * XSyncCopyIsDead() = this full-surface copy writes a shared texture that no
+ * other process ever opened, so nobody can read it.  That is Triton's present
+ * copy ring: pipeline-1030 pg5 found the DWM samples the app's swap chain
+ * buffers, never the 6 slots, and with hDstAllocation = 0 the KMD emits no blt.
+ *
+ * EMBER_SCANOUT_SURF=1 (env, read once): exported BGRA8 render targets of at
+ * least 640x480 live in a global IOSurface instead of the shm object; the shm
+ * object then only carries the sync page, whose surface_id tells importers
+ * (DXMT and QEMU's virglrenderer) where the pixels are.  QEMU can then show
+ * the guest's scanout buffer without copying it. */
+bool XSyncCopyIsDead(const XSyncSlot *dst, const XSyncSlot *src);
+bool XSyncDeadCopyEnabled();
+bool XSyncSurfaceWanted(uint32_t width, uint32_t height, bool bgra8, bool render_target);
+/* Returns a retained IOSurfaceRef, its id and base address; nullptr on any failure. */
+void *XSyncSurfaceCreate(uint32_t width, uint32_t height, uint32_t stride, uint64_t need_bytes, uint32_t *out_id,
+                         void **out_base);
+void *XSyncSurfaceLookup(uint32_t id, uint32_t width, uint32_t height, uint32_t stride, uint64_t need_bytes,
+                         void **out_base);
+/* Release after any command buffer can have used it (a few seconds later). */
+void XSyncSurfaceReleaseLater(void *surface);
+/* surface_id in the sync page of a shm object, 0 = none (no page, no surface).  importer only */
+uint32_t XSyncPeekSurfaceId(int fd, uint64_t surface_map_size, uint64_t page_size);
+
+/* Ember: GPU error hook for the embedder (Neptune render worker). */
+typedef void (*XSyncGpuErrorCallback)(void *user, uint64_t frame, const char *description);
+void XSyncSetGpuErrorCallback(XSyncGpuErrorCallback cb, void *user);
+void XSyncReportGpuError(uint64_t frame, const char *description);
+/* NPT_GPU_ERROR_SIGNAL (default 1): CPU-signal a failed command buffer's events. */
+bool XSyncGpuErrorSignalEnabled();
+
+} // namespace dxmt
