+/* Ember sharedorder-1030: snapshot what the other processes' lanes must reach
+ * (all snapshots before any own ticket: no same-texture wait cycles), then
+ * take this chunk's tickets.  Returns the bridge event value to wait for, or 0. */
+bool
+ArgumentEncodingContext::emberCopyIsDead(Rc<Texture> const &dst, Rc<Texture> const &src, bool whole_surface) {
+  auto *slot = dst->current()->xsync;
+  if (likely(!slot) || !whole_surface || !XSyncDeadCopyEnabled() || !XSyncCopyIsDead(slot, src->current()->xsync))
+    return false;
+  queue_.XSyncBridgeGet().stats.dead_copies.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+uint64_t
+ArgumentEncodingContext::prepareXSync() {
+  const auto &cfg = XSyncGetConfig();
+  std::vector<XSyncWaitItem> items;
+  uint64_t skipped = 0;
+  for (auto &a : xsync_accesses_)
+    skipped += XSyncCollectWaits(a, cfg.mode, items);
+  for (auto &a : xsync_accesses_)
+    XSyncAssignTickets(a, xsync_result_.tickets);
+  xsync_accesses_.clear();
+
+  auto &bridge = queue_.XSyncBridgeGet();
+  bridge.stats.chunks.fetch_add(1, std::memory_order_relaxed);
+  if (skipped)
+    bridge.stats.quarantine_skips.fetch_add(skipped, std::memory_order_relaxed);
+  uint64_t value = 0;
+  if (!items.empty()) {
+    uint64_t war = 0, raw = 0;
+    for (auto &it : items)
+      (it.write ? raw : war)++;
+    bridge.stats.war_items.fetch_add(war, std::memory_order_relaxed);
+    bridge.stats.raw_items.fetch_add(raw, std::memory_order_relaxed);
+    bridge.stats.wait_chunks.fetch_add(1, std::memory_order_relaxed);
+    value = bridge.submit(std::move(items), xsync_result_.tickets);
+    xsync_result_.wait_value = value;
+  }
+
+  if (cfg.log_s) {
+    const uint64_t now = XSyncNowNs();
+    if (!xsync_last_log_ns_)
+      xsync_last_log_ns_ = now;
+    else if (now - xsync_last_log_ns_ >= (uint64_t)cfg.log_s * 1000000000ull) {
+      xsync_last_log_ns_ = now;
+      auto &st = bridge.stats;
+      uint64_t chunks = st.chunks.exchange(0), wc = st.wait_chunks.exchange(0), war = st.war_items.exchange(0),
+               raw = st.raw_items.exchange(0), wd = st.waits_done.exchange(0), wus = st.wait_us_total.exchange(0),
