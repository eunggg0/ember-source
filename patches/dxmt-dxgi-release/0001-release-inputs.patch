+/* generated by Tools/neuralbench/gen_shader.sh from ember_neural.metal - do not edit */
+static const char ember_neural_shader_src[] =
+"// Ember Neural look pass (shared by winemac.drv / DXMT / Tools/neuralbench).\n"
+"// ASCII ONLY: winemetal compiles this from source with NSASCIIStringEncoding.\n"
+"// Regenerate ember_neural_shader.h with Tools/neuralbench/gen_shader.sh after editing.\n"
+"//\n"
+"// Pipeline per game frame (all in the present command buffer, GPU only, no CPU sync):\n"
+"//   vs_ember_nn / fs_ember_nn_down   : full frame -> small analysis texture (RGBA16F) or ANE input (BGRA8 / planar R16F)\n"
+"//   cs_ember_nn_stats                : analysis texture -> per-channel mean/var of input and of the graded output\n"
+"//                                      (EMA in a 64-byte buffer; the color guard reads it in the same frame)\n"
+"//   vs_ember_nn / fs_ember_nn_apply  : full frame -> graded frame: neural delta (from the last finished ANE result,\n"
+"//                                      1..N frames old, low-frequency only, detail re-injected from the original),\n"
+"//                                      filmic S-curve, local contrast, vibrance, grain, color-consistency guard, mix.\n"
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"\n"
+"struct EmberNNParams {\n"
+"    float strength;    // 0..1 final mix original -> graded\n"
+"    float contrast;    // 0..1 filmic S-curve amount\n"
+"    float clarity;     // 0..1 local contrast\n"
+"    float vibrance;    // 0..1\n"
+"    float grain;       // 0..1\n"
+"    float guard;       // 0..1 color-consistency guard (1 = fully match input mean/var per channel)\n"
+"    float neural;      // 0..1 weight of the neural delta (0 when no result yet / stale)\n"
+"    float ema;         // stats EMA keep factor (0 = no smoothing)\n"
+"    float in_scale;    // planar ANE input = c * in_scale + in_bias\n"
+"    float in_bias;\n"
+"    float out_scale;   // planar ANE output c = (v - out_bias) / out_scale\n"
+"    float out_bias;\n"
+"    uint  frame;\n"
+"    uint  flags;       // 1 neural delta available, 2 planar fp16 layout, 4 stats buffer initialised, 8 float (HDR) source\n"
+"    uint  lo_w;\n"
+"    uint  lo_h;\n"
+"};\n"
+"\n"
+"struct EmberNNStats {\n"
+"    float4 mean_in;    // rgb\n"
+"    float4 var_in;\n"
+"    float4 mean_out;\n"
+"    float4 var_out;\n"
+"};\n"
+"\n"
+"struct EmberNNVaryings { float4 pos [[position]]; float2 uv; };\n"
+"\n"
+"vertex EmberNNVaryings vs_ember_nn(uint id [[vertex_id]]) {\n"
+"    float2 p = float2((id << 1) & 2, id & 2);\n"
+"    EmberNNVaryings o;\n"
+"    o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+"    o.uv = float2(p.x, 1.0 - p.y);\n"
+"    return o;\n"
+"}\n"
+"\n"
+"static inline float ember_nn_luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }\n"
+"\n"
+"// Reads one texel of the ANE input/output pair in the frame's [0,1] domain regardless of layout.\n"
+"static inline float3 ember_nn_read_lo(texture2d<float> t, float2 uv, constant EmberNNParams &p, float scale, float bias) {\n"
+"    constexpr sampler s(filter::linear, address::clamp_to_edge);\n"
+"    if (p.flags & 2u) {\n"
+"        // planar: R16F texture, rows [0,H) = R, [H,2H) = G, [2H,3H) = B\n"
+"        float r = t.sample(s, float2(uv.x, (uv.y + 0.0) / 3.0)).r;\n"
+"        float g = t.sample(s, float2(uv.x, (uv.y + 1.0) / 3.0)).r;\n"
+"        float b = t.sample(s, float2(uv.x, (uv.y + 2.0) / 3.0)).r;\n"
+"        return (float3(r, g, b) - bias) / max(scale, 1e-4);\n"
+"    }\n"
+"    return t.sample(s, uv).rgb;\n"
+"}\n"
+"\n"
+"// The grade without spatial terms (used by the stats kernel and the apply pass).\n"
+"static inline float3 ember_nn_grade(float3 c, float2 uv, constant EmberNNParams &p,\n"
+"                                    texture2d<float> lo_in, texture2d<float> lo_out) {\n"
+"    if ((p.flags & 1u) && p.neural > 0.0) {\n"
+"        float3 a = ember_nn_read_lo(lo_in, uv, p, p.in_scale, p.in_bias);\n"
+"        float3 b = ember_nn_read_lo(lo_out, uv, p, p.out_scale, p.out_bias);\n"
+"        c += (b - a) * p.neural;          // low-frequency delta only: full-res detail of c survives untouched\n"
+"    }\n"
+"    if (p.contrast > 0.0) {\n"
+"        // filmic S-curve, pivot 0.5, black and white fixed, identity outside [0,1] (HDR safe)\n"
+"        float3 x = clamp(c, 0.0, 1.0);\n"
+"        c -= (p.contrast * 0.22) * sin(6.2831853 * x) / 6.2831853;\n"
+"        // gentle shoulder: pull the top 10% down so the S-curve does not clip\n"
+"        float3 hi = max(c - 0.9, 0.0);\n"
+"        c -= hi * hi * (p.contrast * 2.0);\n"
+"    }\n"
+"    if (p.vibrance > 0.0) {\n"
+"        float l = ember_nn_luma(c);\n"
+"        float sat = max(max(c.r, c.g), c.b) - min(min(c.r, c.g), c.b);\n"
+"        c = mix(float3(l), c, 1.0 + p.vibrance * 0.7 * saturate(1.0 - sat * 1.5));\n"
+"    }\n"
+"    return c;\n"
+"}\n"
+"\n"
+"// --- analysis / ANE input downscale (render pass so it can wait on the game fence directly) ---\n"
+"// target is either the analysis texture (lo_w x lo_h, RGBA16F), the ANE BGRA8 image (lo_w x lo_h),\n"
+"// or the planar R16F ANE input (lo_w x 3*lo_h): the plane comes from the y position.\n"
+"fragment float4 fs_ember_nn_down(EmberNNVaryings in [[stage_in]], texture2d<float> src [[texture(0)]],\n"
+"                                 constant EmberNNParams &p [[buffer(0)]]) {\n"
+"    constexpr sampler s(filter::linear, address::clamp_to_edge);\n"
+"    float2 uv = in.uv;\n"
+"    uint plane = 0;\n"
+"    if (p.flags & 2u) {\n"
+"        float y = uv.y * 3.0;\n"
+"        plane = min((uint)y, 2u);\n"
+"        uv.y = y - (float)plane;\n"
+"    }\n"
+"    // 4-tap box (bilinear taps at +-0.25 output pixel): fine up to ~3x reduction\n"
+"    float2 h = 0.25 / float2(p.lo_w, p.lo_h);\n"
+"    float3 c = src.sample(s, uv + float2(-h.x, -h.y)).rgb + src.sample(s, uv + float2(h.x, -h.y)).rgb +\n"
+"               src.sample(s, uv + float2(-h.x, h.y)).rgb + src.sample(s, uv + float2(h.x, h.y)).rgb;\n"
+"    c *= 0.25;\n"
+"    if (p.flags & 2u) {\n"
+"        float v = (plane == 0 ? c.r : (plane == 1 ? c.g : c.b)) * p.in_scale + p.in_bias;\n"
+"        return float4(v, v, v, 1.0);\n"
+"    }\n"
+"    return float4(c, 1.0);\n"
+"}\n"
+"\n"
+"// --- statistics: one threadgroup of 256 threads, 128x72 sample grid over the analysis texture ---\n"
+"kernel void cs_ember_nn_stats(texture2d<float> analysis [[texture(0)]],\n"
+"                              texture2d<float> lo_in [[texture(1)]], texture2d<float> lo_out [[texture(2)]],\n"
+"                              constant EmberNNParams &p [[buffer(0)]],\n"
+"                              device EmberNNStats &st [[buffer(1)]],\n"
+"                              uint tid [[thread_index_in_threadgroup]],\n"
+"                              uint sg [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) {\n"
+"    constexpr sampler s(filter::linear, address::clamp_to_edge);\n"
+"    threadgroup float3 part[4][8];\n"
+"    float3 s_in = 0, q_in = 0, s_out = 0, q_out = 0;\n"
+"    const uint W = 128, H = 72;\n"
+"    for (uint i = tid; i < W * H; i += 256) {\n"
+"        float2 uv = (float2(i % W, i / W) + 0.5) / float2(W, H);\n"
+"        float3 c = analysis.sample(s, uv).rgb;\n"
+"        float3 g = ember_nn_grade(c, uv, p, lo_in, lo_out);\n"
+"        s_in += c; q_in += c * c; s_out += g; q_out += g * g;\n"
+"    }\n"
+"    s_in = simd_sum(s_in); q_in = simd_sum(q_in); s_out = simd_sum(s_out); q_out = simd_sum(q_out);\n"
+"    if (lane == 0) { part[0][sg] = s_in; part[1][sg] = q_in; part[2][sg] = s_out; part[3][sg] = q_out; }\n"
+"    threadgroup_barrier(mem_flags::mem_threadgroup);\n"
+"    if (tid == 0) {\n"
+"        float3 a = 0, b = 0, c = 0, d = 0;\n"
