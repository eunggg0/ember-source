+EmberAutoHDR::log(double edr_now, double edr_potential) {
+  if (!log_) return;
+  log_frames_++;
+  auto now = std::chrono::steady_clock::now();
+  if (!log_since_.time_since_epoch().count()) log_since_ = now;
+  double el = std::chrono::duration<double>(now - log_since_).count();
+  if (el < 5.0) return;
+  char line[200];
+  std::snprintf(line, sizeof(line), "ember-autohdr: frames=%.1f/s %ux%u peak=%.2f edr=%.2f potential=%.2f", log_frames_ / el, w_, h_,
