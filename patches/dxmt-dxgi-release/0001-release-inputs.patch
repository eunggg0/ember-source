+EmberNeural::EmberNeural(WMT::Device device) : device_(device) {
+  auto pool = WMT::MakeAutoreleasePool();
+  log_ = env::getEnvVar("EMBER_NEURAL_LOG") == "1";
+  auto res = env::getEnvVar("EMBER_NEURAL_RES");
+  if (!res.empty()) res_ = std::max(0, std::atoi(res.c_str()));
+  auto model = env::getEnvVar("EMBER_NEURAL_MODEL");
+  bool has_model = !model.empty();
+  base_.strength = nn_env_pct("EMBER_NEURAL_STRENGTH", 60);
+  base_.contrast = nn_env_pct("EMBER_NEURAL_CONTRAST", has_model ? 0 : 35);
+  base_.clarity = nn_env_pct("EMBER_NEURAL_CLARITY", 25);
+  base_.vibrance = nn_env_pct("EMBER_NEURAL_VIBRANCE", has_model ? 0 : 20);
+  base_.grain = nn_env_pct("EMBER_NEURAL_GRAIN", 0);
+  base_.guard = nn_env_pct("EMBER_NEURAL_GUARD", 100);
+  base_.neural = nn_env_pct("EMBER_NEURAL_MODEL_WEIGHT", 100);
+  base_.ema = 0.9f;
+  base_.in_scale = base_.out_scale = 1.f;
+  if (!ensurePipelines()) {
+    failed_ = true;
+    return;
+  }
+  if (has_model) openModel(model);
+  if (log_) {
+    char line[256];
+    std::snprintf(line, sizeof(line), "ember-neural: on strength=%.0f%% contrast=%.0f%% clarity=%.0f%% vibrance=%.0f%% guard=%.0f%% res=%d model=%s",
+                  base_.strength * 100, base_.contrast * 100, base_.clarity * 100, base_.vibrance * 100, base_.guard * 100, res_,
+                  ane_ ? model.c_str() : "(baseline)");
+    Logger::info(line);
+  }
 }
 
