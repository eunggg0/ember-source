+bool
+EmberAutoHDR::ensurePipelines() {
+  WMT::Reference<WMT::Error> error;
+  library_ = device_.newLibraryWithSource(std::string_view(ember_autohdr_shader_src), error);
+  if (!library_) {
+    Logger::err("ember-autohdr: shader compile failed");
+    return false;
+  }
+  return pso("fs_ember_ahdr_l1", WMTPixelFormatRGBA16Float, WMTPixelFormatR16Float) &&
+         pso("fs_ember_ahdr_reduce", WMTPixelFormatRGBA16Float) && pso("fs_ember_ahdr_glob", WMTPixelFormatRGBA16Float) &&
+         pso("fs_ember_ahdr_mlp", WMTPixelFormatRG16Float);   //
+}
+
+WMT::RenderPipelineState
+EmberAutoHDR::pso(const char *fs, WMTPixelFormat f0, WMTPixelFormat f1) {
+  for (auto &e : psos_)
+    if (e.fs == fs && e.f0 == f0 && e.f1 == f1) return e.pso;
+  auto pool = WMT::MakeAutoreleasePool();
+  WMT::Reference<WMT::Error> error;
+  auto vs = library_.newFunction("vs_ember_ahdr");
+  auto fn = library_.newFunction(fs);
+  WMT::Reference<WMT::RenderPipelineState> ps;
+  if (vs && fn) {
+    WMTRenderPipelineInfo info;
+    WMT::InitializeRenderPipelineInfo(info);
+    info.colors[0].pixel_format = f0;
+    if (f1 != WMTPixelFormatInvalid) info.colors[1].pixel_format = f1;
+    info.vertex_function = vs;
+    info.fragment_function = fn;
+    ps = device_.newRenderPipelineState(info, error);
+  }
+  if (!ps) Logger::err(std::string("ember-autohdr: pipeline ") + fs + " failed");
+  psos_.push_back({fs, f0, f1, ps});
+  return ps;
+}
+
+bool
+EmberAutoHDR::ensureTextures(uint32_t w, uint32_t h) {
+  if (w == w_ && h == h_ && gain_) return true;
+  auto make = [&](WMTPixelFormat f, uint32_t tw, uint32_t th) {
+    WMTTextureInfo info {};
+    info.pixel_format = f;
+    info.width = std::max(1u, tw);
+    info.height = std::max(1u, th);
+    info.depth = 1;
+    info.array_length = 1;
+    info.type = WMTTextureType2D;
+    info.mipmap_level_count = 1;
+    info.sample_count = 1;
+    info.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageRenderTarget);
+    info.options = WMTResourceStorageModePrivate;   //
+    return device_.newTexture(info);
+  };
+  uint32_t w1 = (w + 3) / 4, h1 = (h + 3) / 4, w2 = (w1 + 3) / 4, h2 = (h1 + 3) / 4, w3 = (w2 + 3) / 4, h3 = (h2 + 3) / 4;
+  l1a_ = make(WMTPixelFormatRGBA16Float, w1, h1);
+  l1b_ = make(WMTPixelFormatR16Float, w1, h1);
+  l2_ = make(WMTPixelFormatRGBA16Float, w2, h2);
+  l3_ = make(WMTPixelFormatRGBA16Float, w3, h3);
+  l4_ = make(WMTPixelFormatRGBA16Float, (w3 + 3) / 4, (h3 + 3) / 4);
+  glob_ = make(WMTPixelFormatRGBA16Float, 1, 1);
+  gain_ = make(WMTPixelFormatRG16Float, w1, h1);
+  w_ = w;
+  h_ = h;
+  return l1a_ && l1b_ && l2_ && l3_ && l4_ && glob_ && gain_;
+}
+
+void
+EmberAutoHDR::pass(
+    WMT::CommandBuffer cmdbuf, const char *fs, WMT::Texture t0, WMT::Texture t1, std::vector<WMT::Texture> srcs,
+    const void *bytes, uint64_t len, std::function<void(WMT::RenderCommandEncoder)> *wait_fences
+) {
+  auto ps = pso(fs, t0.pixelFormat(), t1.handle ? t1.pixelFormat() : WMTPixelFormatInvalid);
+  if (!ps) return;
+  WMTRenderPassInfo info;
+  WMT::InitializeRenderPassInfo(info);
+  info.colors[0].load_action = WMTLoadActionDontCare;
+  info.colors[0].store_action = WMTStoreActionStore;
+  info.colors[0].texture = t0;
+  if (t1.handle) {
+    info.colors[1].load_action = WMTLoadActionDontCare;
+    info.colors[1].store_action = WMTStoreActionStore;
+    info.colors[1].texture = t1;
+  }
+  auto enc = cmdbuf.renderCommandEncoder(info);
+  if (wait_fences) (*wait_fences)(enc);   //
+  enc.setRenderPipelineState(ps);
+  for (uint8_t i = 0; i < srcs.size(); i++) enc.setFragmentTexture(srcs[i], i);
+  if (bytes) enc.setFragmentBytes(bytes, len, 0);
+  enc.setViewport({0, 0, (double)t0.width(), (double)t0.height(), 0, 1});
+  enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+  enc.endEncoding();
 }
 
