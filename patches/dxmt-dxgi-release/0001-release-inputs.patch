+void
+EmberNeural::openModel(const std::string &spec) {
+  ember_neural_ane_desc desc {};
+  auto units = env::getEnvVar("EMBER_NEURAL_UNITS");
+  int h = res_ > 0 ? res_ : 720, w = h * 16 / 9;
+  //
+  ane_ = EmberNeural_open(device_.handle, spec.c_str(), units.c_str(), (uint32_t)w, (uint32_t)h, log_ ? 1 : 0, &desc);
+  if (!ane_) {
+    Logger::warn("ember-neural: model '" + spec + "' unavailable, baseline pass only");
+    return;
+  }
+  ane_w_ = desc.width;
+  ane_h_ = desc.height;
+  ane_layout_ = desc.layout;
+  base_.in_scale = desc.in_scale;
+  base_.in_bias = desc.in_bias;
+  base_.out_scale = desc.out_scale;
+  base_.out_bias = desc.out_bias;
+}
+
+bool
+EmberNeural::ensurePipelines() {
+  WMT::Reference<WMT::Error> error;
+  library_ = device_.newLibraryWithSource(std::string_view(ember_neural_shader_src), error);
+  if (!library_) {
+    Logger::err("ember-neural: shader compile failed");
+    return false;
+  }
+  auto fn = library_.newFunction("cs_ember_nn_stats");
+  if (!fn) return false;
+  stats_pso_ = device_.newComputePipelineState(fn, error);
+  if (!stats_pso_) {
+    Logger::err("ember-neural: stats pipeline failed");
+    return false;
+  }
+  WMTBufferInfo binfo {};
+  binfo.length = 64;
+  binfo.options = WMTResourceStorageModePrivate;
+  stats_ = device_.newBuffer(binfo);
+  WMTTextureInfo tinfo {};
+  tinfo.pixel_format = WMTPixelFormatRGBA16Float;
+  tinfo.width = 256;
+  tinfo.height = 144;
+  tinfo.depth = 1;
+  tinfo.array_length = 1;
+  tinfo.type = WMTTextureType2D;
+  tinfo.mipmap_level_count = 1;
+  tinfo.sample_count = 1;
+  tinfo.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageRenderTarget);
+  tinfo.options = WMTResourceStorageModePrivate;
+  analysis_ = device_.newTexture(tinfo);
+  return stats_ && analysis_;
+}
+
+WMT::RenderPipelineState
+EmberNeural::pso(const char *kind, WMTPixelFormat format) {
+  for (auto &e : psos_)
+    if (e.format == format && e.kind == kind) return e.pso;
+  auto pool = WMT::MakeAutoreleasePool();
+  WMT::Reference<WMT::Error> error;
+  std::string fs_name = std::string("fs_ember_nn_") + kind;
+  auto vs = library_.newFunction("vs_ember_nn");
+  auto fs = library_.newFunction(fs_name.c_str());
+  WMT::Reference<WMT::RenderPipelineState> ps;
+  if (vs && fs) {
+    WMTRenderPipelineInfo info;
+    WMT::InitializeRenderPipelineInfo(info);
+    info.colors[0].pixel_format = format;
+    info.vertex_function = vs;
+    info.fragment_function = fs;
+    ps = device_.newRenderPipelineState(info, error);
+  }
+  if (!ps) Logger::err(std::string("ember-neural: pipeline ") + kind + " failed");
+  psos_.push_back({kind, format, ps});
+  return ps;
+}
