diff --git a/src/dxmt/ember_autohdr_shader.h b/src/dxmt/ember_autohdr_shader.h
new file mode 100644
--- /dev/null
+++ b/src/dxmt/ember_autohdr_shader.h
@@ -0,0 +1,179 @@
+/* generated by Tools/autohdr/gen_shader.sh from ember_autohdr.metal - do not edit */
+static const char ember_autohdr_shader_src[] =
+"// Ember Auto HDR - highlight gain map (shared by DXMT presenter / Tools/autohdr bench).\n"
+"// ASCII ONLY: winemetal compiles this from source with NSASCIIStringEncoding.\n"
+"// Regenerate ember_autohdr_shader.h with Tools/autohdr/gen_shader.sh after editing.\n"
+"//\n"
+"// Passes (all tiny render passes, full-screen triangle):\n"
+"//   l1   : game frame -> L1a (RGBA16F: mean vY, max vmax, clip fraction, mean |grad vY|) + L1b (R16F: mean sat*vY), 4x4 blocks\n"
+"//   l2   : L1a -> L2 (4x4 of L1: mean, max, mean, mean)\n"
+"//   l3   : L2  -> L3 (4x4 of L2: mean, max, mean)\n"
+"//   l4   : L3  -> L4 (same reduce)\n"
+"//   glob : L4 -> 1x1 (frame mean vY, frame clip fraction)\n"
+"//   mlp  : per L1 block features (14) -> tiny MLP (14-16-16-2) -> gain map RG16F (G stops, knee k)\n"
+"// The present shader samples the gain map (bilinear) and applies T = log2(Y) + s*G*w(vmax), then the display roll-off.\n"
+"// Definitions must match Tools/autohdr/autohdr.py features()/Net/expand().\n"
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"\n"
+"struct ahdr_vout { float4 position [[position]]; float2 uv; };\n"
+"\n"
+"vertex ahdr_vout vs_ember_ahdr(uint vid [[vertex_id]]) {\n"
+"  ahdr_vout o;\n"
+"  float2 p = float2((vid << 1) & 2, vid & 2);\n"
+"  o.position = float4(p * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+"  o.uv = p;\n"
+"  return o;\n"
+"}\n"
+"\n"
+"struct ahdr_params {\n"
+"  uint src_w, src_h;      // source (game frame) size\n"
+"  uint flags;             // 1 = source is sRGB format (reads are linear -> re-encode)\n"
+"  uint pad;\n"
+"};\n"
+"\n"
+"static inline float3 ahdr_srgb_encode(float3 l) {\n"
+"  l = clamp(l, 0.0, 1.0);\n"
+"  return select(1.055 * pow(l, 1.0 / 2.4) - 0.055, l * 12.92, l <= 0.0031308);\n"
+"}\n"
+"static inline float3 ahdr_srgb_decode(float3 v) {\n"
+"  return select(pow((v + 0.055) / 1.055, 2.4), v / 12.92, v <= 0.04045);\n"
+"}\n"
+"static inline float ahdr_vY(float3 v) { return dot(v, float3(0.2126, 0.7152, 0.0722)); }\n"
+"\n"
+"static inline float3 ahdr_fetch(texture2d<float, access::read> src, int2 p, constant ahdr_params &pr) {\n"
+"  p = clamp(p, int2(0), int2(pr.src_w - 1, pr.src_h - 1));\n"
+"  float3 v = src.read(uint2(p)).rgb;\n"
+"  if (pr.flags & 1) v = ahdr_srgb_encode(v);\n"
+"  return clamp(v, 0.0, 1.0);\n"
+"}\n"
+"\n"
+"struct ahdr_l1_out { half4 a [[color(0)]]; half b [[color(1)]]; };\n"
+"\n"
+"// One fragment = one 4x4 block. Walks the block row by row keeping only the current and next row (low register\n"
+"// pressure); gradient uses the right/below neighbour (edge pixel repeats at the frame edge -> 0, same as torch's pad).\n"
+"fragment ahdr_l1_out fs_ember_ahdr_l1(ahdr_vout in [[stage_in]],\n"
+"                                      texture2d<float, access::read> src [[texture(0)]],\n"
+"                                      constant ahdr_params &pr [[buffer(0)]]) {\n"
+"  int2 b = int2(in.position.xy) * 4;\n"
+"  int2 lim = int2(pr.src_w - 1, pr.src_h - 1);\n"
+"  float cy[5], ny[5];\n"
+"  float3 cv[4], nv[4];\n"
+"  for (int x = 0; x < 5; x++) {\n"
+"    float3 v = ahdr_fetch(src, b + int2(x, 0), pr);\n"
+"    cy[x] = ahdr_vY(v);\n"
+"    if (x < 4) cv[x] = v;\n"
+"  }\n"
+"  float s_vy = 0, m_vmax = 0, s_clip = 0, s_g = 0, s_sat = 0, n = 0;\n"
+"  for (int y = 0; y < 4; y++) {\n"
+"    for (int x = 0; x < 5; x++) {\n"
+"      float3 v = ahdr_fetch(src, b + int2(x, y + 1), pr);\n"
+"      ny[x] = ahdr_vY(v);\n"
+"      if (x < 4) nv[x] = v;\n"
+"    }\n"
+"    if (b.y + y <= lim.y) {\n"
+"      for (int x = 0; x < 4; x++) {\n"
+"        if (b.x + x > lim.x) continue;\n"
+"        float3 v = cv[x];\n"
+"        float vmax = max3(v.r, v.g, v.b), vmin = min3(v.r, v.g, v.b);\n"
+"        float2 l = ahdr_srgb_decode(float3(vmax, vmin, 0)).xy;   // decode is monotonic: lin max/min = decode(max/min)\n"
+"        float sat = (l.x - l.y) / (l.x + 1e-3);\n"
+"        float g = abs(cy[x + 1] - cy[x]) + abs(ny[x] - cy[x]);\n"
+"        s_vy += cy[x]; m_vmax = max(m_vmax, vmax); s_clip += vmax >= 0.98 ? 1.0 : 0.0; s_g += g; s_sat += sat * cy[x]; n += 1;\n"
+"      }\n"
+"    }\n"
+"    for (int x = 0; x < 5; x++) { cy[x] = ny[x]; if (x < 4) cv[x] = nv[x]; }\n"
+"  }\n"
+"  n = max(n, 1.0);\n"
+"  ahdr_l1_out o;\n"
+"  o.a = half4(s_vy / n, m_vmax, s_clip / n, s_g / n);\n"
+"  o.b = half(s_sat / n);\n"
+"  return o;\n"
+"}\n"
+"\n"
+"// 4x4 reduce: x mean, y max, z mean, w mean (partial blocks at the edge average only valid texels)\n"
+"fragment half4 fs_ember_ahdr_reduce(ahdr_vout in [[stage_in]], texture2d<half, access::read> src [[texture(0)]]) {\n"
+"  int2 b = int2(in.position.xy) * 4;\n"
+"  int w = src.get_width(), h = src.get_height();\n"
+"  float4 s = 0; float m = 0, n = 0;\n"
+"  for (int y = 0; y < 4; y++)\n"
+"    for (int x = 0; x < 4; x++) {\n"
+"      int2 p = b + int2(x, y);\n"
