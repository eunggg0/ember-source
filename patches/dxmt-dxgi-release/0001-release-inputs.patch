+float
+EmberAutoHDR::peak(double edr_now) {
+  float target = (float)std::max(1.0, edr_now);
+  if (peak_cap_ > 0) target = std::min(target, std::max(1.f, peak_cap_));
+  //
+  peak_ = peak_ + (target - peak_) * 0.1f;
