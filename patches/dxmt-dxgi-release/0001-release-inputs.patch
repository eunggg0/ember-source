+"// bilinear sample of a coarser level at the L1 block centre (torch interpolate, align_corners=False)\n"
+"static inline float4 ahdr_up(texture2d<half, access::sample> t, float2 p1, float scale) {\n"
+"  constexpr sampler ls(coord::pixel, filter::linear, address::clamp_to_edge);\n"
+"  return float4(t.sample(ls, (p1 + 0.5) / scale));\n"
+"}\n"
+"\n"
+"fragment half4 fs_ember_ahdr_mlp(ahdr_vout in [[stage_in]],\n"
+"                                 texture2d<half, access::read> l1a [[texture(0)]],\n"
+"                                 texture2d<half, access::read> l1b [[texture(1)]],\n"
+"                                 texture2d<half, access::sample> l2 [[texture(2)]],\n"
+"                                 texture2d<half, access::sample> l3 [[texture(3)]],\n"
+"                                 texture2d<half, access::read> gl [[texture(4)]]) {\n"
+"  uint2 p = uint2(in.position.xy);\n"
+"  float4 a = float4(l1a.read(p));\n"
+"  float b = float(l1b.read(p).r);\n"
+"  float4 u2 = ahdr_up(l2, float2(p), 4.0);\n"
+"  float4 u3 = ahdr_up(l3, float2(p), 16.0);\n"
+"  float4 g = float4(gl.read(uint2(0, 0)));\n"
+"  float f[AHDR_NF] = {a.x, a.y, a.z, a.w, b, u2.x, u2.y, u2.z, u2.w, u3.x, u3.y, u3.z, g.x, g.y};\n"
+"  half fh[AHDR_NF];\n"
+"  for (int i = 0; i < AHDR_NF; i++) fh[i] = half((f[i] - AHDR_WF[AHDR_MU + i]) / AHDR_WF[AHDR_SD + i]);\n"
+"  half h0[AHDR_H], h1[AHDR_H];\n"
+"  for (int j = 0; j < AHDR_H; j++) {\n"
+"    half s = half(AHDR_WF[AHDR_B0 + j]);\n"
+"    for (int i = 0; i < AHDR_NF; i++) s = fma(half(AHDR_WF[AHDR_W0 + j * AHDR_NF + i]), fh[i], s);\n"
+"    h0[j] = max(s, 0.0h);\n"
+"  }\n"
+"  for (int j = 0; j < AHDR_H; j++) {\n"
+"    half s = half(AHDR_WF[AHDR_B1 + j]);\n"
+"    for (int i = 0; i < AHDR_H; i++) s = fma(half(AHDR_WF[AHDR_W1 + j * AHDR_H + i]), h0[i], s);\n"
+"    h1[j] = max(s, 0.0h);\n"
+"  }\n"
+"  float o0 = AHDR_WF[AHDR_B2], o1 = AHDR_WF[AHDR_B2 + 1];\n"
+"  for (int i = 0; i < AHDR_H; i++) { o0 += AHDR_WF[AHDR_W2 + i] * float(h1[i]); o1 += AHDR_WF[AHDR_W2 + AHDR_H + i] * float(h1[i]); }\n"
+"  float G = (o0 > 20.0 ? o0 : log(1.0 + exp(o0))) * AHDR_WF[AHDR_GS];   // softplus * 1.5\n"
+"  float k = AHDR_WF[AHDR_KMIN] + AHDR_WF[AHDR_KR] / (1.0 + exp(-o1));   // sigmoid * 0.5 + 0.45\n"
+"  return half4(G, k, 0, 1);\n"
+"}\n"
