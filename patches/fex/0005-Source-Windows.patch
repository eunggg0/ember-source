+    "GetLastError", "SetLastError", "GetCurrentThreadId", "GetCurrentProcessId", "GetCurrentThread", "GetCurrentProcess",
+    "TlsGetValue", "TlsSetValue", "FlsGetValue", "FlsSetValue", "GetTickCount", "GetTickCount64",
+    "QueryPerformanceCounter", "QueryPerformanceFrequency", "GetSystemTimeAsFileTime", "GetSystemTimePreciseAsFileTime",
+    "EnterCriticalSection", "LeaveCriticalSection", "TryEnterCriticalSection",
+    "AcquireSRWLockExclusive", "AcquireSRWLockShared", "ReleaseSRWLockExclusive", "ReleaseSRWLockShared",
+    "TryAcquireSRWLockExclusive", "TryAcquireSRWLockShared", "WakeByAddressSingle", "WakeByAddressAll", "WaitOnAddress",
+    "SetEvent", "ResetEvent", "ReleaseSemaphore", "ReleaseMutex", "WaitForSingleObject", "Sleep", "SwitchToThread",
+    "GetProcessHeap", "HeapAlloc", "HeapFree", "HeapReAlloc", "HeapSize",
+    "InterlockedPushEntrySList", "InterlockedPopEntrySList", "GetCurrentProcessorNumber",
+    // ntdll
+    "RtlGetLastWin32Error", "RtlSetLastWin32Error", "RtlEnterCriticalSection", "RtlLeaveCriticalSection",
+    "RtlTryEnterCriticalSection", "RtlAllocateHeap", "RtlFreeHeap", "RtlReAllocateHeap", "RtlSizeHeap",
+    "RtlQueryPerformanceCounter", "RtlQueryPerformanceFrequency", "NtQueryPerformanceCounter",
+    "RtlAcquireSRWLockExclusive", "RtlAcquireSRWLockShared", "RtlReleaseSRWLockExclusive", "RtlReleaseSRWLockShared",
+    "RtlTryAcquireSRWLockExclusive", "RtlTryAcquireSRWLockShared", "RtlWakeAddressSingle", "RtlWakeAddressAll",
+    "RtlWaitOnAddress", "NtYieldExecution", "RtlInterlockedPushEntrySList", "RtlInterlockedPopEntrySList",
+    // CRT 힙(Wine 의 msvcrt·ucrtbase 는 ARM64EC — 게임이 동적 CRT 면 malloc/free 가 매우 잦다)
+    "malloc", "free", "calloc", "realloc", "_aligned_malloc", "_aligned_free",
+    // CRT 문자열·메모리·난수 — 정수·벡터 적재만 쓴다(NEP 는 스칼라 부동소수 연산에만 영향). printf 류는 %f 때문에 넣지 않는다.
+    "memcpy", "memmove", "memset", "memcmp", "strlen", "strcmp", "strncmp", "strcpy", "wcslen", "wcscmp", "rand", "srand",
+    // Ember perfpush: 부동소수·로케일 없는 문자열 함수(objdump 로 확인 — msvcrt·ucrtbase·msvcr120 모두 정수 전용, 다른 함수 안 부름)
+    "memchr", "strchr", "strrchr", "strstr", "strcat", "strncpy", "strnlen", "wcschr", "wcsrchr", "wcsstr", "wcscat", "wcscpy",
+    "wcsncmp", "wcsncpy", "wcsnlen",
+    // Ember perfpush: msvcp140 std::mutex(_Mtx_*) — Wine msvcp140 은 ntdll SRW 잠금만 부른다(부동소수 없음, 확인함)
+    "_Mtx_lock", "_Mtx_unlock", "_Mtx_trylock", "_Mtx_current_owns",
+    // std::chrono·조건변수(msvcp140 → QPC·ntdll), 포인터 인코딩, 대기·문자 변환(끝은 시스콜 — 디스패처가 FPCR 을 맞춘다). 모두 objdump 로 부동소수 없음 확인.
+    "_Query_perf_counter", "_Query_perf_frequency", "_Xtime_get_ticks", "_Cnd_signal", "_Cnd_broadcast",
+    "EncodePointer", "DecodePointer", "RtlEncodePointer", "RtlDecodePointer", "WakeConditionVariable", "WakeAllConditionVariable",
+    "RtlWakeConditionVariable", "RtlWakeAllConditionVariable", "WaitForSingleObjectEx", "WaitForMultipleObjects",
+    "WaitForMultipleObjectsEx", "SleepEx", "MultiByteToWideChar", "WideCharToMultiByte",
+};
+
+bool EmberFastApiEnabled() {
+  static int On = -1;
+  if (On < 0) {
+    const char* Env = getenv("EMBER_FEX_FASTAPI");
+    On = !(Env && !strcmp(Env, "0"));
+  }
+  return On;
+}
+
+// 모듈 하나의 내보내기를 표에 넣는다. 전달 내보내기(kernel32 → ntdll 등)는 건너뛴다 — 대상 모듈이 올라올 때 그 이름으로 들어간다.
+// 로더 알림 안에서 불리므로 다른 DLL 을 불러오면 안 된다(GetProcAddress 는 전달을 풀려고 불러올 수 있어 직접 읽는다).
+void EmberAddModule(HMODULE Mod) {
+  ULONG Size;
+  const auto Base = reinterpret_cast<uint64_t>(Mod);
+  const auto* Exp = reinterpret_cast<const IMAGE_EXPORT_DIRECTORY*>(RtlImageDirectoryEntryToData(Mod, true, IMAGE_DIRECTORY_ENTRY_EXPORT, &Size));
+  if (!Exp) return;
+  const auto ExpBegin = reinterpret_cast<uint64_t>(Exp), ExpEnd = ExpBegin + Size;
+  const auto* NameRvas = reinterpret_cast<const DWORD*>(Base + Exp->AddressOfNames);
+  const auto* Ordinals = reinterpret_cast<const WORD*>(Base + Exp->AddressOfNameOrdinals);
+  const auto* Funcs = reinterpret_cast<const DWORD*>(Base + Exp->AddressOfFunctions);
+  int Added = 0;
+  for (DWORD i = 0; i < Exp->NumberOfNames; i++) {
+    const char* Name = reinterpret_cast<const char*>(Base + NameRvas[i]);
+    bool Wanted = false;
+    for (auto W : EmberFastApiNames) if (!strcmp(W, Name)) { Wanted = true; break; }
+    if (!Wanted) continue;
+    const auto Proc = Base + Funcs[Ordinals[i]];
+    if (Proc >= ExpBegin && Proc < ExpEnd) continue;   // 전달
+    const auto Ec = EmberResolveEc(Mod, Proc);
+    if (!Ec) {
+      const auto* B = reinterpret_cast<const uint8_t*>(Proc);
+      LogMan::Msg::DFmt("Ember 빠른 API: {} 해석 실패 {:X} bytes {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} ec={}", Name, Proc,
+                        B[0], B[1], B[2], B[3], B[4], B[5], EmberIsEcCode(Proc));
+      continue;
+    }
+    auto Slot = (Ec * 0x9E3779B97F4A7C15ULL) >> 52;
+    if (EmberFastExitTable[Slot] == Ec || EmberFastExitTable[Slot + 1] == Ec) continue;
+    if (EmberFastExitTable[Slot]) Slot++;
+    if (EmberFastExitTable[Slot]) { LogMan::Msg::DFmt("Ember 빠른 API: {} 충돌", Name); continue; }   // 충돌이면 그냥 느린 길
+    EmberFastExitTable[Slot] = Ec;
+    Added++;
+  }
+  if (Added) LogMan::Msg::DFmt("Ember 빠른 API 전환: {:X} 에서 {}개", Base, Added);
+}
+
+bool EmberFastD3DEnabled() {
+  static int On = -1;
+  if (On < 0) {
+    const char* Env = getenv("EMBER_FEX_FASTD3D");
+    On = EmberFastApiEnabled() && !(Env && !strcmp(Env, "0"));
+  }
+  return On;
+}
+
+// DXMT 빌드인지: winemetal.dll 자신이거나 winemetal.dll 을 가져오는 d3d11·dxgi (다른 구현 — wined3d·DXVK — 은 검사 안 했으니 제외)
+bool EmberImportsWinemetal(HMODULE Mod) {
+  ULONG Size;
+  const auto Base = reinterpret_cast<uint64_t>(Mod);
+  const auto* Imp = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR*>(RtlImageDirectoryEntryToData(Mod, true, IMAGE_DIRECTORY_ENTRY_IMPORT, &Size));
+  if (!Imp) return false;
+  for (; Imp->Name; Imp++) {
+    if (!_stricmp(reinterpret_cast<const char*>(Base + Imp->Name), "winemetal.dll")) return true;
+  }
+  return false;
+}
+
+void EmberAddRange(uint64_t Start, uint64_t Size) {
+  for (size_t i = 0; i + 1 < std::size(EmberFastExitRanges) / 2; i++) {
+    if (EmberFastExitRanges[i * 2] == Start) return;
+    if (EmberFastExitRanges[i * 2]) continue;
+    EmberFastExitRanges[i * 2 + 1] = Start + Size;
+    __atomic_store_n(&EmberFastExitRanges[i * 2], Start, __ATOMIC_RELEASE);
+    LogMan::Msg::DFmt("Ember 빠른 D3D 전환: {:X}-{:X}", Start, Start + Size);
+    return;
+  }
+}
+
+void EmberRemoveRange(uint64_t Start) {
+  for (size_t i = 0; i + 1 < std::size(EmberFastExitRanges) / 2; i++) {
+    if (EmberFastExitRanges[i * 2] == Start) EmberFastExitRanges[i * 2 + 1] = Start;   // 빈 구간으로(칸은 재사용하지 않는다)
+  }
+}
+
+struct EmberDllNotificationData {
+  ULONG Flags;
+  const UNICODE_STRING* FullDllName;
+  const UNICODE_STRING* BaseDllName;
+  void* DllBase;
+  ULONG SizeOfImage;
+};
+
+void CALLBACK EmberDllNotify(ULONG Reason, const EmberDllNotificationData* Data, void*) {
+  static const wchar_t* const Mods[] = {L"kernelbase.dll", L"kernel32.dll", L"ucrtbase.dll", L"msvcrt.dll", L"msvcr120.dll",
+                                        L"msvcr110.dll", L"msvcr100.dll", L"msvcr90.dll", L"msvcr80.dll", L"vcruntime140.dll",
+                                        L"msvcp140.dll"};
+  static const wchar_t* const D3DMods[] = {L"d3d11.dll", L"d3d12.dll", L"dxgi.dll", L"winemetal.dll"};
+  if (!Data || !Data->BaseDllName) return;
+  const auto NameLen = Data->BaseDllName->Length / sizeof(wchar_t);
+  if (Reason == 2 /* UNLOADED */) {
+    EmberRemoveRange(reinterpret_cast<uint64_t>(Data->DllBase));
+    return;
+  }
+  if (Reason != 1 /* LDR_DLL_NOTIFICATION_REASON_LOADED */) return;
+  if (EmberFastD3DEnabled()) {
+    for (auto M : D3DMods) {
+      if (!_wcsnicmp(Data->BaseDllName->Buffer, M, NameLen) && wcslen(M) == NameLen) {
+        const auto Mod = reinterpret_cast<HMODULE>(Data->DllBase);
+        if (!_wcsicmp(M, L"winemetal.dll") || EmberImportsWinemetal(Mod)) {
+          EmberAddRange(reinterpret_cast<uint64_t>(Data->DllBase), Data->SizeOfImage);
+        }
