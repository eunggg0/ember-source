+static int JITWPSupported = -1;
+bool JITWriteProtectSupported() {
+  if (JITWPSupported < 0 && Available()) {
+    FEXUnixLib_JITWriteProtectArgs Args {.Writable = false};
+    JITWPSupported = Call(FEXUnixLibFunctions::JITWriteProtect, &Args) == STATUS_SUCCESS;
+  }
+  return JITWPSupported == 1;
+}
+
+void JITWriteProtect(bool Writable) {
+  if (!JITWriteProtectSupported()) {
+    return;
+  }
+  FEXUnixLib_JITWriteProtectArgs Args {.Writable = Writable};
+  Call(FEXUnixLibFunctions::JITWriteProtect, &Args);
+}
