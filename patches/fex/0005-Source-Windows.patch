+int ImageTracker::EmberOpenCodeMap() {
+  const char* Bucket = FEXCore::DiskCache::EmberAOTBucketPath();
+  if (!Bucket || !*Bucket) {
+    return -1;
+  }
+  LARGE_INTEGER Time;
+  NtQuerySystemTime(&Time);
+  std::string Dir = fmt::format("{}EmberCodeMap", Bucket);
+  std::replace(Dir.begin(), Dir.end(), '/', '\\');
+  const auto Path = fmt::format("{}\\{}.{}.bin", Dir, EmberCodeMapID, Time.QuadPart);
+  auto Widen = [](const std::string& S) {
+    std::wstring W;
+    W.resize(S.size() + 1);
+    DWORD Out = 0;
+    if (!NT_SUCCESS(RtlUTF8ToUnicodeN(W.data(), W.size() * sizeof(wchar_t), &Out, S.data(), S.size()))) {
+      return std::wstring {};
+    }
+    W.resize(Out / sizeof(wchar_t));
+    return W;
+  };
+  const auto WDir = Widen(Dir);
+  const auto WPath = Widen(Path);
+  if (WDir.empty() || WPath.empty()) {
