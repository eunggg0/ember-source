+UNICODE_STRING64 BaseNameOf(const UNICODE_STRING64& Path) {
+  UNICODE_STRING64 Result = Path;
+  const auto* Buf = reinterpret_cast<const WCHAR*>(Path.Buffer);
+  if (!Buf) {
+    return Result;
+  }
+  const size_t Len = Path.Length / sizeof(WCHAR);
+  for (size_t i = Len; i > 0; i--) {
+    if (Buf[i - 1] == L'\\' || Buf[i - 1] == L'/') {
+      Result.Buffer = reinterpret_cast<ULONG64>(Buf + i);
+      Result.Length = static_cast<USHORT>((Len - i) * sizeof(WCHAR));
+      Result.MaximumLength = Result.Length;
+      break;
+    }
+  }
+  return Result;
