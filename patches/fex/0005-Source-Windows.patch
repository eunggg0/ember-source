+bool ContainsNoCase(const UNICODE_STRING64& Str, std::string_view Needle) {
+  const auto* Buf = reinterpret_cast<const WCHAR*>(Str.Buffer);
+  const size_t Len = Str.Length / sizeof(WCHAR);
+  if (!Buf || Needle.empty() || Len < Needle.size()) {
+    return false;
+  }
+  for (size_t i = 0; i + Needle.size() <= Len; i++) {
+    size_t j = 0;
+    for (; j < Needle.size(); j++) {
+      WCHAR C = Buf[i + j];
+      if (C >= L'A' && C <= L'Z') {
+        C = C - L'A' + L'a';
+      }
+      if (C != static_cast<WCHAR>(Needle[j])) {
