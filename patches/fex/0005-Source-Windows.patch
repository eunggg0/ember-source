+namespace {
+bool EmberIsEcCode(uint64_t Address) {
+  const auto* Bitmap = reinterpret_cast<const uint64_t*>(GetCurrentTEB()->Peb->EcCodeBitMap);
+  return Bitmap && ((Bitmap[Address >> 18] >> ((Address >> 12) & 63)) & 1);
+}
+
+// 내보내기 주소(x64 빨리 넘기기 코드일 수 있다) → 실제 ARM64EC 함수 주소
+uint64_t EmberResolveEc(HMODULE Module, uint64_t Address) {
+  for (int Hop = 0; Hop < 4 && Address; Hop++) {
+    // ① 모듈의 CHPE 리디렉션 표
+    ULONG Size;
+    const auto* LoadConfig = reinterpret_cast<_IMAGE_LOAD_CONFIG_DIRECTORY64*>(
+      RtlImageDirectoryEntryToData(Module, true, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG, &Size));
+    if (LoadConfig && LoadConfig->CHPEMetadataPointer) {
+      const auto* Meta = reinterpret_cast<IMAGE_ARM64EC_METADATA*>(LoadConfig->CHPEMetadataPointer);
+      const auto Base = reinterpret_cast<uint64_t>(Module);
+      const auto* It = reinterpret_cast<IMAGE_ARM64EC_REDIRECTION_ENTRY*>(Base + Meta->RedirectionMetadata);
+      const auto Rva = Address - Base;
+      for (ULONG i = 0; i < Meta->RedirectionMetadataCount; i++) {
+        if (It[i].Source == Rva) return Base + It[i].Destination;
+      }
+    }
+    if (EmberIsEcCode(Address)) return Address;
+    // ② x64 점프 따라가기(빨리 넘기기 코드: mov rax,rsp; mov [rax+20],rbx; push rbp; pop rbp; jmp rel32)
+    const auto* B = reinterpret_cast<const uint8_t*>(Address);
+    if (B[0] == 0x48 && B[1] == 0x8b && B[2] == 0xc4 && B[9] == 0xe9) Address = Address + 14 + *reinterpret_cast<const int32_t*>(B + 10);
+    else if (B[0] == 0xe9) Address = Address + 5 + *reinterpret_cast<const int32_t*>(B + 1);
+    else if (B[0] == 0xff && B[1] == 0x25) Address = *reinterpret_cast<const uint64_t*>(Address + 6 + *reinterpret_cast<const int32_t*>(B + 2));
+    else return 0;
+  }
+  return 0;
+}
