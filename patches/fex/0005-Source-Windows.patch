+static constexpr int32_t EMBER_MADV_ZERO_RW = 0x45E0;
+static int ZeroRWSupported = -1;
+bool ZeroRWPages(void* Ptr, size_t Size) {
+  if (!Available() || ZeroRWSupported == 0) {
+    return false;
+  }
+  FEXUnixLib_Madvise Args {
+    .Addr = Ptr,
+    .Size = Size,
+    .Advise = EMBER_MADV_ZERO_RW,
+  };
+  const bool Ok = Call(FEXUnixLibFunctions::Madvise, &Args) == STATUS_SUCCESS;
+  if (ZeroRWSupported < 0) {
+    ZeroRWSupported = Ok ? 1 : 0;
+  }
+  return Ok;
+}
