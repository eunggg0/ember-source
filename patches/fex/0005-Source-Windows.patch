+// Done: 처리한 개수(진행 표시), Cancel: 0 이 아니면 멈춤. 돌려주는 값: 번역(또는 캐시 적중)으로 넘긴 개수.
+extern "C" __attribute__((used)) uint32_t EmberAOTCompile(const uint64_t* RIPs, uint32_t Count, volatile uint32_t* Done,
+                                                          volatile const uint32_t* Cancel) {
+  const auto CPUArea = GetCPUArea();
+  auto* Thread = CPUArea.ThreadState();
+  if (!Thread || !CTX || !ImageTracker || !InvalidationTracker) {
+    return 0;
+  }
+  uint32_t Compiled = 0;
+  for (uint32_t i = 0; i < Count; i++) {
+    if (Cancel && *Cancel) {
+      break;
+    }
+    const uint64_t RIP = RIPs[i];
+    if (ImageTracker->LookupExecutableFileSection(RIP) && !RtlIsEcCode(RIP)) {
+      const auto Range = InvalidationTracker->QueryExecutableRange(RIP);
+      if (Range.Size && Range.Base <= RIP && !Range.Writable) {
+        // 번역 중 FEX 내부 메모리 해제(힙 반납 → NtFreeVirtualMemory)가 통지 콜백으로 FEX 에 다시 들어오면
+        // InvalidateIntervalInternal 이 CodeInvalidationMutex 를 단독으로 잡으려다, 이미 공유로 잡고 있는(CompileBlock)
+        // 같은 스레드가 영원히 기다린다(실측: 작업 스레드 2개가 WaitOnAddress 에서 멈춤). 이 프로세스에선 게스트 코드가
+        // 돌지 않으므로 번역 동안 통지를 끈다(ResetToConsistentState 와 같은 방식).
+        ScopedCallbackDisable NoCallbacks;
+        CTX->CompileRIP(Thread, RIP);
+        Compiled++;
+      }
+    }
+    if (Done) {
+      *Done = i + 1;
+    }
+    // 쓰기 큐가 번역을 못 따라오면(블롭 하나에 파일 잠금·쓰기 몇 번) 큐가 수십만 개·GB 단위로 쌓인다(로아 실측 45만 개).
+    // 큐가 4096 개 아래로 내려갈 때까지 쉰다 — 메모리를 묶고, 진행 표시도 실제로 쓰인 만큼이 된다.
+    while (FEXCore::DiskCache::EmberAOTPending() > 4096 && !(Cancel && *Cancel)) {
+      ::Sleep(2);
+    }
+  }
+  return Compiled;
+}
+
+// 쓰기 큐 비우기(프로세스 끝내기 전에) + 수치. Hits = 이미 디스크 캐시에 있던 블록, Stores = 새로 번역해 저장한 블록.
+extern "C" __attribute__((used)) void EmberAOTFinish(uint64_t* Hits, uint64_t* Stores, char* BucketPath, uint32_t BucketPathSize) {
+  if (CTX) {
+    FEXCore::DiskCache::EmberAOTFlush(CTX.get());
+  }
+  FEXCore::DiskCache::EmberAOTStats(Hits, Stores);
+  if (BucketPath && BucketPathSize) {
+    snprintf(BucketPath, BucketPathSize, "%s", FEXCore::DiskCache::EmberAOTBucketPath());
+  }
+}
+
+// 현재 디스크 캐시 형식 번호와 이 프로세스(이 환경 설정)가 쓰는 버킷 경로.
+extern "C" __attribute__((used)) uint32_t EmberAOTInfo(char* BucketPath, uint32_t BucketPathSize) {
+  if (BucketPath && BucketPathSize) {
+    snprintf(BucketPath, BucketPathSize, "%s", FEXCore::DiskCache::EmberAOTBucketPath());
+  }
+  return FEXCore::DiskCache::GetFormatVersion();
+}
