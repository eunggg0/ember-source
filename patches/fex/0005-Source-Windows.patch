diff --git a/Source/Windows/ARM64EC/CMakeLists.txt b/Source/Windows/ARM64EC/CMakeLists.txt
index 0c9a57a..81848d2 100644
--- a/Source/Windows/ARM64EC/CMakeLists.txt
+++ b/Source/Windows/ARM64EC/CMakeLists.txt
@@ -24,3 +24,7 @@ target_link_libraries(arm64ecfex PRIVATE ${LIBGCC_PATH})
 install(TARGETS arm64ecfex RUNTIME
   DESTINATION ${CMAKE_INSTALL_LIBDIR}
   COMPONENT Runtime)
+
+# macOS 는 16KB 페이지다. 4KB 정렬이면 Wine 이 .text 에 실행 권한을 주지 못한다.
+# Wine 자신의 PE 들과 같은 64KB 로 맞춘다.
+target_link_options(arm64ecfex PRIVATE -Wl,--section-alignment=0x10000,--file-alignment=0x10000)
