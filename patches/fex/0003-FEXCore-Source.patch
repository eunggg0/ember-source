+  template<typename PageList>
+  bool DiskCache::EmberImagePagesStable(Core::InternalThreadState* Thread, const PageList& Pages) {
+    const auto& C = ImgConfig();
+    uint64_t LastHostPage = ~0ULL;
+    for (uint64_t Page : Pages) {
+      if ((Page & ~16383ULL) == LastHostPage) {
+        continue;
+      }
+      LastHostPage = Page & ~16383ULL;
+      auto RI = CTX->SyscallHandler->QueryGuestExecutableRange(Thread, Page);
+      if (RI.Size == 0) {
+        return false;
+      }
+      if (RI.Writable && (!RI.ImageRWX || RI.FullSMC || RI.SMCWrites > C.MaxWrites)) {
+        if (C.Log) {
+          static std::atomic<int> N {};
+          if (N++ < 16) {
+            LogMan::Msg::IFmt("Ember 이미지 RWX 캐시: 걸친 페이지 고정 아님 {:X} full={} writes={}", Page, RI.FullSMC, RI.SMCWrites);
+          }
+        }
+        return false;
+      }
+    }
+    return true;
+  }
