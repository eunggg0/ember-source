+void CodeMapWriter::EmberNoteLibrary(const ExecutableFileSectionInfo& SectionInfo) {
+  {
+    std::shared_lock Lock {Mutex};
+    if (KnownFileIds.contains(SectionInfo.FileInfo.FileId)) {
+      return;
+    }
+  }
+  if (!IsWriteEnabled(SectionInfo)) {
+    return;
+  }
+  bool NewLibraryLoad = false;
+  {
+    std::unique_lock Lock {Mutex};
+    NewLibraryLoad = KnownFileIds.insert(SectionInfo.FileInfo.FileId).second;
+  }
+  if (NewLibraryLoad) {
+    AppendLibraryLoad(SectionInfo.FileInfo);
+  }
+}
+
+void CodeMapWriter::EmberFlushPending() {
+  std::unique_lock Lock {Mutex, std::try_to_lock};
+  if (!Lock.owns_lock() || CodeMapFD.value_or(-1) == -1) {
+    return;
+  }
+  const size_t Offset = BufferOffset.load();
+  if (Offset == 0 || Offset > Buffer.size()) {
+    return; // 넘친 쪽 스레드가 곧 직접 비운다
+  }
+  Flush(Offset, Lock);
+}
+
+void CodeMapWriter::Flush(size_t Offset, std::unique_lock<FEXCore::Utils::EmberRobustSharedMutex>&) {
   write(*CodeMapFD, Buffer.data(), Offset);
   BufferOffset = 0;
 }
