+        if (N++ < 16) {
+          LogMan::Msg::IFmt("Ember 이미지 RWX 캐시: 고정 아님 {:X} full={} writes={}", RangeInfo.Base, RangeInfo.FullSMC, RangeInfo.SMCWrites);
