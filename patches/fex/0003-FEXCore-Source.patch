+  return ptr ? WineHeapUsable(ptr) : 0;
+}
+void* aligned_alloc(size_t a, size_t s) {
+  return WineHeapAlloc(a, s);
+}
+void aligned_free(void* ptr) {
+  WineHeapFree(ptr);
+}
