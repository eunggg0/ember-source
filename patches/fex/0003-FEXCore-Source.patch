+
+static bool EmberMultiblockHasLock(const fextl::vector<FEXCore::Frontend::Decoder::DecodedBlocks>& Blocks) {
+  auto IsMem = [](const FEXCore::X86Tables::DecodedOperand& Op) {
+    return !Op.IsNone() && !Op.IsGPR() && !Op.IsLiteral();
+  };
+  for (const auto& B : Blocks) {
+    for (size_t i = 0; i < B.NumInstructions; ++i) {
+      const auto& Inst = B.DecodedInstructions[i];
+      if (Inst.Flags & FEXCore::X86Tables::DecodeFlags::FLAG_LOCK) {
+        return true;
+      }
+      // XCHG 는 메모리 피연산자면 접두 없이도 잠금(_InterlockedExchange).
+      if (Inst.TableInfo && Inst.TableInfo->Name && Inst.TableInfo->Name[0] == 'X' && strcmp(Inst.TableInfo->Name, "XCHG") == 0 &&
+          (IsMem(Inst.Dest) || IsMem(Inst.Src[0]))) {
+        return true;
+      }
+    }
+  }
+  return false;
 }
 
