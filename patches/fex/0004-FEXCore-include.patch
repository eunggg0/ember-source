--- a/FEXCore/include/FEXCore/Core/CodeCache.h
+++ b/FEXCore/include/FEXCore/Core/CodeCache.h
@@ -161,6 +161,11 @@ public:
   // Thread-safely commit any pending data to disk
   void Flush(size_t Offset);
 
+  // Ember(10-01): 프로세스가 끝나기 직전 버퍼에 남은 기록을 쓴다(잠금을 못 잡으면 건너뜀). 파일이 열려 있지 않으면 아무것도 안 함.
+  void EmberFlushPending();
+  // Ember(10-01): 디스크 캐시 적중 때 — 처음 보는 이미지면 이미지 기록(경로·FileId)만 남긴다.
+  void EmberNoteLibrary(const ExecutableFileSectionInfo&);
+
 private:
   // Queues data into an internal ring buffer.
   // Call Flush() to commit the data to disk.
