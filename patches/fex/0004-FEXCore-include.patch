diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index c4cadf4..64dcfe4 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -37,8 +37,10 @@ FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize);
 #else
 using VirtualNamePtr = void (*)(const char*, const void*, size_t);
 using VirtualTHPPtr = void (*)(const void*, size_t, THPControl);
+using JITWriteProtectPtr = void (*)(bool);
 struct HookPtrs {
   VirtualNamePtr VirtualName;
+  JITWriteProtectPtr JITWriteProtect;
   VirtualTHPPtr VirtualTHPControl;
 };
 FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize, HookPtrs Ptrs);
@@ -46,7 +48,30 @@ FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize, HookPtrs Ptrs);
 FEX_DEFAULT_VISIBILITY void ClearHooks();
 
 #ifdef _WIN32
+// Ember: FEX 가 자기 메모리(코드 버퍼 등)를 잡고 놓을 때 ARM64EC ntdll 래퍼가 FEX 자신의 Notify* 콜백을 되부른다.
+// 코드 버퍼를 바꿔 옛 것을 해제하는 순간은 번역 잠금(CodeInvalidationMutex)을 쥔 채라, 콜백의 무효화가 같은 잠금을
+// 다시 잡으려다 스스로 교착했다(.NET Mono·큰 게임, 2026-09-26 lldb 로 확인). 게스트 코드가 아니니 통지를 끈다.
+FEX_DEFAULT_VISIBILITY extern bool (*SuppressMemoryNotifyHook)(bool);
+// Ember perfpush: VirtualDontNeed(Recommit) 를 Wine 의 VirtualFree(DECOMMIT)+VirtualAlloc(COMMIT) 대신
+// 호스트 mmap(MAP_FIXED, RW, 익명) 한 번으로 — 같은 보호 그대로 0 으로 바뀌고, Wine 의 전역 virtual_mutex·페이지 표 갱신·
+// 비커밋 틈(다른 스레드가 그 사이 접근하면 AV)이 없다. SMC 무효화마다 모든 스레드의 4MB 콜-리턴 스택에 불린다.
+// 훅이 false 를 돌려주면(옛 unixlib 등) 원래 길로. EmberCallRetMode: 1=빠른 길(기본), 0=원래 길(EMBER_FEX_CALLRET=0).
+FEX_DEFAULT_VISIBILITY extern int EmberCallRetMode;
+FEX_DEFAULT_VISIBILITY extern bool (*ZeroRWPagesHook)(void*, size_t);
+struct ScopedSuppressMemoryNotify {
+  bool Prev;
+  ScopedSuppressMemoryNotify() {
+    Prev = SuppressMemoryNotifyHook ? SuppressMemoryNotifyHook(true) : false;
+  }
+  ~ScopedSuppressMemoryNotify() {
+    if (SuppressMemoryNotifyHook) {
+      SuppressMemoryNotifyHook(Prev);
+    }
+  }
+};
+
 inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Commit = true) {
+  ScopedSuppressMemoryNotify Suppress;
   // Allocate top-down to avoid polluting the lower VA space, as even on 64-bit some programs (i.e. LuaJIT) require allocations below 4GB.
   DWORD Flags = (Commit ? MEM_COMMIT : 0) | MEM_RESERVE | MEM_TOP_DOWN;
 #ifdef ARCHITECTURE_arm64ec
@@ -67,10 +92,16 @@ inline void* VirtualAlloc(size_t Size, bool Execute = false, bool Commit = true)
 }
 
 inline void VirtualFree(void* Ptr, size_t Size) {
+  ScopedSuppressMemoryNotify Suppress;
   ::VirtualFree(Ptr, 0, MEM_RELEASE);
 }
 
 inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
+  if (Recommit && EmberCallRetMode == 1 && ZeroRWPagesHook && ((reinterpret_cast<uintptr_t>(Ptr) | Size) & 0x3FFF) == 0 &&
+      ZeroRWPagesHook(Ptr, Size)) {
+    return;
+  }
+  ScopedSuppressMemoryNotify Suppress;
   // Zero the page-aligned region, preserving permissions.
   MEMORY_BASIC_INFORMATION Info;
   ::VirtualQuery(Ptr, &Info, sizeof(Info));
@@ -81,6 +112,7 @@ inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
 }
 
 inline bool VirtualProtect(void* Ptr, size_t Size, ProtectOptions options) {
+  ScopedSuppressMemoryNotify Suppress;
   DWORD prot {PAGE_NOACCESS};
 
   if (options == ProtectOptions::None) {
@@ -103,6 +135,15 @@ inline bool VirtualProtect(void* Ptr, size_t Size, ProtectOptions options) {
 
 FEX_DEFAULT_VISIBILITY extern VirtualNamePtr VirtualName;
 FEX_DEFAULT_VISIBILITY extern VirtualTHPPtr VirtualTHPControl;
+FEX_DEFAULT_VISIBILITY extern JITWriteProtectPtr JITWriteProtect;
+
+// macOS(Wine) 의 MAP_JIT 코드 버퍼는 스레드별로 "쓰기" 또는 "실행" 한쪽만 열린다.
+// 코드를 쓰는 동안만 쓰기로 돌리고, 끝나면 실행으로 되돌린다. 다른 플랫폼에선 빈 동작.
+struct ScopedJITWrite {
+  ScopedJITWrite() { if (JITWriteProtect) JITWriteProtect(true); }
+  ~ScopedJITWrite() { if (JITWriteProtect) JITWriteProtect(false); }
+  ScopedJITWrite(const ScopedJITWrite&) = delete;
+};
 #else
 using MMAP_Hook = void* (*)(void*, size_t, int, int, int, off_t);
 using MUNMAP_Hook = int (*)(void*, size_t);
diff --git a/FEXCore/include/FEXCore/Utils/LongJump.h b/FEXCore/include/FEXCore/Utils/LongJump.h
index df8e4b7..6d1cbd3 100644
--- a/FEXCore/include/FEXCore/Utils/LongJump.h
+++ b/FEXCore/include/FEXCore/Utils/LongJump.h
@@ -33,7 +33,10 @@ struct JumpBuf {
 };
 #endif
 
-[[nodiscard]] FEX_DEFAULT_VISIBILITY uint64_t SetJump(JumpBuf& Buffer);
+// Ember cefsmc: setjmp 처럼 두 번 돌아온다고 컴파일러에 알린다. 이게 없으면 SetJump 뒤에 쓰는 지역값(스택 칸)을
+// 컴파일러가 다른 값에 재사용해, LongJump 로 돌아왔을 때 쓰레기를 읽는다(JIT 재시작 때 Relocations.resize(쓰레기) →
+// 128TB 할당 실패 → FEX 안에서 AV. 로아 CEF 렌더러가 시작하자마자 죽던 원인, 2026-10-01).
+[[nodiscard]] FEX_DEFAULT_VISIBILITY __attribute__((returns_twice)) uint64_t SetJump(JumpBuf& Buffer);
 [[noreturn]] FEX_DEFAULT_VISIBILITY void LongJump(const JumpBuf& Buffer, uint64_t Value);
 FEX_DEFAULT_VISIBILITY void ManuallyLoadJumpBuf(const JumpBuf& Buffer, uint64_t Value, uint64_t* GPRs, __uint128_t* FPRs, uint64_t* PC);
 } // namespace FEXCore::UncheckedLongJump
diff --git a/FEXCore/include/FEXCore/Utils/TypeDefines.h b/FEXCore/include/FEXCore/Utils/TypeDefines.h
index ec03ac6..59cdc7c 100644
