diff --git a/FEXCore/include/FEXCore/Core/GuestBase.h b/FEXCore/include/FEXCore/Core/GuestBase.h
new file mode 100644
index 0000000..ed706dd
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/GuestBase.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: MIT
+// fex32: 32비트 게스트 주소공간을 호스트의 4GB 정렬 창 [GuestBase, GuestBase+4G) 에 둔다.
+// macOS arm64 는 4GB 아래를 매핑할 수 없어서다. 0 이면 꺼짐(게스트 주소 = 호스트 주소).
+#pragma once
+#include <cstdint>
+
+namespace FEXCore::Core {
+extern uint64_t GuestBase;
+
+// 게스트 32비트 주소 → 호스트 포인터 값
+static inline uint64_t GuestToHost(uint64_t Addr) {
+  return GuestBase ? (GuestBase | (Addr & 0xFFFF'FFFFULL)) : Addr;
+}
+
+// 호스트(창 안) → 게스트 32비트 값
+static inline uint64_t HostToGuest(uint64_t Addr) {
+  return GuestBase ? (Addr & 0xFFFF'FFFFULL) : Addr;
+}
+
+// 어느 쪽이든 받아 호스트로 맞춘다(4GB 아래 값은 게스트 주소로 본다)
+static inline uint64_t NormalizeToHost(uint64_t Addr) {
+  return (GuestBase && Addr < (1ULL << 32)) ? (GuestBase | Addr) : Addr;
+}
+
+// 호스트 주소가 창 안인가
+static inline bool IsInGuestWindow(uint64_t Addr) {
+  return GuestBase && (Addr & ~0xFFFF'FFFFULL) == GuestBase;
+}
+} // namespace FEXCore::Core
diff --git a/FEXCore/include/FEXCore/HLE/SyscallHandler.h b/FEXCore/include/FEXCore/HLE/SyscallHandler.h
