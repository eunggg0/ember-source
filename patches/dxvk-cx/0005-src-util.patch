+#include <algorithm>
 #include <array>
 #include <fstream>
 #include <sstream>
diff --git a/src/util/config/config.h b/src/util/config/config.h
index f947272..51f209d 100644
--- a/src/util/config/config.h
+++ b/src/util/config/config.h
