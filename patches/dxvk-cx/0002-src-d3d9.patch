@@ -5633,6 +5637,23 @@ namespace dxvk {
       }
     }
 
+    // Ember: 첨부가 하나도 없는 렌더 패스를 만들지 않는다. 색 쓰기를 끈 렌더 타깃은 위에서 빠지고 깊이 검사도 꺼져 있으면
+    // (Source 엔진 HDR·가시성 질의 단계 등) 첨부 0개 패스가 되는데, Apple GPU 는 첨부 없는 Metal 렌더 인코더에서 검증 없이
+    // 명령 버퍼를 버린다(MoltenVK "execution failed (code 1): Internal Error (0000010d)" → VK_ERROR_DEVICE_LOST,
+    // 레프트 4 데드 2 c1m1_hotel 로딩 중 실측). 그럴 땐 첫 렌더 타깃을 그대로 붙인다 — 쓰기 마스크가 0 이라 아무것도 쓰지 않는다.
+    bool anyAttachment = attachments.depth.view != nullptr;
