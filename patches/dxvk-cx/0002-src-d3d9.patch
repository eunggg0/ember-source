diff --git a/src/d3d9/d3d9_swapchain.cpp b/src/d3d9/d3d9_swapchain.cpp
index 29e3b6e..99c4630 100644
--- a/src/d3d9/d3d9_swapchain.cpp
+++ b/src/d3d9/d3d9_swapchain.cpp
@@ -814,6 +814,28 @@ namespace dxvk {
 
 
   void D3D9SwapChainEx::PresentImage(UINT SyncInterval) {
+    // Ember: EMBER_FPS_LOG=1 — 5초마다 present 수(DXMT·D3DMetal 미터와 같은 형식, 변환기 비교·자동 측정용).
+    // GUI 게임은 CRT 환경이 비어 있을 수 있어 Windows 환경 변수로 읽고, 출력은 DXVK 로거(게임 폴더 <exe>_d3d9.log + stderr).
+    {
+      static int fpsLog = -1;
+      if (fpsLog < 0) fpsLog = env::getEnvVar("EMBER_FPS_LOG") == "1";
+      if (fpsLog) {
+        static dxvk::high_resolution_clock::time_point since{}, last{};
+        static uint32_t n = 0; static double maxdt = 0;
+        auto t = dxvk::high_resolution_clock::now();
+        if (last.time_since_epoch().count()) maxdt = std::max(maxdt, std::chrono::duration<double>(t - last).count());
+        last = t;
+        if (!since.time_since_epoch().count()) since = t;
+        n++;
+        double el = std::chrono::duration<double>(t - since).count();
+        if (el >= 5.0) {
+          Logger::info(str::format("ember-fps: dxvk ", uint32_t(n / el * 10) / 10.0, "/s max=", uint32_t(maxdt * 10000) / 10.0,
+            "ms ", m_presentParams.BackBufferWidth, "x", m_presentParams.BackBufferHeight));
+          n = 0; maxdt = 0; since = t;
+        }
+      }
+    }
+
     m_parent->Flush();
 
     // Retrieve the image and image view to present
