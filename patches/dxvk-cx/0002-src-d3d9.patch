   void D3D9DeviceEx::SetupFPU() {
     // Should match d3d9 float behaviour.
 
-#if defined(_MSC_VER)
+#if defined(__arm64ec__) || defined(__aarch64__)
+    // Ember: ARM64EC(FEX) 빌드 — x64 빌드의 fldcw 는 x87 만 바꿔 DXVK 의 SSE 계산에 영향이 없다. 여기서 _controlfp 로
