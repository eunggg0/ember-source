+  void DxvkContext::trackAsyncRenderTargets() {
+    // Ember: 원본 패치는 드로 중에 프레임버퍼가 다시 바인딩될 때만 기록한다.
+    // 프레임 첫머리의 Clear 가 먼저 프레임버퍼를 바인딩하면 드로에서는 기록이
+    // 안 돼 비동기가 거의 켜지지 않는다. 그래서 드로마다, 프레임버퍼가 바뀌었거나
+    // 새 프레임일 때만 현재 렌더 타깃에 프레임 번호를 남긴다.
+    uint32_t frameId = m_device->getCurrentFrameId();
+
+    if (likely(!m_asyncRtDirty && frameId == m_asyncRtFrameId))
+      return;
+
+    m_asyncRtDirty   = false;
+    m_asyncRtFrameId = frameId;
+
+    const DxvkFramebufferInfo& fbInfo = m_state.om.framebufferInfo;
+
+    for (uint32_t i = 0; i < fbInfo.numAttachments(); i++)
+      fbInfo.getAttachment(i).view->setRtBindingFrameId(frameId);
+  }
+
+
+  bool DxvkContext::checkAsyncCompilationCompat() {
+    if (!m_device->config().enableAsync)
+      return false;
+
+    // Ember: 원본 dxvk-async 는 렌더 타깃 조건만 본다. 트랜스폼 피드백이나
+    // 오클루전·파이프라인 통계 쿼리가 켜진 동안 드로를 건너뛰면 결과 값이
+    // 틀어지므로 그때는 기존처럼 동기로 컴파일한다.
+    if (m_flags.test(DxvkContextFlag::GpXfbActive)
+     || m_state.gp.flags.test(DxvkGraphicsPipelineFlag::HasTransformFeedback)
+     || m_queryManager.hasEnabledQueries(VK_QUERY_TYPE_OCCLUSION)
+     || m_queryManager.hasEnabledQueries(VK_QUERY_TYPE_PIPELINE_STATISTICS))
+      return false;
+
+    // Framebuffers without any attachments are rejected as well,
+    // since there is no render target whose use we could track.
+    uint32_t numAttachments = m_state.om.framebufferInfo.numAttachments();
+
+    if (!numAttachments)
+      return false;
+
+    for (uint32_t i = 0; i < numAttachments; i++) {
+      const auto& attachment = m_state.om.framebufferInfo.getAttachment(i);
+
+      if (!attachment.view->getRtBindingAsyncCompilationCompat())
+        return false;
+    }
+
+    return true;
+  }
+
