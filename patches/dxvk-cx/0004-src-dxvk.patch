diff --git a/src/dxvk/dxvk_pipecompiler.cpp b/src/dxvk/dxvk_pipecompiler.cpp
new file mode 100644
index 0000000..12b4cbf
--- /dev/null
+++ b/src/dxvk/dxvk_pipecompiler.cpp
@@ -0,0 +1,133 @@
+#include "dxvk_device.h"
+#include "dxvk_graphics.h"
+#include "dxvk_pipecompiler.h"
+
+namespace dxvk {
+
+  DxvkPipelineCompiler::DxvkPipelineCompiler(const DxvkDevice* device)
+  : m_device(device) {
+
+  }
+
+
+  DxvkPipelineCompiler::~DxvkPipelineCompiler() {
+    this->stopWorkerThreads();
+  }
+
+
+  void DxvkPipelineCompiler::queueCompilation(
+          DxvkGraphicsPipeline*             pipeline,
+    const DxvkGraphicsPipelineStateInfo&    state,
+    const DxvkRenderPass*                   renderPass) {
+    size_t key = computeKey(pipeline, state, renderPass);
+
+    std::lock_guard<dxvk::mutex> lock(m_compilerLock);
+
+    if (m_compilerStop.load())
+      return;
+
+    // Ember: 파이프라인이 준비될 때까지 드로마다 여기로 다시 온다.
+    // 같은 상태가 큐에 쌓이지 않도록 대기 중인 키는 건너뛴다.
+    // 해시 충돌이면 한쪽이 끝난 뒤 다음 드로에서 다시 큐에 들어간다.
+    if (!m_compilerPending.insert(key).second)
+      return;
+
+    this->createWorkers();
+
+    m_pendingCount += 1;
+    m_compilerQueue.push({ pipeline, state, renderPass, key });
+    m_compilerCond.notify_one();
+  }
+
+
+  void DxvkPipelineCompiler::stopWorkerThreads() {
+    { std::lock_guard<dxvk::mutex> lock(m_compilerLock);
+
+      if (m_compilerStop.exchange(true))
+        return;
+
+      m_compilerCond.notify_all();
+    }
+
+    for (auto& thread : m_compilerThreads)
+      thread.join();
+
+    m_compilerThreads.clear();
+  }
+
+
+  void DxvkPipelineCompiler::createWorkers() {
+    if (!m_compilerThreads.empty())
+      return;
+
+    uint32_t numCpuCores = dxvk::thread::hardware_concurrency();
+    uint32_t numWorkers  = ((std::max(1u, numCpuCores) - 1) * 5) / 7;
+
+    if (numWorkers <  1) numWorkers =  1;
+    if (numWorkers > 32) numWorkers = 32;
+
+    if (m_device->config().numAsyncThreads > 0)
+      numWorkers = m_device->config().numAsyncThreads;
+
+    Logger::info(str::format("DXVK: Using ", numWorkers, " async compiler threads"));
+
+    for (uint32_t i = 0; i < numWorkers; i++)
+      m_compilerThreads.emplace_back([this] () { this->runCompilerThread(); });
+  }
+
+
+  void DxvkPipelineCompiler::runCompilerThread() {
+    env::setThreadName("dxvk-pcompiler");
+
+    while (!m_compilerStop.load()) {
+      PipelineEntry entry;
+
+      { std::unique_lock<dxvk::mutex> lock(m_compilerLock);
+
+        m_compilerCond.wait(lock, [this] {
+          return m_compilerStop.load()
+              || !m_compilerQueue.empty();
+        });
+
+        if (m_compilerStop.load())
+          break;
+
+        entry = std::move(m_compilerQueue.front());
+        m_compilerQueue.pop();
+      }
+
+      if (entry.pipeline->compileAsyncPipeline(entry.state, entry.renderPass))
+        entry.pipeline->writePipelineStateToCache(entry.state, entry.renderPass->format());
+
+      // Only remove the key once the pipeline instance is visible
+      // to the context, otherwise it could get queued again.
+      { std::lock_guard<dxvk::mutex> lock(m_compilerLock);
+        m_compilerPending.erase(entry.key);
+        m_pendingCount -= 1;
+      }
+    }
+  }
+
+
+  size_t DxvkPipelineCompiler::computeKey(
+    const DxvkGraphicsPipeline*             pipeline,
+    const DxvkGraphicsPipelineStateInfo&    state,
+    const DxvkRenderPass*                   renderPass) {
+    // FNV-1a over the raw state vector, which is compared
+    // bytewise as well when looking up pipeline instances
+    auto data = reinterpret_cast<const uint8_t*>(&state);
+    uint64_t hash = 0xcbf29ce484222325ull;
+
+    for (size_t i = 0; i < sizeof(state); i++) {
+      hash ^= data[i];
+      hash *= 0x100000001b3ull;
+    }
+
+    DxvkHashState result;
+    result.add(size_t(hash));
+    result.add(reinterpret_cast<uintptr_t>(pipeline));
+    result.add(reinterpret_cast<uintptr_t>(renderPass));
+    return result;
+  }
+
+}
diff --git a/src/dxvk/dxvk_pipecompiler.h b/src/dxvk/dxvk_pipecompiler.h
new file mode 100644
index 0000000..6494f70
--- /dev/null
+++ b/src/dxvk/dxvk_pipecompiler.h
@@ -0,0 +1,95 @@
+#pragma once
+
+#include <atomic>
+#include <queue>
+#include <unordered_set>
+#include <vector>
+
+#include "../util/thread.h"
+
+#include "dxvk_graphics_state.h"
+#include "dxvk_include.h"
+
+// Ember: dxvk-async (Sporif/dxvk-async, 1.10.2-1.10.3 용 af418dc 패치) 이식.
+// 아직 없는 그래픽 파이프라인을 별도 스레드에서 만들고, 그동안 드로는 건너뛴다.
+// 원본 패치와 달리 같은 상태를 드로마다 다시 큐에 넣지 않도록 대기 목록을 둔다.
+
+namespace dxvk {
+
+  class DxvkDevice;
+  class DxvkGraphicsPipeline;
+  class DxvkRenderPass;
+
+  /**
+   * \brief Pipeline compiler
+   *
+   * Asynchronous graphics pipeline compiler.
+   * Worker threads are created on first use.
+   */
+  class DxvkPipelineCompiler : public RcObject {
+
+  public:
+
+    DxvkPipelineCompiler(const DxvkDevice* device);
+    ~DxvkPipelineCompiler();
+
+    /**
+     * \brief Compiles a pipeline asynchronously
+     *
+     * Does nothing if the same pipeline state is
+     * already queued or currently being compiled.
+     * \param [in] pipeline The pipeline object
+     * \param [in] state The pipeline state info object
+     * \param [in] renderPass The render pass
+     */
+    void queueCompilation(
+            DxvkGraphicsPipeline*             pipeline,
+      const DxvkGraphicsPipelineStateInfo&    state,
+      const DxvkRenderPass*                   renderPass);
+
+    /**
+     * \brief Checks whether pipelines are being compiled
+     * \returns \c true if the queue is not empty
+     */
+    bool isCompilingShaders() const {
+      return m_pendingCount.load() != 0;
+    }
+
+    /**
+     * \brief Stops compiler threads
+     *
+     * Pending pipelines are discarded.
+     */
+    void stopWorkerThreads();
+
+  private:
+
+    struct PipelineEntry {
+      DxvkGraphicsPipeline*                   pipeline = nullptr;
+      DxvkGraphicsPipelineStateInfo           state;
+      const DxvkRenderPass*                   renderPass = nullptr;
+      size_t                                  key = 0;
+    };
+
+    const DxvkDevice*           m_device;
+
+    std::atomic<bool>           m_compilerStop = { false };
+    std::atomic<uint32_t>       m_pendingCount = { 0u };
+    dxvk::mutex                 m_compilerLock;
+    dxvk::condition_variable    m_compilerCond;
+    std::queue<PipelineEntry>   m_compilerQueue;
+    std::unordered_set<size_t>  m_compilerPending;
+    std::vector<dxvk::thread>   m_compilerThreads;
+
+    void createWorkers();
+
+    void runCompilerThread();
+
+    static size_t computeKey(
+      const DxvkGraphicsPipeline*             pipeline,
+      const DxvkGraphicsPipelineStateInfo&    state,
+      const DxvkRenderPass*                   renderPass);
+
+  };
+
+}
