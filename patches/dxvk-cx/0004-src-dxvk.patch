+    /**
+     * \brief Sets render target usage frame number
+     *
+     * The image view will track internally when
+     * it was last used as a render target. This
+     * info is used for async shader compilation.
+     * \param [in] frameId Frame number
+     */
+    void setRtBindingFrameId(uint32_t frameId) {
+      if (frameId != m_rtBindingFrameId) {
+        // Ember: 원본은 바로 앞 프레임만 연속으로 친다. d3d9 백버퍼는 Present 마다
+        // 이미지가 돌아가서(백버퍼 수+1개, 최대 4개) 같은 뷰가 2~4 프레임마다 온다.
+        // 그러면 백버퍼 드로가 영영 비동기가 안 되므로 4 프레임 간격까지 연속으로 본다.
+        if (frameId - m_rtBindingFrameId <= 4)
+          m_rtBindingFrameCount += 1;
+        else
+          m_rtBindingFrameCount = 0;
+
+        m_rtBindingFrameId = frameId;
+      }
+    }
+
+    /**
+     * \brief Checks for async pipeline compatibility
+     *
+     * Asynchronous pipeline compilation may be enabled if the
+     * render target has been drawn to in the previous frames.
+     * Render targets that are only drawn to once, e.g. during
+     * loading, never qualify, since skipping a draw would
+     * permanently corrupt their contents.
+     * \returns \c true if async compilation is supported
+     */
+    bool getRtBindingAsyncCompilationCompat() const {
+      return m_rtBindingFrameCount >= 5;
+    }
+
   private:
     
     Rc<vk::DeviceFn>  m_vkd;
