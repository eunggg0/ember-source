+ * mapped as RAM.  For anything other than a single-GPR load/store without
+ * writeback (LDP/STP, SIMD&FP LDR/STR, pre/post-index, ...) the syndrome has
+ * no instruction info (ISV=0) and upstream QEMU just does assert(isv), which
+ * kills the whole VM with SIGABRT.  With virtio-gpu blob/hostmem (Neptune)
+ * this happens when the guest still touches a blob window the host already
+ * removed from the hostmem BAR (RESOURCE_UNREF / UNMAP_BLOB / reset) -- every
+ * Windows shutdown of the S2 VM ended that way.
+ *
+ * Decode the common A64 load/store forms and emulate them through the
+ * address space, exactly like the ISV=1 path (unassigned space reads 0,
+ * writes are dropped).  Anything we cannot decode gets a synchronous external
+ * abort injected into the guest (what KVM does for ISV=0), never a host
+ * abort.  EMBER_HVF_NISV_ABORT=1 restores the old abort for debugging.
+ */
+static uint64_t hvf_nisv_xreg(CPUARMState *env, int r, bool r31_is_sp)
+{
+    if (r == 31) {
+        /* QEMU keeps the current SP in xregs[31] for AArch64 */
+        return r31_is_sp ? env->xregs[31] : 0;
+    }
+    return env->xregs[r];
+}
+
+static bool hvf_nisv_emulate(CPUARMState *env, uint32_t insn,
+                             uint64_t far, uint64_t ipa, bool *is_write)
+{
+    const uint64_t va_mask = MAKE_64BIT_MASK(0, 56); /* ignore TBI tag byte */
+    int rt = extract32(insn, 0, 5);
+    int rn = extract32(insn, 5, 5);
+    int rt2 = rt;
+    bool vec = extract32(insn, 26, 1);
+    bool load, sign = false, ext32 = false, wback = false, post = false;
+    unsigned scale, esize, nregs = 1, i;
+    int64_t offset;
+    uint64_t base, addr, total, pa0;
+    uint8_t buf[32];
+
+    if ((insn & 0x3a000000) == 0x28000000) {
+        /* Load/store register pair: LDP/STP/LDNP/STNP/LDPSW (+SIMD&FP) */
+        unsigned opc = extract32(insn, 30, 2);
+        unsigned idx = extract32(insn, 23, 2);
+
+        load = extract32(insn, 22, 1);
+        rt2 = extract32(insn, 10, 5);
+        nregs = 2;
+        if (opc == 3) {
+            return false;
+        }
+        if (vec) {
+            scale = 2 + opc;                     /* S, D, Q */
+        } else if (opc == 1) {
+            if (!load || idx == 0) {
+                return false;                    /* STGP, reserved LDNPSW */
+            }
+            sign = true;                         /* LDPSW */
+            scale = 2;
+        } else {
+            scale = opc ? 3 : 2;                 /* X or W */
+        }
+        offset = (int64_t)sextract32(insn, 15, 7) * (int64_t)(1u << scale);
+        wback = (idx == 1 || idx == 3);
+        post = (idx == 1);
+        if (load && rt == rt2) {
+            return false;                        /* CONSTRAINED UNPREDICTABLE */
+        }
+    } else if ((insn & 0x3a000000) == 0x38000000) {
+        /* Load/store register (single) */
+        unsigned size = extract32(insn, 30, 2);
+        unsigned opc = extract32(insn, 22, 2);
+
+        if (vec) {
+            scale = ((opc & 2) << 1) | size;     /* B, H, S, D, Q */
+            if (scale > 4) {
+                return false;
+            }
+            load = opc & 1;
+        } else {
+            scale = size;
+            switch (opc) {
+            case 0:
+                load = false;
+                break;
+            case 1:
+                load = true;
+                break;
+            case 2:
+                if (size == 3) {
+                    return false;                /* PRFM */
+                }
+                load = true;
+                sign = true;                     /* LDRSB/LDRSH/LDRSW -> X */
+                break;
+            default:
+                if (size >= 2) {
+                    return false;
+                }
+                load = true;
+                sign = true;                     /* LDRSB/LDRSH -> W */
+                ext32 = true;
+                break;
+            }
+        }
+
+        if (extract32(insn, 24, 1)) {
+            /* unsigned, scaled 12-bit immediate */
+            offset = (int64_t)((uint64_t)extract32(insn, 10, 12) << scale);
+        } else if (!extract32(insn, 21, 1)) {
+            /* unscaled 9-bit immediate: LDUR/STUR, post, LDTR/STTR, pre */
+            unsigned idx = extract32(insn, 10, 2);
+
+            if (idx == 2 && vec) {
+                return false;
+            }
+            offset = sextract32(insn, 12, 9);
+            wback = (idx == 1 || idx == 3);
+            post = (idx == 1);
+        } else if (extract32(insn, 10, 2) == 2) {
+            /* register offset */
+            int rm = extract32(insn, 16, 5);
+            unsigned option = extract32(insn, 13, 3);
+            uint64_t m = hvf_nisv_xreg(env, rm, false);
+
+            switch (option) {
+            case 2: /* UXTW */
+                m = (uint32_t)m;
+                break;
+            case 3: /* LSL / UXTX */
+            case 7: /* SXTX */
+                break;
+            case 6: /* SXTW */
+                m = (uint64_t)(int64_t)(int32_t)m;
+                break;
+            default:
+                return false;
+            }
+            offset = (int64_t)(m << (extract32(insn, 12, 1) ? scale : 0));
+        } else {
+            return false;                        /* atomics, LDRAA/LDRAB ... */
+        }
+    } else {
+        return false;                            /* exclusives, LD1/ST1, ... */
+    }
+
+    if (!vec && wback && rn != 31 && (rn == rt || (nregs == 2 && rn == rt2))) {
+        return false;                            /* CONSTRAINED UNPREDICTABLE */
+    }
+
+    esize = 1u << scale;
+    total = (uint64_t)esize * nregs;
+    base = hvf_nisv_xreg(env, rn, true);
+    addr = post ? base : base + offset;
+
+    /*
+     * Sanity check the decode against the hardware: FAR must point inside
+     * the access we decoded and the whole access must sit in one 4K guest
+     * page, so the IPA of every element is a fixed offset from the fault IPA.
+     */
+    if (((far - addr) & va_mask) >= total ||
+        ((addr & va_mask) >> 12) != (((addr + total - 1) & va_mask) >> 12)) {
+        return false;
+    }
+    pa0 = ipa - ((far - addr) & va_mask);
+
+    *is_write = !load;
+    memset(buf, 0, sizeof(buf));
+
+    for (i = 0; i < nregs; i++) {
+        int r = i ? rt2 : rt;
+        uint8_t *p = buf + i * esize;
+
+        if (load) {
+            address_space_read(&address_space_memory, pa0 + i * esize,
+                               MEMTXATTRS_UNSPECIFIED, p, esize);
+        } else {
+            if (vec) {
+                memcpy(p, &env->vfp.zregs[r].d[0], esize);
+            } else {
+                uint64_t v = hvf_nisv_xreg(env, r, false);
+                memcpy(p, &v, esize);
+            }
+            address_space_write(&address_space_memory, pa0 + i * esize,
+                                MEMTXATTRS_UNSPECIFIED, p, esize);
+        }
+    }
+
+    if (load) {
+        for (i = 0; i < nregs; i++) {
+            int r = i ? rt2 : rt;
+            uint8_t *p = buf + i * esize;
+
+            if (vec) {
+                /* writing a V register zeroes the rest of it */
+                memset(&env->vfp.zregs[r], 0, sizeof(env->vfp.zregs[r]));
+                memcpy(&env->vfp.zregs[r].d[0], p, esize);
+            } else if (r != 31) {
+                uint64_t v = 0;
+
+                memcpy(&v, p, esize);
+                if (sign) {
+                    v = sextract64(v, 0, esize * 8);
+                    if (ext32) {
+                        v = (uint32_t)v;
+                    }
+                }
+                env->xregs[r] = v;
+            }
+        }
+    }
+
+    if (wback) {
+        env->xregs[rn] = base + offset;          /* rn == 31 updates SP */
+    }
+
+    return true;
+}
+
+static void hvf_nisv_report(CPUState *cpu, const char *what, uint32_t insn,
+                            uint64_t syndrome, uint64_t far, uint64_t ipa)
+{
+    CPUARMState *env = &ARM_CPU(cpu)->env;
+    MemoryRegionSection s = memory_region_find(get_system_memory(), ipa, 1);
+
+    error_report("hvf: ISV=0 data abort %s: cpu=%d el=%d pc=0x%" PRIx64
+                 " insn=0x%08x esr=0x%" PRIx64 " va=0x%" PRIx64
+                 " ipa=0x%" PRIx64 " mr=%s+0x%" HWADDR_PRIx,
+                 what, cpu->cpu_index, arm_current_el(env),
+                 (uint64_t)env->pc, insn, syndrome, far, ipa,
+                 s.mr ? memory_region_name(s.mr) : "(unassigned)",
+                 s.mr ? s.offset_within_region : (hwaddr)0);
+    if (s.mr) {
+        memory_region_unref(s.mr);
+    }
+}
+
+/* Returns true when the access was emulated and the PC must be advanced. */
+static bool hvf_handle_dabt_nisv(CPUState *cpu, uint64_t syndrome,
+                                 uint64_t far, uint64_t ipa)
+{
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    CPUARMState *env = &arm_cpu->env;
+    static int abort_on_nisv = -1;
+    static unsigned n_emulated, n_injected;
+    bool is_write = (syndrome >> 6) & 1;
+    bool fnv = (syndrome >> 10) & 1;
+    bool s1ptw = (syndrome >> 7) & 1;
+    uint32_t insn = 0;
+    bool ok = false;
+
+    if (abort_on_nisv < 0) {
+        abort_on_nisv = getenv("EMBER_HVF_NISV_ABORT") != NULL;
+    }
+
+    cpu_synchronize_state(cpu);
+
+    if (!fnv && !s1ptw && is_a64(env) && !arm_cpu_data_is_big_endian(env) &&
+        cpu_memory_rw_debug(cpu, env->pc, &insn, 4, false) == 0) {
+        ok = hvf_nisv_emulate(env, insn, far, ipa, &is_write);
+    }
+
+    if (ok) {
+        if (n_emulated < 16 || (n_emulated & 1023) == 0) {
+            hvf_nisv_report(cpu, "emulated", insn, syndrome, far, ipa);
+        }
+        n_emulated++;
+        return true;
+    }
+
+    if (n_injected++ < 64) {
+        hvf_nisv_report(cpu, abort_on_nisv ? "not decodable, aborting"
+                                           : "not decodable, injecting SEA",
+                        insn, syndrome, far, ipa);
+    }
+    if (abort_on_nisv) {
+        abort();
+    }
+
+    /* Synchronous external abort on the data access, like KVM does */
+    env->exception.vaddress = far;
+    hvf_raise_exception(cpu, EXCP_DATA_ABORT,
+                        syn_data_abort_no_iss(arm_current_el(env) == 1,
+                                              fnv, 1, 0, s1ptw, is_write,
+                                              0x10));
+    return false;
+}
