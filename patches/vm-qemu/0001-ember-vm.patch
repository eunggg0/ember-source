+/* Ember precise WFI: sleep until deadline_mt (mach time) or a kick. Returns true if the timer fired. */
+static bool ember_wfi_wait_precise(CPUState *cpu, int kq, uint64_t deadline_mt)
+{
+    struct kevent64_s ch, ev[2];
+    bool timer = false;
+    int n, i;
+
+    EV_SET64(&ch, EMBER_WFI_TIMER_ID, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+             NOTE_MACHTIME | NOTE_ABSOLUTE | NOTE_CRITICAL | NOTE_LEEWAY, deadline_mt, 0, 0, 0);
+    /* ch.ext[1] = 0 = leeway */
+    qatomic_set_mb(&cpu->thread_kicked, false);
+    bql_unlock();
+    n = kevent64(kq, &ch, 1, ev, 2, 0, NULL);
+    for (i = 0; i < n; i++) {
+        if (ev[i].filter == EVFILT_TIMER && !(ev[i].flags & EV_ERROR)) {
+            timer = true;
+        }
+    }
+    if (!timer) {
+        /* kicked (or error): drop the armed timer so it can't fire into a later wait */
+        EV_SET64(&ch, EMBER_WFI_TIMER_ID, EVFILT_TIMER, EV_DELETE, 0, 0, 0, 0, 0);
+        kevent64(kq, &ch, 1, NULL, 0, 0, NULL);
+    }
+    bql_lock();
+    return timer;
 }
 
