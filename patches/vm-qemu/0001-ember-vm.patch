+static int vmfg_inflight_limit(void)
+{
+    return vmfg.inflight_auto ? atomic_load(&vmfg.auto_limit) :
+                                vmfg.max_inflight;
+}
+
+static int vmfg_cmp_i64(const void *a, const void *b)
+{
+    int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;
+    return x < y ? -1 : x > y;
+}
+
+static int vmfg_cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
+
+static int64_t vmfg_median_interval(void)
+{
+    int64_t tmp[VMFG_HIST];
+    int n = vmfg.hist_n;
+    if (n < 3) {
+        return 0;
+    }
+    memcpy(tmp, vmfg.hist, sizeof(int64_t) * n);
+    qsort(tmp, n, sizeof(int64_t), vmfg_cmp_i64);
+    return tmp[n / 2];
+}
+
+static void vmfg_atomic_max(_Atomic int64_t *v, int64_t x)
+{
+    int64_t cur = atomic_load(v);
+    while (x > cur && !atomic_compare_exchange_weak(v, &cur, x)) {
+    }
+}
