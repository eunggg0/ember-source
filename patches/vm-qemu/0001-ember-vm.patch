diff --git a/ui/ember-display.h b/ui/ember-display.h
new file mode 100644
index 0000000..4993ddb
--- /dev/null
+++ b/ui/ember-display.h
@@ -0,0 +1,189 @@
+/* Cocoa display policy, deliberately independent of guest/renderer state.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef UI_EMBER_DISPLAY_H
+#define UI_EMBER_DISPLAY_H
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#import <QuartzCore/QuartzCore.h>
+
+typedef struct EmberDisplayPolicy {
+    bool opaque, angle_metal, fit, pool_guard, async_present, probe, log;
+    bool idle_retry; /* retry an owed VMFG presentation without a guest flip */
+    /* vmfs-1031 fullscreen policy (all need fit, which places the image):
+     * fs_fill   view = whole screen, guest image fitted inside (aspect kept)
+     *           instead of QEMU's 1:1 window centred on black;
+     * fs_points ask the guest for the screen size in points, not backing
+     *           pixels (1920x1080pt Retina screen -> 1920x1080 guest, 2x);
+     * fs_grab_auto  0 = QEMU: always grab on entering fullscreen;
+     *           1 = with an absolute tablet grab only if the pointer is over
+     *           the view (a relative mouse keeps QEMU's grab).
+     * A disabled policy (all false) is exactly QEMU's behaviour. */
+    bool fs_fill, fs_points, fs_grab_auto;
+    int sync; /* -1: preserve ANGLE/VMFG policy; 0/1: explicit override */
+    /* vmdisp-1031:
+     * guest_w/h  EMBER_DISP_GUEST_SIZE=WxH: the size QEMU asks the guest for,
+     *            windowed and fullscreen (0 = QEMU's view-size request). The
+     *            10-31 "big window" was a 3840x2160 guest, not a scaled 1080p
+     *            one; a pin keeps the game's swapchain at 1080p.
+     * win_zoom   EMBER_DISP_WIN_ZOOM=1|2|..|fit: non-resizable window size =
+     *            guest/backing x zoom (0 = fit the screen's visible frame).
+     *            The guest size does not follow the window then. */
+    int guest_w, guest_h;
+    double win_zoom;
+} EmberDisplayPolicy;
+
+/* "points"/"backing" style switch: 1 for on_name, 0 for off_name. */
+static inline int ember_disp_choice(const char *name, int fallback,
+                                    const char *on_name, const char *off_name)
+{
+    const char *v = getenv(name);
+    if (!v || !*v || !strcmp(v, "keep")) {
+        return fallback;
+    }
+    if (!strcmp(v, on_name) || !strcmp(v, "1")) {
+        return 1;
+    }
+    if (!strcmp(v, off_name) || !strcmp(v, "0")) {
+        return 0;
+    }
+    fprintf(stderr, "ember-disp: invalid %s=%s; using %s\n", name, v,
+            fallback ? on_name : off_name);
+    return fallback;
+}
+
+static inline int ember_disp_option(const char *name, int fallback)
+{
+    const char *v = getenv(name);
+    if (!v || !*v || !strcmp(v, "keep")) {
+        return fallback;
+    }
+    if (!strcmp(v, "0") || !strcmp(v, "1")) {
+        return v[0] - '0';
+    }
+    fprintf(stderr, "ember-disp: invalid %s=%s; using %d\n", name, v, fallback);
+    return fallback;
+}
+
+/* EMBER_DISP_GUEST_SIZE=WxH (both 320..16384), anything else = no pin. */
+static inline void ember_disp_guest_size(int *w, int *h)
+{
+    const char *v = getenv("EMBER_DISP_GUEST_SIZE");
+    int a = 0, b = 0;
+
+    *w = *h = 0;
+    if (v && *v && strcmp(v, "keep")) {
+        if (sscanf(v, "%dx%d", &a, &b) == 2 && a >= 320 && b >= 200 &&
+            a <= 16384 && b <= 16384) {
+            *w = a;
+            *h = b;
+        } else {
+            fprintf(stderr, "ember-disp: invalid EMBER_DISP_GUEST_SIZE=%s\n", v);
+        }
+    }
+}
+
+/* EMBER_DISP_WIN_ZOOM: 1 (default, QEMU), 1..8, or "fit" (returned as 0). */
+static inline double ember_disp_win_zoom(void)
+{
+    const char *v = getenv("EMBER_DISP_WIN_ZOOM");
+    double z;
+
+    if (!v || !*v || !strcmp(v, "keep")) {
+        return 1;
+    }
+    if (!strcmp(v, "fit")) {
+        return 0;
+    }
+    z = atof(v);
+    if (z >= 1 && z <= 8) {
+        return z;
+    }
+    fprintf(stderr, "ember-disp: invalid EMBER_DISP_WIN_ZOOM=%s\n", v);
+    return 1;
+}
+
+static inline EmberDisplayPolicy ember_disp_policy(void)
+{
+    int guest_w, guest_h;
+
+    ember_disp_guest_size(&guest_w, &guest_h);
+    if (!ember_disp_option("EMBER_DISP_ENABLE", 1)) {
+        return (EmberDisplayPolicy){ .sync = -1, .win_zoom = 1 };
+    }
+    return (EmberDisplayPolicy){
+        .opaque = ember_disp_option("EMBER_DISP_OPAQUE", 1),
+        .angle_metal = ember_disp_option("EMBER_DISP_ANGLE_METAL", 1),
+        .fit = ember_disp_option("EMBER_DISP_FIT", 1),
+        .pool_guard = ember_disp_option("EMBER_DISP_POOL_GUARD", 1),
+        .async_present = ember_disp_option("EMBER_DISP_ASYNC_PRESENT", 1),
+        .probe = ember_disp_option("EMBER_DISP_IOSURFACE_PROBE", 0),
+        .log = ember_disp_option("EMBER_DISP_LOG", 0),
+        .idle_retry = ember_disp_option("EMBER_DISP_IDLE_RETRY", 1),
+        .fs_fill = ember_disp_option("EMBER_DISP_FIT", 1) &&
+                   ember_disp_option("EMBER_DISP_FS_FILL", 1),
+        .fs_points = ember_disp_choice("EMBER_DISP_FS_GUEST", 1,
+                                       "points", "backing"),
+        .fs_grab_auto = ember_disp_choice("EMBER_DISP_FS_GRAB", 1,
+                                          "auto", "always"),
+        .sync = ember_disp_option("EMBER_DISP_SYNC", -1),
+        .guest_w = guest_w,
+        .guest_h = guest_h,
+        .win_zoom = ember_disp_win_zoom(),
+    };
+}
+
+/* Integer magnification (e.g. exactly 2x in fullscreen) samples nearest so
+ * a 1080p guest on a 2x screen looks like a native 1080p panel. */
+static inline bool ember_disp_integer_zoom(CGRect frame, CGSize pixels,
+                                           CGFloat scale)
+{
+    if (pixels.width <= 0 || pixels.height <= 0 || scale <= 0) {
+        return false;
+    }
+    CGFloat zx = frame.size.width * scale / pixels.width;
+    CGFloat zy = frame.size.height * scale / pixels.height;
+    CGFloat r = (CGFloat)(long)(zx + 0.5);
+    return r >= 1 && zx > r - 1e-3 && zx < r + 1e-3 &&
+           zy > r - 1e-3 && zy < r + 1e-3;
+}
+
+/* The Metal copy stays one source texel per drawable texel. Only CA's
+ * destination rectangle changes on resize/fullscreen; no 4K intermediate.
+ * Black bars stay in the opaque view backing layer. */
+static inline CGRect ember_disp_frame(CGRect bounds, CGSize pixels,
+                                      CGFloat scale, bool fit)
+{
+    scale = scale > 0 ? scale : 1;
+    CGRect frame = CGRectMake(0, 0, pixels.width / scale, pixels.height / scale);
+    if (fit && pixels.width > 0 && pixels.height > 0 &&
+        bounds.size.width > 0 && bounds.size.height > 0) {
+        CGFloat ratio = MIN(bounds.size.width / pixels.width,
+                            bounds.size.height / pixels.height);
+        frame.size = CGSizeMake(pixels.width * ratio, pixels.height * ratio);
+        frame.origin = CGPointMake(CGRectGetMidX(bounds) - frame.size.width / 2,
+                                   CGRectGetMidY(bounds) - frame.size.height / 2);
+    }
+    return frame;
+}
+
+static inline void ember_disp_metal_policy(CAMetalLayer *layer,
+                                          EmberDisplayPolicy policy)
+{
+    if (policy.opaque) {
+        layer.opaque = YES;
+    }
+    /* The existing callers use commandBuffer presentDrawable, which is
+     * asynchronous. Turning this switch off preserves the layer default;
+     * it must never force presentsWithTransaction=YES. */
+    if (policy.async_present) {
+        layer.presentsWithTransaction = NO;
+    }
+    if (policy.sync >= 0) {
+        layer.displaySyncEnabled = policy.sync;
+    }
+}
+
+#endif
diff --git a/ui/ember-vmfg-ipc.c b/ui/ember-vmfg-ipc.c
new file mode 100644
index 0000000..869a019
--- /dev/null
+++ b/ui/ember-vmfg-ipc.c
@@ -0,0 +1,611 @@
+/*
+ * Ember VM frame exchange (EVFX) protocol, version 1 -- client side.
+ *
+ * Copyright (c) 2026 Ember
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Transport only: Mach messages to a helper found by bootstrap name, frames
+ * passed as IOSurface send rights once and referenced by index afterwards.
+ * See ember-vmfg-ipc.h and Tools/dev/vmfg-1027/STAGE2.md.
+ *
+ * Threads
+ *   presenter (caller): connect, register surfaces, send FRAME, wait for its
+ *                       RESULT on a kqueue: a user event from the receiver or
+ *                       a NOTE_CRITICAL timer at the deadline (semaphores and
+ *                       condition variables overshoot by ~0.8 ms of timer
+ *                       slack, kqueue critical timers by ~0.03 ms)
+ *   receiver (ours)   : blocks on the reply port, files HELLO_ACK / RESULT /
+ *                       dead-name notifications and wakes the presenter
+ * At most one FRAME is outstanding. A RESULT that misses its deadline stays
+ * outstanding until it arrives (collect) or the session is dropped, so the
+ * caller never reuses buffers the helper may still read or write.
+ */
+#ifndef EMBER_VMFG_IPC_STANDALONE
+#include "qemu/osdep.h"
+#else
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#endif
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <sys/event.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/notify.h>
+#include <servers/bootstrap.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+#include "ember-vmfg-ipc.h"
+
+#define EVFX_RETRY_NS        500000000LL    /* lookup / HELLO retry */
+#define EVFX_HELLO_WAIT_NS   1000000000LL   /* no HELLO_ACK -> retry */
+#define EVFX_STUCK_NS        1000000000LL   /* outstanding this long -> drop */
+#define EVFX_RECV_POLL_MS    200
+
+struct EvfxClient {
+    char service[128];
+    mach_port_t reply;            /* receive right, ours */
+    mach_port_t svc;              /* send right to the helper (presenter) */
+    pthread_t thread;
+    bool thread_ok;
+    _Atomic bool quit;
+    int kq;                       /* EVFILT_USER wake-up + deadline timer */
+
+    pthread_mutex_t lock;         /* fields below shared with the receiver */
+    uint32_t session;             /* current session id */
+    mach_port_t svc_watch;        /* svc name the dead-name request is for */
+    bool acked, engine_ok, dead;
+    uint32_t ack_status, engine_version;
+    bool has_mail;
+    EvfxResultMsg mail;
+    int64_t mail_ns;              /* when the receiver saw it */
+
+    /* presenter only */
+    bool hello_sent;
+    int64_t hello_ns, next_try_ns;
+    bool outstanding;
+    uint64_t out_seq, seq;
+    int64_t out_sent_ns;
+    bool reset_pending;
+    uint32_t sent_gen[2][EVFX_MAX_INDEX];
+};
+
+static mach_timebase_info_data_t evfx_tb;
+
+int64_t evfx_now_ns(void)
+{
+    if (!evfx_tb.denom) {
+        mach_timebase_info(&evfx_tb);
+    }
+    return (int64_t)((__uint128_t)mach_absolute_time() * evfx_tb.numer /
+                     evfx_tb.denom);
+}
+
+#define EVFX_KEV_WAKE  1
+#define EVFX_KEV_TIMER 2
+
+static void evfx_wake(EvfxClient *c)
+{
+    struct kevent64_s ev;
+
+    EV_SET64(&ev, EVFX_KEV_WAKE, EVFILT_USER, 0, NOTE_TRIGGER, 0, 0, 0, 0);
+    kevent64(c->kq, &ev, 1, NULL, 0, 0, NULL);
+}
+
+/* Presenter: sleep until woken or until left_ns passed (precise, no slack). */
+static void evfx_wait(EvfxClient *c, int64_t left_ns)
+{
+    struct kevent64_s ev, out;
+    int n;
+
+    EV_SET64(&ev, EVFX_KEV_TIMER, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+             NOTE_NSECONDS | NOTE_CRITICAL, left_ns, 0, 0, 0);
+    n = kevent64(c->kq, &ev, 1, &out, 1, 0, NULL);
+    if (n > 0 && out.filter == EVFILT_USER) {
+        EV_SET64(&ev, EVFX_KEV_TIMER, EVFILT_TIMER, EV_DELETE, 0, 0, 0, 0, 0);
+        kevent64(c->kq, &ev, 1, NULL, 0, 0, NULL);
+    }
+}
+
+/* ---- receiver thread ----------------------------------------------------- */
+
+typedef union EvfxRecvBuf {
+    mach_msg_header_t header;
+    EvfxHelloAck ack;
+    EvfxResultMsg result;
+    mach_dead_name_notification_t dead;
+    uint8_t bytes[sizeof(EvfxResultMsg) + sizeof(EvfxHelloAck) + 256];
+} EvfxRecvBuf;
+
+static void evfx_on_message(EvfxClient *c, EvfxRecvBuf *m)
+{
+    mach_msg_header_t *h = &m->header;
+
+    switch (h->msgh_id) {
+    case MACH_NOTIFY_DEAD_NAME: {
+        mach_port_name_t name = m->dead.not_port;
+        /* The notification carries one user reference on the dead name. */
+        if (name != MACH_PORT_NULL) {
+            mach_port_deallocate(mach_task_self(), name);
+        }
+        pthread_mutex_lock(&c->lock);
+        if (name == c->svc_watch) {
+            c->dead = true;
+        }
+        pthread_mutex_unlock(&c->lock);
+        evfx_wake(c);
+        return;
+    }
+    case EVFX_ID_HELLO_ACK:
+        if (h->msgh_size < sizeof(EvfxHelloAck) ||
+            m->ack.magic != EVFX_MAGIC || m->ack.version != EVFX_VERSION) {
+            break;
+        }
+        pthread_mutex_lock(&c->lock);
+        if (m->ack.session == c->session) {
+            c->acked = true;
+            c->ack_status = m->ack.status;
+            c->engine_version = m->ack.engine_version;
+            c->engine_ok = m->ack.status == EVFX_ST_OK;
+        }
+        pthread_mutex_unlock(&c->lock);
+        break;
+    case EVFX_ID_RESULT:
+        if (h->msgh_size < sizeof(EvfxResultMsg) ||
+            m->result.magic != EVFX_MAGIC) {
+            break;
+        }
+        pthread_mutex_lock(&c->lock);
+        if (m->result.session == c->session) {
+            c->mail = m->result;
+            c->mail_ns = evfx_now_ns();
+            c->has_mail = true;
+        }
+        pthread_mutex_unlock(&c->lock);
+        evfx_wake(c);
+        break;
+    default:
+        break;
+    }
+    mach_msg_destroy(h);
+}
+
+static void *evfx_receiver(void *opaque)
+{
+    EvfxClient *c = opaque;
+    EvfxRecvBuf buf;
+
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    while (!atomic_load(&c->quit)) {
+        kern_return_t kr;
+
+        memset(&buf.header, 0, sizeof(buf.header));
+        kr = mach_msg(&buf.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0,
+                      sizeof(buf), c->reply, EVFX_RECV_POLL_MS,
+                      MACH_PORT_NULL);
+        if (kr == MACH_RCV_TIMED_OUT || kr == MACH_RCV_INTERRUPTED ||
+            kr == MACH_RCV_TOO_LARGE) {
+            continue;
+        }
+        if (kr != MACH_MSG_SUCCESS) {
+            break;                  /* port gone: client is being freed */
+        }
+        evfx_on_message(c, &buf);
+    }
+    return NULL;
+}
+
+/* ---- presenter side ------------------------------------------------------- */
+
+static void evfx_drop(EvfxClient *c, int64_t now, const char *why)
+{
+    mach_port_t old;
+    bool was = c->hello_sent;
+    bool held = c->outstanding;
+
+    pthread_mutex_lock(&c->lock);
+    c->session++;                 /* late messages of the old session drop */
+    c->acked = c->engine_ok = c->dead = c->has_mail = false;
+    c->svc_watch = MACH_PORT_NULL;
+    old = c->svc;
+    c->svc = MACH_PORT_NULL;
+    pthread_mutex_unlock(&c->lock);
+    if (old != MACH_PORT_NULL) {
+        mach_port_deallocate(mach_task_self(), old);
+    }
+    c->hello_sent = false;
+    c->outstanding = false;
+    if (was || held) {
+        c->reset_pending = true;  /* surfaces/outstanding buffers are void */
+    }
+    memset(c->sent_gen, 0, sizeof(c->sent_gen));
+    c->next_try_ns = now + EVFX_RETRY_NS;
+    if (was && why) {
+        fprintf(stderr, "ember-vmfg: helper session ended (%s)\n", why);
+    }
+}
+
+static kern_return_t evfx_send(EvfxClient *c, mach_msg_header_t *h,
+                               mach_msg_size_t size, mach_msg_timeout_t ms)
+{
+    kern_return_t kr = mach_msg(h, MACH_SEND_MSG | MACH_SEND_TIMEOUT, size, 0,
+                                MACH_PORT_NULL, ms, MACH_PORT_NULL);
+    if (kr == MACH_SEND_INVALID_DEST) {
+        evfx_drop(c, evfx_now_ns(), "helper port gone");
+    }
+    return kr;
+}
+
+EvfxClient *evfx_client_new(const char *service)
+{
+    EvfxClient *c;
+    kern_return_t kr;
+
+    if (!service || !*service || strlen(service) >= sizeof(c->service)) {
+        return NULL;
+    }
+    c = calloc(1, sizeof(*c));
+    if (!c) {
+        return NULL;
+    }
+    snprintf(c->service, sizeof(c->service), "%s", service);
+    pthread_mutex_init(&c->lock, NULL);
+    c->kq = kqueue();
+    c->session = arc4random() | 1u;
+    if (c->kq >= 0) {
+        struct kevent64_s ev;
+        EV_SET64(&ev, EVFX_KEV_WAKE, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, 0,
+                 0, 0);
+        if (kevent64(c->kq, &ev, 1, NULL, 0, 0, NULL) < 0) {
+            close(c->kq);
+            c->kq = -1;
+        }
+    }
+    if (c->kq < 0) {
+        free(c);
+        return NULL;
+    }
+    kr = mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE,
+                            &c->reply);
+    if (kr != KERN_SUCCESS) {
+        evfx_client_free(c);
+        return NULL;
+    }
+    if (pthread_create(&c->thread, NULL, evfx_receiver, c) != 0) {
+        evfx_client_free(c);
+        return NULL;
+    }
+    c->thread_ok = true;
+    return c;
+}
+
+void evfx_client_free(EvfxClient *c)
+{
+    if (!c) {
+        return;
+    }
+    if (c->svc != MACH_PORT_NULL) {
+        EvfxByeMsg bye;
+        memset(&bye, 0, sizeof(bye));
+        bye.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+        bye.header.msgh_size = sizeof(bye);
+        bye.header.msgh_remote_port = c->svc;
+        bye.header.msgh_id = EVFX_ID_BYE;
+        bye.magic = EVFX_MAGIC;
+        bye.session = c->session;
+        mach_msg(&bye.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(bye),
+                 0, MACH_PORT_NULL, 10, MACH_PORT_NULL);
+        evfx_drop(c, evfx_now_ns(), NULL);
+    }
+    atomic_store(&c->quit, true);
+    if (c->thread_ok) {
+        pthread_join(c->thread, NULL);
+    }
+    if (c->reply != MACH_PORT_NULL) {
+        mach_port_mod_refs(mach_task_self(), c->reply,
+                           MACH_PORT_RIGHT_RECEIVE, -1);
+    }
+    if (c->kq >= 0) {
+        close(c->kq);
+    }
+    pthread_mutex_destroy(&c->lock);
+    free(c);
+}
+
+static void evfx_connect(EvfxClient *c, int64_t now)
+{
+    mach_port_t svc = MACH_PORT_NULL, prev = MACH_PORT_NULL;
+    kern_return_t kr;
+    EvfxHello hello;
+    uint32_t session;
+
+    c->next_try_ns = now + EVFX_RETRY_NS;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    kr = bootstrap_look_up(bootstrap_port, c->service, &svc);
+#pragma clang diagnostic pop
+    if (kr != KERN_SUCCESS || svc == MACH_PORT_NULL) {
+        return;                     /* helper not running (yet) */
+    }
+    pthread_mutex_lock(&c->lock);
+    c->session++;
+    session = c->session;
+    c->svc = svc;
+    c->svc_watch = svc;
+    c->acked = c->engine_ok = c->dead = c->has_mail = false;
+    pthread_mutex_unlock(&c->lock);
+
+    /* Learn about the helper's death without polling. */
+    kr = mach_port_request_notification(mach_task_self(), svc,
+                                        MACH_NOTIFY_DEAD_NAME, 1, c->reply,
+                                        MACH_MSG_TYPE_MAKE_SEND_ONCE, &prev);
+    if (kr != KERN_SUCCESS) {
+        evfx_drop(c, now, NULL);    /* already dead */
+        return;
+    }
+    if (prev != MACH_PORT_NULL) {
+        mach_port_deallocate(mach_task_self(), prev);
+    }
+
+    memset(&hello, 0, sizeof(hello));
+    hello.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND,
+                                            MACH_MSG_TYPE_MAKE_SEND);
+    hello.header.msgh_size = sizeof(hello);
+    hello.header.msgh_remote_port = svc;
+    hello.header.msgh_local_port = c->reply;
+    hello.header.msgh_id = EVFX_ID_HELLO;
+    hello.magic = EVFX_MAGIC;
+    hello.version = EVFX_VERSION;
+    hello.session = session;
+    hello.client_pid = (uint32_t)getpid();
+    if (evfx_send(c, &hello.header, sizeof(hello), 20) != MACH_MSG_SUCCESS) {
+        if (c->svc != MACH_PORT_NULL) {
+            evfx_drop(c, now, NULL);
+        }
+        return;
+    }
+    c->hello_sent = true;
+    c->hello_ns = now;
+    memset(c->sent_gen, 0, sizeof(c->sent_gen));
+}
+
+bool evfx_client_ready(EvfxClient *c, int64_t now)
+{
+    bool dead, acked, ok;
+
+    if (!c) {
+        return false;
+    }
+    pthread_mutex_lock(&c->lock);
+    dead = c->dead;
+    acked = c->acked;
+    ok = c->engine_ok;
+    pthread_mutex_unlock(&c->lock);
+
+    if (dead) {
+        evfx_drop(c, now, "helper exited");
+        return false;
+    }
+    if (c->outstanding && now - c->out_sent_ns > EVFX_STUCK_NS) {
+        evfx_drop(c, now, "helper stuck");
+        return false;
+    }
+    if (c->svc == MACH_PORT_NULL) {
+        if (now >= c->next_try_ns) {
+            evfx_connect(c, now);
+        }
+        return false;
+    }
+    if (!acked) {
+        if (c->hello_sent && now - c->hello_ns > EVFX_HELLO_WAIT_NS) {
+            evfx_drop(c, now, "no answer to hello");
+        }
+        return false;
+    }
+    return ok;
+}
+
+bool evfx_client_take_reset(EvfxClient *c)
+{
+    bool r;
+
+    if (!c) {
+        return false;
+    }
+    r = c->reset_pending;
+    c->reset_pending = false;
+    return r;
+}
+
+bool evfx_client_surface(EvfxClient *c, uint32_t role, uint32_t index,
+                         uint32_t gen, IOSurfaceRef surface)
+{
+    EvfxSurfaceMsg m;
+    mach_port_t port;
+    kern_return_t kr;
+
+    if (!c || c->svc == MACH_PORT_NULL || role > EVFX_ROLE_OUTPUT ||
+        index >= EVFX_MAX_INDEX || !gen || !surface) {
+        return false;
+    }
+    if (c->sent_gen[role][index] == gen) {
+        return true;
+    }
+    port = IOSurfaceCreateMachPort(surface);
+    if (port == MACH_PORT_NULL) {
+        return false;
+    }
+    memset(&m, 0, sizeof(m));
+    m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0) |
+                         MACH_MSGH_BITS_COMPLEX;
+    m.header.msgh_size = sizeof(m);
+    m.header.msgh_remote_port = c->svc;
+    m.header.msgh_id = EVFX_ID_SURFACE;
+    m.body.msgh_descriptor_count = 1;
+    m.surface.name = port;
+    m.surface.disposition = MACH_MSG_TYPE_COPY_SEND;
+    m.surface.type = MACH_MSG_PORT_DESCRIPTOR;
+    m.magic = EVFX_MAGIC;
+    m.session = c->session;
+    m.role = role;
+    m.index = index;
+    m.gen = gen;
+    m.width = (uint32_t)IOSurfaceGetWidth(surface);
+    m.height = (uint32_t)IOSurfaceGetHeight(surface);
+    m.format = IOSurfaceGetPixelFormat(surface);
+    kr = evfx_send(c, &m.header, sizeof(m), 20);
+    mach_port_deallocate(mach_task_self(), port);
+    if (kr != MACH_MSG_SUCCESS) {
+        return false;
+    }
+    c->sent_gen[role][index] = gen;
+    return true;
+}
+
+static void evfx_fill_result(const EvfxResultMsg *m, int64_t sent_ns,
+                             int64_t seen_ns, EvfxResult *r)
+{
+    memset(r, 0, sizeof(*r));
+    r->seq = m->seq;
+    r->status = m->status;
+    r->generate = m->generate;
+    r->out_index = m->out_index;
+    r->engine_flags = m->engine_flags;
+    r->hold_ns = m->hold_ns;
+    r->recv_ns = m->recv_ns;
+    r->done_ns = m->done_ns;
+    r->gpu_ns = m->gpu_ns;
+    r->sent_ns = sent_ns;
+    r->rtt_ns = seen_ns - sent_ns;
+}
+
+/* Takes the outstanding result if it is in the mailbox. Presenter only. */
+static bool evfx_take_mail(EvfxClient *c, EvfxResult *r)
+{
+    bool got = false;
+    EvfxResultMsg m;
+    int64_t seen = 0;
+
+    pthread_mutex_lock(&c->lock);
+    if (c->has_mail) {
+        c->has_mail = false;
+        if (c->outstanding && c->mail.seq == c->out_seq) {
+            m = c->mail;
+            seen = c->mail_ns;
+            got = true;
+        }
+    }
+    pthread_mutex_unlock(&c->lock);
+    if (got) {
+        c->outstanding = false;
+        evfx_fill_result(&m, c->out_sent_ns, seen, r);
+    }
+    return got;
+}
+
+bool evfx_client_collect(EvfxClient *c, EvfxResult *r)
+{
+    if (!c || !c->outstanding) {
+        return false;
+    }
+    return evfx_take_mail(c, r);
+}
+
+bool evfx_client_outstanding(EvfxClient *c)
+{
+    return c && c->outstanding;
+}
+
+EvfxWait evfx_client_frame(EvfxClient *c, const EvfxFrame *f, EvfxResult *r)
+{
+    EvfxFrameMsg m;
+    kern_return_t kr;
+    int64_t now = evfx_now_ns();
+
+    if (!c || c->svc == MACH_PORT_NULL || !c->engine_ok) {
+        return EVFX_DOWN;
+    }
+    if (c->outstanding) {
+        return EVFX_BUSY;           /* caller collects the late result first */
+    }
+    memset(&m, 0, sizeof(m));
+    m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+    m.header.msgh_size = sizeof(m);
+    m.header.msgh_remote_port = c->svc;
+    m.header.msgh_id = EVFX_ID_FRAME;
+    m.magic = EVFX_MAGIC;
+    m.session = c->session;
+    m.seq = ++c->seq;
+    m.cur_index = f->cur_index;
+    m.cur_gen = f->cur_gen;
+    m.prev_index = f->prev_index;
+    m.prev_gen = f->prev_gen;
+    m.out_index = f->out_index;
+    m.out_gen = f->out_gen;
+    m.flags = f->flags;
+    m.drops_stale = f->drops_stale;
+    m.drops_no_drawable = f->drops_no_drawable;
+    m.drops_other = f->drops_other;
+    m.transport_outstanding = f->transport_outstanding;
+    m.arrival_ns = f->arrival_ns;
+    m.sent_ns = now;
+    m.display_interval_ns = f->display_interval_ns;
+    m.deadline_ns = f->deadline_ns;
+    m.latency_sample_ns = f->latency_sample_ns;
+    m.transport_start_ns = f->transport_start_ns;
+    m.display_latency_us = f->display_latency_us;
+
+    /* A wake-up left over from an earlier late result is harmless: the wait
+     * loop below re-checks the mailbox after every wake-up. */
+    kr = evfx_send(c, &m.header, sizeof(m), 1);
+    if (kr == MACH_SEND_TIMED_OUT) {
+        return EVFX_BUSY;           /* helper queue full; nothing sent */
+    }
+    if (kr != MACH_MSG_SUCCESS) {
+        if (c->svc != MACH_PORT_NULL) {
+            evfx_drop(c, now, "send failed");
+        }
+        return EVFX_DOWN;
+    }
+    c->outstanding = true;
+    c->out_seq = m.seq;
+    c->out_sent_ns = now;
+
+    for (;;) {
+        bool dead;
+        int64_t left = f->deadline_ns - evfx_now_ns();
+
+        if (evfx_take_mail(c, r)) {
+            return EVFX_DONE;
+        }
+        pthread_mutex_lock(&c->lock);
+        dead = c->dead;
+        pthread_mutex_unlock(&c->lock);
+        if (dead) {
+            evfx_drop(c, evfx_now_ns(), "helper exited");
+            return EVFX_DOWN;
+        }
+        if (left <= 0) {
+            return EVFX_TIMEOUT;
+        }
+        evfx_wait(c, left);
+    }
+}
+
+const char *evfx_client_state(EvfxClient *c)
+{
+    const char *s;
+
+    if (!c) {
+        return "off";
+    }
+    pthread_mutex_lock(&c->lock);
+    s = !c->svc ? "off" : !c->acked ? "connecting" :
+        c->engine_ok ? "up" : "no-engine";
+    pthread_mutex_unlock(&c->lock);
+    return s;
+}
diff --git a/ui/ember-vmfg-ipc.h b/ui/ember-vmfg-ipc.h
new file mode 100644
index 0000000..e6945bc
--- /dev/null
+++ b/ui/ember-vmfg-ipc.h
@@ -0,0 +1,199 @@
+/*
+ * Ember VM frame exchange (EVFX) protocol, version 1 -- client side.
+ *
+ * Copyright (c) 2026 Ember
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * EVFX is a small, documented Mach message protocol for handing finished
+ * display frames (IOSurface pixel buffers + timestamps) to a separate
+ * process and getting back "show an extra frame from output buffer N and
+ * hold the next original for T ns". The client below is written for QEMU's
+ * Cocoa display and contains no frame-generation logic. The protocol is
+ * specified in Tools/dev/vmfg-1027/STAGE2.md ("EVFX v1"); any process that
+ * implements that document can serve as the helper.
+ *
+ * Plain C (no Objective-C, no Metal) so the transport can also be built and
+ * tested outside QEMU (define EMBER_VMFG_IPC_STANDALONE).
+ */
+#ifndef UI_EMBER_VMFG_IPC_H
+#define UI_EMBER_VMFG_IPC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <mach/mach.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+/* ---- wire format (EVFX v1) --------------------------------------------- */
+
+#define EVFX_MAGIC          0x58465645u   /* 'EVFX' little endian */
+#define EVFX_VERSION        1u
+#define EVFX_ID_HELLO       0x45560001
+#define EVFX_ID_HELLO_ACK   0x45560002
+#define EVFX_ID_SURFACE     0x45560003
+#define EVFX_ID_FRAME       0x45560004
+#define EVFX_ID_RESULT      0x45560005
+#define EVFX_ID_BYE         0x45560006
+
+#define EVFX_MAX_INDEX      16
+#define EVFX_FORMAT_BGRA8   0x42475241u   /* 'BGRA' (kCVPixelFormatType_32BGRA) */
+
+enum { EVFX_ROLE_INPUT = 0, EVFX_ROLE_OUTPUT = 1 };
+
+/* FRAME.flags */
+enum {
+    EVFX_FRAME_PREV_VALID  = 1u << 0,  /* prev_index holds the previous frame */
+    EVFX_FRAME_SCENE_RESET = 1u << 1,  /* size/format changed: no history */
+    EVFX_FRAME_TEST_SLOW   = 1u << 30, /* test helpers only: answer late */
+    EVFX_FRAME_TEST_EXIT   = 1u << 31, /* test helpers only: exit, no answer */
+};
+
+/* RESULT.status / HELLO_ACK.status */
+enum {
+    EVFX_ST_OK = 0,
+    EVFX_ST_LATE = 1,          /* deadline passed before work finished */
+    EVFX_ST_NO_SURFACE = 2,    /* index/generation not registered */
+    EVFX_ST_NO_ENGINE = 3,     /* helper runs without a generator */
+    EVFX_ST_GPU_ERROR = 4,
+    EVFX_ST_INVALID = 5,
+};
+
+/* RESULT.engine_flags (informational) */
+enum {
+    EVFX_ENGINE_ACTIVE = 1u << 0,      /* generator is producing frames */
+    EVFX_ENGINE_FAST = 1u << 1,        /* source already near refresh rate */
+    EVFX_ENGINE_GUARD = 1u << 2,       /* generator paused by its own guard */
+};
+
+typedef struct EvfxHello {
+    mach_msg_header_t header;          /* local port = client reply port */
+    uint32_t magic, version, session, client_pid;
+} EvfxHello;
+
+typedef struct EvfxHelloAck {
+    mach_msg_header_t header;
+    uint32_t magic, version, session, status, engine_version, caps;
+} EvfxHelloAck;
+
+typedef struct EvfxSurfaceMsg {
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t surface;    /* IOSurfaceCreateMachPort */
+    uint32_t magic, session, role, index, gen, width, height, format;
+} EvfxSurfaceMsg;
+
+typedef struct EvfxFrameMsg {
+    mach_msg_header_t header;
+    uint32_t magic, session;
+    uint64_t seq;
+    uint32_t cur_index, cur_gen;
+    int32_t prev_index;
+    uint32_t prev_gen;
+    int32_t out_index;
+    uint32_t out_gen;
+    uint32_t flags;
+    uint32_t drops_stale, drops_no_drawable, drops_other;
+    uint32_t transport_outstanding, pad0;
+    int64_t arrival_ns;            /* guest frame arrival, host monotonic */
+    int64_t sent_ns;
+    int64_t display_interval_ns;
+    int64_t deadline_ns;           /* client stops waiting at this time */
+    int64_t latency_sample_ns;     /* latest original on glass (0 = none) */
+    int64_t transport_start_ns;
+    int64_t display_latency_us;    /* recent arrival->glass mean (0 = none) */
+} EvfxFrameMsg;
+
+typedef struct EvfxResultMsg {
+    mach_msg_header_t header;
+    uint32_t magic, session;
+    uint64_t seq;
+    uint32_t status, generate;
+    int32_t out_index;
+    uint32_t engine_flags;
+    int64_t hold_ns;               /* min. time the extra frame stays up */
+    int64_t recv_ns, done_ns, gpu_ns;
+} EvfxResultMsg;
+
+typedef struct EvfxByeMsg {
+    mach_msg_header_t header;
+    uint32_t magic, session;
+} EvfxByeMsg;
+
+_Static_assert(sizeof(EvfxHello) == 40, "EVFX HELLO layout");
+_Static_assert(sizeof(EvfxHelloAck) == 48, "EVFX HELLO_ACK layout");
+_Static_assert(sizeof(EvfxSurfaceMsg) == 72, "EVFX SURFACE layout");
+_Static_assert(sizeof(EvfxFrameMsg) == 144, "EVFX FRAME layout");
+_Static_assert(sizeof(EvfxResultMsg) == 88, "EVFX RESULT layout");
+_Static_assert(sizeof(EvfxByeMsg) == 32, "EVFX BYE layout");
+
+/* ---- client API ---------------------------------------------------------- */
+
+typedef struct EvfxClient EvfxClient;
+
+/* What the caller fills per frame (seq/session/sent_ns are set by the client). */
+typedef struct EvfxFrame {
+    uint32_t cur_index, cur_gen;
+    int32_t prev_index;
+    uint32_t prev_gen;
+    int32_t out_index;
+    uint32_t out_gen;
+    uint32_t flags;
+    uint32_t drops_stale, drops_no_drawable, drops_other;
+    uint32_t transport_outstanding;
+    int64_t arrival_ns, display_interval_ns, deadline_ns;
+    int64_t latency_sample_ns, transport_start_ns, display_latency_us;
+} EvfxFrame;
+
+typedef struct EvfxResult {
+    uint64_t seq;
+    uint32_t status, generate;
+    int32_t out_index;
+    uint32_t engine_flags;
+    int64_t hold_ns, recv_ns, done_ns, gpu_ns;
+    int64_t sent_ns, rtt_ns;       /* client side: send -> reply seen */
+} EvfxResult;
+
+typedef enum EvfxWait {
+    EVFX_DONE,      /* result for this frame arrived before the deadline */
+    EVFX_TIMEOUT,   /* still outstanding; collect it later, keep its buffers */
+    EVFX_BUSY,      /* an older request is still outstanding; nothing sent */
+    EVFX_DOWN,      /* no usable helper; nothing outstanding */
+} EvfxWait;
+
+/* Host monotonic clock in ns (mach_absolute_time, same as CACurrentMediaTime). */
+int64_t evfx_now_ns(void);
+
+/* service: bootstrap name the helper registered. NULL on allocation failure. */
+EvfxClient *evfx_client_new(const char *service);
+void evfx_client_free(EvfxClient *c);
+
+/*
+ * All calls below: one thread at a time (the presenter).
+ * evfx_client_ready (re)connects at most every retry interval and returns
+ * true when a helper with a working generator accepted the session.
+ */
+bool evfx_client_ready(EvfxClient *c, int64_t now_ns);
+
+/*
+ * True once after a session ended (helper exited, stuck, replaced). The
+ * caller must drop whatever it held for an outstanding request and treat
+ * every registered surface as unknown to the helper (new generations).
+ */
+bool evfx_client_take_reset(EvfxClient *c);
+
+/* Sends the surface unless this (role, index, gen) is already registered. */
+bool evfx_client_surface(EvfxClient *c, uint32_t role, uint32_t index,
+                         uint32_t gen, IOSurfaceRef surface);
+
+/* Sends one frame and waits for its result until f->deadline_ns. */
+EvfxWait evfx_client_frame(EvfxClient *c, const EvfxFrame *f, EvfxResult *r);
+
+/* Non-blocking: true when the outstanding (late) result has now arrived. */
+bool evfx_client_collect(EvfxClient *c, EvfxResult *r);
+
+bool evfx_client_outstanding(EvfxClient *c);
+
+/* "off", "connecting", "up", "no-engine" */
+const char *evfx_client_state(EvfxClient *c);
+
+#endif /* UI_EMBER_VMFG_IPC_H */
diff --git a/ui/ember-vmfg.h b/ui/ember-vmfg.h
new file mode 100644
index 0000000..56ec3d7
--- /dev/null
+++ b/ui/ember-vmfg.h
@@ -0,0 +1,140 @@
+/*
+ * Ember VM frame generation transport for the Cocoa Metal scanout
+ * (stage 2: call sites, snapshot ring, direct present, external helper).
+ *
+ * Copyright (c) 2026 Ember
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * This file is part of the QEMU build and is published with it. It contains
+ * no interpolation engine. EMBER_VMFG=fg talks to a separate helper process
+ * over the documented EVFX protocol (IOSurface frames + timestamps, see
+ * ember-vmfg-ipc.h); nothing proprietary is linked or loaded into the QEMU
+ * process. See Tools/dev/vmfg-1027/DESIGN.md and STAGE2.md.
+ *
+ * Switches (read once at ember_vmfg_init):
+ *   EMBER_VMFG=count  snapshot + present each guest frame from the presenter
+ *                     queue as soon as it arrives (no refresh-timer wait)
+ *   EMBER_VMFG=dup    as count, and insert one repeated copy of the current
+ *                     frame where an interpolated frame would go (pacing test)
+ *   EMBER_VMFG=fg     as count, and ask the EVFX helper for an extra frame
+ *                     per guest frame; without a (timely) answer the frame
+ *                     is shown exactly as in count mode
+ *   EMBER_VMFG_SERVICE=<name>      helper bootstrap name (com.ember.vmfg)
+ *   EMBER_VMFG_DEADLINE_MS=<ms>    answer must arrive this long before the
+ *                                  next refresh (default 2.0)
+ *   EMBER_VMFG_MIN_BUDGET_MS=<ms>  if less time than this is left before
+ *                                  that point, aim one refresh later (1.0)
+ *   EMBER_VMFG_HZ=<n>        display refresh override (else CVDisplayLink)
+ *   EMBER_VMFG_GEN_RATIO=<r> insert only when guest interval >= r * refresh
+ *                            interval (default 1.6)
+ *   EMBER_VMFG_LOG=0         silence the 5 s statistics line on stderr
+ *
+ * Stage 3 switches (work with or without EMBER_VMFG):
+ *   EMBER_VMFG_GUEST_HZ=host|nominal|half|<hz>
+ *                            refresh rate the guest gets in its EDID (and
+ *                            so its vsync / DWM rate). host (default) = the
+ *                            larger of CVDisplayLink nominal and NSScreen
+ *                            maximumFramesPerSecond; nominal = upstream QEMU
+ *                            (CVDisplayLink only); half = host / 2 (leaves
+ *                            every other refresh for generated frames);
+ *                            <hz> = fixed, e.g. 60
+ *   EMBER_VMFG_COLORSPACE=srgb|none
+ *                            tag the Metal layer: srgb = sRGB for 8/10-bit
+ *                            scanouts, extended linear sRGB for float ones
+ *                            (colour managed on wide-gamut panels); none =
+ *                            untagged as upstream (default)
+ *   EMBER_VMFG_FLASH=1|<fx>,<fy>
+ *                            input-latency probe: read one pixel (default
+ *                            the centre, else fractions of the scanout) of
+ *                            every guest frame and log the arrival and
+ *                            on-glass time of each dark->bright change
+ *                            ("ember-vmfg: flash ..."). Without EMBER_VMFG the
+ *                            legacy display path is measured.
+ *   EMBER_VMFG_SCREEN=fastest|<n>
+ *                            open the window centred on the screen with the
+ *                            highest refresh, or NSScreen screens[n], keep it
+ *                            there through QEMU's re-centring (pulled back
+ *                            for 20 s after start), and pin the guest EDID
+ *                            refresh to that screen (default: AppKit's choice)
+ *   EMBER_VMFG_GUEST_HZ also takes "first": pin the first value seen
+ *   EMBER_VMFG_INFLIGHT=auto|<n>
+ *                            originals presented but not on glass yet before
+ *                            a new frame waits (mailbox, newest wins); auto
+ *                            (default) = ceil(min present->glass / refresh
+ *                            + 0.25), 1..3
+ *   EMBER_VMFG_DISPLAYSYNC=0 layer.displaySyncEnabled = NO (count/fg only;
+ *                            A/B for latency, windowed has no tearing)
+ *   Frames that are not 8-bit SDR (10-bit, float) are never interpolated.
+ */
+#ifndef UI_EMBER_VMFG_H
+#define UI_EMBER_VMFG_H
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+/* Main thread, once, after the Cocoa view exists. layer may be nil. */
+void ember_vmfg_init(CAMetalLayer *layer);
+
+/*
+ * QEMU thread (BQL held). The guest set a new native scanout. tex may be nil
+ * (scanout disabled or not a Metal texture). tex is retained until replaced.
+ */
+void ember_vmfg_set_source(id<MTLTexture> tex, uint32_t x, uint32_t y,
+                           uint32_t w, uint32_t h);
+#endif
+
+/* True when the transport owns presentation of Metal scanouts. */
+bool ember_vmfg_active(void);
+
+/*
+ * QEMU thread (BQL held), on every guest RESOURCE_FLUSH of the scanout.
+ * Never blocks on the display. Returns true when the frame was taken over
+ * (the caller must then not mark the legacy refresh path dirty).
+ */
+bool ember_vmfg_flush(void);
+
+/*
+ * QEMU thread: the legacy refresh found gl_dirty. Re-presents the last frame
+ * and returns true when the transport owns the current scanout; false means
+ * the caller must draw it the legacy way.
+ */
+bool ember_vmfg_kick(void);
+
+/* Any thread: nominal display refresh period (CVTime value/scale). */
+void ember_vmfg_set_display_period(int64_t time_value, int32_t time_scale);
+
+#ifdef __OBJC__
+#import <AppKit/AppKit.h>
+
+/*
+ * BQL held (updateUIInfoLocked). Refresh rate in mHz to report to the guest
+ * (QemuUIInfo.refresh_rate -> virtio-gpu EDID) for a window on screen, given
+ * the CVDisplayLink nominal period (time_value/time_scale, 0/0 = unknown).
+ * 0 = unknown (QEMU's EDID then uses its 75 Hz default).
+ */
+uint32_t ember_vmfg_guest_refresh_mhz(NSScreen *screen, int64_t time_value,
+                                      int32_t time_scale);
+
+/* Main thread, whenever the layer's pixel format was (re)assigned. */
+void ember_vmfg_layer_format(CAMetalLayer *layer, MTLPixelFormat fmt);
+
+/* Main thread: the legacy drawFrame is about to present d (flash probe). */
+void ember_vmfg_legacy_present(id<CAMetalDrawable> d);
+
+/* Main thread, once after the window was first centred (EMBER_VMFG_SCREEN). */
+void ember_vmfg_place_window(NSWindow *w);
+
+/* vmdisp-1031: EMBER_DISP_NEAREST (default 1), runtime tunable: may an integer
+ * zoom sample nearest? Cocoa asks whenever it picks the layer filter. */
+bool ember_vmfg_nearest_ok(void);
+
+/* Main thread: replaces -[NSWindow center] (keeps the chosen screen). */
+void ember_vmfg_center_window(NSWindow *w);
+
+/* Main thread: windowDidChangeScreen (pull back during start-up). */
+void ember_vmfg_window_screen_changed(NSWindow *w);
+#endif
+
+#endif /* UI_EMBER_VMFG_H */
diff --git a/ui/ember-vmfg.m b/ui/ember-vmfg.m
new file mode 100644
index 0000000..bc71987
--- /dev/null
+++ b/ui/ember-vmfg.m
@@ -0,0 +1,3192 @@
+/*
+ * Ember VM frame generation transport for the Cocoa Metal scanout
+ * (stage 2: snapshot ring on IOSurfaces, direct present, external helper).
+ *
+ * Copyright (c) 2026 Ember
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Data flow
+ *   QEMU thread  set_source  : remember the guest's current scanout texture
+ *   QEMU thread  flush       : take a free ring slot, encode+commit a blit
+ *                              snapshot (the guest reuses its 3 scanout
+ *                              resources, so the copy must happen now), then
+ *                              hand the slot to the presenter queue
+ *   presenter queue          : plan (engine), optionally present a generated
+ *                              frame, then present the original
+ *                              (afterMinimumDuration when a generated frame
+ *                              went first), keep the slot as "previous"
+ *   presented handlers       : count frames on glass, arrival->glass latency,
+ *                              vsync phase and latency feedback for the engine
+ *
+ * Engines (the VmfgEngineOps seam)
+ *   dup    : stage 1 pacing stub, shows a copy of the current frame
+ *   helper : EVFX client (ember-vmfg-ipc.c). The ring slots and two output
+ *            slots are IOSurfaces shared with a separate process that the
+ *            Ember app starts; the process answers per frame whether to show
+ *            an extra frame from an output slot and how long to hold the
+ *            next original. If it is missing, slow (deadline = next vsync
+ *            minus a margin) or dies, frames are shown exactly like
+ *            EMBER_VMFG=count. Nothing else is linked or loaded into QEMU.
+ *
+ * Pacing (stage 4, 10-28): at most EMBER_VMFG_INFLIGHT (1) originals are
+ * presented but not yet on glass. A frame that arrives while the gate is
+ * closed waits as "pending" and is replaced by a newer one (mailbox), so the
+ * layer's FIFO never fills: night3 showed every guest frame presented twice
+ * (frame + refresh-timer kick, because SET_SCANOUT_BLOB marks gl_dirty on
+ * every flip) = 120 presents/s into a 60 Hz FIFO, 3 drawables queued and
+ * arrival->glass 74 ms vs 41 ms on the legacy path. The kick now re-presents
+ * only when a frame could not be shown (geometry change, no drawable).
+ *
+ * vmfg5 (10-28): night4 showed the windowed WindowServer pipeline takes
+ * ~2.3 refreshes from present to glass, so one original in flight capped the
+ * glass rate at ~80 of 143 fps. The limit is now adaptive: ceil(fastest
+ * recent present->glass / refresh + 0.25), 1..3 (EMBER_VMFG_INFLIGHT=auto,
+ * default; a number fixes it). A full FIFO cannot build up because the floor
+ * (min) is used, not the mean. The kick wakes the presenter only for an owed
+ * repost (a pending frame is released by the presented handler / timeout).
+ * Statistics: pres_ms (present call -> presentedTime), cb_ms (presentedTime ->
+ * handler), the limit in use, and the layer settings at start.
+ *
+ * Stage 3 (independent of the engine): guest EDID refresh follows the host
+ * screen, optional sRGB tag on the layer, non-SDR8 scanouts never
+ * interpolated, and a one-pixel flash probe for input->glass latency.
+ *
+ * vmfg-1030 (fg mode, helper engine):
+ *   - repeat detection (EMBER_VMFG_DEDUP, default 2 in fg mode): every
+ *     snapshot is compared exactly (full frame, GPU, same command buffer as
+ *     the snapshot copy) with the previous one. A guest flush whose pixels
+ *     equal the previous flush (DWM re-composition of the same game frame)
+ *     is never sent to the engine as a new game frame -- it would be an
+ *     identical "pair" and would halve the engine's measured game interval.
+ *     With 2 it is also not presented again when the identical frame is
+ *     already queued/on glass, so the refresh slot stays free for the
+ *     generated frame (no FIFO growth). 1 = count only, 0 = off.
+ *   - SCENE_RESET is sent only when the frame size changed; a missing
+ *     previous frame alone is "no history" (the helper keeps its engine).
+ *   - statistics lines carry dup counters and a wall-clock ts=.
+ *
+ * vmfgjit-1031 fill (generation rate, nothing here adds latency by default):
+ *   - EMBER_VMFG_GPU_PRIO=0|1|2|-1 (default 0): IOGPU queue priority of the
+ *     snapshot / present queue (0 highest, 1 = Metal default, -1 = leave).
+ *     The guest keeps the GPU at 100 % in GPU-bound games; the snapshot copy
+ *     and present blit are on every frame's critical path.
+ *   - EMBER_VMFG_TUNE=<file>: KEY=VAL lines re-read every 0.5 s on the
+ *     presenter queue (A/B without restarting the VM): EMBER_VMFG_DEADLINE_MS,
+ *     EMBER_VMFG_MIN_BUDGET_MS, EMBER_VMFG_DEADLINE_MODE=vsync|latch,
+ *     EMBER_VMFG_LATCH_MARGIN_MS, EMBER_VMFG_GPU_PRIO.
+ *   - EMBER_VMFG_DEADLINE_MODE=latch (default vsync = unchanged): the helper
+ *     deadline is the compositor latch of the refresh the original alone
+ *     would reach (latest presentedTime grid minus the measured present->glass
+ *     floor, minus EMBER_VMFG_LATCH_MARGIN_MS, default 1.0) instead of "next
+ *     vsync minus 2 ms", whose phase has no relation to the latch when the
+ *     windowed pipeline is 2-3 refreshes deep.
+ *   - a "timing" line every 5 s: guest arrival interval histogram, arrival->
+ *     send, deadline budget, helper receive / work / reply-trip times and why
+ *     timed-out answers were late (work = finished after the deadline, trip =
+ *     finished in time but the reply arrived after it).
+ *
+ * vmdisp-1031 (one copy while nothing is interpolated, display diagnostics):
+ *   - EMBER_VMFG_ONECOPY=auto|1|0 (default auto; also a tune key): the guest
+ *     frame is blitted straight into a drawable in flush, no snapshot and no
+ *     second copy. auto = count mode, or fg mode while the helper's control
+ *     file says "pass". The presenter keeps one "spare" drawable ready so
+ *     flush (BQL held) never calls nextDrawable; no spare, gate closed, older
+ *     frames still with the presenter or a repost owed = the normal snapshot
+ *     path for that frame. Repeat detection and the helper see nothing while
+ *     this runs; leaving it drops the "previous" slot so the engine never
+ *     pairs a frame with a stale one.
+ *   - EMBER_VMFG_SCREEN defaults to "fastest" (keep/off = QEMU's placement).
+ *     10-31: a VM started on the 60 Hz screen read a 60 Hz EDID, stayed at
+ *     60 Hz after the window moved (no EDID re-read) and, from its stored
+ *     mode for that EDID, ran 3840x2160.
+ *   - tune keys EMBER_DISP_SYNC=0|1 and EMBER_DISP_NEAREST=0|1 for A/B without
+ *     rebooting the VM (layer.displaySyncEnabled, integer-zoom filter).
+ *   - EMBER_VMFG_PASS_NOSYNC=1 (env or tune, default 0): layer vsync off while
+ *     one copy is active, on again when generation resumes. The 10-31 native
+ *     trace is Direct to Display with vsync off; the VM's layer never was.
+ *   - EMBER_DISP_DIRECT_LOG=1: count CA's composite/direct verdicts
+ *     (FramePacing, private; same hook as directhdr/mtlhdr) every 5 s:
+ *     "ember-disp: direct n=.. direct=.. codes ...". Code 0 = direct to
+ *     display; decode others with Tools/dev/directhdr/dcode.py.
+ *
+ * vmzero-1031 (zero copy while nothing is interpolated, default off):
+ *   - EMBER_VMZ=1 (env or tune key, needs the one-copy state): the guest's
+ *     scanout buffer itself becomes the contents of a plain CALayer above the
+ *     Metal layer. No QEMU GPU work at all. Needs an IOSurface scanout
+ *     (EMBER_SCANOUT_SURF=1 in the render workers, stage5 virglrenderer).
+ *   - consumer-done fence: virglrenderer hands us the texture's DXMT sync page
+ *     (dxmt_xsync.hpp). QEMU takes one reader lane per scanout buffer: r_issued
+ *     at flush, r_done once the frame left the glass (replaced and
+ *     IOSurfaceIsInUse false, at least EMBER_VMZ_HOLD_MS after that). DWM's
+ *     next write to the buffer GPU-waits for it through the existing bridge,
+ *     with its 100 ms limit and quarantine. A buffer without a lane is copied.
+ *   - statistics line "ember-vmz:" every 5 s.
+ *
+ * Manual retain/release (QEMU builds Objective-C without ARC).
+ */
+
+#include "qemu/osdep.h"
+
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#import <IOSurface/IOSurface.h>
+#import <objc/message.h>
+#import <objc/runtime.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <sys/stat.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdatomic.h>
+
+#include "ember-vmfg.h"
+#include "ember-vmfg-ipc.h"
+
+#define VMFG_SLOTS 5                  /* guest frame snapshots */
+#define VMFG_OUTS 2                   /* generated frames (helper writes) */
+#define VMFG_ALL (VMFG_SLOTS + VMFG_OUTS)
+#define VMFG_HIST 15
+#define VMFG_LAT 256
+#define VMFG_RTT 256
+#define VMFG_RECENT 64
+#define VMFG_RECENT_NS 200000000LL    /* latency feedback window */
+#define VMFG_LOG_NS 5000000000LL
+#define VMFG_PROBE_N 16               /* flash probe read-back slots */
+#define VMFG_GLASS_N 256              /* recent on-glass times (flash probe) */
+#define VMFG_PROBE_REPORT_NS 300000000LL
+
+/* VMFG_PROBE: EMBER_VMFG unset but EMBER_VMFG_FLASH set. The legacy path keeps
+ * presenting; only the flash probe runs. */
+enum { VMFG_OFF = 0, VMFG_COUNT = 1, VMFG_DUP = 2, VMFG_FG = 3, VMFG_PROBE = 4 };
+
+/* ---- engine seam ------------------------------------------------------- */
+
+typedef struct VmfgPlanIn {
+    uint64_t frame_no;
+    int64_t arrival_ns;
+    int64_t game_interval_ns;     /* median guest frame interval, 0 = unknown */
+    int64_t display_interval_ns;
+    bool prev_valid;
+    int cur_slot;                 /* ring slot of this frame */
+    int prev_slot;                /* ring slot of the previous frame, -1 none */
+} VmfgPlanIn;
+
+typedef struct VmfgPlan {
+    bool generate;                /* show a generated frame before the original */
+    float alpha;                  /* time position of the generated frame */
+    double hold_s;                /* generated frame stays at least this long */
+    int gen_slot;                 /* >= 0: slot holding the generated frame;
+                                     the plan owns one reference on it */
+} VmfgPlan;
+
+typedef struct VmfgEngineOps {
+    const char *name;
+    void (*plan)(const VmfgPlanIn *in, VmfgPlan *out);
+    /* Encode into cb if needed; return the texture to show (borrowed) or nil. */
+    id<MTLTexture> (*encode)(id<MTLCommandBuffer> cb, id<MTLTexture> prev,
+                             id<MTLTexture> cur, const VmfgPlan *plan);
+} VmfgEngineOps;
+
+/* ---- state --------------------------------------------------------------- */
+
+typedef struct VmfgSlot {
+    id<MTLTexture> tex;
+    IOSurfaceRef surf;            /* helper mode, BGRA8 scanouts only */
+    uint32_t gen;                 /* changes whenever tex/surf is recreated */
+    id<MTLCommandBuffer> snap;    /* helper mode / dedup: snapshot copy in flight */
+    uint64_t cmp_frame;           /* dedup: frame_no this snapshot was compared with (0 none) */
+    int refs;                     /* job + "previous" + GPU uses + helper */
+    uint64_t frame_no;
+    int64_t arrival_ns;
+} VmfgSlot;
+
+typedef struct VmfgReq {          /* a helper request whose answer is late */
+    bool live;
+    int cur, prev, out;
+    int64_t deadline_ns;          /* vmfgjit-1031: why it was late */
+} VmfgReq;
+
+static struct {
+    int mode;
+    bool log;
+    double gen_ratio;
+    int64_t hz_override_ns;
+    int64_t margin_ns;            /* answer must arrive this long before vsync */
+    int64_t min_budget_ns;
+    const VmfgEngineOps *engine;
+
+    pthread_mutex_t lock;         /* slot refs, source, latency samples */
+    CAMetalLayer *layer;
+    id<MTLDevice> device;
+    id<MTLCommandQueue> queue;
+    dispatch_queue_t pq;
+
+    /* source (QEMU thread writes under lock) */
+    id<MTLTexture> src;
+    MTLOrigin src_origin;
+    MTLSize src_size;
+
+    VmfgSlot slot[VMFG_ALL];
+    uint64_t frame_no;            /* QEMU thread */
+    _Atomic uint32_t gen_counter;
+
+    /* presenter queue only */
+    int prev_slot;
+    int64_t last_arrival_ns;
+    int64_t hist[VMFG_HIST];
+    int hist_n, hist_i;
+    int64_t last_log_ns;
+    EvfxClient *ipc;
+    VmfgReq req;
+    int out_next;
+    bool out_dirty[VMFG_OUTS];
+    uint32_t pend_stale, pend_no_drawable;
+    double rtt[VMFG_RTT], hgpu[VMFG_RTT];
+    int rtt_n, hgpu_n;
+
+    _Atomic int64_t display_ns;
+    _Atomic int queued;
+    _Atomic bool kick_queued;        /* at most one outstanding refresh retry */
+    _Atomic int64_t vsync_ref_ns;     /* latest presentedTime, any frame */
+    _Atomic int64_t orig_glass_ns;    /* latest presentedTime of an original */
+
+    /* statistics (atomics; reset every log line) */
+    _Atomic uint32_t st_in, st_snap_drop, st_stale, st_gen, st_orig,
+                     st_glass_orig, st_glass_gen, st_not_shown, st_no_drawable,
+                     st_layer_skip, st_kick, st_fmt_off;
+    _Atomic uint32_t last_fmt;        /* MTLPixelFormat of the newest frame */
+    _Atomic uint32_t st_deferred, st_superseded, st_inflight_reset;
+
+    /* repeat detection (vmfg-1030) */
+    int dedup;                        /* 0 off, 1 count, 2 count + skip */
+    id<MTLComputePipelineState> cmp_pso;
+    id<MTLBuffer> cmp_buf;            /* VMFG_SLOTS x uint32 "differs" flags */
+    id<MTLComputePipelineState> cmp_sparse_pso; /* nil: full comparison only */
+    id<MTLBuffer> cmp_args;           /* VMFG_SLOTS x MTLDispatchThreadgroupsIndirectArguments */
+    int cmp_ref;                      /* QEMU thread: slot of the previous snapshot (holds a ref), -1 */
+    uint64_t prev_alias;              /* presenter: frame_no whose pixels prev_slot also shows */
+    bool prev_presented;              /* presenter: prev_slot's original was handed to the layer */
+    uint32_t helper_w, helper_h;      /* presenter: size of the last frame sent to the helper */
+    _Atomic uint32_t st_dup, st_dup_skip, st_dup_unknown;
+
+    /* pacing gate (stage 4) */
+    int max_inflight;                 /* EMBER_VMFG_INFLIGHT=<n>, or auto */
+    bool inflight_auto;
+    _Atomic int auto_limit;           /* adaptive limit (auto) */
+    double pres[VMFG_LAT], cbd[VMFG_LAT];   /* under lock, reset per log */
+    int pres_n, cbd_n;
+    int64_t pfloor[64];               /* recent present->glass, under lock */
+    unsigned pfloor_i, pfloor_n;
+    _Atomic int inflight;             /* originals presented, not on glass yet */
+    _Atomic int64_t last_present_ns;
+    int pending;                      /* presenter queue: slot waiting, -1 */
+    _Atomic bool repost;              /* newest frame still needs a present */
+    /* one copy (vmdisp-1031) */
+    int onecopy_cfg;                  /* 0 off, 1 on, 2 auto */
+    _Atomic bool onecopy_on;          /* flush may present directly */
+    _Atomic bool ctl_pass;            /* helper control file says "pass" */
+    _Atomic bool has_pending;         /* mirror of pending >= 0 for flush */
+    _Atomic int pq_busy;              /* snapshot frames not finished by the presenter */
+    id<CAMetalDrawable> spare;        /* under lock; ready for flush */
+    bool direct_active;               /* presenter: last frame went the one-copy way */
+    _Atomic uint32_t st_1c, st_1c_nospare, st_1c_gate, st_1c_busy, st_1c_geom;
+    /* helper statistics (presenter queue) */
+    uint32_t hs_sent, hs_done, hs_gen, hs_timeout, hs_late_reply, hs_busy,
+             hs_off, hs_nosurf, hs_reset, hs_helper_late, hs_noout;
+    double lat[VMFG_LAT];         /* arrival -> on glass, ms (under lock) */
+    int lat_n;
+    int64_t recent_at[VMFG_RECENT], recent_us[VMFG_RECENT];  /* under lock */
+    unsigned recent_i;
+} vmfg = {
+    .lock = PTHREAD_MUTEX_INITIALIZER,
+    .prev_slot = -1,
+    .pending = -1,
+    .cmp_ref = -1,
+    .max_inflight = 1,
+    .inflight_auto = true,
+    .auto_limit = 2,
+    .onecopy_cfg = 2,
+};
+
+/*
+ * Flash probe (EMBER_VMFG_FLASH). Every guest frame: one pixel copied into a
+ * shared buffer next to the snapshot; on GPU completion a dark->bright change
+ * opens an event. 300 ms later the event is reported with the first on-glass
+ * time of a frame at least that new (from the glass ring, or for the legacy
+ * path the first legacy present committed after the arrival).
+ */
+typedef struct VmfgGlass {
+    uint64_t frame_no;
+    int64_t t_ns;
+    bool generated;
+} VmfgGlass;
+
+static struct {
+    bool on;
+    double fx, fy;
+    id<MTLBuffer> buf;            /* VMFG_PROBE_N x 16 bytes, shared */
+    unsigned next;                /* QEMU thread */
+    /* under vmfg.lock */
+    bool bright;
+    uint32_t seq;
+    VmfgGlass glass[VMFG_GLASS_N];
+    unsigned glass_i;
+    int64_t lp_commit[VMFG_GLASS_N], lp_glass[VMFG_GLASS_N];
+    unsigned lp_i;
+} probe;
+
+/* Window screen chosen by EMBER_VMFG_SCREEN (main thread) and the guest
+ * refresh pinned to it (read with the BQL in updateUIInfoLocked). */
+static CGDirectDisplayID vmfg_screen_id;
+static int64_t vmfg_place_ns;
+static _Atomic uint32_t vmfg_pin_mhz;
+#define VMFG_SCREEN_HOLD_NS 20000000000LL   /* pull back for 20 s */
+
+/* Colour tag (EMBER_VMFG_COLORSPACE), read once on the main thread. */
+static int vmfg_cs_mode = -1;     /* -1 unread, 0 none, 1 srgb */
+
+/* vmfgjit-1031 fill: runtime tuning and timing statistics. */
+#define VMFG_TN 256
+static struct {
+    char path[512];               /* EMBER_VMFG_TUNE */
+    struct timespec mtime;
+    int64_t checked_ns;           /* presenter queue */
+    int deadline_mode;            /* 0 vsync (old), 1 latch */
+    int64_t latch_margin_ns;
+    int gpu_prio, gpu_prio_applied;
+    char ctl_path[512];           /* EMBER_VMFG_CONTROL, first word "pass" */
+    int layer_sync;               /* -1 keep, 0/1 displaySyncEnabled */
+    int pass_nosync;              /* EMBER_VMFG_PASS_NOSYNC: sync off while one copy */
+    int follow_sync;              /* value set by pass_nosync, -1 none */
+    _Atomic int64_t floor_ns;     /* min present->glass of originals (auto-limit window) */
+    /* presenter queue only, reset per log line */
+    uint32_t iv_bin[6];           /* <4, 4-10, 10-17, 17-24, 24-40, >=40 ms */
+    double a2s[VMFG_TN], budget[VMFG_TN], hrecv[VMFG_TN], hwork[VMFG_TN],
+           hback[VMFG_TN];
+    int a2s_n, budget_n, hrecv_n, hwork_n, hback_n;
+    uint32_t late_work, late_trip;
+} vtune = {
+    .deadline_mode = 0,
+    .latch_margin_ns = 1000000,
+    .gpu_prio = 0,
+    .gpu_prio_applied = -2,
+    .layer_sync = -1,
+    .follow_sync = -1,
+};
+
+static _Atomic int disp_nearest = -1;   /* -1 unread (EMBER_DISP_NEAREST) */
+
+/* ---- vmzero-1031: sync page mirror (dxmt_xsync.hpp, XSyncPageShm v2) ------ */
+
+#define VZ_MAGIC 0x4f54504eu
+#define VZ_VERSION 2
+#define VZ_LANES 16
+#define VZ_TAB 12                 /* scanout buffers with a lane */
+#define VZ_REL 8                  /* replaced frames not yet off the glass */
+#define VZ_FORCE_NS 50000000LL    /* give a buffer back after this at the latest */
+#define VZ_POLL_NS 1000000LL
+#define VZ_UL_COMPARE_AND_WAIT_SHARED 3u
+#define VZ_ULF_WAKE_ALL 0x00000100u
+#define VZ_ULF_NO_ERRNO 0x01000000u
+extern int __ulock_wake(uint32_t operation, void *addr, uint64_t wake_value);
+
+typedef struct VzLane {
