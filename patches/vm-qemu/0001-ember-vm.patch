+/*
+ * Ember S2 (10-28, vmtimer1): precise WFI wake-up, EMBER_S2_PRECISE_WFI=1 (default off = upstream).
+ * On this macOS (27.x) pselect()/poll()/mach_wait_until() timeouts get a leeway of ~50% of the
+ * interval, independent of thread QoS and taskpolicy -l 0 (measured: 13 ms -> +6.5 ms late,
+ * Tools/dev/vmtimer-1028/tests/wfitest.c). A guest that programs CNTV 13 ms ahead and executes
+ * WFI therefore wakes up to 6.5 ms late (d11bench pace60: 55.9 fps, p95 20.5 ms).
+ * kevent EVFILT_TIMER with NOTE_CRITICAL|NOTE_LEEWAY(0) on an absolute mach deadline wakes within
+ * tens of microseconds. Kicks from other threads trigger a per-vCPU EVFILT_USER (SIG_IPI stays
+ * blocked while we sit in kevent; a pending SIG_IPI only makes a later pselect return early).
+ *   EMBER_S2_PRECISE_WFI_EARLY_US  wake this much before the guest deadline (default 0, precise only)
+ *   EMBER_S2_WFI_SPIN_US           don't sleep below this (default 2000 = upstream, precise only)
+ *   EMBER_S2_WFI_STATS=1           per-vCPU WFI counters + lateness histogram on stderr every 10 s
+ *                                  (works in both modes, so off/on can be compared in the same log)
+ */
+#include <sys/event.h>
+#define EMBER_WFI_MAX_CPUS 256
+#define EMBER_WFI_TIMER_ID 1
+#define EMBER_WFI_USER_ID  2
+static pthread_once_t ember_wfi_once = PTHREAD_ONCE_INIT;
+static bool ember_wfi_precise;
+static bool ember_wfi_stats;
+static uint64_t ember_wfi_spin_ns = 2 * SCALE_MS;
+static uint64_t ember_wfi_early_ns;
+static mach_timebase_info_data_t ember_tb;
+static int ember_wfi_kq[EMBER_WFI_MAX_CPUS]; /* kqueue fd + 1, 0 = none */
+
+typedef struct {
+    uint64_t t0;            /* mach time the current 10 s window started */
+    uint64_t wfi, spin, past, nodl, sleeps, timeouts, kicked, early;
+    uint64_t hist[8];       /* lateness <50us <100 <250 <500 <1ms <2ms <4ms >=4ms (timer wakes only) */
+    double late_sum_us, late_max_us, req_sum_us;
+} EmberWfiStats;
+static EmberWfiStats ember_wfi_st[EMBER_WFI_MAX_CPUS];
+
+static uint64_t ember_env_u64(const char *n, uint64_t def)
+{
+    const char *v = getenv(n);
+    return (v && *v) ? strtoull(v, NULL, 10) : def;
+}
+
+static void ember_wfi_init_once(void)
+{
+    const char *p = getenv("EMBER_S2_PRECISE_WFI"), *s = getenv("EMBER_S2_WFI_STATS");
+
+    mach_timebase_info(&ember_tb);
+    ember_wfi_precise = p && p[0] == '1';
+    ember_wfi_stats = s && s[0] == '1';
+    if (ember_wfi_precise) {
+        ember_wfi_spin_ns = ember_env_u64("EMBER_S2_WFI_SPIN_US", 2000) * SCALE_US;
+        ember_wfi_early_ns = ember_env_u64("EMBER_S2_PRECISE_WFI_EARLY_US", 0) * SCALE_US;
+    }
+    if (ember_wfi_precise || ember_wfi_stats) {
+        fprintf(stderr, "ember-wfi: precise=%d stats=%d spin_us=%llu early_us=%llu\n",
+                ember_wfi_precise, ember_wfi_stats,
+                (unsigned long long)(ember_wfi_spin_ns / SCALE_US),
+                (unsigned long long)(ember_wfi_early_ns / SCALE_US));
+    }
+}
+
+static void ember_wfi_vcpu_init(CPUState *cpu)
+{
+    struct kevent64_s u;
+    int kq;
+
+    pthread_once(&ember_wfi_once, ember_wfi_init_once);
+    if (!ember_wfi_precise || cpu->cpu_index >= EMBER_WFI_MAX_CPUS) {
+        return;
+    }
+    kq = kqueue();
+    if (kq < 0) {
+        fprintf(stderr, "ember-wfi: kqueue failed (%s), cpu %d uses pselect\n", strerror(errno), cpu->cpu_index);
+        return;
+    }
+    EV_SET64(&u, EMBER_WFI_USER_ID, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, 0, 0, 0);
+    if (kevent64(kq, &u, 1, NULL, 0, 0, NULL) < 0) {
+        fprintf(stderr, "ember-wfi: EVFILT_USER failed (%s), cpu %d uses pselect\n", strerror(errno), cpu->cpu_index);
+        close(kq);
+        return;
+    }
+    qatomic_set(&ember_wfi_kq[cpu->cpu_index], kq + 1);
+}
+
+static void ember_wfi_vcpu_destroy(CPUState *cpu)
+{
+    int k;
+
+    if (cpu->cpu_index >= EMBER_WFI_MAX_CPUS) {
+        return;
+    }
+    k = qatomic_xchg(&ember_wfi_kq[cpu->cpu_index], 0);
+    if (k) {
+        close(k - 1);
+    }
+}
+
+/* any thread: wake the vCPU if it sleeps in ember_wfi_wait_precise (stays pending otherwise) */
+static void ember_wfi_kick(CPUState *cpu)
+{
+    struct kevent64_s t;
+    int k;
+
+    if (!ember_wfi_precise || cpu->cpu_index >= EMBER_WFI_MAX_CPUS) {
+        return;
+    }
+    k = qatomic_read(&ember_wfi_kq[cpu->cpu_index]);
+    if (k) {
+        EV_SET64(&t, EMBER_WFI_USER_ID, EVFILT_USER, 0, NOTE_TRIGGER, 0, 0, 0, 0);
+        kevent64(k - 1, &t, 1, NULL, 0, 0, NULL);
+    }
+}
+
+static EmberWfiStats *ember_wfi_stat(CPUState *cpu)
+{
+    EmberWfiStats *st;
+    uint64_t now;
+
+    if (!ember_wfi_stats || cpu->cpu_index >= EMBER_WFI_MAX_CPUS) {
+        return NULL;
+    }
+    st = &ember_wfi_st[cpu->cpu_index];
+    now = mach_absolute_time();
+    if (!st->t0) {
+        st->t0 = now;
+    } else if (now - st->t0 > muldiv64(10 * NANOSECONDS_PER_SECOND, ember_tb.denom, ember_tb.numer)) {
+        uint64_t to = st->timeouts ? st->timeouts : 1;
+        fprintf(stderr, "ember-wfi cpu%d %s: wfi=%llu spin=%llu past=%llu nodl=%llu sleep=%llu timeout=%llu kick=%llu"
+                " req_avg_us=%.0f late_avg_us=%.1f late_max_us=%.0f early=%llu"
+                " hist(<50,<100,<250,<500,<1m,<2m,<4m,>=4m)=%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+                cpu->cpu_index, ember_wfi_precise ? "precise" : "pselect",
+                (unsigned long long)st->wfi, (unsigned long long)st->spin, (unsigned long long)st->past,
+                (unsigned long long)st->nodl, (unsigned long long)st->sleeps, (unsigned long long)st->timeouts,
+                (unsigned long long)st->kicked,
+                st->sleeps ? st->req_sum_us / st->sleeps : 0.0, st->late_sum_us / to, st->late_max_us,
+                (unsigned long long)st->early,
+                (unsigned long long)st->hist[0], (unsigned long long)st->hist[1], (unsigned long long)st->hist[2],
+                (unsigned long long)st->hist[3], (unsigned long long)st->hist[4], (unsigned long long)st->hist[5],
+                (unsigned long long)st->hist[6], (unsigned long long)st->hist[7]);
+        memset(st, 0, sizeof(*st));
+        st->t0 = now;
+    }
+    return st;
+}
+
+/* deadline_mt = the guest's real CNTV deadline in mach time; timed_out = woke by the timer */
+static void ember_wfi_record(EmberWfiStats *st, uint64_t req_ns, uint64_t deadline_mt, bool timed_out)
+{
+    static const double edge[7] = { 50, 100, 250, 500, 1000, 2000, 4000 };
+    double late;
+    int b;
+
+    if (!st) {
+        return;
+    }
+    st->sleeps++;
+    st->req_sum_us += req_ns / 1000.0;
+    if (!timed_out) {
+        st->kicked++;
+        return;
+    }
+    st->timeouts++;
+    late = (double)(int64_t)(mach_absolute_time() - deadline_mt) * ember_tb.numer / ember_tb.denom / 1000.0;
+    if (late < 0) {
+        st->early++;
+        late = 0;
+    }
+    st->late_sum_us += late;
+    if (late > st->late_max_us) {
+        st->late_max_us = late;
+    }
+    for (b = 0; b < 7 && late >= edge[b]; b++) {
+    }
+    st->hist[b]++;
+}
