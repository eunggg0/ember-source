diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index 2cb8196..681eb64 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -220,17 +220,35 @@ static void edid_desc_text(uint8_t *desc, uint8_t type,
     desc[5 + len] = '\n';
 }
 
-static void edid_desc_ranges(uint8_t *desc)
+static void edid_desc_ranges(uint8_t *desc, uint32_t refresh_rate,
+                             uint32_t vtotal)
 {
+    /*
+     * Ember: widen the limits so a preferred timing above 125 Hz / 160 kHz
+     * (e.g. 144 Hz host screens) stays inside them; the stock limits are
+     * kept as the minimum. EDID 1.4 offset flags give +255 when needed.
+     */
+    uint32_t vmax = MAX(125, refresh_rate / 1000 + 2);
+    uint32_t hmax = MAX(160, (uint32_t)((uint64_t)refresh_rate * vtotal /
+                                        1000000) + 2);
+
+    vmax = MIN(vmax, 510);
+    hmax = MIN(hmax, 510);
     edid_desc_type(desc, 0xfd);
 
-    /* vertical (50 -> 125 Hz) */
+    /* vertical (50 -> 125 Hz, or more) */
     desc[5] =  50;
-    desc[6] = 125;
+    desc[6] = vmax > 255 ? vmax - 255 : vmax;
+    if (vmax > 255) {
+        desc[4] |= 0x02;
+    }
 
-    /* horizontal (30 -> 160 kHz) */
+    /* horizontal (30 -> 160 kHz, or more) */
     desc[7] =  30;
-    desc[8] = 160;
+    desc[8] = hmax > 255 ? hmax - 255 : hmax;
+    if (hmax > 255) {
+        desc[4] |= 0x08;
+    }
 
     /* max dot clock (2550 MHz) */
     desc[9] = 2550 / 10;
@@ -513,7 +531,7 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
      * so dta descriptor offsets don't move any more.
      */
 
-    edid_desc_ranges(desc);
+    edid_desc_ranges(desc, refresh_rate, info->prefy + timings.yblank);
     desc = edid_desc_next(edid, dta, desc);
 
     if (desc && info->name) {
