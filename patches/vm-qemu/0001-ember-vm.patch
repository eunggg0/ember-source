+/* ---- slots --------------------------------------------------------------- */
+
+static void vmfg_slot_unref(int i)
+{
+    if (i < 0) {
+        return;
+    }
+    pthread_mutex_lock(&vmfg.lock);
+    assert(vmfg.slot[i].refs > 0);
+    vmfg.slot[i].refs--;
+    pthread_mutex_unlock(&vmfg.lock);
+}
+
+static void vmfg_slot_ref(int i)
+{
+    pthread_mutex_lock(&vmfg.lock);
+    vmfg.slot[i].refs++;
+    pthread_mutex_unlock(&vmfg.lock);
+}
+
+static void vmfg_slot_clear(VmfgSlot *s)
+{
+    [s->tex release];
+    s->tex = nil;
+    if (s->surf) {
+        CFRelease(s->surf);
+        s->surf = NULL;
+    }
+}
+
+/*
+ * (Re)create a slot. Helper mode with a BGRA8 frame: an IOSurface the helper
+ * can map; otherwise a private texture. The slot must be unused (refs owned
+ * by the caller only).
+ */
+static bool vmfg_slot_alloc(VmfgSlot *s, MTLPixelFormat fmt, NSUInteger w,
+                            NSUInteger h)
+{
+    MTLTextureDescriptor *td;
+
+    vmfg_slot_clear(s);
+    td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt
+                                                            width:w
+                                                           height:h
+                                                        mipmapped:NO];
+    td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+    if (vmfg.mode == VMFG_FG && vmfg.ipc && fmt == MTLPixelFormatBGRA8Unorm) {
+        size_t bpr = (w * 4 + 255) & ~(size_t)255;
+        NSDictionary *props = @{
+            (id)kIOSurfaceWidth: @(w),
+            (id)kIOSurfaceHeight: @(h),
+            (id)kIOSurfaceBytesPerElement: @4,
+            (id)kIOSurfaceBytesPerRow: @(bpr),
+            (id)kIOSurfaceAllocSize: @(bpr * h),
+            (id)kIOSurfacePixelFormat: @(EVFX_FORMAT_BGRA8),
+        };
+        s->surf = IOSurfaceCreate((CFDictionaryRef)props);
+        if (s->surf) {
+            td.storageMode = MTLStorageModeShared;
+            s->tex = [vmfg.device newTextureWithDescriptor:td
+                                                 iosurface:s->surf
+                                                     plane:0];
+        }
+        if (!s->tex) {
+            vmfg_slot_clear(s);     /* fall back to a private texture */
+        }
+    }
+    if (!s->tex) {
+        td.storageMode = MTLStorageModePrivate;
+        s->tex = [vmfg.device newTextureWithDescriptor:td];
+    }
+    s->gen = atomic_fetch_add(&vmfg.gen_counter, 1) + 1;
+    return s->tex != nil;
+}
+
+/* ---- stub engine: duplicate the current frame ---------------------------- */
+
+static void vmfg_dup_plan(const VmfgPlanIn *in, VmfgPlan *out)
+{
+    memset(out, 0, sizeof(*out));
+    out->alpha = 0.5f;
+    out->gen_slot = -1;
+    if (vmfg.mode != VMFG_DUP || !in->prev_valid ||
+        in->game_interval_ns <= 0 || in->display_interval_ns <= 0) {
+        return;
+    }
+    /* Fill style: only when the guest leaves a free refresh to fill. */
+    out->generate = in->game_interval_ns >=
+                    (int64_t)(vmfg.gen_ratio * in->display_interval_ns);
+    out->hold_s = in->display_interval_ns * 0.9e-9;
+}
+
+static id<MTLTexture> vmfg_dup_encode(id<MTLCommandBuffer> cb,
+                                      id<MTLTexture> prev,
+                                      id<MTLTexture> cur, const VmfgPlan *plan)
+{
+    (void)cb; (void)prev; (void)plan;
+    return cur;
+}
+
+static const VmfgEngineOps vmfg_engine_dup = {
+    .name = "dup",
+    .plan = vmfg_dup_plan,
+    .encode = vmfg_dup_encode,
+};
