+static int64_t vmfg_display_ns(void)
+{
+    int64_t ns = vmfg.hz_override_ns;
+    if (ns <= 0) {
+        ns = atomic_load(&vmfg.display_ns);
+    }
+    return ns > 0 ? ns : 16666667;
+}
