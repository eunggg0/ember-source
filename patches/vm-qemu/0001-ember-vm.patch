diff --git a/hw/display/virtio-gpu-pci.c b/hw/display/virtio-gpu-pci.c
index 6d78970..12a637a 100644
--- a/hw/display/virtio-gpu-pci.c
+++ b/hw/display/virtio-gpu-pci.c
@@ -25,6 +25,77 @@ static const Property virtio_gpu_pci_base_properties[] = {
     DEFINE_VIRTIO_GPU_PCI_PROPERTIES(VirtIOPCIProxy),
 };
 
+/*
+ * Ember S2 (10-27) diagnostics: the hostmem BAR is a pure container, so a
+ * guest access to an offset no blob is mapped at used to fall through to
+ * the PCI window as unassigned -- reads 0, writes dropped, and silent for
+ * every ISV=1 (single GPR) access.  Put a lowest-priority I/O region under
+ * the blobs so those accesses are visible: same 0/drop semantics, but the
+ * first ones are logged with the BAR address and the neighbouring blobs.
+ * Mapped blobs (priority 0) still go straight to RAM via HVF stage 2.
+ */
+static void virtio_gpu_hostmem_hole_report(VirtIOGPUBase *g, hwaddr addr,
+                                           unsigned size, bool write,
+                                           uint64_t val)
+{
+    static unsigned n;
+    MemoryRegion *sub, *prev = NULL, *next = NULL;
+
+    n++;
+    if (n > 64 && (n & 4095) != 0) {
+        return;
+    }
+    QTAILQ_FOREACH(sub, &g->hostmem.subregions, subregions_link) {
+        if (!memory_region_is_ram(sub)) {
+            continue;                       /* the hole region itself */
+        }
+        if (sub->addr <= addr && (!prev || sub->addr > prev->addr)) {
+            prev = sub;
+        }
+        if (sub->addr > addr && (!next || sub->addr < next->addr)) {
+            next = sub;
+        }
+    }
+    fprintf(stderr,
+            "virtio-gpu: hostmem HOLE %s #%u off=0x%" HWADDR_PRIx
+            " size=%u val=0x%" PRIx64 " bar=0x%" HWADDR_PRIx
+            " ipa=0x%" HWADDR_PRIx " prev=%s@0x%" HWADDR_PRIx "+0x%" PRIx64
+            " next=%s@0x%" HWADDR_PRIx " t=%" PRId64 "ms\n",
+            write ? "write" : "read", n, addr, size, write ? val : 0,
+            g->hostmem.addr, g->hostmem.addr + addr,
+            prev && memory_region_owner(prev) ?
+                object_get_canonical_path_component(memory_region_owner(prev))
+                : "-",
+            prev ? prev->addr : 0,
+            prev ? (uint64_t)memory_region_size(prev) : 0,
+            next && memory_region_owner(next) ?
+                object_get_canonical_path_component(memory_region_owner(next))
+                : "-",
+            next ? next->addr : 0,
+            g_get_real_time() / 1000 % 100000000);
+}
+
+static uint64_t virtio_gpu_hostmem_hole_read(void *opaque, hwaddr addr,
+                                             unsigned size)
+{
+    virtio_gpu_hostmem_hole_report(opaque, addr, size, false, 0);
+    return 0;
+}
+
+static void virtio_gpu_hostmem_hole_write(void *opaque, hwaddr addr,
+                                          uint64_t val, unsigned size)
+{
+    virtio_gpu_hostmem_hole_report(opaque, addr, size, true, val);
+}
+
+static const MemoryRegionOps virtio_gpu_hostmem_hole_ops = {
+    .read = virtio_gpu_hostmem_hole_read,
+    .write = virtio_gpu_hostmem_hole_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8 },
+    .impl = { .min_access_size = 1, .max_access_size = 8 },
+};
+
 static void virtio_gpu_pci_base_realize(VirtIOPCIProxy *vpci_dev, Error **errp)
 {
     VirtIOGPUPCIBase *vgpu = VIRTIO_GPU_PCI_BASE(vpci_dev);
@@ -37,6 +108,15 @@ static void virtio_gpu_pci_base_realize(VirtIOPCIProxy *vpci_dev, Error **errp)
         vpci_dev->modern_mem_bar_idx = 2;
         memory_region_init(&g->hostmem, OBJECT(g), "virtio-gpu-hostmem",
                            g->conf.hostmem);
+        {
+            /* Ember S2: see virtio_gpu_hostmem_hole_report() */
+            MemoryRegion *hole = g_new0(MemoryRegion, 1);
+
+            memory_region_init_io(hole, OBJECT(g),
+                                  &virtio_gpu_hostmem_hole_ops, g,
+                                  "virtio-gpu-hostmem-hole", g->conf.hostmem);
+            memory_region_add_subregion_overlap(&g->hostmem, 0, hole, -1);
+        }
         pci_register_bar(&vpci_dev->pci_dev, 4,
                          PCI_BASE_ADDRESS_SPACE_MEMORY |
                          PCI_BASE_ADDRESS_MEM_PREFETCH |
