+static void vmfg_note_glass(id<MTLDrawable> d, bool generated,
+                            int64_t arrival_ns, uint64_t frame_no,
+                            int64_t call_ns, int64_t cb_ns)
+{
+    CFTimeInterval t = d.presentedTime;
+    int64_t t_ns, lat_ns;
+
+    if (t <= 0) {
+        atomic_fetch_add(&vmfg.st_not_shown, 1);
+        return;
+    }
+    t_ns = (int64_t)(t * 1e9);
+    vmfg_atomic_max(&vmfg.vsync_ref_ns, t_ns);
+    if (probe.on) {
+        pthread_mutex_lock(&vmfg.lock);
+        probe.glass[probe.glass_i++ % VMFG_GLASS_N] =
+            (VmfgGlass){ .frame_no = frame_no, .t_ns = t_ns,
+                         .generated = generated };
+        pthread_mutex_unlock(&vmfg.lock);
+    }
+    if (generated) {
+        atomic_fetch_add(&vmfg.st_glass_gen, 1);
+        return;
+    }
+    atomic_fetch_add(&vmfg.st_glass_orig, 1);
+    vmfg_atomic_max(&vmfg.orig_glass_ns, t_ns);
+    lat_ns = t_ns - arrival_ns;
+    pthread_mutex_lock(&vmfg.lock);
+    if (call_ns > 0 && t_ns > call_ns && t_ns - call_ns < 500000000LL) {
+        int64_t pf = t_ns - call_ns, mn;
+        unsigned k;
+        if (vmfg.pres_n < VMFG_LAT) {
+            vmfg.pres[vmfg.pres_n++] = pf / 1e6;
+        }
+        if (vmfg.cbd_n < VMFG_LAT) {
+            vmfg.cbd[vmfg.cbd_n++] = (cb_ns - t_ns) / 1e6;
+        }
+        vmfg.pfloor[vmfg.pfloor_i++ % 64] = pf;
+        if (vmfg.pfloor_n < 64) {
+            vmfg.pfloor_n++;
+        }
+        if (vmfg.pfloor_n >= 16 && vmfg.pfloor_i % 8 == 0) {
+            /* floor of the pipeline: min of the last 64, not the mean, so a
+               queue we build ourselves cannot raise the limit (no runaway) */
+            mn = vmfg.pfloor[0];
+            for (k = 1; k < vmfg.pfloor_n; k++) {
+                mn = MIN(mn, vmfg.pfloor[k]);
+            }
+            atomic_store(&vmfg.auto_limit,
+                         MAX(1, MIN(3, (int)ceil((double)mn /
+                                                 vmfg_display_ns() + 0.25))));
+            atomic_store(&vtune.floor_ns, mn);
+        }
+    }
+    if (vmfg.lat_n < VMFG_LAT) {
+        vmfg.lat[vmfg.lat_n++] = lat_ns / 1e6;
+    }
+    if (lat_ns > 0 && lat_ns < 1000000000LL) {
+        unsigned k = vmfg.recent_i++ % VMFG_RECENT;
+        vmfg.recent_at[k] = t_ns;
+        vmfg.recent_us[k] = lat_ns / 1000;
+    }
+    pthread_mutex_unlock(&vmfg.lock);
+}
+
+/* Mean arrival->glass latency of originals shown in the last 200 ms. */
+static int64_t vmfg_recent_latency_us(int64_t now)
+{
+    int64_t sum = 0;
+    int n = 0, k;
+
+    pthread_mutex_lock(&vmfg.lock);
+    for (k = 0; k < VMFG_RECENT; k++) {
+        if (vmfg.recent_at[k] > 0 && now >= vmfg.recent_at[k] &&
+            now - vmfg.recent_at[k] <= VMFG_RECENT_NS) {
+            sum += vmfg.recent_us[k];
+            n++;
+        }
+    }
+    pthread_mutex_unlock(&vmfg.lock);
+    return n ? sum / n : 0;
+}
+
+static void vmfg_pctl(double *v, int n, double *p50, double *p95)
+{
+    *p50 = *p95 = 0;
+    if (n > 0) {
+        qsort(v, n, sizeof(double), vmfg_cmp_double);
+        *p50 = v[n / 2];
+        *p95 = v[(n * 95) / 100 < n ? (n * 95) / 100 : n - 1];
+    }
+}
+
+static void vmfg_log_stats(int64_t now)
+{
+    double lat[VMFG_LAT], p50, p95, secs;
+    double pres[VMFG_LAT], cbd[VMFG_LAT], pr50, pr95, cb50, cb95;
+    int n, pn, cn;
+
+    if (!vmfg.log) {
+        return;
+    }
+    if (!vmfg.last_log_ns) {
+        vmfg.last_log_ns = now;
+        return;
+    }
+    if (now - vmfg.last_log_ns < VMFG_LOG_NS) {
+        return;
+    }
+    secs = (now - vmfg.last_log_ns) / 1e9;
+    vmfg.last_log_ns = now;
+
+    pthread_mutex_lock(&vmfg.lock);
+    n = vmfg.lat_n;
+    memcpy(lat, vmfg.lat, sizeof(double) * n);
+    vmfg.lat_n = 0;
+    pn = vmfg.pres_n;
+    memcpy(pres, vmfg.pres, sizeof(double) * pn);
+    vmfg.pres_n = 0;
+    cn = vmfg.cbd_n;
+    memcpy(cbd, vmfg.cbd, sizeof(double) * cn);
+    vmfg.cbd_n = 0;
+    pthread_mutex_unlock(&vmfg.lock);
+    vmfg_pctl(lat, n, &p50, &p95);
+    vmfg_pctl(pres, pn, &pr50, &pr95);
+    vmfg_pctl(cbd, cn, &cb50, &cb95);
+
+    {
+        uint32_t in = atomic_exchange(&vmfg.st_in, 0);
+        uint32_t go = atomic_exchange(&vmfg.st_glass_orig, 0);
+        uint32_t gg = atomic_exchange(&vmfg.st_glass_gen, 0);
+        fprintf(stderr,
+                "ember-vmfg: mode=%s engine=%s fmt=%s fmt_off=%u "
+                "in=%.1f fps glass=%.1f fps "
+                "(orig %u gen %u) planned_gen=%u orig=%u stale=%u "
+                "snap_drop=%u no_drawable=%u not_shown=%u layer_skip=%u "
+                "kick=%u deferred=%u superseded=%u inflight_reset=%u "
+                "lat_ms p50=%.1f p95=%.1f n=%d game_ms=%.2f "
+                "disp_ms=%.2f inflight_lim=%d%s pres_ms p50=%.2f p95=%.2f "
+                "cb_ms p50=%.2f p95=%.2f dup=%u dup_skip=%u dup_unknown=%u "
+                "ts=%.3f\n",
+                vmfg_mode_name(), vmfg.engine->name,
+                vmfg_fmt_name((MTLPixelFormat)atomic_load(&vmfg.last_fmt)),
+                atomic_exchange(&vmfg.st_fmt_off, 0),
+                in / secs, (go + gg) / secs, go, gg,
+                atomic_exchange(&vmfg.st_gen, 0),
+                atomic_exchange(&vmfg.st_orig, 0),
+                atomic_exchange(&vmfg.st_stale, 0),
+                atomic_exchange(&vmfg.st_snap_drop, 0),
+                atomic_exchange(&vmfg.st_no_drawable, 0),
+                atomic_exchange(&vmfg.st_not_shown, 0),
+                atomic_exchange(&vmfg.st_layer_skip, 0),
+                atomic_exchange(&vmfg.st_kick, 0),
+                atomic_exchange(&vmfg.st_deferred, 0),
+                atomic_exchange(&vmfg.st_superseded, 0),
+                atomic_exchange(&vmfg.st_inflight_reset, 0),
+                p50, p95, n, vmfg_median_interval() / 1e6,
+                vmfg_display_ns() / 1e6, vmfg_inflight_limit(),
+                vmfg.inflight_auto ? "(auto)" : "", pr50, pr95, cb50, cb95,
+                atomic_exchange(&vmfg.st_dup, 0),
+                atomic_exchange(&vmfg.st_dup_skip, 0),
+                atomic_exchange(&vmfg.st_dup_unknown, 0),
+                [[NSDate date] timeIntervalSince1970]);
+    }
+    if (vmfg.onecopy_cfg) {
+        fprintf(stderr, "ember-vmfg: onecopy on=%d direct=%u fallback "
+                "nospare=%u gate=%u busy=%u geom=%u ts=%.3f\n",
+                (int)atomic_load(&vmfg.onecopy_on),
+                atomic_exchange(&vmfg.st_1c, 0),
+                atomic_exchange(&vmfg.st_1c_nospare, 0),
+                atomic_exchange(&vmfg.st_1c_gate, 0),
+                atomic_exchange(&vmfg.st_1c_busy, 0),
+                atomic_exchange(&vmfg.st_1c_geom, 0),
+                [[NSDate date] timeIntervalSince1970]);
+    }
+    if (vz.cfg || vz.was_on) {
+        double h50, h95;
+        vmfg_pctl(vz.hold_ms, vz.hold_n, &h50, &h95);
+        fprintf(stderr, "ember-vmz: on=%d ready=%d show=%u same=%u released=%u "
+                "forced=%u fallback nosurf=%u nolane=%u geom=%u evict=%u "
+                "held=%d hold_ms p50=%.2f p95=%.2f ts=%.3f\n",
+                (int)atomic_load(&vz.on), (int)atomic_load(&vz.ready),
+                atomic_exchange(&vz.st_show, 0),
+                atomic_exchange(&vz.st_same, 0),
+                atomic_exchange(&vz.st_released, 0),
+                atomic_exchange(&vz.st_forced, 0),
+                atomic_exchange(&vz.st_nosurf, 0),
+                atomic_exchange(&vz.st_nolane, 0),
+                atomic_exchange(&vz.st_geom, 0),
+                atomic_exchange(&vz.st_evict, 0),
+                vz.rel_n + (vz.has_cur ? 1 : 0), h50, h95,
+                [[NSDate date] timeIntervalSince1970]);
+        vz.hold_n = 0;
+    }
+    if (vmfg.mode == VMFG_FG && vmfg.ipc) {
+        double r50, r95, g50, g95;
+        vmfg_pctl(vmfg.rtt, vmfg.rtt_n, &r50, &r95);
+        vmfg_pctl(vmfg.hgpu, vmfg.hgpu_n, &g50, &g95);
+        fprintf(stderr,
+                "ember-vmfg: helper=%s sent=%u done=%u gen=%u timeout=%u "
+                "late_reply=%u helper_late=%u busy=%u off=%u nosurf=%u "
+                "no_out=%u reset=%u rtt_ms p50=%.2f p95=%.2f "
+                "helper_gpu_ms p50=%.2f p95=%.2f ts=%.3f\n",
+                evfx_client_state(vmfg.ipc), vmfg.hs_sent, vmfg.hs_done,
+                vmfg.hs_gen, vmfg.hs_timeout, vmfg.hs_late_reply,
+                vmfg.hs_helper_late, vmfg.hs_busy, vmfg.hs_off,
+                vmfg.hs_nosurf, vmfg.hs_noout, vmfg.hs_reset,
+                r50, r95, g50, g95, [[NSDate date] timeIntervalSince1970]);
+        vmfg.hs_sent = vmfg.hs_done = vmfg.hs_gen = vmfg.hs_timeout = 0;
+        vmfg.hs_late_reply = vmfg.hs_helper_late = vmfg.hs_busy = 0;
+        vmfg.hs_off = vmfg.hs_nosurf = vmfg.hs_noout = vmfg.hs_reset = 0;
+        vmfg.rtt_n = vmfg.hgpu_n = 0;
+    }
+    if (vmfg.mode == VMFG_FG) {
+        double a50, a95, b05, b50, rc50, rc95, w50, w95, bk50, bk95, dummy;
+        vmfg_pctl(vtune.a2s, vtune.a2s_n, &a50, &a95);
+        vmfg_pctl(vtune.budget, vtune.budget_n, &b50, &dummy);
+        b05 = vtune.budget_n ? vtune.budget[(vtune.budget_n * 5) / 100] : 0;
+        vmfg_pctl(vtune.hrecv, vtune.hrecv_n, &rc50, &rc95);
+        vmfg_pctl(vtune.hwork, vtune.hwork_n, &w50, &w95);
+        vmfg_pctl(vtune.hback, vtune.hback_n, &bk50, &bk95);
+        fprintf(stderr,
+                "ember-vmfg: timing iv_ms<4=%u 4-10=%u 10-17=%u 17-24=%u "
+                "24-40=%u 40+=%u a2s_ms p50=%.2f p95=%.2f budget_ms p05=%.2f "
+                "p50=%.2f hrecv_ms p50=%.3f p95=%.3f hwork_ms p50=%.2f "
+                "p95=%.2f hback_ms p50=%.3f p95=%.3f late_work=%u "
+                "late_trip=%u floor_ms=%.2f mode=%s margin_ms=%.2f "
+                "minb_ms=%.2f prio=%d ts=%.3f\n",
+                vtune.iv_bin[0], vtune.iv_bin[1], vtune.iv_bin[2],
+                vtune.iv_bin[3], vtune.iv_bin[4], vtune.iv_bin[5],
+                a50, a95, b05, b50, rc50, rc95, w50, w95, bk50, bk95,
+                vtune.late_work, vtune.late_trip,
+                atomic_load(&vtune.floor_ns) / 1e6,
+                vtune.deadline_mode ? "latch" : "vsync",
+                (vtune.deadline_mode ? vtune.latch_margin_ns :
+                 vmfg.margin_ns) / 1e6,
+                vmfg.min_budget_ns / 1e6, vtune.gpu_prio_applied,
+                [[NSDate date] timeIntervalSince1970]);
+    }
+    memset(vtune.iv_bin, 0, sizeof(vtune.iv_bin));
+    vtune.a2s_n = vtune.budget_n = vtune.hrecv_n = vtune.hwork_n = 0;
+    vtune.hback_n = 0;
+    vtune.late_work = vtune.late_trip = 0;
+}
+
+/* vmfgjit-1031: IOGPU queue priority (private, checked at run time). */
+static void vmfg_apply_gpu_prio(void)
+{
+    SEL sel = @selector(setGPUPriority:);
+
+    if (!vmfg.queue || vtune.gpu_prio < 0 || vtune.gpu_prio > 2 ||
+        vtune.gpu_prio == vtune.gpu_prio_applied) {
+        return;
+    }
+    if ([(id)vmfg.queue respondsToSelector:sel]) {
+        BOOL ok = ((BOOL (*)(id, SEL, unsigned long long))objc_msgSend)(
+            (id)vmfg.queue, sel, (unsigned long long)vtune.gpu_prio);
+        vtune.gpu_prio_applied = ok ? vtune.gpu_prio : -3;
+    } else {
+        vtune.gpu_prio_applied = -4;
+    }
+}
+
+static void vmfg_tune_set(const char *k, const char *v)
+{
+    if (!strcmp(k, "EMBER_VMFG_DEADLINE_MS") && atof(v) >= 0) {
+        vmfg.margin_ns = (int64_t)(atof(v) * 1e6);
+    } else if (!strcmp(k, "EMBER_VMFG_MIN_BUDGET_MS") && atof(v) >= 0) {
+        vmfg.min_budget_ns = (int64_t)(atof(v) * 1e6);
+    } else if (!strcmp(k, "EMBER_VMFG_DEADLINE_MODE")) {
+        vtune.deadline_mode = !strcmp(v, "latch");
+    } else if (!strcmp(k, "EMBER_VMFG_LATCH_MARGIN_MS") && atof(v) >= 0) {
+        vtune.latch_margin_ns = (int64_t)(atof(v) * 1e6);
+    } else if (!strcmp(k, "EMBER_VMFG_GPU_PRIO")) {
+        vtune.gpu_prio = atoi(v);
+    } else if (!strcmp(k, "EMBER_VMFG_ONECOPY")) {
+        vmfg.onecopy_cfg = !strcmp(v, "auto") ? 2 : atoi(v) != 0;
+    } else if (!strcmp(k, "EMBER_VMFG_PASS_NOSYNC")) {
+        vtune.pass_nosync = atoi(v) != 0;
+    } else if (!strcmp(k, "EMBER_VMZ")) {
+        vz.cfg = atoi(v) != 0;
+    } else if (!strcmp(k, "EMBER_VMZ_HOLD_MS")) {
+        vz.hold_ns = atof(v) < 0 ? -1 : (int64_t)(atof(v) * 1e6);
+    } else if (!strcmp(k, "EMBER_DISP_SYNC")) {
+        int want = !strcmp(v, "keep") ? -1 : atoi(v) != 0;
+        if (want >= 0 && want != vtune.layer_sync) {
+            CAMetalLayer *l = vmfg.layer;
+            vtune.layer_sync = want;
+            dispatch_async(dispatch_get_main_queue(), ^{
+                l.displaySyncEnabled = want;
+            });
+        }
+    } else if (!strcmp(k, "EMBER_DISP_NEAREST")) {
+        int want = atoi(v) != 0;
+        if (want != atomic_exchange(&disp_nearest, want)) {
+            CAMetalLayer *l = vmfg.layer;
+            /* an integer zoom is what made nearest legal; the next geometry
+               update re-checks, so only the "off" direction is applied now */
+            if (!want) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    l.magnificationFilter = kCAFilterLinear;
+                });
+            }
+        }
+    }
+}
+
+static void vz_update(bool onecopy);
+
+/* Presenter queue: one-copy state from the settings and the control file. */
+static void vmfg_onecopy_update(void)
+{
+    bool on;
+
+    if (vtune.ctl_path[0]) {
+        char word[16] = "";
+        FILE *f = fopen(vtune.ctl_path, "r");
+        if (f) {
+            if (fscanf(f, "%15s", word) == 1) {
+                atomic_store(&vmfg.ctl_pass, !strcmp(word, "pass"));
+            }
+            fclose(f);
+        }
+    }
+    on = vmfg.onecopy_cfg == 1 ||
+         (vmfg.onecopy_cfg == 2 && (vmfg.mode == VMFG_COUNT ||
+                                    (vmfg.mode == VMFG_FG &&
+                                     atomic_load(&vmfg.ctl_pass))));
+    if (on && (probe.on || vmfg.mode == VMFG_DUP)) {
+        on = false;               /* these need the snapshot */
+    }
+    atomic_store(&vmfg.onecopy_on, on);
+    vz_update(on);
+    /* Direct to display needs displaySyncEnabled=NO, 3 drawables and plain
+       presents, which is exactly the no-generation path. An explicit
+       EMBER_DISP_SYNC wins; the fg path keeps its vsync pacing. */
+    if (vtune.layer_sync < 0 && (vtune.pass_nosync || vtune.follow_sync >= 0)) {
+        int want = !(vtune.pass_nosync && on);
+        if (want != vtune.follow_sync) {
+            CAMetalLayer *l = vmfg.layer;
+            vtune.follow_sync = want;
+            fprintf(stderr, "ember-vmfg: pass_nosync: displaySyncEnabled=%d\n",
+                    want);
+            dispatch_async(dispatch_get_main_queue(), ^{
+                l.displaySyncEnabled = want;
+            });
+        }
+    }
+}
+
+/* Presenter queue (and once at init): re-read the tune file when it changed. */
+static void vmfg_tune_poll(int64_t now)
+{
+    struct stat st;
+    FILE *f;
+    char line[256];
+
+    if (vtune.checked_ns && now - vtune.checked_ns < 500000000LL) {
+        return;
+    }
+    vtune.checked_ns = now;
+    vmfg_onecopy_update();
+    if (!vtune.path[0]) {
+        return;
+    }
+    if (stat(vtune.path, &st) != 0 ||
+        (st.st_mtimespec.tv_sec == vtune.mtime.tv_sec &&
+         st.st_mtimespec.tv_nsec == vtune.mtime.tv_nsec)) {
+        return;
+    }
+    vtune.mtime = st.st_mtimespec;
+    f = fopen(vtune.path, "r");
+    if (!f) {
+        return;
+    }
+    while (fgets(line, sizeof(line), f)) {
+        char *eq = strchr(line, '='), *end;
+
+        if (line[0] == '#' || !eq) {
+            continue;
+        }
+        *eq = 0;
+        end = eq + 1 + strcspn(eq + 1, " \t\r\n#");
+        *end = 0;
+        vmfg_tune_set(line, eq + 1);
+    }
+    fclose(f);
+    vmfg_apply_gpu_prio();
+    vmfg_onecopy_update();
+    fprintf(stderr, "ember-vmfg: tune %s: deadline_ms=%.2f min_budget_ms=%.2f "
+            "mode=%s latch_margin_ms=%.2f gpu_prio=%d(applied %d) onecopy=%d "
+            "layer_sync=%d nearest=%d\n",
+            vtune.path, vmfg.margin_ns / 1e6, vmfg.min_budget_ns / 1e6,
+            vtune.deadline_mode ? "latch" : "vsync",
+            vtune.latch_margin_ns / 1e6, vtune.gpu_prio,
+            vtune.gpu_prio_applied, (int)atomic_load(&vmfg.onecopy_on),
+            vtune.layer_sync, atomic_load(&disp_nearest));
+}
+
+/* ---- helper engine (EVFX client) ------------------------------------------ */
+
+/*
+ * The deadline for the helper's answer: the next display refresh we can
+ * still make, minus a margin for the present blit and the compositor. With
+ * no answer by then the original is shown alone (as in count mode).
+ */
+static int64_t vmfg_deadline(int64_t now, int64_t disp)
+{
+    int64_t ref = atomic_load(&vmfg.vsync_ref_ns), next, dl;
+    int64_t fl = atomic_load(&vtune.floor_ns);
+
+    if (vtune.deadline_mode == 1 && fl > 0 && fl < 8 * disp && ref > 0 &&
+        now - ref < 1000000000LL && ref - now < 4 * disp) {
+        /* vmfgjit-1031 latch: a present made at L = V - floor still reaches
+           refresh V; the original alone would reach the first V whose latch
+           is after now, so the generated frame has until that latch. */
+        int64_t latch = ref - fl;
+
+        if (latch <= now) {
+            latch += ((now - latch) / disp + 1) * disp;
+        } else {
+            latch -= ((latch - now - 1) / disp) * disp;
+        }
+        dl = latch - vtune.latch_margin_ns;
+        if (dl - now < vmfg.min_budget_ns) {
+            dl += disp;
+        }
+        return dl;
+    }
+    if (ref > 0 && now - ref < 1000000000LL && ref - now < 4 * disp) {
+        next = ref > now ? ref : ref + ((now - ref) / disp + 1) * disp;
+    } else {
+        next = now + disp;          /* no phase reference yet */
+    }
+    dl = next - vmfg.margin_ns;
+    if (dl - now < vmfg.min_budget_ns) {
+        dl += disp;
+    }
+    return dl;
+}
+
+/* Presenter queue: a free output slot sized like cur (refs = 1), or -1. */
+static int vmfg_out_pick(id<MTLTexture> cur)
+{
+    int n;
+
+    for (n = 0; n < VMFG_OUTS; n++) {
+        int k = (vmfg.out_next + n) % VMFG_OUTS, j = VMFG_SLOTS + k;
+        VmfgSlot *s = &vmfg.slot[j];
+        bool free;
+
+        pthread_mutex_lock(&vmfg.lock);
+        free = s->refs == 0;
+        if (free) {
+            s->refs = 1;
+        }
+        pthread_mutex_unlock(&vmfg.lock);
+        if (!free) {
+            continue;
+        }
+        if (!s->tex || !s->surf || vmfg.out_dirty[k] ||
+            s->tex.width != cur.width || s->tex.height != cur.height) {
+            vmfg.out_dirty[k] = false;
+            if (!vmfg_slot_alloc(s, MTLPixelFormatBGRA8Unorm, cur.width,
+                                 cur.height) || !s->surf) {
+                vmfg_slot_unref(j);
+                return -1;
+            }
+        }
+        vmfg.out_next = k + 1;
+        return j;
+    }
+    return -1;
+}
+
+static void vmfg_req_release(const VmfgReq *r)
+{
+    vmfg_slot_unref(r->cur);
+    vmfg_slot_unref(r->prev);
+    vmfg_slot_unref(r->out);
+}
+
+/*
+ * The helper answered request r. Its input slots are free for reuse again.
+ * With out non-NULL (answer in time) a generated frame becomes the plan,
+ * which then owns the output slot's reference.
+ */
+static void vmfg_fg_finish(const VmfgReq *r, const EvfxResult *res,
+                           VmfgPlan *out)
+{
+    vmfg_slot_unref(r->cur);
+    vmfg_slot_unref(r->prev);
+    if (vmfg.rtt_n < VMFG_RTT) {
+        vmfg.rtt[vmfg.rtt_n++] = res->rtt_ns / 1e6;
+    }
+    if (res->recv_ns > 0 && res->done_ns >= res->recv_ns &&
+        res->recv_ns >= res->sent_ns) {
+        vtune_push(vtune.hrecv, &vtune.hrecv_n,
+                   (res->recv_ns - res->sent_ns) / 1e6);
+        vtune_push(vtune.hwork, &vtune.hwork_n,
+                   (res->done_ns - res->recv_ns) / 1e6);
+        vtune_push(vtune.hback, &vtune.hback_n,
+                   (res->sent_ns + res->rtt_ns - res->done_ns) / 1e6);
+        if (!out && r->deadline_ns > 0) {       /* collected after a timeout */
+            if (res->done_ns > r->deadline_ns) {
+                vtune.late_work++;
+            } else {
+                vtune.late_trip++;
+            }
+        }
+    }
+    if (res->status == EVFX_ST_LATE) {
+        vmfg.hs_helper_late++;
+    }
+    if (out && res->status == EVFX_ST_OK && res->generate && r->out >= 0 &&
+        res->out_index == r->out - VMFG_SLOTS) {
+        int64_t disp = vmfg_display_ns(), hold = res->hold_ns;
+
+        if (hold <= 0 || hold > 4 * disp) {
+            hold = disp * 9 / 10;
+        }
+        if (vmfg.hgpu_n < VMFG_RTT) {
+            vmfg.hgpu[vmfg.hgpu_n++] = res->gpu_ns / 1e6;
+        }
+        out->generate = true;
+        out->gen_slot = r->out;
+        out->hold_s = hold / 1e9;
+        out->alpha = 0.5f;
+        vmfg.hs_gen++;
+        return;
+    }
+    vmfg_slot_unref(r->out);
+}
+
+/* Presenter queue, before each frame: late answers and lost sessions. */
+static void vmfg_fg_housekeeping(void)
+{
+    EvfxResult res;
+    int k;
+
+    if (!vmfg.ipc) {
+        return;
+    }
+    if (vmfg.req.live && evfx_client_collect(vmfg.ipc, &res)) {
+        vmfg_fg_finish(&vmfg.req, &res, NULL);
+        vmfg.req.live = false;
+        vmfg.hs_late_reply++;
+    }
+    if (evfx_client_take_reset(vmfg.ipc)) {
+        if (vmfg.req.live) {
+            vmfg_req_release(&vmfg.req);
+            vmfg.req.live = false;
+        }
+        /* A helper that hung may still write into old output buffers. */
+        for (k = 0; k < VMFG_OUTS; k++) {
+            vmfg.out_dirty[k] = true;
+        }
+        vmfg.hs_reset++;
+    }
+}
+
+static void vmfg_fg_plan(const VmfgPlanIn *in, VmfgPlan *out)
+{
+    VmfgSlot *cs = &vmfg.slot[in->cur_slot];
+    int64_t now = vmfg_now_ns();
+    VmfgReq r = { .live = false, .cur = in->cur_slot, .prev = -1, .out = -1 };
+    EvfxFrame f;
+    EvfxResult res;
+
+    memset(out, 0, sizeof(*out));
+    out->alpha = 0.5f;
+    out->gen_slot = -1;
+
+    if (!evfx_client_ready(vmfg.ipc, now)) {
+        vmfg.hs_off++;
+        return;
+    }
+    if (evfx_client_outstanding(vmfg.ipc)) {
+        vmfg.hs_busy++;
+        vmfg.pend_stale++;
+        return;
+    }
+    if (!cs->surf) {
+        vmfg.hs_nosurf++;           /* not a BGRA8 scanout */
+        return;
+    }
+    if (cs->snap) {
+        /* The helper reads the snapshot from another process. */
+        [cs->snap waitUntilCompleted];
+    }
+    if (in->prev_valid && in->prev_slot >= 0 &&
+        vmfg.slot[in->prev_slot].surf) {
+        r.prev = in->prev_slot;
+    }
+    r.out = vmfg_out_pick(cs->tex);
+    if (r.out < 0) {
+        vmfg.hs_noout++;
+    }
+    if (!evfx_client_surface(vmfg.ipc, EVFX_ROLE_INPUT, r.cur, cs->gen,
+                             cs->surf) ||
+        (r.prev >= 0 &&
+         !evfx_client_surface(vmfg.ipc, EVFX_ROLE_INPUT, r.prev,
+                              vmfg.slot[r.prev].gen,
+                              vmfg.slot[r.prev].surf)) ||
+        (r.out >= 0 &&
+         !evfx_client_surface(vmfg.ipc, EVFX_ROLE_OUTPUT, r.out - VMFG_SLOTS,
+                              vmfg.slot[r.out].gen, vmfg.slot[r.out].surf))) {
+        vmfg_slot_unref(r.out);
+        vmfg.hs_nosurf++;
+        return;
+    }
+    vmfg_slot_ref(r.cur);
+    if (r.prev >= 0) {
+        vmfg_slot_ref(r.prev);
+    }
+
+    memset(&f, 0, sizeof(f));
+    f.cur_index = r.cur;
+    f.cur_gen = cs->gen;
+    f.prev_index = r.prev;
+    f.prev_gen = r.prev >= 0 ? vmfg.slot[r.prev].gen : 0;
+    f.out_index = r.out >= 0 ? r.out - VMFG_SLOTS : -1;
+    f.out_gen = r.out >= 0 ? vmfg.slot[r.out].gen : 0;
+    /* vmfg-1030: a reset (engine history dropped) only when the size
+       changed; without a usable previous frame this pair is original-only. */
+    f.flags = r.prev >= 0 ? EVFX_FRAME_PREV_VALID :
+              (cs->tex.width != vmfg.helper_w ||
+               cs->tex.height != vmfg.helper_h) ? EVFX_FRAME_SCENE_RESET : 0;
+    vmfg.helper_w = (uint32_t)cs->tex.width;
+    vmfg.helper_h = (uint32_t)cs->tex.height;
+    f.drops_stale = vmfg.pend_stale;
+    f.drops_no_drawable = vmfg.pend_no_drawable;
+    f.transport_outstanding = (uint32_t)atomic_load(&vmfg.queued);
+    f.arrival_ns = in->arrival_ns;
+    f.display_interval_ns = in->display_interval_ns;
+    f.deadline_ns = vmfg_deadline(now, in->display_interval_ns);
+    r.deadline_ns = f.deadline_ns;
+    vtune_push(vtune.a2s, &vtune.a2s_n, (now - in->arrival_ns) / 1e6);
+    vtune_push(vtune.budget, &vtune.budget_n, (f.deadline_ns - now) / 1e6);
+    f.latency_sample_ns = atomic_load(&vmfg.orig_glass_ns);
+    f.display_latency_us = vmfg_recent_latency_us(now);
+
+    switch (evfx_client_frame(vmfg.ipc, &f, &res)) {
+    case EVFX_DONE:
+        vmfg.hs_sent++;
+        vmfg.hs_done++;
+        vmfg.pend_stale = vmfg.pend_no_drawable = 0;
+        vmfg_fg_finish(&r, &res, out);
+        break;
+    case EVFX_TIMEOUT:
+        /* The helper may still use these buffers: keep them until it answers. */
+        vmfg.hs_sent++;
+        vmfg.hs_timeout++;
+        vmfg.pend_stale = vmfg.pend_no_drawable = 0;
+        r.live = true;
+        vmfg.req = r;
+        break;
+    case EVFX_BUSY:
+        vmfg.hs_busy++;
+        vmfg_req_release(&r);
+        break;
+    case EVFX_DOWN:
+    default:
+        vmfg.hs_off++;
+        vmfg_req_release(&r);
+        break;
+    }
+}
+
+static id<MTLTexture> vmfg_fg_encode(id<MTLCommandBuffer> cb,
+                                     id<MTLTexture> prev,
+                                     id<MTLTexture> cur, const VmfgPlan *plan)
+{
+    (void)cb; (void)prev; (void)cur;
+    /* The helper already wrote the frame (GPU complete before it answered). */
+    return plan->gen_slot >= 0 ? vmfg.slot[plan->gen_slot].tex : nil;
+}
+
+static const VmfgEngineOps vmfg_engine_helper = {
+    .name = "helper",
+    .plan = vmfg_fg_plan,
+    .encode = vmfg_fg_encode,
+};
+
+/* ---- repeat detection (vmfg-1030) ------------------------------------------ */
+
+/* Exact full-frame comparison of two same-sized snapshots. Writes 1 into the
+   flag when any texel differs (the flag is zeroed by a blit in the same
+   command buffer). Memory bound: two 1440p BGRA8 reads ~0.1 ms. */
+static NSString *const vmfg_cmp_src =
+    @"#include <metal_stdlib>\n"
+     "using namespace metal;\n"
+     "kernel void vmfg_same(texture2d<float, access::read> a [[texture(0)]],\n"
+     "                      texture2d<float, access::read> b [[texture(1)]],\n"
+     "                      device atomic_uint *diff [[buffer(0)]],\n"
+     "                      uint2 gid [[thread_position_in_grid]]) {\n"
+     "  uint w = a.get_width(), h = a.get_height(), x0 = gid.x * 4;\n"
+     "  if (gid.y >= h || x0 >= w) return;\n"
+     "  if (atomic_load_explicit(diff, memory_order_relaxed)) return;\n"
+     "  bool d = false;\n"
+     "  for (uint k = 0; k < 4 && x0 + k < w; k++) {\n"
+     "    uint2 p = uint2(x0 + k, gid.y);\n"
+     "    d = d || any(a.read(p) != b.read(p));\n"
+     "  }\n"
+     "  if (d) atomic_store_explicit(diff, 1u, memory_order_relaxed);\n"
+     "}\n"
+     /* cmpsparse-1031: every 16th row first. A real game frame almost always differs there, and
+      * then the full pass is dispatched with zero threadgroups, so its GPU time (0.9 ms/frame
+      * measured at 100% GPU) is not spent. Only a sparse match pays for the full comparison. */
+     "kernel void vmfg_same_sparse(texture2d<float, access::read> a [[texture(0)]],\n"
+     "                      texture2d<float, access::read> b [[texture(1)]],\n"
+     "                      device atomic_uint *diff [[buffer(0)]],\n"
+     "                      device atomic_uint *args [[buffer(1)]],\n"
+     "                      uint2 gid [[thread_position_in_grid]]) {\n"
+     "  uint w = a.get_width(), h = a.get_height(), x0 = gid.x * 4, y = gid.y * 16;\n"
+     "  if (y >= h || x0 >= w) return;\n"
+     "  if (atomic_load_explicit(diff, memory_order_relaxed)) return;\n"
+     "  bool d = false;\n"
+     "  for (uint k = 0; k < 4 && x0 + k < w; k++) {\n"
+     "    uint2 p = uint2(x0 + k, y);\n"
+     "    d = d || any(a.read(p) != b.read(p));\n"
+     "  }\n"
+     "  if (d) {\n"
+     "    atomic_store_explicit(diff, 1u, memory_order_relaxed);\n"
+     "    atomic_store_explicit(args, 0u, memory_order_relaxed);\n"
+     "  }\n"
+     "}\n";
+
+static void vmfg_cmp_init(void)
+{
+    @autoreleasepool {
+        NSError *err = nil;
+        id<MTLLibrary> lib = [vmfg.device newLibraryWithSource:vmfg_cmp_src
+                                                       options:nil
+                                                         error:&err];
+        id<MTLFunction> fn = [lib newFunctionWithName:@"vmfg_same"];
+
+        vmfg.cmp_pso = fn ? [vmfg.device newComputePipelineStateWithFunction:fn
+                                                                       error:&err]
+                          : nil;
+        [fn release];
+        fn = [lib newFunctionWithName:@"vmfg_same_sparse"];
+        vmfg.cmp_sparse_pso = fn ? [vmfg.device newComputePipelineStateWithFunction:fn
+                                                                              error:nil]
+                                 : nil;
+        [fn release];
+        [lib release];
+        vmfg.cmp_buf = [vmfg.device newBufferWithLength:VMFG_SLOTS * 4
+                                                options:MTLResourceStorageModeShared];
+        vmfg.cmp_args = [vmfg.device newBufferWithLength:VMFG_SLOTS * 12
+                                                 options:MTLResourceStorageModeShared];
+        {
+            const char *sp = getenv("EMBER_VMFG_CMP_SPARSE");
+            if ((sp && !strcmp(sp, "0")) || !vmfg.cmp_sparse_pso || !vmfg.cmp_args) {
+                [vmfg.cmp_sparse_pso release];
+                vmfg.cmp_sparse_pso = nil;
+            }
+        }
+        if (!vmfg.cmp_pso || !vmfg.cmp_buf) {
+            fprintf(stderr, "ember-vmfg: repeat detection unavailable (%s), "
+                    "off\n", err ? err.description.UTF8String : "no buffer");
+            [vmfg.cmp_pso release];
+            vmfg.cmp_pso = nil;
+            [vmfg.cmp_buf release];
+            vmfg.cmp_buf = nil;
+            vmfg.dedup = 0;
+        }
+    }
+}
+
+/*
+ * QEMU thread, inside the snapshot command buffer: zero this slot's flag and,
+ * when the previous snapshot has the same geometry, compare against it. The
+ * previous snapshot slot stays referenced by the QEMU thread (cmp_ref) until
+ * a newer snapshot replaces it, so it cannot be picked and overwritten while
+ * a comparison may still read it. Returns true when a comparison was encoded.
+ */
+static bool vmfg_cmp_encode(id<MTLBlitCommandEncoder> blit, int pick)
+{
+    VmfgSlot *s = &vmfg.slot[pick], *r;
+    int old = vmfg.cmp_ref;
+    bool cmp = false;
+
+    s->cmp_frame = 0;
+    if (!vmfg.dedup || !vmfg.cmp_pso) {
+        return false;
+    }
+    [blit fillBuffer:vmfg.cmp_buf range:NSMakeRange(pick * 4, 4) value:0];
+    if (old >= 0 && old != pick) {
+        r = &vmfg.slot[old];
+        cmp = r->tex && s->tex && r->tex.width == s->tex.width &&
+              r->tex.height == s->tex.height &&
+              r->tex.pixelFormat == s->tex.pixelFormat && r->frame_no;
+    }
+    if (cmp) {
+        s->cmp_frame = vmfg.slot[old].frame_no;
+    }
+    /* The caller ends the blit encoder before vmfg_cmp_dispatch(). */
+    vmfg_slot_ref(pick);
+    vmfg.cmp_ref = pick;
+    if (old >= 0) {
+        vmfg_slot_unref(old);   /* the textures stay alive for cb: Metal retains */
+    }
+    return cmp;
+}
+
+static void vmfg_cmp_dispatch(id<MTLCommandBuffer> cb, int pick, int against)
+{
+    id<MTLComputeCommandEncoder> ce = [cb computeCommandEncoder];
+    id<MTLTexture> a = vmfg.slot[pick].tex, b = vmfg.slot[against].tex;
+
+    [ce setComputePipelineState:vmfg.cmp_pso];
+    [ce setTexture:a atIndex:0];
+    [ce setTexture:b atIndex:1];
+    [ce setBuffer:vmfg.cmp_buf offset:pick * 4 atIndex:0];
+    if (vmfg.cmp_sparse_pso) {
+        uint32_t *args = (uint32_t *)vmfg.cmp_args.contents + pick * 3;
+
+        args[0] = (uint32_t)(((a.width + 3) / 4 + 31) / 32);
+        args[1] = (uint32_t)((a.height + 7) / 8);
+        args[2] = 1;
+        [ce setComputePipelineState:vmfg.cmp_sparse_pso];
+        [ce setBuffer:vmfg.cmp_args offset:pick * 12 atIndex:1];
+        [ce dispatchThreads:MTLSizeMake((a.width + 3) / 4, (a.height + 15) / 16, 1)
+      threadsPerThreadgroup:MTLSizeMake(32, 8, 1)];
+        [ce endEncoding];
+        ce = [cb computeCommandEncoder];
+        [ce setComputePipelineState:vmfg.cmp_pso];
+        [ce setTexture:a atIndex:0];
+        [ce setTexture:b atIndex:1];
+        [ce setBuffer:vmfg.cmp_buf offset:pick * 4 atIndex:0];
+        [ce dispatchThreadgroupsWithIndirectBuffer:vmfg.cmp_args
+                              indirectBufferOffset:pick * 12
+                             threadsPerThreadgroup:MTLSizeMake(32, 8, 1)];
+    } else {
+        [ce dispatchThreads:MTLSizeMake((a.width + 3) / 4, a.height, 1)
+      threadsPerThreadgroup:MTLSizeMake(32, 8, 1)];
+    }
+    [ce endEncoding];
+}
+
+/*
+ * Presenter queue: true when slot i's snapshot equals the snapshot it was
+ * compared with. wait: block until the snapshot command buffer finished
+ * (fg mode waits for it before the helper call anyway). Unknown = false.
+ */
+static bool vmfg_cmp_same(int i, bool wait)
+{
+    VmfgSlot *s = &vmfg.slot[i];
+    const volatile uint32_t *flags;
+
+    if (vmfg.dedup < 2 || !vmfg.cmp_buf || !s->cmp_frame || !s->snap) {
+        return false;               /* 1 (count only) counts on completion */
+    }
+    if (wait) {
+        [s->snap waitUntilCompleted];
+    }
+    if (s->snap.status != MTLCommandBufferStatusCompleted) {
+        atomic_fetch_add(&vmfg.st_dup_unknown, 1);
+        return false;
+    }
+    flags = (const volatile uint32_t *)vmfg.cmp_buf.contents;
+    return flags[i] == 0;
+}
+
+/* ---- presentation ---------------------------------------------------------- */
+
+/* ---- pacing gate ---------------------------------------------------------- */
+
+static void vmfg_present_pending(void);
+
+/* The presenter's spare drawable, or nil. The caller owns one reference. */
+static id<CAMetalDrawable> vmfg_spare_take(void)
+{
+    id<CAMetalDrawable> d;
+
+    pthread_mutex_lock(&vmfg.lock);
+    d = vmfg.spare;
+    vmfg.spare = nil;
+    pthread_mutex_unlock(&vmfg.lock);
+    return d;
+}
+
+/* Presenter queue: keep one drawable ready for flush (nextDrawable can block,
+   flush holds the BQL). Off: give the spare back. */
+static void vmfg_spare_refill(void)
+{
+    CAMetalLayer *layer = vmfg.layer;
+    id<CAMetalDrawable> d;
+    MTLPixelFormat fmt;
+    NSUInteger w, h;
+    bool want;
+
+    if (!atomic_load(&vmfg.onecopy_on)) {
+        [vmfg_spare_take() release];
+        return;
+    }
+    pthread_mutex_lock(&vmfg.lock);
+    want = !vmfg.spare && vmfg.src;
+    fmt = vmfg.src.pixelFormat;
+    w = vmfg.src_size.width;
+    h = vmfg.src_size.height;
+    pthread_mutex_unlock(&vmfg.lock);
+    if (!want || atomic_load(&vmfg.pq_busy) > 0 || layer.pixelFormat != fmt ||
+        (NSUInteger)layer.drawableSize.width != w ||
+        (NSUInteger)layer.drawableSize.height != h) {
+        return;
+    }
+    @autoreleasepool {
+        d = [layer nextDrawable];
+        if (!d) {
+            return;
+        }
+        pthread_mutex_lock(&vmfg.lock);
+        if (!vmfg.spare) {
+            vmfg.spare = [d retain];
+        }
+        pthread_mutex_unlock(&vmfg.lock);
+    }
+}
+
+static void vmfg_inflight_done(void)
+{
+    int v = atomic_load(&vmfg.inflight);
+    while (v > 0 && !atomic_compare_exchange_weak(&vmfg.inflight, &v, v - 1)) {
+    }
+}
+
+/* Presenter queue: may another original be presented now? */
+static bool vmfg_gate_open(void)
+{
+    int64_t stuck;
+
+    if (atomic_load(&vmfg.inflight) < vmfg_inflight_limit()) {
+        return true;
+    }
+    /* A presented handler that never came (layer detached...) must not
+       stop the display: give up waiting after 3 refreshes + 50 ms. */
+    stuck = vmfg_now_ns() - atomic_load(&vmfg.last_present_ns);
+    if (stuck > 3 * vmfg_display_ns() + 50000000LL) {
+        atomic_store(&vmfg.inflight, 0);
+        atomic_fetch_add(&vmfg.st_inflight_reset, 1);
+        return true;
+    }
+    return false;
+}
+
+/* Blit tex into a fresh drawable and present it. Returns false if no drawable. */
+static bool vmfg_present_tex(int slot, id<MTLTexture> tex, bool generated,
+                             int64_t arrival_ns, uint64_t frame_no,
+                             double min_hold_s)
+{
+    CAMetalLayer *layer = vmfg.layer;
+    id<CAMetalDrawable> d = [vmfg_spare_take() autorelease];
+    id<MTLCommandBuffer> cb;
+    id<MTLBlitCommandEncoder> blit;
+    id<MTLTexture> dst;
+
+    if (!d) {
+        d = [layer nextDrawable];
+    }
+    if (!d) {
+        atomic_fetch_add(&vmfg.st_no_drawable, 1);
+        return false;
+    }
+    dst = d.texture;
+    if (dst.width < tex.width || dst.height < tex.height ||
+        dst.pixelFormat != tex.pixelFormat) {
+        /* Layer reconfigured between the check and nextDrawable. */
+        atomic_fetch_add(&vmfg.st_layer_skip, 1);
+        return false;
+    }
+    cb = [vmfg.queue commandBuffer];
+    blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:tex
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:MTLOriginMake(0, 0, 0)
+               sourceSize:MTLSizeMake(tex.width, tex.height, 1)
+                toTexture:dst
+         destinationSlice:0
+         destinationLevel:0
+        destinationOrigin:MTLOriginMake(0, 0, 0)];
+    [blit endEncoding];
+    int64_t call_ns = vmfg_now_ns();
+    [d addPresentedHandler:^(id<MTLDrawable> shown) {
+        vmfg_note_glass(shown, generated, arrival_ns, frame_no, call_ns,
+                        vmfg_now_ns());
+        if (!generated) {
+            /* The original is on glass (or dropped): open the gate. */
+            vmfg_inflight_done();
+            dispatch_async(vmfg.pq, ^{
+                vmfg_present_pending();
+            });
+        }
+    }];
+    if (!generated) {
+        atomic_fetch_add(&vmfg.inflight, 1);
+        atomic_store(&vmfg.last_present_ns, vmfg_now_ns());
+    }
+    if (min_hold_s > 0) {
+        [cb presentDrawable:d afterMinimumDuration:min_hold_s];
+    } else {
+        [cb presentDrawable:d];
+    }
+    vmfg_slot_ref(slot);
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        (void)done;
+        vmfg_slot_unref(slot);
+    }];
+    [cb commit];
+    return true;
+}
+
+/*
+ * Presenter queue: re-present the newest snapshot, only when it could not be
+ * shown (geometry change, no drawable). Never a second copy of a frame that
+ * is already queued: that is what filled the FIFO before.
+ */
+static void vmfg_present_last(void)
+{
+    @autoreleasepool {
+        int i = vmfg.prev_slot;
+        CAMetalLayer *layer = vmfg.layer;
+        id<MTLTexture> t;
+
+        if (!atomic_load(&vmfg.repost) || i < 0 ||
+            atomic_load(&vmfg.queued) > 0 || vmfg.pending >= 0 ||
+            !vmfg_gate_open()) {
+            return;     /* nothing to do, newer frame coming, or gate closed */
+        }
+        t = vmfg.slot[i].tex;
+        if (layer.pixelFormat == t.pixelFormat &&
+            (NSUInteger)layer.drawableSize.width == t.width &&
+            (NSUInteger)layer.drawableSize.height == t.height &&
+            vmfg_present_tex(i, t, false, vmfg_now_ns(),
+                             vmfg.slot[i].frame_no, 0)) {
+            atomic_store(&vmfg.repost, false);
+        }
+    }
+}
+
+/*
+ * The main thread applies a new scanout geometry to the layer asynchronously
+ * (scanoutMetalTexture). Blocks queued on the main queue before this one have
+ * run by the time it does, so hop through it and re-present the last frame.
+ */
+static void vmfg_repost_after_main(void)
+{
+    atomic_store(&vmfg.repost, true);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        dispatch_async(vmfg.pq, ^{
+            vmfg_present_last();
+        });
+    });
+}
+
+/* Presenter queue: one guest frame, already snapshotted into slot i. */
+static void vmfg_process_frame(int i, bool backlog)
+{
+    @autoreleasepool {
+        VmfgSlot *s = &vmfg.slot[i];
+        id<MTLTexture> cur = s->tex;
+        id<MTLTexture> prev = vmfg.prev_slot >= 0 ?
+                              vmfg.slot[vmfg.prev_slot].tex : nil;
+        int64_t disp = vmfg_display_ns();
+        CAMetalLayer *layer = vmfg.layer;
+        VmfgPlanIn in;
+        VmfgPlan plan;
+        bool shown_gen = false;
+        /* vmfg-1030: same pixels as the previous flush? fg / skip mode waits
+           for the snapshot (the helper path waited for it anyway). */
+        bool dup = vmfg_cmp_same(i, !backlog);
+        bool same_prev = dup && vmfg.prev_slot >= 0 &&
+                         (s->cmp_frame == vmfg.slot[vmfg.prev_slot].frame_no ||
+                          s->cmp_frame == vmfg.prev_alias);
+
+        if (dup) {
+            atomic_fetch_add(&vmfg.st_dup, 1);
+        }
+        if (dup && vmfg.dedup >= 2 && same_prev &&
+            (backlog || (vmfg.prev_presented && !atomic_load(&vmfg.repost)))) {
+            /* A repeat of the frame that is already queued / on glass (or
+               a superseded repeat): not a new game frame, nothing new to
+               show. prev_slot keeps the first copy (its arrival time is the
+               game frame's); the timing history is left untouched. */
+            atomic_fetch_add(&vmfg.st_dup_skip, 1);
+            vmfg.prev_alias = s->frame_no;
+            if (s->snap) {
+                [s->snap release];
+                s->snap = nil;
+            }
+            vmfg_slot_unref(i);             /* the presenter job's reference */
+            vmfg_log_stats(vmfg_now_ns());
+            return;
+        }
+        if (dup && vmfg.dedup >= 2) {
+            /* shown again (not safe to skip), but no history update and no
+               interpolation between two identical images */
+        } else if (vmfg.last_arrival_ns && s->arrival_ns > vmfg.last_arrival_ns) {
+            int64_t iv = s->arrival_ns - vmfg.last_arrival_ns;
+
+            vtune.iv_bin[iv < 4000000 ? 0 : iv < 10000000 ? 1 :
+                         iv < 17000000 ? 2 : iv < 24000000 ? 3 :
+                         iv < 40000000 ? 4 : 5]++;
+            vmfg.hist[vmfg.hist_i] = iv;
+            vmfg.hist_i = (vmfg.hist_i + 1) % VMFG_HIST;
+            if (vmfg.hist_n < VMFG_HIST) {
+                vmfg.hist_n++;
+            }
+        }
+        if (!(dup && vmfg.dedup >= 2)) {
+            vmfg.last_arrival_ns = s->arrival_ns;
+        }
+        vmfg_tune_poll(vmfg_now_ns());      /* vmdisp-1031: count mode too */
+        if (vmfg.mode == VMFG_FG) {
+            vmfg_fg_housekeeping();
+        }
+
+        if (backlog) {
+            /* A newer frame is queued: keep this one as "previous" only. */
+            atomic_fetch_add(&vmfg.st_stale, 1);
+            vmfg.pend_stale++;
+        } else if (layer.pixelFormat != cur.pixelFormat ||
+                   (NSUInteger)layer.drawableSize.width != cur.width ||
+                   (NSUInteger)layer.drawableSize.height != cur.height) {
+            /* Main thread has not applied the scanout geometry yet. */
+            atomic_fetch_add(&vmfg.st_layer_skip, 1);
+            vmfg_repost_after_main();
+            vmfg.prev_presented = false;
+        } else {
+            memset(&in, 0, sizeof(in));
+            in.frame_no = s->frame_no;
+            in.arrival_ns = s->arrival_ns;
+            in.game_interval_ns = vmfg_median_interval();
+            in.display_interval_ns = disp;
+            in.prev_valid = prev && prev.width == cur.width &&
+                            prev.height == cur.height &&
+                            prev.pixelFormat == cur.pixelFormat;
+            in.cur_slot = i;
+            in.prev_slot = in.prev_valid ? vmfg.prev_slot : -1;
+            if (dup && vmfg.dedup >= 2) {
+                memset(&plan, 0, sizeof(plan));
+                plan.gen_slot = -1;
+            } else if (vmfg_fmt_sdr8(cur.pixelFormat)) {
+                vmfg.engine->plan(&in, &plan);
+            } else {
+                /* 10-bit / float (possibly HDR) scanout: original only. */
+                memset(&plan, 0, sizeof(plan));
+                plan.gen_slot = -1;
+                atomic_fetch_add(&vmfg.st_fmt_off, 1);
+            }
+
+            if (plan.generate) {
+                id<MTLCommandBuffer> ecb = [vmfg.queue commandBuffer];
+                id<MTLTexture> g = vmfg.engine->encode(ecb, prev, cur, &plan);
+                [ecb commit];
+                atomic_fetch_add(&vmfg.st_gen, 1);
+                shown_gen = g && vmfg_present_tex(plan.gen_slot >= 0 ?
+                                                  plan.gen_slot : i,
+                                                  g, true, s->arrival_ns,
+                                                  s->frame_no, 0);
+                if (!shown_gen) {
+                    vmfg.pend_no_drawable++;
+                }
+            }
+            vmfg_slot_unref(plan.gen_slot);     /* the plan's reference */
+            atomic_fetch_add(&vmfg.st_orig, 1);
+            atomic_store(&vmfg.repost,
+                         !vmfg_present_tex(i, cur, false, s->arrival_ns,
+                                           s->frame_no,
+                                           shown_gen ? plan.hold_s : 0));
+            vmfg.prev_presented = !atomic_load(&vmfg.repost);
+        }
+        if (s->snap) {
+            [s->snap release];
+            s->snap = nil;
+        }
+
+        /* Rotate "previous": the job's reference moves to prev_slot. */
+        if (backlog) {
+            vmfg.prev_presented = false;
+        }
+        vmfg_slot_unref(vmfg.prev_slot);
+        vmfg.prev_slot = i;
+        vmfg.prev_alias = 0;
+        vmfg_log_stats(vmfg_now_ns());
+    }
+}
+
+/*
+ * Presenter queue, per guest frame (from flush). Mailbox: while an original
+ * is still on its way to the glass the frame waits as "pending"; a newer
+ * frame replaces it (the older one becomes "previous" only, like stale).
+ */
+static void vmfg_present_frame(int i)
+{
+    bool backlog = atomic_fetch_sub(&vmfg.queued, 1) > 1;
+    int p = vmfg.pending;
+
+    if (p >= 0) {
+        vmfg.pending = -1;
+        atomic_store(&vmfg.has_pending, false);
+        atomic_fetch_add(&vmfg.st_superseded, 1);
+        vmfg_process_frame(p, true);
+    }
+    vmfg.direct_active = false;
+    if (!backlog && !vmfg_gate_open()) {
+        vmfg.pending = i;
+        atomic_store(&vmfg.has_pending, true);
+        atomic_fetch_add(&vmfg.st_deferred, 1);
+        /* if neither a presented handler nor a new frame comes, the gate's
+           timeout still lets this frame out */
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                     3 * vmfg_display_ns() + 60000000LL),
+                       vmfg.pq, ^{
+            vmfg_present_pending();
+        });
+        return;
+    }
+    vmfg_process_frame(i, backlog);
+}
+
+/* Presenter queue: the gate may have opened (presented handler). */
+static void vmfg_present_pending(void)
+{
+    int p = vmfg.pending;
+
+    if (p >= 0 && vmfg_gate_open()) {
+        vmfg.pending = -1;
+        atomic_store(&vmfg.has_pending, false);
+        vmfg_process_frame(p, atomic_load(&vmfg.queued) > 0);
+    } else if (p < 0) {
+        vmfg_present_last();        /* only acts when a repost is owed */
+    }
+    vmfg_spare_refill();
+}
+
+/* Presenter queue, after a one-copy frame. */
+static void vmfg_direct_done(int64_t arrival_ns)
+{
+    if (!vmfg.direct_active) {
+        /* The slots are stale from here on: drop "previous" so a return to
+           the snapshot path starts without history. */
+        vmfg.direct_active = true;
+        if (vmfg.prev_slot >= 0) {
+            vmfg_slot_unref(vmfg.prev_slot);
+            vmfg.prev_slot = -1;
+        }
+        vmfg.prev_alias = 0;
+        vmfg.prev_presented = false;
+    }
+    vmfg.last_arrival_ns = arrival_ns;
+    if (vmfg.mode == VMFG_FG) {
+        vmfg_fg_housekeeping();
+    }
+    vmfg_tune_poll(vmfg_now_ns());
+    vmfg_log_stats(vmfg_now_ns());
+    vmfg_spare_refill();
+}
+
+/*
+ * QEMU thread, flush: copy the guest frame into the spare drawable and present
+ * it. Only when nothing older can still reach the layer, otherwise a false
+ * return sends this frame down the snapshot path (mailbox, repost).
+ */
+static bool vmfg_direct_flush(id<MTLTexture> src, MTLOrigin origin,
+                              MTLSize size, int64_t now)
+{
+    id<CAMetalDrawable> d;
+    id<MTLCommandBuffer> cb;
+    id<MTLBlitCommandEncoder> blit;
+    id<MTLTexture> dst;
+    int64_t call_ns;
+    uint64_t frame_no;
+
+    if (!atomic_load(&vmfg.onecopy_on)) {
+        return false;
+    }
+    if (atomic_load(&vmfg.pq_busy) > 0 || atomic_load(&vmfg.has_pending) ||
+        atomic_load(&vmfg.repost)) {
+        atomic_fetch_add(&vmfg.st_1c_busy, 1);
+        return false;
+    }
+    if (atomic_load(&vmfg.inflight) >= vmfg_inflight_limit()) {
+        atomic_fetch_add(&vmfg.st_1c_gate, 1);
+        return false;
+    }
+    d = vmfg_spare_take();
+    if (!d) {
+        atomic_fetch_add(&vmfg.st_1c_nospare, 1);
+        dispatch_async(vmfg.pq, ^{
+            vmfg_spare_refill();
+        });
+        return false;
+    }
+    dst = d.texture;
+    if (dst.width != size.width || dst.height != size.height ||
+        dst.pixelFormat != src.pixelFormat) {
+        atomic_fetch_add(&vmfg.st_1c_geom, 1);
+        [d release];
+        return false;
+    }
+    frame_no = ++vmfg.frame_no;
+    cb = [vmfg.queue commandBuffer];
+    blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:src
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:origin
+               sourceSize:size
+                toTexture:dst
+         destinationSlice:0
+         destinationLevel:0
+        destinationOrigin:MTLOriginMake(0, 0, 0)];
+    [blit endEncoding];
+    call_ns = vmfg_now_ns();
+    [d addPresentedHandler:^(id<MTLDrawable> shown) {
+        vmfg_note_glass(shown, false, now, frame_no, call_ns, vmfg_now_ns());
+        vmfg_inflight_done();
+        dispatch_async(vmfg.pq, ^{
+            vmfg_present_pending();
+        });
+    }];
+    atomic_fetch_add(&vmfg.inflight, 1);
+    atomic_store(&vmfg.last_present_ns, vmfg_now_ns());
+    [cb presentDrawable:d];
+    /* Keep the guest's scanout memory mapped until the copy ran. */
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        (void)done;
+        [src release];
+    }];
+    [cb commit];
+    [d release];
+    atomic_fetch_add(&vmfg.st_orig, 1);
+    atomic_fetch_add(&vmfg.st_1c, 1);
+    dispatch_async(vmfg.pq, ^{
+        vmfg_direct_done(now);
+    });
+    return true;
+}
+
+/* ---- zero copy (vmzero-1031) ---------------------------------------------- */
+
+static inline void vz_lane_settle(VzLane *l)
+{
+    atomic_store(&l->r_done, atomic_load(&l->r_issued));
+}
+
+static inline void vz_wake(VzPage *p)
+{
+    if (atomic_load(&p->waiters) == 0) {
+        return;
+    }
+    atomic_fetch_add(&p->wake, 1);
+    __ulock_wake(VZ_UL_COMPARE_AND_WAIT_SHARED | VZ_ULF_WAKE_ALL |
+                 VZ_ULF_NO_ERRNO, &p->wake, 0);
+}
+
+/* QEMU thread: our reader lane on this texture's sync page. */
+static VzEntry *vz_entry_of(id<MTLTexture> src)
+{
+    NSData *data = objc_getAssociatedObject(src,
+                                            sel_registerName("emberXSyncPage"));
+    VzPage *p = data ? (VzPage *)data.bytes : NULL;
+    VzEntry *e = NULL;
+    uint64_t owner;
+    int i, lane = -1;
+
+    if (!p || data.length < sizeof(VzPage) ||
+        atomic_load(&p->magic) != VZ_MAGIC || p->version != VZ_VERSION) {
+        return NULL;
+    }
+    for (i = 0; i < VZ_TAB; i++) {
+        if (vz.tab[i].page == p) {
+            vz.tab[i].used = ++vz.tab_clock;
+            return &vz.tab[i];
+        }
+    }
+    owner = ((uint64_t)(uint32_t)getpid() << 32) | (uint64_t)(0x80000000u + i +
+                                                    (uint32_t)vz.tab_clock);
+    for (i = 0; i < VZ_LANES; i++) {
+        uint64_t cur = 0;
+        if (atomic_compare_exchange_strong(&p->lanes[i].owner, &cur, owner)) {
+            lane = i;
+            break;
+        }
+    }
+    if (lane < 0) {
+        return NULL;                /* all taken: this buffer stays copied */
+    }
+    for (i = 0; i < VZ_TAB; i++) {
+        if (!e || !vz.tab[i].page || vz.tab[i].used < e->used) {
+            e = &vz.tab[i];
+            if (!e->page) {
+                break;
+            }
+        }
+    }
+    if (e->page) {
+        /* An old buffer loses its fence, which only matters while it is on
+           screen; the guest does not rotate through this many. */
+        VzLane *l = &e->page->lanes[e->lane];
+        uint64_t mine = e->owner;
+        vz_lane_settle(l);
+        atomic_compare_exchange_strong(&l->owner, &mine, 0);
+        vz_wake(e->page);
+        [e->data release];
+        atomic_fetch_add(&vz.st_evict, 1);
+    }
+    e->data = [data retain];
+    e->page = p;
+    e->lane = lane;
+    e->owner = owner;
+    e->used = ++vz.tab_clock;
+    return e;
+}
+
+/* Presenter queue: the frame in h may be overwritten now. */
+static void vz_publish(VzHeld *h, bool forced)
+{
+    VzLane *l = &h->page->lanes[h->lane];
+
+    if (atomic_load(&l->owner) == h->owner) {
+        uint64_t done = atomic_load(&l->r_done);
+        if (done < h->ticket) {
+            atomic_store(&l->r_done, h->ticket);
+        }
+        vz_wake(h->page);
+    }
+    if (h->replaced_ns && vz.hold_n < VMFG_LAT) {
+        vz.hold_ms[vz.hold_n++] = (vmfg_now_ns() - h->replaced_ns) / 1e6;
+    }
+    atomic_fetch_add(forced ? &vz.st_forced : &vz.st_released, 1);
+    [h->tex release];
+    [h->data release];
+    h->tex = nil;
+    h->data = nil;
+}
+
+static void vz_poll(void)
+{
+    int64_t now = vmfg_now_ns();
+    int64_t hold = vz.hold_ns >= 0 ? vz.hold_ns :
+                   vmfg_display_ns() + 1000000LL;
+    int i, n = 0;
+
+    for (i = 0; i < vz.rel_n; i++) {
+        VzHeld *h = &vz.rel[i];
+        int64_t age = now - h->replaced_ns;
+
+        if (age >= VZ_FORCE_NS) {
+            vz_publish(h, true);
+        } else if (age >= hold && !IOSurfaceIsInUse(h->tex.iosurface)) {
+            vz_publish(h, false);
+        } else {
+            if (n != i) {
+                vz.rel[n] = *h;
+            }
+            n++;
+        }
+    }
+    vz.rel_n = n;
+    if (n && !vz.poll_armed) {
+        vz.poll_armed = true;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, VZ_POLL_NS), vmfg.pq, ^{
+            vz.poll_armed = false;
+            vz_poll();
+        });
+    }
+}
+
+/* Presenter queue: the frame on screen was replaced. */
+static void vz_retire_cur(int64_t now)
+{
+    if (!vz.has_cur) {
+        return;
+    }
+    if (vz.rel_n == VZ_REL) {
+        vz_publish(&vz.rel[0], true);
+        memmove(&vz.rel[0], &vz.rel[1], sizeof(vz.rel[0]) * (VZ_REL - 1));
+        vz.rel_n--;
+    }
+    vz.cur.replaced_ns = now;
+    vz.rel[vz.rel_n++] = vz.cur;
+    vz.has_cur = false;
+}
+
+/* Main thread: keep the layer right above the Metal layer, same geometry. */
+static void vz_sync_layer(bool show)
+{
+    CAMetalLayer *m = vmfg.layer;
+    CALayer *sup = m.superlayer;
+
+    if (!sup) {
+        atomic_store(&vz.ready, false);
+        return;
+    }
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    if (!vz.layer) {
+        vz.layer = [[CALayer alloc] init];
+        vz.layer.opaque = YES;
+        vz.layer.contentsGravity = kCAGravityResize;
+        vz.layer.hidden = YES;      /* vz_show uncovers the Metal layer's */
+    }
+    if (vz.layer.superlayer != sup ||
+        [sup.sublayers indexOfObject:vz.layer] !=
+        [sup.sublayers indexOfObject:m] + 1) {
+        [sup insertSublayer:vz.layer above:m];
+    }
+    if (!CGRectEqualToRect(vz.layer.frame, m.frame)) {
+        vz.layer.frame = m.frame;
+    }
+    if (vz.layer.contentsScale != m.contentsScale) {
+        vz.layer.contentsScale = m.contentsScale;
+    }
+    if (![vz.layer.magnificationFilter isEqual:m.magnificationFilter]) {
+        vz.layer.magnificationFilter = m.magnificationFilter;
+        vz.layer.minificationFilter = m.minificationFilter;
+    }
+    [CATransaction commit];
+    atomic_store(&vz.ready, show);
+}
+
+/* Presenter queue: back to the Metal layer (off, or a frame that must be
+   copied: without this the copy would be presented underneath, unseen). */
+static void vz_hide(void)
+{
+    if (!atomic_exchange(&vz.visible, false)) {
+        return;
+    }
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    vz.layer.hidden = YES;
+    vz.layer.contents = nil;
+    [CATransaction commit];
+    vz_retire_cur(vmfg_now_ns());
+    vz_poll();
+}
+
+/* Presenter queue, every 0.5 s and after a tune change. */
+static void vz_update(bool onecopy)
+{
+    bool want = vz.cfg && onecopy;
+
+    if (want != vz.was_on) {
+        fprintf(stderr, "ember-vmz: %s\n", want ? "on" : "off");
+    }
+    atomic_store(&vz.on, want);
+    if (want || vz.was_on) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            vz_sync_layer(want);
+        });
+    }
+    if (!want && vz.was_on) {
+        vz_hide();
+        atomic_store(&vmfg.repost, true);   /* the Metal layer is stale */
+    }
+    vz.was_on = want;
+}
+
+/* Presenter queue: put the buffer on screen. */
+static void vz_show(id<MTLTexture> tex, NSData *data, VzPage *page, int lane,
+                    uint64_t owner, uint64_t ticket, int64_t arrival_ns)
+{
+    @autoreleasepool {
+        int64_t now = vmfg_now_ns();
+        bool same = vz.has_cur && vz.cur.tex.iosurface == tex.iosurface;
+
+        if (!atomic_load(&vz.on) || !vz.layer) {
+            /* Switched off while this frame was queued: never on screen. */
+            VzHeld h = { .tex = tex, .data = data, .page = page, .lane = lane,
+                         .owner = owner, .ticket = ticket };
+            vz_publish(&h, false);
+            return;
+        }
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (same) {
+            /* The same object would be ignored; GPU writes change no seed. */
+            ((void (*)(id, SEL))objc_msgSend)(vz.layer,
+                                              sel_registerName("setContentsChanged"));
+            atomic_fetch_add(&vz.st_same, 1);
+        } else {
+            vz.layer.contents = (id)tex.iosurface;
+        }
+        if (!atomic_exchange(&vz.visible, true)) {
+            vz.layer.hidden = NO;
+        }
+        [CATransaction commit];
+        vz_retire_cur(now);
+        vz.cur = (VzHeld){
+            .tex = tex, .data = data, .page = page, .lane = lane,
+            .owner = owner, .ticket = ticket,
+        };
+        vz.has_cur = true;
+        atomic_fetch_add(&vz.st_show, 1);
+        vmfg.last_arrival_ns = arrival_ns;
+        vmfg_tune_poll(now);
+        vmfg_log_stats(now);
+        vz_poll();
+    }
+}
+
+/*
+ * QEMU thread, flush. false: this frame goes down the copy paths. The reader
+ * ticket is taken here, before the guest can learn the frame was displayed.
+ */
+static bool vz_flush(id<MTLTexture> src, MTLOrigin origin, MTLSize size,
+                     int64_t now)
+{
+    VzEntry *e;
+    NSData *data;
+    VzPage *page;
+    int lane;
+    uint64_t owner, ticket;
+
+    if (!atomic_load(&vz.on) || !atomic_load(&vz.ready)) {
+        return false;
+    }
+    if (!src.iosurface) {
+        atomic_fetch_add(&vz.st_nosurf, 1);
+        return false;
+    }
+    if (origin.x || origin.y || size.width != src.width ||
+        size.height != src.height ||
+        (src.pixelFormat != MTLPixelFormatBGRA8Unorm &&
+         src.pixelFormat != MTLPixelFormatBGRA8Unorm_sRGB)) {
+        atomic_fetch_add(&vz.st_geom, 1);
+        return false;
+    }
+    e = vz_entry_of(src);
+    if (!e) {
+        atomic_fetch_add(&vz.st_nolane, 1);
+        return false;
+    }
+    data = [e->data retain];
+    page = e->page;
+    lane = e->lane;
+    owner = e->owner;
+    ticket = atomic_fetch_add(&page->lanes[lane].r_issued, 1) + 1;
+    [src retain];
+    ++vmfg.frame_no;
+    atomic_fetch_add(&vmfg.st_orig, 1);
+    dispatch_async(vmfg.pq, ^{
+        vz_show(src, data, page, lane, owner, ticket, now);
+    });
+    return true;
+}
+
+/* ---- flash probe (EMBER_VMFG_FLASH) ------------------------------------- */
+
+static bool vmfg_on(void)
+{
+    return vmfg.mode != VMFG_OFF && vmfg.queue != nil;
+}
+
+static unsigned vmfg_probe_bpp(MTLPixelFormat f)
+{
+    switch (f) {
+    case MTLPixelFormatBGRA8Unorm:
+    case MTLPixelFormatBGRA8Unorm_sRGB:
+    case MTLPixelFormatRGBA8Unorm:
+    case MTLPixelFormatRGBA8Unorm_sRGB:
+    case MTLPixelFormatRGB10A2Unorm:
+    case MTLPixelFormatBGR10A2Unorm:
+        return 4;
+    case MTLPixelFormatRGBA16Float:
+    case MTLPixelFormatRGBA16Unorm:
+        return 8;
+    case MTLPixelFormatRGBA32Float:
+        return 16;
+    default:
+        return 0;
+    }
+}
+
+static double vmfg_half(uint16_t h)
+{
+    int e = (h >> 10) & 0x1f, m = h & 0x3ff;
+    double v = e == 0 ? ldexp(m, -24) :
+               e == 31 ? 65504.0 : ldexp(m + 1024, e - 25);
+    return (h & 0x8000) ? -v : v;
+}
+
+/* Mean of the colour channels, 0 = black, 1 = SDR white. */
+static double vmfg_probe_level(const uint8_t *p, MTLPixelFormat f)
+{
+    uint32_t w;
+    uint16_t u[3];
+    float fl[3];
+
+    switch (f) {
+    case MTLPixelFormatBGRA8Unorm:
+    case MTLPixelFormatBGRA8Unorm_sRGB:
+    case MTLPixelFormatRGBA8Unorm:
+    case MTLPixelFormatRGBA8Unorm_sRGB:
+        return (p[0] + p[1] + p[2]) / 765.0;
+    case MTLPixelFormatRGB10A2Unorm:
+    case MTLPixelFormatBGR10A2Unorm:
+        memcpy(&w, p, 4);
+        return ((w & 0x3ff) + ((w >> 10) & 0x3ff) + ((w >> 20) & 0x3ff)) /
+               3069.0;
+    case MTLPixelFormatRGBA16Float:
+        memcpy(u, p, 6);
+        return (vmfg_half(u[0]) + vmfg_half(u[1]) + vmfg_half(u[2])) / 3;
+    case MTLPixelFormatRGBA16Unorm:
+        memcpy(u, p, 6);
+        return (u[0] + u[1] + u[2]) / 196605.0;
+    case MTLPixelFormatRGBA32Float:
+        memcpy(fl, p, 12);
+        return (fl[0] + fl[1] + fl[2]) / 3;
+    default:
+        return 0;
+    }
+}
+
+static void vmfg_probe_report(uint32_t seq, uint64_t frame_no,
+                              int64_t arrival, int64_t gpu_done, double level)
+{
+    int64_t g_any = 0, g_orig = 0, lp_best = 0, g_leg = 0;
+    int k;
+
+    pthread_mutex_lock(&vmfg.lock);
+    for (k = 0; k < VMFG_GLASS_N; k++) {
+        const VmfgGlass *e = &probe.glass[k];
+        if (e->t_ns <= 0 || e->frame_no < frame_no || e->t_ns < arrival) {
+            continue;
+        }
+        if (!g_any || e->t_ns < g_any) {
+            g_any = e->t_ns;
+        }
+        if (!e->generated && (!g_orig || e->t_ns < g_orig)) {
+            g_orig = e->t_ns;
+        }
+    }
+    for (k = 0; k < VMFG_GLASS_N; k++) {
+        if (probe.lp_commit[k] >= arrival &&
+            (!lp_best || probe.lp_commit[k] < lp_best)) {
+            lp_best = probe.lp_commit[k];
+            g_leg = probe.lp_glass[k];          /* 0 pending, -1 not shown */
+        }
+    }
+    pthread_mutex_unlock(&vmfg.lock);
+    if (vmfg.mode == VMFG_PROBE) {
+        g_any = g_orig = g_leg > 0 ? g_leg : 0;
+    }
+    fprintf(stderr,
+            "ember-vmfg: flash seq=%u frame=%llu path=%s arrive_ns=%lld "
+            "gpu_ms=%.2f glass_ms=%.2f glass_orig_ms=%.2f level=%.2f\n",
+            seq, (unsigned long long)frame_no, vmfg_mode_name(),
+            (long long)arrival, (gpu_done - arrival) / 1e6,
+            g_any ? (g_any - arrival) / 1e6 : -1.0,
+            g_orig ? (g_orig - arrival) / 1e6 : -1.0, level);
+}
+
+/* Metal completion: the probe pixel of frame frame_no is in slot k. */
+static void vmfg_probe_done(unsigned k, MTLPixelFormat f, uint64_t frame_no,
+                            int64_t arrival)
+{
+    const uint8_t *p = (const uint8_t *)probe.buf.contents + k * 16;
+    double v = vmfg_probe_level(p, f);
+    int64_t now = vmfg_now_ns();
+    uint32_t seq = 0;
+
+    pthread_mutex_lock(&vmfg.lock);
+    if (!probe.bright && v > 0.62) {
+        probe.bright = true;
+        seq = ++probe.seq;
+    } else if (probe.bright && v < 0.38) {
+        probe.bright = false;
+    }
+    pthread_mutex_unlock(&vmfg.lock);
+    if (seq) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, VMFG_PROBE_REPORT_NS),
+                       dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+            vmfg_probe_report(seq, frame_no, arrival, now, v);
+        });
+    }
+}
+
+/* QEMU thread: copy one pixel of src into the probe ring (same encoder). */
+static void vmfg_probe_encode(id<MTLBlitCommandEncoder> blit,
+                              id<MTLCommandBuffer> cb, id<MTLTexture> src,
+                              MTLOrigin o, MTLSize sz, uint64_t frame_no,
+                              int64_t arrival)
+{
+    MTLPixelFormat f = src.pixelFormat;
+    NSUInteger x, y;
+    unsigned k;
+
+    if (!probe.on || !vmfg_probe_bpp(f) || !sz.width || !sz.height) {
+        return;
+    }
+    x = o.x + MIN(sz.width - 1, (NSUInteger)(probe.fx * sz.width));
+    y = o.y + MIN(sz.height - 1, (NSUInteger)(probe.fy * sz.height));
+    k = probe.next++ % VMFG_PROBE_N;
+    [blit copyFromTexture:src
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:MTLOriginMake(x, y, 0)
+               sourceSize:MTLSizeMake(1, 1, 1)
+                 toBuffer:probe.buf
+        destinationOffset:k * 16
+   destinationBytesPerRow:16
+ destinationBytesPerImage:16];
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        (void)done;
+        vmfg_probe_done(k, f, frame_no, arrival);
+    }];
+}
+
+/* QEMU thread, legacy path measured (VMFG_PROBE): probe copy only. */
+static void vmfg_probe_legacy_flush(void)
+{
+    @autoreleasepool {
+        id<MTLTexture> src;
+        MTLOrigin origin;
+        MTLSize size;
+        id<MTLCommandBuffer> cb;
+        id<MTLBlitCommandEncoder> blit;
+        int64_t now = vmfg_now_ns();
+
+        pthread_mutex_lock(&vmfg.lock);
+        src = [vmfg.src retain];
+        origin = vmfg.src_origin;
+        size = vmfg.src_size;
+        pthread_mutex_unlock(&vmfg.lock);
+        if (!src) {
+            return;
+        }
+        atomic_fetch_add(&vmfg.st_in, 1);
+        atomic_store(&vmfg.last_fmt, (uint32_t)src.pixelFormat);
+        cb = [vmfg.queue commandBuffer];
+        blit = [cb blitCommandEncoder];
+        vmfg_probe_encode(blit, cb, src, origin, size, ++vmfg.frame_no, now);
+        [blit endEncoding];
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+            (void)done;
+            [src release];
+        }];
+        [cb commit];
+    }
+}
+
+/* ---- public entry points --------------------------------------------------- */
+
+static double vmfg_env_double(const char *name, double def, double lo)
+{
+    const char *v = getenv(name);
+    return v && atof(v) >= lo ? atof(v) : def;
+}
+
+void ember_vmfg_init(CAMetalLayer *layer)
+{
+    const char *m = getenv("EMBER_VMFG");
+    const char *fl = getenv("EMBER_VMFG_FLASH");
+    const char *v, *service = NULL;
+    bool want_probe = fl && *fl && strcmp(fl, "0") && strcmp(fl, "off");
+
+    if (!m || !*m || !strcmp(m, "0") || !strcmp(m, "off")) {
+        if (!want_probe) {
+            return;
+        }
+        m = NULL;                   /* legacy display path + flash probe */
+    }
+    if (!layer || !layer.device) {
+        fprintf(stderr, "ember-vmfg: no Metal layer, staying off\n");
+        return;
+    }
+    vmfg.mode = !m ? VMFG_PROBE : !strcmp(m, "dup") ? VMFG_DUP :
+                !strcmp(m, "fg") ? VMFG_FG : VMFG_COUNT;
+    v = getenv("EMBER_VMFG_LOG");
+    vmfg.log = !(v && !strcmp(v, "0"));
+    vmfg.gen_ratio = vmfg_env_double("EMBER_VMFG_GEN_RATIO", 1.6, 1.0001);
+    v = getenv("EMBER_VMFG_HZ");
+    if (v && atof(v) >= 24.0) {
+        vmfg.hz_override_ns = (int64_t)(1e9 / atof(v));
+    }
+    vmfg.margin_ns = (int64_t)(vmfg_env_double("EMBER_VMFG_DEADLINE_MS",
+                                               2.0, 0.0) * 1e6);
+    vmfg.min_budget_ns = (int64_t)(vmfg_env_double("EMBER_VMFG_MIN_BUDGET_MS",
+                                                   1.0, 0.0) * 1e6);
+    v = getenv("EMBER_VMFG_INFLIGHT");
+    vmfg.inflight_auto = !v || !*v || !strcmp(v, "auto") || atoi(v) < 1;
+    vmfg.max_inflight = vmfg.inflight_auto ? 3 : MIN(3, atoi(v));
+    vmfg.engine = &vmfg_engine_dup;
+    if (vmfg.mode == VMFG_FG) {
+        service = getenv("EMBER_VMFG_SERVICE");
+        if (!service || !*service) {
+            service = "com.ember.vmfg";
+        }
+        vmfg.ipc = evfx_client_new(service);
+        if (vmfg.ipc) {
+            vmfg.engine = &vmfg_engine_helper;
+        } else {
+            fprintf(stderr, "ember-vmfg: helper client failed, using count\n");
+            vmfg.mode = VMFG_COUNT;
+        }
+    }
+    vmfg.layer = [layer retain];
+    vmfg.device = [layer.device retain];
+    if (want_probe) {
+        double fx = 0.5, fy = 0.5;
+        if (sscanf(fl, "%lf,%lf", &fx, &fy) != 2 || fx < 0 || fx > 1 ||
+            fy < 0 || fy > 1) {
+            fx = fy = 0.5;
+        }
+        probe.fx = fx;
+        probe.fy = fy;
+        probe.buf = [vmfg.device
+                     newBufferWithLength:VMFG_PROBE_N * 16
+                                 options:MTLResourceStorageModeShared];
+        probe.on = probe.buf != nil;
+        fprintf(stderr, "ember-vmfg: flash probe %s at %.3f,%.3f of the "
+                "scanout (%s path)\n", probe.on ? "on" : "FAILED", fx, fy,
+                vmfg_mode_name());
+    }
+    vmfg.queue = [vmfg.device newCommandQueue];
+    /* vmfgjit-1031 fill */
+    v = getenv("EMBER_VMFG_GPU_PRIO");
+    if (v && *v) {
+        vtune.gpu_prio = atoi(v);
+    }
+    v = getenv("EMBER_VMFG_DEADLINE_MODE");
+    if (v && *v) {
+        vtune.deadline_mode = !strcmp(v, "latch");
+    }
+    vtune.latch_margin_ns = (int64_t)(vmfg_env_double(
+        "EMBER_VMFG_LATCH_MARGIN_MS", 1.0, 0.0) * 1e6);
+    v = getenv("EMBER_VMFG_TUNE");
+    if (v && *v && strlen(v) < sizeof(vtune.path)) {
+        strcpy(vtune.path, v);
+    }
+    v = getenv("EMBER_VMZ");
+    vz.cfg = v && atoi(v) != 0;
+    v = getenv("EMBER_VMZ_HOLD_MS");
+    if (v && atof(v) >= 0) {
+        vz.hold_ns = (int64_t)(atof(v) * 1e6);
+    }
+    v = getenv("EMBER_VMFG_ONECOPY");
+    if (v && *v) {
+        vmfg.onecopy_cfg = !strcmp(v, "auto") ? 2 : atoi(v) != 0;
+    }
+    v = getenv("EMBER_VMFG_PASS_NOSYNC");
+    vtune.pass_nosync = v && atoi(v) != 0;
+    v = getenv("EMBER_VMFG_CONTROL");
+    if (v && *v && strlen(v) < sizeof(vtune.ctl_path)) {
+        strcpy(vtune.ctl_path, v);
+    }
+    vmfg_apply_gpu_prio();
+    vmfg_tune_poll(vmfg_now_ns());
+    fprintf(stderr, "ember-vmfg: fill1031 gpu_prio=%d(applied %d) "
+            "deadline_mode=%s latch_margin_ms=%.2f tune=%s\n",
+            vtune.gpu_prio, vtune.gpu_prio_applied,
+            vtune.deadline_mode ? "latch" : "vsync",
+            vtune.latch_margin_ns / 1e6, vtune.path[0] ? vtune.path : "-");
+    v = getenv("EMBER_VMFG_DEDUP");
+    vmfg.dedup = v && *v ? MAX(0, MIN(2, atoi(v))) :
+                 vmfg.mode == VMFG_FG ? 2 : 0;
+    if (vmfg.mode == VMFG_PROBE) {
+        vmfg.dedup = 0;             /* legacy path presents; nothing to skip */
+    }
+    if (vmfg.dedup) {
+        vmfg_cmp_init();
+    }
+    vmfg.pq = dispatch_queue_create("ember.vmfg.present",
+                                    dispatch_queue_attr_make_with_qos_class(
+                                        DISPATCH_QUEUE_SERIAL,
+                                        QOS_CLASS_USER_INTERACTIVE, 0));
+    v = getenv("EMBER_VMFG_DISPLAYSYNC");
+    if (v && !strcmp(v, "0") && vmfg.mode != VMFG_PROBE) {
+        /* windowed: WindowServer still composites (no tearing); the drawable
+           goes to it at once instead of waiting for the layer's own vsync */
+        layer.displaySyncEnabled = NO;
+    }
+    fprintf(stderr, "ember-vmfg: layer maximumDrawableCount=%lu "
+            "displaySyncEnabled=%d presentsWithTransaction=%d "
+            "framebufferOnly=%d allowsNextDrawableTimeout=%d\n",
+            (unsigned long)layer.maximumDrawableCount,
+            (int)layer.displaySyncEnabled, (int)layer.presentsWithTransaction,
+            (int)layer.framebufferOnly, (int)layer.allowsNextDrawableTimeout);
+    fprintf(stderr, "ember-vmfg: on mode=%s inflight=%s%d gen_ratio=%.2f "
+            "hz_override=%s service=%s deadline_margin_ms=%.2f dedup=%d "
+            "(vmfg-1030)\n",
+            vmfg_mode_name(), vmfg.inflight_auto ? "auto<=" : "",
+            vmfg.max_inflight, vmfg.gen_ratio,
+            vmfg.hz_override_ns ? getenv("EMBER_VMFG_HZ") : "no",
+            vmfg.ipc ? service : "-", vmfg.margin_ns / 1e6, vmfg.dedup);
+}
+
+bool ember_vmfg_active(void)
+{
+    return vmfg_on() && vmfg.mode != VMFG_PROBE;
+}
+
+void ember_vmfg_set_source(id<MTLTexture> tex, uint32_t x, uint32_t y,
+                           uint32_t w, uint32_t h)
+{
+    id<MTLTexture> old;
+
+    if (!vmfg_on()) {
+        return;
+    }
+    if (tex && tex.device != vmfg.device) {
+        /* Scanout on another device: leave it to the legacy path. */
+        tex = nil;
+    }
+    pthread_mutex_lock(&vmfg.lock);
+    old = vmfg.src;
+    vmfg.src = [tex retain];
+    vmfg.src_origin = MTLOriginMake(x, y, 0);
+    vmfg.src_size = MTLSizeMake(w, h, 1);
+    pthread_mutex_unlock(&vmfg.lock);
+    [old release];
+    if (!tex && atomic_load(&vz.visible)) {
+        dispatch_async(vmfg.pq, ^{
+            vz_hide();
+        });
+    }
+}
+
+bool ember_vmfg_flush(void)
+{
+    id<MTLTexture> src;
+    MTLOrigin origin;
+    MTLSize size;
+    int i, pick = -1, against;
+    bool cmp;
+
+    if (!vmfg_on()) {
+        return false;
+    }
+    if (vmfg.mode == VMFG_PROBE) {
+        vmfg_probe_legacy_flush();
+        return false;               /* the legacy path still presents */
+    }
+    @autoreleasepool {
+        int64_t now = vmfg_now_ns();
+        id<MTLCommandBuffer> cb;
+        id<MTLBlitCommandEncoder> blit;
+        VmfgSlot *s;
+
+        pthread_mutex_lock(&vmfg.lock);
+        src = [vmfg.src retain];
+        origin = vmfg.src_origin;
+        size = vmfg.src_size;
+        for (i = 0; src && i < VMFG_SLOTS; i++) {
+            if (vmfg.slot[i].refs == 0) {
+                pick = i;
+                vmfg.slot[i].refs = 1;      /* the presenter job's reference */
+                break;
+            }
+        }
+        pthread_mutex_unlock(&vmfg.lock);
+
+        if (!src) {
+            return false;                   /* not a Metal scanout */
+        }
+        atomic_fetch_add(&vmfg.st_in, 1);
+        atomic_store(&vmfg.last_fmt, (uint32_t)src.pixelFormat);
+        if (vz_flush(src, origin, size, now)) {
+            if (pick >= 0) {
+                vmfg_slot_unref(pick);      /* the slot was not needed */
+            }
+            [src release];                  /* vz_flush holds its own */
+            return true;
+        }
+        if (atomic_load(&vz.visible)) {
+            dispatch_async(vmfg.pq, ^{
+                vz_hide();
+            });
+        }
+        if (vmfg_direct_flush(src, origin, size, now)) {
+            if (pick >= 0) {
+                vmfg_slot_unref(pick);      /* the slot was not needed */
+            }
+            return true;                    /* src released on GPU completion */
+        }
+        if (pick < 0) {
+            atomic_fetch_add(&vmfg.st_snap_drop, 1);
+            [src release];
+            return true;
+        }
+
+        s = &vmfg.slot[pick];
+        if (!s->tex || s->tex.width != size.width ||
+            s->tex.height != size.height ||
+            s->tex.pixelFormat != src.pixelFormat) {
+            vmfg_slot_alloc(s, src.pixelFormat, size.width, size.height);
+        }
+        if (!s->tex) {
+            vmfg_slot_unref(pick);
+            [src release];
+            return true;
+        }
+        s->frame_no = ++vmfg.frame_no;
+        s->arrival_ns = now;
+
+        cb = [vmfg.queue commandBuffer];
+        blit = [cb blitCommandEncoder];
+        [blit copyFromTexture:src
+                  sourceSlice:0
+                  sourceLevel:0
+                 sourceOrigin:origin
+                   sourceSize:size
+                    toTexture:s->tex
+             destinationSlice:0
+             destinationLevel:0
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+        vmfg_probe_encode(blit, cb, src, origin, size, s->frame_no, now);
+        against = vmfg.cmp_ref;
+        cmp = vmfg_cmp_encode(blit, pick);
+        [blit endEncoding];
+        if (cmp) {
+            vmfg_cmp_dispatch(cb, pick, against);
+            if (vmfg.dedup == 1) {
+                /* count only: no wait, no behaviour change */
+                int k = pick;
+                [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+                    const volatile uint32_t *fl =
+                        (const volatile uint32_t *)vmfg.cmp_buf.contents;
+                    if (done.status == MTLCommandBufferStatusCompleted &&
+                        fl[k] == 0) {
+                        atomic_fetch_add(&vmfg.st_dup, 1);
+                    }
+                }];
+            }
+        }
+        /* Keep the guest's scanout memory mapped until the copy ran. */
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+            (void)done;
+            [src release];
+        }];
+        if (s->surf || (cmp && vmfg.dedup >= 2)) {
+            s->snap = [cb retain];          /* presenter waits before IPC / reads the flag */
+        }
+        [cb commit];
+
+        atomic_fetch_add(&vmfg.queued, 1);
+        atomic_fetch_add(&vmfg.pq_busy, 1);
+        dispatch_async(vmfg.pq, ^{
+            vmfg_present_frame(pick);
+            atomic_fetch_sub(&vmfg.pq_busy, 1);
+            vmfg_spare_refill();
+        });
+    }
+    return true;
+}
+
+bool ember_vmfg_kick(void)
+{
+    bool owns;
+
+    if (!ember_vmfg_active()) {
+        return false;
+    }
+    pthread_mutex_lock(&vmfg.lock);
+    owns = vmfg.src != nil;
+    pthread_mutex_unlock(&vmfg.lock);
+    if (!owns) {
+        return false;               /* legacy path draws this scanout */
+    }
+    /* Called on guest flips and, with idle retry enabled, refresh ticks:
+       re-present only when a frame is owed (geometry change, no drawable),
+       never a duplicate of the queued one. A pending frame is released by
+       the presented handler or its timeout, not by the kick (vmfg4 woke the
+       presenter ~100 times/s for that). */
+    if (atomic_load(&vmfg.repost) &&
+        !atomic_exchange(&vmfg.kick_queued, true)) {
+        atomic_fetch_add(&vmfg.st_kick, 1);
+        dispatch_async(vmfg.pq, ^{
+            vmfg_present_pending();
+            /* A blocked nextDrawable must not accumulate timer jobs. */
+            atomic_store(&vmfg.kick_queued, false);
+        });
+    }
+    return true;
+}
+
+void ember_vmfg_set_display_period(int64_t time_value, int32_t time_scale)
+{
+    if (time_value > 0 && time_scale > 0) {
+        atomic_store(&vmfg.display_ns,
+                     (int64_t)(1e9 * (double)time_value / time_scale));
+    }
+}
+
+/* ---- stage 3: guest refresh, colour tag, legacy present hook --------------- */
+
+uint32_t ember_vmfg_guest_refresh_mhz(NSScreen *screen, int64_t time_value,
+                                      int32_t time_scale)
+{
+    static uint32_t last = UINT32_MAX;
+    const char *mode = getenv("EMBER_VMFG_GUEST_HZ");
+    double nominal = 0, maxfps = 0, host, hz;
+    uint32_t mhz;
+
+    if (time_value > 0 && time_scale > 0) {
+        nominal = (double)time_scale / time_value;
+    }
+    if (@available(macOS 12.0, *)) {
+        maxfps = screen ? (double)screen.maximumFramesPerSecond : 0;
+    }
+    host = MAX(nominal, maxfps);
+    if (atomic_load(&vmfg_pin_mhz)) {
+        /* EMBER_VMFG_SCREEN chose a screen: the guest keeps its rate even if
+           the window is moved or re-centred elsewhere (no EDID flip-flop) */
+        host = atomic_load(&vmfg_pin_mhz) / 1000.0;
+    } else if (mode && !strcmp(mode, "first") && host > 0) {
+        atomic_store(&vmfg_pin_mhz, (uint32_t)(host * 1000 + 0.5));
+    }
+    if (!mode || !*mode || !strcmp(mode, "host") || !strcmp(mode, "first")) {
+        hz = host;
+    } else if (!strcmp(mode, "nominal")) {
+        hz = nominal;
+    } else if (!strcmp(mode, "half")) {
+        hz = host / 2;
+    } else {
+        hz = atof(mode);
+        if (hz < 24 || hz > 500) {
+            hz = host;
+        }
+    }
+    if (mode && !strcmp(mode, "nominal") && nominal > 0) {
+        /* exactly what upstream QEMU computes */
+        mhz = (uint32_t)((int64_t)1000 * time_scale / time_value);
+    } else {
+        mhz = hz >= 1 ? (uint32_t)(hz * 1000 + 0.5) : 0;
+    }
+    if (mhz != last) {
+        last = mhz;
+        fprintf(stderr, "ember-vmfg: guest EDID refresh %.3f Hz (screen "
+                "nominal %.3f max %.0f, EMBER_VMFG_GUEST_HZ=%s%s)\n",
+                mhz / 1000.0, nominal, maxfps, mode && *mode ? mode : "host",
+                atomic_load(&vmfg_pin_mhz) ? ", pinned" : "");
+    }
+    return mhz;
+}
+
+void ember_vmfg_layer_format(CAMetalLayer *layer, MTLPixelFormat fmt)
+{
+    CGColorSpaceRef want;
+
+    if (vmfg_cs_mode < 0) {
+        const char *v = getenv("EMBER_VMFG_COLORSPACE");
+        vmfg_cs_mode = v && !strcasecmp(v, "srgb") ? 1 : 0;
+        fprintf(stderr, "ember-vmfg: layer colorspace %s\n",
+                vmfg_cs_mode ? "sRGB (float: extended linear sRGB)" :
+                "untagged");
+    }
+    if (!layer || vmfg_cs_mode != 1) {
+        return;
+    }
+    want = CGColorSpaceCreateWithName(fmt == MTLPixelFormatRGBA16Float ?
+                                      kCGColorSpaceExtendedLinearSRGB :
+                                      kCGColorSpaceSRGB);
+    if (want && (!layer.colorspace || !CFEqual(layer.colorspace, want))) {
+        layer.colorspace = want;
+    }
+    CGColorSpaceRelease(want);
+}
+
+void ember_vmfg_legacy_present(id<CAMetalDrawable> d)
+{
+    unsigned k;
+    int64_t now;
+
+    if (!probe.on || vmfg.mode != VMFG_PROBE || !d) {
+        return;
+    }
+    now = vmfg_now_ns();
+    pthread_mutex_lock(&vmfg.lock);
+    k = probe.lp_i++ % VMFG_GLASS_N;
+    probe.lp_commit[k] = now;
+    probe.lp_glass[k] = 0;
+    pthread_mutex_unlock(&vmfg.lock);
+    [d addPresentedHandler:^(id<MTLDrawable> shown) {
+        CFTimeInterval t = shown.presentedTime;
+        pthread_mutex_lock(&vmfg.lock);
+        if (probe.lp_commit[k] == now) {
+            probe.lp_glass[k] = t > 0 ? (int64_t)(t * 1e9) : -1;
+        }
+        pthread_mutex_unlock(&vmfg.lock);
+    }];
+}
+
+static CGDirectDisplayID vmfg_display_of(NSScreen *sc)
+{
+    return sc ? [sc.deviceDescription[@"NSScreenNumber"] unsignedIntValue] : 0;
+}
+
+static NSScreen *vmfg_screen_by_id(CGDirectDisplayID id)
+{
+    for (NSScreen *sc in [NSScreen screens]) {
+        if (vmfg_display_of(sc) == id) {
+            return sc;
+        }
+    }
+    return nil;
+}
+
+static NSInteger vmfg_screen_hz(NSScreen *sc)
+{
+    NSInteger hz = 0;
+    CGDisplayModeRef m;
+
+    if (!sc) {
+        return 0;
+    }
+    if (@available(macOS 12.0, *)) {
+        hz = sc.maximumFramesPerSecond;
+    }
+    m = CGDisplayCopyDisplayMode(vmfg_display_of(sc));
+    if (m) {
+        hz = MAX(hz, (NSInteger)(CGDisplayModeGetRefreshRate(m) + 0.5));
+        CGDisplayModeRelease(m);
+    }
+    return hz;
+}
+
+/* Centre w on sc the way -[NSWindow center] does (a bit above the middle). */
+static void vmfg_center_on(NSWindow *w, NSScreen *sc)
+{
+    NSRect vf = sc.visibleFrame, f = w.frame;
+
+    [w setFrameOrigin:NSMakePoint(
+         vf.origin.x + MAX(0, (vf.size.width - f.size.width) / 2),
+         vf.origin.y + MAX(0, (vf.size.height - f.size.height) * 2 / 3))];
+}
+
+static void vmfg_log_screen(NSWindow *w, const char *why)
+{
+    NSScreen *sc = w.screen;
+    NSRect f = w.frame;
+
+    fprintf(stderr, "ember-vmfg: window on screen \"%s\" max %ld Hz frame "
+            "%.0fx%.0f at %.0f,%.0f (%s)\n",
+            sc ? sc.localizedName.UTF8String : "?", (long)vmfg_screen_hz(sc),
+            f.size.width, f.size.height, f.origin.x, f.origin.y, why);
+}
+
+/* ---- EMBER_DISP_DIRECT_LOG: CA's composite/direct verdicts ---------------- */
+
+#define VMFG_DCODES 8
+static struct {
+    pthread_mutex_t lock;
+    uint64_t code[VMFG_DCODES];
+    uint32_t count[VMFG_DCODES];
+    uint32_t total, other;
+} vdirect = { .lock = PTHREAD_MUTEX_INITIALIZER };
+
+typedef void (*vmfg_composite_fn)(id, SEL, void *, uint64_t, uint32_t, double,
+                                  uint64_t);
+static vmfg_composite_fn vmfg_composite_orig;
+
+static void vmfg_composite_hook(id self, SEL cmd, void *layer, uint64_t did,
+                                uint32_t sid, double t, uint64_t code)
+{
+    int i;
+
+    pthread_mutex_lock(&vdirect.lock);
+    vdirect.total++;
+    for (i = 0; i < VMFG_DCODES; i++) {
+        if (vdirect.count[i] == 0 || vdirect.code[i] == code) {
+            vdirect.code[i] = code;
+            vdirect.count[i]++;
+            break;
+        }
+    }
+    if (i == VMFG_DCODES) {
+        vdirect.other++;
+    }
+    pthread_mutex_unlock(&vdirect.lock);
+    if (vmfg_composite_orig) {
+        vmfg_composite_orig(self, cmd, layer, did, sid, t, code);
+    }
+}
+
+static BOOL vmfg_track_hook(id self, SEL cmd)
+{
+    (void)self;
+    (void)cmd;
+    return YES;
+}
+
+static void vmfg_direct_log_tick(void)
+{
+    char line[256];
+    size_t n = 0;
+    uint32_t direct = 0;
+    int i;
+
+    pthread_mutex_lock(&vdirect.lock);
+    for (i = 0; i < VMFG_DCODES && vdirect.count[i]; i++) {
+        if (vdirect.code[i] == 0) {
+            direct = vdirect.count[i];
+        } else if (n < sizeof(line) - 32) {
+            n += snprintf(line + n, sizeof(line) - n, " 0x%llx:%u",
+                          (unsigned long long)vdirect.code[i],
+                          vdirect.count[i]);
+        }
+    }
+    line[n] = 0;
+    fprintf(stderr, "ember-disp: direct n=%u direct=%u other=%u codes%s\n",
+            vdirect.total, direct, vdirect.other, line);
+    memset(vdirect.code, 0, sizeof(vdirect.code));
+    memset(vdirect.count, 0, sizeof(vdirect.count));
+    vdirect.total = vdirect.other = 0;
+    pthread_mutex_unlock(&vdirect.lock);
+}
+
+static void vmfg_direct_log_init(void)
+{
+    static bool done;
+    const char *v = getenv("EMBER_DISP_DIRECT_LOG");
+    Class k;
+    Method m, t;
+    dispatch_source_t timer;
+
+    if (done || !v || strcmp(v, "1")) {
+        return;
+    }
+    done = true;
+    if (!dlopen("/System/Library/PrivateFrameworks/FramePacing.framework/"
+                "FramePacing", RTLD_NOW) ||
+        !(k = objc_getClass("FPMTLMetricsServiceInternal")) ||
+        !(m = class_getInstanceMethod(k, sel_registerName(
+              "metalLayerDrawableDidComposite:drawableID:surfaceID:"
+              "compositedTime:detachCode:")))) {
+        fprintf(stderr, "ember-disp: direct log unavailable\n");
+        return;
+    }
+    vmfg_composite_orig = (vmfg_composite_fn)method_setImplementation(
+        m, (IMP)vmfg_composite_hook);
+    t = class_getInstanceMethod(k, sel_registerName("_shouldEnableTracking"));
+    if (t) {
+        method_setImplementation(t, (IMP)vmfg_track_hook);
+    }
+    timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+                                   dispatch_get_global_queue(
+                                       QOS_CLASS_UTILITY, 0));
+    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW,
+                                                   5 * NSEC_PER_SEC),
+                              5 * NSEC_PER_SEC, NSEC_PER_SEC / 10);
+    dispatch_source_set_event_handler(timer, ^{
+        vmfg_direct_log_tick();
+    });
+    dispatch_resume(timer);
+    fprintf(stderr, "ember-disp: direct log on\n");
+}
+
+/*
+ * EMBER_VMFG_SCREEN=fastest|<n>: put the window on that screen and keep it
+ * there through QEMU's own re-centring (resizeWindow calls -center, which
+ * uses the screen with keyboard focus — night3: the 60 Hz one). The guest
+ * refresh is pinned to the chosen screen.
+ */
+void ember_vmfg_place_window(NSWindow *w)
+{
+    const char *v = getenv("EMBER_VMFG_SCREEN");
+    NSArray<NSScreen *> *all = [NSScreen screens];
+    NSScreen *pick = nil;
+
+    vmfg_direct_log_init();
+    if (!v || !*v) {
+        v = "fastest";              /* vmdisp-1031: see the header comment */
+    } else if (!strcmp(v, "keep") || !strcmp(v, "off")) {
+        v = NULL;
+    }
+    if (w && v && *v && all.count) {
+        if (!strcmp(v, "fastest")) {
+            NSInteger best = -1;
+            for (NSScreen *sc in all) {
+                NSInteger hz = vmfg_screen_hz(sc);
+                if (hz > best) {
+                    best = hz;
+                    pick = sc;
+                }
+            }
+        } else if (atoi(v) >= 0 && (NSUInteger)atoi(v) < all.count) {
+            pick = all[atoi(v)];
+        }
+    }
+    if (pick) {
+        vmfg_screen_id = vmfg_display_of(pick);
+        vmfg_place_ns = vmfg_now_ns();
+        atomic_store(&vmfg_pin_mhz, (uint32_t)(vmfg_screen_hz(pick) * 1000));
+        vmfg_center_on(w, pick);
+    }
+    if (w) {
+        vmfg_log_screen(w, v && *v ? v : "EMBER_VMFG_SCREEN unset");
+    }
+}
+
+/* Main thread, instead of -[NSWindow center] in resizeWindow. */
+void ember_vmfg_center_window(NSWindow *w)
+{
+    NSScreen *sc = vmfg_screen_id ? vmfg_screen_by_id(vmfg_screen_id) : nil;
+
+    if (sc) {
+        vmfg_center_on(w, sc);
+        vmfg_log_screen(w, "re-centred on the chosen screen");
+    } else {
+        [w center];
+    }
+}
+
+/*
+ * Main thread, windowDidChangeScreen. In the first 20 s (start-up resizes)
+ * the window is pulled back to the chosen screen; after that a move is the
+ * user's and is kept (the guest refresh stays pinned either way).
+ */
+void ember_vmfg_window_screen_changed(NSWindow *w)
+{
+    NSScreen *sc;
+
+    if (!w) {
+        return;
+    }
+    if (vmfg_screen_id && vmfg_display_of(w.screen) != vmfg_screen_id &&
+        vmfg_now_ns() - vmfg_place_ns < VMFG_SCREEN_HOLD_NS &&
+        (sc = vmfg_screen_by_id(vmfg_screen_id))) {
+        vmfg_center_on(w, sc);
+        vmfg_log_screen(w, "pulled back to the chosen screen");
+        return;
+    }
+    vmfg_log_screen(w, "screen changed");
+}
