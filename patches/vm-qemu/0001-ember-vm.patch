+/* Renderer reset/cleanup must join producers before cancelling/freeing. */
+void virtio_gpu_virgl_reset_async_fences(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_virgl_context_fence *f;
+
+    if (gl->async_fence_bh) {
+        qemu_bh_cancel(gl->async_fence_bh);
+    }
+    while (!QSLIST_EMPTY(&gl->async_fenceq)) {
+        f = QSLIST_FIRST(&gl->async_fenceq);
+        QSLIST_REMOVE_HEAD(&gl->async_fenceq, next);
+        g_free(f);
+    }
+}
+
+#if VIRGL_CHECK_VERSION(1, 1, 2)
+static void virtio_gpu_virgl_drain_async_fences(VirtIOGPU *g)
+{
+    QSLIST_HEAD(, virtio_gpu_virgl_context_fence) pending;
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_virgl_context_fence *f;
+
+    QSLIST_MOVE_ATOMIC(&pending, &gl->async_fenceq);
+    while (!QSLIST_EMPTY(&pending)) {
+        f = QSLIST_FIRST(&pending);
+        QSLIST_REMOVE_HEAD(&pending, next);
+        if (f->ring_idx == UINT32_MAX) {
+            virgl_write_fence(g, (uint32_t)f->fence_id);
+        } else {
+            virgl_write_context_fence(g, f->ctx_id, f->ring_idx, f->fence_id);
+        }
+        g_free(f);
+    }
+}
+
+static void virtio_gpu_virgl_async_fence_bh(void *opaque)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (gl->renderer_state != RS_INITED) {
+        return; /* reset/cleanup will join producers and discard records */
+    }
+    /*
+     * create_fence may call back before process_cmdq inserts into fenceq.
+     * Normally BQL + the guarded BH serialize these operations.  Keep the
+     * record and reschedule even if a nested main-loop poll runs this BH.
+     */
+    if (g->processing_cmdq) {
+        qemu_bh_schedule(gl->async_fence_bh);
+        return;
+    }
+    virtio_gpu_virgl_drain_async_fences(g);
+}
+
+static void virtio_gpu_virgl_context_fences_destroyed(VirtIOGPU *g,
+                                                       uint32_t ctx_id)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_ctrl_command *cmd, *tmp;
+
+    if (!gl->async_fence_bh) {
+        return;
+    }
+    /*
+     * Called inside CTX_DESTROY, after its producer was joined and before
