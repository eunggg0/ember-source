diff --git a/util/ember-precise-poll.c b/util/ember-precise-poll.c
new file mode 100644
index 0000000..1b13c2e
--- /dev/null
+++ b/util/ember-precise-poll.c
@@ -0,0 +1,249 @@
+/*
+ * Ember S2 (10-28, vmtimer2): precise main-loop / AioContext poll timeouts on macOS.
+ *
+ * QEMU on macOS has no ppoll(), so qemu_poll_ns() rounds every timeout up to a whole
+ * millisecond and calls g_poll()/poll(). The kernel then adds its timer-coalescing
+ * leeway on top (measured on macOS 27.2: a 16.67 ms main-loop wait returns
+ * p50 +2.35 ms late; pselect/nanosleep +7 ms; thread QoS does not change it).
+ * Every main_loop_tlg timer inherits that: the virtio-gpu GUI refresh (16 ms at 60 Hz,
+ * drives cocoa drawFrame on the legacy present path) and the 1 ms virgl fence poll.
+ *
+ * With EMBER_S2_PRECISE_LOOP=1 a per-thread kqueue is added to the poll set as one
+ * extra fd. Before polling, a one-shot EVFILT_TIMER (NOTE_MACHTIME|NOTE_ABSOLUTE|
+ * NOTE_CRITICAL|NOTE_LEEWAY 0) is armed on it at the exact deadline; the kqueue fd
+ * becomes readable when it fires and wakes poll(). poll() keeps its own (rounded-up,
+ * never earlier) timeout as a backstop. Afterwards the timer is deleted (which also
+ * drops a fired-but-unread activation), so the kqueue never stays readable.
+ * The caller's fds, events and revents are untouched apart from the copy.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/event.h>
+#include <mach/mach_time.h>
+#include "qemu/ember-precise-poll.h"
+
+#define EMBER_LOOP_TIMER_ID 0x454d4c50 /* 'EMLP' */
+
+typedef struct {
+    uint64_t t0;
+    uint64_t waits, timeouts, fdwakes, errs;
+    uint64_t hist[8]; /* lateness <50us <100 <250 <500 <1ms <2ms <4ms >=4ms */
+    double late_sum_us, late_max_us, req_sum_us;
+} EmberLoopStats;
+
+typedef struct {
+    int kq;               /* -1 = unusable on this thread */
+    struct pollfd *buf;
+    unsigned cap;
+    EmberLoopStats st;
+} EmberLoopTLS;
+
+static pthread_once_t ember_loop_once = PTHREAD_ONCE_INIT;
+static pthread_key_t ember_loop_key;
+static bool ember_loop_precise, ember_loop_stats;
+static mach_timebase_info_data_t ember_loop_tb;
+static __thread EmberLoopTLS *ember_loop_tls;
+
+static void ember_loop_tls_free(void *p)
+{
+    EmberLoopTLS *t = p;
+
+    if (t) {
+        if (t->kq >= 0) {
+            close(t->kq);
+        }
+        free(t->buf);
+        free(t);
+    }
+}
+
+static void ember_loop_init(void)
+{
+    const char *p = getenv("EMBER_S2_PRECISE_LOOP"), *s = getenv("EMBER_S2_LOOP_STATS");
+
+    mach_timebase_info(&ember_loop_tb);
+    pthread_key_create(&ember_loop_key, ember_loop_tls_free);
+    ember_loop_precise = p && p[0] == '1';
+    ember_loop_stats = s && s[0] == '1';
+    if (ember_loop_precise || ember_loop_stats) {
+        fprintf(stderr, "ember-loop: precise=%d stats=%d\n", ember_loop_precise, ember_loop_stats);
+    }
+}
+
+bool ember_precise_loop_enabled(void)
+{
+    pthread_once(&ember_loop_once, ember_loop_init);
+    return ember_loop_precise;
+}
+
+bool ember_loop_stats_enabled(void)
+{
+    pthread_once(&ember_loop_once, ember_loop_init);
+    return ember_loop_stats;
+}
+
+uint64_t ember_loop_now(void)
+{
+    return mach_absolute_time();
+}
+
+static uint64_t ns_to_mt(int64_t ns)
+{
+    return (uint64_t)((__uint128_t)ns * ember_loop_tb.denom / ember_loop_tb.numer);
+}
+
+static double mt_to_us(int64_t mt)
+{
+    return (double)mt * ember_loop_tb.numer / ember_loop_tb.denom / 1000.0;
+}
+
+static EmberLoopTLS *ember_loop_get(void)
+{
+    EmberLoopTLS *t = ember_loop_tls;
+
+    if (!t) {
+        pthread_once(&ember_loop_once, ember_loop_init);
+        t = calloc(1, sizeof(*t));
+        if (!t) {
+            return NULL;
+        }
+        t->kq = -1;
+        if (ember_loop_precise) {
+            t->kq = kqueue();
+            if (t->kq < 0) {
+                fprintf(stderr, "ember-loop: kqueue failed (%s), this thread keeps the normal poll\n",
+                        strerror(errno));
+            }
+        }
+        ember_loop_tls = t;
+        pthread_setspecific(ember_loop_key, t);
+    }
+    return t;
+}
+
+int ember_precise_poll(struct pollfd *fds, unsigned nfds, int64_t timeout_ns)
+{
+    EmberLoopTLS *t = ember_loop_get();
+    struct kevent64_s ch;
+    int64_t ms;
+    int r, saved;
+    unsigned i;
+
+    if (!t || t->kq < 0 || timeout_ns <= 0) {
+        return -2;
+    }
+    if (t->cap < nfds + 1) {
+        unsigned cap = (nfds + 1) * 2;
+        struct pollfd *nb = realloc(t->buf, cap * sizeof(*nb));
+        if (!nb) {
+            return -2;
+        }
+        t->buf = nb;
+        t->cap = cap;
+    }
+    if (nfds) {
+        memcpy(t->buf, fds, nfds * sizeof(*fds));
+    }
+    t->buf[nfds].fd = t->kq;
+    t->buf[nfds].events = POLLIN;
+    t->buf[nfds].revents = 0;
+
+    EV_SET64(&ch, EMBER_LOOP_TIMER_ID, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+             NOTE_MACHTIME | NOTE_ABSOLUTE | NOTE_CRITICAL | NOTE_LEEWAY,
+             mach_absolute_time() + ns_to_mt(timeout_ns), 0, 0, 0); /* ext[1] = 0 = leeway */
+    if (kevent64(t->kq, &ch, 1, NULL, 0, 0, NULL) < 0) {
+        t->st.errs++;
+        return -2;
+    }
+    /* backstop: same rounded-up ms as the normal path, so it can only fire after the kqueue timer */
+    ms = (timeout_ns + 999999) / 1000000;
+    if (ms > 0x7fffffff) {
+        ms = 0x7fffffff;
+    }
+    r = poll(t->buf, nfds + 1, (int)ms);
+    saved = errno;
+
+    /*
+     * Disarm; deleting the knote also drops a fired-but-unread activation, so the kqueue
+     * is not readable on the next call. No event list here: kevent with an event list and
+     * a zero timeout costs ~12 us on macOS 27, without it ~0.2 us. ENOENT is fine.
+     */
+    EV_SET64(&ch, EMBER_LOOP_TIMER_ID, EVFILT_TIMER, EV_DELETE, 0, 0, 0, 0, 0);
+    kevent64(t->kq, &ch, 1, NULL, 0, 0, NULL);
+
+    if (r > 0) {
+        for (i = 0; i < nfds; i++) {
+            fds[i].revents = t->buf[i].revents;
+        }
+        if (t->buf[nfds].revents) {
+            r--;
+        }
+    } else if (r == 0) {
+        for (i = 0; i < nfds; i++) {
+            fds[i].revents = 0;
+        }
+    }
+    errno = saved;
+    return r;
+}
+
+void ember_loop_record(int64_t timeout_ns, uint64_t start, int ret)
+{
+    static const double edge[7] = { 50, 100, 250, 500, 1000, 2000, 4000 };
+    EmberLoopTLS *t;
+    EmberLoopStats *st;
+    uint64_t now = mach_absolute_time();
+    double late;
+    int b;
+
+    if (!ember_loop_stats_enabled() || timeout_ns <= 0 || !(t = ember_loop_get())) {
+        return;
+    }
+    st = &t->st;
+    if (!st->t0) {
+        st->t0 = now;
+    }
+    st->waits++;
+    st->req_sum_us += timeout_ns / 1000.0;
+    if (ret != 0) {
+        st->fdwakes++;
+    } else {
+        st->timeouts++;
+        late = mt_to_us((int64_t)(now - (start + ns_to_mt(timeout_ns))));
+        if (late < 0) {
+            late = 0;
+        }
+        st->late_sum_us += late;
+        if (late > st->late_max_us) {
+            st->late_max_us = late;
+        }
+        for (b = 0; b < 7 && late >= edge[b]; b++) {
+        }
+        st->hist[b]++;
+    }
+    if (now - st->t0 > ns_to_mt(10000000000LL)) {
+        char name[32] = "";
+        uint64_t to = st->timeouts ? st->timeouts : 1;
+
+        pthread_getname_np(pthread_self(), name, sizeof(name));
+        fprintf(stderr, "ember-loop %s [%s]: waits=%llu timeout=%llu fdwake=%llu err=%llu req_avg_us=%.0f"
+                " late_avg_us=%.1f late_max_us=%.0f hist(<50,<100,<250,<500,<1m,<2m,<4m,>=4m)="
+                "%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+                ember_loop_precise && t->kq >= 0 ? "precise" : "poll", name[0] ? name : "?",
+                (unsigned long long)st->waits, (unsigned long long)st->timeouts,
+                (unsigned long long)st->fdwakes, (unsigned long long)st->errs,
+                st->req_sum_us / st->waits, st->late_sum_us / to, st->late_max_us,
+                (unsigned long long)st->hist[0], (unsigned long long)st->hist[1],
+                (unsigned long long)st->hist[2], (unsigned long long)st->hist[3],
+                (unsigned long long)st->hist[4], (unsigned long long)st->hist[5],
+                (unsigned long long)st->hist[6], (unsigned long long)st->hist[7]);
+        memset(st, 0, sizeof(*st));
+        st->t0 = now;
+    }
+}
