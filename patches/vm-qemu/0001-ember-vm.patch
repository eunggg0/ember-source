+/*
+ * Ember S2 (10-28, vmtimer2): precise main-loop / AioContext poll timeouts on macOS.
+ * Plain C (no QEMU headers) so Tools/dev/vmtimer-1028/tests/polltest.c can link the same code.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_EMBER_PRECISE_POLL_H
+#define QEMU_EMBER_PRECISE_POLL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <poll.h>
+
+/* EMBER_S2_PRECISE_LOOP=1 (default off) */
+bool ember_precise_loop_enabled(void);
+/* EMBER_S2_LOOP_STATS=1: per-thread timed-wait lateness on stderr every 10 s (both modes) */
+bool ember_loop_stats_enabled(void);
+uint64_t ember_loop_now(void);
+
+/*
+ * poll() whose timeout (ns, > 0) is enforced by a per-thread kqueue EVFILT_TIMER
+ * (NOTE_CRITICAL, leeway 0) that sits in the poll set as one extra fd; the caller's
+ * fds are polled unchanged. Returns like poll(); -2 = precise path unavailable
+ * (caller must fall back to its normal poll).
+ */
+int ember_precise_poll(struct pollfd *fds, unsigned nfds, int64_t timeout_ns);
+
+/* stats: one timed wait that started at start (ember_loop_now()) with timeout_ns, poll returned ret */
+void ember_loop_record(int64_t timeout_ns, uint64_t start, int ret);
+
+#endif
