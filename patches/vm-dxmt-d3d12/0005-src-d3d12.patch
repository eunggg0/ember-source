+  // D3D11 ExtractMTLStreamOutputElements, for D3D12 declarations (slot 0 only).
+  HRESULT EmberSOElements(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *d, std::vector<SM50_STREAM_OUTPUT_ELEMENT> &out) {
+    using namespace microsoft;
+    CSignatureParser parser;
+    HRESULT hr = DXBCGetOutputSignature(d->VS.pShaderBytecode, &parser);
+    if (FAILED(hr)) return hr;
+    const D3D11_SIGNATURE_PARAMETER *params;
+    auto count = parser.GetParameters(&params);
+    uint32_t offset = 0;
+    for (UINT i = 0; i < ember_so_desc_->NumEntries; i++) {
+      auto &e = ember_so_desc_->pSODeclaration[i];
+      uint32_t reg = 0xffffffff;
+      if (e.SemanticName) {
+        auto p = std::find_if(params, params + count, [&](const D3D11_SIGNATURE_PARAMETER &x) {
+          return x.SemanticIndex == e.SemanticIndex && strcasecmp(x.SemanticName, e.SemanticName) == 0;
+        });
+        if (p == params + count) return E_INVALIDARG;
+        reg = p->Register;
+      }
+      for (unsigned c = 0; c < e.ComponentCount; c++, offset += 4)
+        out.push_back({reg, (uint32_t)(e.StartComponent + c), 0, offset});
+    }
+    return offset <= ember_so_desc_->pBufferStrides[0] ? S_OK : E_INVALIDARG;
+  }
