+      for (uint64_t i = 0; i < count; ++i) {
+        if (size - pos < 4) return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
+        auto n = read(p + pos, 4); pos += 4;
+        if (n > (size - pos) / 2) return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
+        Name name;
+        name.reserve(size_t(n));
+        for (uint64_t j = 0; j < n; ++j) {
+          auto c = read(p + pos, 2); pos += 2;
+          if (!c) return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
+          name.push_back(WCHAR(c));
+        }
+        if (!pipelines_.emplace(std::move(name), Entry{}).second) return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
+      }
+      return pos == size ? S_OK : D3D12_ERROR_DRIVER_VERSION_MISMATCH;
+    } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void **out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    if (iid == __uuidof(IUnknown) || iid == __uuidof(ID3D12Object) || iid == __uuidof(ID3D12DeviceChild) ||
+        iid == __uuidof(ID3D12PipelineLibrary) || iid == __uuidof(ID3D12PipelineLibrary1)) {
+      *out = ref(this); return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+  HRESULT STDMETHODCALLTYPE StorePipeline(const WCHAR *name, ID3D12PipelineState *pso) override {
+    if (!name || !pso) return E_INVALIDARG;
+    try {
+      UINT size = 0;
+      HRESULT hr = pso->GetPrivateData(kEmberPipelineKey, &size, nullptr);
+      if (FAILED(hr) || !size) return E_INVALIDARG;
+      EmberPipelineKey key(size);
+      hr = pso->GetPrivateData(kEmberPipelineKey, &size, key.data());
+      if (FAILED(hr) || size != key.size()) return E_INVALIDARG;
