+  /* Ember: 그리기를 건너뛰는 자리표시 파이프라인. 상태 설정·바인딩 경로가 참조하는 값(깊이·래스터 상태,
+   * is_dxil)은 채워 두고 Metal PSO 만 없다. 명령 목록 PreDraw 가 ember_skip_draws 를 보고 그리기를 버린다. */
+  /* Ember(w3d12) 진단: EMBER_D12_DUMP_SKIP=<윈도우 폴더> 면 건너뛰는 파이프라인의 셰이더·루트 시그니처·입력 배치를 떠 둔다
+   * (테셀레이션 에뮬 오프라인 시험용). 파일 skNNN-{vs,hs,ds,gs,ps}.dxil, skNNN-rs.bin, skNNN.txt */
+  void
+  EmberDumpSkipped(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    static const std::string dir = EmberD12Opt("EMBER_D12_DUMP_SKIP");
+    if (dir.empty())
+      return;
+    static std::atomic<unsigned> seq{0};
+    unsigned n = seq.fetch_add(1);
+    if (n >= 200)
+      return;
+    char base[600];
+    snprintf(base, sizeof(base), "%s\\sk%03u", dir.c_str(), n);
+    auto put = [&](const char *suf, const void *p, size_t len) {
+      if (!p || !len)
+        return;
+      std::string path = std::string(base) + suf;
+      if (FILE *f = fopen(path.c_str(), "wb")) {
+        fwrite(p, 1, len, f);
+        fclose(f);
+      }
+    };
+    put("-vs.dxil", pDesc->VS.pShaderBytecode, pDesc->VS.BytecodeLength);
+    put("-hs.dxil", pDesc->HS.pShaderBytecode, pDesc->HS.BytecodeLength);
+    put("-ds.dxil", pDesc->DS.pShaderBytecode, pDesc->DS.BytecodeLength);
+    put("-gs.dxil", pDesc->GS.pShaderBytecode, pDesc->GS.BytecodeLength);
+    put("-ps.dxil", pDesc->PS.pShaderBytecode, pDesc->PS.BytecodeLength);
+    if (auto rs = static_cast<MTLD3D12RootSignature *>(pDesc->pRootSignature)) {
+      const void *blob = nullptr;
+      size_t len = rs->GetBlob(&blob);
+      put("-rs.bin", blob, len);
+    }
+    std::string path = std::string(base) + ".txt";
+    if (FILE *f = fopen(path.c_str(), "w")) {
+      fprintf(f, "topology_type %d rt %u fmt0 %d dsv %d samples %u so %u\n", (int)pDesc->PrimitiveTopologyType,
+              pDesc->NumRenderTargets, (int)pDesc->RTVFormats[0], (int)pDesc->DSVFormat, pDesc->SampleDesc.Count,
+              pDesc->StreamOutput.NumEntries);
+      for (UINT i = 0; i < pDesc->NumRenderTargets && i < 8; i++)
+        fprintf(f, "rt %u fmt %d\n", i, (int)pDesc->RTVFormats[i]);
+      for (UINT i = 0; i < pDesc->InputLayout.NumElements; i++) {
+        auto &e = pDesc->InputLayout.pInputElementDescs[i];
+        fprintf(f, "in %s %u fmt %d slot %u off %u class %d step %u\n", e.SemanticName, e.SemanticIndex, (int)e.Format,
+                e.InputSlot, e.AlignedByteOffset, (int)e.InputSlotClass, e.InstanceDataStepRate);
+      }
+      fclose(f);
+    }
+  }
