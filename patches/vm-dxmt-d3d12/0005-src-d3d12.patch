diff --git a/src/d3d12/d3d12.cpp b/src/d3d12/d3d12.cpp
index aacf63d..3773716 100644
--- a/src/d3d12/d3d12.cpp
+++ b/src/d3d12/d3d12.cpp
@@ -25,8 +25,26 @@
 
 namespace dxmt {
 
+// Exit diagnostics deliberately avoid Logger/CRT locks during loader teardown.
+static bool ember_exit_trace = false;
+
 Logger Logger::s_instance("d3d12.log");
 
+#ifdef EMBER_NATIVE
+#include <dlfcn.h>
+/* COM 객체의 vtable 이 이 이미지(libember-d3d12-native.dylib) 안에 있으면 우리 객체 */
+static bool
+EmberNativeIsOwnObject(IUnknown *object) {
+  if (!object)
+    return false;
+  const void *vtbl = *reinterpret_cast<void *const *>(object);
+  Dl_info mine, theirs;
+  if (!dladdr((const void *)&EmberNativeIsOwnObject, &mine) || !dladdr(vtbl, &theirs))
+    return false;
+  return mine.dli_fbase == theirs.dli_fbase;
+}
+#endif
+
 extern "C" HRESULT WINAPI
 D3D12CreateDevice(IUnknown *pAdapter, D3D_FEATURE_LEVEL MinimumFeatureLevel, REFIID riid, void **ppDevice) {
 
@@ -52,6 +70,15 @@ D3D12CreateDevice(IUnknown *pAdapter, D3D_FEATURE_LEVEL MinimumFeatureLevel, REF
       return hr;
     }
   } else {
+#ifdef EMBER_NATIVE
+    /* 10-28 vmd3d12: VM 호스트에선 같은 프로세스에 UTM libdxmt-native 의 dxgi 도 있다. 그 어댑터도 같은 IID 의
+     * IMTLDXGIAdapter 를 돌려주지만 객체 모양이 달라 그대로 쓰면 튕긴다. IID 가 아니라 '우리 이미지의 vtable'
+     * 인지로 가린다(dxgi 가 이 dylib 안에 들어 있음). 남의 것이면 거절 → 게스트 Triton 이 기본 어댑터로 다시 시도. */
+    if (!EmberNativeIsOwnObject(pAdapter)) {
+      WARN("D3D12CreateDevice: foreign adapter rejected (not from this image)");
+      return DXGI_ERROR_UNSUPPORTED;
+    }
+#endif
     dxgi_adapter = com_cast<IDXGIAdapter>(pAdapter);
   }
 
@@ -78,13 +105,29 @@ D3D12GetDebugInterface(REFIID iid, void **debug) {
   return E_NOINTERFACE;
 }
 
-BOOL WINAPI
+extern "C" BOOL WINAPI
 DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved) {
+  if (reason == DLL_PROCESS_ATTACH) {
+    char value[2] = {};
+    ember_exit_trace = GetEnvironmentVariableA("EMBER_D12_EXIT_TRACE", value, sizeof(value)) == 1 && value[0] == '1';
+    if (ember_exit_trace) {
+      const char line[] = "ember-d12-exit: process-attach\n";
+      DWORD written;
+      WriteFile(GetStdHandle(STD_ERROR_HANDLE), line, sizeof(line) - 1, &written, nullptr);
+    }
+  }
+  if (reason == DLL_PROCESS_DETACH && ember_exit_trace) {
+    const char *line = reserved ? "ember-d12-exit: process-detach\n" : "ember-d12-exit: module-unload\n";
+    DWORD written;
+    WriteFile(GetStdHandle(STD_ERROR_HANDLE), line, reserved ? 31 : 30, &written, nullptr);
+  }
   if (reason != DLL_PROCESS_ATTACH)
     return TRUE;
 
-  DisableThreadLibraryCalls(instance);
+  // The previous effective entry point was the CRT default stub.
+  // Keep its thread-notification behavior; this candidate only enables tracing.
+  (void)instance;
   return TRUE;
 }
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
