diff --git a/src/d3d12/d3d12_multiple_fence.hpp b/src/d3d12/d3d12_multiple_fence.hpp
new file mode 100644
index 0000000..b409eef
--- /dev/null
+++ b/src/d3d12/d3d12_multiple_fence.hpp
@@ -0,0 +1,77 @@
+// Multiple-fence waits use the same software completion timeline as single
+// fence waits. No worker thread, OS wait-object limit, or COM reference cycle.
+#pragma once
+#include "ember_reblack_completion.hpp"
+#include <new>
+
+namespace dxmt {
+class EmberMultipleFenceNotification final : public EmberCompletionNotification {
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  uint64_t remaining_;
+  HANDLE event_;
+  bool armed_ = false;
+  bool canceled_ = false;
+  bool finished_ = false;
+
+  void finishLocked() noexcept {
+    if (!armed_ || canceled_ || finished_ || remaining_) return;
+    finished_ = true;
+    if (event_) SetEvent(event_);
+    cv_.notify_all();
+  }
+
+public:
+  EmberMultipleFenceNotification(uint64_t count, HANDLE event) : remaining_(count), event_(event) {}
+
+  void complete() noexcept override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (remaining_) --remaining_;
+    finishLocked();
+  }
+
+  void arm() noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    armed_ = true;
+    finishLocked();
+  }
+
+  void cancel() noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    canceled_ = true;
+  }
+
+  void wait() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [&] { return finished_; });
+  }
+};
+
+inline HRESULT EmberSetEventOnMultipleFenceCompletion(
+    ID3D12Fence *const *fences, const UINT64 *values, UINT count,
+    D3D12_MULTIPLE_FENCE_WAIT_FLAGS flags, HANDLE event) {
+  if (!count || !fences || !values ||
+      (flags != D3D12_MULTIPLE_FENCE_WAIT_FLAG_ALL && flags != D3D12_MULTIPLE_FENCE_WAIT_FLAG_ANY))
+    return E_INVALIDARG;
+  for (UINT i = 0; i < count; ++i)
+    if (!fences[i]) return E_INVALIDARG;
+
+  std::shared_ptr<EmberMultipleFenceNotification> notification;
+  try {
+    notification = std::make_shared<EmberMultipleFenceNotification>(
+        flags == D3D12_MULTIPLE_FENCE_WAIT_FLAG_ALL ? count : 1, event);
+    for (UINT i = 0; i < count; ++i) {
+      auto *fence = static_cast<MTLD3D12Fence *>(fences[i]);
+      EmberCompletion(fence->fence.ptr())->setNotification(values[i], notification);
+    }
+  } catch (const std::bad_alloc &) {
+    // No event is signaled until every registration has succeeded. Callbacks
+    // already registered keep only this canceled state, never a caller pointer.
+    if (notification) notification->cancel();
+    return E_OUTOFMEMORY;
+  }
+  notification->arm();
+  if (!event) notification->wait();
+  return S_OK;
+}
+}
diff --git a/src/d3d12/d3d12_native_embedder.cpp b/src/d3d12/d3d12_native_embedder.cpp
new file mode 100644
index 0000000..a8e2077
--- /dev/null
+++ b/src/d3d12/d3d12_native_embedder.cpp
@@ -0,0 +1,115 @@
+/*
+ * Ember vmd3d12-1027(10-28): libember-d3d12-native.dylib 의 directx-native embedder API.
+ * Neptune(virglrenderer)이 D3D12 경로에서 쓰는 이벤트·공유 핸들 함수 — 접두 dxmt_ (UTM libdxmt-native 와 같은 규약).
+ * 이 이미지가 만든 이벤트·서술자는 이 이미지의 함수로만 닫는다(directx-native 사본은 이미지마다 따로).
+ */
+#ifndef _WIN32
+#include <stdlib.h>
+#include <unistd.h>
+#include <directx-native/dxn_embedder.h>
+#include <directx-native/dxn_event.h>
+#include <directx-native/dxn_shared.h>
+#include "winemetal.h"
+#include "ember_dxil_thunks.h"
+#include <dlfcn.h>
+#include <sys/mman.h>
+#include "d3d12_device.hpp"
+
+extern "C" {
+
+DXN_DEFINE_NATIVE_ABI_VERSION(dxmt_)
+
+__attribute__((visibility("default"))) void *
+dxmt_event_create(int manual_reset, int initial_state) {
+  return dxn_event_create(manual_reset, initial_state);
+}
+
+__attribute__((visibility("default"))) void
+dxmt_event_close(void *handle) {
+  dxn_event_close(handle);
+}
+
+__attribute__((visibility("default"))) int
+dxmt_event_dup_fd(void *handle) {
+  return dxn_event_dup_fd(handle);
+}
+
+__attribute__((visibility("default"))) dxn_wait_status
+dxmt_event_wait(void *handle, uint64_t timeout_ns) {
+  return dxn_event_wait(handle, timeout_ns);
+}
+
+/* CreateSharedHandle(NT 형) 서술자 닫기: 서술자가 가진 fd 를 닫고 메모리를 푼다. */
+__attribute__((visibility("default"))) int
+dxmt_shared_handle_close(void *handle) {
+  if (!handle)
+    return -1;
+  auto *hdr = static_cast<dxn_shared_header *>(handle);
+  if (hdr->magic != DXN_SHARED_TEXTURE_MAGIC && hdr->magic != DXN_SHARED_BUFFER_MAGIC &&
+      hdr->magic != DXN_SHARED_FENCE_MAGIC)
+    return -1;
+  if (hdr->fd >= 0)
+    close(hdr->fd);
+  hdr->magic = 0;
+  free(handle);
+  return 0;
+}
+
+/* 10-28 vmd3d12: Neptune CREATE_HEAP_FROM_SHMEM — 게스트 shm 블롭 창(fd 의 offset 부터 size)을 ID3D12Heap 으로.
+ * 게스트의 지속 Map 포인터와 GPU 가 같은 페이지를 본다(UPLOAD/READBACK 복사 없음). fd 는 가져가지 않는다.
+ * 매핑은 힙이 가지고 힙이 죽을 때 푼다(그 위 버퍼·텍스처는 힙을 붙잡는다). */
+static bool
+ember_is_own_object(void *object) {
+  if (!object)
+    return false;
+  const void *vtbl = *static_cast<void *const *>(object);
+  Dl_info mine, theirs;
+  if (!dladdr((const void *)&ember_is_own_object, &mine) || !dladdr(vtbl, &theirs))
+    return false;
+  return mine.dli_fbase == theirs.dli_fbase;
+}
+
+__attribute__((visibility("default"))) int32_t
+dxmt_open_existing_heap_from_fd(void *device, int fd, uint64_t offset, uint64_t size, uint32_t heap_type,
+                                uint32_t heap_flags, const void *iid, void **heap) {
+  if (heap)
+    *heap = nullptr;
+  if (!device || fd < 0 || !size || !iid || !heap || !ember_is_own_object(device))
+    return (int32_t)E_INVALIDARG;
+  const uint64_t page = (uint64_t)getpagesize();
+  if (offset % page) {
+    dxmt::Logger::err("ember-d12: open_existing_heap_from_fd: offset not page aligned");
+    return (int32_t)E_INVALIDARG;
+  }
+  const size_t maplen = (size_t)((size + page - 1) / page * page);
+  void *base = mmap(nullptr, maplen, PROT_READ | PROT_WRITE, MAP_SHARED, fd, (off_t)offset);
+  if (base == MAP_FAILED)
+    return (int32_t)E_OUTOFMEMORY;
+  D3D12_HEAP_DESC desc = {};
+  desc.SizeInBytes = size;
+  desc.Properties.Type = (D3D12_HEAP_TYPE)heap_type;
+  if (desc.Properties.Type == D3D12_HEAP_TYPE_CUSTOM) {
+    desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_BACK;
+    desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+  }
+  desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+  desc.Flags = (D3D12_HEAP_FLAGS)heap_flags;
+  auto *dev = static_cast<dxmt::MTLD3D12Device *>(static_cast<ID3D12Device *>(device));
+  /* 매핑 소유권은 힙 객체로 넘어간다(QI 실패로 힙이 바로 죽어도 그 소멸자가 munmap) */
+  return (int32_t)dxmt::CreateExternalHeap(dev, &desc, base, size, maplen, *static_cast<const IID *>(iid), heap);
+}
+
+/* Neptune capset: DXIL(SM6) 을 받을 수 있나 = 애플 MSC(libmetalirconverter) 를 찾았나 */
+__attribute__((visibility("default"))) int
+dxmt_d3d12_dxil_supported(void) {
+  return EmberDXIL_available() ? 1 : 0;
+}
+
+/* Neptune 이 'Ember d3d12 덩어리'인지 알아보는 표식(UTM libdxmt-native 에는 없음) */
+__attribute__((visibility("default"))) uint32_t
+dxmt_d3d12_is_ember(void) {
+  return 0x454d4231u; /* 'EMB1' */
+}
+
+} // extern "C"
+#endif
