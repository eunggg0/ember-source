+  if (!lock.owns_lock()) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 1, id);
+    return;
+  }
+  auto existing = trace_descriptor_heaps.find(id);
+  if (existing == trace_descriptor_heaps.end() && trace_descriptor_heaps.size() >= kTraceHeapLimit) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 3, id, kTraceHeapLimit);
+    return;
+  }
+  if (existing != trace_descriptor_heaps.end())
+    trace_descriptor_slot_count -= existing->second.slots.size();
+  uint64_t generation = trace_descriptor_generation.fetch_add(1);
+  trace_descriptor_heaps[id] = {base, count, ir_handle, ir_base, generation, type};
+  EmberD12Trace(TraceKind::Heap, 0, 0, 0, 0, id, base, ir_handle, count, generation, type, ir_base, 1);
+  } catch (...) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 7, id);
+  }
+}
+void TraceHeapDestroy(uint64_t id) noexcept {
+  try {
+  std::unique_lock<std::mutex> lock(trace_descriptor_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 1, id);
+    return;
+  }
+  auto it = trace_descriptor_heaps.find(id);
+  if (it != trace_descriptor_heaps.end()) {
+    EmberD12Trace(TraceKind::Heap, 0, 0, 0, 0, id, it->second.base, it->second.ir_handle,
+                  it->second.count, it->second.incarnation, it->second.type, it->second.ir_base, 2);
+    trace_descriptor_slot_count -= it->second.slots.size();
+    trace_descriptor_heaps.erase(it);
+  }
+  } catch (...) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 7, id);
+  }
+}
+uint64_t TraceDescriptorAllocation(const ShaderVisibleDescriptorCPUStorage &cpu) {
+  switch (cpu.type) {
+  case ShaderVisibleDescriptorType::SRVTexture: return (uintptr_t)cpu.SRVTexture.texture->current();
+  case ShaderVisibleDescriptorType::UAVTexture: return (uintptr_t)cpu.UAVTexture.texture->current();
+  case ShaderVisibleDescriptorType::UAVTexelBuffer: return (uintptr_t)cpu.UAVTexelBuffer.buffer->current();
+  case ShaderVisibleDescriptorType::SRVTexelBuffer: return (uintptr_t)cpu.SRVTexelBuffer.buffer->current();
+  case ShaderVisibleDescriptorType::UAVBuffer: return cpu.UAVBuffer.buffer ? (uintptr_t)cpu.UAVBuffer.buffer->current() : 0;
+  case ShaderVisibleDescriptorType::SRVBuffer: return cpu.SRVBuffer.buffer ? (uintptr_t)cpu.SRVBuffer.buffer->current() : 0;
+  default: return 0;
+  }
+}
+void TraceDescriptorPublish(uint64_t id, uint64_t index, IRDescEntry ir, const void *raw, uint64_t type, uint64_t allocation = 0, uint64_t source = 0, uint64_t source_index = 0) noexcept {
+  try {
+  std::unique_lock<std::mutex> lock(trace_descriptor_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 1, id, index);
+    return;
+  }
+  auto it = trace_descriptor_heaps.find(id);
+  if (it == trace_descriptor_heaps.end()) {
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 2, id, index);
+    return;
+  }
+  auto &heap = it->second;
+  uint64_t generation = trace_descriptor_generation.fetch_add(1);
+  if (source) {
+    auto from = trace_descriptor_heaps.find(source);
+    if (from != trace_descriptor_heaps.end()) {
+      auto slot = from->second.slots.find(source_index);
+      if (slot != from->second.slots.end())
+        allocation = slot->second.allocation;
+    }
+  }
+  TraceDescriptorSlot slot{ir, {}, generation, type, allocation};
+  memcpy(slot.raw, raw, sizeof(slot.raw));
+  if (allocation)
+    EmberD12Trace(TraceKind::ResourceView, 0, 0, 0, 0, allocation, ir.textureViewID, ir.gpuVA, id, index, generation);
+  EmberD12Trace(TraceKind::Descriptor, 0, 0, 0, 0, id, heap.base, index, generation,
+                ir.gpuVA, ir.textureViewID, ir.metadata, type);
+  EmberD12Trace(TraceKind::DescriptorWrite, 0, 0, 0, 0, id, heap.base, index, generation,
+                slot.raw[0], slot.raw[1], slot.raw[2], slot.raw[3]);
+  heap.version = generation;
+  bool exists = heap.slots.count(index);
+  if (exists || (heap.slots.size() < kTraceDescriptorLimit && trace_descriptor_slot_count < kTraceTotalSlotLimit)) {
+    heap.slots[index] = slot;
+    if (!exists)
+      ++trace_descriptor_slot_count;
+  } else {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 3, id, index, kTraceDescriptorLimit);
+  }
+  } catch (...) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 7, id, index);
+  }
+}
+} // namespace
+
+void
+EmberTraceDescriptorSnapshot(uint64_t value, bool is_handle, uint64_t queue, uint64_t cb, uint64_t encoder, uint64_t dispatch) {
+  try {
+  if (!value)
+    return;
+  std::unique_lock<std::mutex> lock(trace_descriptor_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 1, value);
+    return;
+  }
+  for (auto &[id, heap] : trace_descriptor_heaps) {
+    if (is_handle ? heap.ir_handle != value : (!heap.base || value < heap.base || (value - heap.base) / 32 >= heap.count))
+      continue;
+    uint64_t index = is_handle ? 0 : (value - heap.base) / 32;
+    EmberD12Trace(TraceKind::Binding, queue, cb, encoder, dispatch, id, heap.base, index,
+                  heap.incarnation, heap.version, heap.ir_handle, heap.type, is_handle);
+    // Repeated bindings in one CB refer to this same versioned snapshot.
+    if (heap.last_queue != queue || heap.last_cb != cb || heap.last_version != heap.version) {
+      heap.last_queue = queue; heap.last_cb = cb; heap.last_version = heap.version;
+      for (const auto &[i, slot] : heap.slots) {
+        if (slot.allocation)
+          EmberD12Trace(TraceKind::ResourceView, queue, cb, encoder, dispatch, slot.allocation, slot.ir.textureViewID, slot.ir.gpuVA, id, i, slot.generation);
+        EmberD12Trace(TraceKind::Descriptor, queue, cb, encoder, dispatch, id, heap.base, i, slot.generation,
+                      slot.ir.gpuVA, slot.ir.textureViewID, slot.ir.metadata, slot.type);
+        EmberD12Trace(TraceKind::DescriptorWrite, queue, cb, encoder, dispatch, id, heap.base, i, slot.generation,
+                      slot.raw[0], slot.raw[1], slot.raw[2], slot.raw[3]);
+      }
+      // Unpublished/uninitialized slots have no trustworthy shadow value.
+      if (heap.slots.size() < heap.count)
+        EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 4, id, heap.count, heap.slots.size());
+    }
+    if (auto losses = trace_descriptor_losses.load())
+      EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 5, id, losses);
+    return;
+  }
+  EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 2, value, is_handle);
+  } catch (...) {
+    EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 7, value);
+  }
+}
+
+/* IR 은 2D·2DMS·큐브 텍스처를 배열형(texture2d_array·texture2d_ms_array·texturecube_array)으로 읽는다
+ * (Texture1D 도 2D 배열, 3D 는 그대로 — 실측: irprobe). DXMT 자체 셰이더는 비배열 뷰를 쓰므로 IR 칸에만 배열 뷰를 넣는다. */
+static uint64_t
+IRTextureResourceID(Texture *texture, TextureViewKey view) {
+  switch (texture->textureType(view)) {
+  case WMTTextureType2D:
+  case WMTTextureType2DMultisample:
+  case WMTTextureTypeCube:
+    return texture->view(texture->checkViewUseArray(view, true)).gpuResourceID;
+  default:
+    return texture->view(view).gpuResourceID;
+  }
+}
+
+/* 형식 있는 버퍼(Buffer<float4> 등): IR 은 텍스처 버퍼 뷰를 0 번부터 읽는다(메타데이터의 요소 오프셋은 안 본다 — 실측).
+ * FirstElement 가 있으면 그 자리(16바이트 정렬)에서 시작하는 뷰를 따로 만들어 칸에 붙여 둔다. */
+static IRDescEntry
+IRTexelEntry(
+    Buffer *buffer, const BufferView &whole, const BufferSlice &Slice, bool uav,
+    WMT::Reference<WMT::Texture> &keep
+) {
+  keep = {};
+  uint64_t va = buffer->current()->gpuAddress() + Slice.byteOffset;
+  if (!Slice.firstElement)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  auto format = const_cast<BufferView &>(whole).texture.pixelFormat();
+  uint64_t texel = MTLGetTexelSize(format);
+  uint64_t aligned = Slice.byteOffset & ~15ull;
+  uint64_t rem = texel ? (Slice.byteOffset - aligned) / texel : 0;
+  if (rem) {
+    static bool warned = false;
+    if (!warned) {
+      warned = true;
+      WARN("Ember DXIL: typed buffer view offset not 16-byte aligned (", Slice.byteOffset, "), off by ", rem, " elements");
+    }
+  }
+  auto allocation = buffer->current();
+  WMTTextureInfo info;
+  info.type = WMTTextureTypeTextureBuffer;
+  uint64_t length = Slice.byteLength + (Slice.byteOffset - aligned);
+  info.width = texel ? length / texel : 0;
+  info.height = 1;
+  info.depth = 1;
+  info.array_length = 1;
+  info.mipmap_level_count = 1;
+  info.sample_count = 1;
+  info.pixel_format = format;
+  info.options = allocation->options();
+  auto usage = WMTTextureUsageShaderRead;
+  if (uav) {
+    usage |= WMTTextureUsageShaderWrite;
+    if (format == WMTPixelFormatR32Uint || format == WMTPixelFormatR32Sint)
+      usage |= WMTTextureUsageShaderAtomic;
+  }
+  info.usage = usage;
+  if (!info.width)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  keep = allocation->buffer().newTexture(info, aligned, length);
+  if (!keep)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  return {va, info.gpu_resource_id, IRBufferMetadata(Slice.byteLength, (uint32_t)rem, true)};
+}
+
+uint64_t
+EmberTranslateDescriptorTableVA(uint64_t va) {
+  if (!va)
+    return 0;
+  std::unique_lock<dxmt::mutex> lock(ir_registry_lock);
+  auto it = ir_registry.upper_bound(va);
+  if (it == ir_registry.begin())
+    return 0;
+  --it;
+  uint64_t index = (va - it->first) / 32; /* DXMT 서술자 크기 = 32 */
+  if (index >= it->second.count + 1)
+    return 0;
+  return it->second.ir_base + index * sizeof(IRDescEntry);
+}
