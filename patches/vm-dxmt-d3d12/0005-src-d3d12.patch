new file mode 100644
index 0000000..fe32e68
--- /dev/null
+++ b/src/d3d12/d3d12_ember_wait_guard.hpp
@@ -0,0 +1,22 @@
+// Ember-only incident mitigation. Same LGPL terms as the enclosing DXMT source.
+#pragma once
+#include <chrono>
+#include <cstdint>
+namespace dxmt::ember {
+constexpr unsigned kWaitGuardMs = 2000;
+// Tracks outstanding committed work, not CPU pipeline compilation or idle time.
+class QueueProgress {
+  using Clock = std::chrono::steady_clock;
+  bool pending_ = false;
+  uint64_t done_ = 0;
+  Clock::time_point since_{};
+public:
+  bool expired(uint64_t submitted, uint64_t done, Clock::time_point now) {
+    if (done >= submitted) { pending_ = false; return false; }
+    if (!pending_ || done != done_) {
+      pending_ = true; done_ = done; since_ = now; return false;
+    }
+    return now - since_ >= std::chrono::milliseconds(kWaitGuardMs);
+  }
+};
+}
