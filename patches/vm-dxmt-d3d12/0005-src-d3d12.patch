@@ -0,0 +1,125 @@
+#pragma once
+/* Ember(wukong-1106): DXBC(SM5) 셰이더의 장치 범위 메모리 일관성.
+ * D3D12 경로는 airconv 를 Metal 3.1 로 고정해 두었다. 3.1 에서 airconv 는 globallycoherent UAV 접근을 일반 접근으로 만들고,
+ * 실행 장벽 없는 DeviceMemoryBarrier(sync_uglobal)는 아무 명령도 내지 않는다(SupportsMemoryCoherency·
+ * SupportsNonExecutionBarrier 가 3.2 부터). 그래서 다른 스레드 그룹이 쓴 값을 돌며 기다리는 계산 셰이더(지속 스레드
+ * 작업 큐 — 1440 그룹 컬링 등)가 낡은 캐시 값만 읽어 끝나지 않는다 → 명령 버퍼가 GPU 에서 안 끝남 → 0xD12E0002.
+ * D3D11 경로는 이미 장치 Metal 판(macOS 15+ 이면 3.2)을 쓴다.
+ * 고침: 파이프라인의 DXBC 단계 중 그 꼴(dcl_uav_* globallycoherent 표시, 또는 sync 의 UAV 전역 메모리 표시)을 실제로
+ * 쓰는 것이 있을 때만 그 파이프라인을 3.2 로 변환한다. 그런 셰이더가 없는 파이프라인의 출력은 예전과 바이트가 같다.
+ * airconv(winemetal.so)는 바꾸지 않는다 — 3.2 경로는 D3D11 이 쓰는 것과 같다. 그래서 어느 so 와도 짝이 된다.
+ * EMBER_D12_DXBC_COHERENCY=0 이면 예전(늘 3.1). 기본 켬. macOS 15 미만·Apple7 미만이면 꺼짐(dxmt_device.cpp 와 같은 조건). */
+#include "d3d12.h"
+#include "airconv_public.h"
+#include "d3d12_ember_opts.hpp"
+#include "Metal.hpp"
+#include "log/log.hpp"
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+
+namespace dxmt {
+
+/* DXBC 컨테이너의 SHEX/SHDR 토큰을 훑는다(읽기만, 범위 검사).
+ * 비트: 1 = globallycoherent UAV, 2 = sync_uglobal, 4 = loop, 8 = SV_DispatchThreadID·SV_GroupID 입력(vThreadID·vThreadGroupID) */
+constexpr unsigned kEmberDxbcGlc = 1, kEmberDxbcUglobal = 2, kEmberDxbcLoop = 4, kEmberDxbcGroupId = 8;
+inline unsigned
+EmberDxbcScan(const void *code, size_t size) {
+  auto *b = static_cast<const uint8_t *>(code);
+  auto rd = [&](size_t off) -> uint32_t {
+    uint32_t v;
+    std::memcpy(&v, b + off, 4);
+    return v;
+  };
+  if (!b || size < 32 || std::memcmp(b, "DXBC", 4) != 0)
+    return 0;
+  const uint32_t chunks = rd(28);
+  if (chunks > 64 || 32 + (size_t)chunks * 4 > size)
+    return 0;
+  for (uint32_t i = 0; i < chunks; i++) {
+    const size_t off = rd(32 + i * 4);
+    if (off + 8 > size)
+      return 0;
+    if (std::memcmp(b + off, "SHEX", 4) != 0 && std::memcmp(b + off, "SHDR", 4) != 0)
+      continue;
+    const size_t csize = rd(off + 4);
+    if (off + 8 + csize > size || csize < 8)
+      return 0;
+    const size_t base = off + 8, ntok = csize / 4;
+    unsigned use = 0;
+    for (size_t p = 2; p < ntok;) {
+      const uint32_t t = rd(base + p * 4), op = t & 0x7ff;
+      size_t len = op == 0x35 /* CUSTOMDATA */ ? (p + 1 < ntok ? rd(base + (p + 1) * 4) : 0) : (t >> 24) & 0x7f;
+      if (len == 0)
+        break;
+      if ((op == 156 || op == 157 || op == 158) && (t & 0x10000)) /* dcl_uav_typed/raw/structured + GLOBALLY_COHERENT */
+        use |= kEmberDxbcGlc;
+      else if (op == 190 && (t & 0x4000)) /* sync + UAV_MEMORY_GLOBAL */
+        use |= kEmberDxbcUglobal;
+      else if (op == 48) /* loop */
+        use |= kEmberDxbcLoop;
+      else if (op == 95 && p + 1 < ntok) { /* dcl_input: 피연산자 종류 0x20 vThreadID, 0x21 vThreadGroupID */
+        const uint32_t ty = (rd(base + (p + 1) * 4) >> 12) & 0xff;
+        if (ty == 0x20 || ty == 0x21)
+          use |= kEmberDxbcGroupId;
+      }
+      p += len;
+    }
+    return use;
+  }
+  return 0;
+}
+inline unsigned
+EmberDxbcCoherencyUse(const void *code, size_t size) {
+  return EmberDxbcScan(code, size) & (kEmberDxbcGlc | kEmberDxbcUglobal);
+}
+
+/* Ember(wukong-1106) EMBER_D12_PERSISTENT_CAP=N (기본 0 = 끔): "지속 스레드" 꼴 DXBC CS 의 1차원 직접 디스패치를 N 그룹으로 줄인다.
+ * 꼴 = globallycoherent UAV + DeviceMemoryBarrier(sync_uglobal) + loop, 그리고 SV_GroupID·SV_DispatchThreadID 를 안 읽음
+ * (그룹끼리 구별할 수 없고, 원자 작업 큐를 돌며 일을 가져가는 커널). PC GPU 가 한꺼번에 띄울 수 있다고 보고 잡은 그룹 수(예: 1440×64)가
+ * Apple GPU 의 동시 상주 수보다 훨씬 많으면, 상주 못 한 그룹을 기다리며 명령 버퍼 하나가 1~12초 걸린다(0xD12E0002).
+ * 그룹 수를 바꾸는 것이라 D3D12 동작과 같다고 증명할 수 없다 → 스위치. 그룹 수를 일의 양으로 쓰는 커널에 걸리면 결과가 틀린다. */
+inline uint32_t
+EmberDxbcPersistentCap(const void *code, size_t size) {
+  static const int n = EmberD12OptInt("EMBER_D12_PERSISTENT_CAP", 0);
+  if (n <= 0)
+    return 0;
+  const unsigned s = EmberDxbcScan(code, size);
+  constexpr unsigned need = kEmberDxbcGlc | kEmberDxbcUglobal | kEmberDxbcLoop;
+  if ((s & need) != need || (s & kEmberDxbcGroupId))
+    return 0;
+  return (uint32_t)n;
+}
+
+inline bool
+EmberDxbcCoherencyOn(WMT::Device device) {
+  static const bool on = [&] {
+    if (EmberD12OptInt("EMBER_D12_DXBC_COHERENCY", 1) == 0)
+      return false;
+    uint64_t major = 0, minor = 0;
+    WMTGetOSVersion(&major, &minor, nullptr);
+    return major >= 15 && device.supportsFamily(WMTGPUFamilyApple7);
+  }();
+  return on;
+}
+
+/* 파이프라인의 DXBC 단계들 → airconv metal_version */
+inline SM50_SHADER_METAL_VERSION
+EmberDxbcMetalVersion(WMT::Device device, const char *what, std::initializer_list<D3D12_SHADER_BYTECODE> stages) {
+  if (!EmberDxbcCoherencyOn(device))
+    return SM50_SHADER_METAL_310;
+  unsigned use = 0;
+  for (auto &s : stages)
+    if (s.pShaderBytecode)
+      use |= EmberDxbcCoherencyUse(s.pShaderBytecode, s.BytecodeLength);
+  if (!use)
+    return SM50_SHADER_METAL_310;
+  static std::atomic<unsigned> n{0};
+  if (n.fetch_add(1) < 16)
+    WARN("ember-d12: DXBC ", what, " uses ", (use & 1) ? "globallycoherent UAV" : "", use == 3 ? " + " : "",
+         (use & 2) ? "DeviceMemoryBarrier" : "", " — Metal 3.2 (device-coherent access, device-scope fence)");
+  return SM50_SHADER_METAL_320;
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_ei_guard.hpp b/src/d3d12/d3d12_ember_ei_guard.hpp
new file mode 100644
index 0000000..9d0a726
--- /dev/null
+++ b/src/d3d12/d3d12_ember_ei_guard.hpp
@@ -0,0 +1,29 @@
+// Private Ember incident candidate; LGPL-2.1-or-later, like the adjacent code.
+#pragma once
+#include <cstdint>
+namespace ember {
+// Validate bytes actually read, using subtraction to avoid offset+span wrap.
+inline bool EIReadRange(uint64_t length, uint64_t offset, uint64_t count,
+                        uint64_t stride, uint64_t bytes) {
+  if (!count) return true;
+  if (!bytes || (offset & 3) || (stride & 3) || stride < bytes || offset > length)
+    return false;
+  const auto left = length - offset;
+  return bytes <= left && count - 1 <= (left - bytes) / stride;
+}
+inline bool EIHeapFits(uint64_t previous, uint64_t aligned, uint64_t length, uint64_t size) {
+  return aligned >= previous && aligned < size && length < size - aligned;
+}
+// This exact MSL body is also compiled as C++ by the CPU sanitizer test.
+inline constexpr char kEIClampBody[] = R"EI(
+if (i >= d.max_count) return;
+uint count = min(d.count_buf[0], d.max_count);
+device uint *o = d.dst + ulong(i) * d.arg_words;
+if (i >= count) {
+  for (uint w = 0; w < d.arg_words; ++w) o[w] = 0u;
+  return;
+}
+device uint *s = d.src + ulong(i) * d.stride_words;
+for (uint w = 0; w < d.arg_words; ++w) o[w] = s[w];
+)EI";
+} // namespace ember
diff --git a/src/d3d12/d3d12_ember_opts.hpp b/src/d3d12/d3d12_ember_opts.hpp
new file mode 100644
index 0000000..cce0be7
--- /dev/null
+++ b/src/d3d12/d3d12_ember_opts.hpp
@@ -0,0 +1,110 @@
+#pragma once
+/* Ember: D3D12 실험·진단 스위치. 먼저 환경 변수, 없으면 보틀의 C:\ember-d12.cfg (한 줄에 NAME=VALUE).
+ * 스팀처럼 이미 떠 있는 런처가 게임을 띄우면 Ember 가 넘기는 환경 변수 목록에 없는 값은 게임까지 안 간다 —
+ * 그래서 시험용으로 파일도 읽는다. 파일이 없으면 기본값(제품 동작)이다. */
+#include "util_env.hpp"
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <string>
+#include <atomic>
+#include <cstdint>
+
+namespace dxmt {
+
+inline std::string
+EmberD12Opt(const char *name) {
+  auto v = env::getEnvVar(name);
+  if (!v.empty())
+    return v;
+  static std::string file = []() {
+    std::string out;
+    if (FILE *f = fopen("C:\\ember-d12.cfg", "rb")) {
+      char buf[4096];
+      size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+      buf[n] = 0;
+      out = buf;
+      fclose(f);
+    }
+    return out;
+  }();
+  size_t len = strlen(name);
+  size_t pos = 0;
+  while (pos < file.size()) {
+    size_t eol = file.find_first_of("\r\n", pos);
+    if (eol == std::string::npos)
+      eol = file.size();
+    if (eol - pos > len && file.compare(pos, len, name) == 0 && file[pos + len] == '=')
+      return file.substr(pos + len + 1, eol - pos - len - 1);
+    pos = eol + 1;
+  }
+  return {};
+}
+
+inline int
+EmberD12OptInt(const char *name, int def) {
+  auto v = EmberD12Opt(name);
+  return v.empty() ? def : atoi(v.c_str());
+}
+
+/* Ember: GPU 전용 텍스처·힙을 private 저장으로(기본 켬). EMBER_D12_TEX_PRIVATE=0 이면 예전처럼 전부 shared. */
+inline bool
+EmberD12TexturePrivate() {
+  static bool v = EmberD12OptInt("EMBER_D12_TEX_PRIVATE", 1) != 0;
+  return v;
+}
+
+/* Ember(d12games4): 타일·힙 진단 로그(EMBER_D12_TLOG=1) — CreateHeap·CreatePlacedResource·CreateReservedResource·
+ * GetResourceTiling·GetResourceAllocationInfo·UpdateTileMappings(지역·범위 전부) */
+inline bool
+EmberD12TileLog() {
+  static bool v = EmberD12OptInt("EMBER_D12_TLOG", 0) != 0;
+  return v;
+}
+
+/* Ember(d12games4): 명령 목록 호출 수(EMBER_D12_CALLSTAT=N: N Present 마다 기록) — 게임이 무엇을 그리고 올리는지 */
+enum EmberCallStat {
+  kCsDraw, kCsDrawIndexed, kCsDrawDropped, kCsExecIndirect, kCsExecIndirectCount, kCsExecIndirectArgs, kCsDispatch,
+  kCsCopyBuffer, kCsCopyTexture, kCsCopyResource, kCsEclDirect, kCsEclCompute, kCsEclCopy, kCsClearRtv, kCsCount
+};
+inline std::atomic<uint64_t> g_ember_callstat[kCsCount];
+inline bool
+EmberCallStatOn() {
+  static bool v = EmberD12OptInt("EMBER_D12_CALLSTAT", 0) > 0;
+  return v;
+}
+inline void
+EmberCs(EmberCallStat k, uint64_t n = 1) {
+  if (EmberCallStatOn())
+    g_ember_callstat[k].fetch_add(n, std::memory_order_relaxed);
+}
+
+/* Ember(launch5): 장치가 못 하는 MSAA 표본 수(애플 GPU 는 8x 없음)를 할 수 있는 가장 큰 값으로 낮춘다.
+ * 위쳐 3 차세대판이 8x PSO 를 만들다 실패하면 렌더 스레드가 멈춘다. D3D12 쪽 설명(GetDesc)은 그대로 두고 Metal 자원·PSO 만 낮춘다.
+ * EMBER_D12_MSAA_CLAMP=0 이면 끔(예전처럼 그대로 넘겨 실패). */
+template <typename DeviceT>
+inline unsigned
+EmberClampSampleCount(DeviceT device, unsigned count) {
+  if (count <= 1)
+    return count;
+  static const bool on = EmberD12OptInt("EMBER_D12_MSAA_CLAMP", 1) != 0;
+  if (!on)
+    return count;
+  static std::atomic<uint8_t> cache[33];
+  if (count > 32)
+    count = 32;
+  uint8_t c = cache[count].load(std::memory_order_relaxed);
+  if (c)
+    return c;
+  unsigned n = count;
+  while (n > 1 && !device.supportsTextureSampleCount((uint8_t)n))
+    n >>= 1;
+  if (n < 1)
+    n = 1;
+  if (n != count)
+    fprintf(stderr, "warn:  ember-d12: MSAA %ux not supported by device -> %ux\n", count, n);
+  cache[count].store((uint8_t)n, std::memory_order_relaxed);
+  return n;
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_shutdown.hpp b/src/d3d12/d3d12_ember_shutdown.hpp
new file mode 100644
index 0000000..c20e20a
--- /dev/null
+++ b/src/d3d12/d3d12_ember_shutdown.hpp
@@ -0,0 +1,37 @@
+// Private Ember incident candidate; same LGPL terms as adjacent DXMT code.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace dxmt::ember {
+using ShutdownClock = std::chrono::steady_clock;
+using ShutdownDeadline = ShutdownClock::time_point;
+inline constexpr unsigned kShutdownMs = 2000;
+
+template <typename Mutex>
+bool LockBefore(Mutex &mutex, ShutdownDeadline deadline) {
+  do {
+    if (mutex.try_lock()) return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  } while (ShutdownClock::now() < deadline);
+  return false;
+}
+
+template <typename Thread>
+bool JoinBefore(Thread &thread, ShutdownDeadline deadline) {
+  if (!thread.joinable()) return true;
+  auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - ShutdownClock::now()).count();
+  return thread.join_for(left > 0 ? static_cast<uint32_t>(left) : 0);
+}
+
+// Caller holds the submission mutex. Publish the sentinel BEFORE changing the
+// wait address: atomic::wait can wake without waiting for notify_one().
+template <typename Atomic>
+void StopCollector(Atomic &stop, Atomic &sequence) {
+  stop.store(sequence.load(std::memory_order_acquire), std::memory_order_release);
+  sequence.fetch_add(1, std::memory_order_release);
+  sequence.notify_one();
+}
+} // namespace dxmt::ember
diff --git a/src/d3d12/d3d12_ember_sparse.hpp b/src/d3d12/d3d12_ember_sparse.hpp
new file mode 100644
index 0000000..63205d4
--- /dev/null
+++ b/src/d3d12/d3d12_ember_sparse.hpp
@@ -0,0 +1,181 @@
+#pragma once
+/* Ember(d12games4): D3D12 예약(타일) 자원을 Metal 4 자리잡이 희소(placement sparse) 자원으로.
+ *
+ * 자원은 메모리 없이 만들고(winemetal EmberSparse_call, 호출 158), UpdateTileMappings·CopyTileMappings 가 큐의 MTL4CommandQueue 로
+ * D3D12 힙(= Metal 자리잡이 힙, maxCompatiblePlacementSparsePageSize 64K)의 타일을 건다. 안 건 타일은 0 으로 읽히고 쓰기는 버려진다
+ * (D3D12 타일 등급 2). 실측(M4 Pro, macOS 27): 고전 MTLCommandQueue 에서 읽고 쓰기·힙 별칭·0 읽기 모두 된다. 텍스처 타일 모양은
+ * Metal sparseTileSize(64K) — D3D12 표준 타일 모양과 같다(RGBA8 128², RGBA16F 128×64, BC1 512×256 …). 작은 밉 꼬리는 Metal
+ * firstMipmapInTail·tailSizeInBytes 를 그대로 D3D12 묶음 밉(packed)으로 알린다.
+ *
+ * 타일 순서(D3D12): 배열 조각마다 [표준 밉 0..std-1 의 타일(x→y→z), 그 조각의 묶음 밉 타일]. */
+#include <cstdint>
+#include <algorithm>
+
+namespace dxmt {
+
+struct EmberSparseLayout {
+  bool on = false;
+  bool is_buffer = false;
+  uint32_t tile_w = 65536, tile_h = 1, tile_d = 1; /* 타일 모양(텍셀, 버퍼는 바이트) */
+  uint32_t width = 0, height = 1, depth = 1;       /* 밉 0 크기(텍셀) */
+  uint32_t mips = 1, slices = 1, std_mips = 1, tail_tiles = 0;
+  uint64_t total_tiles = 0;
+  uint64_t metal = 0; /* MTLBuffer / MTLTexture 핸들 */
+
+  uint32_t
+  mipW(uint32_t m) const {
+    return std::max<uint32_t>(1, width >> m);
+  }
+  uint32_t
+  mipH(uint32_t m) const {
+    return std::max<uint32_t>(1, height >> m);
+  }
+  uint32_t
+  mipD(uint32_t m) const {
+    return std::max<uint32_t>(1, depth >> m);
+  }
+  uint32_t
+  tilesW(uint32_t m) const {
+    return (mipW(m) + tile_w - 1) / tile_w;
+  }
+  uint32_t
+  tilesH(uint32_t m) const {
+    return (mipH(m) + tile_h - 1) / tile_h;
+  }
+  uint32_t
+  tilesD(uint32_t m) const {
+    return (mipD(m) + tile_d - 1) / tile_d;
+  }
+  uint64_t
+  tilesPerSlice() const {
+    uint64_t n = 0;
+    for (uint32_t m = 0; m < std_mips; m++)
+      n += (uint64_t)tilesW(m) * tilesH(m) * tilesD(m);
+    return n + tail_tiles;
+  }
+  void
+  finish() {
+    if (is_buffer) {
+      total_tiles = ((uint64_t)width + 65535) / 65536;
+      return;
+    }
+    total_tiles = tilesPerSlice() * slices;
+  }
+  /* 밉 m(표준), 조각 a 의 첫 타일 번호 */
+  uint64_t
+  startTile(uint32_t a, uint32_t m) const {
+    uint64_t n = tilesPerSlice() * a;
+    for (uint32_t i = 0; i < m && i < std_mips; i++)
+      n += (uint64_t)tilesW(i) * tilesH(i) * tilesD(i);
+    return n;
+  }
+};
+
+/* 타일 하나(D3D12 좌표 → Metal 좌표). packed 면 level = std_mips(Metal firstMipmapInTail), x = 꼬리 안 번호 */
+struct EmberSparseTile {
+  uint32_t level, slice, x, y, z;
+};
+
+/* D3D12 지역(시작 좌표 + 크기)의 타일을 순서대로 내놓는다. 범위를 벗어나면 false */
+struct EmberSparseWalker {
+  const EmberSparseLayout &L;
+  uint32_t sub, x, y, z;
+  bool box;
+  uint32_t bx0, by0, bz0, bw, bh, bd;
+  uint64_t left;
+  bool valid = true;
+
+  EmberSparseWalker(
+      const EmberSparseLayout &layout, uint32_t X, uint32_t Y, uint32_t Z, uint32_t Subresource, uint64_t num_tiles, bool use_box,
+      uint32_t w, uint32_t h, uint32_t d
+  ) :
+      L(layout),
+      sub(Subresource),
+      x(X),
+      y(Y),
+      z(Z),
+      box(use_box),
+      bx0(X),
+      by0(Y),
+      bz0(Z),
+      bw(w),
+      bh(h),
+      bd(d) {
+    left = use_box ? (uint64_t)w * h * d : num_tiles;
+    if (!L.is_buffer && packed(sub))
+      sub = slice(sub) * L.mips + L.std_mips; /* 묶음 밉은 조각마다 하나 */
+  }
+
+  uint32_t
+  mip(uint32_t s) const {
+    return s % L.mips;
+  }
+  uint32_t
+  slice(uint32_t s) const {
+    return (s / L.mips) % std::max<uint32_t>(1, L.slices);
+  }
+  bool
+  packed(uint32_t s) const {
+    return mip(s) >= L.std_mips;
+  }
+
+  bool
+  next(EmberSparseTile &t) {
+    if (!left || !valid)
+      return false;
+    if (L.is_buffer) {
+      if (x >= L.total_tiles)
+        return valid = false;
+      t = {0, 0, x, 0, 0};
+      x++;
+      left--;
+      return true;
+    }
+    uint32_t a = slice(sub), m = mip(sub);
+    if (sub / L.mips >= L.slices)
+      return valid = false;
+    if (packed(sub)) {
+      if (x >= L.tail_tiles)
+        return valid = false;
+      t = {L.std_mips, a, x, 0, 0};
+    } else {
+      if (x >= L.tilesW(m) || y >= L.tilesH(m) || z >= L.tilesD(m))
+        return valid = false;
+      t = {m, a, x, y, z};
+    }
+    left--;
+    /* 다음 */
+    if (box) {
+      if (++x >= bx0 + bw) {
+        x = bx0;
+        if (++y >= by0 + bh) {
+          y = by0;
+          ++z;
+        }
+      }
+      return true;
+    }
+    if (packed(sub)) {
+      if (++x >= L.tail_tiles) {
+        x = y = z = 0;
+        sub = (a + 1) * L.mips;
+      }
+      return true;
+    }
+    if (++x >= L.tilesW(m)) {
+      x = 0;
+      if (++y >= L.tilesH(m)) {
+        y = 0;
+        if (++z >= L.tilesD(m)) {
+          z = 0;
+          sub++;
+          if (packed(sub) && L.tail_tiles == 0)
+            sub = (a + 1) * L.mips; /* 꼬리 없음 */
+        }
+      }
+    }
+    return true;
+  }
+};
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_trace.cpp b/src/d3d12/d3d12_ember_trace.cpp
new file mode 100644
index 0000000..47bfd7d
--- /dev/null
+++ b/src/d3d12/d3d12_ember_trace.cpp
@@ -0,0 +1,169 @@
+#include "d3d12_ember_trace.hpp"
+#include "d3d12_ember_trace_ring.hpp"
+
+#include <windows.h>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cwchar>
+#include <string>
+
+namespace dxmt {
+namespace {
+
+struct TraceState {
+  ember_trace::Ring ring;
+  const std::wstring path;
+  uint64_t frequency = 0;
+  std::atomic_flag dumping = ATOMIC_FLAG_INIT;
+  bool abnormal_dump_saved = false; // Protected by dumping.
+
+  TraceState(size_t capacity, std::wstring output) : ring(capacity), path(std::move(output)) {
+    LARGE_INTEGER value{};
+    QueryPerformanceFrequency(&value);
+    frequency = static_cast<uint64_t>(value.QuadPart);
+  }
+};
+
+// Kept alive for atexit and late queue destructors. There is no DLL detach I/O.
+TraceState *state = nullptr;
+
+std::wstring
+environment(const wchar_t *name) {
+  DWORD size = GetEnvironmentVariableW(name, nullptr, 0);
+  if (!size)
+    return {};
+  std::wstring result(size, L'\0');
+  DWORD copied = GetEnvironmentVariableW(name, result.data(), size);
+  if (!copied || copied >= size)
+    return {};
+  result.resize(copied);
+  return result;
+}
+
+void
+exit_dump() {
+  EmberD12TraceDumpSlow(3, 0, 0);
+}
+
+bool
+initialize() noexcept {
+  try {
+    // Only the exact opt-in value enables tracing, and no cfg file is consulted.
+    if (environment(L"EMBER_D12_TRACE") != L"1")
+      return false;
+    size_t capacity = 65536;
+    const auto requested = environment(L"EMBER_D12_TRACE_CAPACITY");
+    if (!requested.empty()) {
+      wchar_t *end = nullptr;
+      const auto value = std::wcstoull(requested.c_str(), &end, 10);
+      if (end != requested.c_str() && *end == L'\0' && requested[0] != L'-')
+        capacity = static_cast<size_t>(std::clamp<uint64_t>(value, 4096, 1048576));
+    }
+    auto path = environment(L"EMBER_D12_TRACE_PATH");
+    if (path.empty())
+      path = L"C:\\ember-d12trace.bin";
+    state = new TraceState(capacity, std::move(path));
+    std::atexit(exit_dump);
+    return true;
+  } catch (...) {
+    // Enabling diagnostics must never turn allocation failure into a game crash.
+    return false;
+  }
+}
+
+void
+put32(unsigned char *out, uint32_t value) noexcept {
+  for (unsigned i = 0; i < 4; ++i)
+    out[i] = static_cast<unsigned char>(value >> (8 * i));
+}
+
+void
+put64(unsigned char *out, uint64_t value) noexcept {
+  for (unsigned i = 0; i < 8; ++i)
+    out[i] = static_cast<unsigned char>(value >> (8 * i));
+}
+
+bool
+write_bytes(HANDLE file, const void *bytes, DWORD size) noexcept {
+  const auto *current = static_cast<const unsigned char *>(bytes);
+  while (size) {
+    DWORD written = 0;
+    if (!WriteFile(file, current, size, &written, nullptr) || !written)
+      return false;
+    current += written;
+    size -= written;
+  }
+  return true;
+}
+
+} // namespace
+
+const bool EmberD12TraceEnabled = initialize();
+
+void
+EmberD12TraceSlow(TraceKind kind, uint64_t queue, uint64_t cb,
+                  uint64_t encoder, uint64_t dispatch, uint64_t a,
+                  uint64_t b, uint64_t c, uint64_t d, uint64_t e,
+                  uint64_t f, uint64_t g, uint64_t h) noexcept {
+  LARGE_INTEGER ticks{};
+  QueryPerformanceCounter(&ticks);
+  state->ring.write({0, static_cast<uint64_t>(ticks.QuadPart), GetCurrentThreadId(),
+                     queue, cb, encoder, dispatch, static_cast<uint64_t>(kind),
+                     a, b, c, d, e, f, g, h});
+}
+
+void
+EmberD12TraceDumpSlow(uint64_t reason, uint64_t queue, uint64_t cb) noexcept {
+  if (!state || state->dumping.test_and_set(std::memory_order_acquire))
+    return;
+  if (state->abnormal_dump_saved) {
+    state->dumping.clear(std::memory_order_release);
+    return;
+  }
+  HANDLE file = INVALID_HANDLE_VALUE;
+  try {
+    auto snapshot = state->ring.snapshot();
+    file = CreateFileW(state->path.c_str(), GENERIC_WRITE, FILE_SHARE_READ,
+                       nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+      std::array<unsigned char, 88> header{};
+      const char magic[8] = {'E', 'M', 'B', 'D', '1', '2', 'T', '\0'};
+      std::copy_n(magic, 8, header.begin());
+      put32(header.data() + 8, 1);
+      put32(header.data() + 12, 128);
+      const uint64_t fields[9] = {state->ring.capacity(), snapshot.records.size(),
+        snapshot.next_serial, snapshot.dropped, state->frequency,
+        GetCurrentProcessId(), reason, queue, cb};
+      for (size_t i = 0; i < 9; ++i)
+        put64(header.data() + 16 + i * 8, fields[i]);
+      bool ok = write_bytes(file, header.data(), header.size());
+      // Batched I/O is confined to explicit dumps; event producers perform none.
+      std::array<unsigned char, 128 * 256> block{};
+      for (size_t base = 0; ok && base < snapshot.records.size(); base += 256) {
+        size_t count = std::min<size_t>(256, snapshot.records.size() - base);
+        for (size_t i = 0; i < count; ++i)
+          for (size_t field = 0; field < 16; ++field)
+            put64(block.data() + i * 128 + field * 8, snapshot.records[base + i][field]);
+        ok = write_bytes(file, block.data(), static_cast<DWORD>(count * 128));
+      }
+      ok = ok && FlushFileBuffers(file);
+      const bool closed = CloseHandle(file);
+      file = INVALID_HANDLE_VALUE;
+      if (ok && closed && (reason == 1 || reason == 2))
+        state->abnormal_dump_saved = true;
+      if (!ok || !closed)
+        std::fprintf(stderr, "Ember D12 trace: dump write failed (Win32 error %lu)\n", static_cast<unsigned long>(GetLastError()));
+    } else {
+      std::fprintf(stderr, "Ember D12 trace: cannot open dump (Win32 error %lu)\n", static_cast<unsigned long>(GetLastError()));
+    }
+  } catch (...) {
+    // A failed dump can be retried by the next trigger; never unwind into DXMT.
+    std::fprintf(stderr, "Ember D12 trace: dump snapshot allocation failed\n");
+  }
+  if (file != INVALID_HANDLE_VALUE)
+    CloseHandle(file);
+  state->dumping.clear(std::memory_order_release);
+}
+
+} // namespace dxmt
