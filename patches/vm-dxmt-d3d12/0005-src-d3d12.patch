+// Process-local D3D12 pipeline library. Persisted names are hints, never native PSOs.
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+#include "com/com_pointer.hpp"
+#include "d3d12_device_child.hpp"
+#include "d3d12_pipeline_stream.hpp"
+#include <vector>
+#include <map>
+#include <string>
+#include <mutex>
+#include <limits>
+#include <new>
+#include <cstdint>
+#include <cstring>
+#include <utility>
+
+namespace dxmt {
+// Private metadata is owned by the PSO: no device registry, dangling descriptor
+// pointers, or device -> PSO -> device reference cycle.
+static const GUID kEmberPipelineKey = {0x4ce8d723, 0xc62b, 0x40eb, {0xae, 0x11, 0xa0, 0xb7, 0x19, 0x6a, 0xd9, 0x31}};
+using EmberPipelineKey = std::vector<uint8_t>;
+
+class EmberPipelineKeyWriter {
+public:
+  EmberPipelineKey data;
+  template<class T> void field(const T &v) {
+    const auto *p = reinterpret_cast<const uint8_t *>(&v);
+    data.insert(data.end(), p, p + sizeof(v));
+  }
+  bool bytes(const void *p, size_t n) {
+    if (n && !p) return false;
+    field(uint64_t(n));
+    if (n) data.insert(data.end(), static_cast<const uint8_t *>(p), static_cast<const uint8_t *>(p) + n);
+    return true;
+  }
+  bool text(const char *p) { return bytes(p, p ? strlen(p) + 1 : 0); }
+  bool shader(const D3D12_SHADER_BYTECODE &s) { return bytes(s.pShaderBytecode, s.BytecodeLength); }
+  bool root(ID3D12RootSignature *r) {
+    if (!r) return bytes(nullptr, 0);
+    const void *blob = nullptr;
+    auto n = static_cast<MTLD3D12RootSignature *>(r)->GetBlob(&blob);
+    return bytes(blob, n);
+  }
+};
+
+static bool EmberMakePipelineKey(const D3D12_COMPUTE_PIPELINE_STATE_DESC &d, EmberPipelineKey &key) {
+  EmberPipelineKeyWriter w;
+  w.field(uint32_t(1));
+  if (!w.root(d.pRootSignature) || !w.shader(d.CS)) return false;
+  w.field(d.NodeMask == 1 ? 0u : d.NodeMask);
+  w.field(d.Flags);
+  key = std::move(w.data);
+  return true;
+}
+
+static bool EmberMakePipelineKey(const D3D12_GRAPHICS_PIPELINE_STATE_DESC &d, EmberPipelineKey &key) {
+  if (d.NumRenderTargets > 8 || (d.InputLayout.NumElements && !d.InputLayout.pInputElementDescs) ||
+      (d.StreamOutput.NumEntries && !d.StreamOutput.pSODeclaration) ||
+      (d.StreamOutput.NumStrides && !d.StreamOutput.pBufferStrides)) return false;
+  EmberPipelineKeyWriter w;
+  w.field(uint32_t(2));
+  if (!w.root(d.pRootSignature) || !w.shader(d.VS) || !w.shader(d.PS) || !w.shader(d.DS) ||
+      !w.shader(d.HS) || !w.shader(d.GS)) return false;
+  w.field(d.StreamOutput.NumEntries);
+  for (UINT i = 0; i < d.StreamOutput.NumEntries; ++i) {
+    const auto &e = d.StreamOutput.pSODeclaration[i];
+    w.field(e.Stream); if (!w.text(e.SemanticName)) return false;
+    w.field(e.SemanticIndex); w.field(e.StartComponent); w.field(e.ComponentCount); w.field(e.OutputSlot);
+  }
+  w.field(d.StreamOutput.NumStrides);
+  for (UINT i = 0; i < d.StreamOutput.NumStrides; ++i) w.field(d.StreamOutput.pBufferStrides[i]);
+  w.field(d.StreamOutput.RasterizedStream);
+  w.field(d.BlendState.AlphaToCoverageEnable); w.field(d.BlendState.IndependentBlendEnable);
+  for (const auto &b : d.BlendState.RenderTarget) {
+    w.field(b.BlendEnable); w.field(b.LogicOpEnable); w.field(b.SrcBlend); w.field(b.DestBlend);
+    w.field(b.BlendOp); w.field(b.SrcBlendAlpha); w.field(b.DestBlendAlpha); w.field(b.BlendOpAlpha);
+    w.field(b.LogicOp); w.field(b.RenderTargetWriteMask);
+  }
+  w.field(d.SampleMask);
+  const auto &r = d.RasterizerState;
+  w.field(r.FillMode); w.field(r.CullMode); w.field(r.FrontCounterClockwise); w.field(r.DepthBias);
+  w.field(r.DepthBiasClamp); w.field(r.SlopeScaledDepthBias); w.field(r.DepthClipEnable);
+  w.field(r.MultisampleEnable); w.field(r.AntialiasedLineEnable); w.field(r.ForcedSampleCount);
+  w.field(r.ConservativeRaster);
+  const auto &z = d.DepthStencilState;
+  w.field(z.DepthEnable); w.field(z.DepthWriteMask); w.field(z.DepthFunc); w.field(z.StencilEnable);
+  w.field(z.StencilReadMask); w.field(z.StencilWriteMask);
+  for (const auto *f : {&z.FrontFace, &z.BackFace}) {
+    w.field(f->StencilFailOp); w.field(f->StencilDepthFailOp); w.field(f->StencilPassOp); w.field(f->StencilFunc);
+  }
+  w.field(d.InputLayout.NumElements);
+  for (UINT i = 0; i < d.InputLayout.NumElements; ++i) {
+    const auto &e = d.InputLayout.pInputElementDescs[i];
+    if (!w.text(e.SemanticName)) return false;
+    w.field(e.SemanticIndex); w.field(e.Format); w.field(e.InputSlot); w.field(e.AlignedByteOffset);
+    w.field(e.InputSlotClass); w.field(e.InstanceDataStepRate);
+  }
+  w.field(d.IBStripCutValue); w.field(d.PrimitiveTopologyType); w.field(d.NumRenderTargets);
+  for (UINT i = 0; i < d.NumRenderTargets; ++i) w.field(d.RTVFormats[i]);
+  w.field(d.DSVFormat); w.field(d.SampleDesc.Count); w.field(d.SampleDesc.Quality);
+  w.field(d.NodeMask == 1 ? 0u : d.NodeMask); w.field(d.Flags);
+  // CachedPSO is an optional creation accelerator, not pipeline state.
+  key = std::move(w.data);
+  return true;
+}
+
+template<class Desc, class Create>
+static HRESULT EmberCreateLibraryPipeline(const Desc *desc, REFIID iid, void **out, Create create) {
+  if (out) *out = nullptr;
+  if (!desc) return E_INVALIDARG;
+  if (!out) return E_POINTER;
+  Com<ID3D12PipelineState> pso;
+  try {
+    HRESULT hr = create(__uuidof(ID3D12PipelineState), reinterpret_cast<void **>(&pso));
+    if (FAILED(hr)) return hr;
+  } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  // Keep the existing creation path authoritative. It intentionally repairs
+  // some malformed shader/SO descriptions for older games. Optional library
+  // metadata must never turn a working PSO (or an allocation-pressure case)
+  // into a new creation failure. Unidentifiable PSOs simply cannot be stored.
+  try {
+    EmberPipelineKey key;
+    if (EmberMakePipelineKey(*desc, key) && key.size() <= std::numeric_limits<UINT>::max())
+      pso->SetPrivateData(kEmberPipelineKey, UINT(key.size()), key.data());
+  } catch (const std::bad_alloc &) {}
+  return pso->QueryInterface(iid, out);
+}
+
+class MTLD3D12PipelineLibraryImpl final : public MTLD3D12DeviceChild<ID3D12PipelineLibrary1> {
+  using Name = std::basic_string<WCHAR>;
+  struct Entry { Com<ID3D12PipelineState> pso; EmberPipelineKey key; };
+  std::map<Name, Entry> pipelines_;
+  std::mutex mutex_;
+  static constexpr size_t HeaderSize = 24;
+  static constexpr uint8_t Magic[8] = {'D','X','M','T','P','L','B','1'};
+
+  static uint64_t read(const uint8_t *p, unsigned n) {
+    uint64_t x = 0; for (unsigned i = 0; i < n; ++i) x |= uint64_t(p[i]) << (8 * i); return x;
+  }
+  static void write(uint8_t *p, uint64_t x, unsigned n) {
+    for (unsigned i = 0; i < n; ++i) p[i] = uint8_t(x >> (8 * i));
+  }
+  static uint64_t checksum(const uint8_t *p, size_t n) {
+    uint64_t x = 14695981039346656037ull;
+    for (size_t i = 0; i < n; ++i) { x ^= p[i]; x *= 1099511628211ull; }
+    return x;
+  }
+  size_t serializedSize() const {
+    size_t n = HeaderSize;
+    for (const auto &[name, entry] : pipelines_) n += 4 + 2 * name.size();
+    return n;
+  }
+  HRESULT load(const WCHAR *name, const EmberPipelineKey &key, REFIID iid, void **out) {
+    std::lock_guard lock(mutex_);
+    auto it = pipelines_.find(name);
+    if (it == pipelines_.end() || !it->second.pso || it->second.key != key) return E_INVALIDARG;
+    return it->second.pso->QueryInterface(iid, out);
+  }
+  template<class Desc> HRESULT loadDesc(const WCHAR *name, const Desc *desc, REFIID iid, void **out) {
+    if (out) *out = nullptr;
+    if (!out) return E_POINTER;
+    if (!name || !desc) return E_INVALIDARG;
+    try {
+      EmberPipelineKey key;
+      if (!EmberMakePipelineKey(*desc, key)) return E_INVALIDARG;
+      return load(name, key, iid, out);
+    } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  }
+public:
+  explicit MTLD3D12PipelineLibraryImpl(MTLD3D12Device *device) : MTLD3D12DeviceChild(device) {}
+  HRESULT Initialize(const void *blob, SIZE_T size) {
+    if (!size) return S_OK;
+    if (!blob || size < HeaderSize) return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
