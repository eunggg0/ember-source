+  // Same warp split as D3D11 get_gs_vertex_count(): {vertices per object threadgroup, increment}.
+  static std::pair<uint32_t, uint32_t> EmberGSVertexCount(D3D_PRIMITIVE_TOPOLOGY t) {
+    switch (t) {
+    case D3D_PRIMITIVE_TOPOLOGY_POINTLIST: return {32, 32};
+    case D3D_PRIMITIVE_TOPOLOGY_LINELIST: return {32, 32};
+    case D3D_PRIMITIVE_TOPOLOGY_LINESTRIP: return {32, 31};
+    case D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST: return {30, 30};
+    case D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP: return {32, 30};
+    case D3D_PRIMITIVE_TOPOLOGY_LINELIST_ADJ: return {32, 32};
+    case D3D_PRIMITIVE_TOPOLOGY_LINESTRIP_ADJ: return {32, 29};
+    case D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST_ADJ: return {30, 30};
+    case D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP_ADJ: return {32, 28};
+    default: return {0, 0};
+    }
+  }
+
+  void EmberDrawDXBCGS(bool indexed, uint32_t count, uint32_t instances, uint32_t start,
+                       int32_t base_vertex, uint32_t start_instance) {
+    auto [per_warp, increment] = EmberGSVertexCount(topology_);
+    if (!instances || !count || !per_warp) return;
+    bool strip = topology_ == D3D_PRIMITIVE_TOPOLOGY_LINESTRIP || topology_ == D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP ||
+                 topology_ == D3D_PRIMITIVE_TOPOLOGY_LINESTRIP_ADJ || topology_ == D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP_ADJ;
+    uint64_t warps = (count - 1) / increment + 1;
+    if (warps * instances > (1u << 20)) {
+      static bool warned = false;
+      if (!warned) { warned = true; WARN("Ember DXBC GS: draw too large for object threadgroups, skipped"); }
+      return;
+    }
+    auto *p = pso_graphics_.ptr();
+    uint64_t ib_offset = 0;
+    if (indexed) {
+      uint32_t width = index_type == WMTIndexTypeUInt32 ? 4 : 2;
+      uint64_t end = (uint64_t(start) + count) * width;
+      auto allocation = index_buffer_address ? device_->LookupBufferByVA(index_buffer_address, &ib_offset) : nullptr;
+      if (!allocation || end > ember_dxbc_tess_ibv_.SizeInBytes ||
+          (ember_dxbc_tess_ibv_.Format != DXGI_FORMAT_R16_UINT && ember_dxbc_tess_ibv_.Format != DXGI_FORMAT_R32_UINT)) return;
+    }
+    unsigned variant = indexed ? (index_type == WMTIndexTypeUInt32 ? 2 : 1) : 0;
+    auto &state = allocator_->EncodeRenderCommand<wmtcmd_render_setpso>();
+    state.type = WMTRenderCommandSetPSO;
+    state.pso = p->ember_dxbc_gs_pso[strip][variant];
+    // DXMT_DRAW_ARGUMENTS / DXMT_DRAW_INDEXED_ARGUMENTS (D3D11 GeometryDraw*).
+    auto [mapped, offset] = allocator_->AllocateGPUHeap(32, 16);
+    uint32_t args[8] = {};
+    if (indexed) {
+      args[0] = count; args[1] = instances; args[2] = start; args[3] = (uint32_t)base_vertex; args[4] = start_instance;
+    } else {
+      args[0] = count; args[1] = instances; args[2] = start; args[3] = start_instance;
+    }
+    memcpy(mapped, args, sizeof(args));
+    for (auto type : {WMTRenderCommandSetObjectBuffer, WMTRenderCommandSetMeshBuffer}) {
+      auto &arg = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      arg.type = type; arg.buffer = allocator_->gpu_heap_buffer_; arg.offset = offset;
+      arg.index = SM50_BINDING_INDEX_DRAW_ARGUMENTS;
+    }
+    if (indexed) {
+      auto allocation = index_buffer_address ? device_->LookupBufferByVA(index_buffer_address, &ib_offset) : nullptr;
+      if (!allocation) return;
+      auto &ib = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      ib.type = WMTRenderCommandSetObjectBuffer; ib.buffer = allocation->buffer(); ib.offset = ib_offset;
+      ib.index = SM50_BINDING_INDEX_INDEX_BUFFER;
+    }
+    auto &draw = allocator_->EncodeRenderCommand<wmtcmd_render_draw_meshthreadgroups>();
+    draw.type = WMTRenderCommandDrawMeshThreadgroups;
+    draw.reserved[0] = draw.reserved[1] = draw.reserved[2] = 0;
+    draw.threadgroup_per_grid = {(uint32_t)warps, instances, 1};
+    draw.object_threadgroup_size = {per_warp, 1, 1};
+    draw.mesh_threadgroup_size = {1, 1, 1};
+  }
diff --git a/src/d3d12/ember_dxbc_gs_pipeline.inc b/src/d3d12/ember_dxbc_gs_pipeline.inc
new file mode 100644
index 0000000..c38e3c3
--- /dev/null
+++ b/src/d3d12/ember_dxbc_gs_pipeline.inc
@@ -0,0 +1,118 @@
+  // Bridge DXBC VS+GS to the existing D3D11 AIR geometry pipeline: VS runs as the object
+  // function, GS as the mesh function (d3d11_pipeline_gs.cpp). Strip/list and index format
+  // are compile-time variants there, so build all six and pick at draw time.
+  HRESULT InitializeDXBCGeometry(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *d) {
+    if (d->PrimitiveTopologyType == D3D12_PRIMITIVE_TOPOLOGY_TYPE_PATCH ||
+        d->PrimitiveTopologyType == D3D12_PRIMITIVE_TOPOLOGY_TYPE_UNDEFINED ||
+        !d->pRootSignature || d->InputLayout.NumElements > 31 ||
+        (d->InputLayout.NumElements && !d->InputLayout.pInputElementDescs)) return E_NOTIMPL;
+    for (uint32_t i = 0; i < d->InputLayout.NumElements; i++)
+      if (d->InputLayout.pInputElementDescs[i].InputSlot >= 32) return E_INVALIDARG;
+    SM50Shader vs, gs, ps;
+    MTL_SHADER_REFLECTION gr = {};
+    memset(&ref_vs, 0, sizeof(ref_vs));
+    memset(&ref_ps, 0, sizeof(ref_ps));
+    HRESULT result;
+    if (FAILED(result = InitializeShader(d->VS, &vs, &ref_vs)) ||
+        FAILED(result = InitializeShader(d->GS, &gs, &gr))) return result;
+    SM50_SHADER_COMMON_DATA common = {};
+    common.type = SM50_SHADER_COMMON;
+    common.metal_version = EmberDxbcMetalVersion(device_->GetMTLDevice(), "VS/GS/PS", {d->VS, d->GS, d->PS}); /* Ember(wukong-1106) */
+    SM50_SHADER_PSO_GEOMETRY_SHADER_DATA geometry = {};
+    geometry.type = SM50_SHADER_PSO_GEOMETRY_SHADER;
+    geometry.next = &common;
+    SM50_SHADER_ROOT_SIGNATURE_DATA root = {};
+    root.type = SM50_SHADER_ROOT_SIGNATURE;
+    root.bytecode_length = static_cast<MTLD3D12RootSignature *>(d->pRootSignature)->GetBlob(&root.bytecode);
+    root.next = &geometry;
+    std::vector<SM50_IA_INPUT_ELEMENT> elements(d->InputLayout.NumElements);
+    SM50_SHADER_IA_INPUT_LAYOUT_DATA ia = {};
+    ia.type = SM50_SHADER_IA_INPUT_LAYOUT;
+    if (FAILED(result = ExtractMTLInputLayoutElements(device_, d->VS.pShaderBytecode,
+        d->InputLayout.pInputElementDescs, d->InputLayout.NumElements, elements.data(), &ia.num_elements))) return result;
+    ia.elements = elements.data();
+    uint32_t mask = 0;
+    for (uint32_t i = 0; i < ia.num_elements; i++) mask |= 1u << elements[i].slot;
+    ia.slot_mask = mask;
+    ia.next = &root;
+    auto metal = device_->GetMTLDevice();
+    WMT::Reference<WMT::Error> error;
+    auto load = [&](SM50ShaderBitcode &bc, const char *name) -> WMT::Reference<WMT::Function> {
+      SM50_COMPILED_BITCODE data;
+      SM50GetCompiledBitcode(bc, &data);
+      auto lib = metal.newLibrary(WMT::MakeDispatchData(data.Data, data.Size), error);
+      if (!lib) return {};
+      return lib.newFunction(name);
+    };
+    SM50Error smerr;
+    WMTRenderPipelineInfo raster;
+    WMT::InitializeRenderPipelineInfo(raster);
+    bool dual = false;
+    WMT::Reference<WMT::Function> fragment;
+    if (d->PS.pShaderBytecode && FAILED(result = InitializeShader(d->PS, &ps, &ref_ps))) return result;
+    if (FAILED(result = InitializePSO(d, raster, dual))) return result;
+    if (d->PS.pShaderBytecode) {
+      SM50_SHADER_PSO_PIXEL_SHADER_DATA pixel = {};
+      pixel.type = SM50_SHADER_PSO_PIXEL_SHADER;
+      pixel.sample_mask = d->SampleMask;
+      pixel.dual_source_blending = dual;
+      for (uint32_t i = 0; i < d->NumRenderTargets; i++) pixel.pixel_formats[i] = ORIGINAL_FORMAT(raster.colors[i].pixel_format);
+      pixel.next = &common;
+      SM50_SHADER_ROOT_SIGNATURE_DATA proot = root;
+      proot.next = &pixel;
+      SM50ShaderBitcode psbc;
+      if (SM50Compile(ps, reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&proot),
+                      "ember_dxbc_gs_ps", &psbc, &smerr)) {
+        WARN("Ember DXBC GS PS: ", SM50GetErrorMessageString(smerr)); return E_FAIL;
+      }
+      fragment = load(psbc, "ember_dxbc_gs_ps");
+      if (!fragment) return E_FAIL;
+    }
+    WMT::Reference<WMT::RenderPipelineState> variants[2][3];
+    for (unsigned strip = 0; strip < 2; strip++) {
+      geometry.strip_topology = strip != 0;
+      SM50ShaderBitcode gsbc;
+      if (SM50CompileGeometryPipelineGeometry(vs, gs, reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&root),
+                                              "ember_dxbc_gs", &gsbc, &smerr)) {
+        WARN("Ember DXBC GS: ", SM50GetErrorMessageString(smerr)); return E_FAIL;
+      }
+      auto mesh_fn = load(gsbc, "ember_dxbc_gs");
+      if (!mesh_fn) return E_FAIL;
+      for (unsigned indexed = 0; indexed < 3; indexed++) {
+        ia.index_buffer_format = (SM50_INDEX_BUFFER_FORMAT)indexed;
+        SM50ShaderBitcode vsbc;
+        if (SM50CompileGeometryPipelineVertex(vs, gs, reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&ia),
+                                              "ember_dxbc_gs_vs", &vsbc, &smerr)) {
+          WARN("Ember DXBC GS VS: ", SM50GetErrorMessageString(smerr)); return E_FAIL;
+        }
+        auto object_fn = load(vsbc, "ember_dxbc_gs_vs");
+        if (!object_fn) return E_FAIL;
+        WMTMeshRenderPipelineInfo mesh;
+        WMT::InitializeMeshRenderPipelineInfo(mesh);
+        mesh.object_function = object_fn;
+        mesh.mesh_function = mesh_fn;
+        mesh.fragment_function = fragment;
+        mesh.payload_memory_length = 16256; // same as d3d11_pipeline_gs.cpp
+        mesh.rasterization_enabled = raster.rasterization_enabled;
+        mesh.raster_sample_count = raster.raster_sample_count;
+        mesh.alpha_to_coverage_enabled = raster.alpha_to_coverage_enabled;
+        mesh.depth_pixel_format = raster.depth_pixel_format;
+        mesh.stencil_pixel_format = raster.stencil_pixel_format;
+        for (unsigned i = 0; i < 8; i++) mesh.colors[i] = raster.colors[i];
+        // Object threadgroups are 28..32 vertices wide: not a SIMD-width multiple.
+        variants[strip][indexed] = metal.newRenderPipelineState(mesh, error);
+        if (!variants[strip][indexed]) {
+          WARN("Ember DXBC GS mesh PSO: ", error.description().getUTF8String()); return E_FAIL;
+        }
+      }
+    }
+    for (unsigned s = 0; s < 2; s++)
+      for (unsigned i = 0; i < 3; i++) ember_dxbc_gs_pso[s][i] = variants[s][i];
+    pso = variants[0][0];
+    ember_dxbc_gs = true;
+    slot_mask = mask;
+    InitializeDSSO(d);
+    InitializeRasterizerState(d);
+    WARN("Ember: DXBC GS enabled via AIR mesh pipeline (VS ", d->VS.BytecodeLength, " GS ", d->GS.BytecodeLength, ")");
+    return S_OK;
+  }
diff --git a/src/d3d12/ember_dxbc_tess.hpp b/src/d3d12/ember_dxbc_tess.hpp
new file mode 100644
index 0000000..c09f0c0
--- /dev/null
+++ b/src/d3d12/ember_dxbc_tess.hpp
@@ -0,0 +1,61 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <cmath>
+#include "DXBCParser/d3d12tokenizedprogramformat.hpp"
+
+// Inspect the token stream, never infer a constant tess factor from topology.
+// The existing AIR tessellator executes the patch-constant function at runtime.
+struct EmberDXBCTessInfo {
+  uint32_t input_cps = 0, output_cps = 0, domain = 0;
+  float declared_max = 64; // SM5 default when dcl_hs_max_tessfactor is absent.
+};
+inline bool EmberDXBCTessTokens(const void *data, size_t bytes, uint32_t stage, EmberDXBCTessInfo &out) {
+  using namespace microsoft;
+  out = {};
+  if (!data || bytes < 8 || bytes % 4) return false;
+  auto word = [=](size_t i) { uint32_t v; std::memcpy(&v, static_cast<const uint8_t *>(data) + i * 4, 4); return v; };
+  size_t n = bytes / 4;
+  bool seen_input = false, seen_output = false, seen_domain = false, seen_max = false;
+  if ((word(0) >> 16) != stage || word(1) != n || ((word(0) >> 4) & 15) != 5) return false;
+  for (size_t i = 2; i < n;) {
+    uint32_t t = word(i), op = t & 0x7ff, len = (t >> 24) & 127;
+    if (op == D3D10_SB_OPCODE_CUSTOMDATA) {
+      if (i + 1 >= n) return false;
+      len = word(i + 1);
+      if (len < 2) return false;
+    }
+    if (!len || len > n - i) return false;
+    if (op == D3D11_SB_OPCODE_DCL_INPUT_CONTROL_POINT_COUNT) {
+      if (len != 1 || seen_input || (t >> 31)) return false;
+      seen_input = true;
+      out.input_cps = (t >> 11) & 63;
+      if (!out.input_cps || out.input_cps > 32) return false;
+    } else if (op == D3D11_SB_OPCODE_DCL_OUTPUT_CONTROL_POINT_COUNT) {
+      if (len != 1 || seen_output || (t >> 31)) return false;
+      seen_output = true;
+      out.output_cps = (t >> 11) & 63;
+      if (!out.output_cps || out.output_cps > 32) return false;
+    } else if (op == D3D11_SB_OPCODE_DCL_TESS_DOMAIN) {
+      if (len != 1 || seen_domain || (t >> 31)) return false;
+      seen_domain = true;
+      out.domain = (t >> 11) & 3;
+      if (!out.domain) return false;
+    } else if (op == D3D11_SB_OPCODE_DCL_HS_MAX_TESSFACTOR) {
+      if (len != 2 || seen_max || (t >> 31)) return false;
+      seen_max = true;
+      uint32_t bits = word(i + 1); std::memcpy(&out.declared_max, &bits, 4);
+      if (!std::isfinite(out.declared_max) || out.declared_max < 1 || out.declared_max > 64) return false;
+    }
+    i += len;
+  }
+  return out.domain != 0;
+}
+
+// AIR object groups have 32 lanes, with one power-of-two group per patch.
+inline uint32_t EmberDXBCTessGroups(uint32_t count, uint32_t cps, uint32_t threads) {
+  if (!cps || !threads || threads > 32 || (threads & (threads - 1))) return 0;
+  uint32_t patches = count / cps, per_group = 32 / threads;
+  return patches / per_group + (patches % per_group != 0);
+}
diff --git a/src/d3d12/ember_dxbc_tess_draw.inc b/src/d3d12/ember_dxbc_tess_draw.inc
new file mode 100644
index 0000000..26476b5
--- /dev/null
+++ b/src/d3d12/ember_dxbc_tess_draw.inc
@@ -0,0 +1,43 @@
+  void EmberDrawDXBCTess(bool indexed, uint32_t count, uint32_t instances, uint32_t start,
+                        int32_t base_vertex, uint32_t start_instance) {
+    if (!instances || topology_ != D3D_PRIMITIVE_TOPOLOGY_3_CONTROL_POINT_PATCHLIST) return;
+    auto *p = pso_graphics_.ptr();
+    uint32_t groups = EmberDXBCTessGroups(count, 3, p->ember_dxbc_tess_threads);
+    if (!groups) return;
+    count -= count % 3;
+    uint64_t ib_offset = 0;
+    if (indexed) {
+      uint32_t width = index_type == WMTIndexTypeUInt32 ? 4 : 2;
+      uint64_t end = (uint64_t(start) + count) * width;
+      auto allocation = index_buffer_address ? device_->LookupBufferByVA(index_buffer_address, &ib_offset) : nullptr;
+      if (!allocation || end > ember_dxbc_tess_ibv_.SizeInBytes ||
+          (ember_dxbc_tess_ibv_.Format != DXGI_FORMAT_R16_UINT && ember_dxbc_tess_ibv_.Format != DXGI_FORMAT_R32_UINT)) return;
+    }
+    unsigned variant = indexed ? (index_type == WMTIndexTypeUInt32 ? 2 : 1) : 0;
+    auto &state = allocator_->EncodeRenderCommand<wmtcmd_render_setpso>();
+    state.type = WMTRenderCommandSetPSO;
+    state.pso = p->ember_dxbc_tess_pso[variant];
+    // AIR's draw_arguments layout is the standard D3D draw/indexed argument layout.
+    auto [mapped, offset] = allocator_->AllocateGPUHeap(32, 16);
+    uint32_t args[8] = {count, instances, start, indexed ? (uint32_t)base_vertex : start_instance,
+                        indexed ? start_instance : 0, 0, 0, 0};
+    memcpy(mapped, args, sizeof(args));
+    for (auto type : {WMTRenderCommandSetObjectBuffer, WMTRenderCommandSetMeshBuffer}) {
+      auto &arg = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      arg.type = type; arg.buffer = allocator_->gpu_heap_buffer_; arg.offset = offset;
+      arg.index = SM50_BINDING_INDEX_DRAW_ARGUMENTS;
+    }
+    if (indexed) {
+      auto allocation = index_buffer_address ? device_->LookupBufferByVA(index_buffer_address, &ib_offset) : nullptr;
+      if (!allocation) return;
+      auto &ib = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      ib.type = WMTRenderCommandSetObjectBuffer; ib.buffer = allocation->buffer(); ib.offset = ib_offset;
+      ib.index = SM50_BINDING_INDEX_INDEX_BUFFER;
+    }
+    auto &draw = allocator_->EncodeRenderCommand<wmtcmd_render_draw_meshthreadgroups>();
+    draw.type = WMTRenderCommandDrawMeshThreadgroups;
+    draw.reserved[0] = draw.reserved[1] = draw.reserved[2] = 0;
+    draw.threadgroup_per_grid = {groups, instances, 1};
+    draw.object_threadgroup_size = {p->ember_dxbc_tess_threads, 32 / p->ember_dxbc_tess_threads, 1};
+    draw.mesh_threadgroup_size = {32, 1, 1};
+  }
diff --git a/src/d3d12/ember_dxbc_tess_pipeline.inc b/src/d3d12/ember_dxbc_tess_pipeline.inc
new file mode 100644
index 0000000..674c917
--- /dev/null
+++ b/src/d3d12/ember_dxbc_tess_pipeline.inc
@@ -0,0 +1,141 @@
+  // Bridge tri3 DXBC to the existing D3D11 AIR object/mesh tessellator.
+  // Both HS phases and DS execute; no factor-one assumption or shader bypass.
+  HRESULT InitializeDXBCTess(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *d) {
+    using namespace microsoft;
+    if (d->PrimitiveTopologyType != D3D12_PRIMITIVE_TOPOLOGY_TYPE_PATCH ||
+        !d->pRootSignature || d->InputLayout.NumElements > 31 ||
+        (d->InputLayout.NumElements && !d->InputLayout.pInputElementDescs)) return E_NOTIMPL;
+    for (uint32_t i = 0; i < d->InputLayout.NumElements; i++)
+      if (d->InputLayout.pInputElementDescs[i].InputSlot >= 32) return E_INVALIDARG;
+    auto inspect = [](D3D12_SHADER_BYTECODE code, uint32_t stage, EmberDXBCTessInfo &out) {
+      if (code.BytecodeLength > UINT32_MAX) return false;
+      CDXBCParser parser;
+      if (FAILED(parser.ReadDXBC(code.pShaderBytecode, (uint32_t)code.BytecodeLength))) return false;
+      for (uint32_t i = 0; i < parser.GetBlobCount(); i++) {
+        auto tag = parser.GetBlobFourCC(i);
+        if (tag == 0x52444853 || tag == 0x58454853)
+          return EmberDXBCTessTokens(parser.GetBlob(i), parser.GetBlobSize(i), stage, out);
+      }
+      return false;
+    };
+    EmberDXBCTessInfo hi, di;
+    if (!inspect(d->HS, D3D11_SB_HULL_SHADER, hi) || !inspect(d->DS, D3D11_SB_DOMAIN_SHADER, di) ||
+        hi.input_cps != 3 || hi.output_cps != 3 || hi.domain != D3D11_SB_TESSELLATOR_DOMAIN_TRI ||
+        di.domain != hi.domain || di.input_cps != 3 || hi.declared_max == 0) return E_NOTIMPL;
+    SM50Shader vs, hs, ds, ps;
+    MTL_SHADER_REFLECTION hr = {}, dr = {};
+    memset(&ref_vs, 0, sizeof(ref_vs));
+    memset(&ref_ps, 0, sizeof(ref_ps));
+    HRESULT result;
+    if (FAILED(result = InitializeShader(d->VS, &vs, &ref_vs)) ||
+        FAILED(result = InitializeShader(d->HS, &hs, &hr)) ||
+        FAILED(result = InitializeShader(d->DS, &ds, &dr))) return result;
+    // Refuse truncation to mesh/payload capacity rather than clamping a legal factor.
+    if (hr.Tessellator.Partition != D3D11_SB_TESSELLATOR_PARTITIONING_INTEGER ||
+        (hr.Tessellator.OutputPrimitive != MTL_TESSELLATOR_OUTPUT_TRIANGLE_CW &&
+         hr.Tessellator.OutputPrimitive != MTL_TESSELLATOR_TRIANGLE_CCW) ||
+        hr.Tessellator.MaxFactor != hi.declared_max ||
+        dr.PostTessellator.MaxPotentialTessFactor < (uint32_t)std::ceil(hi.declared_max) ||
+        !EmberDXBCTessGroups(3, 3, hr.ThreadsPerPatch)) return E_NOTIMPL;
+    SM50_SHADER_COMMON_DATA common = {};
+    common.type = SM50_SHADER_COMMON;
+    common.metal_version = EmberDxbcMetalVersion(device_->GetMTLDevice(), "VS/HS/DS/PS", {d->VS, d->HS, d->DS, d->PS}); /* Ember(wukong-1106) */
+    SM50_SHADER_PSO_TESSELLATOR_DATA tess = {};
+    tess.type = SM50_SHADER_PSO_TESSELLATOR;
+    tess.next = &common;
+    tess.max_potential_tess_factor = dr.PostTessellator.MaxPotentialTessFactor;
+    SM50_SHADER_ROOT_SIGNATURE_DATA root = {}, root_vs = {};
+    root.type = SM50_SHADER_ROOT_SIGNATURE;
+    root.bytecode_length = static_cast<MTLD3D12RootSignature *>(d->pRootSignature)->GetBlob(&root.bytecode);
+    root_vs = root;
+    root_vs.type = SM50_SHADER_ROOT_SIGNATURE2;
+    std::vector<SM50_IA_INPUT_ELEMENT> elements(d->InputLayout.NumElements);
+    SM50_SHADER_IA_INPUT_LAYOUT_DATA ia = {};
+    ia.type = SM50_SHADER_IA_INPUT_LAYOUT;
+    if (FAILED(result = ExtractMTLInputLayoutElements(device_, d->VS.pShaderBytecode,
+        d->InputLayout.pInputElementDescs, d->InputLayout.NumElements, elements.data(), &ia.num_elements))) return result;
+    ia.elements = elements.data();
+    uint32_t mask = 0;
+    for (uint32_t i = 0; i < ia.num_elements; i++) mask |= 1u << elements[i].slot;
+    ia.slot_mask = mask;
+    ia.next = &root;
+    root.next = &root_vs;
+    root_vs.next = &tess;
+    auto metal = device_->GetMTLDevice();
+    WMT::Reference<WMT::Error> error;
+    auto load = [&](SM50ShaderBitcode &bc, const char *name) -> WMT::Reference<WMT::Function> {
+      SM50_COMPILED_BITCODE data;
+      SM50GetCompiledBitcode(bc, &data);
+      auto lib = metal.newLibrary(WMT::MakeDispatchData(data.Data, data.Size), error);
+      if (!lib) return {};
+      return lib.newFunction(name);
+    };
+    WMT::Reference<WMT::Function> domain, fragment;
+    SM50Error smerr;
+    SM50ShaderBitcode dsbc;
+    root.next = &tess;
+    if (SM50CompileTessellationPipelineDomain(hs, ds,
+        reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&root), "ember_dxbc_ds", &dsbc, &smerr)) {
+      WARN("Ember DXBC tess DS: ", SM50GetErrorMessageString(smerr)); return E_FAIL;
+    }
+    domain = load(dsbc, "ember_dxbc_ds");
+    if (!domain) return E_FAIL;
+    WMTRenderPipelineInfo raster;
+    WMT::InitializeRenderPipelineInfo(raster);
+    bool dual = false;
+    if (d->PS.pShaderBytecode && FAILED(result = InitializeShader(d->PS, &ps, &ref_ps))) return result;
+    if (FAILED(result = InitializePSO(d, raster, dual))) return result;
+    if (d->PS.pShaderBytecode) {
+      SM50_SHADER_PSO_PIXEL_SHADER_DATA pixel = {};
+      pixel.type = SM50_SHADER_PSO_PIXEL_SHADER;
+      pixel.sample_mask = d->SampleMask;
+      pixel.dual_source_blending = dual;
+      for (uint32_t i = 0; i < d->NumRenderTargets; i++) pixel.pixel_formats[i] = ORIGINAL_FORMAT(raster.colors[i].pixel_format);
+      pixel.next = &common;
+      root.next = &pixel;
+      SM50ShaderBitcode psbc;
+      if (SM50Compile(ps, reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&root),
+                      "ember_dxbc_ps", &psbc, &smerr)) return E_FAIL;
+      fragment = load(psbc, "ember_dxbc_ps");
+      if (!fragment) return E_FAIL;
+    }
+    WMT::Reference<WMT::RenderPipelineState> variants[3];
+    for (unsigned indexed = 0; indexed < 3; indexed++) {
+      ia.index_buffer_format = (SM50_INDEX_BUFFER_FORMAT)indexed;
+      root.next = &root_vs;
+      SM50ShaderBitcode hsbc;
+      if (SM50CompileTessellationPipelineHull(vs, hs,
+          reinterpret_cast<SM50_SHADER_COMPILATION_ARGUMENT_DATA *>(&ia), "ember_dxbc_vshs", &hsbc, &smerr)) {
+        WARN("Ember DXBC tess VS/HS: ", SM50GetErrorMessageString(smerr)); return E_FAIL;
+      }
+      auto hull = load(hsbc, "ember_dxbc_vshs");
+      if (!hull) return E_FAIL;
+      WMTMeshRenderPipelineInfo mesh;
+      WMT::InitializeMeshRenderPipelineInfo(mesh);
+      mesh.object_function = hull;
+      mesh.mesh_function = domain;
+      mesh.fragment_function = fragment;
+      mesh.rasterization_enabled = raster.rasterization_enabled;
+      mesh.raster_sample_count = raster.raster_sample_count;
+      mesh.alpha_to_coverage_enabled = raster.alpha_to_coverage_enabled;
+      mesh.depth_pixel_format = raster.depth_pixel_format;
+      mesh.stencil_pixel_format = raster.stencil_pixel_format;
+      for (unsigned i = 0; i < 8; i++) mesh.colors[i] = raster.colors[i];
+      mesh.object_tgsize_is_multiple_of_sgwidth = true;
+      mesh.mesh_tgsize_is_multiple_of_sgwidth = true;
+      if (!metal.supportsFamily(WMTGPUFamilyApple7)) mesh.payload_memory_length = 16384;
+      variants[indexed] = metal.newRenderPipelineState(mesh, error);
+      if (!variants[indexed]) {
+        WARN("Ember DXBC tess mesh PSO: ", error.description().getUTF8String()); return E_FAIL;
+      }
+    }
+    for (unsigned i = 0; i < 3; i++) ember_dxbc_tess_pso[i] = variants[i];
+    pso = variants[0];
+    ember_dxbc_tess_threads = hr.ThreadsPerPatch;
+    ember_dxbc_tess = true;
+    slot_mask = mask;
+    InitializeDSSO(d);
+    InitializeRasterizerState(d);
+    WARN("Ember: DXBC tri3 HS/DS tessellation enabled, max factor ", hi.declared_max);
+    return S_OK;
+  }
diff --git a/src/d3d12/ember_reblack_completion.hpp b/src/d3d12/ember_reblack_completion.hpp
new file mode 100644
index 0000000..c362ca1
--- /dev/null
+++ b/src/d3d12/ember_reblack_completion.hpp
@@ -0,0 +1,131 @@
+// Ember-only D3D12 software completion timeline; native Fence ABI is unchanged.
+#pragma once
+#include "ember_reblack_completion_core.hpp"
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+namespace dxmt {
+class Fence;
+// Completion notifications run under the timeline mutex and must not re-enter
+// a fence. Shared ownership outlives the API call without retaining COM fences.
+struct EmberCompletionNotification {
+  virtual ~EmberCompletionNotification() = default;
+  virtual void complete() noexcept = 0;
+};
+inline std::atomic<uint64_t> ember_completed_progress{0};
+struct EmberQueueWait {
+  uint64_t value;
+  std::atomic<bool> done{false};
+  explicit EmberQueueWait(uint64_t target) : value(target) {}
+};
+struct EmberFenceCompletion {
+  std::mutex mutex;
+  std::condition_variable cv;
+  ::ember::completion::Timeline timeline;
+  struct Event {
+    uint64_t value;
+    HANDLE handle;
+    bool *done=nullptr;
+    std::shared_ptr<EmberCompletionNotification> notification;
+  };
+  std::vector<Event> events;
+  std::vector<std::weak_ptr<EmberQueueWait>> queue_waits;
+  explicit EmberFenceCompletion(uint64_t initial) : timeline(initial) {}
+  auto request(uint64_t value, uint64_t producer=0) {
+    std::lock_guard<std::mutex> lock(mutex);
+    return timeline.request(value,producer);
+  }
+  uint64_t value() {
+    std::lock_guard<std::mutex> lock(mutex);
+    return timeline.value();
+  }
+  // Caller holds mutex. CPU Signal reserves and retires in one critical section.
+  void completeLocked(::ember::completion::Ticket ticket) {
+    if (!timeline.complete(ticket)) return;
+    ember_completed_progress.fetch_add(1, std::memory_order_release);
+    // Satisfy registrations at this completion, before a later explicit rewind.
+    for (auto it=events.begin(); it!=events.end();) {
+      if (timeline.value()>=it->value) {
+        if(it->handle) SetEvent(it->handle);
+        if(it->done) *it->done=true;
+        if(it->notification) it->notification->complete();
+        it=events.erase(it);
+      }
+      else ++it;
+    }
+    for (auto it=queue_waits.begin(); it!=queue_waits.end();) {
+      auto wait=it->lock();
+      if (!wait) { it=queue_waits.erase(it); continue; }
+      if (timeline.value()>=wait->value) {
+        wait->done.store(true,std::memory_order_release);
+        it=queue_waits.erase(it);
+      } else ++it;
+    }
+    cv.notify_all();
+  }
+  void complete(::ember::completion::Ticket ticket) {
+    std::lock_guard<std::mutex> lock(mutex);
+    completeLocked(ticket);
+  }
+  void signal(uint64_t value) {
+    std::lock_guard<std::mutex> lock(mutex);
+    completeLocked(timeline.request(value)); // producer 0 is synchronous CPU
+  }
+  auto queueWait(uint64_t value) {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto wait=std::make_shared<EmberQueueWait>(value);
+    if (timeline.value()>=value) wait->done.store(true,std::memory_order_release);
+    else {
+      // Canceled/deleted queue operations cannot retain an unbounded dead list.
+      for (auto it=queue_waits.begin(); it!=queue_waits.end();)
+        if (it->expired()) it=queue_waits.erase(it); else ++it;
+      queue_waits.push_back(wait);
+    }
+    return wait;
+  }
+  void setEvent(uint64_t value, HANDLE event) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (timeline.value()>=value) SetEvent(event);
+    else events.push_back({value,event,nullptr,{}});
+  }
+  void setNotification(uint64_t value, const std::shared_ptr<EmberCompletionNotification> &notification) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (timeline.value()>=value) notification->complete();
+    else events.push_back({value,nullptr,nullptr,notification});
+  }
+  bool wait(uint64_t value, uint64_t timeout=~0ull) {
+    std::unique_lock<std::mutex> lock(mutex);
+    // Latch satisfaction under the same mutex as completion. A subsequent
+    // explicit rewind must not undo an already satisfied CPU wait.
+    if (timeline.value()>=value) return true;
+    bool done=false;
+    events.push_back({value,nullptr,&done,{}});
+    if (timeout==~0ull) cv.wait(lock,[&]{return done;});
+    else cv.wait_for(lock,std::chrono::milliseconds(timeout),[&]{return done;});
+    for(auto it=events.begin();it!=events.end();++it)
+      if(it->done==&done) { events.erase(it); break; }
+    return done;
+  }
+};
+// Only initialized D3D12 COM fences enter this registry. Keeping state separate
+// avoids changing the shared DXMT Fence layout or stale precompiled inline code.
+inline std::mutex ember_completion_registry_mutex;
+inline std::unordered_map<Fence *,std::shared_ptr<EmberFenceCompletion>> ember_completion_registry;
+inline auto EmberCompletion(Fence *fence) {
+  std::lock_guard<std::mutex> lock(ember_completion_registry_mutex);
+  return ember_completion_registry.at(fence);
+}
+inline void EmberCompletionCreate(Fence *fence,uint64_t value) {
+  std::lock_guard<std::mutex> lock(ember_completion_registry_mutex);
+  ember_completion_registry.emplace(fence,std::make_shared<EmberFenceCompletion>(value));
+}
+inline void EmberCompletionDestroy(Fence *fence) {
+  std::lock_guard<std::mutex> lock(ember_completion_registry_mutex);
+  ember_completion_registry.erase(fence);
+}
+inline uint64_t EmberCompleted(Fence *fence) { return EmberCompletion(fence)->value(); }
+}
diff --git a/src/d3d12/ember_reblack_completion_core.hpp b/src/d3d12/ember_reblack_completion_core.hpp
new file mode 100644
index 0000000..8c91cb3
--- /dev/null
+++ b/src/d3d12/ember_reblack_completion_core.hpp
@@ -0,0 +1,45 @@
+// Ember D3D12 compatibility candidate; same LGPL terms as enclosing source.
+#pragma once
+#include <cstdint>
+#include <unordered_map>
+namespace ember::completion {
+// Serial orders retirements only WITHIN one producer. It never imposes an
+// execution order on different queues (nor on CPU Signal versus GPU Signal).
+struct Ticket { uint64_t serial=0, value=0, producer=0; };
+// Serialized by the owning fence mutex. A queued API request is not completion.
+// Each queue's collector retires its own CBs in FIFO order. Distinct producers
+// may request in either order and must publish the value that actually retires.
+// In particular B's request(2) before A's request(1) cannot cancel B's later
+// completion(2). D3D12 permits fence rewinds and racing independent producers.
+class Timeline {
+  uint64_t next_serial_=0, completed_;
+  std::unordered_map<uint64_t,uint64_t> retired_;
+public:
+  explicit Timeline(uint64_t initial) : completed_(initial) {}
+  Ticket request(uint64_t value, uint64_t producer=0) {
+    return {++next_serial_,value,producer};
+  }
+  bool complete(Ticket ticket) {
+    auto &last=retired_[ticket.producer];
+    if (ticket.serial<=last) return false; // duplicate or stale SAME producer
+    last=ticket.serial;
+    const bool changed=completed_!=ticket.value;
+    completed_=ticket.value; // a real lower completed Signal is a legal rewind
+    return changed;
+  }
+  uint64_t value() const { return completed_; }
+};
+// Progress means completed work, not new requests, wakeups or repeated polls.
+// candidate=false retains enqueue-origin timing for the diagnostic A/B only.
+struct StallBudget {
+  bool active=false;
+  uint64_t since=0, progress=0;
+  bool expired(bool candidate, uint64_t enqueued, uint64_t now,
+               uint64_t completed_progress, uint64_t limit) {
+    if (!active) { active=true; since=candidate ? now : enqueued; progress=completed_progress; }
+    if (progress!=completed_progress) { progress=completed_progress; since=now; }
+    return now-since>=limit;
+  }
+  void reset() { active=false; }
+};
+}
diff --git a/src/d3d12/ember_reblack_fence.hpp b/src/d3d12/ember_reblack_fence.hpp
new file mode 100644
index 0000000..01bba35
--- /dev/null
+++ b/src/d3d12/ember_reblack_fence.hpp
@@ -0,0 +1,81 @@
+#pragma once
+#include "ember_reblack_fence_core.hpp"
+#include "d3d12_ember_opts.hpp"
+#include <new>
+namespace dxmt {
+namespace fdiag = ::ember::fdiag;
+inline std::atomic<fdiag::File *> ember_fdiag_sink{nullptr};
+inline void EmberFenceDiagInit() {
+  static auto *sink=[]() -> fdiag::File * {
+    if(!EmberD12OptInt("EMBER_D12_FENCE_LOG",0)) return nullptr;
+    auto path=EmberD12Opt("EMBER_D12_FENCE_PATH");
+    if(path.empty()) path="C:\\ember-reblack-fence-"+std::to_string(GetCurrentProcessId())+".bin";
+    auto file=CreateFileA(path.c_str(),GENERIC_READ|GENERIC_WRITE,
+      FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,nullptr,CREATE_ALWAYS,0,nullptr);
+    if(file==INVALID_HANDLE_VALUE) return nullptr;
+    auto mapping=CreateFileMappingA(file,nullptr,PAGE_READWRITE,0,sizeof(fdiag::File),nullptr);
+    auto mem=mapping ? MapViewOfFile(mapping,FILE_MAP_ALL_ACCESS,0,0,sizeof(fdiag::File)) : nullptr;
+    if(mapping) CloseHandle(mapping); CloseHandle(file);
+    return mem ? new(mem) fdiag::File() : nullptr;
+  }();
+  ember_fdiag_sink.store(sink,std::memory_order_release);
+}
+inline uint64_t EmberDiagPtr(const void *p) { return reinterpret_cast<uintptr_t>(p); }
+inline void EmberFenceDiag(unsigned event, const void *q=nullptr, const void *f=nullptr,
+  uint64_t value=0, uint64_t completed=0, uint64_t submitted=0, uint64_t seq=0,
+  uint64_t type=0, uint64_t flags=0, uint64_t depth=0, uint64_t aux=0) {
+  auto *s=ember_fdiag_sink.load(std::memory_order_acquire); if(!s) return;
+
+  uint64_t r[fdiag::Words]{};
+  r[fdiag::Tick]=GetTickCount64(); r[fdiag::Event]=event; r[fdiag::Object]=EmberDiagPtr(q ? q : f);
+  r[fdiag::Queue]=EmberDiagPtr(q); r[fdiag::Fence]=EmberDiagPtr(f); r[fdiag::Value]=value;
+  r[fdiag::Completed]=completed; r[fdiag::Submitted]=submitted; r[fdiag::Seq]=seq; r[fdiag::Type]=type;
+  r[fdiag::Flags]=flags; r[fdiag::Depth]=depth; r[fdiag::Aux]=aux; r[fdiag::Thread]=GetCurrentThreadId(); s->emit(r);
+  fdiag::Row *state=nullptr;
+  if(event==fdiag::QueueCreate || event==fdiag::FenceCreate) state=s->add(event==fdiag::QueueCreate,r[fdiag::Object]);
+  else if(q) state=s->find(true,EmberDiagPtr(q));
+  else if(f) state=s->find(false,EmberDiagPtr(f));
+  // Persist the last actually committed GPU producer even after ring wrap.
+  // This is one producer observation, not an exhaustive ownership relation.
+  if(event==fdiag::SignalSubmit && f) {
+    if(auto *producer=s->find(false,EmberDiagPtr(f))) {
+      producer->v[fdiag::Queue].store(EmberDiagPtr(q));
+      producer->v[fdiag::Type].store(value);
+      producer->v[fdiag::Depth].store(seq);
+    }
+  }
+  if(!state) return;
+  if(event==fdiag::QueueCreate || event==fdiag::FenceCreate) {
+    for(size_t i=1;i<fdiag::Words;++i) state->v[i].store(r[i]);
+    state->v[fdiag::Reserved].store(event==fdiag::QueueCreate ? type : value); // original queue type / fence initial value
+  } else if(q) {
+    state->v[fdiag::Tick].store(r[fdiag::Tick]);
+    if(event==fdiag::QueueSubmit) state->v[fdiag::Submitted].store(seq);
+    if(event==fdiag::QueueComplete) state->v[fdiag::Completed].store(seq);
+    if(event==fdiag::DeferredHead) {
+      for(auto i : {fdiag::Fence,fdiag::Value,fdiag::Type,fdiag::Depth,fdiag::Aux}) state->v[i].store(r[i]);
+    }
+    if(event==fdiag::QueueDestroy) state->v[fdiag::Flags].store(1); // tombstone
+  } else {
+    state->v[fdiag::Tick].store(r[fdiag::Tick]);
+    if(event==fdiag::FenceObserve || event==fdiag::CpuSignalDone) {
+      state->v[fdiag::Completed].store(completed); state->v[fdiag::Submitted].store(submitted);
+    }
+    if(event==fdiag::CpuSignalDone) { state->v[fdiag::Value].store(value); state->v[fdiag::Seq].fetch_add(1); }
+    if(event==fdiag::FenceDestroy) state->v[fdiag::Flags].fetch_or(1ull<<63);
+  }
+}
+inline void EmberFenceDiagPending(const void *q, const void *f, uint64_t serial,
+                                 unsigned kind, uint64_t value, bool clear) {
+  if(auto *s=ember_fdiag_sink.load(std::memory_order_acquire)) {
+  
+    uint64_t r[fdiag::Words]{}; r[fdiag::Tick]=GetTickCount64(); r[fdiag::Event]=fdiag::DeferredPush;
+    r[fdiag::Object]=EmberDiagPtr(q); r[fdiag::Queue]=EmberDiagPtr(q); r[fdiag::Fence]=EmberDiagPtr(f);
+    r[fdiag::Seq]=serial; r[fdiag::Type]=kind; r[fdiag::Value]=value;
+    s->pendingOp(EmberDiagPtr(q),serial,r,clear);
+  }
+}
+inline void EmberFenceDiagStop(unsigned reason) {
+  if(auto *s=ember_fdiag_sink.load(std::memory_order_acquire)) s->snapshot(reason,GetTickCount64());
+}
+}
diff --git a/src/d3d12/ember_reblack_fence_core.hpp b/src/d3d12/ember_reblack_fence_core.hpp
new file mode 100644
index 0000000..ab0c57c
--- /dev/null
+++ b/src/d3d12/ember_reblack_fence_core.hpp
@@ -0,0 +1,86 @@
+// Ember internal diagnostics. Fixed storage; no heap, locks, or native calls.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+namespace ember::fdiag {
+constexpr uint64_t Magic = 0x3346435245424d45ull; // EMBERCF3
+constexpr size_t Capacity = 32768, Queues = 128, Fences = 4096, Words = 16;
+enum Field { Commit, Tick, Event, Object, Queue, Fence, Value, Completed,
+             Submitted, Seq, Type, Flags, Depth, Aux, Thread, Reserved };
+enum Kind { FenceCreate=1, FenceDestroy, CpuSignalRequest, CpuSignalDone, CpuWait,
+            QueueCreate, QueueDestroy, SignalRequest, SignalSubmit, WaitRequest,
+            DeferredPush, DeferredHead, QueueSubmit, QueueComplete, FenceObserve,
+            Stop, QueueSnapshot, FenceSnapshot, DeferredRun };
+struct Row { std::atomic<uint64_t> v[Words]{}; };
+static_assert(sizeof(Row) == 128 && std::atomic<uint64_t>::is_always_lock_free);
+struct File {
+  uint64_t magic=Magic, version=1, capacity=Capacity, words=Words;
+  std::atomic<uint64_t> next{0}, dropped{0}, nq{0}, nf{0};
+  Row queues[Queues], fences[Fences], pending[Queues*128], records[Capacity];
+  // Try once: a preempted writer cannot block another thread or fail-stop.
+  void emit(const uint64_t (&r)[Words]) {
+    auto ticket = next.fetch_add(1, std::memory_order_relaxed) + 1;
+    auto &row = records[(ticket-1)%Capacity];
+    auto old = row.v[Commit].load(std::memory_order_relaxed);
+    constexpr uint64_t Busy = 1ull<<63;
+    if ((old & Busy) || !row.v[Commit].compare_exchange_strong(old, ticket|Busy)) {
+      dropped.fetch_add(1, std::memory_order_relaxed); return;
+    }
+    for (size_t i=1; i<Words; ++i) row.v[i].store(r[i], std::memory_order_relaxed);
+    row.v[Commit].store(ticket, std::memory_order_release);
+  }
+  Row *add(bool queue, uint64_t object) {
+    auto n = (queue ? nq : nf).fetch_add(1);
+    auto cap = queue ? Queues : Fences;
+    if (n>=cap) { dropped.fetch_add(1); return nullptr; }
+    auto *r = &(queue ? queues : fences)[n];
+    r->v[Object].store(object, std::memory_order_release);
+    return r;
+  }
+  Row *find(bool queue, uint64_t object) {
+    auto n = (queue ? nq : nf).load(std::memory_order_acquire);
+    auto cap = queue ? Queues : Fences;
+    if (n>cap) n=cap;
+    // Latest allocation wins if a COM address is reused. Slots never recycle.
+    while (n) { auto &r=(queue ? queues : fences)[--n];
+      if (r.v[Object].load(std::memory_order_acquire)==object) return &r; }
+    return nullptr;
+  }
+  // One pending slot per queue/op serial modulo 128. Overflow is explicit;
+  // never overwrite a still pending producer. Normal callers hold defer mutex.
+  void pendingOp(uint64_t queue, uint64_t serial, const uint64_t (&r)[Words], bool clear) {
+    auto *q=find(true,queue); if(!q) return;
+    auto index=size_t(q-queues)*128+(serial%128);
+    auto &row=pending[index];
+    if(clear) { if(row.v[Commit].load()==serial+1) row.v[Commit].store(0); return; }
+    if(row.v[Commit].load()!=0) { dropped.fetch_add(1); return; }
+    for(size_t i=1;i<Words;++i) row.v[i].store(r[i]);
+    row.v[Commit].store(serial+1,std::memory_order_release);
+  }
+  void snapshot(uint64_t reason, uint64_t tick) {
+    uint64_t r[Words]{}; r[Tick]=tick; r[Event]=Stop; r[Aux]=reason; emit(r);
+    for (size_t kind=0; kind<2; ++kind) {
+      auto cap=kind ? Fences : Queues;
+      auto count=(kind ? nf : nq).load(); if(count>cap) count=cap;
+      for(size_t j=0;j<count;++j) {
+        auto &s=(kind ? fences : queues)[j];
+        for(size_t i=1;i<Words;++i) r[i]=s.v[i].load(std::memory_order_relaxed);
+        r[Tick]=tick; r[Event]=kind ? FenceSnapshot : QueueSnapshot; emit(r);
+      }
+    }
+  }
+};
+static_assert(offsetof(File, queues)==64);
+static_assert(sizeof(File)==64+(Queues+Fences+Queues*128+Capacity)*128);
+// Candidate: budget starts when a Wait reaches the FIFO head, rather than when
+// enqueued behind unrelated work. Still bounded; never bypasses the dependency.
+struct HeadBudget {
+  uint64_t since=0; bool active=false;
+  bool expired(bool candidate, uint64_t enqueued, uint64_t now, uint64_t limit) {
+    if(!active) { active=true; since=now; }
+    return now-(candidate ? since : enqueued)>=limit;
+  }
+  void reset() { active=false; }
+};
+}
diff --git a/src/d3d12/ember_reblack_owned.hpp b/src/d3d12/ember_reblack_owned.hpp
new file mode 100644
index 0000000..cbad494
--- /dev/null
+++ b/src/d3d12/ember_reblack_owned.hpp
@@ -0,0 +1,20 @@
+// Ember-only compatibility candidate, same LGPL terms as the enclosing source.
+#pragma once
+#include <vector>
+
+namespace dxmt::ember {
+// Preserve omitted arrays: D3D12 gives nullptr a meaning distinct from zero data.
+// Queue operations must own caller arrays before returning to the application.
+template <typename T> class OwnedTileArray {
+  bool provided_;
+  std::vector<T> values_;
+  T empty_{};
+public:
+  OwnedTileArray(const T *data, unsigned count) : provided_(data != nullptr) {
+    if (data && count) values_.assign(data, data + count);
+  }
+  const T *data() const {
+    return !provided_ ? nullptr : values_.empty() ? &empty_ : values_.data();
+  }
+};
+} // namespace dxmt::ember
diff --git a/src/d3d12/ember_resource_zero.hpp b/src/d3d12/ember_resource_zero.hpp
new file mode 100644
index 0000000..e3fa57f
--- /dev/null
+++ b/src/d3d12/ember_resource_zero.hpp
@@ -0,0 +1,216 @@
+#pragma once
+
+// Local compatibility fix. Never clear a placed resource: its heap may contain
+// live aliased data. Reserved resources have no allocation to initialize.
+#include "d3d12_device.hpp"
+#include "dxmt_format.hpp"
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+namespace dxmt {
+
+inline bool EmberNeedsZero(bool placed, D3D12_HEAP_FLAGS flags) {
+  return !placed && !(flags & D3D12_HEAP_FLAG_CREATE_NOT_ZEROED);
+}
+
+// Keep temporary memory bounded even for 3D textures. One strip is reused for
+// every mip, slice and depth plane; the GPU fills it, then blits zero bits.
+struct EmberZeroLayout {
+  uint32_t row_bytes, rows_per_strip, block_height;
+  uint64_t staging_bytes;
+};
+
+inline bool EmberMakeZeroLayout(uint64_t width, uint32_t bytes, bool bc, EmberZeroLayout &out) {
+  if (!width || !bytes || width > UINT32_MAX)
+    return false;
+  const uint64_t blocks = bc ? (width + 3) / 4 : width;
+  const uint64_t row = (blocks * bytes + 255) & ~uint64_t(255);
+  if (!row || row > UINT32_MAX)
+    return false;
+  const uint64_t rows = std::max<uint64_t>(1, (8 * 1024 * 1024) / row);
+  out = {uint32_t(row), uint32_t(rows), bc ? 4u : 1u, row * rows};
+  return true;
+}
+
+class EmberZeroCommands {
+  MTLD3D12Device *device_;
+  WMT::Reference<WMT::CommandQueue> queue_;
+  WMT::Reference<WMT::CommandBuffer> buffer_;
+public:
+  explicit EmberZeroCommands(MTLD3D12Device *device) : device_(device) {
+    queue_ = device_->GetMTLDevice().newCommandQueue(1);
+    if (queue_) {
+      queue_.addResidencySet(device_->GetGlobalResidencySet());
+      buffer_ = queue_.commandBuffer();
+    }
+  }
+  WMT::CommandBuffer buffer() { return buffer_; }
+  explicit operator bool() const { return bool(buffer_); }
+  HRESULT finish() {
+    buffer_.commit();
+    // Publication waits for this allocation only, never an application queue
+    // (which may be waiting for an as-yet unsignalled application fence).
+    buffer_.waitUntilCompleted();
+    if (buffer_.status() != WMTCommandBufferStatusCompleted) {
+      ERR("D3D12 resource zero initialization failed");
+      return E_FAIL;
+    }
+    return S_OK;
+  }
+};
+
+inline void EmberEncodeZeroBuffer(WMT::BlitCommandEncoder encoder, WMT::Buffer buffer, uint64_t bytes) {
+  wmtcmd_blit_fillbuffer fill = {};
+  fill.type = WMTBlitCommandFillBuffer;
+  fill.buffer = buffer.handle;
+  fill.length = bytes;
+  encoder.encodeCommands(reinterpret_cast<const wmtcmd_blit_nop *>(&fill));
+}
+
+inline HRESULT EmberZeroBuffer(MTLD3D12Device *device, WMT::Buffer buffer, uint64_t bytes) {
+  if (!buffer)
+    return E_OUTOFMEMORY;
+  if (bytes & 3)
+    return E_INVALIDARG; // Metal fillBuffer requires a 4-byte range
+  EmberZeroCommands commands(device);
+  if (!commands)
+    return E_OUTOFMEMORY;
+  auto encoder = commands.buffer().blitCommandEncoder();
+  if (!encoder)
+    return E_OUTOFMEMORY;
+  EmberEncodeZeroBuffer(encoder, buffer, bytes);
+  encoder.endEncoding();
+  return commands.finish();
+}
+
+inline HRESULT EmberZeroHeap(MTLD3D12Device *device, WMT::Heap heap, uint64_t bytes, WMTResourceOptions options) {
+  if (!heap)
+    return E_OUTOFMEMORY;
+  EmberZeroCommands commands(device);
+  if (!commands)
+    return E_OUTOFMEMORY;
+  auto encoder = commands.buffer().blitCommandEncoder();
+  if (!encoder)
+    return E_OUTOFMEMORY;
+  // Do not require a single Metal buffer as large as the entire D3D heap.
+  // Placement buffers cover disjoint 64 MiB regions and stay alive until done.
+  std::vector<WMT::Reference<WMT::Buffer>> aliases;
+  for (uint64_t offset = 0; offset < bytes;) {
+    WMTBufferInfo info = {};
+    info.length = std::min<uint64_t>(64 * 1024 * 1024, bytes - offset);
+    info.options = options;
+    auto buffer = heap.newBuffer(info, offset);
+    if (!buffer) {
+      encoder.endEncoding();
+      return E_OUTOFMEMORY;
+    }
+    EmberEncodeZeroBuffer(encoder, buffer, info.length);
+    aliases.push_back(std::move(buffer));
+    offset += info.length;
+  }
+  encoder.endEncoding();
+  // Temporary aliases are released before CreateHeap publishes the heap.
+  return commands.finish();
+}
+
+inline HRESULT EmberZeroTexture(MTLD3D12Device *device, WMT::Texture texture, const WMTTextureInfo &info) {
+  if (!texture)
+    return E_OUTOFMEMORY;
+  EmberZeroCommands commands(device);
+  if (!commands)
+    return E_OUTOFMEMORY;
+  const auto planes = DepthStencilPlanarFlags(WMTPixelFormat(ORIGINAL_FORMAT(info.pixel_format)));
+  const bool render = info.usage & WMTTextureUsageRenderTarget;
+  if (render) {
+    for (uint32_t mip = 0; mip < info.mipmap_level_count; ++mip) {
+      const uint32_t depth = std::max(1u, info.depth >> mip);
+      for (uint32_t slice = 0; slice < info.array_length; ++slice) {
+        for (uint32_t z = 0; z < depth; ++z) {
+          WMTRenderPassInfo pass;
+          WMT::InitializeRenderPassInfo(pass);
+          pass.render_target_array_length = 1;
+          pass.render_target_width = std::max(1u, info.width >> mip);
+          pass.render_target_height = std::max(1u, info.height >> mip);
+          pass.default_raster_sample_count = info.sample_count;
+          auto attachment = [&](auto &a) {
+            a.texture = texture.handle;
+            a.level = mip;
+            a.slice = slice;
+            a.depth_plane = z;
+            a.load_action = WMTLoadActionClear;
+            a.store_action = WMTStoreActionStore;
+          };
+          if (planes & 1) { attachment(pass.depth); pass.depth.clear_depth = 0; }
+          if (planes & 2) { attachment(pass.stencil); pass.stencil.clear_stencil = 0; }
+          if (!planes) { attachment(pass.colors[0]); pass.colors[0].clear_color = {0, 0, 0, 0}; }
+          auto encoder = commands.buffer().renderCommandEncoder(pass);
+          if (!encoder)
+            return E_FAIL;
+          encoder.endEncoding();
+        }
+      }
+    }
+    return commands.finish();
+  }
+
+  if (info.sample_count > 1)
+    return E_INVALIDARG; // multisample textures must be renderable
+  // Pixel format, not the potentially typeless D3D format, sets copy geometry.
+  const bool bc = IsBlockCompressionFormat(info.pixel_format);
+  const uint32_t texel = planes ? (planes == 2 ? 1 :
+      ORIGINAL_FORMAT(info.pixel_format) == WMTPixelFormatDepth16Unorm ? 2 : 4) : MTLGetTexelSize(info.pixel_format);
+  EmberZeroLayout layout;
+  if (!EmberMakeZeroLayout(info.width, texel, bc, layout))
+    return E_INVALIDARG;
+  WMTBufferInfo staging_info = {};
+  staging_info.length = layout.staging_bytes;
+  staging_info.options = WMTResourceStorageModePrivate; // tracked: fill -> copy
+  auto staging = device->GetMTLDevice().newBuffer(staging_info);
+  if (!staging)
+    return E_OUTOFMEMORY;
+  device->RegisterResidency(staging);
+  struct Residency {
+    MTLD3D12Device *device; WMT::Buffer buffer;
+    ~Residency() { device->UnregisterResidency(buffer); }
+  } residency{device, staging};
+  auto encoder = commands.buffer().blitCommandEncoder();
+  if (!encoder)
+    return E_OUTOFMEMORY;
+  EmberEncodeZeroBuffer(encoder, staging, layout.staging_bytes);
+  // End the fill encoder before copies read the tracked staging allocation.
+  encoder.endEncoding();
+  encoder = commands.buffer().blitCommandEncoder();
+  if (!encoder)
+    return E_OUTOFMEMORY;
+  for (uint32_t mip = 0; mip < info.mipmap_level_count; ++mip) {
+    const uint32_t width = std::max(1u, info.width >> mip);
+    const uint32_t height = std::max(1u, info.height >> mip);
+    const uint32_t depth = std::max(1u, info.depth >> mip);
+    const uint64_t strip = uint64_t(layout.rows_per_strip) * layout.block_height;
+    for (uint32_t slice = 0; slice < info.array_length; ++slice) {
+      for (uint32_t z = 0; z < depth; ++z) {
+        for (uint64_t y = 0; y < height; y += strip) {
+          for (uint32_t plane = 0; plane < (planes == 3 ? 2u : 1u); ++plane) {
+          wmtcmd_blit_copy_from_buffer_to_texture_withblitoption copy = {};
+          copy.type = WMTBlitCommandCopyFromBufferToTextureWithBlitOption;
+          copy.options = planes == 3 ? (plane ? WMTBlitOptionStencilFromDepthStencil : WMTBlitOptionDepthFromDepthStencil) : WMTBlitOptionNone;
+          copy.src = staging.handle;
+          copy.bytes_per_row = layout.row_bytes;
+          const uint32_t rows = uint32_t(std::min<uint64_t>(strip, height - y));
+          copy.bytes_per_image = layout.row_bytes * ((rows + layout.block_height - 1) / layout.block_height);
+          copy.size = {width, rows, 1};
+          copy.dst = texture.handle;
+          copy.slice = slice;
+          copy.level = mip;
+          copy.origin = {0, uint32_t(y), z};
+          encoder.encodeCommands(reinterpret_cast<const wmtcmd_blit_nop *>(&copy));
+          }
+        }
+      }
+    }
+  }
+  encoder.endEncoding();
+  return commands.finish();
+}
+} // namespace dxmt
diff --git a/src/d3d12/ember_so_draw.inc b/src/d3d12/ember_so_draw.inc
new file mode 100644
index 0000000..6f06bb8
--- /dev/null
+++ b/src/d3d12/ember_so_draw.inc
@@ -0,0 +1,141 @@
+  // Ember(d12so): D3D12 stream output on top of the AIR VS emulation (D3D11 path), which writes each
+  // vertex to table[0].buf + (vertex_id - base_vertex) * stride but knows nothing about the D3D12
+  // BufferFilledSize append counter. Two tiny vertex-only passes around the draw provide it:
+  //   prep: table[0].buf = BufferLocation + *filled  (scratch instead when the draw would overflow)
+  //   post: *filled += written bytes                 (unchanged on overflow, like a dropped draw)
+  struct EmberSOParams {
+    uint64_t buf, filled, scratch;
+    uint32_t size, bytes, start_bytes, pad; // pad: guard bytes in case [[base_vertex]] is 0
+  };
+
+  static bool EmberSOPipelines(WMT::Device metal, obj_handle_t &prep, obj_handle_t &post) {
+    static std::mutex lock;
+    static bool tried = false;
+    static WMT::Reference<WMT::RenderPipelineState> s_prep, s_post;
+    std::lock_guard<std::mutex> guard(lock);
+    if (!tried) {
+      tried = true;
+      static const char source[] =
+          "#include <metal_stdlib>\n"
+          "using namespace metal;\n"
+          "struct P { device uchar *buf; device uint *filled; device uchar *scratch; uint size; uint bytes; uint start_bytes; uint extra; };\n"
+          "struct E { device uchar *buf; device uint *cnt; };\n"
+          "vertex void ember_so_prep(constant P &p [[buffer(30)]], device E *t [[buffer(29)]]) {\n"
+          "  uint f = p.filled ? *p.filled : 0u;\n"
+          "  bool fits = ulong(f) + ulong(p.bytes) + ulong(p.extra) <= ulong(p.size);\n"
+          "  device uchar *base = fits ? p.buf + f : p.scratch;\n"
+          "  t[0].buf = base - p.start_bytes;\n"
+          "  t[0].cnt = nullptr;\n"
+          "}\n"
+          "vertex void ember_so_post(constant P &p [[buffer(30)]]) {\n"
+          "  if (!p.filled) return;\n"
+          "  uint f = *p.filled;\n"
+          "  if (ulong(f) + ulong(p.bytes) <= ulong(p.size)) *p.filled = f + p.bytes;\n"
+          "}\n";
+      WMT::Reference<WMT::Error> err;
+      auto lib = metal.newLibraryWithSource(std::string_view(source, sizeof(source) - 1), err);
+      if (!lib) {
+        ERR("Ember SO: helper shader compile failed: ", err.description().getUTF8String());
+        return false;
+      }
+      for (auto [name, out] : {std::pair{"ember_so_prep", &s_prep}, std::pair{"ember_so_post", &s_post}}) {
+        WMTRenderPipelineInfo info;
+        WMT::InitializeRenderPipelineInfo(info);
+        info.rasterization_enabled = false;
+        auto fn = lib.newFunction(name);
+        if (!fn) return false;
+        info.vertex_function = fn;
+        WMT::Reference<WMT::Error> perr;
+        *out = metal.newRenderPipelineState(info, perr);
+        if (!*out) {
+          ERR("Ember SO: helper pipeline failed: ", perr.description().getUTF8String());
+          return false;
+        }
+      }
+    }
+    if (!s_prep || !s_post) return false;
+    prep = s_prep.handle;
+    post = s_post.handle;
+    return true;
+  }
+
+  // Returns false to let the caller issue the ordinary draw: either SO was not possible, or the
+  // stream is also rasterized (the SO pass does not rasterize).
+  bool EmberDrawSO(WMTPrimitiveType primitive_type, uint32_t count, uint32_t instances, uint32_t start,
+                   uint32_t start_instance) {
+    auto &view = ember_so_views_[0];
+    auto *p = pso_graphics_.ptr();
+    // Step 1 scope: list topologies, one instance (AIR orders by vertex id, not primitive/instance).
+    // start != 0: the AIR emulation subtracts [[base_vertex]]; the guard (extra) also covers the
+    // case where that is 0 for non-indexed draws, so a wrong assumption cannot write past the view.
+    if (!view.BufferLocation || !count || instances != 1 ||
+        (primitive_type != WMTPrimitiveTypePoint && primitive_type != WMTPrimitiveTypeLine &&
+         primitive_type != WMTPrimitiveTypeTriangle))
+      return false;
+    uint64_t bytes = uint64_t(count) * p->ember_so_stride;
+    uint64_t extra = uint64_t(start) * p->ember_so_stride;
+    if (bytes + extra > (1u << 22)) return false;
+    uint64_t buf_off = 0, filled_off = 0;
+    auto *buf = device_->LookupBufferByVA(view.BufferLocation, &buf_off);
+    auto *filled = view.BufferFilledSizeLocation ? device_->LookupBufferByVA(view.BufferFilledSizeLocation, &filled_off) : nullptr;
+    if (!buf || (view.BufferFilledSizeLocation && !filled)) return false;
+    obj_handle_t prep, post;
+    if (!EmberSOPipelines(device_->GetMTLDevice(), prep, post)) return false;
+
+    auto [scratch_ptr, scratch_off] = allocator_->AllocateGPUHeap(bytes + extra, 16);
+    (void)scratch_ptr;
+    auto [table_ptr, table_off] = allocator_->AllocateGPUHeap(64, 16);
+    memset(table_ptr, 0, 64);
+    auto [param_ptr, param_off] = allocator_->AllocateGPUHeap(sizeof(EmberSOParams), 16);
+    auto *params = reinterpret_cast<EmberSOParams *>(param_ptr);
+    params->buf = buf->gpuAddress() + buf_off;
+    params->filled = filled ? filled->gpuAddress() + filled_off : 0;
+    params->scratch = allocator_->gpu_heap_buffer_address_ + scratch_off;
+    params->size = (uint32_t)std::min<uint64_t>(view.SizeInBytes, UINT32_MAX);
+    params->bytes = (uint32_t)bytes;
+    params->start_bytes = 0;
+    params->pad = (uint32_t)extra;
+
+    auto set_pso = [&](obj_handle_t pso) {
+      auto &c = allocator_->EncodeRenderCommand<wmtcmd_render_setpso>();
+      c.type = WMTRenderCommandSetPSO;
+      c.pso = pso;
+    };
+    auto set_buffer = [&](uint8_t index, uint64_t offset) {
+      auto &c = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      c.type = WMTRenderCommandSetVertexBuffer;
+      c.buffer = allocator_->gpu_heap_buffer_;
+      c.offset = offset;
+      c.index = index;
+    };
+    auto barrier = [&]() {
+      auto &mb = allocator_->EncodeRenderCommand<wmtcmd_render_memory_barrier>();
+      mb.type = WMTRenderCommandMemoryBarrier;
+      mb.scope = WMTBarrierScopeBuffers;
+      mb.stages_after = WMTRenderStageVertex;
+      mb.stages_before = WMTRenderStageVertex;
+    };
+    auto draw = [&](WMTPrimitiveType type, uint64_t first, uint64_t n, uint32_t base_instance) {
+      auto &d = allocator_->EncodeRenderCommand<wmtcmd_render_draw>();
+      d.type = WMTRenderCommandDraw;
+      d.primitive_type = type;
+      d.vertex_start = first;
+      d.vertex_count = n;
+      d.instance_count = 1;
+      d.base_instance = base_instance;
+    };
+    set_pso(prep);
+    set_buffer(30, param_off);
+    set_buffer(29, table_off);
+    draw(WMTPrimitiveTypePoint, 0, 1, 0);
+    barrier();
+    set_pso(p->ember_so_pso.handle);
+    set_buffer(SM50_BINDING_INDEX_STREAM_OUTPUT0, table_off);
+    draw(primitive_type, start, count, start_instance);
+    set_pso(post);
+    set_buffer(30, param_off);
+    draw(WMTPrimitiveTypePoint, 0, 1, 0);
+    barrier();
+    set_pso(p->pso.handle);
+    return p->ember_so_no_raster;
+  }
