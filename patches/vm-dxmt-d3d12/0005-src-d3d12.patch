+// Fixed-size, file-backed records. Open/map once during queue initialization.
+// Drain/fail-stop only stores scalars and atomically publishes a record: no
+// logger, allocator, file write/flush, or new lock on that path.
+struct EmberDrainRecord {
+  uint64_t committed, tick, event, queue, what, depth, kind, fence, value, submitted, completed;
+};
+static_assert(sizeof(EmberDrainRecord) == 88);
+struct EmberDrainFile {
+  uint64_t magic, version;
+  volatile LONG64 next;
+  uint64_t reserved[5];
+  EmberDrainRecord records[128];
+  void record(EmberDrainRecord r) {
+    const auto index = InterlockedIncrement64(&next) - 1;
+    if (index >= 128) return;
+    r.committed = 0;
+    r.tick = GetTickCount64();
+    records[index] = r;
+    InterlockedExchange64(reinterpret_cast<volatile LONG64 *>(&records[index].committed), index + 1);
+  }
+};
+static_assert(offsetof(EmberDrainFile, records) == 64);
+static EmberDrainFile *EmberDrainSink() {
+  static EmberDrainFile *sink = []() -> EmberDrainFile * {
+    if (!EmberD12OptInt("EMBER_D12_DRAIN_LOG", 0)) return nullptr;
+    auto path = EmberD12Opt("EMBER_D12_DRAIN_PATH");
+    if (path.empty()) path = "C:\\ember-reblack-drain-" + std::to_string(GetCurrentProcessId()) + ".bin";
+    HANDLE file = CreateFileA(path.c_str(), GENERIC_READ | GENERIC_WRITE,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, CREATE_ALWAYS, 0, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return nullptr;
+    HANDLE mapping = CreateFileMappingA(file, nullptr, PAGE_READWRITE, 0, sizeof(EmberDrainFile), nullptr);
+    auto *view = mapping ? static_cast<EmberDrainFile *>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(EmberDrainFile))) : nullptr;
