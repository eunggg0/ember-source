+    } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  }
+  HRESULT STDMETHODCALLTYPE LoadGraphicsPipeline(const WCHAR *name, const D3D12_GRAPHICS_PIPELINE_STATE_DESC *d,
+      REFIID iid, void **out) override { return loadDesc(name, d, iid, out); }
