From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 8/15] src-nativemetal: Ember changes

Base: DXMT 7c8dee1 with submodules
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/src/nativemetal/meson.build b/src/nativemetal/meson.build
index 2c037f8..5743fae 100644
--- a/src/nativemetal/meson.build
+++ b/src/nativemetal/meson.build
@@ -1,28 +1,40 @@
+# Ember vmd3d12-1027: 네이티브 winemetal — 썽크가 unix 쪽 함수를 같은 이미지에서 직접 부른다(__wine_unix_call_funcs).
+# Ember 확장(DXIL·FG·Neural) 썽크와 unix 구현을 함께 넣는다.
+add_languages('objc', native: false, required: true)
+
 winemetal_src = [
   '../winemetal/winemetal_thunks.c',
+  '../winemetal/ember_dxil_thunks.c',
+  '../winemetal/ember_fg_thunks.c',
+  '../winemetal/ember_neural_thunks.c',
   '../winemetal/unix/winemetal_unix.c',
   '../winemetal/unix/cache.c',
+  '../winemetal/unix/ember_dxil_unix.m',
+  '../winemetal/unix/ember_fg_unix.c',
+  '../winemetal/unix/ember_neural_unix.m',
 ]
-winemetal_link_depends = []
 
 winemetal_ld_args = [
   '-weak_framework', 'CoreFoundation', '-weak_framework', 'Metal',
   '-framework', 'MetalFX', '-weak_framework', 'Foundation',
   '-weak_framework', 'CoreGraphics', '-weak_framework', 'QuartzCore',
   '-weak_framework', 'ColorSync',   '-weak_framework', 'Cocoa',
+  '-weak_framework', 'CoreML', '-weak_framework', 'CoreVideo', '-weak_framework', 'IOSurface',
   '-lsqlite3',
 ]
 
-winemetal_dll = shared_library('winemetal', winemetal_src,
-  name_prefix         : '',
-  dependencies        : [ airconv_dep_darwin ],
+# 10-28: VM 호스트용 한 덩어리(libember-d3d12-native.dylib)에 link_whole 로 넣는다 — 정적 라이브러리.
+winemetal_lib = static_library('winemetal', winemetal_src,
+  dependencies        : [ airconv_dep_darwin, directx_native_dep ],
   include_directories : [ dxmt_include_path, include_directories('.') ],
-  c_args              : ['-ObjC', '-DDXMT_NATIVE=1'],
-  link_args           : winemetal_ld_args,
-  build_rpath         : '@loader_path/:@loader_path/../../',
+  # UTM libdxmt-native 와 같은 프로세스에 올라가므로 ObjC 클래스 이름이 겹치면 안 된다(cache.c)
+  c_args              : ['-ObjC', '-DDXMT_NATIVE=1', '-Wno-unguarded-availability-new', '-DCacheReader=EmberD12CacheReader', '-DCacheWriter=EmberD12CacheWriter'],
+  objc_args           : ['-DDXMT_NATIVE=1', '-Wno-unguarded-availability-new'],
+  pic                 : true,
 )
 
 winemetal_dep = declare_dependency(
-  link_with           : [ winemetal_dll ],
+  link_args           : winemetal_ld_args,
+  dependencies        : [ directx_native_dep ],
   include_directories : [ include_directories('../winemetal') ],
 )
