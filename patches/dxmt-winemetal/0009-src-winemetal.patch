+/* Ember 진단(EMBER_MTL_ENCODER_STATUS=1): 명령 버퍼에 인코더 실행 상태를 켜서 GPU 오류(행·폴트) 때 어느 인코더(라벨)가
+ * 끝났고/멈췄고/영향받았는지 stderr 에 적는다. d3d12 의 EMBER_D12_LABELS=1 과 같이 쓴다. 꺼져 있으면 예전 그대로. */
+static int ember_enc_status = -1;
+
+/* 스팀이 띄운 게임엔 환경 변수가 안 갈 수 있다 — d3d12 스위치처럼 보틀의 C:\ember-d12.cfg 에 NAME=1 줄이 있어도 켠다 */
+static int
+ember_cfg_flag(const char *name) {
+  const char *v = getenv(name);
+  if (v && *v)
+    return atoi(v) != 0;
+  const char *prefix = getenv("WINEPREFIX");
+  if (!prefix)
+    return 0;
+  char path[1024];
+  snprintf(path, sizeof(path), "%s/drive_c/ember-d12.cfg", prefix);
+  FILE *f = fopen(path, "rb");
+  if (!f)
+    return 0;
+  char buf[4096];
+  size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+  buf[n] = 0;
+  fclose(f);
+  size_t len = strlen(name);
+  for (char *p = buf; (p = strstr(p, name)); p += len)
+    if ((p == buf || p[-1] == '\n' || p[-1] == '\r') && p[len] == '=')
+      return atoi(p + len + 1) != 0;
+  return 0;
+}
