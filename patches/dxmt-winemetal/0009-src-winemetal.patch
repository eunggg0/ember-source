+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_COPY_BUFFER: {
+        const struct ember_sparse_copy_buffer_op *in = p->ops.ptr;
+        MTL4CopySparseBufferMappingOperation *ops = calloc(p->op_count ? p->op_count : 1, sizeof(*ops));
