+                                                            toBuffer:(id<MTLBuffer>)p->resource2
+                                                          operations:ops count:p->op_count];
+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_COPY_TEXTURE: {
+        const struct ember_sparse_copy_texture_op *in = p->ops.ptr;
