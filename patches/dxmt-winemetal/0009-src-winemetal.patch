+static NTSTATUS
+_MTLCommandBuffer_presentDrawable(void *obj) {
+  struct unixcall_generic_obj_obj_noret *params = obj;
+  ember_track_present((id<MTLDrawable>)params->arg, 0, 0, 0);
+  [(id<MTLCommandBuffer>)params->handle presentDrawable:(id<MTLDrawable>)params->arg];
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLCommandBuffer_presentDrawableAfterMinimumDuration(void *obj) {
+  struct unixcall_generic_obj_obj_double_noret *params = obj;
+  /* Ember: -1 은 DXMT 보간 프레임 표식 — 바로 표시하고 지연 측정에서는 뺀다(원본 프레임만 입력 지연을 뜻한다). */
+  if (params->arg1 < 0) {
+    ember_track_present((id<MTLDrawable>)params->arg0, 1, 0, 0);
+    [(id<MTLCommandBuffer>)params->handle presentDrawable:(id<MTLDrawable>)params->arg0];
+    return STATUS_SUCCESS;
+  }
+  ember_track_present((id<MTLDrawable>)params->arg0, 0, 0, 0);
+  [(id<MTLCommandBuffer>)params->handle presentDrawable:(id<MTLDrawable>)params->arg0
+                                   afterMinimumDuration:params->arg1];
+  return STATUS_SUCCESS;
+}
+
+/* Ember: 썽크 153 — 지정 시각(CACurrentMediaTime 초) 뒤 표시. flags 비트0 = 보간 프레임. time<=0 이면 즉시. */
+static NTSTATUS
+_MTLCommandBuffer_presentDrawableAtTime(void *obj) {
+  struct unixcall_ember_present_at_time *params = obj;
+  id<MTLDrawable> d = (id<MTLDrawable>)params->drawable;
+  id<MTLCommandBuffer> cb = (id<MTLCommandBuffer>)params->handle;
+  /* 비트1: 즉시 표시하되 time 은 페이서가 기대한 칸(정렬 통계 at=/late= 용) */
+  ember_track_present(d, (int)(params->flags & 1), params->time > 0 ? params->time : 0, (int)(params->flags & 2));
+  if (params->time > 0 && !(params->flags & 2))
+    [cb presentDrawable:d atTime:params->time];
+  else if (params->flags >> 8)   /* 실험: 비트 8~ = afterMinimumDuration(µs) — 표시 경로 차이 확인용 */
+    [cb presentDrawable:d afterMinimumDuration:(double)(params->flags >> 8) * 1e-6];
+  else
+    [cb presentDrawable:d];
+  return STATUS_SUCCESS;
+}
