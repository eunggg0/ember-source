+ * 실측(2026-09-24, 로아 FEX 시작 중 3번에 2번): 두 번째 D3D11 장치를 만들 때 핸들 자리에 태그 포인터(NSNumber)가 와서
+ * newComputePipelineState 가 "unrecognized selector" 로 프로세스를 죽였다. 애플 실리콘 GPU 는 하나뿐이므로
+ * 잘못된 핸들이면 시스템 기본 장치로 대신하고, 원인 추적을 위해 한 번 기록한다. 같은 핸들은 한 번만 검사한다. */
+static _Atomic(obj_handle_t) ember_good_device;
+static id<MTLDevice>
+ember_device(obj_handle_t h, const char *site) {
+  static id<MTLDevice> fallback;
+  static _Atomic int reported;
+  if (h && h == atomic_load_explicit(&ember_good_device, memory_order_relaxed))
+    return (id<MTLDevice>)h;
+  if (h && !(h >> 63) && malloc_zone_from_ptr((void *)h) &&
+      [(id)h conformsToProtocol:@protocol(MTLDevice)]) {
+    atomic_store_explicit(&ember_good_device, h, memory_order_relaxed);
+    return (id<MTLDevice>)h;
+  }
+  if (!fallback)
+    fallback = MTLCreateSystemDefaultDevice();
+  if (atomic_fetch_add(&reported, 1) < 8) {
+    void *bt[24];
+    int n = backtrace(bt, 24);
+    fprintf(stderr, "ember-winemetal: %s: invalid MTLDevice handle %#llx, using system default %p\n", site,
+            (unsigned long long)h, fallback);
+    backtrace_symbols_fd(bt, n, 2);
+  }
+  return fallback;
+}
