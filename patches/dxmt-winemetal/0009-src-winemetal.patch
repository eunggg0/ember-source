+static NTSTATUS
+_MetalLayer_setProps(void *obj) {
+  struct unixcall_generic_obj_constptr_noret *params = obj;
+  CAMetalLayer *layer = (CAMetalLayer *)params->handle;
+  const struct WMTLayerProps *props = params->arg.ptr;
+  execute_on_main(^{
+    layer.device = (id<MTLDevice>)props->device;
+    layer.opaque = props->opaque;
+    layer.framebufferOnly = props->framebuffer_only;
+    layer.contentsScale = props->contents_scale;
+    layer.displaySyncEnabled = props->display_sync_enabled;
+    layer.drawableSize = CGSizeMake(props->drawable_width, props->drawable_height);
+    layer.pixelFormat = to_metal_pixel_format(props->pixel_format);
+    /* Ember: 화면 대기열 장수(presenter 가 저지연·보간 상태를 보고 정한다) */
+    if (props->ember_max_drawables == 2 || props->ember_max_drawables == 3)
+      layer.maximumDrawableCount = props->ember_max_drawables;
+  });
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MetalLayer_getProps(void *obj) {
+  struct unixcall_generic_obj_ptr_noret *params = obj;
+  CAMetalLayer *layer = (CAMetalLayer *)params->handle;
+  struct WMTLayerProps *props = params->arg.ptr;
+  props->device = (obj_handle_t)layer.device;
+  props->opaque = layer.opaque;
+  props->framebuffer_only = layer.framebufferOnly;
+  props->contents_scale = layer.contentsScale;
+  props->display_sync_enabled = layer.displaySyncEnabled;
+  props->drawable_height = layer.drawableSize.height;
+  props->drawable_width = layer.drawableSize.width;
+  props->pixel_format = layer.pixelFormat;
+  props->ember_max_drawables = (int)layer.maximumDrawableCount;
+  /* Ember: 실제 화면 주사율. Wine 의 모니터 정보는 모니터를 끊고 붙이면 틀리거나 비어서(NULL) 직접 NSScreen 에서 읽는다.
+   * AppKit 은 메인 스레드에서만 — 비동기로 갱신하고 지난 값을 돌려준다(부르는 쪽이 2초마다 부른다). */
+  {
+    static _Atomic double screen_hz;
+    props->ember_refresh_hz = screen_hz;
+    static _Atomic double last_screen_query;
+    double now_q = CACurrentMediaTime();
+    ember_lat_want = 1;
+    props->ember_display_latency_ms = ember_lat_ema * 1000;
+    /* Ember: 수직동기 위상(페이서 위상 모드). 간격 표본이 없으면 1/주사율 */
+    if (screen_hz > 1) ember_vs_nominal = 1.0 / screen_hz;
+    props->ember_vsync_time = ember_vs_last;
+    props->ember_vsync_period = ember_vs_period > 0 ? ember_vs_period : (screen_hz > 1 ? 1.0 / screen_hz : 0);
+    props->ember_now = now_q;
+    props->ember_inflight = ember_inflight;
+    if (now_q - last_screen_query < 2.0) return STATUS_SUCCESS;   /* 화면 주사율은 2초에 한 번(메인 스레드 비용) */
+    last_screen_query = now_q;
+    [layer retain];
+    dispatch_async(dispatch_get_main_queue(), ^{
+      NSScreen *screen = nil;
+      id delegate = layer.delegate;
+      if ([delegate isKindOfClass:[NSView class]]) screen = [[(NSView *)delegate window] screen];
+      if (!screen) screen = [NSScreen mainScreen];
+      if (@available(macOS 12.0, *)) screen_hz = (double)screen.maximumFramesPerSecond;
+      [layer release];
+    });
+  }
+  return STATUS_SUCCESS;
+}
