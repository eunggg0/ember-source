diff --git a/src/winemetal/ember_dxil_thunks.c b/src/winemetal/ember_dxil_thunks.c
new file mode 100644
index 0000000..100050c
--- /dev/null
+++ b/src/winemetal/ember_dxil_thunks.c
@@ -0,0 +1,101 @@
+/* Ember DXIL: PE 쪽 썽크. 번호는 EMBER_DXIL_UNIX_CALL_BASE 부터 compile, set_vertex_descriptor 순. */
+#ifdef _WIN32
+#define WINEMETAL_API __declspec(dllexport)
+#else
+#define WINEMETAL_API
+#endif
+
+#include "winemetal_thunks.h"
+#include "ember_dxil_thunks.h"
+#include <wineunixlib.h>
+#include <string.h>
+
+#define ED_CALL(i, params) WINE_UNIX_CALL(EMBER_DXIL_UNIX_CALL_BASE + (i), params)
+
+WINEMETAL_API obj_handle_t
+EmberDXIL_compile(
+    obj_handle_t device, const void *dxil, uint64_t dxil_size, const void *root_signature, uint32_t int_rt_mask,
+    uint32_t flags, struct ember_dxil_reflection *reflection
+) {
+  struct unixcall_ember_dxil_compile params;
+  memset(&params, 0, sizeof(params));
+  params.device = device;
+  WMT_MEMPTR_SET(params.dxil, dxil);
+  params.dxil_size = dxil_size;
+  WMT_MEMPTR_SET(params.root_signature, root_signature);
+  WMT_MEMPTR_SET(params.reflection, reflection);
+  params.int_rt_mask = int_rt_mask;
+  params.flags = flags;
+  if (ED_CALL(0, &params))
+    return 0;
+  return params.ret_function;
+}
+
+WINEMETAL_API void
+EmberMTL_setNextVertexDescriptor(
+    const struct ember_vertex_attribute *attributes, uint32_t num_attributes, const struct ember_vertex_layout *layouts,
+    uint32_t num_layouts
+) {
+  struct unixcall_ember_set_vertex_descriptor params;
+  memset(&params, 0, sizeof(params));
+  WMT_MEMPTR_SET(params.attributes, attributes);
+  WMT_MEMPTR_SET(params.layouts, layouts);
+  params.num_attributes = num_attributes;
+  params.num_layouts = num_layouts;
+  ED_CALL(1, &params);
+}
+
+WINEMETAL_API obj_handle_t
+EmberDXIL_newGeometryPipeline(struct ember_dxil_gs_pipeline *desc) {
+  struct unixcall_ember_gs_pipeline params;
+  desc->ret_pso = 0;
+  WMT_MEMPTR_SET(params.desc, desc);
+  if (ED_CALL(2, &params))
+    return 0;
+  return desc->ret_pso;
+}
+
+WINEMETAL_API int
+EmberDXIL_available(void) {
+  static int cached = -1;
+  if (cached < 0) {
+    struct ember_dxil_reflection r;
+    memset(&r, 0, sizeof(r));
+    r.error_code = 0xffff;
+    EmberDXIL_compile(0, NULL, 0, NULL, 0, 0, &r);
+    cached = r.error_code == 0xfff0;
+  }
+  return cached;
+}
+
+WINEMETAL_API int
+EmberDXIL_hasVertexRTIndex(void) {
+  static int cached = -1;
+  if (cached < 0) {
+    struct ember_dxil_reflection r;
+    memset(&r, 0, sizeof(r));
+    r.error_code = 0xffff;
+    EmberDXIL_compile(0, NULL, 0, NULL, 0, EMBER_DXIL_GS_PROBE, &r);
+    cached = r.error_code == 0xfff0 && r.gs_is_passthrough == 0xabcd; /* 유닉스 쪽이 알아들으면 표식을 남긴다 */
+  }
+  return cached;
+}
+
+/* Ember(d12games4): 희소 자원(호출 158) — 옛 유닉스 쪽이면 표에 없는 번호라 실패 → 0 */
+WINEMETAL_API int32_t
+EmberSparse_call(struct unixcall_ember_sparse *params) {
+  params->ret = 0;
+  if (WINE_UNIX_CALL(EMBER_SPARSE_UNIX_CALL, params))
+    return 0;
+  return params->ret;
+}
+
+WINEMETAL_API obj_handle_t
+EmberDXIL_compileStageIn(struct ember_dxil_stagein *desc) {
+  struct unixcall_ember_dxil_stagein params;
+  desc->ret_function = 0;
+  WMT_MEMPTR_SET(params.desc, desc);
+  if (WINE_UNIX_CALL(EMBER_DXIL_STAGEIN_UNIX_CALL, &params))
+    return 0;
+  return desc->ret_function;
+}
diff --git a/src/winemetal/ember_dxil_thunks.h b/src/winemetal/ember_dxil_thunks.h
new file mode 100644
index 0000000..2b03578
--- /dev/null
+++ b/src/winemetal/ember_dxil_thunks.h
@@ -0,0 +1,282 @@
+/*
+ * Ember DXIL: DX12 셰이더(DXIL, SM6)를 애플 Metal Shader Converter(libmetalirconverter.dylib)로 Metal 함수로 바꾸는
+ * winemetal PE <-> 유닉스 썽크. DXMT 자체 변환기(airconv)는 DXBC(SM5.x)만 읽으므로, DXIL 만 싣는 요즘 DX12 게임
+ * (UE4 DXC 빌드·RE 엔진 등)은 이 길로 간다. 유닉스 구현은 unix/ember_dxil_unix.m (dylib 는 dlopen — 없으면 조용히 실패).
+ * 호출 번호: EMBER_DXIL_UNIX_CALL_BASE(154)부터 compile, set_vertex_descriptor, new_geometry_pipeline(156) 순. winemetal_unix.c 의 두 표 끝에 덧붙임.
+ */
+#ifndef __EMBER_DXIL_THUNKS_H
+#define __EMBER_DXIL_THUNKS_H
+
+#include "winemetal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#pragma pack(push, 8)
+
+#define EMBER_DXIL_UNIX_CALL_BASE 154
+#define EMBER_DXIL_MAX_VS_INPUTS 32
+
+struct ember_dxil_vs_input {
+  char name[60];              /* IR 가 준 이름(시맨틱+번호, 예: POSITION0) */
+  uint32_t attribute_index;   /* [[attribute(n)]] */
+};
+
+/* IRShaderStage 값 그대로: 1 VS, 2 PS, 8 CS */
+struct ember_dxil_reflection {
+  uint32_t stage;
+  uint32_t needs_draw_params;
+  uint32_t tg_size[3];
+  uint32_t num_vs_inputs;
+  struct ember_dxil_vs_input vs_inputs[EMBER_DXIL_MAX_VS_INPUTS];
+  int32_t vertex_id_index;
+  int32_t instance_id_index;
+  uint32_t vertex_output_size;
+  uint32_t fs_num_render_targets;
+  uint32_t fs_discards;
+  uint32_t error_code;        /* IRErrorCode, 0 = 성공 */
+  uint32_t from_cache;
+  uint32_t compile_us;
+  char error[256];
+  /* Ember: EMBER_DXIL_GS_PROBE 로 GS 를 물으면 채운다(IRGSInfo_1_0) */
+  uint32_t gs_is_passthrough;
+  int32_t gs_rt_array_index_record_id;
+  int32_t gs_viewport_array_index_record_id;
+  uint32_t gs_input_primitive;
+  uint32_t gs_instance_count;
+  uint32_t gs_num_vertex_outputs;
+};
+
+enum ember_dxil_flags {
+  EMBER_DXIL_DUAL_SOURCE_BLEND = 1,
+  /* Ember: GS 를 컴파일하지 않고 반사만 채운다(통과형 판별). ret_function 은 0 */
+  EMBER_DXIL_GS_PROBE = 2,
+};
+/* Ember: 통과형 GS 를 없애고 VS 가 RT 배열 번호·뷰포트 번호를 직접 내게 한다(IRCompilerSetVertexRenderTargetIndexID).
+ * flags 의 8~15 비트 = RT 배열 번호 레코드 id + 1, 16~23 비트 = 뷰포트 번호 레코드 id + 1 (0 = 없음) */
+#define EMBER_DXIL_VS_RT_INDEX_ID(id) ((((uint32_t)(id) + 1) & 0xff) << 8)
+#define EMBER_DXIL_VS_VP_INDEX_ID(id) ((((uint32_t)(id) + 1) & 0xff) << 16)
+
+struct unixcall_ember_dxil_compile {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer dxil;       /* DXBC 컨테이너(DXIL 파트 포함) 전체 */
+  uint64_t dxil_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) == IRVersionedRootSignatureDescriptor, 없으면 NULL */
+  struct WMTMemoryPointer reflection;      /* out: ember_dxil_reflection */
+  uint32_t int_rt_mask;                    /* 정수형 렌더 타깃 비트 */
+  uint32_t flags;                          /* ember_dxil_flags */
+  obj_handle_t ret_function;               /* out: retain 된 MTLFunction, 0 이면 실패 */
+};
+
+/* 다음 MTLDevice_newRenderPipelineState 호출(같은 스레드)에 붙일 정점 서술자. stride 는 동적(setVertexBuffer:...attributeStride:) */
+struct ember_vertex_attribute {
+  uint32_t format;          /* MTLVertexFormat(= WMTAttributeFormat 값) */
+  uint32_t offset;
+  uint32_t buffer_index;
+  uint32_t attribute_index;
+};
+
+struct ember_vertex_layout {
+  uint32_t buffer_index;
+  uint32_t step_function;   /* MTLVertexStepFunction: 1 정점마다, 2 인스턴스마다, 0 상수 */
+  uint32_t step_rate;
+  uint32_t pad;
+};
+
+struct unixcall_ember_set_vertex_descriptor {
+  struct WMTConstMemoryPointer attributes;
+  struct WMTConstMemoryPointer layouts;
+  uint32_t num_attributes;
+  uint32_t num_layouts;
+};
+
+#pragma pack(pop)
+
+/* Ember: 지오메트리 셰이더(GS) 파이프라인 — Metal Shader Converter 의 GS 에뮬레이션(객체+메시 셰이더).
+ * VS 는 객체 단계(정점 가져오기는 합성한 stage-in 함수), GS 는 메시 단계, PS 는 그대로. 호출 번호 156. */
+struct ember_dxil_gs_pipeline {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer vs;             /* DXIL 컨테이너 */
+  struct WMTConstMemoryPointer gs;
+  struct WMTConstMemoryPointer ps;             /* 없으면 NULL(깊이만) */
+  uint64_t vs_size;
+  uint64_t gs_size;
+  uint64_t ps_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) */
+  struct WMTConstMemoryPointer input_layout;   /* IRVersionedInputLayoutDescriptor */
+  struct WMTConstMemoryPointer mesh_info;      /* WMTMeshRenderPipelineInfo(색·깊이 형식, 섞기, 표본 수) */
+  uint32_t int_rt_mask;
+  uint32_t flags;                              /* ember_dxil_flags */
+  /* 나가는 값 */
+  obj_handle_t ret_pso;                        /* retain 된 MTLRenderPipelineState(메시), 0 이면 실패 */
+  uint32_t gs_vertex_size;                     /* IRRuntimeGeometryPipelineConfig.gsVertexSizeInBytes */
+  uint32_t gs_max_input_prims;                 /* .gsMaxInputPrimitivesPerMeshThreadgroup */
+  uint32_t gs_input_primitive;                 /* IRInputPrimitive */
+  uint32_t gs_instance_count;
+  uint32_t vs_needs_draw_params;
+  uint32_t vertex_buffer_table_index;          /* 객체 단계의 IRRuntimeVertexBuffers 묶음 번호 */
+  uint32_t error_code;
+  char error[256];
+};
+
+struct unixcall_ember_gs_pipeline {
+  struct WMTMemoryPointer desc;
+};
+
+/* 성공하면 desc->ret_pso(0 이 아니면 성공). 없으면(옛 winemetal.so) 0 */
+WINEMETAL_API obj_handle_t EmberDXIL_newGeometryPipeline(struct ember_dxil_gs_pipeline *desc);
+
+/* 없으면(옛 winemetal.so·dylib 없음) 0 을 돌려준다 */
+WINEMETAL_API obj_handle_t EmberDXIL_compile(
+    obj_handle_t device, const void *dxil, uint64_t dxil_size, const void *root_signature, uint32_t int_rt_mask,
+    uint32_t flags, struct ember_dxil_reflection *reflection
+);
+
+
+/* ---- Ember(d12games4): 호출 158 = 자리잡이 희소 자원(Metal 4 placement sparse, D3D12 타일 자원), 159 = VS 의 stage-in 을
+ * 따로 합성(Metal 정점 가져오기가 못 읽는 형식 — R10G10B10A2_UINT 등). 옛 winemetal 에는 없다 — d3d12 는 GetProcAddress 로
+ * 찾고 없으면 예전 동작(예약 자원 = 보통 자원, 그 형식 PSO 실패)으로 간다. */
+#define EMBER_SPARSE_UNIX_CALL 158
+#define EMBER_DXIL_STAGEIN_UNIX_CALL 159
+
+#pragma pack(push, 8)
+
+enum ember_sparse_op {
+  EMBER_SPARSE_OP_SUPPORTED = 0,    /* device → ret 1 (supportsPlacementSparse + MTL4CommandQueue) */
+  EMBER_SPARSE_OP_NEW_BUFFER = 1,   /* device, length, options, page → out_handle, out_gpu_address */
+  EMBER_SPARSE_OP_NEW_TEXTURE = 2,  /* device, info(WMTTextureInfo, gpu_resource_id 채움), page → out_handle,
+                                       out[0] = firstMipmapInTail, out[1] = tailSizeInBytes, out[2] = sparseTextureTier */
+  EMBER_SPARSE_OP_TILE_SIZE = 3,    /* device, tex_type, pixel_format, samples, page → out[0..2] = 타일 너비·높이·깊이(텍셀) */
+  EMBER_SPARSE_OP_NEW_QUEUE = 4,    /* device → out_handle = MTL4CommandQueue */
+  EMBER_SPARSE_OP_MAP_BUFFER = 5,   /* queue, resource, heap(0 = 풀기만), ops = ember_sparse_buffer_op[op_count] */
+  EMBER_SPARSE_OP_MAP_TEXTURE = 6,  /* queue, resource, heap, ops = ember_sparse_texture_op[op_count] */
+  EMBER_SPARSE_OP_COPY_BUFFER = 7,  /* queue, resource(src), resource2(dst), ops = ember_sparse_copy_buffer_op[] */
+  EMBER_SPARSE_OP_COPY_TEXTURE = 8, /* queue, resource(src), resource2(dst), ops = ember_sparse_copy_texture_op[] */
+  EMBER_SPARSE_OP_WAIT = 9,         /* queue, event, value — 큐가 GPU 에서 이벤트를 기다린다 */
+  EMBER_SPARSE_OP_SIGNAL = 10,      /* queue, event, value */
+};
+
+struct ember_sparse_buffer_op {
+  uint32_t mode;          /* 0 걸기, 1 풀기 (MTLSparseTextureMappingMode) */
+  uint32_t pad;
+  uint64_t start;         /* 버퍼 안 타일 번호 */
+  uint64_t count;
+  uint64_t heap_offset;   /* 힙 안 타일 번호 */
+};
+
+struct ember_sparse_texture_op {
+  uint32_t mode, level, slice, pad;
+  uint32_t x, y, z, w, h, d; /* 타일 단위 영역 */
+  uint64_t heap_offset;
+};
+
+struct ember_sparse_copy_buffer_op {
+  uint64_t src_start, count, dst_start;
+};
+
+struct ember_sparse_copy_texture_op {
+  uint32_t src_level, src_slice, dst_level, dst_slice;
+  uint32_t sx, sy, sz, w, h, d, dx, dy, dz, pad;
+};
+
+struct unixcall_ember_sparse {
+  uint32_t op;
+  int32_t ret;
+  obj_handle_t device;
+  obj_handle_t queue;
+  obj_handle_t resource;
+  obj_handle_t resource2;
+  obj_handle_t heap;
+  obj_handle_t event;
+  uint64_t value;
+  uint64_t length;
+  uint32_t options;       /* WMTResourceOptions */
+  uint32_t page;          /* WMTSparsePageSize(101 16K, 102 64K, 103 256K) */
+  uint32_t tex_type, pixel_format, samples, pad;
+  struct WMTMemoryPointer info;
+  struct WMTConstMemoryPointer ops;
+  uint64_t op_count;
+  obj_handle_t out_handle;
+  uint64_t out_gpu_address;
+  uint64_t out[4];
+};
+
+/* VS 를 stage-in 따로 모드로 컴파일하고 입력 배치로 stage-in 함수를 합성한다. 돌려주는 것은 VS 함수(retain), stage-in 함수는
+ * 같은 스레드의 다음 MTLDevice_newRenderPipelineState 에 vertexLinkedFunctions 로 붙는다(정점 서술자는 안 쓴다).
+ * 정점 버퍼는 IRRuntimeVertexBuffers 표(정점 단계 버퍼 vertex_buffer_table_index, 보통 6)로 읽는다. */
+struct ember_dxil_stagein {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer vs;
+  uint64_t vs_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) */
+  struct WMTConstMemoryPointer input_layout;   /* IRVersionedInputLayoutDescriptor */
+  struct WMTMemoryPointer reflection;          /* out: ember_dxil_reflection */
+  uint32_t flags;                              /* ember_dxil_flags 의 VS 비트(RT·뷰포트 번호) */
+  uint32_t vertex_buffer_table_index;          /* out */
+  obj_handle_t ret_function;                   /* out */
+};
+
+struct unixcall_ember_dxil_stagein {
+  struct WMTMemoryPointer desc;
+};
+
+#pragma pack(pop)
+
+/* ---- Ember(w3d12 10-20): DXIL 테셀레이션(VS+HS+DS[+GS]+PS) 에뮬레이션 파이프라인. 새 썽크·호출 번호를 만들지 않고
+ * EmberFG_call 의 op EMBER_FG_OP_DXIL_TESS(40) 로 부른다(winemetal.dll 은 그대로, winemetal.so 만 새로). out = 이 구조체.
+ * 옛 winemetal.so 는 그 op 를 모르므로 ret 0 → d3d12 는 예전처럼 그 파이프라인 그리기를 건너뛴다.
+ * 조립은 애플 metal_irconverter_runtime.h 의 IRRuntimeNewGeometryTessellationEmulationPipeline 과 같다:
+ *   객체 단계 = VS("<entry>.dxil_irconverter_object_shader", tessellationEnabled) + 링크[stage-in, HS "irconverter_hull_shader"],
+ *   메시 단계 = GS(있으면) 또는 DS 라이브러리의 통과형 "irconverter_domain_shader_<prim>_passthrough"
+ *              + 링크[HS "irconverter_tessellator", DS "irconverter_dxil_domain_shader"]. */
+#pragma pack(push, 8)
+struct ember_dxil_tess_pipeline {
+  uint32_t version;                            /* 2: returns tessellator tables; v1 rejected */
+  uint32_t flags;                              /* ember_dxil_flags(EMBER_DXIL_DUAL_SOURCE_BLEND) */
+  obj_handle_t device;
+  struct WMTConstMemoryPointer vs, hs, ds, gs, ps; /* gs·ps 는 없으면 NULL */
+  uint64_t vs_size, hs_size, ds_size, gs_size, ps_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) */
+  struct WMTConstMemoryPointer input_layout;   /* IRVersionedInputLayoutDescriptor (원소 0개도 됨) */
+  struct WMTConstMemoryPointer mesh_info;      /* WMTMeshRenderPipelineInfo */
+  uint32_t int_rt_mask;
+  uint32_t reserved0; /* output: TG memory bytes, low16=index0, high16=index1; ABI size unchanged */
+  /* 나가는 값(IRRuntimeTessellationPipelineConfig 와 그리기에 필요한 것) */
+  obj_handle_t ret_pso;
+  uint32_t vs_output_size;                     /* vsOutputSizeInBytes */
+  uint32_t hs_patches_per_tg;                  /* hsMaxPatchesPerObjectThreadgroup */
+  uint32_t hs_threads_per_patch;               /* hsMaxObjectThreadsPerThreadgroup(패치당) */
+  uint32_t hs_input_cps;                       /* hsInputControlPointCount */
+  uint32_t output_primitive;                   /* IRRuntimeTessellatorOutputPrimitive 1 점 2 선 3·4 삼각형 */
+  float max_tess_factor;
+  uint32_t mesh_prims;                         /* gsMaxInputPrimitivesPerMeshThreadgroup(GS 없으면 DS 의 값) */
+  uint32_t gs_instance_count;
+  uint32_t vertex_buffer_table_index;          /* 객체 단계 IRRuntimeVertexBuffers 묶음 번호 */
+  uint32_t vs_needs_draw_params;
+  uint32_t error_code;
+  char error[256];
+  obj_handle_t ret_tess_tables;                /* owned +1 MTLBuffer, shared, mesh binding 7 */
+};
+#pragma pack(pop)
+
+/* 옛 winemetal.so 면 0 */
+WINEMETAL_API int32_t EmberSparse_call(struct unixcall_ember_sparse *params);
+WINEMETAL_API obj_handle_t EmberDXIL_compileStageIn(struct ember_dxil_stagein *desc);
+
+/* libmetalirconverter.dylib 를 쓸 수 있으면 1 */
+WINEMETAL_API int EmberDXIL_available(void);
+
+/* Ember: 이 winemetal 이 VS 의 RT 배열 번호 출력(통과형 GS 제거)을 할 수 있나 */
+WINEMETAL_API int EmberDXIL_hasVertexRTIndex(void);
+
+WINEMETAL_API void EmberMTL_setNextVertexDescriptor(
+    const struct ember_vertex_attribute *attributes, uint32_t num_attributes, const struct ember_vertex_layout *layouts,
+    uint32_t num_layouts
+);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/winemetal/ember_dxil_thunks.h.pre-w3t b/src/winemetal/ember_dxil_thunks.h.pre-w3t
new file mode 100644
index 0000000..d3e0946
--- /dev/null
+++ b/src/winemetal/ember_dxil_thunks.h.pre-w3t
@@ -0,0 +1,245 @@
+/*
+ * Ember DXIL: DX12 셰이더(DXIL, SM6)를 애플 Metal Shader Converter(libmetalirconverter.dylib)로 Metal 함수로 바꾸는
+ * winemetal PE <-> 유닉스 썽크. DXMT 자체 변환기(airconv)는 DXBC(SM5.x)만 읽으므로, DXIL 만 싣는 요즘 DX12 게임
+ * (UE4 DXC 빌드·RE 엔진 등)은 이 길로 간다. 유닉스 구현은 unix/ember_dxil_unix.m (dylib 는 dlopen — 없으면 조용히 실패).
+ * 호출 번호: EMBER_DXIL_UNIX_CALL_BASE(154)부터 compile, set_vertex_descriptor, new_geometry_pipeline(156) 순. winemetal_unix.c 의 두 표 끝에 덧붙임.
+ */
+#ifndef __EMBER_DXIL_THUNKS_H
+#define __EMBER_DXIL_THUNKS_H
+
+#include "winemetal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#pragma pack(push, 8)
+
+#define EMBER_DXIL_UNIX_CALL_BASE 154
+#define EMBER_DXIL_MAX_VS_INPUTS 32
+
+struct ember_dxil_vs_input {
+  char name[60];              /* IR 가 준 이름(시맨틱+번호, 예: POSITION0) */
+  uint32_t attribute_index;   /* [[attribute(n)]] */
+};
+
+/* IRShaderStage 값 그대로: 1 VS, 2 PS, 8 CS */
+struct ember_dxil_reflection {
+  uint32_t stage;
+  uint32_t needs_draw_params;
+  uint32_t tg_size[3];
+  uint32_t num_vs_inputs;
+  struct ember_dxil_vs_input vs_inputs[EMBER_DXIL_MAX_VS_INPUTS];
+  int32_t vertex_id_index;
+  int32_t instance_id_index;
+  uint32_t vertex_output_size;
+  uint32_t fs_num_render_targets;
+  uint32_t fs_discards;
+  uint32_t error_code;        /* IRErrorCode, 0 = 성공 */
+  uint32_t from_cache;
+  uint32_t compile_us;
+  char error[256];
+  /* Ember: EMBER_DXIL_GS_PROBE 로 GS 를 물으면 채운다(IRGSInfo_1_0) */
+  uint32_t gs_is_passthrough;
+  int32_t gs_rt_array_index_record_id;
+  int32_t gs_viewport_array_index_record_id;
+  uint32_t gs_input_primitive;
+  uint32_t gs_instance_count;
+  uint32_t gs_num_vertex_outputs;
+};
+
+enum ember_dxil_flags {
+  EMBER_DXIL_DUAL_SOURCE_BLEND = 1,
+  /* Ember: GS 를 컴파일하지 않고 반사만 채운다(통과형 판별). ret_function 은 0 */
+  EMBER_DXIL_GS_PROBE = 2,
+};
+/* Ember: 통과형 GS 를 없애고 VS 가 RT 배열 번호·뷰포트 번호를 직접 내게 한다(IRCompilerSetVertexRenderTargetIndexID).
+ * flags 의 8~15 비트 = RT 배열 번호 레코드 id + 1, 16~23 비트 = 뷰포트 번호 레코드 id + 1 (0 = 없음) */
+#define EMBER_DXIL_VS_RT_INDEX_ID(id) ((((uint32_t)(id) + 1) & 0xff) << 8)
+#define EMBER_DXIL_VS_VP_INDEX_ID(id) ((((uint32_t)(id) + 1) & 0xff) << 16)
+
+struct unixcall_ember_dxil_compile {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer dxil;       /* DXBC 컨테이너(DXIL 파트 포함) 전체 */
+  uint64_t dxil_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) == IRVersionedRootSignatureDescriptor, 없으면 NULL */
+  struct WMTMemoryPointer reflection;      /* out: ember_dxil_reflection */
+  uint32_t int_rt_mask;                    /* 정수형 렌더 타깃 비트 */
+  uint32_t flags;                          /* ember_dxil_flags */
+  obj_handle_t ret_function;               /* out: retain 된 MTLFunction, 0 이면 실패 */
+};
+
+/* 다음 MTLDevice_newRenderPipelineState 호출(같은 스레드)에 붙일 정점 서술자. stride 는 동적(setVertexBuffer:...attributeStride:) */
+struct ember_vertex_attribute {
+  uint32_t format;          /* MTLVertexFormat(= WMTAttributeFormat 값) */
+  uint32_t offset;
+  uint32_t buffer_index;
+  uint32_t attribute_index;
+};
+
+struct ember_vertex_layout {
+  uint32_t buffer_index;
+  uint32_t step_function;   /* MTLVertexStepFunction: 1 정점마다, 2 인스턴스마다, 0 상수 */
+  uint32_t step_rate;
+  uint32_t pad;
+};
+
+struct unixcall_ember_set_vertex_descriptor {
+  struct WMTConstMemoryPointer attributes;
+  struct WMTConstMemoryPointer layouts;
+  uint32_t num_attributes;
+  uint32_t num_layouts;
+};
+
+#pragma pack(pop)
+
+/* Ember: 지오메트리 셰이더(GS) 파이프라인 — Metal Shader Converter 의 GS 에뮬레이션(객체+메시 셰이더).
+ * VS 는 객체 단계(정점 가져오기는 합성한 stage-in 함수), GS 는 메시 단계, PS 는 그대로. 호출 번호 156. */
+struct ember_dxil_gs_pipeline {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer vs;             /* DXIL 컨테이너 */
+  struct WMTConstMemoryPointer gs;
+  struct WMTConstMemoryPointer ps;             /* 없으면 NULL(깊이만) */
+  uint64_t vs_size;
+  uint64_t gs_size;
+  uint64_t ps_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) */
+  struct WMTConstMemoryPointer input_layout;   /* IRVersionedInputLayoutDescriptor */
+  struct WMTConstMemoryPointer mesh_info;      /* WMTMeshRenderPipelineInfo(색·깊이 형식, 섞기, 표본 수) */
+  uint32_t int_rt_mask;
+  uint32_t flags;                              /* ember_dxil_flags */
+  /* 나가는 값 */
+  obj_handle_t ret_pso;                        /* retain 된 MTLRenderPipelineState(메시), 0 이면 실패 */
+  uint32_t gs_vertex_size;                     /* IRRuntimeGeometryPipelineConfig.gsVertexSizeInBytes */
+  uint32_t gs_max_input_prims;                 /* .gsMaxInputPrimitivesPerMeshThreadgroup */
+  uint32_t gs_input_primitive;                 /* IRInputPrimitive */
+  uint32_t gs_instance_count;
+  uint32_t vs_needs_draw_params;
+  uint32_t vertex_buffer_table_index;          /* 객체 단계의 IRRuntimeVertexBuffers 묶음 번호 */
+  uint32_t error_code;
+  char error[256];
+};
+
+struct unixcall_ember_gs_pipeline {
+  struct WMTMemoryPointer desc;
+};
+
+/* 성공하면 desc->ret_pso(0 이 아니면 성공). 없으면(옛 winemetal.so) 0 */
+WINEMETAL_API obj_handle_t EmberDXIL_newGeometryPipeline(struct ember_dxil_gs_pipeline *desc);
+
+/* 없으면(옛 winemetal.so·dylib 없음) 0 을 돌려준다 */
+WINEMETAL_API obj_handle_t EmberDXIL_compile(
+    obj_handle_t device, const void *dxil, uint64_t dxil_size, const void *root_signature, uint32_t int_rt_mask,
+    uint32_t flags, struct ember_dxil_reflection *reflection
+);
+
+
+/* ---- Ember(d12games4): 호출 158 = 자리잡이 희소 자원(Metal 4 placement sparse, D3D12 타일 자원), 159 = VS 의 stage-in 을
+ * 따로 합성(Metal 정점 가져오기가 못 읽는 형식 — R10G10B10A2_UINT 등). 옛 winemetal 에는 없다 — d3d12 는 GetProcAddress 로
+ * 찾고 없으면 예전 동작(예약 자원 = 보통 자원, 그 형식 PSO 실패)으로 간다. */
+#define EMBER_SPARSE_UNIX_CALL 158
+#define EMBER_DXIL_STAGEIN_UNIX_CALL 159
+
+#pragma pack(push, 8)
+
+enum ember_sparse_op {
+  EMBER_SPARSE_OP_SUPPORTED = 0,    /* device → ret 1 (supportsPlacementSparse + MTL4CommandQueue) */
+  EMBER_SPARSE_OP_NEW_BUFFER = 1,   /* device, length, options, page → out_handle, out_gpu_address */
+  EMBER_SPARSE_OP_NEW_TEXTURE = 2,  /* device, info(WMTTextureInfo, gpu_resource_id 채움), page → out_handle,
+                                       out[0] = firstMipmapInTail, out[1] = tailSizeInBytes, out[2] = sparseTextureTier */
+  EMBER_SPARSE_OP_TILE_SIZE = 3,    /* device, tex_type, pixel_format, samples, page → out[0..2] = 타일 너비·높이·깊이(텍셀) */
+  EMBER_SPARSE_OP_NEW_QUEUE = 4,    /* device → out_handle = MTL4CommandQueue */
+  EMBER_SPARSE_OP_MAP_BUFFER = 5,   /* queue, resource, heap(0 = 풀기만), ops = ember_sparse_buffer_op[op_count] */
+  EMBER_SPARSE_OP_MAP_TEXTURE = 6,  /* queue, resource, heap, ops = ember_sparse_texture_op[op_count] */
+  EMBER_SPARSE_OP_COPY_BUFFER = 7,  /* queue, resource(src), resource2(dst), ops = ember_sparse_copy_buffer_op[] */
+  EMBER_SPARSE_OP_COPY_TEXTURE = 8, /* queue, resource(src), resource2(dst), ops = ember_sparse_copy_texture_op[] */
+  EMBER_SPARSE_OP_WAIT = 9,         /* queue, event, value — 큐가 GPU 에서 이벤트를 기다린다 */
+  EMBER_SPARSE_OP_SIGNAL = 10,      /* queue, event, value */
+};
+
+struct ember_sparse_buffer_op {
+  uint32_t mode;          /* 0 걸기, 1 풀기 (MTLSparseTextureMappingMode) */
+  uint32_t pad;
+  uint64_t start;         /* 버퍼 안 타일 번호 */
+  uint64_t count;
+  uint64_t heap_offset;   /* 힙 안 타일 번호 */
+};
+
+struct ember_sparse_texture_op {
+  uint32_t mode, level, slice, pad;
+  uint32_t x, y, z, w, h, d; /* 타일 단위 영역 */
+  uint64_t heap_offset;
+};
+
+struct ember_sparse_copy_buffer_op {
+  uint64_t src_start, count, dst_start;
+};
+
+struct ember_sparse_copy_texture_op {
+  uint32_t src_level, src_slice, dst_level, dst_slice;
+  uint32_t sx, sy, sz, w, h, d, dx, dy, dz, pad;
+};
+
+struct unixcall_ember_sparse {
+  uint32_t op;
+  int32_t ret;
+  obj_handle_t device;
+  obj_handle_t queue;
+  obj_handle_t resource;
+  obj_handle_t resource2;
+  obj_handle_t heap;
+  obj_handle_t event;
+  uint64_t value;
+  uint64_t length;
+  uint32_t options;       /* WMTResourceOptions */
+  uint32_t page;          /* WMTSparsePageSize(101 16K, 102 64K, 103 256K) */
+  uint32_t tex_type, pixel_format, samples, pad;
+  struct WMTMemoryPointer info;
+  struct WMTConstMemoryPointer ops;
+  uint64_t op_count;
+  obj_handle_t out_handle;
+  uint64_t out_gpu_address;
+  uint64_t out[4];
+};
+
+/* VS 를 stage-in 따로 모드로 컴파일하고 입력 배치로 stage-in 함수를 합성한다. 돌려주는 것은 VS 함수(retain), stage-in 함수는
+ * 같은 스레드의 다음 MTLDevice_newRenderPipelineState 에 vertexLinkedFunctions 로 붙는다(정점 서술자는 안 쓴다).
+ * 정점 버퍼는 IRRuntimeVertexBuffers 표(정점 단계 버퍼 vertex_buffer_table_index, 보통 6)로 읽는다. */
+struct ember_dxil_stagein {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer vs;
+  uint64_t vs_size;
+  struct WMTConstMemoryPointer root_signature; /* D3D12_VERSIONED_ROOT_SIGNATURE_DESC(1_1) */
+  struct WMTConstMemoryPointer input_layout;   /* IRVersionedInputLayoutDescriptor */
+  struct WMTMemoryPointer reflection;          /* out: ember_dxil_reflection */
+  uint32_t flags;                              /* ember_dxil_flags 의 VS 비트(RT·뷰포트 번호) */
+  uint32_t vertex_buffer_table_index;          /* out */
+  obj_handle_t ret_function;                   /* out */
+};
+
+struct unixcall_ember_dxil_stagein {
+  struct WMTMemoryPointer desc;
+};
+
+#pragma pack(pop)
+
+/* 옛 winemetal.so 면 0 */
+WINEMETAL_API int32_t EmberSparse_call(struct unixcall_ember_sparse *params);
+WINEMETAL_API obj_handle_t EmberDXIL_compileStageIn(struct ember_dxil_stagein *desc);
+
+/* libmetalirconverter.dylib 를 쓸 수 있으면 1 */
+WINEMETAL_API int EmberDXIL_available(void);
+
+/* Ember: 이 winemetal 이 VS 의 RT 배열 번호 출력(통과형 GS 제거)을 할 수 있나 */
+WINEMETAL_API int EmberDXIL_hasVertexRTIndex(void);
+
+WINEMETAL_API void EmberMTL_setNextVertexDescriptor(
+    const struct ember_vertex_attribute *attributes, uint32_t num_attributes, const struct ember_vertex_layout *layouts,
+    uint32_t num_layouts
+);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/winemetal/ember_fg_thunks.c b/src/winemetal/ember_fg_thunks.c
new file mode 100644
index 0000000..458f2e0
--- /dev/null
+++ b/src/winemetal/ember_fg_thunks.c
@@ -0,0 +1,24 @@
+/*
+ * Ember FG hook: PE side thunk (see ember_fg_thunks.h).
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifdef _WIN32
+#define WINEMETAL_API __declspec(dllexport)
+#else
+#define WINEMETAL_API
+#endif
+
+#include "winemetal_thunks.h"
+#include "ember_fg_thunks.h"
+#include <wineunixlib.h>
+
+WINEMETAL_API int32_t
+EmberFG_call(struct unixcall_ember_fg *params) {
+  params->ret = 0;
+  params->log_len = 0;
+  if (WINE_UNIX_CALL(EMBER_FG_UNIX_CALL, params)) return 0;
+  return params->ret;
+}
diff --git a/src/winemetal/ember_fg_thunks.h b/src/winemetal/ember_fg_thunks.h
new file mode 100644
index 0000000..5a7e538
--- /dev/null
+++ b/src/winemetal/ember_fg_thunks.h
@@ -0,0 +1,88 @@
+/*
+ * Ember FG hook: winemetal PE ↔ unix bridge to the optional libEmberFG.dylib (EmberCore, separate library).
+ * This file only forwards calls; the frame generation engine itself is not part of this tree.
+ * One unix call (EMBER_FG_UNIX_CALL) carries every operation, selected by `op`.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifndef __EMBER_FG_THUNKS_H
+#define __EMBER_FG_THUNKS_H
+
+#include "winemetal.h"
+
+#define EMBER_FG_UNIX_CALL 157
+
+enum ember_fg_op {
+  EMBER_FG_OP_VERSION = 0,     /* ret = library ABI version, 0 = library missing */
+  EMBER_FG_OP_CREATE = 1,      /* device, in = env block → ctx, out = config */
+  EMBER_FG_OP_DESTROY = 2,
+  EMBER_FG_OP_CONFIG = 3,      /* out = config */
+  EMBER_FG_OP_BEGIN = 4,       /* in = frame_in, out = frame_plan */
+  EMBER_FG_OP_ENCODE = 5,      /* in = encode_in, out = encode_out */
+  EMBER_FG_OP_RING_ACQUIRE = 6,/* in = ring_req, out = ring_slots */
+  EMBER_FG_OP_RING_RELEASE = 7,/* arg0 = slot, arg1 = frame_done */
+  EMBER_FG_OP_RING_IDLE = 8,
+  EMBER_FG_OP_NOTE_DROP = 9,   /* arg0 = kind */
+  EMBER_FG_OP_STATS = 10,      /* arg_i64 = now, out = stats */
+  EMBER_FG_OP_HUD = 11,        /* arg_i64 = now, arg_f64 = game fps, arg1 = generated frames, out = text */
+  EMBER_FG_OP_DRAIN_LOG = 12,
+  /* Ember in-game HUD (optional libEmberHUD.dylib next to winemetal.so). Independent of frame generation: these ops work
+   * without libEmberFG. ctx = HUD context (not an FG context). */
+  EMBER_FG_OP_HUD_CREATE = 13, /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_HUD_ENCODE = 14, /* in = ember_hud_encode_in, out = ember_hud_encode_out, ret = panels drawn */
+  EMBER_FG_OP_HUD_DESTROY = 15,
+  /* Ember Tone / Ember Flare (optional libEmberTone.dylib next to winemetal.so, EmberCore). Independent of frame generation.
+   * ctx = Tone or Flare context. in/out structs: EmberCore/tone/include/ember_tone.h (mirrored in src/dxmt/ember_neural.hpp). */
+  EMBER_FG_OP_TONE_NEURAL_CREATE = 16,  /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_TONE_NEURAL_ENCODE = 17,  /* in = ember_tone_neural_in, out = ember_tone_neural_out, ret = processed */
+  EMBER_FG_OP_TONE_NEURAL_DESTROY = 18,
+  EMBER_FG_OP_TONE_AHDR_CREATE = 19,    /* device, in = env block → ctx, out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_ENCODE = 20,    /* in = ember_tone_ahdr_encode_in, out = ember_tone_ahdr_encode_out, ret = ok */
+  EMBER_FG_OP_TONE_AHDR_FRAME = 21,     /* in = ember_tone_ahdr_frame_in, out = ember_tone_ahdr_frame_out, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_CONFIG = 22,    /* out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_DESTROY = 23,
+  /* Ember Spark (optional libEmberSpark.dylib next to winemetal.so, EmberCore, kiln 10-08): delays the return from Present so the
+   * game's next frame starts just in time. One instance per process, no ctx. Times are taken on the unix side
+   * (mach_absolute_time seconds, the MTLCommandBuffer GPU time domain); the PE side passes none.
+   * Off unless the unix environment has EMBER_SPARK=1 (arg0 = 1 forces on, 0 forces off, -1 follows it — C:\ember-d11.cfg). */
+  EMBER_FG_OP_SPARK_STATE = 24,   /* arg0 = override → ret = 1 if Spark is on */
+  EMBER_FG_OP_SPARK_ENTER = 25,   /* arg1 = frame id, arg_f64 = period (s, 0 = uncapped) */
+  EMBER_FG_OP_SPARK_EXIT = 26,    /* arg1 = frame id → sleeps on the unix side, ret = slept µs */
+  EMBER_FG_OP_SPARK_GPU = 27,     /* arg1 = frame id, arg_i64 = GPU start ns, arg0 = GPU end ns, arg_f64 = GPU busy s */
+  EMBER_FG_OP_SPARK_SLOT = 28,    /* arg0 = kind (1 submit, 2 display), arg1 = frame id, arg_f64 = slot time − now (s) */
+  /* Ember(w3d12): DXIL 테셀레이션 파이프라인 — out = struct ember_dxil_tess_pipeline(ember_dxil_thunks.h) → ret 1 성공 */
+  EMBER_FG_OP_DXIL_TESS = 40,
+  /* Ember FlowQ 뉴럴 엔진 흐름(dxmt-ane 10-16): libEmberFG(ABI 1.4) ember_fg_ane_submit / ember_fg_ane_status 를 그대로 넘긴다.
+   * 선택 기호 — 옛 libEmberFG 면 SUBMIT ret 0(안 받음), STATUS ret -1(없음). ctx = FG 컨텍스트(EMBER_FG_OP_CREATE 결과).
+   * in 구조체는 EmberCore/include/ember_fg.h 의 ember_fg_ane_submit_in(src/dxmt/ember_fg_hook.hpp 에 같은 배치로 거울).
+   * PE 쪽은 mach_absolute_time 을 모르므로 arg0 = 1 이면 deadline_ns 를 "지금부터 ns" 로 받아 유닉스 쪽에서 절대 시각으로 바꾼다. */
+  EMBER_FG_OP_ANE_SUBMIT = 29,    /* in = ember_fg_ane_submit_in, arg0 = 1 상대 기한 → ret = 1 받음(준비 아님), 0 안 받음 */
+  EMBER_FG_OP_ANE_STATUS = 30,    /* arg1 = pair id → ret = -1 없음/만료, 0 대기, 1 준비, 2 인코딩됨 (소비하지 않음) */
+};
+
+#pragma pack(push, 8)
+struct unixcall_ember_fg {
+  uint32_t op;
+  int32_t ret;
+  obj_handle_t ctx;            /* in/out (create) */
+  obj_handle_t device;
+  struct WMTConstMemoryPointer in;
+  uint64_t in_size;
+  struct WMTMemoryPointer out;
+  uint64_t out_size;
+  struct WMTMemoryPointer log; /* optional: queued log lines are moved here after the call */
+  uint64_t log_cap;
+  uint64_t log_len;            /* out */
+  int64_t arg_i64;
+  double arg_f64;
+  int64_t arg0;
+  uint64_t arg1;
+};
+#pragma pack(pop)
+
+/* PE side: returns `ret` (0 if the unix side has no library). */
+WINEMETAL_API int32_t EmberFG_call(struct unixcall_ember_fg *params);
+
+#endif
diff --git a/src/winemetal/ember_fg_thunks.h.pre-w3t b/src/winemetal/ember_fg_thunks.h.pre-w3t
new file mode 100644
index 0000000..dcbcbc0
--- /dev/null
+++ b/src/winemetal/ember_fg_thunks.h.pre-w3t
@@ -0,0 +1,86 @@
+/*
+ * Ember FG hook: winemetal PE ↔ unix bridge to the optional libEmberFG.dylib (EmberCore, separate library).
+ * This file only forwards calls; the frame generation engine itself is not part of this tree.
+ * One unix call (EMBER_FG_UNIX_CALL) carries every operation, selected by `op`.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifndef __EMBER_FG_THUNKS_H
+#define __EMBER_FG_THUNKS_H
+
+#include "winemetal.h"
+
+#define EMBER_FG_UNIX_CALL 157
+
+enum ember_fg_op {
+  EMBER_FG_OP_VERSION = 0,     /* ret = library ABI version, 0 = library missing */
+  EMBER_FG_OP_CREATE = 1,      /* device, in = env block → ctx, out = config */
+  EMBER_FG_OP_DESTROY = 2,
+  EMBER_FG_OP_CONFIG = 3,      /* out = config */
+  EMBER_FG_OP_BEGIN = 4,       /* in = frame_in, out = frame_plan */
+  EMBER_FG_OP_ENCODE = 5,      /* in = encode_in, out = encode_out */
+  EMBER_FG_OP_RING_ACQUIRE = 6,/* in = ring_req, out = ring_slots */
+  EMBER_FG_OP_RING_RELEASE = 7,/* arg0 = slot, arg1 = frame_done */
+  EMBER_FG_OP_RING_IDLE = 8,
+  EMBER_FG_OP_NOTE_DROP = 9,   /* arg0 = kind */
+  EMBER_FG_OP_STATS = 10,      /* arg_i64 = now, out = stats */
+  EMBER_FG_OP_HUD = 11,        /* arg_i64 = now, arg_f64 = game fps, arg1 = generated frames, out = text */
+  EMBER_FG_OP_DRAIN_LOG = 12,
+  /* Ember in-game HUD (optional libEmberHUD.dylib next to winemetal.so). Independent of frame generation: these ops work
+   * without libEmberFG. ctx = HUD context (not an FG context). */
+  EMBER_FG_OP_HUD_CREATE = 13, /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_HUD_ENCODE = 14, /* in = ember_hud_encode_in, out = ember_hud_encode_out, ret = panels drawn */
+  EMBER_FG_OP_HUD_DESTROY = 15,
+  /* Ember Tone / Ember Flare (optional libEmberTone.dylib next to winemetal.so, EmberCore). Independent of frame generation.
+   * ctx = Tone or Flare context. in/out structs: EmberCore/tone/include/ember_tone.h (mirrored in src/dxmt/ember_neural.hpp). */
+  EMBER_FG_OP_TONE_NEURAL_CREATE = 16,  /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_TONE_NEURAL_ENCODE = 17,  /* in = ember_tone_neural_in, out = ember_tone_neural_out, ret = processed */
+  EMBER_FG_OP_TONE_NEURAL_DESTROY = 18,
+  EMBER_FG_OP_TONE_AHDR_CREATE = 19,    /* device, in = env block → ctx, out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_ENCODE = 20,    /* in = ember_tone_ahdr_encode_in, out = ember_tone_ahdr_encode_out, ret = ok */
+  EMBER_FG_OP_TONE_AHDR_FRAME = 21,     /* in = ember_tone_ahdr_frame_in, out = ember_tone_ahdr_frame_out, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_CONFIG = 22,    /* out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_DESTROY = 23,
+  /* Ember Spark (optional libEmberSpark.dylib next to winemetal.so, EmberCore, kiln 10-08): delays the return from Present so the
+   * game's next frame starts just in time. One instance per process, no ctx. Times are taken on the unix side
+   * (mach_absolute_time seconds, the MTLCommandBuffer GPU time domain); the PE side passes none.
+   * Off unless the unix environment has EMBER_SPARK=1 (arg0 = 1 forces on, 0 forces off, -1 follows it — C:\ember-d11.cfg). */
+  EMBER_FG_OP_SPARK_STATE = 24,   /* arg0 = override → ret = 1 if Spark is on */
+  EMBER_FG_OP_SPARK_ENTER = 25,   /* arg1 = frame id, arg_f64 = period (s, 0 = uncapped) */
+  EMBER_FG_OP_SPARK_EXIT = 26,    /* arg1 = frame id → sleeps on the unix side, ret = slept µs */
+  EMBER_FG_OP_SPARK_GPU = 27,     /* arg1 = frame id, arg_i64 = GPU start ns, arg0 = GPU end ns, arg_f64 = GPU busy s */
+  EMBER_FG_OP_SPARK_SLOT = 28,    /* arg0 = kind (1 submit, 2 display), arg1 = frame id, arg_f64 = slot time − now (s) */
+  /* Ember FlowQ 뉴럴 엔진 흐름(dxmt-ane 10-16): libEmberFG(ABI 1.4) ember_fg_ane_submit / ember_fg_ane_status 를 그대로 넘긴다.
+   * 선택 기호 — 옛 libEmberFG 면 SUBMIT ret 0(안 받음), STATUS ret -1(없음). ctx = FG 컨텍스트(EMBER_FG_OP_CREATE 결과).
+   * in 구조체는 EmberCore/include/ember_fg.h 의 ember_fg_ane_submit_in(src/dxmt/ember_fg_hook.hpp 에 같은 배치로 거울).
+   * PE 쪽은 mach_absolute_time 을 모르므로 arg0 = 1 이면 deadline_ns 를 "지금부터 ns" 로 받아 유닉스 쪽에서 절대 시각으로 바꾼다. */
+  EMBER_FG_OP_ANE_SUBMIT = 29,    /* in = ember_fg_ane_submit_in, arg0 = 1 상대 기한 → ret = 1 받음(준비 아님), 0 안 받음 */
+  EMBER_FG_OP_ANE_STATUS = 30,    /* arg1 = pair id → ret = -1 없음/만료, 0 대기, 1 준비, 2 인코딩됨 (소비하지 않음) */
+};
+
+#pragma pack(push, 8)
+struct unixcall_ember_fg {
+  uint32_t op;
+  int32_t ret;
+  obj_handle_t ctx;            /* in/out (create) */
+  obj_handle_t device;
+  struct WMTConstMemoryPointer in;
+  uint64_t in_size;
+  struct WMTMemoryPointer out;
+  uint64_t out_size;
+  struct WMTMemoryPointer log; /* optional: queued log lines are moved here after the call */
+  uint64_t log_cap;
+  uint64_t log_len;            /* out */
+  int64_t arg_i64;
+  double arg_f64;
+  int64_t arg0;
+  uint64_t arg1;
+};
+#pragma pack(pop)
+
+/* PE side: returns `ret` (0 if the unix side has no library). */
+WINEMETAL_API int32_t EmberFG_call(struct unixcall_ember_fg *params);
+
+#endif
diff --git a/src/winemetal/ember_neural_thunks.c b/src/winemetal/ember_neural_thunks.c
new file mode 100644
index 0000000..eafe05d
--- /dev/null
+++ b/src/winemetal/ember_neural_thunks.c
@@ -0,0 +1,88 @@
+/* Ember Neural: PE 쪽 썽크. 번호는 EMBER_NEURAL_UNIX_CALL_BASE 부터 open, close, begin, submit, cancel, latest, stats 순. */
+#ifdef _WIN32
+#define WINEMETAL_API __declspec(dllexport)
+#else
+#define WINEMETAL_API
+#endif
+
+#include "winemetal_thunks.h"
+#include "ember_neural_thunks.h"
+#include <wineunixlib.h>
+#include <string.h>
+
+#define EN_CALL(i, params) WINE_UNIX_CALL(EMBER_NEURAL_UNIX_CALL_BASE + (i), params)
+
+WINEMETAL_API obj_handle_t
+EmberNeural_open(
+    obj_handle_t device, const char *spec, const char *units, uint32_t want_w, uint32_t want_h, uint32_t log,
+    struct ember_neural_ane_desc *desc
+) {
+  struct unixcall_ember_neural_open params;
+  memset(&params, 0, sizeof(params));
+  params.device = device;
+  WMT_MEMPTR_SET(params.spec, spec);
+  WMT_MEMPTR_SET(params.units, units);
+  params.want_w = want_w;
+  params.want_h = want_h;
+  params.log = log;
+  WMT_MEMPTR_SET(params.desc, desc);
+  if (EN_CALL(0, &params)) return 0;   /* 유닉스 쪽이 없으면(옛 winemetal.so) 조용히 실패 */
+  return params.ret;
+}
+
+WINEMETAL_API void
+EmberNeural_close(obj_handle_t ctx) {
+  struct unixcall_generic_obj_noret params;
+  params.handle = ctx;
+  EN_CALL(1, &params);
+}
+
+WINEMETAL_API int32_t
+EmberNeural_begin(obj_handle_t ctx, obj_handle_t *input_texture) {
+  struct unixcall_ember_neural_begin params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.ret_slot = -1;
+  if (EN_CALL(2, &params)) return -1;
+  *input_texture = params.ret_texture;
+  return params.ret_slot;
+}
+
+WINEMETAL_API void
+EmberNeural_submit(obj_handle_t ctx, obj_handle_t cmdbuf, int32_t slot) {
+  struct unixcall_ember_neural_submit params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.cmdbuf = cmdbuf;
+  params.slot = slot;
+  EN_CALL(3, &params);
+}
+
+WINEMETAL_API void
+EmberNeural_cancel(obj_handle_t ctx, int32_t slot) {
+  struct unixcall_ember_neural_submit params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.slot = slot;
+  EN_CALL(4, &params);
+}
+
+WINEMETAL_API int32_t
+EmberNeural_latest(obj_handle_t ctx, obj_handle_t *lo_in, obj_handle_t *lo_out, uint64_t *seq, int32_t *age) {
+  struct unixcall_ember_neural_latest params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  if (EN_CALL(5, &params) || !params.ret_ok) return 0;
+  *lo_in = params.ret_in;
+  *lo_out = params.ret_out;
+  if (seq) *seq = params.ret_seq;
+  if (age) *age = params.ret_age;
+  return 1;
+}
+
+WINEMETAL_API void
+EmberNeural_stats(obj_handle_t ctx, struct unixcall_ember_neural_stats *st) {
+  memset(st, 0, sizeof(*st));
+  st->ctx = ctx;
+  EN_CALL(6, st);
+}
diff --git a/src/winemetal/ember_neural_thunks.h b/src/winemetal/ember_neural_thunks.h
new file mode 100644
index 0000000..aef209a
--- /dev/null
+++ b/src/winemetal/ember_neural_thunks.h
@@ -0,0 +1,73 @@
+/*
+ * Ember Neural: winemetal PE ↔ 유닉스 썽크(CoreML 워커). 유닉스 구현은 unix/ember_neural_unix.m(→ winemac.drv 의 ember_neural_ane.m).
+ * 호출 번호는 winemetal_unix.c 의 __wine_unix_call_funcs 끝에 덧붙인 순서(146~151)와 같아야 한다 — 통합 헝크 참고.
+ */
+#ifndef __EMBER_NEURAL_THUNKS_H
+#define __EMBER_NEURAL_THUNKS_H
+
+#include "winemetal.h"
+
+#pragma pack(push, 8)
+
+struct ember_neural_ane_desc {
+  uint32_t width, height, layout;   /* layout: 0 BGRA8 이미지, 1 planar fp16(R16Float, 3H 높이), 2 RGBA16F 이미지 */
+  uint32_t pad;
+  float in_scale, in_bias, out_scale, out_bias;
+};
+
+struct unixcall_ember_neural_open {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer spec;    /* NUL 종료 */
+  struct WMTConstMemoryPointer units;   /* NUL 종료, 비어 있으면 ane */
+  uint32_t want_w, want_h, log, pad;
+  struct WMTMemoryPointer desc;         /* out: ember_neural_ane_desc */
+  obj_handle_t ret;                     /* 컨텍스트 핸들, 0 이면 실패 */
+};
+
+struct unixcall_ember_neural_begin {
+  obj_handle_t ctx;
+  obj_handle_t ret_texture;
+  int32_t ret_slot;
+  uint32_t pad;
+};
+
+struct unixcall_ember_neural_submit {
+  obj_handle_t ctx;
+  obj_handle_t cmdbuf;
+  int32_t slot;
+  uint32_t pad;
+};
+
+struct unixcall_ember_neural_latest {
+  obj_handle_t ctx;
+  obj_handle_t ret_in, ret_out;
+  uint64_t ret_seq;
+  int32_t ret_age;
+  int32_t ret_ok;
+};
+
+struct unixcall_ember_neural_stats {
+  obj_handle_t ctx;
+  uint64_t done, skipped, failed;
+  double ms_ema, ms_max, open_ms;
+};
+
+#pragma pack(pop)
+
+#define EMBER_NEURAL_UNIX_CALL_BASE 146
+
+/* PE 쪽 API */
+WINEMETAL_API obj_handle_t EmberNeural_open(
+    obj_handle_t device, const char *spec, const char *units, uint32_t want_w, uint32_t want_h, uint32_t log,
+    struct ember_neural_ane_desc *desc
+);
+WINEMETAL_API void EmberNeural_close(obj_handle_t ctx);
+/* 빈 슬롯 → 슬롯 번호와 입력 텍스처 핸들(유닉스 쪽 소유, retain 하지 말 것). -1 이면 이번 프레임 건너뜀 */
+WINEMETAL_API int32_t EmberNeural_begin(obj_handle_t ctx, obj_handle_t *input_texture);
+/* 입력 텍스처에 그린 뒤: cmdbuf 에 이벤트 신호를 넣고 GPU 가 지나면 워커가 돈다 */
+WINEMETAL_API void EmberNeural_submit(obj_handle_t ctx, obj_handle_t cmdbuf, int32_t slot);
+WINEMETAL_API void EmberNeural_cancel(obj_handle_t ctx, int32_t slot);
+WINEMETAL_API int32_t EmberNeural_latest(obj_handle_t ctx, obj_handle_t *lo_in, obj_handle_t *lo_out, uint64_t *seq, int32_t *age);
+WINEMETAL_API void EmberNeural_stats(obj_handle_t ctx, struct unixcall_ember_neural_stats *st);
+
+#endif
diff --git a/src/winemetal/ember_tessellation.h b/src/winemetal/ember_tessellation.h
new file mode 100644
index 0000000..93cca86
--- /dev/null
+++ b/src/winemetal/ember_tessellation.h
@@ -0,0 +1,120 @@
+/* Ember private compatibility patch. CPU-only checks for MSC tessellation.
+ * Interface rules follow Apple's Apache-2.0 metal_irconverter_runtime.h
+ * IRRuntimeValidateTessellationPipeline. GS values here are IRInputPrimitive,
+ * not IRRuntimePrimitiveType (their point/line values differ).
+ */
+#ifndef EMBER_TESSELLATION_H
+#define EMBER_TESSELLATION_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+static inline const char *ember_tess_validate_interface(
+    uint32_t output, uint32_t gs_input, uint32_t hs_size, uint32_t ds_size,
+    uint32_t hs_constants, uint32_t ds_constants, uint32_t hs_cps, uint32_t ds_cps) {
+  if (output < 1 || output > 4)
+    return "tessellator output primitive";
+  uint32_t expected = output <= 2 ? output : 3;
+  if (gs_input != expected)
+    return "tessellator/geometry primitive mismatch";
+  if (hs_size != ds_size || hs_constants != ds_constants || hs_cps != ds_cps)
+    return "hull/domain interface mismatch";
+  if (!hs_cps || hs_cps > 32)
+    return "hull output control points";
+  return 0;
+}
+
+static inline const char *ember_tess_validate_shape(
+    uint32_t cps, uint32_t patches, uint32_t threads, uint32_t mesh_prims,
+    uint32_t output, uint32_t instances, uint32_t vs_size, float max_factor) {
+  uint32_t overlap = output == 1 ? 0 : output == 2 ? 1 : 2;
+  if (!cps || cps > 32 || !patches || patches > UINT16_MAX || !threads || threads > UINT8_MAX ||
+      (uint64_t)patches * threads > 1024 || (uint64_t)patches * cps > UINT16_MAX)
+    return "hull threadgroup shape";
+  if (output < 1 || output > 4 || mesh_prims <= overlap || mesh_prims > 1024)
+    return "mesh threadgroup shape";
+  if (!instances || instances > UINT16_MAX)
+    return "geometry instance count";
+  if (!(max_factor >= 1.0f && max_factor <= 64.0f))
+    return "max tessellation factor";
+  /* This becomes an MTLDataTypeInt function constant. It is not a separate
+   * scratch allocation: Apple's MSC 3.0 runtime reserves 15360 bytes at TG0.
+   * Defer memory checks until the compiled pipeline bindings are available.
+   */
+  /* Procedural patches may consume only SV_VertexID/SV_InstanceID and emit
+   * no VS payload. Real W3 sk001 reflects zero here and matching zero HS/DS
+   * control-point sizes; zero is a valid function constant. */
+  if (vs_size > INT32_MAX)
+    return "vertex output size";
+  return 0;
+}
+
+#define EMBER_TESS_OBJECT_MEMORY_BYTES 15360u
+static inline const char *ember_tess_validate_memory(
+    uint32_t binding_mask, uint32_t vs_size, uint32_t cps, uint32_t patches,
+    uint64_t device_limit, uint32_t *mem0, uint32_t *mem1) {
+  /* The public MSC 3.0 header uses only TG0. Preserve the prior converter
+   * compatibility layout only when the compiled reflection reports TG0+TG1.
+   * Never charge split-layout scratch to a single-slot pipeline.
+   */
+  *mem0 = *mem1 = 0;
+  if (binding_mask != 1 && binding_mask != 3)
+    return "object threadgroup memory layout";
+  uint64_t size0 = EMBER_TESS_OBJECT_MEMORY_BYTES, size1 = 0;
+  if (binding_mask == 3) {
+    if (!cps || cps > 32 || !patches || patches > UINT16_MAX)
+      return "object threadgroup scratch shape";
+    size0 = (uint64_t)vs_size * cps * patches;
+    size1 = EMBER_TESS_OBJECT_MEMORY_BYTES - 128;
+  }
+  if (size0 > UINT16_MAX || size1 > UINT16_MAX)
+    return "object threadgroup memory ABI limit";
+  if (size0 + size1 > device_limit)
+    return "object threadgroup memory device limit";
+  *mem0 = (uint32_t)size0;
+  *mem1 = (uint32_t)size1;
+  return 0;
+}
+static inline const char *ember_tess_validate_memory_binding(
+    uint32_t allocated, uint64_t reflected_size, uint64_t reflected_alignment) {
+  if (reflected_size > allocated ||
+      (reflected_alignment && allocated % reflected_alignment))
+    return "object threadgroup memory reflection size/alignment";
+  return 0;
+}
+/* Reject outputless UAV GS before calling MSC (including from the harness). */
+static inline int ember_tess_gs_has_outputs(const void *bytes, size_t n) {
+  const uint8_t *p = (const uint8_t *)bytes;
+  uint32_t parts;
+  if (!p || n < 32 || memcmp(p, "DXBC", 4)) return 0;
+  memcpy(&parts, p + 28, 4);
+  if (parts > 64 || 32 + 4ull * parts > n) return 0;
+  int has_outputs = 0;
+  for (uint32_t i = 0; i < parts; ++i) {
+    uint32_t off, size, count;
+    memcpy(&off, p + 32 + 4 * i, 4);
+    if ((uint64_t)off + 8 > n) return 0;
+    memcpy(&size, p + off + 4, 4);
+    if ((uint64_t)off + 8 + size > n) return 0;
+    if (!memcmp(p + off, "OSG1", 4) || !memcmp(p + off, "OSGN", 4) || !memcmp(p + off, "OSG5", 4)) {
+      if (size < 4) return 0;
+      memcpy(&count, p + off + 8, 4);
+      has_outputs |= count != 0;
+    }
+  }
+  return has_outputs;
+}
+
+struct ember_tess_draw_info {
+  uint16_t indexType;
+  uint8_t primitiveTopology, threadsPerPatch;
+  uint16_t maxInputPrimitivesPerMeshThreadgroup, objectThreadgroupVertexStride;
+  uint16_t meshThreadgroupPrimitiveStride, gsInstanceCount;
+  uint16_t patchesPerObjectThreadgroup, inputControlPointsPerPatch;
+  uint64_t indexBuffer;
+};
+
+static inline uint32_t ember_tess_grid_width(uint32_t count, uint32_t stride) {
+  return stride ? count / stride + (count % stride != 0) : 0;
+}
+#endif
