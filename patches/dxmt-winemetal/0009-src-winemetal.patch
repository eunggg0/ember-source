+static NTSTATUS
+_MTLCommandQueue_commandBuffer(void *obj) {
+  struct unixcall_generic_obj_obj_ret *params = obj;
+  if (ember_enc_status < 0)
+    ember_enc_status = ember_cfg_flag("EMBER_MTL_ENCODER_STATUS");
+  if (ember_enc_status) {
+    if (@available(macOS 11.0, *)) {
+      MTLCommandBufferDescriptor *desc = [MTLCommandBufferDescriptor new];
+      desc.errorOptions = MTLCommandBufferErrorOptionEncoderExecutionStatus;
+      id<MTLCommandBuffer> cb = [(id<MTLCommandQueue>)params->handle commandBufferWithDescriptor:desc];
+      [desc release];
+      [cb addCompletedHandler:^(id<MTLCommandBuffer> c) {
+        NSError *e = c.error;
+        if (!e)
+          return;
+        NSArray *infos = e.userInfo[MTLCommandBufferEncoderInfoErrorKey];
+        fprintf(stderr, "ember-encstatus: cmdbuf error %ld (%lu encoders)\n", (long)e.code, (unsigned long)infos.count);
+        for (id<MTLCommandBufferEncoderInfo> i in infos)
+          fprintf(stderr, "ember-encstatus:   %-40s state %ld\n", i.label ? i.label.UTF8String : "(nolabel)", (long)i.errorState);
+      }];
+      params->ret = (obj_handle_t)cb;
+      return STATUS_SUCCESS;
+    }
+  }
+  params->ret = (obj_handle_t)[(id<MTLCommandQueue>)params->handle commandBuffer];
+  return STATUS_SUCCESS;
+}
