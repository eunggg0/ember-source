+/* Ember: EMBER_FG_LOG=1 이면 Metal 에 낸 시각 → 실제 화면에 뜬 시각(표시 지연)을 5초마다 stderr 로.
+ * DXMT 큐 쪽 로그(dxmt-lat: queue=)와 더하면 게임 Present → 화면 전체 지연이다. */
+static int ember_lat_on = -1;
+static _Atomic double ember_lat_sum = 0;
+static _Atomic int ember_lat_n = 0;
+static _Atomic int ember_lat_dropped = 0;
+static _Atomic double ember_lat_since = 0;
+static _Atomic int ember_lat_want = 0;      /* 오버레이·보간이 getProps 로 지연을 물으면 1 */
+static _Atomic double ember_lat_ema = 0;    /* 초 */
+/* Ember 수직동기 위상(페이서 위상 모드용, getProps 가 돌려준다): 마지막 presentedTime(보간 프레임 포함)과 그 간격의 EMA.
+ * presentedTime 은 CACurrentMediaTime 영역. 간격은 화면 주기의 0.7~1.3 배 안에 드는 표본만(그 밖은 빠진 칸). */
+static _Atomic double ember_vs_last = 0;
+static _Atomic double ember_vs_period = 0;
+static _Atomic double ember_vs_nominal = 0;   /* 1/주사율(getProps 가 채움) */
+static _Atomic double ember_at_sum = 0;       /* atTime 지정 시각 → presentedTime (초 합) */
+static _Atomic int ember_at_n = 0;
+static _Atomic int ember_at_late = 0;         /* 지정 시각보다 1.5 칸 넘게 늦게 뜬 것(놓친 칸) */
+static _Atomic int ember_gen_dropped = 0;     /* 보간 프레임이 안 뜬 것(덮임) */
+static _Atomic int ember_inflight = 0;        /* 낸 뒤 presented 핸들러가 아직 안 온 드로어블 수 */
+static int ember_vs_trace = -1;               /* EMBER_VSYNC_TRACE=N: 처음 N 장을 stderr 로 */
+static _Atomic int ember_vs_trace_left = 0;
+static _Atomic double ember_vs_trace_base = 0;
+
+/* generated: 보간 프레임(지연 통계에서 뺀다, 위상은 갱신). at: presentDrawable:atTime: 의 지정 시각(0 = 즉시) */
+static void
+ember_track_present(id<MTLDrawable> d, int generated, double at, int expect) {
+  double t0;
+  if (ember_lat_on < 0) {
+    const char *e = getenv("EMBER_FG_LOG");
+    if (!e) e = getenv("EMBER_D3DM_FG_LOG");
+    ember_lat_on = e && !strcmp(e, "1");
+    e = getenv("EMBER_VSYNC_TRACE");
+    ember_vs_trace = e ? atoi(e) : 0;
+    ember_vs_trace_left = ember_vs_trace;
+  }
+  if (!ember_lat_on && !ember_lat_want) return;
+  t0 = CACurrentMediaTime();
+  if (@available(macOS 10.15.4, *)) {
+    ember_inflight++;
+    [d addPresentedHandler:^(id<MTLDrawable> dr) {
+      double t = dr.presentedTime, now = CACurrentMediaTime(), since;
+      ember_inflight--;
+      if (t > 0) {
+        /* 위상: 실제로 뜬 모든 프레임 */
+        double last = ember_vs_last, nominal = ember_vs_nominal;
+        if (nominal <= 0) nominal = ember_vs_period > 0 ? ember_vs_period : 1.0 / 60.0;
+        if (last > 0 && t > last) {
+          double dt = t - last;
+          if (dt > nominal * 0.7 && dt < nominal * 1.3) {
+            double pe = ember_vs_period;
+            ember_vs_period = pe > 0 ? pe * 0.9 + dt * 0.1 : dt;
+          }
+        }
+        if (t > last) ember_vs_last = t;
+        if (at > 0) {
+          /* 기대 칸(expect) 또는 atTime 지정 시각 → 실제로 뜬 시각. 기대 칸이면 반 칸 넘게 어긋난 것을 late 로 */
+          double per = ember_vs_period > 0 ? ember_vs_period : nominal;
+          ember_at_sum += t - at; ember_at_n++;
+          if (t - at > per * (expect ? 0.5 : 1.5)) ember_at_late++;
+        }
+      }
+      if (ember_vs_trace_left > 0) {
+        double base = ember_vs_trace_base;
+        if (base == 0) { base = t0; ember_vs_trace_base = base; }
+        ember_vs_trace_left--;
+        fprintf(stderr, "vt: gen=%d call=%.3f at=%.3f shown=%.3f (ms)\n", generated, (t0 - base) * 1000,
+                at > 0 ? (at - base) * 1000 : 0.0, t > 0 ? (t - base) * 1000 : -1.0);
+      }
+      if (generated) {
+        if (t == 0) ember_gen_dropped++;
+        return;
+      }
+      if (t > t0 && t - t0 < 1.0) {
+        double e = ember_lat_ema;
+        ember_lat_ema = e > 0 ? e * 0.75 + (t - t0) * 0.25 : t - t0;   /* 가드가 빨리 반응하게 */
+        ember_lat_sum += t - t0; ember_lat_n++;
+      }
+      else if (t == 0) ember_lat_dropped++;
+      if (!ember_lat_on) return;
+      since = ember_lat_since;
+      if (since == 0) ember_lat_since = now;
+      else if (now - since >= 5.0) {
+        int n = ember_lat_n, an = ember_at_n;
+        fprintf(stderr, "winemetal-lat: display=%.1fms presented=%d dropped=%d gen_dropped=%d at=%.2fms/%d late=%d period=%.3fms\n",
+                n ? ember_lat_sum / n * 1000 : 0.0, n, (int)ember_lat_dropped, (int)ember_gen_dropped,
+                an ? ember_at_sum / an * 1000 : 0.0, an, (int)ember_at_late, ember_vs_period * 1000);
+        ember_lat_sum = 0; ember_lat_n = 0; ember_lat_dropped = 0; ember_lat_since = now;
+        ember_gen_dropped = 0; ember_at_sum = 0; ember_at_n = 0; ember_at_late = 0;
+      }
+    }];
+  }
+}
