diff --git a/src/winemetal/unix/cache.c b/src/winemetal/unix/cache.c
index f7a122b..79b432e 100644
--- a/src/winemetal/unix/cache.c
+++ b/src/winemetal/unix/cache.c
@@ -229,7 +229,11 @@ extern NSString* MTLGetShaderCachePath();
