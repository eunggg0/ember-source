+
+#ifndef IRDESCRIPTORRANGEFLAGS_H
+#define IRDESCRIPTORRANGEFLAGS_H
+
+typedef enum IRDescriptorRangeFlags
+{
+    IRDescriptorRangeFlagNone                                       = 0,
