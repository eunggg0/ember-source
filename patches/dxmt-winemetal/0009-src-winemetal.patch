+/* ---- Ember(d12games4): 자리잡이 희소 자원 (호출 158) — D3D12 예약(타일) 자원을 Metal 4 placement sparse 로.
+ * 자원은 메모리 없이 만들고, UpdateTileMappings 가 MTL4CommandQueue 의 updateBufferMappings/updateTextureMappings 로
+ * 자리잡이 힙(maxCompatiblePlacementSparsePageSize)의 타일을 건다. 매핑 큐와 DXMT 의 고전 큐는 공유 이벤트로 줄 세운다.
+ * 실측(M4 Pro, macOS 27): 고전 MTLCommandQueue 에서 읽고 쓰기·힙 별칭·안 건 타일 0 읽기 모두 된다. */
+static NTSTATUS
+_EmberSparse_call(void *obj) {
+  struct unixcall_ember_sparse *p = obj;
+  p->ret = 0;
+  if (@available(macOS 26.0, *)) {
+    @autoreleasepool {
+      switch (p->op) {
+      case EMBER_SPARSE_OP_SUPPORTED: {
+        id<MTLDevice> d = ember_device(p->device, __func__);
+        BOOL ok = NO;
+        if ([d respondsToSelector:@selector(supportsPlacementSparse)])
+          ok = [(id)d supportsPlacementSparse];
+        p->ret = ok && [d respondsToSelector:@selector(newMTL4CommandQueue)] ? 1 : 0;
+        break;
+      }
+      case EMBER_SPARSE_OP_NEW_BUFFER: {
+        id<MTLDevice> d = ember_device(p->device, __func__);
+        id<MTLBuffer> b = [d newBufferWithLength:p->length options:(MTLResourceOptions)p->options
+                                placementSparsePageSize:(MTLSparsePageSize)p->page];
+        p->out_handle = (obj_handle_t)b;
+        p->out_gpu_address = b ? [b gpuAddress] : 0;
+        p->ret = b != nil;
+        break;
+      }
+      case EMBER_SPARSE_OP_NEW_TEXTURE: {
+        id<MTLDevice> d = ember_device(p->device, __func__);
+        struct WMTTextureInfo *info = p->info.ptr;
+        MTLTextureDescriptor *desc = [[MTLTextureDescriptor alloc] init];
+        fill_texture_descriptor(desc, info);
+        desc.placementSparsePageSize = (MTLSparsePageSize)p->page;
+        id<MTLTexture> t = [d newTextureWithDescriptor:desc];
+        [desc release];
+        p->out_handle = (obj_handle_t)t;
+        if (t) {
+          info->gpu_resource_id = [t gpuResourceID]._impl;
+          info->mach_port = 0;
+          p->out[0] = [t firstMipmapInTail];
+          p->out[1] = [t tailSizeInBytes];
+          p->out[2] = (uint64_t)[t sparseTextureTier];
+        }
+        p->ret = t != nil;
+        break;
+      }
+      case EMBER_SPARSE_OP_TILE_SIZE: {
+        id<MTLDevice> d = ember_device(p->device, __func__);
+        MTLSize sz = [d sparseTileSizeWithTextureType:(MTLTextureType)p->tex_type
+                                          pixelFormat:to_metal_pixel_format(p->pixel_format)
+                                          sampleCount:p->samples ? p->samples : 1
+                                       sparsePageSize:(MTLSparsePageSize)p->page];
+        p->out[0] = sz.width;
+        p->out[1] = sz.height;
+        p->out[2] = sz.depth;
+        p->ret = sz.width != 0;
+        break;
+      }
+      case EMBER_SPARSE_OP_NEW_QUEUE: {
+        id<MTLDevice> d = ember_device(p->device, __func__);
+        id<MTL4CommandQueue> q = [d newMTL4CommandQueue];
+        p->out_handle = (obj_handle_t)q;
+        p->ret = q != nil;
+        break;
+      }
+      case EMBER_SPARSE_OP_MAP_BUFFER: {
+        const struct ember_sparse_buffer_op *in = p->ops.ptr;
+        MTL4UpdateSparseBufferMappingOperation *ops = calloc(p->op_count ? p->op_count : 1, sizeof(*ops));
+        for (uint64_t i = 0; i < p->op_count; i++) {
+          ops[i].mode = in[i].mode ? MTLSparseTextureMappingModeUnmap : MTLSparseTextureMappingModeMap;
+          ops[i].bufferRange = NSMakeRange(in[i].start, in[i].count);
+          ops[i].heapOffset = in[i].heap_offset;
+        }
+        [(id<MTL4CommandQueue>)p->queue updateBufferMappings:(id<MTLBuffer>)p->resource heap:(id<MTLHeap>)p->heap
+                                                  operations:ops count:p->op_count];
+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_MAP_TEXTURE: {
+        const struct ember_sparse_texture_op *in = p->ops.ptr;
+        MTL4UpdateSparseTextureMappingOperation *ops = calloc(p->op_count ? p->op_count : 1, sizeof(*ops));
+        for (uint64_t i = 0; i < p->op_count; i++) {
+          ops[i].mode = in[i].mode ? MTLSparseTextureMappingModeUnmap : MTLSparseTextureMappingModeMap;
+          ops[i].textureRegion = MTLRegionMake3D(in[i].x, in[i].y, in[i].z, in[i].w, in[i].h, in[i].d);
+          ops[i].textureLevel = in[i].level;
+          ops[i].textureSlice = in[i].slice;
+          ops[i].heapOffset = in[i].heap_offset;
+        }
+        [(id<MTL4CommandQueue>)p->queue updateTextureMappings:(id<MTLTexture>)p->resource heap:(id<MTLHeap>)p->heap
+                                                   operations:ops count:p->op_count];
+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_COPY_BUFFER: {
+        const struct ember_sparse_copy_buffer_op *in = p->ops.ptr;
+        MTL4CopySparseBufferMappingOperation *ops = calloc(p->op_count ? p->op_count : 1, sizeof(*ops));
+        for (uint64_t i = 0; i < p->op_count; i++) {
+          ops[i].sourceRange = NSMakeRange(in[i].src_start, in[i].count);
+          ops[i].destinationOffset = in[i].dst_start;
+        }
+        [(id<MTL4CommandQueue>)p->queue copyBufferMappingsFromBuffer:(id<MTLBuffer>)p->resource
+                                                            toBuffer:(id<MTLBuffer>)p->resource2
+                                                          operations:ops count:p->op_count];
+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_COPY_TEXTURE: {
+        const struct ember_sparse_copy_texture_op *in = p->ops.ptr;
+        MTL4CopySparseTextureMappingOperation *ops = calloc(p->op_count ? p->op_count : 1, sizeof(*ops));
+        for (uint64_t i = 0; i < p->op_count; i++) {
+          ops[i].sourceRegion = MTLRegionMake3D(in[i].sx, in[i].sy, in[i].sz, in[i].w, in[i].h, in[i].d);
+          ops[i].sourceLevel = in[i].src_level;
+          ops[i].sourceSlice = in[i].src_slice;
+          ops[i].destinationOrigin = MTLOriginMake(in[i].dx, in[i].dy, in[i].dz);
+          ops[i].destinationLevel = in[i].dst_level;
+          ops[i].destinationSlice = in[i].dst_slice;
+        }
+        [(id<MTL4CommandQueue>)p->queue copyTextureMappingsFromTexture:(id<MTLTexture>)p->resource
+                                                             toTexture:(id<MTLTexture>)p->resource2
+                                                            operations:ops count:p->op_count];
+        free(ops);
+        p->ret = 1;
+        break;
+      }
+      case EMBER_SPARSE_OP_WAIT:
+        [(id<MTL4CommandQueue>)p->queue waitForEvent:(id<MTLEvent>)p->event value:p->value];
+        p->ret = 1;
+        break;
+      case EMBER_SPARSE_OP_SIGNAL:
+        [(id<MTL4CommandQueue>)p->queue signalEvent:(id<MTLEvent>)p->event value:p->value];
+        p->ret = 1;
+        break;
+      default:
