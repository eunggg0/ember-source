+static const int SIGNALS[] = {
+    SIGHUP,
+    SIGINT,
+    SIGTERM,
+    SIGUSR2,
+    SIGILL,
+    SIGTRAP,
+    SIGABRT,
+    SIGFPE,
+    SIGBUS,
