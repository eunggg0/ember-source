     if (encoder_last)
       return E_INVALIDARG;
     *pStartEncoder = encoder_last = &encoder_lists_.emplace_back(EncoderType::Null, nullptr);
+    ember_pending_clears_.clear();
+    ember_barrier_pending_ = false; /* 목록 경계의 동기화는 큐가 따로 한다 — 여기선 이 목록 안의 장벽만 센다 */
+    ember_bres_.clear();
+    ember_bres_info_.clear();
+    ember_bres_unsafe_ = false;
     return S_OK;
   }
 
@@ -169,11 +174,42 @@ public:
     }
   }
 
+  /* Ember: 바로 앞의 전체 지우기 패스들 — 다음 렌더 패스가 같은 첨부를 쓰면 로드 동작(Clear)으로 합친다 */
+  small_vector<ClearEncoderData *, 8> ember_pending_clears_;
+
+  bool ember_barrier_pending_ = true;
+  small_vector<void *, 32> ember_bres_;
+  small_vector<uint64_t, 32> ember_bres_info_;
+  bool ember_bres_unsafe_ = true;
+  bool ember_barrier_mid_ = false; /* Ember: 열린 컴퓨트 인코더 안에서 장벽이 있었나(동시 디스패치 → 메모리 장벽) */
+
   template <typename T>
   T *
   AllocatePass() {
     auto p = (new (AllocateCPUHeap(sizeof(T), alignof(T))) T());
     encoder_current = p;
+    p->ember_barrier = ember_barrier_pending_;
+    if (ember_barrier_pending_) {
+      p->ember_bres_unsafe = ember_bres_unsafe_;
+      p->ember_bres_count = (uint16_t)ember_bres_.size();
+      if (!ember_bres_.empty()) {
+        p->ember_bres = (void **)AllocateCPUHeap(sizeof(void *) * ember_bres_.size(), alignof(void *));
+        p->ember_bres_info = (uint64_t *)AllocateCPUHeap(sizeof(uint64_t) * ember_bres_.size(), alignof(uint64_t));
+        for (size_t i = 0; i < ember_bres_.size(); i++) {
+          p->ember_bres[i] = ember_bres_[i];
+          p->ember_bres_info[i] = i < ember_bres_info_.size() ? ember_bres_info_[i] : 0;
+        }
+      }
+    }
+    ember_bres_.clear();
+    ember_bres_info_.clear();
+    ember_bres_unsafe_ = false;
+    ember_barrier_pending_ = false;
+    ember_barrier_mid_ = false;
+    if constexpr (std::is_same_v<T, ClearEncoderData>)
+      ember_pending_clears_.push_back(p);
+    else
+      ember_pending_clears_.clear();
     return p;
   };
 
