+  uint64_t *ember_bres_info = nullptr; /* 진단: (전 상태 << 32 | 후 상태), 맨 위 비트 = 텍스처 */
+  uint16_t ember_bres_count = 0;
+  bool ember_bres_unsafe = false;
 };
 
