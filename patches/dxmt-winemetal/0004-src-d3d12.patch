+/* IR 은 2D·2DMS·큐브 텍스처를 배열형(texture2d_array·texture2d_ms_array·texturecube_array)으로 읽는다
+ * (Texture1D 도 2D 배열, 3D 는 그대로 — 실측: irprobe). DXMT 자체 셰이더는 비배열 뷰를 쓰므로 IR 칸에만 배열 뷰를 넣는다. */
+static uint64_t
+IRTextureResourceID(Texture *texture, TextureViewKey view) {
+  switch (texture->textureType(view)) {
+  case WMTTextureType2D:
+  case WMTTextureType2DMultisample:
+  case WMTTextureTypeCube:
+    return texture->view(texture->checkViewUseArray(view, true)).gpuResourceID;
+  default:
+    return texture->view(view).gpuResourceID;
+  }
+}
+
+/* 형식 있는 버퍼(Buffer<float4> 등): IR 은 텍스처 버퍼 뷰를 0 번부터 읽는다(메타데이터의 요소 오프셋은 안 본다 — 실측).
+ * FirstElement 가 있으면 그 자리(16바이트 정렬)에서 시작하는 뷰를 따로 만들어 칸에 붙여 둔다. */
+static IRDescEntry
+IRTexelEntry(
+    Buffer *buffer, const BufferView &whole, const BufferSlice &Slice, bool uav,
+    WMT::Reference<WMT::Texture> &keep
+) {
+  keep = {};
+  uint64_t va = buffer->current()->gpuAddress() + Slice.byteOffset;
+  if (!Slice.firstElement)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  auto format = const_cast<BufferView &>(whole).texture.pixelFormat();
+  uint64_t texel = MTLGetTexelSize(format);
+  uint64_t aligned = Slice.byteOffset & ~15ull;
+  uint64_t rem = texel ? (Slice.byteOffset - aligned) / texel : 0;
+  if (rem) {
+    static bool warned = false;
+    if (!warned) {
+      warned = true;
+      WARN("Ember DXIL: typed buffer view offset not 16-byte aligned (", Slice.byteOffset, "), off by ", rem, " elements");
+    }
+  }
+  auto allocation = buffer->current();
+  WMTTextureInfo info;
+  info.type = WMTTextureTypeTextureBuffer;
+  uint64_t length = Slice.byteLength + (Slice.byteOffset - aligned);
+  info.width = texel ? length / texel : 0;
+  info.height = 1;
+  info.depth = 1;
+  info.array_length = 1;
+  info.mipmap_level_count = 1;
+  info.sample_count = 1;
+  info.pixel_format = format;
+  info.options = allocation->options();
+  auto usage = WMTTextureUsageShaderRead;
+  if (uav) {
+    usage |= WMTTextureUsageShaderWrite;
+    if (format == WMTPixelFormatR32Uint || format == WMTPixelFormatR32Sint)
+      usage |= WMTTextureUsageShaderAtomic;
+  }
+  info.usage = usage;
+  if (!info.width)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  keep = allocation->buffer().newTexture(info, aligned, length);
+  if (!keep)
+    return {va, whole.gpu_resource_id, IRBufferMetadata(Slice.byteLength, 0, true)};
+  return {va, info.gpu_resource_id, IRBufferMetadata(Slice.byteLength, (uint32_t)rem, true)};
+}
+
+uint64_t
+EmberTranslateDescriptorTableVA(uint64_t va) {
+  if (!va)
+    return 0;
+  std::unique_lock<dxmt::mutex> lock(ir_registry_lock);
+  auto it = ir_registry.upper_bound(va);
+  if (it == ir_registry.begin())
+    return 0;
+  --it;
+  uint64_t index = (va - it->first) / 32; /* DXMT 서술자 크기 = 32 */
+  if (index >= it->second.count + 1)
+    return 0;
+  return it->second.ir_base + index * sizeof(IRDescEntry);
+}
