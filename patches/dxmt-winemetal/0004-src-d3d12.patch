+/* Ember DXIL */
+bool
+EmberIsDXIL(D3D12_SHADER_BYTECODE Bytecode) {
+  if (!Bytecode.pShaderBytecode || Bytecode.BytecodeLength < 32)
+    return false;
+  microsoft::CDXBCParser Parser;
+  if (FAILED(Parser.ReadDXBC(Bytecode.pShaderBytecode, Bytecode.BytecodeLength)))
+    return false;
+  return Parser.FindNextMatchingBlob(microsoft::DXBC_DXIL) != DXBC_BLOB_NOT_FOUND;
+}
