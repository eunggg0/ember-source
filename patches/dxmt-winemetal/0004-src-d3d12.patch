+   * 그 전부를 기다린다. 목록 첫 인코더·Present·내부 지우기 도우미 앞뒤는 늘 기다린다. */
+  static constexpr unsigned kEmberRing = 16;
+  bool ember_barrier_sync_ = false;
+  WMT::Reference<WMT::Fence> ember_ring_[kEmberRing];
+  unsigned ember_ring_next_ = 0;
+  unsigned ember_pending_[kEmberRing];
+  unsigned ember_pending_count_ = 0;
+  bool ember_force_sync_ = true;
+  small_vector<obj_handle_t, 16> ember_recent_targets_;
+  uint64_t ember_stat_waits_ = 0, ember_stat_skips_ = 0;
+
+  bool
+  EmberNeedSync(EncoderData *current, obj_handle_t *targets, unsigned num_targets) {
+    bool sync = ember_force_sync_ || current->ember_barrier || current->type == EncoderType::Resolve ||
+                ember_pending_count_ + 1 >= kEmberRing;
+    if (!sync) {
+      for (unsigned i = 0; i < num_targets && !sync; i++)
+        for (auto h : ember_recent_targets_)
+          if (h == targets[i]) {
+            sync = true;
+            break;
+          }
+    }
+    if (sync)
+      ember_recent_targets_.clear();
+    for (unsigned i = 0; i < num_targets; i++)
+      ember_recent_targets_.push_back(targets[i]);
+    ember_force_sync_ = false;
+    if (sync)
+      ember_stat_waits_++;
+    else
+      ember_stat_skips_++;
+    return sync;
+  }
+
+  /* Ember: 장벽 동기화의 "합류 집합". D3D12 장벽은 앞의 모든 일과 뒤의 모든 일을 가른다 — 장벽 바로 뒤 인코더만이 아니라
+   * 다음 장벽까지의 모든 인코더가 장벽 앞 일을 기다려야 한다(2026-10-01 수정: 예전엔 첫 인코더만 기다려 스텔라 블레이드
+   * 캐릭터가 깨졌다). 동기화 때 지금 구간의 펜스들이 새 합류 집합이 되고, 같은 구간의 인코더는 모두 그 집합을 기다린다.
+   * 구간 안의 인코더는 각자 앞 합류 집합을 기다렸으므로 이행성으로 그 전 일도 끝나 있다. 고리 칸을 다시 쓰면 기다림이
+   * 더 나중 인코더에 묶일 뿐(그 인코더도 합류 집합을 기다렸다) 순서는 지켜진다. */
+  /* Ember: 단계 동기화(EMBER_D12_STAGE_SYNC). 기본 사슬(모든 인코더가 앞 인코더 끝을 기다림)은 그대로 두되, 장벽 없는
+   * 렌더 패스는 앞 패스 끝을 정점 단계가 아니라 조각 단계에서 기다린다 — 다음 패스의 정점 작업이 앞 패스 조각 작업과 겹친다.
+   * 정점 단계는 대신 "구간 펜스"(마지막 장벽 인코더의 정점 단계 끝 = 장벽 앞 일이 모두 끝남)를 기다린다. 사슬 펜스는
+   * 늘 조각 단계 끝에 갱신되므로 "사슬 펜스의 마지막 갱신 = 앞 일 전부 끝"이 유지된다(표시·Signal·컴퓨트는 그대로). */
+  bool ember_stage_sync_ = false;
+  WMT::Reference<WMT::Fence> ember_epoch_fence_;
+  uint64_t ember_stat_overlap_ = 0;
+
+  /* Ember(10-01): 렌더 패스의 펜스 대기·갱신 단계. 예전엔 대기가 정점 단계뿐이라 GS 에뮬(객체·메시 단계)은 앞 일을 안
+   * 기다렸고, 갱신은 조각 단계 뒤뿐이라 조각이 없는 그리기(정점·메시에서만 쓰기)는 안 덮였다. */
+  /* EMBER_D12_PRERASTER=0 이면 예전처럼(정점 대기·조각 뒤 갱신) — A/B 용 */
+  WMTRenderStages kEmberPreRaster = WMTRenderStagePreRaster;
+  WMTRenderStages kEmberAllRender = (WMTRenderStages)(WMTRenderStagePreRaster | WMTRenderStageFragment);
+
+  /* Ember 진단: EMBER_D12_LABELS=1 — 인코더마다 라벨(프레임 안 순번·종류·크기·장벽·동기). EMBER_MTL_ENCODER_STATUS 와 같이 쓰면
+   * GPU 오류 때 어느 인코더가 멈췄는지 나온다 */
+  bool ember_labels_ = false;
+  unsigned ember_label_seq_ = 0;
+
+  template <typename Encoder>
+  void
+  EmberLabel(Encoder &encoder, EncoderData *current, const char *kind, bool sync) {
+    if (!ember_labels_)
+      return;
+    char buf[160];
+    unsigned w = 0, h = 0, f = 0, draws = 0;
+    if (current->type == EncoderType::Render) {
+      auto d = static_cast<RenderEncoderData *>(current);
+      w = d->render_target_width;
+      h = d->render_target_height;
+      uint64_t t = 0;
+      for (auto &c : d->colors)
+        if (c.attachment) {
+          f = (unsigned)c.attachment.texture().pixelFormat();
+          t = 1;
+          break;
+        }
+      if (!t && d->depth.attachment)
+        f = (unsigned)d->depth.attachment.texture().pixelFormat();
+      for (auto cmd = (const wmtcmd_base *)&d->cmd_head; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr)
+        if (cmd->type == WMTRenderCommandDraw || cmd->type == WMTRenderCommandDrawIndexed ||
+            cmd->type == WMTRenderCommandDrawIndirect || cmd->type == WMTRenderCommandDrawIndexedIndirect ||
+            cmd->type == WMTRenderCommandDrawMeshThreadgroups || cmd->type == WMTRenderCommandExecuteCommandsInBuffer)
+          draws++;
+    }
+    snprintf(buf, sizeof(buf), "%s#%u %ux%u f%u n%u b%u i%u s%u", kind, ember_label_seq_++, w, h, f, draws,
+             (unsigned)current->ember_barrier, (unsigned)current->ember_barrier_inside, (unsigned)sync);
+    encoder.setLabel(WMT::String::string(buf, WMTUTF8StringEncoding));
+  }
+
+  /* EMBER_D12_STAGE_SYNC_MASK(진단·안전): 1 = 앞 렌더 패스와 첨부가 하나라도 같으면 겹치지 않음,
+   * 2 = ExecuteIndirect(ICB)·메시(GS 에뮬) 그리기가 있는 패스는 앞뒤로 겹치지 않음, 4 = 앞이 렌더 패스가 아니면 겹치지 않음 */
+  int ember_ss_mask_ = 0;
+  RenderEncoderData *ember_ss_prev_ = nullptr;
+
+  static bool
+  EmberHasSpecialDraws(RenderEncoderData *d) {
+    for (auto cmd = (const wmtcmd_base *)&d->cmd_head; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr)
+      if (cmd->type == WMTRenderCommandExecuteCommandsInBuffer || cmd->type == WMTRenderCommandDrawMeshThreadgroups)
+        return true;
+    return false;
+  }
+
+  bool
+  EmberStageSyncFor(EncoderData *current) {
+    bool sync = ember_force_sync_ || current->ember_barrier || current->ember_barrier_inside;
+    auto cur = static_cast<RenderEncoderData *>(current);
+    auto prev = ember_ss_prev_;
+    ember_ss_prev_ = cur;
+    if (!sync && ember_ss_mask_) {
+      if ((ember_ss_mask_ & 4) && !prev)
+        sync = true;
+      if (!sync && (ember_ss_mask_ & 1) && prev)
+        for (auto t : cur->ember_att)
+          for (auto u : prev->ember_att)
+            if (t && t == u)
+              sync = true;
+      if (!sync && (ember_ss_mask_ & 2) && (EmberHasSpecialDraws(cur) || (prev && EmberHasSpecialDraws(prev))))
+        sync = true;
+    }
+    ember_force_sync_ = false;
+    if (sync)
+      ember_stat_waits_++;
+    else
+      ember_stat_overlap_++;
+    return sync;
+  }
+
+  /* 단계 동기화: 렌더 아닌 인코더는 늘 앞 일 전부를 기다리므로(사슬) 끝날 때 구간 펜스도 갱신해도 된다 */
+  template <typename Encoder, typename... Stage>
+  void
+  EmberEpochUpdate(Encoder &encoder, Stage... stage) {
+    if (!ember_stage_sync_ || ember_barrier_sync_)
+      return;
+    encoder.updateFence(ember_epoch_fence_, stage...);
+    ember_force_sync_ = false;
+  }
+
+  unsigned ember_join_[kEmberRing];
+  unsigned ember_join_count_ = 0;
+
+  template <typename Encoder, typename... Stage>
+  void
+  EmberWait(Encoder &encoder, bool sync, Stage... stage) {
+    if (!ember_barrier_sync_) {
+      encoder.waitForFence(fence_, stage...);
+      return;
+    }
+    if (sync && ember_pending_count_) {
+      memcpy(ember_join_, ember_pending_, sizeof(unsigned) * ember_pending_count_);
+      ember_join_count_ = ember_pending_count_;
+      ember_pending_count_ = 0;
+    }
+    for (unsigned i = 0; i < ember_join_count_; i++)
+      encoder.waitForFence(ember_ring_[ember_join_[i]], stage...);
+  }
+
+  template <typename Encoder, typename... Stage>
+  void
+  EmberUpdate(Encoder &encoder, Stage... stage) {
+    if (!ember_barrier_sync_) {
+      encoder.updateFence(fence_, stage...);
+      return;
+    }
+    unsigned slot = ember_ring_next_++ % kEmberRing;
+    encoder.updateFence(ember_ring_[slot], stage...);
+    for (unsigned i = 0; i < ember_pending_count_; i++)
+      if (ember_pending_[i] == slot)
+        return;
+    ember_pending_[ember_pending_count_++] = slot;
+  }
+  std::unordered_map<uint64_t, EmberProfAgg> ember_prof_map_;
+  /* Ember: 대상(첫 첨부 텍스처)별 합계 — 한 아틀라스가 여러 패스로 쪼개져도 한 줄로 본다 */
+  struct EmberTargetAgg {
+    EmberProfInfo info;
+    uint64_t ns = 0, passes = 0, d3d_passes = 0, draws = 0, loads = 0, clears = 0;
   };
+  std::unordered_map<uint64_t, EmberTargetAgg> ember_target_map_;
+  uint64_t ember_prof_kind_ns_[8] = {};
+  uint64_t ember_prof_kind_count_[8] = {};
+  uint64_t ember_prof_frames_ = 0;
+  uint64_t ember_prof_seq_presents_ = 0;
+  uint64_t ember_prof_total_ns_ = 0;
+  uint64_t ember_prof_first_start_ = 0, ember_prof_last_end_ = 0;
+
+  void
+  EmberProfRecord(InflightCommandBuffer &inflight) {
+    uint64_t t0 = inflight.cmdbuf.gpuStartTime(), t1 = inflight.cmdbuf.gpuEndTime();
+    uint64_t dt = t1 > t0 ? t1 - t0 : 0;
+    auto &info = inflight.prof;
+    if (!ember_prof_first_start_)
+      ember_prof_first_start_ = t0;
+    ember_prof_last_end_ = std::max(ember_prof_last_end_, t1);
+    /* EMBER_D12_PROF_SEQ=N: N 번째 Present 뒤 한 프레임의 인코더 순서를 적는다(패스가 쪼개지는지 보려고) */
+    static const int seq_frame = EmberD12OptInt("EMBER_D12_PROF_SEQ", 0);
+    if (seq_frame && ember_prof_seq_presents_ && ember_prof_seq_presents_ % (uint64_t)seq_frame == 0) {
+      static const char *names[8] = {"null", "clear", "render", "blit", "compute", "resolve", "?", "?"};
+      const char *nm = info.kind == 0xff ? "present" : info.kind == 0xfe ? "signal" : info.kind == 0xfd ? "wait"
+                                                                        : names[std::min<unsigned>(info.kind, 7)];
+      EmberProfLog("ember-d12seq: %s%-8s %6.3f ms %ux%u a%u rt%u d%u fmt%u draws %u disp %u cmds %u ls %u%u/%u%u b%u m%u tgt %llx",
+                   info.ecl_first ? "| " : "  ", nm, dt / 1e6, info.width, info.height, info.array_len, info.rts,
+                   info.has_depth, info.fmt0, info.draws + info.mesh_draws, info.dispatches, info.cmds, info.load0,
+                   info.store0, info.dload, info.dstore, info.barrier, info.merged, (unsigned long long)info.target0);
+    }
+    if (info.kind == 0xfe || info.kind == 0xfd)
+      return;
+    if (info.kind == 0xff)
+      ember_prof_seq_presents_++;
+    if (info.kind == 0xff) {
+      ember_prof_frames_++;
+    } else {
+      unsigned k = std::min<unsigned>(info.kind, 6);
+      if (info.kind == (uint8_t)EncoderType::Render && info.mesh_draws)
+        k = 7;
+      ember_prof_kind_ns_[k] += dt;
+      ember_prof_kind_count_[k]++;
+    }
+    ember_prof_total_ns_ += dt;
+    auto &agg = ember_prof_map_[info.key];
+    agg.info = info;
+    agg.ns += dt;
+    agg.count++;
+    agg.draws += info.draws;
+    agg.mesh_draws += info.mesh_draws;
+    agg.dispatches += info.dispatches;
+    if (info.target0 && (info.kind == (uint8_t)EncoderType::Render || info.kind == (uint8_t)EncoderType::Clear)) {
+      auto &t = ember_target_map_[info.target0];
+      t.info = info;
+      t.ns += dt;
+      t.passes++;
+      t.d3d_passes += std::max<uint32_t>(info.merged, 1);
+      t.draws += info.draws + info.mesh_draws;
+      bool depth_main = !info.rts && info.has_depth;
+      uint8_t ld = depth_main ? info.dload : info.load0;
+      if (ld == WMTLoadActionLoad)
+        t.loads++;
+      else if (ld == WMTLoadActionClear || info.kind == (uint8_t)EncoderType::Clear)
+        t.clears++;
+    }
+    if (ember_prof_frames_ >= 200)
+      EmberProfDump();
+  }
+
+  static void
+  EmberProfLog(const char *fmt, ...) {
+    char buf[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    Logger::warn(buf);
+  }
+
+  void
+  EmberProfDump() {
+    double frames = (double)ember_prof_frames_;
+    double wall_ms = (ember_prof_last_end_ - ember_prof_first_start_) / 1e6;
+    static const char *kind_names[8] = {"null", "clear", "render", "blit", "compute", "resolve", "?", "render+GS"};
+    EmberProfLog("ember-d12prof: %.0f frames, GPU busy %.2f ms/frame, wall %.2f ms/frame", frames,
+            ember_prof_total_ns_ / 1e6 / frames, wall_ms / frames);
+    for (unsigned k = 0; k < 8; k++) {
+      if (!ember_prof_kind_count_[k])
+        continue;
+      EmberProfLog("ember-d12prof:   %-9s %7.3f ms/frame  %6.1f enc/frame", kind_names[k],
+              ember_prof_kind_ns_[k] / 1e6 / frames, ember_prof_kind_count_[k] / frames);
+    }
+    std::vector<EmberProfAgg *> v;
+    for (auto &[key, agg] : ember_prof_map_)
+      v.push_back(&agg);
+    std::sort(v.begin(), v.end(), [](auto a, auto b) { return a->ns > b->ns; });
+    for (unsigned i = 0; i < v.size() && i < 40; i++) {
+      auto a = v[i];
+      auto &in = a->info;
+      EmberProfLog(
+              "ember-d12prof:   #%02u %-9s %7.3f ms/f  x%5.1f/f  %ux%u a%u rt%u d%u fmt%u  draws %.1f mesh %.1f (tg %u) disp %.1f cmds %u ls %u%u/%u%u m%u b%u tgt %llx",
+              i, in.kind == 0xff ? "present" : kind_names[std::min<unsigned>(in.kind, 6)], a->ns / 1e6 / frames,
+              a->count / frames, in.width, in.height, in.array_len, in.rts, in.has_depth, in.fmt0, a->draws / frames,
+              a->mesh_draws / frames, in.mesh_tgs, a->dispatches / frames, in.cmds, in.load0, in.store0, in.dload, in.dstore,
+              in.merged, in.barrier, (unsigned long long)in.target0);
+    }
+    std::vector<EmberTargetAgg *> tv;
+    for (auto &[key, agg] : ember_target_map_)
+      tv.push_back(&agg);
+    std::sort(tv.begin(), tv.end(), [](auto a, auto b) { return a->ns > b->ns; });
+    for (unsigned i = 0; i < tv.size() && i < 16; i++) {
+      auto t = tv[i];
+      EmberProfLog("ember-d12tgt:   #%02u %7.3f ms/f  metal passes %5.1f/f  d3d passes %5.1f/f  loads %5.1f/f clears %4.1f/f  draws %6.1f/f  %ux%u a%u fmt%u rt%u d%u tgt %llx",
+                   i, t->ns / 1e6 / frames, t->passes / frames, t->d3d_passes / frames, t->loads / frames, t->clears / frames,
+                   t->draws / frames, t->info.width, t->info.height, t->info.array_len, t->info.fmt0, t->info.rts,
+                   t->info.has_depth, (unsigned long long)t->info.target0);
+    }
+    ember_target_map_.clear();
+    ember_prof_map_.clear();
+    memset(ember_prof_kind_ns_, 0, sizeof(ember_prof_kind_ns_));
+    memset(ember_prof_kind_count_, 0, sizeof(ember_prof_kind_count_));
+    ember_prof_frames_ = 0;
+    ember_prof_total_ns_ = 0;
+    ember_prof_first_start_ = ember_prof_last_end_ = 0;
+  }
+
+  static EmberProfInfo
+  EmberProfDescribe(EncoderData *current) {
+    EmberProfInfo info;
+    info.kind = (uint8_t)current->type;
+    uint64_t h = 0xcbf29ce484222325ull ^ info.kind;
+    auto mix = [&](uint64_t x) { h = (h ^ x) * 0x100000001b3ull; };
+    const wmtcmd_base *cmd = nullptr;
+    switch (current->type) {
+    case EncoderType::Render: {
+      auto data = static_cast<RenderEncoderData *>(current);
+      for (auto &c : data->colors) {
+        if (!c.attachment)
+          continue;
+        auto t = c.attachment.texture();
+        if (!info.rts) {
+          info.fmt0 = (uint32_t)t.pixelFormat();
+          info.target0 = t.handle;
+        }
+        info.rts++;
+        mix(t.handle);
+      }
+      if (data->depth.attachment) {
+        info.has_depth = 1;
+        mix(data->depth.attachment.texture().handle);
+        if (!info.target0)
+          info.target0 = data->depth.attachment.texture().handle;
+        if (!info.rts)
+          info.fmt0 = (uint32_t)data->depth.attachment.texture().pixelFormat();
+      }
+      info.width = data->render_target_width;
+      info.height = data->render_target_height;
+      info.array_len = data->render_target_array_length;
+      for (auto &c : data->colors)
+        if (c.attachment) {
+          info.load0 = (uint8_t)c.load_action;
+          info.store0 = (uint8_t)c.store_action;
+          break;
+        }
+      if (data->depth.attachment) {
+        info.dload = (uint8_t)data->depth.load_action;
+        info.dstore = (uint8_t)data->depth.store_action;
+      }
+      cmd = (const wmtcmd_base *)&data->cmd_head;
+      break;
+    }
+    case EncoderType::Compute:
+      cmd = (const wmtcmd_base *)&static_cast<ComputeEncoderData *>(current)->cmd_head;
+      break;
+    case EncoderType::Blit:
+      cmd = (const wmtcmd_base *)&static_cast<BlitEncoderData *>(current)->cmd_head;
+      break;
+    case EncoderType::Clear: {
+      auto data = static_cast<ClearEncoderData *>(current);
+      info.width = data->width;
+      info.height = data->height;
+      info.array_len = data->array_length;
+      if (data->attachment) {
+        mix(data->attachment.texture().handle);
+        info.fmt0 = (uint32_t)data->attachment.texture().pixelFormat();
+        info.target0 = data->attachment.texture().handle;
+      }
+      break;
+    }
+    default:
+      break;
+    }
+    uint64_t first_pso = 0;
+    for (; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr) {
+      info.cmds++;
+      if (current->type == EncoderType::Render) {
+        switch (cmd->type) {
+        case WMTRenderCommandDraw:
+        case WMTRenderCommandDrawIndexed:
+        case WMTRenderCommandDrawIndirect:
+        case WMTRenderCommandDrawIndexedIndirect:
+          info.draws++;
+          break;
+        case WMTRenderCommandDrawMeshThreadgroups: {
+          info.mesh_draws++;
+          auto m = (const wmtcmd_render_draw_meshthreadgroups *)cmd;
+          info.mesh_tgs += (uint32_t)(m->threadgroup_per_grid.width * m->threadgroup_per_grid.height);
+          break;
+        }
+        default:
+          break;
+        }
+      } else if (current->type == EncoderType::Compute) {
+        if (cmd->type == WMTComputeCommandDispatch || cmd->type == WMTComputeCommandDispatchIndirect)
+          info.dispatches++;
+        if (cmd->type == WMTComputeCommandSetPSO && !first_pso)
+          first_pso = ((const wmtcmd_compute_setpso *)cmd)->pso;
+      } else if (current->type == EncoderType::Blit) {
+        if (cmd->type != WMTBlitCommandNop)
+          info.dispatches++;
+      }
+    }
