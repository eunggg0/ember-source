index 0000000..a6c2838
--- /dev/null
+++ b/src/d3d12/d3d12_ember_opts.hpp
@@ -0,0 +1,55 @@
+#pragma once
+/* Ember: D3D12 실험·진단 스위치. 먼저 환경 변수, 없으면 보틀의 C:\ember-d12.cfg (한 줄에 NAME=VALUE).
+ * 스팀처럼 이미 떠 있는 런처가 게임을 띄우면 Ember 가 넘기는 환경 변수 목록에 없는 값은 게임까지 안 간다 —
+ * 그래서 시험용으로 파일도 읽는다. 파일이 없으면 기본값(제품 동작)이다. */
+#include "util_env.hpp"
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <string>
+
+namespace dxmt {
+
+inline std::string
+EmberD12Opt(const char *name) {
+  auto v = env::getEnvVar(name);
+  if (!v.empty())
+    return v;
+  static std::string file = []() {
+    std::string out;
+    if (FILE *f = fopen("C:\\ember-d12.cfg", "rb")) {
+      char buf[4096];
+      size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+      buf[n] = 0;
+      out = buf;
+      fclose(f);
+    }
+    return out;
+  }();
+  size_t len = strlen(name);
+  size_t pos = 0;
+  while (pos < file.size()) {
+    size_t eol = file.find_first_of("\r\n", pos);
+    if (eol == std::string::npos)
+      eol = file.size();
+    if (eol - pos > len && file.compare(pos, len, name) == 0 && file[pos + len] == '=')
+      return file.substr(pos + len + 1, eol - pos - len - 1);
+    pos = eol + 1;
+  }
+  return {};
+}
+
+inline int
+EmberD12OptInt(const char *name, int def) {
+  auto v = EmberD12Opt(name);
+  return v.empty() ? def : atoi(v.c_str());
+}
