+/* Ember DXIL: 애플 Metal Shader Converter 셰이더가 읽는 서술자 형식(IRDescriptorTableEntry, 24바이트).
+ * DXMT 자체 형식(32바이트)과 나란히 채워 두고, 서술자 표 주소는 루트 인자를 올릴 때 이쪽으로 옮긴다. */
+struct IRDescEntry {
+  uint64_t gpuVA;
+  uint64_t textureViewID;
+  uint64_t metadata;
+};
+static_assert(sizeof(IRDescEntry) == 24);
+
+namespace {
+struct IRHeapRange {
+  uint64_t count;
+  uint64_t ir_base;
+};
+dxmt::mutex ir_registry_lock;
+std::map<uint64_t, IRHeapRange> ir_registry;
+
+void
+IRRegisterHeap(uint64_t base, uint64_t count, uint64_t ir_base) {
+  std::unique_lock<dxmt::mutex> lock(ir_registry_lock);
+  ir_registry[base] = {count, ir_base};
+}
+void
+IRUnregisterHeap(uint64_t base) {
+  std::unique_lock<dxmt::mutex> lock(ir_registry_lock);
+  ir_registry.erase(base);
+}
+inline uint64_t
+IRBufferMetadata(uint64_t size, uint32_t tex_view_offset, bool typed) {
+  return (size & 0xffffffffull) | ((uint64_t)(tex_view_offset & 0xff) << 32) | ((uint64_t)typed << 63);
+}
