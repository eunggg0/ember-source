Subject: [PATCH 12/12] server: Ember changes

Base: wine-11.0.tar.xz
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/server/device.c b/server/device.c
index 3eed743..7ed78e4 100644
--- a/server/device.c
+++ b/server/device.c
@@ -671,11 +671,41 @@ static void device_file_flush( struct fd *fd, struct async *async )
     queue_irp( file, &params, async );
 }
 
+/* Ember 진단: WINESERVER_IOCTL_STATS=1 이면 장치별 ioctl 코드 횟수를 5초마다 stderr 에 찍는다 */
+static void ember_ioctl_stats( struct device_file *file, ioctl_code_t code )
+{
+    static int enabled = -1;
+    static struct { struct device *device; ioctl_code_t code; unsigned int count; } slots[64];
+    static unsigned int nslots;
+    static timeout_t last;
+    unsigned int i;
+
+    if (enabled < 0) enabled = getenv( "WINESERVER_IOCTL_STATS" ) != NULL;
+    if (!enabled) return;
+    for (i = 0; i < nslots; i++) if (slots[i].device == file->device && slots[i].code == code) break;
+    if (i == nslots && nslots < 64) { slots[nslots].device = file->device; slots[nslots].code = code; slots[nslots].count = 0; nslots++; }
+    if (i < 64) slots[i].count++;
+    if (!last) last = current_time;
+    if (current_time - last >= 5 * TICKS_PER_SEC)
+    {
+        fprintf( stderr, "ember-ioctl-stats (%.1fs):", (current_time - last) / (double)TICKS_PER_SEC );
+        for (i = 0; i < nslots; i++)
+        {
+            if (!slots[i].count) continue;
+            fprintf( stderr, " dev=%p code=%08x n=%u;", slots[i].device, slots[i].code, slots[i].count );
+            slots[i].count = 0;
+        }
+        fprintf( stderr, "\n" );
+        last = current_time;
+    }
+}
+
 static void device_file_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
 {
     struct device_file *file = get_fd_user( fd );
     union irp_params params;
 
+    ember_ioctl_stats( file, code );
     memset( &params, 0, sizeof(params) );
     params.ioctl.type = IRP_CALL_IOCTL;
     params.ioctl.code = code;
diff --git a/server/inproc_sync.c b/server/inproc_sync.c
index a291d10..d2cddc7 100644
--- a/server/inproc_sync.c
+++ b/server/inproc_sync.c
@@ -240,6 +240,297 @@ static int get_obj_inproc_sync( struct object *obj, int *type )
     return fd;
 }
 
+int inproc_sync_publish_timer( struct object *obj, timeout_t due, unsigned int period_ms )
+{
+    return 0;
+}
+
+#elif defined(__APPLE__)   /* macOS: 공유 메모리 + __ulock 으로 직접 구현한다 */
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include "wine/inproc_sync_macos.h"
+
+extern int __ulock_wake( uint32_t operation, void *addr, uint64_t wake_value );
+#define UL_COMPARE_AND_WAIT_SHARED 3
+#define ULF_WAKE_ALL               0x00000100
+
+static struct macos_sync_global *macos_global;
+
+/* macOS 에는 /dev/ntsync 같은 커널 장치가 없다.
+ * 그 자리에 전역 깨우기 카운터를 담은 공유 메모리를 하나 두고, 그 fd 를 넘긴다.
+ * 클라이언트는 이 값이 0 이상이면 in-process 동기화가 있다고 본다.
+ *
+ * 기본으로 켠다. WINEMSYNC=0 으로 끄면 예전처럼 서버가 모든 대기를 맡는다. */
+int get_inproc_device_fd(void)
+{
+    static int fd = -2;
+
+    if (fd == -2)
+    {
+        const char *opt = getenv( "WINEMSYNC" );
+        char name[64];
+        void *map;
+
+        fd = -1;
+        if (opt && !atoi( opt )) return fd;
+
+        snprintf( name, sizeof(name), "/wine-sync-global-%u", (unsigned int)getpid() );
+        shm_unlink( name );
+        if ((fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 )) == -1) return fd = -1;
+        shm_unlink( name );
+        if (ftruncate( fd, MACOS_SYNC_MAP_SIZE ) == -1) goto failed;
+        map = mmap( NULL, MACOS_SYNC_MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+        if (map == MAP_FAILED) goto failed;
+        memset( map, 0, MACOS_SYNC_MAP_SIZE );
+        macos_global = map;
+    }
+    return fd;
+
+failed:
+    close( fd );
+    return fd = -1;
+}
+
+struct inproc_sync
+{
+    struct object            obj;
+    enum inproc_sync_type    type;
+    int                      fd;
+    struct macos_sync_state *state;   /* 공유 메모리. 누가 기다리기 전엔 NULL(지연 생성) */
+    struct list              entry;
+    /* state 가 없을 때의 초기값. 파일 잠금·IRP 마다 내부 동기화 객체가 생기는데 대부분 아무도 기다리지 않는다.
+     * shm_open+mmap 을 그때마다 하면(실측 wineserver 6%) 낭비라, fd 를 요청하는 쪽이 있을 때만 만든다. */
+    int                      init_manual;
+    unsigned int             init_max;
+    unsigned int             init_count;
+    int                      init_owner;
+    int                      init_abandoned;
+};
+
+static struct list inproc_mutexes = LIST_INIT( inproc_mutexes );
+
+static void inproc_sync_dump( struct object *obj, int verbose );
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal );
+static void inproc_sync_destroy( struct object *obj );
+
+static const struct object_ops inproc_sync_ops =
+{
+    sizeof(struct inproc_sync), &no_type, inproc_sync_dump, no_add_queue, NULL, NULL, NULL,
+    inproc_sync_signal, no_get_fd, default_get_sync, default_map_access, default_get_sd,
+    default_set_sd, default_get_full_name, no_lookup_name, directory_link_name,
+    default_unlink_name, no_open_file, no_kernel_obj_list, no_close_handle, inproc_sync_destroy,
+};
+
+static int macos_sync_materialize( struct inproc_sync *sync );
+
+int get_inproc_sync_fd( struct inproc_sync *sync )
+{
+    if (!sync) return -1;
+    if (macos_sync_materialize( sync ) < 0) return -1;
+    return sync->fd;
+}
+
+/* 자는 사람이 없으면 깨우기 syscall 을 부르지 않는다.
+ * 게임은 대부분 이미 신호가 와 있는 객체를 건드린다. 그 길에서 syscall 을 빼는 게 핵심이다. */
+static void wake_waiters( struct macos_sync_state *state )
+{
+    __atomic_add_fetch( &state->seq, 1, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &state->waiters, __ATOMIC_SEQ_CST ))
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, &state->seq, 0 );
+    if (!macos_global) return;
+    /* 객체 여러 개를 기다리는 쪽은 전역 카운터만 보고 있다. 같이 깨워 준다.
+     * 다만 이 객체를 목록에 넣은 사람이 없으면 전역은 건드리지 않는다.
+     * 안 그러면 신호 한 번에 온 시스템의 대기자가 다 깨어난다. */
+    if (!__atomic_load_n( &state->multi, __ATOMIC_SEQ_CST )) return;
+    __atomic_add_fetch( &macos_global->seq, 1, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &macos_global->waiters, __ATOMIC_SEQ_CST ))
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, &macos_global->seq, 0 );
+}
+
+/* 객체 하나마다 공유 메모리 한 장을 만든다.
+ * 이름을 붙여 열자마자 지워서, fd 를 받은 쪽만 볼 수 있게 한다. */
+static struct inproc_sync *alloc_macos_sync( enum inproc_sync_type type, int manual,
+                                             unsigned int count, unsigned int max, int owner )
+{
+    static unsigned int counter;
+    struct inproc_sync *sync;
+    char name[64];
+    void *map;
+    int fd;
+
+    if (!(sync = alloc_object( &inproc_sync_ops ))) return NULL;
+
+    sync->type  = type;
+    sync->fd    = -1;
+    sync->state = NULL;
+    sync->init_manual = manual;
+    sync->init_max = max;
+    sync->init_count = count;
+    sync->init_owner = owner;
+    sync->init_abandoned = 0;
+    list_init( &sync->entry );
+    if (type == INPROC_SYNC_MUTEX) list_add_tail( &inproc_mutexes, &sync->entry );
+    (void)counter; (void)name; (void)map; (void)fd;
+    return sync;
+}
+
+/* 공유 메모리를 실제로 만든다. 클라이언트가 fd 를 요청할 때(기다리려 할 때) 처음 한 번. */
+static int macos_sync_materialize( struct inproc_sync *sync )
+{
+    static unsigned int counter;
+    char name[64];
+    void *map;
+    int fd;
+
+    if (sync->state) return 0;
+    snprintf( name, sizeof(name), "/wine-sync-%u-%u", (unsigned int)getpid(), ++counter );
+    shm_unlink( name );
+    fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 );
+    shm_unlink( name );
+    if (fd == -1 || ftruncate( fd, MACOS_SYNC_MAP_SIZE ) == -1)
+    {
+        if (fd != -1) close( fd );
+        return -1;
+    }
+    map = mmap( NULL, MACOS_SYNC_MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    if (map == MAP_FAILED)
+    {
+        close( fd );
+        return -1;
+    }
+    memset( map, 0, MACOS_SYNC_MAP_SIZE );
+    sync->fd    = fd;
+    sync->state = map;
+    sync->state->type      = sync->type;
+    sync->state->manual    = sync->init_manual;
+    sync->state->max       = sync->init_max;
+    sync->state->count     = sync->init_count;
+    sync->state->owner     = sync->init_owner;
+    sync->state->abandoned = sync->init_abandoned;
+    return 0;
+}
+
+struct inproc_sync *create_inproc_internal_sync( int manual, int signaled )
+{
+    return alloc_macos_sync( INPROC_SYNC_INTERNAL, manual, signaled ? 1 : 0, 0, 0 );
+}
+
+struct inproc_sync *create_inproc_event_sync( int manual, int signaled )
+{
+    return alloc_macos_sync( INPROC_SYNC_EVENT, manual, signaled ? 1 : 0, 0, 0 );
+}
+
+struct inproc_sync *create_inproc_mutex_sync( thread_id_t owner, unsigned int count )
+{
+    return alloc_macos_sync( INPROC_SYNC_MUTEX, 0, count, 0, owner );
+}
+
+struct inproc_sync *create_inproc_semaphore_sync( unsigned int initial, unsigned int max )
+{
+    return alloc_macos_sync( INPROC_SYNC_SEMAPHORE, 0, initial, max, 0 );
+}
+
+static void inproc_sync_dump( struct object *obj, int verbose )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    fprintf( stderr, "in-process sync (macOS) fd=%d type=%u\n", sync->fd, sync->type );
+}
+
+void signal_inproc_sync( struct inproc_sync *sync )
+{
+    if (!sync) return;
+    if (!sync->state) { sync->init_count = 1; return; }   /* 아직 아무도 안 본다. 초기값만 바꾼다 */
+    /* 이미 켜져 있었으면 새로 깰 사람이 없다. */
+    if (__atomic_exchange_n( &sync->state->count, 1, __ATOMIC_SEQ_CST )) return;
+    wake_waiters( sync->state );
+}
+
+void reset_inproc_sync( struct inproc_sync *sync )
+{
+    if (!sync) return;
+    if (!sync->state) { sync->init_count = 0; return; }
+    __atomic_store_n( &sync->state->count, 0, __ATOMIC_SEQ_CST );
+}
+
+/* 대기 타이머를 프로세스 안에서 처리하게 한다. 만료 시각만 공유 메모리에 적고 대기자를 한 번 깨워
+ * 새 시각에 맞춰 다시 자게 한다. due 0 은 취소: 이미 만료했는데 아직 소모되지 않았으면 신호 상태로 남긴다. */
+int inproc_sync_publish_timer( struct object *obj, timeout_t due, unsigned int period_ms )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+
+    if (!obj || obj->ops != &inproc_sync_ops) return 0;
+    if (macos_sync_materialize( sync ) < 0) return 0;
+    if (!due)
+    {
+        long long old = __atomic_load_n( &sync->state->due, __ATOMIC_SEQ_CST );
+        if (old && current_time >= old) __atomic_store_n( &sync->state->count, 1, __ATOMIC_SEQ_CST );
+    }
+    __atomic_store_n( &sync->state->period_ms, period_ms, __ATOMIC_SEQ_CST );
+    __atomic_store_n( &sync->state->due, (long long)due, __ATOMIC_SEQ_CST );
+    wake_waiters( sync->state );
+    return 1;
+}
+
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+    /* 뮤텍스/세마포어로는 불려 오지 않는다. 이벤트 계열만 신호를 받는다. */
+    assert( sync->type == INPROC_SYNC_INTERNAL || sync->type == INPROC_SYNC_EVENT );
+    assert( signal == 0 || signal == 1 );
+
+    if (signal) signal_inproc_sync( sync );
+    else reset_inproc_sync( sync );
+    return 1;
+}
+
+static void inproc_sync_destroy( struct object *obj )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    if (sync->type == INPROC_SYNC_MUTEX) list_remove( &sync->entry );
+    if (sync->state) munmap( sync->state, MACOS_SYNC_MAP_SIZE );
+    if (sync->fd != -1) close( sync->fd );
+}
+
+static int get_obj_inproc_sync( struct object *obj, int *type )
+{
+    struct object *sync;
+    int fd = -1;
+
+    if (!(sync = get_obj_sync( obj ))) return -1;
+    if (sync->ops == &inproc_sync_ops)
+    {
+        struct inproc_sync *inproc = (struct inproc_sync *)sync;
+        *type = inproc->type;
+        if (macos_sync_materialize( inproc ) < 0) fd = -1;
+        else fd = inproc->fd;
+    }
+    release_object( sync );
+    return fd;
+}
+
+/* 스레드가 뮤텍스를 쥔 채 죽으면 다음에 잡는 쪽에 알려 줘야 한다. */
+void abandon_inproc_mutexes( thread_id_t tid )
+{
+    struct inproc_sync *mutex;
+
+    LIST_FOR_EACH_ENTRY( mutex, &inproc_mutexes, struct inproc_sync, entry )
+    {
+        if (!mutex->state)
+        {
+            if (mutex->init_owner == (int)tid) { mutex->init_owner = 0; mutex->init_count = 0; mutex->init_abandoned = 1; }
+            continue;
+        }
+        if (__atomic_load_n( &mutex->state->owner, __ATOMIC_SEQ_CST ) != tid) continue;
+        __atomic_store_n( &mutex->state->count, 0, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &mutex->state->abandoned, 1, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &mutex->state->owner, 0, __ATOMIC_SEQ_CST );
+        wake_waiters( mutex->state );
+    }
+}
+
 #else /* NTSYNC_IOC_EVENT_READ */
 
 int get_inproc_device_fd(void)
@@ -280,6 +571,11 @@ void reset_inproc_sync( struct inproc_sync *sync )
 {
 }
 
+int inproc_sync_publish_timer( struct object *obj, timeout_t due, unsigned int period_ms )
+{
+    return 0;
+}
+
 void abandon_inproc_mutexes( thread_id_t tid )
 {
 }
diff --git a/server/object.h b/server/object.h
index cab8ad2..b98378d 100644
--- a/server/object.h
+++ b/server/object.h
@@ -254,6 +254,8 @@ extern struct inproc_sync *create_inproc_mutex_sync( thread_id_t owner, unsigned
 extern void abandon_inproc_mutexes( thread_id_t owner );
 extern void signal_inproc_sync( struct inproc_sync *sync );
 extern void reset_inproc_sync( struct inproc_sync *sync );
+/* Ember: 대기 타이머를 클라이언트가 처리하게 만료 시각을 공유 메모리에 적는다. 1 이면 서버 타임아웃 불필요 */
+extern int inproc_sync_publish_timer( struct object *sync, timeout_t due, unsigned int period_ms );
 
 /* serial functions */
 
diff --git a/server/timer.c b/server/timer.c
index a4309d5..2ed523f 100644
--- a/server/timer.c
+++ b/server/timer.c
@@ -166,6 +166,8 @@ static int cancel_timer( struct timer *timer )
 {
     int signaled = timer->signaled;
 
+    inproc_sync_publish_timer( timer->sync, 0, 0 );   /* 로컬 타이머 취소 */
+
     if (timer->timeout)
     {
         remove_timeout_user( timer->timeout );
@@ -197,7 +199,13 @@ static int set_timer( struct timer *timer, timeout_t expire, unsigned int period
     timer->arg      = arg;
     if (callback) timer->thread = (struct thread *)grab_object( current );
     if (expire != TIMEOUT_INFINITE)
-        timer->timeout = add_timeout_user( expire, timer_callback, timer );
+    {
+        /* Ember: APC 없는 타이머는 클라이언트가 만료를 처리한다(macOS in-process 동기화).
+         * 서버 타임아웃·신호·깨우기 왕복이 만료마다 드는 비용을 없앤다. */
+        timeout_t due = (expire <= 0) ? current_time - expire : max( expire, current_time );
+        if (callback || !inproc_sync_publish_timer( timer->sync, due, period ))
+            timer->timeout = add_timeout_user( expire, timer_callback, timer );
+    }
     return signaled;
 }
 
