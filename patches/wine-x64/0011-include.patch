diff --git a/include/Makefile.in b/include/Makefile.in
index e0987ce..0a21b79 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -991,6 +991,7 @@ SOURCES = \
 	wine/server_protocol.h \
 	wine/strmbase.h \
 	wine/svcctl.idl \
+	wine/inproc_sync_macos.h \
 	wine/test.h \
