+/* Ember: 게임 프로세스를 앱 번들의 주 실행파일(Wine 로더 복사본)로 exec 한다.
+ * macOS 는 번들 주 실행파일인 프로세스만 "앱"으로 취급하므로, 그래야 게임 모드·Dock·앱 전환기
+ * 정체가 게임 프로세스에 붙는다. 호스트 옆에는 ntdll.so 심볼릭 링크가 있어 로더가 그대로 뜬다.
+ *   EMBER_HOST_LOADER  호스트 실행파일 절대 경로
+ *   EMBER_HOST_ROUTE   "1" 이면 이 프로세스를 호스트로 보낸다. 자식은 spawn_process 가
+ *                      ImagePathName 을 EMBER_HOST_EXE 목록과 비교해 매번 다시 정한다. */
+static const char *ember_host_loader(void)
+{
+    const char *host = getenv( "EMBER_HOST_LOADER" ), *route = getenv( "EMBER_HOST_ROUTE" );
+    struct stat st;
+
+    if (!host || host[0] != '/' || !route || strcmp( route, "1" )) return NULL;
+    if (stat( host, &st ) || !S_ISREG( st.st_mode ) || !(st.st_mode & S_IXUSR)) return NULL;
+    return host;
+}
+
 /* exec the appropriate wine loader for the specified machine */
 static NTSTATUS loader_exec( char **argv, WORD machine )
 {
     static char noexec[] = "WINELOADERNOEXEC=1";
+    const char *host;
 
     putenv( noexec );
 
+    if ((host = ember_host_loader()))
+    {
+        /* 호스트에는 프리로더가 없다. 실패하면 아래 일반 경로로 계속 간다. */
+        argv[1] = strdup( host );
+        execv( argv[1], argv + 1 );
+        free( argv[1] );
+    }
+
     if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv );
 
     argv[1] = strdup( wineloader );
