index c5c3493..6e44abb 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -73,6 +73,19 @@ static void __fastcall default_thread_init_func( DWORD unknown, LPTHREAD_START_R
 void (FASTCALL *pBaseThreadInitThunk)(DWORD,LPTHREAD_START_ROUTINE,void *) = default_thread_init_func;
 NTSTATUS (WINAPI *__wine_unix_call_dispatcher)( unixlib_handle_t, unsigned int, void * ) = NULL;
 
+/***********************************************************************
+ *           __wine_unix_call   (NTDLL.@)
+ *
+ * upstream 은 이것을 헤더의 인라인으로 두지만, CrossOver 의 Wine 은 실제 함수로
+ * 내보낸다. 애플 D3DMetal 처럼 그쪽에 맞춰 빌드된 DLL 이 이 심볼을 import 한다.
+ * 없으면 "unimplemented function ntdll.dll.__wine_unix_call" 로 죽는다.
+ * 하는 일은 디스패처로 그대로 넘기는 것뿐이다.
+ */
+NTSTATUS WINAPI wine_unix_call_entry( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    return __wine_unix_call_dispatcher( handle, code, args );
+}
+
 static DWORD (WINAPI *pCtrlRoutine)(void *);
 
 SYSTEM_DLL_INIT_BLOCK LdrSystemDllInitBlock = { 0xf0 };
