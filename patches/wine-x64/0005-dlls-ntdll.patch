+/* Ember: 유니코드 경로에 ASCII 조각이 (대소문자·구분자 무시하고) 들어 있는가 */
+static int ember_path_contains( const WCHAR *path, const WCHAR *end, const char *frag, size_t len )
+{
+    size_t i;
+    const WCHAR *p;
+
+    for (p = path; p + len <= end; p++)
+    {
+        for (i = 0; i < len; i++)
+        {
+            WCHAR a = p[i];
+            unsigned char b = frag[i];
+            if (a == '/') a = '\\';
+            if (b == '/') b = '\\';
+            if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+            if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+            if (a != b) break;
+        }
+        if (i == len) return 1;
+    }
+    return 0;
+}
+
+/* Ember: 이 자식이 게임 실행파일이면 호스트(앱 번들 주 실행파일)로 exec 하게 표시한다.
+ * EMBER_HOST_EXE 는 ';' 로 나눈 파일 이름 목록(대소문자 무시). 표시는 자식마다 새로 정하므로
+ * 런처(STOVE 등)는 보통 로더로, 게임만 호스트로 간다. fork 뒤 exec 전 단계에서만 부른다. */
+static void ember_route_child( const UNICODE_STRING *image )
+{
+    const char *list = getenv( "EMBER_HOST_EXE" ), *s;
+    const WCHAR *p, *name, *end;
+    char buf[256];
+    unsigned int i, n;
+
+    unsetenv( "EMBER_HOST_ROUTE" );
+    if (!list || !*list || !image->Buffer) return;
+    end = image->Buffer + image->Length / sizeof(WCHAR);
+    for (p = name = image->Buffer; p < end; p++) if (*p == '\\' || *p == '/') name = p + 1;
+    n = end - name;
+    if (!n || n >= sizeof(buf)) return;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR c = name[i];
+        if (c > 127) return;
+        buf[i] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : (char)c;
+    }
+    buf[n] = 0;
+    for (s = list; *s; )
+    {
+        const char *e = strchr( s, ';' );
+        size_t len = e ? (size_t)(e - s) : strlen( s );
+        if (len == n && !strncasecmp( s, buf, len )) { setenv( "EMBER_HOST_ROUTE", "1", 1 ); return; }
+        /* '\' 로 시작하면 경로 조각: 전체 경로에 포함되면 게임으로 본다(예: \steamapps\common\ — 스팀이 띄우는 게임 전부) */
+        if (len > 1 && (s[0] == '\\' || s[0] == '/') && ember_path_contains( image->Buffer, end, s, len ))
+        {
+            setenv( "EMBER_HOST_ROUTE", "1", 1 );
+            return;
+        }
+        s += len;
+        if (*s == ';') s++;
+    }
+}
