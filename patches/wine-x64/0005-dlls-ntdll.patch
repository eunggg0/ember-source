diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index e59f211..cb6ff51 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -450,6 +450,509 @@ static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_
     return errno_to_status( errno );
 }
 
+#elif defined(__APPLE__)   /* macOS: 공유 메모리 + __ulock 으로 직접 구현한다 */
+
+#include <sys/mman.h>
+#include "wine/inproc_sync_macos.h"
+
+extern int __ulock_wait( uint32_t operation, void *addr, uint64_t value, uint32_t timeout_us );
+extern int __ulock_wake( uint32_t operation, void *addr, uint64_t wake_value );
+#define UL_COMPARE_AND_WAIT_SHARED 3
+#define ULF_WAKE_ALL               0x00000100
+
+/* fd 하나에 공유 메모리 한 장이 붙는다. 매번 mmap 하면 느리니 표에 담아 둔다.
+ * fd 번호로 바로 찾도록 해서 충돌도, 표가 꽉 차는 일도 없게 한다. */
+static struct macos_sync_state **macos_sync_by_fd;
+static int macos_sync_nfds;
+static pthread_mutex_t macos_sync_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static struct macos_sync_state *macos_sync_map( int fd )
+{
+    struct macos_sync_state *state;
+    void *map;
+
+    if (fd < 0) return NULL;
+    pthread_mutex_lock( &macos_sync_cache_mutex );
+    if (fd < macos_sync_nfds && (state = macos_sync_by_fd[fd]))
+    {
+        pthread_mutex_unlock( &macos_sync_cache_mutex );
+        return state;
+    }
+    if (fd >= macos_sync_nfds)
+    {
+        int want = fd + 64;
+        struct macos_sync_state **grown = realloc( macos_sync_by_fd, want * sizeof(*grown) );
+
+        if (!grown)
+        {
+            pthread_mutex_unlock( &macos_sync_cache_mutex );
+            return NULL;
+        }
+        memset( grown + macos_sync_nfds, 0, (want - macos_sync_nfds) * sizeof(*grown) );
+        macos_sync_by_fd = grown;
+        macos_sync_nfds = want;
+    }
+    map = mmap( NULL, MACOS_SYNC_MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    state = map == MAP_FAILED ? NULL : map;
+    macos_sync_by_fd[fd] = state;
+    pthread_mutex_unlock( &macos_sync_cache_mutex );
+    return state;
+}
+
+/* fd 번호는 닫히면 곧바로 다른 객체에 다시 쓰인다.
+ * 닫는 순간 표에서 지우지 않으면 엉뚱한 공유 메모리를 보게 된다. */
+static void macos_sync_forget( int fd )
+{
+    struct macos_sync_state *state;
+
+    if (fd < 0) return;
+    pthread_mutex_lock( &macos_sync_cache_mutex );
+    if (fd < macos_sync_nfds && (state = macos_sync_by_fd[fd]))
+    {
+        macos_sync_by_fd[fd] = NULL;
+        munmap( state, MACOS_SYNC_MAP_SIZE );
+    }
+    pthread_mutex_unlock( &macos_sync_cache_mutex );
+}
+
+/* wineserver 가 프로세스마다 넘겨 준 전역 카운터. 객체 여러 개를 기다릴 때 쓴다. */
+static struct macos_sync_global *macos_global;
+static pthread_once_t macos_global_once = PTHREAD_ONCE_INIT;
+
+static void macos_global_init(void)
+{
+    void *map;
+
+    if (inproc_device_fd < 0) return;
+    map = mmap( NULL, MACOS_SYNC_MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, inproc_device_fd, 0 );
+    if (map != MAP_FAILED) macos_global = map;
+}
+
+static struct macos_sync_global *macos_global_state(void)
+{
+    pthread_once( &macos_global_once, macos_global_init );
+    return macos_global;
+}
+
+/* 자는 사람이 없으면 깨우기 syscall 을 부르지 않는다.
+ * 게임이 쏟아내는 신호는 대부분 아무도 안 기다리는 객체로 간다. */
+static void macos_sync_wake( struct macos_sync_state *state )
+{
+    struct macos_sync_global *global = macos_global_state();
+
+    __atomic_add_fetch( &state->seq, 1, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &state->waiters, __ATOMIC_SEQ_CST ))
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, &state->seq, 0 );
+    if (!global) return;
+    /* 이 객체를 다중 대기 목록에 넣은 사람이 없으면 전역은 건드리지 않는다.
+     * 게임이 쏟아내는 신호 대부분이 여기서 syscall 없이 끝난다. */
+    if (!__atomic_load_n( &state->multi, __ATOMIC_SEQ_CST )) return;
+    __atomic_add_fetch( &global->seq, 1, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &global->waiters, __ATOMIC_SEQ_CST ))
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, &global->seq, 0 );
+}
+
+static NTSTATUS linux_release_semaphore_obj( int obj, ULONG count, ULONG *prev_count )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    unsigned int prev;
+
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    for (;;)
+    {
+        prev = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+        if (prev + count > state->max) return STATUS_SEMAPHORE_LIMIT_EXCEEDED;
+        if (__atomic_compare_exchange_n( &state->count, &prev, prev + count, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) break;
+    }
+    if (prev_count) *prev_count = prev;
+    /* 자던 쪽은 0 일 때만 잔다. 0 에서 올라올 때만 깨우면 된다. */
+    if (!prev) macos_sync_wake( state );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_semaphore_obj( int obj, SEMAPHORE_BASIC_INFORMATION *info )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    info->CurrentCount = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+    info->MaximumCount = state->max;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_set_event_obj( int obj, LONG *prev_state )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    unsigned int prev;
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    prev = __atomic_exchange_n( &state->count, 1, __ATOMIC_SEQ_CST );
+    if (prev_state) *prev_state = prev;
+    /* 이미 켜져 있었으면 새로 깰 사람이 없다. syscall 을 아낀다. */
+    if (!prev) macos_sync_wake( state );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_reset_event_obj( int obj, LONG *prev_state )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    unsigned int prev;
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    prev = __atomic_exchange_n( &state->count, 0, __ATOMIC_SEQ_CST );
+    if (prev_state) *prev_state = prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_pulse_event_obj( int obj, LONG *prev_state )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    unsigned int prev;
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    prev = __atomic_exchange_n( &state->count, 1, __ATOMIC_SEQ_CST );
+    if (prev_state) *prev_state = prev;
+    macos_sync_wake( state );
+    __atomic_store_n( &state->count, 0, __ATOMIC_SEQ_CST );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_event_obj( int obj, EVENT_BASIC_INFORMATION *info )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    info->EventType = state->manual ? NotificationEvent : SynchronizationEvent;
+    info->EventState = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST ) ? 1 : 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_release_mutex_obj( int obj, LONG *prev_count )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    unsigned int count;
+
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    if (__atomic_load_n( &state->owner, __ATOMIC_SEQ_CST ) != (int)GetCurrentThreadId())
+        return STATUS_MUTANT_NOT_OWNED;
+    count = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+    if (prev_count) *prev_count = count;
+    if (count > 1) __atomic_store_n( &state->count, count - 1, __ATOMIC_SEQ_CST );
+    else
+    {
+        __atomic_store_n( &state->count, 0, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &state->owner, 0, __ATOMIC_SEQ_CST );
+        macos_sync_wake( state );
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_mutex_obj( int obj, MUTANT_BASIC_INFORMATION *info )
+{
+    struct macos_sync_state *state = macos_sync_map( obj );
+    if (!state) return STATUS_NOT_IMPLEMENTED;
+    info->CurrentCount = 1 - __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+    info->OwnedByCaller = (__atomic_load_n( &state->owner, __ATOMIC_SEQ_CST )
+                           == (int)GetCurrentThreadId());
+    info->AbandonedState = __atomic_load_n( &state->abandoned, __ATOMIC_SEQ_CST ) != 0;
+    return STATUS_SUCCESS;
+}
+
+/* 로컬 대기 타이머: 만료했으면 1. consume 이면 만료를 소모한다(주기 타이머는 다음 만료로 넘긴다).
+ * 소모는 due 의 CAS 로 하므로 대기자가 여럿이어도 한 명만 가져간다. */
+static int macos_timer_expired( struct macos_sync_state *state, int consume )
+{
+    long long due = __atomic_load_n( &state->due, __ATOMIC_SEQ_CST );
+    LARGE_INTEGER now;
+
+    if (!due) return 0;
+    NtQuerySystemTime( &now );
+    if (now.QuadPart < due) return 0;
+    if (!consume) return 1;
+    for (;;)
+    {
+        unsigned int period = __atomic_load_n( &state->period_ms, __ATOMIC_SEQ_CST );
+        long long next = 0;
+        if (period)
+        {
+            long long p = (long long)period * 10000;
+            next = due + p * (1 + (now.QuadPart - due) / p);
+        }
+        if (__atomic_compare_exchange_n( &state->due, &due, next, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            return 1;
+        if (!due || now.QuadPart < due) return 0;   /* 다른 대기자가 먼저 가져갔다 */
+    }
+}
+
+/* 객체 하나를 잡아 본다. 잡았으면 0, 못 잡았으면 -1, 버려진 뮤텍스면 1. */
+static int macos_try_acquire( struct macos_sync_state *state )
+{
+    unsigned int prev;
+
+    switch (state->type)
+    {
+    case INPROC_SYNC_MUTEX:
+    {
+        int tid = GetCurrentThreadId(), zero = 0;
+        if (__atomic_load_n( &state->owner, __ATOMIC_SEQ_CST ) == tid)
+        {
+            __atomic_add_fetch( &state->count, 1, __ATOMIC_SEQ_CST );
+            return 0;
+        }
+        if (__atomic_compare_exchange_n( &state->owner, &zero, tid, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        {
+            __atomic_store_n( &state->count, 1, __ATOMIC_SEQ_CST );
+            if (__atomic_exchange_n( &state->abandoned, 0, __ATOMIC_SEQ_CST )) return 1;
+            return 0;
+        }
+        return -1;
+    }
+    case INPROC_SYNC_SEMAPHORE:
+        for (;;)
+        {
+            prev = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+            if (!prev) return -1;
+            if (__atomic_compare_exchange_n( &state->count, &prev, prev - 1, 0,
+                                             __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) return 0;
+        }
+    default:   /* 이벤트 (대기 타이머 포함) */
+        if (state->manual)
+        {
+            /* 수동 타이머가 만료했으면 신호 상태로 남긴다(리셋은 SetWaitableTimer 가 한다) */
+            if (macos_timer_expired( state, 1 )) __atomic_store_n( &state->count, 1, __ATOMIC_SEQ_CST );
+            return __atomic_load_n( &state->count, __ATOMIC_SEQ_CST ) ? 0 : -1;
+        }
+        if (macos_timer_expired( state, 1 )) return 0;   /* 동기화 타이머 만료를 소모 */
+        prev = 1;
+        return __atomic_compare_exchange_n( &state->count, &prev, 0, 0,
+                                            __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ) ? 0 : -1;
+    }
+}
+
+/* 신호가 와 있는가. 잡지는 않는다. WaitAll 이 먼저 전부 확인할 때 쓴다. */
+static int macos_is_signaled( struct macos_sync_state *state )
+{
+    switch (state->type)
+    {
+    case INPROC_SYNC_MUTEX:
+    {
+        int owner = __atomic_load_n( &state->owner, __ATOMIC_SEQ_CST );
+        return !owner || owner == (int)GetCurrentThreadId();
+    }
+    case INPROC_SYNC_SEMAPHORE:
+        return __atomic_load_n( &state->count, __ATOMIC_SEQ_CST ) != 0;
+    default:
+        return __atomic_load_n( &state->count, __ATOMIC_SEQ_CST ) != 0 || macos_timer_expired( state, 0 );
+    }
+}
+
+/* 잡았던 것을 도로 놓는다.
+ * WaitAll 은 전부 잡아야 성립한다. 중간에 하나라도 놓치면 앞서 잡은 것을 되돌린다. */
+static void macos_undo_acquire( struct macos_sync_state *state, int was_abandoned )
+{
+    unsigned int count;
+
+    switch (state->type)
+    {
+    case INPROC_SYNC_MUTEX:
+        if (was_abandoned) __atomic_store_n( &state->abandoned, 1, __ATOMIC_SEQ_CST );
+        count = __atomic_load_n( &state->count, __ATOMIC_SEQ_CST );
+        if (count > 1)
+        {
+            __atomic_store_n( &state->count, count - 1, __ATOMIC_SEQ_CST );
+            return;
+        }
+        __atomic_store_n( &state->count, 0, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &state->owner, 0, __ATOMIC_SEQ_CST );
+        break;
+    case INPROC_SYNC_SEMAPHORE:
+        if (__atomic_fetch_add( &state->count, 1, __ATOMIC_SEQ_CST )) return;
+        break;
+    default:
+        if (state->manual) return;   /* 수동 리셋 이벤트는 애초에 소모하지 않는다 */
+        if (__atomic_exchange_n( &state->count, 1, __ATOMIC_SEQ_CST )) return;
+        break;
+    }
+    macos_sync_wake( state );
+}
+
+/* 깨우기 유실 판정 보조: 신호 쪽은 count 를 먼저 켜고 seq 를 나중에 올린다.
+ * 그 사이를 유실로 오판하지 않도록 잠깐 뒤에도 seq 가 그대로인지 본다. */
+static int macos_still_stale( unsigned int *seq, unsigned int before )
+{
+    usleep( 1000 );
+    return __atomic_load_n( seq, __ATOMIC_SEQ_CST ) == before;
+}
+
+/* 기다린다.
+ *
+ * 객체 하나면 그 객체의 seq 에서 잔다. 이게 게임이 가장 많이 하는 호출이다.
+ * 여러 개거나 alertable 이면 전역 카운터에서 잔다. 아무 객체가 신호를 받아도
+ * 깨어나 다시 확인하는 식이다. __ulock_wait 이 주소 하나만 볼 수 있어서 그렇다.
+ *
+ * 서버로 넘기는 길은 없다. msync 를 켜면 서버 쪽 객체는 대기열을 갖지 않아서
+ * 넘겨 봐야 OBJECT_TYPE_MISMATCH 만 돌아온다. 여기서 전부 처리해야 한다.
+ */
+static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_TYPE type,
+                                 int alert_fd, const LARGE_INTEGER *timeout )
+{
+    struct macos_sync_state *states[64], *alert = NULL;
+    struct macos_sync_global *global = macos_global_state();
+    int got[ARRAY_SIZE(states)];
+    ULONGLONG end = 0;
+    NTSTATUS ret;
+    int multi;
+    DWORD i;
+
+    if (!global || count > ARRAY_SIZE(states)) return STATUS_NOT_IMPLEMENTED;
+    for (i = 0; i < count; i++)
+        if (!(states[i] = macos_sync_map( objs[i] ))) return STATUS_NOT_IMPLEMENTED;
+    if (alert_fd > 0 && !(alert = macos_sync_map( alert_fd ))) return STATUS_NOT_IMPLEMENTED;
+    multi = !(count == 1 && !alert);
+
+    if (timeout)
+    {
+        LARGE_INTEGER now;
+        NtQuerySystemTime( &now );
+        end = timeout->QuadPart <= 0 ? now.QuadPart - timeout->QuadPart : timeout->QuadPart;
+    }
+
+    /* 여러 개를 한꺼번에 기다리는 동안에는 각 객체에 "나 여기 있다"고 표시해 둔다.
+     * 신호를 보내는 쪽은 이 표시가 있을 때만 전역 카운터를 올린다.
+     * 확인보다 먼저 표시해야 그 사이에 온 신호를 놓치지 않는다. */
+    if (multi)
+    {
+        for (i = 0; i < count; i++) __atomic_add_fetch( &states[i]->multi, 1, __ATOMIC_SEQ_CST );
+        if (alert) __atomic_add_fetch( &alert->multi, 1, __ATOMIC_SEQ_CST );
+    }
+
+    /* 깨우기 유실 안전장치. 무한 대기라도 이 간격마다 깨어나 다시 확인한다.
+     * 실측(2026-09-24, FEX 엔진): 게임 UI 스레드가 큐 객체에서 영원히 잠들어 창이 멈췄고, 메시지를
+     * 6만 개 던져도 깨지 않았다. 원인을 잡기 전까지 최대 이 시간만큼만 늦게 알아채도록 한다. */
+    enum { MACOS_SYNC_MAX_SLEEP_US = 20000 };
+    int stale = 0;
+    unsigned int stale_seq = 0;   /* 잠들기 전 seq. 오탐 방지: 검사 시점에도 그대로여야 유실이다 */
+
+    for (;;)
+    {
+        unsigned int gseq = __atomic_load_n( &global->seq, __ATOMIC_SEQ_CST );
+        unsigned int oseq = count == 1 && !alert
+                          ? __atomic_load_n( &states[0]->seq, __ATOMIC_SEQ_CST ) : 0;
+        uint32_t wait_us, sleep_us;
+        int capped;
+
+        if (stale)
+        {
+            /* 직전 잠에서 seq 가 안 바뀌었는데 지금 신호가 와 있으면 깨우기가 샌 것이다.
+             * 깬 직후 새 신호가 들어왔을 수 있으니 지금 seq 도, 1ms 뒤 seq 도 잠들기 전과 같아야 한다. */
+            unsigned int *seqp = count == 1 && !alert ? &states[0]->seq : &global->seq;
+            unsigned int now_seq = count == 1 && !alert ? oseq : gseq;
+            for (i = 0; i < count && now_seq == stale_seq; i++)
+                if (macos_is_signaled( states[i] ) && macos_still_stale( seqp, stale_seq ))
+                    ERR( "깨우기 유실: fd %d type %d count %u seq %u waiters %u multi %u (alert %d, count %u)\n",
+                         objs[i], states[i]->type, __atomic_load_n( &states[i]->count, __ATOMIC_SEQ_CST ),
+                         __atomic_load_n( &states[i]->seq, __ATOMIC_SEQ_CST ),
+                         __atomic_load_n( &states[i]->waiters, __ATOMIC_SEQ_CST ),
+                         __atomic_load_n( &states[i]->multi, __ATOMIC_SEQ_CST ), alert_fd, count );
+            stale = 0;
+        }
+
+        if (type == WaitAll && count > 1)
+        {
+            DWORD taken = 0;
+            int ready = 1, abandoned = 0;
+
+            for (i = 0; i < count; i++) if (!macos_is_signaled( states[i] )) { ready = 0; break; }
+            if (ready)
+            {
+                for (i = 0; i < count; i++)
+                {
+                    if ((got[i] = macos_try_acquire( states[i] )) < 0) break;
+                    if (got[i]) abandoned = 1;
+                    taken++;
+                }
+                if (taken == count) { ret = abandoned ? STATUS_ABANDONED_WAIT_0 : STATUS_WAIT_0; goto done; }
+                while (taken--) macos_undo_acquire( states[taken], got[taken] );
+            }
+        }
+        else
+        {
+            for (i = 0; i < count; i++)
+            {
+                if ((got[0] = macos_try_acquire( states[i] )) < 0) continue;
+                ret = (got[0] ? STATUS_ABANDONED_WAIT_0 : STATUS_WAIT_0) + i;
+                goto done;
+            }
+        }
+
+        if (alert && macos_is_signaled( alert ))
+        {
+            static const LARGE_INTEGER no_wait;
+            /* APC 는 서버가 들고 있다. 깨우기만 여기서 받고 전달은 서버에 맡긴다. */
+            ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &no_wait );
+            goto done;
+        }
+
+        if (!timeout) wait_us = 0;   /* 0 이면 무한 */
+        else
+        {
+            LARGE_INTEGER now;
+            LONGLONG left;
+
+            NtQuerySystemTime( &now );
+            if ((left = end - now.QuadPart) <= 0) { ret = STATUS_TIMEOUT; goto done; }
+            left /= 10;                                  /* 100ns → us */
+            wait_us = left > 0xfffffffe ? 0xfffffffe : (uint32_t)left;
+            if (!wait_us) wait_us = 1;
+        }
+
+        /* 로컬 대기 타이머는 가장 이른 만료 시각까지만 잔다 */
+        {
+            LONGLONG soonest = 0;
+            for (i = 0; i < count; i++)
+            {
+                long long d = __atomic_load_n( &states[i]->due, __ATOMIC_SEQ_CST );
+                if (d && (!soonest || d < soonest)) soonest = d;
+            }
+            if (soonest)
+            {
+                LARGE_INTEGER now;
+                LONGLONG left;
+                NtQuerySystemTime( &now );
+                left = (soonest - now.QuadPart) / 10;
+                if (left < 1) left = 1;
+                if (left > 0xfffffffe) left = 0xfffffffe;
+                if (!wait_us || (uint32_t)left < wait_us) wait_us = (uint32_t)left;
+            }
+        }
+
+        sleep_us = (!wait_us || wait_us > MACOS_SYNC_MAX_SLEEP_US) ? MACOS_SYNC_MAX_SLEEP_US : wait_us;
+        capped = sleep_us != wait_us;
+
+        if (count == 1 && !alert)
+        {
+            __atomic_add_fetch( &states[0]->waiters, 1, __ATOMIC_SEQ_CST );
+            __ulock_wait( UL_COMPARE_AND_WAIT_SHARED, &states[0]->seq, oseq, sleep_us );
+            __atomic_sub_fetch( &states[0]->waiters, 1, __ATOMIC_SEQ_CST );
+            stale = capped && __atomic_load_n( &states[0]->seq, __ATOMIC_SEQ_CST ) == oseq;
+            stale_seq = oseq;
+        }
+        else
+        {
+            __atomic_add_fetch( &global->waiters, 1, __ATOMIC_SEQ_CST );
+            __ulock_wait( UL_COMPARE_AND_WAIT_SHARED, &global->seq, gseq, sleep_us );
+            __atomic_sub_fetch( &global->waiters, 1, __ATOMIC_SEQ_CST );
+            stale = capped && __atomic_load_n( &global->seq, __ATOMIC_SEQ_CST ) == gseq;
+            stale_seq = gseq;
+        }
+    }
+
+done:
+    if (multi)
+    {
+        for (i = 0; i < count; i++) __atomic_sub_fetch( &states[i]->multi, 1, __ATOMIC_SEQ_CST );
+        if (alert) __atomic_sub_fetch( &alert->multi, 1, __ATOMIC_SEQ_CST );
+    }
+    return ret;
+}
+
 #else /* NTSYNC_IOC_EVENT_READ */
 
 static NTSTATUS linux_release_semaphore_obj( int obj, ULONG count, ULONG *prev_count )
@@ -635,7 +1138,25 @@ static void release_inproc_sync( struct inproc_sync *sync )
     LONG ref = InterlockedDecrement( &sync->refcount );
 
     assert( ref >= 0 );
-    if (!ref) close( fd );
+    if (!ref)
+    {
+#ifdef __APPLE__
+        macos_sync_forget( fd );
+#endif
+        close( fd );
+    }
+}
+
+/* 스레드 알림 fd 처럼 캐시(release_inproc_sync) 밖에서 닫는 동기화 fd.
+ * 실측(2026-09-24): 스레드가 끝나며 알림 fd 를 그냥 닫았고, 같은 번호를 받은 새 뮤텍스가
+ * 죽은 스레드의 알림 상태(내부 객체, 수동 리셋)를 보고 영원히 기다려 게임 메인 스레드가 멈췄다. */
+void close_inproc_sync_fd( int fd )
+{
+    if (fd < 0) return;
+#ifdef __APPLE__
+    macos_sync_forget( fd );
+#endif
+    close( fd );
 }
 
