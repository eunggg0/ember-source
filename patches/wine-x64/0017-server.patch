diff --git a/server/async.c b/server/async.c
index 907d5f5..a86e4c8 100644
--- a/server/async.c
+++ b/server/async.c
@@ -325,6 +325,15 @@ void queue_async( struct async_queue *queue, struct async *async )
     if (!async->is_system) set_fd_signaled( async->fd, 0 );
 }
 
+/* Move a pending request between queues of the same fd, preserving ownership. */
+void requeue_async( struct async_queue *queue, struct async *async )
+{
+    assert( async->queue );
+    list_remove( &async->queue_entry );
+    async->queue = queue;
+    list_add_tail( &queue->queue, &async->queue_entry );
+}
+
 /* create an async on a given queue of a fd */
 struct async *create_async( struct fd *fd, struct thread *thread, const struct async_data *data, struct iosb *iosb )
 {
diff --git a/server/device.c b/server/device.c
index 3eed743..7ed78e4 100644
--- a/server/device.c
+++ b/server/device.c
@@ -671,11 +671,41 @@ static void device_file_flush( struct fd *fd, struct async *async )
     queue_irp( file, &params, async );
 }
 
+/* Ember 진단: WINESERVER_IOCTL_STATS=1 이면 장치별 ioctl 코드 횟수를 5초마다 stderr 에 찍는다 */
+static void ember_ioctl_stats( struct device_file *file, ioctl_code_t code )
+{
+    static int enabled = -1;
+    static struct { struct device *device; ioctl_code_t code; unsigned int count; } slots[64];
+    static unsigned int nslots;
+    static timeout_t last;
+    unsigned int i;
+
+    if (enabled < 0) enabled = getenv( "WINESERVER_IOCTL_STATS" ) != NULL;
+    if (!enabled) return;
+    for (i = 0; i < nslots; i++) if (slots[i].device == file->device && slots[i].code == code) break;
+    if (i == nslots && nslots < 64) { slots[nslots].device = file->device; slots[nslots].code = code; slots[nslots].count = 0; nslots++; }
+    if (i < 64) slots[i].count++;
+    if (!last) last = current_time;
+    if (current_time - last >= 5 * TICKS_PER_SEC)
+    {
+        fprintf( stderr, "ember-ioctl-stats (%.1fs):", (current_time - last) / (double)TICKS_PER_SEC );
+        for (i = 0; i < nslots; i++)
+        {
+            if (!slots[i].count) continue;
+            fprintf( stderr, " dev=%p code=%08x n=%u;", slots[i].device, slots[i].code, slots[i].count );
+            slots[i].count = 0;
+        }
+        fprintf( stderr, "\n" );
+        last = current_time;
+    }
+}
+
 static void device_file_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
 {
     struct device_file *file = get_fd_user( fd );
     union irp_params params;
 
+    ember_ioctl_stats( file, code );
     memset( &params, 0, sizeof(params) );
     params.ioctl.type = IRP_CALL_IOCTL;
     params.ioctl.code = code;
diff --git a/server/ember_shield_gate.h b/server/ember_shield_gate.h
new file mode 100644
index 0000000..f57ff4b
--- /dev/null
+++ b/server/ember_shield_gate.h
@@ -0,0 +1,58 @@
+/* Ember-owned asynchronous preconnect transport. No Wine/GPL product code. */
+#ifndef EMBER_SHIELD_GATE_H
+#define EMBER_SHIELD_GATE_H
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+struct es_gate {
+ int fd; uint64_t id, deadline, connection, instance; unsigned pid, verified, signed_valid, same_signer;
+ char local[sizeof(((struct sockaddr_un *)0)->sun_path)];
+ struct sockaddr_un host;
+ char address[128];
+};
+static void es_gate_close(struct es_gate *g) {
+ if(g->fd>=0)close(g->fd);g->fd=-1;if(g->local[0])unlink(g->local);g->local[0]=0;
+}
+static void es_gate_message(struct es_gate *g,const char *kind,int allow,int timeout) {
+ char b[640];int n=snprintf(b,sizeof b,"{\"version\":1,\"kind\":\"%s\",\"request_id\":%llu,\"pid\":%u,\"instance\":%llu,\"connection_id\":%llu,\"address\":\"%s\",\"identity_verified\":%s,\"signed_valid\":%s,\"trusted_same_signer\":%s,\"allow\":%s,\"timeout\":%s}",kind,(unsigned long long)g->id,g->pid,(unsigned long long)g->instance,(unsigned long long)g->connection,g->address,g->verified?"true":"false",g->signed_valid?"true":"false",g->same_signer?"true":"false",allow?"true":"false",timeout?"true":"false");
+ if(n>0 && (size_t)n<sizeof b)sendto(g->fd,b,(size_t)n,0,(struct sockaddr *)&g->host,sizeof g->host);
+}
+static int es_gate_open(struct es_gate *g,const char *host,unsigned pid,const char *address,uint64_t id,uint64_t instance,unsigned verified,unsigned signed_valid,unsigned same_signer,uint64_t now) {
+ struct sockaddr_un local;struct stat st;char parent[108],*slash;
+ memset(g,0,sizeof *g);g->fd=-1;
+ if(!host || host[0]!='/' || strlen(host)>=sizeof g->host.sun_path || strlen(address)>=sizeof g->address)return 0;
+ snprintf(parent,sizeof parent,"%s",host);slash=strrchr(parent,'/');if(!slash || slash==parent)return 0;*slash=0;
+ if(lstat(parent,&st) || !S_ISDIR(st.st_mode) || st.st_uid!=getuid() || (st.st_mode&077))return 0;
+ if(lstat(host,&st) || !S_ISSOCK(st.st_mode) || st.st_uid!=getuid() || (st.st_mode&077))return 0;
+ g->host.sun_family=AF_UNIX;snprintf(g->host.sun_path,sizeof g->host.sun_path,"%s",host);
+ g->id=id;g->instance=instance;g->verified=verified;g->signed_valid=signed_valid;g->same_signer=same_signer;g->connection=id;g->pid=pid;g->deadline=now+5000;snprintf(g->address,sizeof g->address,"%s",address);
+ if(snprintf(g->local,sizeof g->local,"%s/q%u-%llx",parent,(unsigned)getpid(),(unsigned long long)id)>=(int)sizeof g->local)return 0;
+ g->fd=socket(AF_UNIX,SOCK_DGRAM,0);if(g->fd<0)return 0;
+ fcntl(g->fd,F_SETFD,FD_CLOEXEC);fcntl(g->fd,F_SETFL,O_NONBLOCK);
+ memset(&local,0,sizeof local);local.sun_family=AF_UNIX;snprintf(local.sun_path,sizeof local.sun_path,"%s",g->local);
+ if(bind(g->fd,(struct sockaddr *)&local,sizeof local) || chmod(g->local,0600)){es_gate_close(g);return 0;}
+ es_gate_message(g,"question.request",1,0);return 1;
+}
+/* 0 pending; 1 allow; -1 deny. A missing UI always expires to allow. */
+static int es_gate_poll(struct es_gate *g,uint64_t now) {
+ char b[512];struct sockaddr_un from;socklen_t len=sizeof from;ssize_t n;
+ if(now>=g->deadline){es_gate_message(g,"question.result",1,1);return 1;}
+ n=recvfrom(g->fd,b,sizeof b-1,0,(struct sockaddr *)&from,&len);
+ if(n>0 && from.sun_family==AF_UNIX && !strncmp(from.sun_path,g->host.sun_path,sizeof from.sun_path)) {
+  char *id,*allow,*end;uint64_t value;b[n]=0;
+  id=strstr(b,"\"request_id\"");allow=strstr(b,"\"allow\"");
+  if(!id || !allow || !(id=strchr(id,':')) || !(allow=strchr(allow,':')))return 0;
+  value=strtoull(id+1,&end,10);if(end==id+1 || value!=g->id || (*end!=',' && *end!='}' && *end!=' ' && *end!='\n'))return 0;
+  do{allow++;}while(*allow==' ' || *allow=='\t');
+  if(!strncmp(allow,"true",4) && (allow[4]==',' || allow[4]=='}' || allow[4]==' ' || allow[4]=='\n')){es_gate_message(g,"question.result",1,0);return 1;}
+  if(!strncmp(allow,"false",5) && (allow[5]==',' || allow[5]=='}' || allow[5]==' ' || allow[5]=='\n')){es_gate_message(g,"question.result",0,0);return -1;}
+ }
+ return 0;
+}
+#endif
diff --git a/server/ember_shield_route.h b/server/ember_shield_route.h
new file mode 100644
index 0000000..f69dd7e
--- /dev/null
+++ b/server/ember_shield_route.h
@@ -0,0 +1,43 @@
+#ifndef EMBER_SHIELD_ROUTE_H
+#define EMBER_SHIELD_ROUTE_H
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <string.h>
+#ifdef __APPLE__
+#include <libproc.h>
+#endif
+static inline uint64_t es_process_birth(unsigned pid) {
+#ifdef __APPLE__
+ struct proc_bsdinfo info;
+ if(proc_pidinfo((int)pid,PROC_PIDTBSDINFO,0,&info,sizeof info)!=(int)sizeof info)return 0;
+ return info.pbi_start_tvsec*1000000ull+info.pbi_start_tvusec;
+#else
+ (void)pid;return 0; /* Unsupported platform does not trust routes. */
+#endif
+}
+static inline int es_private_directory(int parent,const char *name) {
+ struct stat st;int fd=openat(parent,name,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+ if(fd<0)return -1;
+ if(fstat(fd,&st) || !S_ISDIR(st.st_mode) || st.st_uid!=getuid() || (st.st_mode&077)){close(fd);return -1;}
+ return fd;
+}
+static inline int es_route_read(int root,unsigned pid,char *socket_path,size_t cap,uint64_t *instance,unsigned *verified,unsigned *signed_valid,unsigned *same_signer) {
+ int shield,clients,fd,result=0;struct stat st;char name[32],path[108],header[48];unsigned cautious,matched,signed_flag,trusted;unsigned long long birth,generation;FILE *f;
+ uint64_t expected=es_process_birth(pid);if(!expected)return 0;
+ if((shield=es_private_directory(root,".ember-shield"))<0)return 0;
+ clients=es_private_directory(shield,"clients");close(shield);if(clients<0)return 0;
+ snprintf(name,sizeof name,"%u",pid);fd=openat(clients,name,O_RDONLY|O_NOFOLLOW|O_CLOEXEC);close(clients);if(fd<0)return 0;
+ if(fstat(fd,&st) || !S_ISREG(st.st_mode) || st.st_uid!=getuid() || (st.st_mode&077) || st.st_size>512){close(fd);return 0;}
+ f=fdopen(fd,"r");if(!f){close(fd);return 0;}
+ if(fgets(header,sizeof header,f) && !strcmp(header,"EMBER_SHIELD_ROUTE_V2\n") &&
+    fscanf(f,"%llu %llu %u %u %u %u\n%107[^\n]",&birth,&generation,&cautious,&matched,&signed_flag,&trusted,path)==7 &&
+    birth==expected && generation && matched<=1 && signed_flag<=1 && trusted<=1 && cautious==1 && path[0]=='/' && strlen(path)<cap) {
+  snprintf(socket_path,cap,"%s",path);*instance=generation;*verified=matched;*signed_valid=signed_flag;*same_signer=trusted;result=1;
+ }
+ fclose(f);return result;
+}
+#endif
diff --git a/server/file.h b/server/file.h
index e1485e4..9c267a4 100644
