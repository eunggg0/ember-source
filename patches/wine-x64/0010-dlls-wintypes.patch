--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -150,7 +150,11 @@ static HRESULT STDMETHODCALLTYPE api_information_statics_IsTypePresent(
     if (!type_name)
         return E_INVALIDARG;
 
-    return E_NOTIMPL;
+    /* Ember: 모르는 형식·멤버는 "없음"으로 답한다(실제 Windows 와 같다). E_NOTIMPL 을 돌려주면 C++/WinRT 가 예외로 던져
+     * 게임이 시작하자마자 비상 종료(c0000409)했다 — 2026-09-25 스텔라 블레이드 체험판(Windows.Graphics.Capture 확인). */
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
 }
 
