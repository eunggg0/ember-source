From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 1/12] dlls-bcrypt: Ember changes

Base: Wine 11.0
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/bcrypt/gnutls.c b/dlls/bcrypt/gnutls.c
index b80e7f8..6703c06 100644
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -49,6 +49,37 @@
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(bcrypt);
+
+#ifdef __APPLE__
+/* macOS 의 dlopen 은 맨 이름만 주면 DYLD_FALLBACK_LIBRARY_PATH 만 본다.
+ * 그 환경변수는 실행하는 쪽이 빠뜨리기 쉽고, 빠지면 TLS 가 통째로 죽는다
+ * (실측: schannel 이 등록되지 않아 AcquireCredentialsHandle 이
+ *  SEC_E_SECPKG_NOT_FOUND 로 실패하고, 게임 런처가 "네트워크 점검" 으로 멈춘다).
+ * 그래서 우리 .so 의 위치를 기준으로 절대 경로를 만들어 한 번 더 시도한다.
+ *   <root>/lib/wine/<arch>-unix/*.so  →  <root>/lib/<soname> */
+static void *dlopen_beside_wine( const char *soname )
+{
+    Dl_info info;
+    char path[1024];
+    size_t len;
+    char *p;
+    int i;
+
+    if (!dladdr( (void *)dlopen_beside_wine, &info ) || !info.dli_fname) return NULL;
+    len = strlen( info.dli_fname );
+    if (len >= sizeof(path)) return NULL;
+    memcpy( path, info.dli_fname, len + 1 );
+    for (i = 0; i < 3; i++)   /* 파일명, <arch>-unix, wine 을 차례로 벗긴다 */
+    {
+        if (!(p = strrchr( path, '/' ))) return NULL;
+        *p = 0;
+    }
+    if (strlen( path ) + strlen( soname ) + 2 >= sizeof(path)) return NULL;
+    strcat( path, "/" );
+    strcat( path, soname );
+    return dlopen( path, RTLD_NOW );
+}
+#endif
 WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
 #if GNUTLS_VERSION_MAJOR < 3
@@ -383,7 +414,11 @@ static NTSTATUS gnutls_process_attach( void *args )
         setenv("GNUTLS_SYSTEM_PRIORITY_FILE", "/dev/null", 0);
     }
 
-    if (!(libgnutls_handle = dlopen( SONAME_LIBGNUTLS, RTLD_NOW )))
+    libgnutls_handle = dlopen( SONAME_LIBGNUTLS, RTLD_NOW );
+#ifdef __APPLE__
+    if (!libgnutls_handle) libgnutls_handle = dlopen_beside_wine( SONAME_LIBGNUTLS );
+#endif
+    if (!libgnutls_handle)
     {
         ERR_(winediag)( "failed to load libgnutls, no support for encryption\n" );
         return STATUS_DLL_NOT_FOUND;
