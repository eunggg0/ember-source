@@ -763,6 +799,7 @@ static void sync_window_position(struct macdrv_win_data *data, UINT swp_flags, c
             frame.size.width = frame.size.height = 1;
 
         macdrv_set_cocoa_window_frame(data->cocoa_window, &frame);
