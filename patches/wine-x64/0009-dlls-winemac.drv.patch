+/***********************************************************************
+ *              macdrv_functions
+ *
+ * 애플 D3DMetal 과 크로스오버가 번들하는 DXMT 는 winemac.drv 가 이 이름으로
+ * 내보내는 함수 포인터 표를 dlsym 으로 찾아 쓴다. upstream Wine 에는 없다.
+ *
+ * 항목 24개와 그 순서는 크로스오버 winemac.so 안의 추적 문자열에서 확인했다.
+ * 앞 10개는 DXMT 소스(`src/winemetal/unix/winemetal_unix.c`)의 선언과도 맞는다.
+ * 뒤 14개는 유닉스 쪽에서 쓸 수 없는 Win32 함수들이라, win32u 의 NtUser·레지스트리
+ * 호출로 같은 일을 하도록 감쌌다.
+ */
+extern void OnMainThreadAsync( dispatch_block_t block );
+
+static void macdrv_init_display_devices_wrap( BOOL force )
+{
+    /* 화면 구성은 winemac.drv 가 이미 들고 있다. 여기서 더 할 일은 없다. */
+}
+
+static void macdrv_on_main_thread( dispatch_block_t block )
+{
+    OnMainThreadAsync( block );
+}
+
+/* --- 레지스트리: A 문자열을 받아 유니코드로 바꿔 ntdll 로 넘긴다 --- */
+
+static HKEY reg_open_ascii( HKEY root, const char *name )
+{
+    WCHAR buf[MAX_PATH];
+    DWORD len = asciiz_to_unicode( buf, name ? name : "" );
+    return reg_open_key( root, buf, len - sizeof(WCHAR) );
+}
+
+static LONG macdrv_RegOpenKeyExA( HKEY root, const char *name, DWORD options, REGSAM access, HKEY *out )
+{
+    HKEY key = reg_open_ascii( root, name );
+    if (!key) return ERROR_FILE_NOT_FOUND;
+    *out = key;
+    return ERROR_SUCCESS;
+}
+
+static LONG macdrv_RegCreateKeyExA( HKEY root, const char *name, DWORD reserved, char *cls,
+                                    DWORD options, REGSAM access, void *sa, HKEY *out, DWORD *disp )
+{
+    /* 여는 것으로 충분하다. D3DMetal 은 설정을 읽기만 한다. */
+    HKEY key = reg_open_ascii( root, name );
+    if (!key) return ERROR_FILE_NOT_FOUND;
+    *out = key;
+    if (disp) *disp = REG_OPENED_EXISTING_KEY;
+    return ERROR_SUCCESS;
+}
+
+static LONG macdrv_RegQueryValueExA( HKEY key, const char *name, DWORD *reserved,
+                                     DWORD *type, BYTE *data, DWORD *count )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[1024])];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (void *)buffer;
+    WCHAR nameW[256];
+    UNICODE_STRING str;
+    DWORD size;
+
+    str.Buffer = nameW;
+    str.Length = asciiz_to_unicode( nameW, name ? name : "" ) - sizeof(WCHAR);
+    str.MaximumLength = sizeof(nameW);
+    if (NtQueryValueKey( key, &str, KeyValuePartialInformation, buffer, sizeof(buffer), &size ))
+        return ERROR_FILE_NOT_FOUND;
+    if (type) *type = info->Type;
+    if (data && count && *count >= info->DataLength) memcpy( data, info->Data, info->DataLength );
+    else if (data) return ERROR_MORE_DATA;
+    if (count) *count = info->DataLength;
+    return ERROR_SUCCESS;
+}
+
+static LONG macdrv_RegSetValueExA( HKEY key, const char *name, DWORD reserved,
+                                   DWORD type, const BYTE *data, DWORD count )
+{
+    /* 설정을 되쓸 일은 없다. 성공으로 답해 흐름만 유지한다. */
+    return ERROR_SUCCESS;
+}
+
+static LONG macdrv_RegCloseKey( HKEY key )
+{
+    NtClose( key );
+    return ERROR_SUCCESS;
+}
+
+/* --- 창·모니터: 유닉스 쪽에서는 win32u 를 통해 부른다 --- */
+
+static BOOL macdrv_EnumDisplayMonitors( HDC hdc, RECT *rect, MONITORENUMPROC proc, LPARAM lp )
+{
+    return NtUserEnumDisplayMonitors( hdc, rect, proc, lp );
+}
+
+static BOOL macdrv_GetMonitorInfoA( HMONITOR mon, MONITORINFO *info )
+{
+    return NtUserGetMonitorInfo( mon, info );
+}
+
+static BOOL macdrv_AdjustWindowRectEx( RECT *rect, DWORD style, BOOL menu, DWORD ex_style )
+{
+    return NtUserAdjustWindowRect( rect, style, menu, ex_style, 0 );
+}
+
+static LONG_PTR macdrv_GetWindowLongPtrW( HWND hwnd, INT offset )
+{
+    return NtUserGetWindowLongPtrW( hwnd, offset );
+}
+
+static LONG_PTR macdrv_SetWindowLongPtrW( HWND hwnd, INT offset, LONG_PTR val )
+{
+    return NtUserSetWindowLongPtr( hwnd, offset, val, FALSE );
+}
+
+static BOOL macdrv_GetWindowRect( HWND hwnd, RECT *rect )
+{
+    return NtUserGetWindowRect( hwnd, rect, NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ) );
+}
+
+static BOOL macdrv_MoveWindow( HWND hwnd, INT x, INT y, INT cx, INT cy, BOOL repaint )
+{
+    UINT flags = SWP_NOZORDER | SWP_NOACTIVATE | (repaint ? 0 : SWP_NOREDRAW);
+    return NtUserSetWindowPos( hwnd, 0, x, y, cx, cy, flags );
+}
+
+static BOOL macdrv_SetWindowPos( HWND hwnd, HWND after, INT x, INT y, INT cx, INT cy, UINT flags )
+{
+    return NtUserSetWindowPos( hwnd, after, x, y, cx, cy, flags );
+}
+
+static INT macdrv_GetSystemMetrics( INT index )
+{
+    return NtUserGetSystemMetrics( index );
+}
+
+__attribute__((visibility("default")))
+void *macdrv_functions[24] =
+{
+    macdrv_init_display_devices_wrap,
+    get_win_data,
+    release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    macdrv_on_main_thread,
+    macdrv_RegQueryValueExA,
+    macdrv_RegSetValueExA,
+    macdrv_RegOpenKeyExA,
+    macdrv_RegCreateKeyExA,
+    macdrv_RegCloseKey,
+    macdrv_EnumDisplayMonitors,
+    macdrv_GetMonitorInfoA,
+    macdrv_AdjustWindowRectEx,
+    macdrv_GetWindowLongPtrW,
+    macdrv_GetWindowRect,
+    macdrv_MoveWindow,
+    macdrv_SetWindowPos,
+    macdrv_GetSystemMetrics,
+    macdrv_SetWindowLongPtrW,
+};
+
+
 void init_user_driver(void)
 {
     __wine_set_user_driver( &macdrv_funcs, WINE_GDI_DRIVER_VERSION );
