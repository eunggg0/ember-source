+/**********************************************************************
+ *              sync_client_view
+ *
+ * DXMT 는 Metal 레이어를 client_view 에 붙인다. 그런데 Wine 11 은 OpenGL 이나
+ * Vulkan 이 처음 화면을 내보낼 때만 이 뷰를 만든다. DXMT 는 그보다 먼저 필요해서
+ * 늘 NULL 을 보고 포기한다. 그래서 창을 만들 때 미리 하나 붙여 둔다.
+ *
+ * 숨긴 채로 둔다. 실제로 Metal 뷰가 붙는 순간에만 보이게 한다.
+ * 그러지 않으면 일반 창에서 이 뷰가 그림을 가린다.
+ */
+static void sync_client_view(struct macdrv_win_data *data)
+{
+    RECT rect = data->rects.client;
+
+    if (!data->cocoa_window) return;
+
+    OffsetRect(&rect, -data->rects.visible.left, -data->rects.visible.top);
+    if (rect.right <= rect.left) rect.right = rect.left + 1;
+    if (rect.bottom <= rect.top) rect.bottom = rect.top + 1;
+
+    if (!data->client_view)
+    {
+        if (!(data->client_view = macdrv_create_view(cgrect_from_rect(rect)))) return;
+        macdrv_set_view_superview(data->client_view, NULL, data->cocoa_window, NULL, NULL);
+    }
+    else macdrv_set_view_frame(data->client_view, cgrect_from_rect(rect));
+}
