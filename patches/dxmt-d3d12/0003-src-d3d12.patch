+uint64_t TraceDescriptorAllocation(const ShaderVisibleDescriptorCPUStorage &cpu) {
+  switch (cpu.type) {
+  case ShaderVisibleDescriptorType::SRVTexture: return (uintptr_t)cpu.SRVTexture.texture->current();
+  case ShaderVisibleDescriptorType::UAVTexture: return (uintptr_t)cpu.UAVTexture.texture->current();
+  case ShaderVisibleDescriptorType::UAVTexelBuffer: return (uintptr_t)cpu.UAVTexelBuffer.buffer->current();
+  case ShaderVisibleDescriptorType::SRVTexelBuffer: return (uintptr_t)cpu.SRVTexelBuffer.buffer->current();
+  case ShaderVisibleDescriptorType::UAVBuffer: return cpu.UAVBuffer.buffer ? (uintptr_t)cpu.UAVBuffer.buffer->current() : 0;
