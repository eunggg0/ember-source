+    if (heap.last_queue != queue || heap.last_cb != cb || heap.last_version != heap.version) {
+      heap.last_queue = queue; heap.last_cb = cb; heap.last_version = heap.version;
+      for (const auto &[i, slot] : heap.slots) {
+        if (slot.allocation)
+          EmberD12Trace(TraceKind::ResourceView, queue, cb, encoder, dispatch, slot.allocation, slot.ir.textureViewID, slot.ir.gpuVA, id, i, slot.generation);
+        EmberD12Trace(TraceKind::Descriptor, queue, cb, encoder, dispatch, id, heap.base, i, slot.generation,
+                      slot.ir.gpuVA, slot.ir.textureViewID, slot.ir.metadata, slot.type);
+        EmberD12Trace(TraceKind::DescriptorWrite, queue, cb, encoder, dispatch, id, heap.base, i, slot.generation,
+                      slot.raw[0], slot.raw[1], slot.raw[2], slot.raw[3]);
+      }
+      // Unpublished/uninitialized slots have no trustworthy shadow value.
+      if (heap.slots.size() < heap.count)
+        EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 4, id, heap.count, heap.slots.size());
+    }
+    if (auto losses = trace_descriptor_losses.load())
+      EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 5, id, losses);
+    return;
+  }
+  EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 2, value, is_handle);
+  } catch (...) {
+    EmberD12Trace(TraceKind::SnapshotGap, queue, cb, encoder, dispatch, 7, value);
+  }
+}
