+  /* Ember: 새 렌더 패스 바로 앞의 전체 지우기(ClearRenderTargetView·ClearDepthStencilView, 사각형 없음)가 이 패스의 첨부와
+   * 같으면 따로 지우기 패스를 내지 않고 로드 동작 Clear 로 합친다. 스텔라 블레이드: 지우기 패스 35개/프레임 ≈ 1.3ms.
+   * 크기·배열 길이가 패스와 같을 때만(로드 Clear 는 패스 영역·레이어 전체를 지운다). EMBER_D12_FOLD_CLEAR=0 이면 끔. */
+  void
+  EmberFoldClears(RenderEncoderData *render, small_vector<ClearEncoderData *, 8> &clears) {
+    static const bool enabled = EmberD12OptInt("EMBER_D12_FOLD_CLEAR", 1) != 0;
+    if (!enabled || clears.empty())
+      return;
+    for (auto clear : clears) {
+      if (clear->type != EncoderType::Clear || !clear->attachment)
+        continue;
+      if (clear->width != render->render_target_width || clear->height != render->render_target_height ||
+          clear->array_length != render->render_target_array_length)
+        continue;
+      auto handle = clear->attachment.texture().handle;
+      bool folded = false;
+      if (!clear->clear_dsv) {
+        for (auto &c : render->colors) {
+          if (!c.attachment || c.attachment.texture().handle != handle || c.depth_plane != clear->depth_plane)
+            continue;
+          c.load_action = WMTLoadActionClear;
+          c.clear_color = clear->color;
+          folded = true;
+        }
+      } else {
+        bool depth_ok = !(clear->clear_dsv & 1) ||
+                        (render->depth.attachment && render->depth.attachment.texture().handle == handle);
+        bool stencil_ok = !(clear->clear_dsv & 2) ||
+                          (render->stencil.attachment && render->stencil.attachment.texture().handle == handle);
+        if (depth_ok && stencil_ok) {
+          if (clear->clear_dsv & 1) {
+            render->depth.load_action = WMTLoadActionClear;
+            render->depth.clear_depth = clear->depth_stencil.first;
+          }
+          if (clear->clear_dsv & 2) {
+            render->stencil.load_action = WMTLoadActionClear;
+            render->stencil.clear_stencil = clear->depth_stencil.second;
+          }
+          folded = true;
+        }
+      }
+      if (folded) {
+        clear->type = EncoderType::Null;
+        render->ember_barrier |= clear->ember_barrier; /* 지우기 앞의 장벽은 합친 패스가 떠안는다 */
+        if (clear->ember_barrier)
+          render->ember_bres_unsafe = true;
+      }
+    }
+  }
