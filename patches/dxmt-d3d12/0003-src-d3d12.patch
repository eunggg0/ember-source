+  }
+
+  void STDMETHODCALLTYPE
+  BeginRenderPass(
+      UINT count, const D3D12_RENDER_PASS_RENDER_TARGET_DESC *rts, const D3D12_RENDER_PASS_DEPTH_STENCIL_DESC *ds,
+      D3D12_RENDER_PASS_FLAGS flags
+  ) {
+    if (bundle_) {
+      EMBER_CL_WARN_ONCE("BeginRenderPass in bundle");
+      return;
+    }
+    ember_rp_resolves_.clear();
+    ember_in_render_pass_ = true;
+    D3D12_CPU_DESCRIPTOR_HANDLE handles[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    count = std::min<UINT>(count, D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT);
+    for (UINT i = 0; i < count; i++)
+      handles[i] = rts[i].cpuDescriptor;
+    D3D12_CPU_DESCRIPTOR_HANDLE dsv_handle = ds ? ds->cpuDescriptor : D3D12_CPU_DESCRIPTOR_HANDLE();
+    OMSetRenderTargets(count, count ? handles : nullptr, FALSE, ds ? &dsv_handle : nullptr);
+    for (UINT i = 0; i < count; i++) {
+      if (rts[i].BeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        ClearRenderTargetView(rts[i].cpuDescriptor, rts[i].BeginningAccess.Clear.ClearValue.Color, 0, nullptr);
+      EmberRPAddResolves(rts[i].EndingAccess);
+    }
+    if (ds) {
+      UINT cf = 0;
+      if (ds->DepthBeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        cf |= D3D12_CLEAR_FLAG_DEPTH;
+      if (ds->StencilBeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        cf |= D3D12_CLEAR_FLAG_STENCIL;
