+  try {
+  std::unique_lock<std::mutex> lock(trace_descriptor_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 1, id, index);
+    return;
+  }
+  auto it = trace_descriptor_heaps.find(id);
+  if (it == trace_descriptor_heaps.end()) {
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 2, id, index);
+    return;
+  }
+  auto &heap = it->second;
