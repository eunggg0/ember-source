+  static EmberProfInfo
+  EmberProfDescribe(EncoderData *current) {
+    EmberProfInfo info;
+    info.kind = (uint8_t)current->type;
+    uint64_t h = 0xcbf29ce484222325ull ^ info.kind;
+    auto mix = [&](uint64_t x) { h = (h ^ x) * 0x100000001b3ull; };
+    const wmtcmd_base *cmd = nullptr;
+    switch (current->type) {
+    case EncoderType::Render: {
+      auto data = static_cast<RenderEncoderData *>(current);
+      for (auto &c : data->colors) {
+        if (!c.attachment)
+          continue;
+        auto t = c.attachment.texture();
+        if (!info.rts) {
+          info.fmt0 = (uint32_t)t.pixelFormat();
+          info.target0 = t.handle;
+        }
+        info.rts++;
+        mix(t.handle);
+      }
+      if (data->depth.attachment) {
+        info.has_depth = 1;
+        mix(data->depth.attachment.texture().handle);
+        if (!info.target0)
+          info.target0 = data->depth.attachment.texture().handle;
+        if (!info.rts)
+          info.fmt0 = (uint32_t)data->depth.attachment.texture().pixelFormat();
+      }
+      info.width = data->render_target_width;
+      info.height = data->render_target_height;
+      info.array_len = data->render_target_array_length;
+      for (auto &c : data->colors)
+        if (c.attachment) {
+          info.load0 = (uint8_t)c.load_action;
+          info.store0 = (uint8_t)c.store_action;
+          break;
+        }
+      if (data->depth.attachment) {
+        info.dload = (uint8_t)data->depth.load_action;
+        info.dstore = (uint8_t)data->depth.store_action;
+      }
+      cmd = (const wmtcmd_base *)&data->cmd_head;
+      break;
+    }
+    case EncoderType::Compute:
+      cmd = (const wmtcmd_base *)&static_cast<ComputeEncoderData *>(current)->cmd_head;
+      break;
+    case EncoderType::Blit:
+      cmd = (const wmtcmd_base *)&static_cast<BlitEncoderData *>(current)->cmd_head;
+      break;
+    case EncoderType::Clear: {
+      auto data = static_cast<ClearEncoderData *>(current);
+      info.width = data->width;
+      info.height = data->height;
+      info.array_len = data->array_length;
+      if (data->attachment) {
+        mix(data->attachment.texture().handle);
+        info.fmt0 = (uint32_t)data->attachment.texture().pixelFormat();
+        info.target0 = data->attachment.texture().handle;
+      }
+      break;
+    }
+    default:
+      break;
+    }
+    uint64_t first_pso = 0;
+    for (; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr) {
+      info.cmds++;
+      if (current->type == EncoderType::Render) {
+        switch (cmd->type) {
+        case WMTRenderCommandDraw:
+        case WMTRenderCommandDrawIndexed:
+        case WMTRenderCommandDrawIndirect:
+        case WMTRenderCommandDrawIndexedIndirect:
+          info.draws++;
+          break;
+        case WMTRenderCommandDrawMeshThreadgroups: {
+          info.mesh_draws++;
+          auto m = (const wmtcmd_render_draw_meshthreadgroups *)cmd;
+          info.mesh_tgs += (uint32_t)(m->threadgroup_per_grid.width * m->threadgroup_per_grid.height);
+          break;
+        }
+        default:
+          break;
+        }
+      } else if (current->type == EncoderType::Compute) {
+        if (cmd->type == WMTComputeCommandDispatch || cmd->type == WMTComputeCommandDispatchIndirect)
+          info.dispatches++;
+        if (cmd->type == WMTComputeCommandSetPSO && !first_pso)
+          first_pso = ((const wmtcmd_compute_setpso *)cmd)->pso;
+      } else if (current->type == EncoderType::Blit) {
+        if (cmd->type != WMTBlitCommandNop)
+          info.dispatches++;
+      }
+    }
+    if (current->type == EncoderType::Compute)
+      mix(first_pso);
+    if (current->type == EncoderType::Render)
+      mix(info.draws + (uint64_t)info.mesh_draws * 1000); /* 같은 대상이라도 그리기 수로 나눈다 */
+    info.key = h;
+    info.barrier = current->ember_barrier;
+    info.merged = 1;
+    return info;
+  }
 
