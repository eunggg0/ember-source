+#pragma once
+/* Ember: D3D12 실험·진단 스위치. 먼저 환경 변수, 없으면 보틀의 C:\ember-d12.cfg (한 줄에 NAME=VALUE).
+ * 스팀처럼 이미 떠 있는 런처가 게임을 띄우면 Ember 가 넘기는 환경 변수 목록에 없는 값은 게임까지 안 간다 —
+ * 그래서 시험용으로 파일도 읽는다. 파일이 없으면 기본값(제품 동작)이다. */
+#include "util_env.hpp"
+#include <cstdio>
