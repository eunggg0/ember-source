+std::mutex trace_descriptor_mutex;
+std::unordered_map<uint64_t, TraceDescriptorHeap> trace_descriptor_heaps;
+std::atomic<uint64_t> trace_descriptor_generation{1};
+std::atomic<uint64_t> trace_descriptor_losses{0};
+constexpr size_t kTraceDescriptorLimit = 8192;
+constexpr size_t kTraceHeapLimit = 256, kTraceTotalSlotLimit = 65536;
+size_t trace_descriptor_slot_count = 0;
