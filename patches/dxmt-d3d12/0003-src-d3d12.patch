+  EmberTraceEncoder(EncoderData *current) noexcept {
+    try {
+    uint64_t cb = inflight_cmdbuf_seq_.load(std::memory_order_relaxed);
+    ember_trace_encoder_ = current->id;
+    EmberD12Trace(TraceKind::Encoder, ember_trace_queue_id_, cb, current->id, 0, (uint64_t)current->type,
+                  current->ember_barrier, current->ember_barrier_inside, current->ember_bres_unsafe);
+    for (unsigned i = 0; i < current->ember_bres_count; i++)
+      EmberD12Trace(TraceKind::Barrier, ember_trace_queue_id_, cb, current->id, 0,
+                    (uintptr_t)current->ember_bres[i], current->ember_bres_info[i]);
+    const wmtcmd_base *cmd = nullptr;
+    if (current->type == EncoderType::Compute)
+      cmd = (const wmtcmd_base *)&static_cast<ComputeEncoderData *>(current)->cmd_head;
+    else if (current->type == EncoderType::Render)
+      cmd = (const wmtcmd_base *)&static_cast<RenderEncoderData *>(current)->cmd_head;
+    else if (current->type == EncoderType::Blit)
+      cmd = (const wmtcmd_base *)&static_cast<BlitEncoderData *>(current)->cmd_head;
+    const EmberTraceRoots *active = nullptr, *next = current->ember_trace_head;
+    uint64_t dispatch = 0, pso = 0;
+    if (current->ember_trace_incomplete)
+      EmberD12Trace(TraceKind::SnapshotGap, ember_trace_queue_id_, cb, current->id, 0, 7);
+    for (; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr) {
+      if (current->type == EncoderType::Compute && cmd->type == WMTComputeCommandSetPSO)
+        pso = ((const wmtcmd_compute_setpso *)cmd)->pso;
+      if (current->type == EncoderType::Render && cmd->type == WMTRenderCommandSetPSO)
+        pso = ((const wmtcmd_render_setpso *)cmd)->pso;
+      bool execute = false;
+      if (current->type == EncoderType::Compute)
+        execute = cmd->type == WMTComputeCommandDispatch || cmd->type == WMTComputeCommandDispatchThreads ||
+                  cmd->type == WMTComputeCommandDispatchIndirect || cmd->type == WMTComputeCommandExecuteCommandsInBuffer;
+      else if (current->type == EncoderType::Render)
+        execute = cmd->type == WMTRenderCommandDraw || cmd->type == WMTRenderCommandDrawIndexed ||
+                  cmd->type == WMTRenderCommandDrawIndirect || cmd->type == WMTRenderCommandDrawIndexedIndirect ||
+                  cmd->type == WMTRenderCommandDrawMeshThreadgroups || cmd->type == WMTRenderCommandExecuteCommandsInBuffer;
+      if (execute) {
+        ++dispatch;
+        uint64_t a = 0, b = 0, c = 0;
+        if (current->type == EncoderType::Compute) {
+          if (cmd->type == WMTComputeCommandDispatch || cmd->type == WMTComputeCommandDispatchThreads) {
+            const auto *d = (const wmtcmd_compute_dispatch *)cmd;
+            a = d->size.width; b = d->size.height; c = d->size.depth;
+          } else if (cmd->type == WMTComputeCommandDispatchIndirect) {
+            const auto *d = (const wmtcmd_compute_dispatch_indirect *)cmd;
+            a = d->indirect_args_buffer; b = d->indirect_args_offset;
+          }
+        }
+        EmberD12Trace(TraceKind::Dispatch, ember_trace_queue_id_, cb, current->id, dispatch, pso, cmd->type, a, b, c, active && active->indirect);
+        if (!active)
+          EmberD12Trace(TraceKind::SnapshotGap, ember_trace_queue_id_, cb, current->id, dispatch, 8);
+        if (active && !current->ember_trace_incomplete) {
+          if (ember_trace_bindings_.size() + active->count + 2 > 65536) {
+            EmberD12Trace(TraceKind::SnapshotGap, ember_trace_queue_id_, cb, current->id, dispatch, 3, 65536);
+            return;
+          }
+          for (uint32_t i = 0; i < active->count; i++) {
+            EmberD12Trace(TraceKind::Root, ember_trace_queue_id_, cb, current->id, dispatch, i, active->words[i], (active->tables >> i) & 1, active->indirect);
+            if ((active->tables >> i) & 1)
+              ember_trace_bindings_.push_back({active->words[i], current->id, dispatch, false});
+          }
+          if (active->resource_heap)
+            ember_trace_bindings_.push_back({active->resource_heap, current->id, dispatch, true});
+          if (active->sampler_heap)
+            ember_trace_bindings_.push_back({active->sampler_heap, current->id, dispatch, true});
+          if (active->indirect)
+            EmberD12Trace(TraceKind::SnapshotGap, ember_trace_queue_id_, cb, current->id, dispatch, 6); // GPU-written roots not CPU-observable
+        }
+      }
+      if (current->type == EncoderType::Compute && cmd->type == WMTComputeCommandMemoryBarrier)
+        EmberD12Trace(TraceKind::Barrier, ember_trace_queue_id_, cb, current->id, dispatch, 0,
+                      ((const wmtcmd_compute_memory_barrier *)cmd)->scope, 1);
+      if (current->type == EncoderType::Compute && (cmd->type == WMTComputeCommandWaitForFence || cmd->type == WMTComputeCommandUpdateFence))
