+struct TraceDescriptorHeap {
+  uint64_t base, count, ir_handle, ir_base, incarnation, type, version = 0;
+  uint64_t last_queue = 0, last_cb = 0, last_version = ~0ull;
+  std::unordered_map<uint64_t, TraceDescriptorSlot> slots;
