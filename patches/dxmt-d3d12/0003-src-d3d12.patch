+/* Ember(w3d12): 출력 시그니처(OSGN/OSG5/OSG1) 원소가 0개인가. 위쳐 3 차세대판의 UAV 만 쓰는 GS 가 이렇고,
+ * Apple MSC 32.47 은 이 GS 를 변환하다 llvm::Value::getName(null) 로 죽는다(compat17 단독 재현) — 넘기기 전에 거른다. */
+static bool
+EmberShaderHasNoOutputs(D3D12_SHADER_BYTECODE b) {
+  auto p = (const uint8_t *)b.pShaderBytecode;
+  size_t n = b.BytecodeLength;
+  if (!p || n < 32 || memcmp(p, "DXBC", 4))
+    return false;
+  uint32_t parts;
+  memcpy(&parts, p + 28, 4);
+  if (parts > 64 || 32 + 4ull * parts > n)
+    return false;
+  long outs = -1;
+  for (uint32_t i = 0; i < parts; i++) {
+    uint32_t off, sz;
+    memcpy(&off, p + 32 + 4 * i, 4);
+    if ((uint64_t)off + 8 > n)
+      return false;
+    memcpy(&sz, p + off + 4, 4);
+    if ((uint64_t)off + 8 + sz > n)
+      return false;
+    if ((!memcmp(p + off, "OSG1", 4) || !memcmp(p + off, "OSGN", 4) || !memcmp(p + off, "OSG5", 4)) && sz >= 4) {
+      uint32_t c;
+      memcpy(&c, p + off + 8, 4);
+      outs = (outs < 0 ? 0 : outs) + c;
+    }
+  }
+  return outs == 0;
+}
