+void TraceHeapCreate(uint64_t id, uint64_t base, uint64_t count, uint64_t ir_handle, uint64_t ir_base, uint64_t type) noexcept {
+  try {
+  std::unique_lock<std::mutex> lock(trace_descriptor_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 1, id);
+    return;
+  }
+  auto existing = trace_descriptor_heaps.find(id);
+  if (existing == trace_descriptor_heaps.end() && trace_descriptor_heaps.size() >= kTraceHeapLimit) {
+    trace_descriptor_losses.fetch_add(1);
