+namespace dxmt {
+
+inline std::string
+EmberD12Opt(const char *name) {
+  auto v = env::getEnvVar(name);
+  if (!v.empty())
+    return v;
+  static std::string file = []() {
+    std::string out;
+    if (FILE *f = fopen("C:\\ember-d12.cfg", "rb")) {
+      char buf[4096];
+      size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+      buf[n] = 0;
+      out = buf;
+      fclose(f);
+    }
+    return out;
+  }();
+  size_t len = strlen(name);
+  size_t pos = 0;
+  while (pos < file.size()) {
+    size_t eol = file.find_first_of("\r\n", pos);
+    if (eol == std::string::npos)
+      eol = file.size();
+    if (eol - pos > len && file.compare(pos, len, name) == 0 && file[pos + len] == '=')
+      return file.substr(pos + len + 1, eol - pos - len - 1);
+    pos = eol + 1;
+  }
+  return {};
+}
+
+inline int
+EmberD12OptInt(const char *name, int def) {
+  auto v = EmberD12Opt(name);
+  return v.empty() ? def : atoi(v.c_str());
+}
+
+/* Ember: GPU 전용 텍스처·힙을 private 저장으로(기본 켬). EMBER_D12_TEX_PRIVATE=0 이면 예전처럼 전부 shared. */
+inline bool
+EmberD12TexturePrivate() {
+  static bool v = EmberD12OptInt("EMBER_D12_TEX_PRIVATE", 1) != 0;
+  return v;
+}
+
+/* Ember(d12games4): 타일·힙 진단 로그(EMBER_D12_TLOG=1) — CreateHeap·CreatePlacedResource·CreateReservedResource·
+ * GetResourceTiling·GetResourceAllocationInfo·UpdateTileMappings(지역·범위 전부) */
+inline bool
+EmberD12TileLog() {
+  static bool v = EmberD12OptInt("EMBER_D12_TLOG", 0) != 0;
+  return v;
+}
+
+/* Ember(d12games4): 명령 목록 호출 수(EMBER_D12_CALLSTAT=N: N Present 마다 기록) — 게임이 무엇을 그리고 올리는지 */
+enum EmberCallStat {
+  kCsDraw, kCsDrawIndexed, kCsDrawDropped, kCsExecIndirect, kCsExecIndirectCount, kCsExecIndirectArgs, kCsDispatch,
+  kCsCopyBuffer, kCsCopyTexture, kCsCopyResource, kCsEclDirect, kCsEclCompute, kCsEclCopy, kCsClearRtv, kCsCount
+};
+inline std::atomic<uint64_t> g_ember_callstat[kCsCount];
+inline bool
+EmberCallStatOn() {
+  static bool v = EmberD12OptInt("EMBER_D12_CALLSTAT", 0) > 0;
+  return v;
+}
+inline void
+EmberCs(EmberCallStat k, uint64_t n = 1) {
+  if (EmberCallStatOn())
+    g_ember_callstat[k].fetch_add(n, std::memory_order_relaxed);
+}
+
+/* Ember(launch5): 장치가 못 하는 MSAA 표본 수(애플 GPU 는 8x 없음)를 할 수 있는 가장 큰 값으로 낮춘다.
+ * 위쳐 3 차세대판이 8x PSO 를 만들다 실패하면 렌더 스레드가 멈춘다. D3D12 쪽 설명(GetDesc)은 그대로 두고 Metal 자원·PSO 만 낮춘다.
+ * EMBER_D12_MSAA_CLAMP=0 이면 끔(예전처럼 그대로 넘겨 실패). */
+template <typename DeviceT>
+inline unsigned
+EmberClampSampleCount(DeviceT device, unsigned count) {
+  if (count <= 1)
+    return count;
+  static const bool on = EmberD12OptInt("EMBER_D12_MSAA_CLAMP", 1) != 0;
+  if (!on)
+    return count;
+  static std::atomic<uint8_t> cache[33];
+  if (count > 32)
+    count = 32;
+  uint8_t c = cache[count].load(std::memory_order_relaxed);
+  if (c)
+    return c;
+  unsigned n = count;
+  while (n > 1 && !device.supportsTextureSampleCount((uint8_t)n))
+    n >>= 1;
+  if (n < 1)
+    n = 1;
+  if (n != count)
+    fprintf(stderr, "warn:  ember-d12: MSAA %ux not supported by device -> %ux\n", count, n);
+  cache[count].store((uint8_t)n, std::memory_order_relaxed);
+  return n;
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_sparse.hpp b/src/d3d12/d3d12_ember_sparse.hpp
new file mode 100644
index 0000000..63205d4
--- /dev/null
+++ b/src/d3d12/d3d12_ember_sparse.hpp
@@ -0,0 +1,181 @@
+#pragma once
+/* Ember(d12games4): D3D12 예약(타일) 자원을 Metal 4 자리잡이 희소(placement sparse) 자원으로.
+ *
+ * 자원은 메모리 없이 만들고(winemetal EmberSparse_call, 호출 158), UpdateTileMappings·CopyTileMappings 가 큐의 MTL4CommandQueue 로
+ * D3D12 힙(= Metal 자리잡이 힙, maxCompatiblePlacementSparsePageSize 64K)의 타일을 건다. 안 건 타일은 0 으로 읽히고 쓰기는 버려진다
+ * (D3D12 타일 등급 2). 실측(M4 Pro, macOS 27): 고전 MTLCommandQueue 에서 읽고 쓰기·힙 별칭·0 읽기 모두 된다. 텍스처 타일 모양은
+ * Metal sparseTileSize(64K) — D3D12 표준 타일 모양과 같다(RGBA8 128², RGBA16F 128×64, BC1 512×256 …). 작은 밉 꼬리는 Metal
+ * firstMipmapInTail·tailSizeInBytes 를 그대로 D3D12 묶음 밉(packed)으로 알린다.
+ *
+ * 타일 순서(D3D12): 배열 조각마다 [표준 밉 0..std-1 의 타일(x→y→z), 그 조각의 묶음 밉 타일]. */
+#include <cstdint>
+#include <algorithm>
+
+namespace dxmt {
+
+struct EmberSparseLayout {
+  bool on = false;
+  bool is_buffer = false;
+  uint32_t tile_w = 65536, tile_h = 1, tile_d = 1; /* 타일 모양(텍셀, 버퍼는 바이트) */
+  uint32_t width = 0, height = 1, depth = 1;       /* 밉 0 크기(텍셀) */
+  uint32_t mips = 1, slices = 1, std_mips = 1, tail_tiles = 0;
+  uint64_t total_tiles = 0;
+  uint64_t metal = 0; /* MTLBuffer / MTLTexture 핸들 */
+
+  uint32_t
+  mipW(uint32_t m) const {
+    return std::max<uint32_t>(1, width >> m);
+  }
+  uint32_t
+  mipH(uint32_t m) const {
+    return std::max<uint32_t>(1, height >> m);
+  }
+  uint32_t
+  mipD(uint32_t m) const {
+    return std::max<uint32_t>(1, depth >> m);
+  }
+  uint32_t
+  tilesW(uint32_t m) const {
+    return (mipW(m) + tile_w - 1) / tile_w;
+  }
+  uint32_t
+  tilesH(uint32_t m) const {
+    return (mipH(m) + tile_h - 1) / tile_h;
+  }
+  uint32_t
+  tilesD(uint32_t m) const {
+    return (mipD(m) + tile_d - 1) / tile_d;
+  }
+  uint64_t
+  tilesPerSlice() const {
+    uint64_t n = 0;
+    for (uint32_t m = 0; m < std_mips; m++)
+      n += (uint64_t)tilesW(m) * tilesH(m) * tilesD(m);
+    return n + tail_tiles;
+  }
+  void
+  finish() {
+    if (is_buffer) {
+      total_tiles = ((uint64_t)width + 65535) / 65536;
+      return;
+    }
+    total_tiles = tilesPerSlice() * slices;
+  }
+  /* 밉 m(표준), 조각 a 의 첫 타일 번호 */
+  uint64_t
+  startTile(uint32_t a, uint32_t m) const {
+    uint64_t n = tilesPerSlice() * a;
+    for (uint32_t i = 0; i < m && i < std_mips; i++)
+      n += (uint64_t)tilesW(i) * tilesH(i) * tilesD(i);
+    return n;
+  }
+};
+
+/* 타일 하나(D3D12 좌표 → Metal 좌표). packed 면 level = std_mips(Metal firstMipmapInTail), x = 꼬리 안 번호 */
+struct EmberSparseTile {
+  uint32_t level, slice, x, y, z;
+};
+
+/* D3D12 지역(시작 좌표 + 크기)의 타일을 순서대로 내놓는다. 범위를 벗어나면 false */
+struct EmberSparseWalker {
+  const EmberSparseLayout &L;
+  uint32_t sub, x, y, z;
+  bool box;
+  uint32_t bx0, by0, bz0, bw, bh, bd;
+  uint64_t left;
+  bool valid = true;
+
+  EmberSparseWalker(
+      const EmberSparseLayout &layout, uint32_t X, uint32_t Y, uint32_t Z, uint32_t Subresource, uint64_t num_tiles, bool use_box,
+      uint32_t w, uint32_t h, uint32_t d
+  ) :
+      L(layout),
+      sub(Subresource),
+      x(X),
+      y(Y),
+      z(Z),
+      box(use_box),
+      bx0(X),
+      by0(Y),
+      bz0(Z),
+      bw(w),
+      bh(h),
+      bd(d) {
+    left = use_box ? (uint64_t)w * h * d : num_tiles;
+    if (!L.is_buffer && packed(sub))
+      sub = slice(sub) * L.mips + L.std_mips; /* 묶음 밉은 조각마다 하나 */
+  }
+
+  uint32_t
+  mip(uint32_t s) const {
+    return s % L.mips;
+  }
+  uint32_t
+  slice(uint32_t s) const {
+    return (s / L.mips) % std::max<uint32_t>(1, L.slices);
+  }
+  bool
+  packed(uint32_t s) const {
+    return mip(s) >= L.std_mips;
+  }
+
+  bool
+  next(EmberSparseTile &t) {
+    if (!left || !valid)
+      return false;
+    if (L.is_buffer) {
+      if (x >= L.total_tiles)
+        return valid = false;
+      t = {0, 0, x, 0, 0};
+      x++;
+      left--;
+      return true;
+    }
+    uint32_t a = slice(sub), m = mip(sub);
+    if (sub / L.mips >= L.slices)
+      return valid = false;
+    if (packed(sub)) {
+      if (x >= L.tail_tiles)
+        return valid = false;
+      t = {L.std_mips, a, x, 0, 0};
+    } else {
+      if (x >= L.tilesW(m) || y >= L.tilesH(m) || z >= L.tilesD(m))
+        return valid = false;
+      t = {m, a, x, y, z};
+    }
+    left--;
+    /* 다음 */
+    if (box) {
+      if (++x >= bx0 + bw) {
+        x = bx0;
+        if (++y >= by0 + bh) {
+          y = by0;
+          ++z;
+        }
+      }
+      return true;
+    }
+    if (packed(sub)) {
+      if (++x >= L.tail_tiles) {
+        x = y = z = 0;
+        sub = (a + 1) * L.mips;
+      }
+      return true;
+    }
+    if (++x >= L.tilesW(m)) {
+      x = 0;
+      if (++y >= L.tilesH(m)) {
+        y = 0;
+        if (++z >= L.tilesD(m)) {
+          z = 0;
+          sub++;
+          if (packed(sub) && L.tail_tiles == 0)
+            sub = (a + 1) * L.mips; /* 꼬리 없음 */
+        }
+      }
+    }
+    return true;
+  }
+};
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_trace.cpp b/src/d3d12/d3d12_ember_trace.cpp
new file mode 100644
index 0000000..47bfd7d
--- /dev/null
+++ b/src/d3d12/d3d12_ember_trace.cpp
@@ -0,0 +1,169 @@
+#include "d3d12_ember_trace.hpp"
+#include "d3d12_ember_trace_ring.hpp"
+
+#include <windows.h>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cwchar>
+#include <string>
+
+namespace dxmt {
+namespace {
+
+struct TraceState {
+  ember_trace::Ring ring;
+  const std::wstring path;
+  uint64_t frequency = 0;
+  std::atomic_flag dumping = ATOMIC_FLAG_INIT;
+  bool abnormal_dump_saved = false; // Protected by dumping.
+
+  TraceState(size_t capacity, std::wstring output) : ring(capacity), path(std::move(output)) {
+    LARGE_INTEGER value{};
+    QueryPerformanceFrequency(&value);
+    frequency = static_cast<uint64_t>(value.QuadPart);
+  }
+};
+
+// Kept alive for atexit and late queue destructors. There is no DLL detach I/O.
+TraceState *state = nullptr;
+
+std::wstring
+environment(const wchar_t *name) {
+  DWORD size = GetEnvironmentVariableW(name, nullptr, 0);
+  if (!size)
+    return {};
+  std::wstring result(size, L'\0');
+  DWORD copied = GetEnvironmentVariableW(name, result.data(), size);
+  if (!copied || copied >= size)
+    return {};
+  result.resize(copied);
+  return result;
+}
+
+void
+exit_dump() {
+  EmberD12TraceDumpSlow(3, 0, 0);
+}
+
+bool
+initialize() noexcept {
+  try {
+    // Only the exact opt-in value enables tracing, and no cfg file is consulted.
+    if (environment(L"EMBER_D12_TRACE") != L"1")
+      return false;
+    size_t capacity = 65536;
+    const auto requested = environment(L"EMBER_D12_TRACE_CAPACITY");
+    if (!requested.empty()) {
+      wchar_t *end = nullptr;
+      const auto value = std::wcstoull(requested.c_str(), &end, 10);
+      if (end != requested.c_str() && *end == L'\0' && requested[0] != L'-')
+        capacity = static_cast<size_t>(std::clamp<uint64_t>(value, 4096, 1048576));
+    }
+    auto path = environment(L"EMBER_D12_TRACE_PATH");
+    if (path.empty())
+      path = L"C:\\ember-d12trace.bin";
+    state = new TraceState(capacity, std::move(path));
+    std::atexit(exit_dump);
+    return true;
+  } catch (...) {
+    // Enabling diagnostics must never turn allocation failure into a game crash.
+    return false;
+  }
+}
+
+void
+put32(unsigned char *out, uint32_t value) noexcept {
+  for (unsigned i = 0; i < 4; ++i)
+    out[i] = static_cast<unsigned char>(value >> (8 * i));
+}
+
+void
+put64(unsigned char *out, uint64_t value) noexcept {
+  for (unsigned i = 0; i < 8; ++i)
+    out[i] = static_cast<unsigned char>(value >> (8 * i));
+}
+
+bool
+write_bytes(HANDLE file, const void *bytes, DWORD size) noexcept {
+  const auto *current = static_cast<const unsigned char *>(bytes);
+  while (size) {
+    DWORD written = 0;
+    if (!WriteFile(file, current, size, &written, nullptr) || !written)
+      return false;
+    current += written;
+    size -= written;
+  }
+  return true;
+}
+
+} // namespace
+
+const bool EmberD12TraceEnabled = initialize();
+
+void
+EmberD12TraceSlow(TraceKind kind, uint64_t queue, uint64_t cb,
+                  uint64_t encoder, uint64_t dispatch, uint64_t a,
+                  uint64_t b, uint64_t c, uint64_t d, uint64_t e,
+                  uint64_t f, uint64_t g, uint64_t h) noexcept {
+  LARGE_INTEGER ticks{};
+  QueryPerformanceCounter(&ticks);
+  state->ring.write({0, static_cast<uint64_t>(ticks.QuadPart), GetCurrentThreadId(),
+                     queue, cb, encoder, dispatch, static_cast<uint64_t>(kind),
+                     a, b, c, d, e, f, g, h});
+}
+
+void
+EmberD12TraceDumpSlow(uint64_t reason, uint64_t queue, uint64_t cb) noexcept {
+  if (!state || state->dumping.test_and_set(std::memory_order_acquire))
+    return;
+  if (state->abnormal_dump_saved) {
+    state->dumping.clear(std::memory_order_release);
+    return;
+  }
+  HANDLE file = INVALID_HANDLE_VALUE;
+  try {
+    auto snapshot = state->ring.snapshot();
+    file = CreateFileW(state->path.c_str(), GENERIC_WRITE, FILE_SHARE_READ,
+                       nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+      std::array<unsigned char, 88> header{};
+      const char magic[8] = {'E', 'M', 'B', 'D', '1', '2', 'T', '\0'};
+      std::copy_n(magic, 8, header.begin());
+      put32(header.data() + 8, 1);
+      put32(header.data() + 12, 128);
+      const uint64_t fields[9] = {state->ring.capacity(), snapshot.records.size(),
+        snapshot.next_serial, snapshot.dropped, state->frequency,
+        GetCurrentProcessId(), reason, queue, cb};
+      for (size_t i = 0; i < 9; ++i)
+        put64(header.data() + 16 + i * 8, fields[i]);
+      bool ok = write_bytes(file, header.data(), header.size());
+      // Batched I/O is confined to explicit dumps; event producers perform none.
+      std::array<unsigned char, 128 * 256> block{};
+      for (size_t base = 0; ok && base < snapshot.records.size(); base += 256) {
+        size_t count = std::min<size_t>(256, snapshot.records.size() - base);
+        for (size_t i = 0; i < count; ++i)
+          for (size_t field = 0; field < 16; ++field)
+            put64(block.data() + i * 128 + field * 8, snapshot.records[base + i][field]);
+        ok = write_bytes(file, block.data(), static_cast<DWORD>(count * 128));
+      }
+      ok = ok && FlushFileBuffers(file);
+      const bool closed = CloseHandle(file);
+      file = INVALID_HANDLE_VALUE;
+      if (ok && closed && (reason == 1 || reason == 2))
+        state->abnormal_dump_saved = true;
+      if (!ok || !closed)
+        std::fprintf(stderr, "Ember D12 trace: dump write failed (Win32 error %lu)\n", static_cast<unsigned long>(GetLastError()));
+    } else {
+      std::fprintf(stderr, "Ember D12 trace: cannot open dump (Win32 error %lu)\n", static_cast<unsigned long>(GetLastError()));
+    }
+  } catch (...) {
+    // A failed dump can be retried by the next trigger; never unwind into DXMT.
+    std::fprintf(stderr, "Ember D12 trace: dump snapshot allocation failed\n");
+  }
+  if (file != INVALID_HANDLE_VALUE)
+    CloseHandle(file);
+  state->dumping.clear(std::memory_order_release);
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_trace.hpp b/src/d3d12/d3d12_ember_trace.hpp
new file mode 100644
index 0000000..d49bd34
--- /dev/null
+++ b/src/d3d12/d3d12_ember_trace.hpp
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+
+namespace dxmt {
+
+// Ember-local diagnostics. Values are the stable binary trace ABI (version 1).
+enum class TraceKind : uint64_t {
+  Queue = 1, Submit, Complete, Error, Timeout, Encoder, Dispatch, Binding, Root,
+  Descriptor, DescriptorWrite, Heap, ResourceAlloc, ResourceRelease,
+  ResidencyAdd, ResidencyRemove, ResidencyCommit, Barrier, FenceWait,
+  FenceSignal, EventWait, EventSignal, SnapshotGap, ResourceView, ResourceMap
+};
+
+extern const bool EmberD12TraceEnabled;
+void EmberD12TraceSlow(TraceKind kind, uint64_t queue, uint64_t cb,
+                     uint64_t encoder, uint64_t dispatch, uint64_t a,
+                     uint64_t b, uint64_t c, uint64_t d, uint64_t e,
+                     uint64_t f, uint64_t g, uint64_t h) noexcept;
+void EmberD12TraceDumpSlow(uint64_t reason, uint64_t queue, uint64_t cb) noexcept;
+
+inline void
+EmberD12Trace(TraceKind kind, uint64_t queue = 0, uint64_t cb = 0,
+              uint64_t encoder = 0, uint64_t dispatch = 0, uint64_t a = 0,
+              uint64_t b = 0, uint64_t c = 0, uint64_t d = 0, uint64_t e = 0,
+              uint64_t f = 0, uint64_t g = 0, uint64_t h = 0) noexcept {
+  if (EmberD12TraceEnabled)
+    EmberD12TraceSlow(kind, queue, cb, encoder, dispatch, a, b, c, d, e, f, g, h);
+}
+
+// Reasons: 1 GPU error, 2 suspected timeout, 3 normal shutdown. The first
+// successfully written reason 1/2 dump is retained across later calls.
+inline void
+EmberD12TraceDump(uint64_t reason, uint64_t queue = 0, uint64_t cb = 0) noexcept {
+  if (EmberD12TraceEnabled)
+    EmberD12TraceDumpSlow(reason, queue, cb);
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_ember_trace_ring.hpp b/src/d3d12/d3d12_ember_trace_ring.hpp
new file mode 100644
index 0000000..98fbf2d
--- /dev/null
+++ b/src/d3d12/d3d12_ember_trace_ring.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace dxmt::ember_trace {
+
+using Record = std::array<uint64_t, 16>;
+static_assert(sizeof(Record) == 128);
+
+struct Snapshot {
+  uint64_t next_serial;
+  uint64_t dropped;
+  std::vector<Record> records;
+};
+
+// Writers never wait: contention costs one dropped event, not a game-thread
+// mutex. Slot data is only accessed while holding its flag, including dumps.
+// A delayed producer cannot overwrite a newer lap of the same slot.
+class Ring {
+  struct Slot {
+    std::atomic_flag busy = ATOMIC_FLAG_INIT;
+    Record record{};
+  };
+  const size_t capacity_;
+  std::unique_ptr<Slot[]> slots_;
+  std::atomic<uint64_t> next_{1};
+  std::atomic<uint64_t> dropped_{0};
+
+public:
+  explicit Ring(size_t capacity)
+      : capacity_(capacity), slots_(new Slot[capacity]) {}
+  size_t capacity() const noexcept { return capacity_; }
+
+  void write(Record record) noexcept {
+    const uint64_t serial = next_.fetch_add(1, std::memory_order_relaxed);
+    record[0] = serial;
+    Slot &slot = slots_[(serial - 1) % capacity_];
+    if (slot.busy.test_and_set(std::memory_order_acquire)) {
+      dropped_.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    if (slot.record[0] < serial)
+      slot.record = record;
+    else
+      dropped_.fetch_add(1, std::memory_order_relaxed);
+    slot.busy.clear(std::memory_order_release);
+  }
+
+  Snapshot snapshot() {
+    Snapshot result{next_.load(std::memory_order_relaxed),
+                    dropped_.load(std::memory_order_relaxed), {}};
+    const uint64_t first = result.next_serial > capacity_
+                               ? result.next_serial - capacity_ : 1;
+    result.records.reserve(capacity_);
+    for (size_t i = 0; i < capacity_; ++i) {
+      Slot &slot = slots_[i];
+      if (slot.busy.test_and_set(std::memory_order_acquire))
+        continue;
+      const Record record = slot.record;
+      slot.busy.clear(std::memory_order_release);
+      if (record[0] >= first && record[0] < result.next_serial)
+        result.records.push_back(record);
+    }
+    std::sort(result.records.begin(), result.records.end(),
+              [](const Record &a, const Record &b) { return a[0] < b[0]; });
+    return result;
+  }
+};
