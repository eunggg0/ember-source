+            ds->cpuDescriptor, (D3D12_CLEAR_FLAGS)cf, ds->DepthBeginningAccess.Clear.ClearValue.DepthStencil.Depth,
+            ds->StencilBeginningAccess.Clear.ClearValue.DepthStencil.Stencil, 0, nullptr
+        );
+      EmberRPAddResolves(ds->DepthEndingAccess);
+    }
+  }
