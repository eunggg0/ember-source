+/* Ember: DXBC 컨테이너 입력 서명(ISG1/ISGN)에서 IR 이름("attribute12" = 의미 이름+번호)에 맞는 입력의 성분 형식.
+ * 1 = uint, 2 = sint, 3 = float, 못 찾으면 0 */
+static uint32_t
+EmberInputComponentType(D3D12_SHADER_BYTECODE Bytecode, const char *ir_name) {
+  auto base = reinterpret_cast<const uint8_t *>(Bytecode.pShaderBytecode);
+  size_t size = Bytecode.BytecodeLength;
+  if (!base || size < 32 || memcmp(base, "DXBC", 4))
+    return 0;
+  auto rd32 = [&](size_t off) -> uint32_t {
+    if (off + 4 > size)
+      return 0;
+    uint32_t v;
+    memcpy(&v, base + off, 4);
+    return v;
+  };
+  uint32_t chunks = rd32(28);
+  for (uint32_t c = 0; c < chunks && c < 64; c++) {
+    uint32_t off = rd32(32 + c * 4);
+    if (off + 8 > size)
+      continue;
+    bool isg1 = !memcmp(base + off, "ISG1", 4), isgn = !memcmp(base + off, "ISGN", 4);
+    if (!isg1 && !isgn)
+      continue;
+    size_t data = off + 8;
+    uint32_t count = rd32(data), elem_off = rd32(data + 4);
+    size_t stride = isg1 ? 32 : 24;
+    for (uint32_t i = 0; i < count && i < 64; i++) {
+      size_t e = data + elem_off + i * stride;
+      if (e + stride > size)
+        break;
+      if (isg1)
+        e += 4; /* stream */
+      uint32_t name_off = rd32(e), sem_index = rd32(e + 4), comp_type = rd32(e + 12);
+      if (data + name_off >= size)
+        continue;
+      const char *name = reinterpret_cast<const char *>(base + data + name_off);
+      size_t max_len = size - (data + name_off);
+      size_t len = strnlen(name, max_len);
+      if (len == max_len || len > 60)
+        continue;
+      char full[80];
+      snprintf(full, sizeof(full), "%.*s%u", (int)len, name, sem_index);
+      if (strcasecmp(full, ir_name) == 0 ||
+          (sem_index == 0 && strlen(ir_name) == len && strncasecmp(name, ir_name, len) == 0))
+        return comp_type;
+    }
+  }
+  return 0;
+}
