+    trace_descriptor_heaps.erase(it);
+  }
+  } catch (...) {
+    trace_descriptor_losses.fetch_add(1);
+    EmberD12Trace(TraceKind::SnapshotGap, 0, 0, 0, 0, 7, id);
+  }
