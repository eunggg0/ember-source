+  void
+  EmberRPAddResolves(const D3D12_RENDER_PASS_ENDING_ACCESS &e) {
+    if (e.Type != D3D12_RENDER_PASS_ENDING_ACCESS_TYPE_RESOLVE)
+      return;
+    auto &r = e.Resolve;
+    for (UINT k = 0; k < r.SubresourceCount; k++) {
+      auto &sp = r.pSubresourceParameters[k];
+      ember_rp_resolves_.push_back({r.pSrcResource, r.pDstResource, sp.SrcSubresource, sp.DstSubresource, r.Format});
+    }
+  }
