+        want_stagein = true;
+    }
+    static const bool force_stagein = EmberD12OptInt("EMBER_D12_STAGEIN", 0) == 2; /* 2 = 모든 DXIL PSO 를 이 길로(시험) */
+    static const bool allow_stagein = EmberD12OptInt("EMBER_D12_STAGEIN", 1) != 0;
+    if (force_stagein && pDesc->InputLayout.NumElements)
+      want_stagein = true;
+    ember_stagein = false;
+    EmberIRInputLayout si_layout;
+    uint32_t si_slots = 0;
+    WMT::Reference<WMT::Function> vs_func;
+    if (want_stagein && allow_stagein && EmberStageInFn() && SUCCEEDED(BuildIRInputLayout(pDesc, si_layout, si_slots))) {
+      vs_func = EmberCompileStageIn(pDesc, rsdesc, si_layout, vs_flags, vs_refl);
+      if (vs_func)
+        ember_stagein = true;
+      else
+        WARN("CreateGraphicsPipelineState: VS stage-in synthesis failed: ", vs_refl.error);
+    }
+    if (!ember_stagein)
+      vs_func =
+          EmberDXIL_compile(metal.handle, pDesc->VS.pShaderBytecode, pDesc->VS.BytecodeLength, rsdesc, 0, vs_flags, &vs_refl);
+    if (!vs_func) {
+      ERR("CreateGraphicsPipelineState: DXIL vertex shader conversion failed: ", vs_refl.error);
+      return E_FAIL;
+    }
+    WMT::Reference<WMT::Function> ps_func;
+    if (pDesc->PS.pShaderBytecode) {
+      if (!EmberIsDXIL(pDesc->PS)) {
+        ERR("CreateGraphicsPipelineState: mixing DXIL VS with DXBC PS not supported");
+        do { ERR("ember-d12: E_NOTIMPL ", __func__, " ", __LINE__); return E_NOTIMPL; } while (0);
+      }
+      ps_func = EmberDXIL_compile(
+          metal.handle, pDesc->PS.pShaderBytecode, pDesc->PS.BytecodeLength, rsdesc, int_rt_mask,
+          dual_source_blending ? EMBER_DXIL_DUAL_SOURCE_BLEND : 0, &ps_refl
+      );
+      if (!ps_func) {
+        ERR("CreateGraphicsPipelineState: DXIL pixel shader conversion failed: ", ps_refl.error);
+        return E_FAIL;
+      }
+    }
+
+    /* 정점 입력: IR 반사의 속성 번호에 입력 배치를 맞춘다. 버퍼는 6+슬롯, stride 는 그릴 때(동적) */
+    std::vector<ember_vertex_attribute> attributes;
+    ember_vertex_layout layouts[32];
+    uint32_t num_layouts = 0;
+    uint32_t layout_seen = 0;
+    uint16_t append_offset[32] = {0};
+    uint32_t used_attributes = 0; /* Ember: Metal 속성 번호 비트 */
+    slot_mask = 0;
+    if (ember_stagein)
+      slot_mask = si_slots; /* stage-in 함수가 표로 읽는다 — 정점 서술자 없음 */
+    for (UINT j = 0; j < pDesc->InputLayout.NumElements && !ember_stagein; j++) {
+      auto &desc = pDesc->InputLayout.pInputElementDescs[j];
+      if (desc.InputSlot >= 24)
+        continue;
+      MTL_DXGI_FORMAT_DESC metal_format;
+      if (FAILED(MTLQueryDXGIFormat(metal, desc.Format, metal_format)) || !metal_format.AttributeFormat ||
+          !metal_format.BytesPerTexel) {
+        ERR("CreateGraphicsPipelineState: unsupported vertex format ", desc.Format);
+        return E_INVALIDARG;
+      }
+      auto offset = desc.AlignedByteOffset == D3D12_APPEND_ALIGNED_ELEMENT
+                        ? align(append_offset[desc.InputSlot], std::min(4u, metal_format.BytesPerTexel))
+                        : desc.AlignedByteOffset;
+      append_offset[desc.InputSlot] = offset + metal_format.BytesPerTexel;
+
+      char want[80], want0[80];
+      snprintf(want, sizeof(want), "%s%u", desc.SemanticName, desc.SemanticIndex);
+      snprintf(want0, sizeof(want0), "%s", desc.SemanticName);
+      int found = -1;
+      for (unsigned k = 0; k < vs_refl.num_vs_inputs; k++) {
+        if (strcasecmp(vs_refl.vs_inputs[k].name, want) == 0 ||
+            (desc.SemanticIndex == 0 && strcasecmp(vs_refl.vs_inputs[k].name, want0) == 0)) {
+          found = k;
+          break;
+        }
+      }
+      if (found < 0)
+        continue; /* 셰이더가 안 쓰는 입력 */
+      /* Ember: IR 반사의 속성 번호는 0 부터, Metal 쪽은 stage-in 시작 번호(kIRStageInAttributeStartIndex = 11)를 더한다.
+       * 예전엔 "11 보다 작으면 더한다" 였는데 반사 번호가 11 이상인 입력(attribute12 등)이 다른 입력과 겹쳐
+       * 버퍼 배치가 빈 채로 남고 Metal 이 assert 로 프로세스를 죽였다. */
+      uint32_t attribute_index = vs_refl.vs_inputs[found].attribute_index + 11;
+      if (attribute_index >= 31 || (used_attributes & (1u << attribute_index)))
+        continue;
+      used_attributes |= 1u << attribute_index;
+      attributes.push_back({(uint32_t)metal_format.AttributeFormat, (uint32_t)offset, 6 + desc.InputSlot, attribute_index});
+      slot_mask |= 1u << desc.InputSlot;
+      if (!(layout_seen & (1u << desc.InputSlot))) {
+        layout_seen |= 1u << desc.InputSlot;
+        bool instanced = desc.InputSlotClass == D3D12_INPUT_CLASSIFICATION_PER_INSTANCE_DATA;
+        layouts[num_layouts++] = {
+            6 + desc.InputSlot, instanced ? (desc.InstanceDataStepRate ? 2u : 0u) : 1u,
+            instanced ? desc.InstanceDataStepRate : 1u, 0
+        };
+      }
+    }
+    /* Ember: 입력 배치에 없는 VS 입력 — D3D12 는 0 을 읽게 두지만 Metal 은 PSO 를 거절한다
+     * ("Vertex attribute attributeN is missing from the vertex descriptor"). 0 으로 채운 상수 버퍼(30번)에 묶는다.
+     * 형식은 입력 서명(ISG1)의 성분 형식을 따른다(정수 입력에 float 형식을 주면 역시 거절). */
+    dxil_dummy_vb = false;
+    for (unsigned k = 0; k < vs_refl.num_vs_inputs && !ember_stagein; k++) {
+      uint32_t attribute_index = vs_refl.vs_inputs[k].attribute_index + 11;
+      if (attribute_index >= 31 || (used_attributes & (1u << attribute_index)))
+        continue;
+      used_attributes |= 1u << attribute_index;
+      uint32_t format = WMTAttributeFormatFloat4;
+      switch (EmberInputComponentType(pDesc->VS, vs_refl.vs_inputs[k].name)) {
+      case 1: format = WMTAttributeFormatUInt4; break;
+      case 2: format = WMTAttributeFormatInt4; break;
+      default: break;
+      }
+      WARN("CreateGraphicsPipelineState: DXIL VS input ", vs_refl.vs_inputs[k].name, " not in input layout, reads 0");
+      attributes.push_back({format, 0, kEmberDummyVertexBuffer, attribute_index});
+      if (!dxil_dummy_vb) {
+        dxil_dummy_vb = true;
+        layouts[num_layouts++] = {kEmberDummyVertexBuffer, 0 /* 상수 */, 0, 0};
+      }
+    }
+    if (!ember_stagein)
+      EmberMTL_setNextVertexDescriptor(attributes.data(), attributes.size(), layouts, num_layouts);
+
+    info.vertex_function = vs_func.handle;
+    info.fragment_function = ps_func.handle;
+    /* Ember: DXIL 경로의 ExecuteIndirect 는 ICB 가 아니라 Metal 간접 그리기를 하나씩 낸다 — ICB 지원을 켤 까닭이 없다 */
+    info.support_indirect_command_buffers = false;
+    WMT::Reference<WMT::Error> err;
+    /* Ember(d12games 10-03): 깊이 대상 없음 + PS 가 SV_Depth 를 쓰면 미리 Depth32Float — AGX 는 한 번 거절한 함수 조합을
+     * 다시 만들어도 같은 오류를 돌려준다(실측: 실패 뒤 깊이 형식을 넣어도 실패, 처음부터 넣으면 성공). */
+    if (pDesc->PS.pShaderBytecode && info.depth_pixel_format == WMTPixelFormatInvalid && pDesc->DSVFormat == DXGI_FORMAT_UNKNOWN &&
+        [&] {
+          static const char kDepth[] = "SV_Depth";
+          auto *b = (const char *)pDesc->PS.pShaderBytecode, *e = b + pDesc->PS.BytecodeLength;
+          return std::search(b, e, kDepth, kDepth + 8) != e;
+        }())
+      info.depth_pixel_format = WMTPixelFormatDepth32Float;
+    pso = metal.newRenderPipelineState(info, err);
+    /* Ember(d12games 10-03): D3D12 는 되는데 Metal 이 PSO 를 거절하는 두 경우를 고쳐 한 번 더(RE 엔진 — 프라그마타·레퀴엠).
+     *  ① 깊이 대상 없음(DSVFormat UNKNOWN) + PS 가 SV_Depth 를 씀: D3D12 는 깊이 출력을 버린다 → 파이프라인에만 Depth32Float 를 둔다
+     *     (그릴 때 깊이 첨부가 없으면 출력이 버려진다).
+     *  ② 셰이더 출력 정수 부호(uint4/int4)와 RT 형식(Sint/Uint)이 다름: D3D12 는 비트 그대로 쓴다 → 파이프라인 형식만 같은 폭의
+     *     반대 부호로(Metal 형식 번호: XUint 홀수, XSint = XUint+1 — R8·R16·RG8·R32·RG16·RGBA8·RG32·RGBA16·RGBA32). */
+    for (int retry = 0; !pso && retry < 2 && err; retry++) {
+      std::string why = err.description().getUTF8String();
+      bool changed = false;
+      if (why.find("shader writes to depth") != std::string::npos && info.depth_pixel_format == WMTPixelFormatInvalid) {
+        info.depth_pixel_format = WMTPixelFormatDepth32Float;
+        changed = true;
+      }
+      bool want_uint = why.find("output of type uint") != std::string::npos;
+      bool want_sint = !want_uint && why.find("output of type int") != std::string::npos;
+      if ((want_uint || want_sint) && why.find("is not compatible with a MTLPixelFormat") != std::string::npos) {
+        for (unsigned i = 0; i < 8; i++) {
+          uint32_t f = (uint32_t)info.colors[i].pixel_format;
+          bool pair = f == 13 || f == 14 || f == 23 || f == 24 || f == 33 || f == 34 || f == 53 || f == 54 || f == 63 ||
+                      f == 64 || f == 73 || f == 74 || f == 103 || f == 104 || f == 113 || f == 114 || f == 123 || f == 124;
+          if (!pair)
+            continue;
+          bool is_uint = (f & 1) != 0;
+          if (want_uint && !is_uint) { info.colors[i].pixel_format = (WMTPixelFormat)(f - 1); changed = true; }
+          if (want_sint && is_uint) { info.colors[i].pixel_format = (WMTPixelFormat)(f + 1); changed = true; }
+        }
+      }
+      if (!changed)
+        break;
+      WARN("CreateGraphicsPipelineState: Metal refused PSO (", why, ") — retrying with adjusted attachment formats");
+      if (ember_stagein) { /* 앞 호출이 stage-in 함수를 가져갔다 — 다시 합성 */
+        ember_dxil_reflection again;
+        vs_func = EmberCompileStageIn(pDesc, rsdesc, si_layout, vs_flags, again);
+        info.vertex_function = vs_func.handle;
+      } else
+        EmberMTL_setNextVertexDescriptor(attributes.data(), attributes.size(), layouts, num_layouts); /* 앞 호출이 가져갔다 */
+      err = {};
+      pso = metal.newRenderPipelineState(info, err);
+    }
+    if (!pso) {
+      ERR("CreateGraphicsPipelineState: DXIL PSO failed", ember_stagein ? " (stage-in)" : "", ": ",
+          err ? err.description().getUTF8String() : "(no error)");
+      return E_FAIL;
+    }
+    if (ember_stagein) {
+      static std::atomic<unsigned> n{0};
+      if (n.fetch_add(1) < 4)
+        WARN("CreateGraphicsPipelineState: DXIL PSO with synthesized stage-in (vertex format Metal can't fetch)");
+    }
+    is_dxil = true;
+    dxil_needs_draw_params = vs_refl.needs_draw_params;
+
+    InitializeDSSO(pDesc);
+    InitializeRasterizerState(pDesc);
+    return S_OK;
+  }
+
+  /* Ember: GS 파이프라인 — winemetal EmberDXIL_newGeometryPipeline(호출 156)이 VS·GS·PS 를 GS 에뮬레이션으로 바꾸고
+   * 메시 파이프라인을 만든다. 입력 배치는 IR 형식(IRVersionedInputLayoutDescriptor)으로 넘겨 stage-in 함수를 합성한다. */
+  struct EmberIRInputElement {
+    uint32_t semanticIndex;
+    uint32_t format; /* IRFormat = DXGI_FORMAT */
+    uint32_t inputSlot;
+    uint32_t alignedByteOffset;
+    uint32_t instanceDataStepRate;
+    uint32_t inputSlotClass;
+  };
+  struct EmberIRInputLayout {
+    uint32_t version; /* IRInputLayoutDescriptorVersion_1 */
+    const char *semanticNames[31];
+    EmberIRInputElement elements[31];
+    uint32_t numElements;
+  };
+
+  /* Ember(d12games4): 새 winemetal 의 EmberDXIL_compileStageIn(호출 159) — 옛 winemetal 이면 없다(nullptr) */
+  using EmberStageInFnT = obj_handle_t (*)(struct ember_dxil_stagein *);
+  static EmberStageInFnT
+  EmberStageInFn() {
+    static EmberStageInFnT fn = [] {
+      HMODULE m = GetModuleHandleA("winemetal.dll");
+      return m ? (EmberStageInFnT)(void *)GetProcAddress(m, "EmberDXIL_compileStageIn") : nullptr;
+    }();
+    return fn;
+  }
+
+  WMT::Reference<WMT::Function>
+  EmberCompileStageIn(
+      const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc, const void *rsdesc, const EmberIRInputLayout &layout, uint32_t vs_flags,
+      ember_dxil_reflection &refl
+  ) {
+    memset(&refl, 0, sizeof(refl));
+    ember_dxil_stagein si;
+    memset(&si, 0, sizeof(si));
+    si.device = device_->GetMTLDevice().handle;
+    WMT_MEMPTR_SET(si.vs, pDesc->VS.pShaderBytecode);
+    si.vs_size = pDesc->VS.BytecodeLength;
+    WMT_MEMPTR_SET(si.root_signature, rsdesc);
+    WMT_MEMPTR_SET(si.input_layout, &layout);
+    WMT_MEMPTR_SET(si.reflection, &refl);
+    si.flags = vs_flags;
+    obj_handle_t h = EmberStageInFn()(&si);
+    if (h)
+      ember_gs_vbtable = si.vertex_buffer_table_index;
+    return WMT::Reference<WMT::Function>(h); /* retain 된 것을 넘겨받는다 */
+  }
+
+  HRESULT
+  BuildIRInputLayout(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc, EmberIRInputLayout &layout, uint32_t &slots) {
+    auto metal = device_->GetMTLDevice();
+    memset(&layout, 0, sizeof(layout));
+    layout.version = 1;
+    uint16_t append_offset[32] = {0};
+    slots = 0;
+    for (UINT j = 0; j < pDesc->InputLayout.NumElements && layout.numElements < 31; j++) {
+      auto &desc = pDesc->InputLayout.pInputElementDescs[j];
+      if (desc.InputSlot >= 31)
+        continue;
+      MTL_DXGI_FORMAT_DESC metal_format;
+      uint32_t bytes = 0;
+      if (SUCCEEDED(MTLQueryDXGIFormat(metal, desc.Format, metal_format)))
+        bytes = metal_format.BytesPerTexel;
+      if (!bytes)
+        bytes = desc.Format == DXGI_FORMAT_R10G10B10A2_UINT || desc.Format == DXGI_FORMAT_R10G10B10A2_UNORM ? 4 : 0;
+      if (!bytes)
+        return E_INVALIDARG;
+      auto offset = desc.AlignedByteOffset == D3D12_APPEND_ALIGNED_ELEMENT
+                        ? align(append_offset[desc.InputSlot], std::min(4u, bytes))
+                        : desc.AlignedByteOffset;
+      append_offset[desc.InputSlot] = offset + bytes;
+      auto &e = layout.elements[layout.numElements];
+      layout.semanticNames[layout.numElements] = desc.SemanticName;
+      e.semanticIndex = desc.SemanticIndex;
+      e.format = desc.Format;
+      e.inputSlot = desc.InputSlot;
+      e.alignedByteOffset = offset;
+      e.instanceDataStepRate = desc.InstanceDataStepRate;
+      e.inputSlotClass = desc.InputSlotClass;
+      layout.numElements++;
+      slots |= 1u << desc.InputSlot;
+    }
+    return S_OK;
+  }
+
+
+  HRESULT
+  InitializeDXILGeometry(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    HRESULT hr;
+    auto metal = device_->GetMTLDevice();
+    memset(&ref_vs, 0, sizeof(ref_vs));
+    memset(&ref_ps, 0, sizeof(ref_ps));
+    auto rootsig = static_cast<MTLD3D12RootSignature *>(pDesc->pRootSignature);
+
+    WMTMeshRenderPipelineInfo info;
+    WMT::InitializeMeshRenderPipelineInfo(info);
+    bool dual_source_blending = false;
+    if (FAILED(hr = InitializePSO(pDesc, info, dual_source_blending)))
+      return hr;
+    uint32_t int_rt_mask = 0;
+    for (unsigned i = 0; i < pDesc->NumRenderTargets && i < 8; i++)
+      if (EmberIsIntegerFormat(pDesc->RTVFormats[i]))
+        int_rt_mask |= 1u << i;
+
+    EmberIRInputLayout layout;
+    memset(&layout, 0, sizeof(layout));
+    layout.version = 1;
+    uint16_t append_offset[32] = {0};
+    uint32_t slots = 0;
+    for (UINT j = 0; j < pDesc->InputLayout.NumElements && layout.numElements < 31; j++) {
+      auto &desc = pDesc->InputLayout.pInputElementDescs[j];
+      if (desc.InputSlot >= 31)
+        continue;
+      MTL_DXGI_FORMAT_DESC metal_format;
+      if (FAILED(MTLQueryDXGIFormat(metal, desc.Format, metal_format)) || !metal_format.BytesPerTexel)
+        return E_INVALIDARG;
+      auto offset = desc.AlignedByteOffset == D3D12_APPEND_ALIGNED_ELEMENT
+                        ? align(append_offset[desc.InputSlot], std::min(4u, metal_format.BytesPerTexel))
+                        : desc.AlignedByteOffset;
+      append_offset[desc.InputSlot] = offset + metal_format.BytesPerTexel;
+      auto &e = layout.elements[layout.numElements];
+      layout.semanticNames[layout.numElements] = desc.SemanticName;
+      e.semanticIndex = desc.SemanticIndex;
+      e.format = desc.Format;
+      e.inputSlot = desc.InputSlot;
+      e.alignedByteOffset = offset;
+      e.instanceDataStepRate = desc.InstanceDataStepRate;
+      e.inputSlotClass = desc.InputSlotClass;
+      layout.numElements++;
+      slots |= 1u << desc.InputSlot;
+    }
+
+    ember_dxil_gs_pipeline gp;
+    memset(&gp, 0, sizeof(gp));
+    gp.device = metal.handle;
+    WMT_MEMPTR_SET(gp.vs, pDesc->VS.pShaderBytecode);
+    gp.vs_size = pDesc->VS.BytecodeLength;
+    WMT_MEMPTR_SET(gp.gs, pDesc->GS.pShaderBytecode);
+    gp.gs_size = pDesc->GS.BytecodeLength;
+    WMT_MEMPTR_SET(gp.ps, pDesc->PS.pShaderBytecode);
+    gp.ps_size = pDesc->PS.pShaderBytecode ? pDesc->PS.BytecodeLength : 0;
+    WMT_MEMPTR_SET(gp.root_signature, rootsig ? rootsig->VersionedDesc1_1 : nullptr);
+    WMT_MEMPTR_SET(gp.input_layout, &layout);
+    WMT_MEMPTR_SET(gp.mesh_info, &info);
+    gp.int_rt_mask = int_rt_mask;
+    gp.flags = dual_source_blending ? EMBER_DXIL_DUAL_SOURCE_BLEND : 0;
+    obj_handle_t handle = EmberDXIL_newGeometryPipeline(&gp);
+    if (!handle) {
+      WARN("Ember: GS pipeline emulation failed: ", gp.error);
+      return E_FAIL;
+    }
+    pso = WMT::Reference<WMT::RenderPipelineState>(handle); /* retain 된 것을 넘겨받는다 */
+    is_dxil = true;
+    dxil_needs_draw_params = false;
+    ember_gs = true;
+    ember_gs_vertex_size = gp.gs_vertex_size;
+    ember_gs_max_prims = gp.gs_max_input_prims;
+    ember_gs_vbtable = gp.vertex_buffer_table_index;
+    slot_mask = slots;
+    InitializeDSSO(pDesc);
+    InitializeRasterizerState(pDesc);
+    return S_OK;
+  }
+
+  /* Ember(w3d12): DXIL 테셀레이션(HS+DS, GS 는 있어도 없어도) — winemetal.so 의 EmberFG_call op 40 으로 메시 파이프라인을 만든다.
+   * 옛 winemetal.so(그 op 없음)거나 변환·검사에 실패하면 E_FAIL — 부른 쪽이 그리기 건너뛰기로 물러난다. */
+  HRESULT
+  InitializeDXILTess(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    HRESULT hr;
+    auto metal = device_->GetMTLDevice();
+    memset(&ref_vs, 0, sizeof(ref_vs));
+    memset(&ref_ps, 0, sizeof(ref_ps));
+    auto rootsig = static_cast<MTLD3D12RootSignature *>(pDesc->pRootSignature);
+
+    WMTMeshRenderPipelineInfo info;
+    WMT::InitializeMeshRenderPipelineInfo(info);
+    bool dual_source_blending = false;
+    if (FAILED(hr = InitializePSO(pDesc, info, dual_source_blending)))
+      return hr;
+    uint32_t int_rt_mask = 0;
+    for (unsigned i = 0; i < pDesc->NumRenderTargets && i < 8; i++)
+      if (EmberIsIntegerFormat(pDesc->RTVFormats[i]))
+        int_rt_mask |= 1u << i;
+
+    EmberIRInputLayout layout;
+    memset(&layout, 0, sizeof(layout));
+    layout.version = 1;
+    if (pDesc->PrimitiveTopologyType != D3D12_PRIMITIVE_TOPOLOGY_TYPE_PATCH || pDesc->InputLayout.NumElements > 31)
+      return E_INVALIDARG;
+    uint32_t append_offset[32] = {0};
+    uint32_t slots = 0;
+    for (UINT j = 0; j < pDesc->InputLayout.NumElements && layout.numElements < 31; j++) {
+      auto &desc = pDesc->InputLayout.pInputElementDescs[j];
+      if (desc.InputSlot >= 31)
+        return E_INVALIDARG;
+      MTL_DXGI_FORMAT_DESC metal_format;
+      if (FAILED(MTLQueryDXGIFormat(metal, desc.Format, metal_format)) || !metal_format.BytesPerTexel)
+        return E_INVALIDARG;
+      auto offset = desc.AlignedByteOffset == D3D12_APPEND_ALIGNED_ELEMENT
+                        ? align(append_offset[desc.InputSlot], std::min(4u, metal_format.BytesPerTexel))
+                        : desc.AlignedByteOffset;
+      append_offset[desc.InputSlot] = offset + metal_format.BytesPerTexel;
+      auto &e = layout.elements[layout.numElements];
+      layout.semanticNames[layout.numElements] = desc.SemanticName;
+      e.semanticIndex = desc.SemanticIndex;
+      e.format = desc.Format;
+      e.inputSlot = desc.InputSlot;
+      e.alignedByteOffset = offset;
