+/* Ember 프레임 오버레이: 화면 왼쪽 위에 8x16 비트맵 글꼴로 텍스트를 그린다.
+ * 정점은 vs_present_quad(전체 화면)를 쓰고, 사각형 밖 픽셀은 버린다. */
+struct EmberHudParams {
+  uint origin_x, origin_y;   /* 픽셀 */
+  uint cols, rows;
+  uint scale;                /* 글자 배율 */
+  uint pad0, pad1, pad2;
+  float4 bg;
+  float4 fg;
+};
+[[fragment]] float4 fs_ember_hud(
+    present_data input [[stage_in]],
+    constant EmberHudParams& p [[buffer(0)]],
+    constant uchar* text [[buffer(1)]],
+    constant uchar* font [[buffer(2)]]
+) {
+  int2 pos = int2(input.position.xy) - int2(p.origin_x, p.origin_y);
+  int w = int(p.cols * 8 * p.scale), h = int(p.rows * 16 * p.scale);
+  if (pos.x < 0 || pos.y < 0 || pos.x >= w || pos.y >= h) return float4(0);   /* 알파 0: 블렌딩으로 원본 유지 */
+  uint x = uint(pos.x) / p.scale, y = uint(pos.y) / p.scale;
+  uint col = x / 8, row = y / 16;
+  uint ch = text[row * p.cols + col];
+  if (ch < 32 || ch > 126) return p.bg;
+  uchar bits = font[(ch - 32) * 16 + (y % 16)];
+  bool on = ((bits >> (7 - (x % 8))) & 1) != 0;
+  /* 그림자: 왼쪽 위 이웃 픽셀이 켜져 있으면 어둡게 */
+  bool shadow = false;
+  if (!on && x % 8 > 0 && y % 16 > 0) {
+    uchar b2 = font[(ch - 32) * 16 + (y % 16) - 1];
+    shadow = ((b2 >> (7 - ((x % 8) - 1))) & 1) != 0;
+  }
+  return on ? p.fg : (shadow ? float4(0, 0, 0, 0.9) : p.bg);
+}
+
 constant constexpr float PQ_M1 = 0.1593017578125;
 constant constexpr float PQ_M2 = 78.84375;
 constant constexpr float PQ_C1 = 0.8359375;
@@ -303,6 +337,39 @@ constant bool present_with_hdr_metadata [[function_constant(kPresentFCIndex_With
 constant bool present_backbuffer_is_ms [[function_constant(kPresentFCIndex_BackbufferIsMS)]];
 constant bool present_backbuffer_is_not_ms = !present_backbuffer_is_ms;
 constant bool present_gamma_enabled [[function_constant(kPresentFCIndex_GammaEnabled)]];
+// Ember 프레임 보간: 이전 프레임과 절반씩 섞은 중간 프레임을 만든다.
+constant bool present_blend_previous [[function_constant(kPresentFCIndex_BlendPrevious)]];
+// Ember 선명화: AMD FidelityFX CAS(대비 적응 선명화, MIT) 방식. 주변 대비가 낮은 곳만 세게 — 이미 날카로운 경계는 덜 건드린다.
+constant bool present_sharpen [[function_constant(kPresentFCIndex_Sharpen)]];
+constant float present_sharpness [[function_constant(kPresentFCIndex_Sharpness)]];
+// Ember Auto HDR(EMBER_AUTOHDR_PATCH): 레이어는 RGBA16Float + 확장 선형 sRGB. 이득 지도(1/4 해상도 G 스톱·무릎 k)는 ember_autohdr 패스가 만든다.
+constant bool present_autohdr [[function_constant(kPresentFCIndex_AutoHDR)]];
+
+float4 ember_cas_core(float3 b, float3 d, float3 f, float3 h, float4 e) {
+  float3 mn = min(min(min(d, e.rgb), min(f, b)), h);
+  float3 mx = max(max(max(d, e.rgb), max(f, b)), h);
+  float3 amp = saturate(min(mn, 2.0 - mx) / max(mx, 1e-5));
+  amp = sqrt(amp);
+  float peak = -1.0 / mix(8.0, 5.0, saturate(present_sharpness));
+  float3 w = amp * peak;
+  float3 rgb = (b * w + d * w + f * w + h * w + e.rgb) / (1.0 + 4.0 * w);
+  return float4(max(rgb, 0.0), e.a);
+}
+
+float4 ember_cas_read(texture2d<float, access::sample> t, uint2 p, float4 e) {
+  uint2 lo = uint2(p.x > 0 ? p.x - 1 : 0, p.y > 0 ? p.y - 1 : 0);
+  uint w1 = t.get_width() - 1, h1 = t.get_height() - 1;
+  uint2 hi = uint2(p.x < w1 ? p.x + 1 : w1, p.y < h1 ? p.y + 1 : h1);
+  return ember_cas_core(t.read(uint2(p.x, lo.y)).rgb, t.read(uint2(lo.x, p.y)).rgb,
+                        t.read(uint2(hi.x, p.y)).rgb, t.read(uint2(p.x, hi.y)).rgb, e);
+}
+
+float4 ember_cas_sample(texture2d<float, access::sample> t, float2 uv, float4 e) {
+  constexpr sampler s(coord::normalized);
+  float2 texel = 1.0 / float2(t.get_width(), t.get_height());
+  return ember_cas_core(t.sample(s, uv + float2(0, -texel.y)).rgb, t.sample(s, uv + float2(-texel.x, 0)).rgb,
+                        t.sample(s, uv + float2(texel.x, 0)).rgb, t.sample(s, uv + float2(0, texel.y)).rgb, e);
+}
 
 constexpr sampler s(coord::normalized);
 constexpr sampler gamma_sampler(coord::normalized, filter::linear, address::clamp_to_edge);
@@ -311,8 +378,31 @@ struct DXMTPresentMetadata {
   float edr_scale;
   float max_content_luminance;
   float max_display_luminance;
+  float blend_weight;
+  // Ember Auto HDR: 표시 최대 밝기(SDR 흰색 배수), 세기, 감마 2.2 여부, 픽셀 가중 지수
+  float ahdr_peak;
+  float ahdr_strength;
+  float ahdr_gamma22;
+  float ahdr_wexp;
 };
 
+// Ember Auto HDR: v = SDR 인코딩 값(0..1), gk = 이득 지도(G 스톱, 무릎 k). 하이라이트 픽셀만 T = log2(Y) + s*G*w(vmax),
+// 표시는 1 이하 그대로·위는 기울기 1 로 시작해 peak 로 수렴(C_P). 색상은 유지(RGB 같은 배율), 가장 센 채널이 peak 를 넘지 않게.
+// Tools/autohdr/autohdr.py(expand·display)·ahdr_bench.m 과 같은 식.
+float3 ember_autohdr_apply(float3 v, float2 gk, constant DXMTPresentMetadata &m) {
+  v = clamp(v, 0.0, 1.0);
+  float vmax = max3(v.r, v.g, v.b);
+  float3 l = m.ahdr_gamma22 > 0.5 ? pow(v, 2.2) : select(pow((v + 0.055) / 1.055, 2.4), v / 12.92, v <= 0.04045);
+  float Y = l.r * 0.2126 + l.g * 0.7152 + l.b * 0.0722;
+  float w = pow(saturate((vmax - gk.y) / max(1.0 - gk.y, 1e-3)), m.ahdr_wexp);
+  float u = Y * exp2(m.ahdr_strength * gk.x * w);
+  float pk = max(m.ahdr_peak, 1.0);
+  float Yo = (u <= 1.0 || pk <= 1.001) ? min(u, pk) : 1.0 + (pk - 1.0) * (1.0 - exp(-(u - 1.0) / (pk - 1.0)));
+  float mx = max3(l.r, l.g, l.b);
+  float sc = Y > 1e-6 ? min(Yo / Y, pk / max(mx, 1e-6)) : 1.0;
+  return l * max(sc, 1.0);
+}
+
 float3 to_srgb(float3 linear) {
   return select(1.055 * pow(linear, 1.0 / 2.4) - 0.055, linear * 12.92, linear < 0.0031308); 
 }
@@ -322,6 +412,8 @@ float3 to_srgb(float3 linear) {
     texture2d<float, access::sample> source [[texture(0), function_constant(present_backbuffer_is_not_ms)]],
