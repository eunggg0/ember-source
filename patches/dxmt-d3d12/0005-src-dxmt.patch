+
+void
+Presenter::flushFrameDumps(bool force) {
+  for (auto it = pending_dumps_.begin(); it != pending_dumps_.end();) {
+    // Ember: 8 프레임 뒤면 그 커맨드 버퍼는 GPU 에서 끝났다(드로어블이 3장뿐이라 더 앞서 갈 수 없다)
+    if (!force && frame_no_ < it->frame + 8) { ++it; continue; }
+    char base[64];
+    std::snprintf(base, sizeof(base), "/fg_%06llu", (unsigned long long)it->frame);
+    std::string b = dump_dir_ + base;
+    bool ok = ember_write_ppm(b + "_prev.ppm", it->prev) && ember_write_ppm(b + "_cur.ppm", it->cur) &&
+              ember_write_ppm(b + "_blend.ppm", it->gen_blend);
+    if (ok && it->mc) ok = ember_write_ppm(b + "_mc.ppm", it->gen_mc);
+    if (ok && it->up_gen && it->up_cur)   // Ember: MetalFX 앞 보간 — 키운 보간 프레임·키운 원본
+      ok = ember_write_ppm(b + "_up_gen.ppm", it->up_gen) && ember_write_ppm(b + "_up_cur.ppm", it->up_cur);
+    float conf = -1;
+    if (fg_.ok()) {   // Ember: 마지막 MC 프레임의 평균 신뢰도(엔진 통계)
+      emberfg::Stats st;
+      fg_.stats(emberfg::now_ns(std::chrono::steady_clock::now()), st);
+      conf = (float)st.dump_mean_conf;
+    }
+    if (FILE *f = std::fopen((b + "_meta.txt").c_str(), "w")) {
+      std::fprintf(f, "frame=%llu\nalpha=%.6f\nmc=%d\nmean_conf=%.4f\nwidth=%llu\nheight=%llu\nfmt_cur=%d\nfmt_gen=%d\n",
+                   (unsigned long long)it->frame, it->alpha, (int)it->mc, conf,
+                   (unsigned long long)it->cur.width(), (unsigned long long)it->cur.height(),
+                   (int)it->cur.pixelFormat(), (int)it->gen_blend.pixelFormat());
+      std::fclose(f);
+    }
+    std::fprintf(stderr, "dxmt-fg-dump: %s %s alpha=%.3f mc=%d\n", b.c_str(), ok ? "ok" : "FAILED", it->alpha, (int)it->mc);
+    it = pending_dumps_.erase(it);
+  }
 }
 
