+/* Ember(d12games3) 늦은 드로어블 슬롯 — 큐 스레드가 잡고 페이싱 스레드가 복사를 마친 뒤 돌려준다.
+ * 다 차 있으면(GPU 가 late_slots_ 프레임 뒤처짐) 비워질 때까지 기다린다. 1초 넘게 안 비면 예전 경로(바로 드로어블). */
+bool
+Presenter::acquireLateSlot(int &slot) {
+  const uint64_t w = (uint64_t)layer_props_.drawable_width, h = (uint64_t)layer_props_.drawable_height;
+  const auto fmt = (WMTPixelFormat)ORIGINAL_FORMAT(layer_props_.pixel_format);
+  if (!w || !h || fmt == WMTPixelFormatInvalid) return false;
+  slot = -1;
+  {
+    std::unique_lock<std::mutex> lk(late_mutex_);
+    auto free_slot = [&] {
+      for (int i = 0; i < late_slots_; i++)
+        if (!late_busy_[i]) { slot = i; return true; }
+      return false;
+    };
+    if (!late_cv_.wait_for(lk, std::chrono::seconds(1), free_slot)) return false;
+    late_busy_[slot] = true;
+  }
+  auto &t = late_tex_[slot];
+  if (!t || t.width() != w || t.height() != h || t.pixelFormat() != fmt) {
+    WMTTextureInfo info;
+    info.type = WMTTextureType2D;
+    info.pixel_format = fmt;
+    info.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageRenderTarget);
+    info.options = WMTResourceStorageModePrivate;
+    info.width = w;
+    info.height = h;
+    info.depth = 1;
+    info.mipmap_level_count = 1;
+    info.sample_count = 1;
+    info.array_length = 1;
+    t = device_.newTexture(info);
+    if (!t) { releaseLateSlot(slot); slot = -1; return false; }
+  }
+  ring_tex_[slot] = t.handle;
+  return true;
+}
+
+void
+Presenter::releaseLateSlot(int slot) {
+  {
+    std::lock_guard<std::mutex> lk(late_mutex_);
+    if (slot >= 0 && slot < 3) late_busy_[slot] = false;
+  }
+  late_cv_.notify_all();
+}
+
+void
+Presenter::waitLateIdle() {
+  std::unique_lock<std::mutex> lk(late_mutex_);
+  late_cv_.wait_for(lk, std::chrono::seconds(2), [&] { return !late_busy_[0] && !late_busy_[1] && !late_busy_[2]; });
+}
