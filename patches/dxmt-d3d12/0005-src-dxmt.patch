+  static const EmberD11KeyInfo keys[kEmberD11KeyCount] = {
+      {"EMBER_D11_PROF", 0},
+      {"EMBER_D11_PROF_FRAMES", 300},
+      {"EMBER_D11_PROF_TOP", 30},
+      {"EMBER_D11_BATCH", 1},
+      {"EMBER_D11_CADENCE", 0},
+      {"EMBER_D11_PACE", 1},
+      {"EMBER_D11_PACE_EDGE_US", 2000},
+      {"EMBER_D11_PACE_LOG", 0},
+      {"EMBER_D11_PACE_MID", 1},
+      {"EMBER_D11_PACE_FREE", 0},
+      {"EMBER_D11_CADTRAP", 1},
+      {"EMBER_D11_CADTRAP_HOLD", 120},
+      {"EMBER_D11_DISPALIGN", 1},
+      {"EMBER_D11_PACE_AUTO_OFF", 88},
+      {"EMBER_D11_PACE_AUTO_ON", 75},
+      {"EMBER_FG_PRE_UPSCALE", 1},
+      {"EMBER_D11_LABEL", 0},
+      {"EMBER_D11_OVERLAY_INPASS", 1},
+      {"EMBER_NEURAL_RT", -1},
+      {"EMBER_D11_DUMP", 0},
+      {"EMBER_D11_ROMERGE", 1},
+      {"EMBER_D11_DEADCOPY", 1},
+      {"EMBER_D11_CLEARMERGE", 1},
+      {"EMBER_D11_GENDIRECT", 1},
+      {"EMBER_D11_UPDIRECT", 1},
+      {"EMBER_D11_RINGDRAW", -1},
+      {"EMBER_SPARK", -1},
+  };
+  return keys[k];
+}
+
+struct EmberD11Options {
+  std::atomic<int> v[kEmberD11KeyCount];
+  std::atomic<int64_t> last_reload_ms{0};
+  std::string env[kEmberD11KeyCount];
+
+  static std::string
+  getenv_(const char *name) {
+#ifdef _WIN32
+    char buf[256];
+    DWORD n = GetEnvironmentVariableA(name, buf, sizeof(buf));
+    if (n > 0 && n < sizeof(buf))
+      return std::string(buf, n);
+    return {};
+#else
+    const char *e = std::getenv(name);
+    return e ? e : "";
+#endif
+  }
+
+  static std::string
+  readFile() {
+    std::string out;
+    if (FILE *f = fopen("C:\\ember-d11.cfg", "rb")) {
+      char buf[4096];
+      size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+      buf[n] = 0;
+      out = buf;
+      fclose(f);
+    }
+    return out;
+  }
+
+  static bool
+  lookup(const std::string &file, const char *name, std::string &out) {
+    size_t len = strlen(name), pos = 0;
+    while (pos < file.size()) {
+      size_t eol = file.find_first_of("\r\n", pos);
+      if (eol == std::string::npos)
+        eol = file.size();
+      if (eol - pos > len && file.compare(pos, len, name) == 0 && file[pos + len] == '=') {
+        out = file.substr(pos + len + 1, eol - pos - len - 1);
+        return true;
+      }
+      pos = eol + 1;
+    }
+    return false;
+  }
+
+  void
+  reload() {
+    auto file = readFile();
+    for (unsigned k = 0; k < kEmberD11KeyCount; k++) {
+      std::string s;
+      if (!lookup(file, EmberD11KeyDesc(k).name, s))
+        s = env[k];
+      int value = s.empty() ? EmberD11KeyDesc(k).def : atoi(s.c_str());
+      int old = v[k].exchange(value, std::memory_order_relaxed);
+      if (old != value && last_reload_ms.load(std::memory_order_relaxed) != 0)
+        Logger::info(std::string("ember-d11: ") + EmberD11KeyDesc(k).name + "=" + std::to_string(value));
+    }
+  }
+
+  EmberD11Options() {
+    for (unsigned k = 0; k < kEmberD11KeyCount; k++)
+      env[k] = getenv_(EmberD11KeyDesc(k).name);
+    reload();
+    last_reload_ms = 1;
+  }
+};
+
+inline EmberD11Options &
+EmberD11() {
+  static EmberD11Options opts;
+  return opts;
+}
+
+inline int
+EmberD11Get(EmberD11Key k) {
+  return EmberD11().v[k].load(std::memory_order_relaxed);
+}
+
+/* 약 1초에 한 번만 실제로 파일을 읽는다(아무 스레드에서나 불러도 된다) */
+inline void
+EmberD11MaybeReload() {
+  auto &o = EmberD11();
+  int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now().time_since_epoch()
+  )
+                    .count();
+  int64_t last = o.last_reload_ms.load(std::memory_order_relaxed);
+  if (now - last < 1000)
+    return;
+  if (!o.last_reload_ms.compare_exchange_strong(last, now))
+    return;
+  o.reload();
+}
+
+inline uint64_t
+EmberD11NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+/* 한 Metal 인코더(최적화로 합쳐진 뒤)의 요약 */
+struct EmberD11PassInfo {
+  uint8_t kind = 0; /* EncoderType 값 */
+  uint8_t rts = 0;  /* 실제 붙은 색 첨부 수 */
+  uint8_t load0 = 0, store0 = 0, dload = 0, dstore = 0;
+  uint8_t has_depth = 0;
+  uint16_t merged = 0; /* 합쳐진 D3D11 패스 수(자기 포함) */
+  uint16_t clears = 0; /* 접힌 지우기 수 */
+  uint32_t fmt0 = 0, dfmt = 0;
+  uint32_t w = 0, h = 0, layers = 0;
+  uint32_t draws = 0, dispatches = 0, cmds = 0;
+  uint64_t tex0 = 0, dtex = 0;
+
+  uint64_t
+  key() const {
+    uint64_t h1 = kind * 0x9E3779B97F4A7C15ull;
+    auto mix = [&](uint64_t v) { h1 = (h1 ^ v) * 0x100000001B3ull + (h1 >> 29); };
+    mix(rts);
+    mix(fmt0);
+    mix(dfmt);
+    mix(((uint64_t)w << 32) | h);
+    mix(tex0);
+    mix(dtex);
+    mix((load0 << 24) | (store0 << 16) | (dload << 8) | dstore);
+    return h1;
+  }
+};
+
+/* 같은 대상(색·깊이 첨부가 겹침)을 쓰는 렌더 패스가 둘로 갈린 이유 */
+enum EmberD11Split : unsigned {
+  kSplitBetweenCompute,
+  kSplitBetweenBlit,
+  kSplitBetweenClear,
+  kSplitBetweenResolve,
+  kSplitBetweenOther,
+  kSplitChunk,        /* 명령 버퍼(청크) 경계 — Flush·쿼리·Map 읽기 */
+  kSplitRtCount,
+  kSplitDsvFlags,
+  kSplitArrayLen,
+  kSplitArgbuf,
+  kSplitDepthTarget,
+  kSplitDepthLoadStore,
+  kSplitStencil,
+  kSplitColorTarget,
+  kSplitColorLoadStore,
+  kSplitFenceVertex,  /* 뒤 패스의 정점 단계가 앞 패스 조각 출력을 기다림(렌더 → 정점 읽기) */
+  kSplitUnknown,
+  kSplitCount,
+};
+
+inline const char *
+EmberD11SplitName(unsigned s) {
+  static const char *names[kSplitCount] = {
+      "compute-between", "blit-between", "clear-between", "resolve-between", "other-between", "chunk",
+      "rt-count",        "dsv-flags",    "array-len",     "argbuf",          "depth-target",  "depth-loadstore",
+      "stencil",         "color-target", "color-loadstore", "fence-vertex",  "unknown",
+  };
+  return s < kSplitCount ? names[s] : "?";
+}
+
+/* D3D11 API 쪽(게임 스레드) 사건 */
+enum EmberD11Api : unsigned {
+  kApiUpdateBufBlit,   /* DEFAULT 버퍼 UpdateSubresource → 스테이징 + blit(렌더 패스 끊김) */
+  kApiUpdateBufDyn,    /* 동적 버퍼 UpdateSubresource(=Map) */
+  kApiUpdateTex,
+  kApiCopyBuf,
+  kApiCopyTex,
+  kApiMapDiscard,
+  kApiMapNoOverwrite,
+  kApiMapDynTex,
+  kApiMapStaging,
+  kApiMapStagingWait,  /* 스테이징 Map 이 GPU 를 기다림(CPU 동기화) */
+  kApiClearRTV,
+  kApiClearDSV,
+  kApiClearUAV,
+  kApiDiscardView,
+  kApiGenMips,
+  kApiResolve,
+  kApiFlush,
+  kApiQueryEnd,
+  kApiDraw,
+  kApiDispatch,
+  kApiCopyTexBitcast, /* (loagpu) 다른 형식 텍스처 복사 → 임시 버퍼 경유(복사 2번) */
+  kApiCopyTexDepth,   /* (loagpu) 깊이·스텐실 텍스처 복사 */
+  kApiDeadCopy,       /* (loagpu2) 아무도 안 본 채 다시 덮여 Nop 이 된 복사 */
+  kApiInpassClear,    /* (loagpu2) 합치며 패스 안 그리기로 바꾼 깊이·스텐실 지우기 */
+  kApiCount,
+};
+
+inline const char *
+EmberD11ApiName(unsigned a) {
+  static const char *names[kApiCount] = {
+      "update-buf-blit", "update-buf-dyn", "update-tex", "copy-buf",  "copy-tex",    "map-discard",  "map-nooverwrite",
+      "map-dyntex",      "map-staging",    "map-staging-wait", "clear-rtv", "clear-dsv", "clear-uav", "discard-view",
+      "genmips",         "resolve",        "flush",       "query-end", "draw",        "dispatch",
+      "copy-tex-bitcast", "copy-tex-depth", "dead-copy", "inpass-clear",
+  };
+  return a < kApiCount ? names[a] : "?";
+}
+
+inline void
+EmberD11DumpWrite(const std::string &text) {
+  if (FILE *f = fopen("C:\\ember-d11dump.log", "ab")) {
+    fwrite(text.data(), 1, text.size(), f);
+    fclose(f);
+  }
+}
+
+class EmberD11Profiler {
+public:
+  /* ---- 게임 스레드: API 사건 ---- */
+  void
+  noteApi(unsigned api, uint64_t bytes = 0) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.api[std::min<unsigned>(api, kApiCount - 1)]++;
+    c_.api_bytes[std::min<unsigned>(api, kApiCount - 1)] += bytes;
+  }
+
+  /* ---- 인코딩 스레드 ---- */
+  void
+  notePass(const EmberD11PassInfo &p) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.passes[std::min<unsigned>(p.kind, 15)]++;
+    c_.draws += p.draws;
+    c_.dispatches += p.dispatches;
+    c_.cmds += p.cmds;
+    if (p.kind == 1 /* Render */) {
+      c_.d3d_render += p.merged;
+      c_.clears_folded += p.clears;
+      c_.color_attach += p.rts;
+      if (p.has_depth) {
+        c_.dload[std::min<unsigned>(p.dload, 3)]++;
+        c_.dstore[std::min<unsigned>(p.dstore, 7)]++;
+      }
+    }
+  }
+  void
+  noteColorAction(unsigned load, unsigned store) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.cload[std::min<unsigned>(load, 3)]++;
+    c_.cstore[std::min<unsigned>(store, 7)]++;
+  }
+  void
+  noteSplit(unsigned reason) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.split[std::min<unsigned>(reason, kSplitCount - 1)]++;
+  }
+  void
+  noteChunk(uint64_t prep_ns, uint64_t flush_ns, uint64_t submit_ns) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.chunks++;
+    c_.prep_ns += prep_ns;
+    c_.flush_ns += flush_ns;
+    c_.submit_ns += submit_ns;
+  }
+  /* 인코딩 스레드: Metal 인코더로 옮기는 데 쓴 시간(종류별). 표시(present)는 드로어블 대기를 포함한다 */
+  void
+  noteEncodeCpu(unsigned kind, uint64_t ns, uint32_t encoders) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.enc_ns[std::min<unsigned>(kind, 15)] += ns;
+    c_.enc_n[std::min<unsigned>(kind, 15)] += encoders;
+  }
+  void
+  notePsoWait(uint64_t ns) {
+    std::lock_guard<std::mutex> lk(mu_);
+    c_.pso_wait_ns += ns;
+    if (ns > 2000000)
+      c_.pso_stalls++;
+  }
+
+  /* ---- 게임 스레드 ---- */
+  void
+  noteGameWait(bool frame_latency, uint64_t ns) {
+    std::lock_guard<std::mutex> lk(mu_);
+    (frame_latency ? c_.latency_wait_ns : c_.chunk_wait_ns) += ns;
+  }
+
+  /* ---- 완료 스레드 ---- */
+  void
+  cmdbufDone(uint64_t start, uint64_t end, const EmberD11PassInfo *info) {
+    std::lock_guard<std::mutex> lk(mu_);
+    if (!start || end <= start)
+      return;
+    uint64_t from = std::max(start, last_end_);
+    uint64_t t = end > from ? end - from : 0;
+    last_end_ = std::max(last_end_, end);
+    busy_ns_ += t;
+    if (info) {
+      auto &a = agg_[info->key()];
+      if (!a.count)
+        a.info = *info;
+      a.ns += t;
+      a.count++;
+      a.draws += info->draws + info->dispatches;
+      split_ns_ += t;
+    } else {
+      tail_ns_ += t;
+    }
+  }
+
+  void
+  frameDone() {
+    int window = std::max(1, EmberD11Get(kEmberD11ProfFrames));
+    std::string text;
+    {
+      std::lock_guard<std::mutex> lk(mu_);
+      frames_++;
+      uint64_t now = EmberD11NowNs();
+      if (!since_ns_)
+        since_ns_ = now;
+      if (frames_ < (uint64_t)window)
+        return;
+      text = report(now);
+      reset(now);
+    }
+    emit(text);
+  }
+
+private:
+  struct Counts {
+    uint64_t passes[16] = {};
+    uint64_t d3d_render = 0, clears_folded = 0, color_attach = 0;
+    uint64_t cload[4] = {}, cstore[8] = {}, dload[4] = {}, dstore[8] = {};
+    uint64_t split[kSplitCount] = {};
+    uint64_t draws = 0, dispatches = 0, cmds = 0;
+    uint64_t chunks = 0, prep_ns = 0, flush_ns = 0, submit_ns = 0;
+    uint64_t pso_wait_ns = 0, pso_stalls = 0;
+    uint64_t chunk_wait_ns = 0, latency_wait_ns = 0;
+    uint64_t api[kApiCount] = {}, api_bytes[kApiCount] = {};
+    uint64_t enc_ns[16] = {}, enc_n[16] = {};
+  };
+  struct Agg {
+    EmberD11PassInfo info;
+    uint64_t ns = 0, count = 0, draws = 0;
+  };
+
+  std::mutex mu_;
+  Counts c_;
+  std::unordered_map<uint64_t, Agg> agg_;
+  uint64_t frames_ = 0, since_ns_ = 0, last_end_ = 0, busy_ns_ = 0, split_ns_ = 0, tail_ns_ = 0;
+
+  static const char *
+  kindName(unsigned k) {
+    static const char *n[] = {"null", "render", "compute", "blit", "clear", "resolve", "present", "upscale",
+                              "signal", "tupscale", "wait", "timestamp"};
+    return k < sizeof(n) / sizeof(n[0]) ? n[k] : "?";
+  }
+  static const char *
+  loadName(unsigned a) {
+    static const char *n[] = {"D", "L", "C", "?"}; /* DontCare, Load, Clear */
+    return n[std::min<unsigned>(a, 3)];
+  }
+  static const char *
+  storeName(unsigned a) {
+    static const char *n[] = {"D", "S", "R", "SR", "U", "?", "?", "?"}; /* DontCare, Store, Resolve, Store+Resolve, Unknown */
+    return n[std::min<unsigned>(a, 7)];
+  }
+
+  std::string
+  report(uint64_t now) {
+    double f = (double)frames_;
+    double secs = (now - since_ns_) / 1e9;
+    char line[512];
+    std::string out;
+    snprintf(
+        line, sizeof(line),
+        "ember-d11prof: frames=%llu fps=%.1f gpu_busy=%.2fms/frame (passes %.2f + tail %.2f) chunks=%.2f/frame "
+        "encode prep=%.2fms flush=%.2fms submit=%.2fms pso_wait=%.2fms (stalls %llu) game_wait chunk=%.2fms latency=%.2fms\n",
+        (unsigned long long)frames_, secs > 0 ? f / secs : 0.0, busy_ns_ / 1e6 / f, split_ns_ / 1e6 / f,
+        tail_ns_ / 1e6 / f, c_.chunks / f, c_.prep_ns / 1e6 / f, c_.flush_ns / 1e6 / f, c_.submit_ns / 1e6 / f,
+        c_.pso_wait_ns / 1e6 / f, (unsigned long long)c_.pso_stalls, c_.chunk_wait_ns / 1e6 / f,
+        c_.latency_wait_ns / 1e6 / f
+    );
+    out += line;
+    snprintf(
+        line, sizeof(line),
+        "  per frame: render %.1f (d3d %.1f, clears folded %.1f) compute %.1f blit %.1f clear %.1f resolve %.1f "
+        "present %.2f other %.1f | draws %.0f dispatches %.1f cmds %.0f\n",
+        c_.passes[1] / f, c_.d3d_render / f, c_.clears_folded / f, c_.passes[2] / f, c_.passes[3] / f,
+        c_.passes[4] / f, c_.passes[5] / f, c_.passes[6] / f,
+        (c_.passes[7] + c_.passes[8] + c_.passes[9] + c_.passes[10] + c_.passes[11]) / f, c_.draws / f,
+        c_.dispatches / f, c_.cmds / f
+    );
+    out += line;
+    snprintf(
+        line, sizeof(line),
+        "  color load D/L/C %.1f/%.1f/%.1f store D/S/R/SR %.1f/%.1f/%.1f/%.1f | depth load D/L/C %.1f/%.1f/%.1f "
+        "store D/S %.1f/%.1f\n",
+        c_.cload[0] / f, c_.cload[1] / f, c_.cload[2] / f, c_.cstore[0] / f, c_.cstore[1] / f, c_.cstore[2] / f,
+        c_.cstore[3] / f, c_.dload[0] / f, c_.dload[1] / f, c_.dload[2] / f, c_.dstore[0] / f, c_.dstore[1] / f
+    );
+    out += line;
+    out += "  encode cpu ms/frame:";
+    for (unsigned k = 0; k < 16; k++) {
+      if (!c_.enc_ns[k])
+        continue;
+      snprintf(line, sizeof(line), " %s=%.2f(%.1f)", kindName(k), c_.enc_ns[k] / 1e6 / f, c_.enc_n[k] / f);
+      out += line;
+    }
+    out += "\n";
+    out += "  api/frame:";
+    for (unsigned a = 0; a < kApiCount; a++) {
+      if (!c_.api[a])
+        continue;
+      if (c_.api_bytes[a])
+        snprintf(line, sizeof(line), " %s=%.2f(%.0fKB)", EmberD11ApiName(a), c_.api[a] / f, c_.api_bytes[a] / 1024.0 / f);
+      else
+        snprintf(line, sizeof(line), " %s=%.2f", EmberD11ApiName(a), c_.api[a] / f);
+      out += line;
+    }
+    out += "\n";
+    out += "  same-target splits/frame:";
+    for (unsigned s = 0; s < kSplitCount; s++) {
+      if (!c_.split[s])
+        continue;
+      snprintf(line, sizeof(line), " %s=%.2f", EmberD11SplitName(s), c_.split[s] / f);
+      out += line;
+    }
+    out += "\n";
+    if (!agg_.empty()) {
+      std::vector<const Agg *> v;
+      for (auto &[k, a] : agg_)
+        v.push_back(&a);
+      std::sort(v.begin(), v.end(), [](auto a, auto b) { return a->ns > b->ns; });
+      int top = std::max(1, EmberD11Get(kEmberD11ProfTop));
+      for (int i = 0; i < (int)v.size() && i < top; i++) {
+        auto &a = *v[i];
+        auto &p = a.info;
+        snprintf(
+            line, sizeof(line),
+            "  #%02d %6.3fms/f x%.2f %-7s %4ux%-4u L%u rt=%u fmt0=%u d=%u load=%s%s store=%s%s merged=%u clr=%u "
+            "work=%.0f tex0=%llx dtex=%llx\n",
+            i, a.ns / 1e6 / f, a.count / f, kindName(p.kind), p.w, p.h, p.layers, p.rts, p.fmt0, p.dfmt,
+            p.rts ? loadName(p.load0) : "-", p.has_depth ? loadName(p.dload) : "-", p.rts ? storeName(p.store0) : "-",
+            p.has_depth ? storeName(p.dstore) : "-", p.merged, p.clears, a.count ? (double)a.draws / a.count : 0.0,
+            (unsigned long long)p.tex0, (unsigned long long)p.dtex
+        );
+        out += line;
+      }
+    }
+    return out;
+  }
+
+  void
+  reset(uint64_t now) {
+    c_ = {};
+    agg_.clear();
+    frames_ = 0;
+    since_ns_ = now;
+    busy_ns_ = split_ns_ = tail_ns_ = 0;
+  }
+
+  static void
+  emit(const std::string &text) {
+    Logger::info(text);
+    if (FILE *f = fopen("C:\\ember-d11prof.log", "ab")) {
+      fwrite(text.data(), 1, text.size(), f);
+      fclose(f);
+    }
+  }
+};
+
+} // namespace dxmt
