+    c.cull_mode = WMTCullModeNone;
+    c.depth_clip_mode = WMTDepthClipModeClip;
+    c.winding = WMTWindingClockwise;
+    c.depth_bias = 0;
+    c.scole_scale = 0;
+    c.depth_bias_clamp = 0;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setviewport>();
+    c.type = WMTRenderCommandSetViewport;
+    c.viewport = {0.0, 0.0, (double)r1->render_target_width, (double)r1->render_target_height, 0.0, 1.0};
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setscissorrect>();
+    c.type = WMTRenderCommandSetScissorRect;
+    c.scissor_rect = {0, 0, r1->render_target_width, r1->render_target_height};
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setbytes>();
+    c.type = WMTRenderCommandSetFragmentBytes;
+    float *v = (float *)allocate_cpu_heap(16, 16);
+    v[0] = v[1] = v[2] = v[3] = r1->depth.clear_depth;
+    c.bytes.set(v);
+    c.length = 16;
+    c.index = kCustomBufferArgumentIndex0;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_draw>();
+    c.type = WMTRenderCommandDraw;
+    c.primitive_type = WMTPrimitiveTypeTriangle;
+    c.vertex_start = 0;
+    c.vertex_count = 3;
+    c.base_instance = 0;
+    c.instance_count = 1;
+  }
+  encoder_current = saved;
+  ember_inpass_clears_++;
+  if (ember_prof_level_)
+    queue_.ember_prof.noteApi(kApiInpassClear);
+  return true;
+}
