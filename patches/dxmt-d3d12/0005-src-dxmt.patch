+  }
+  auto follow = pacerQueue.commandBuffer();
+  follow.presentDrawable(item.drawable);
+  follow.commit();
+  item.drawable.release();
+  recordQueueLatency(item.handoff);
+  // 로그(EMBER_D11_PACE_LOG): 1 = 5초 요약, 2 = 프레임마다
+  int log = EmberD11Get(kEmberD11PaceLog);
+  if (!log) { pace_stat_ = {}; return; }
+  auto ms = [](clock::time_point a, clock::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+  pace_stat_.n++;
+  pace_stat_.k_sum += k;
+  pace_stat_.hold_ms += hold * 1000;
+  pace_stat_.max_hold_ms = std::max(pace_stat_.max_hold_ms, hold * 1000);
+  if (item.commit.time_since_epoch().count()) pace_stat_.gpu_ms += ms(item.commit, t_ready);
+  if (log >= 2) {
+    // 시각은 CACurrentMediaTime 영역(초): 게임 Present, GPU 완료, present 호출, 앞 표시 칸(V), 잡은 칸
+    double off = now_u - std::chrono::duration<double>(t_props.time_since_epoch()).count();
+    auto cu = [&](clock::time_point t) { return t.time_since_epoch().count() ? std::chrono::duration<double>(t.time_since_epoch()).count() + off : 0.0; };
+    char line[256];
+    std::snprintf(line, sizeof(line), "F %.6f %.6f %.6f %.6f %.6f k=%d n=%.0f nmin=%.0f per=%.4f\n", cu(item.handoff), cu(t_ready),
+                  cu(t_call), V, pace_last_land_, k, n, n_min, period * 1000);
+    pace_stat_.lines += line;
+  }
+  auto now = clock::now();
+  if (!pace_stat_.since.time_since_epoch().count()) pace_stat_.since = now;
+  if (ms(pace_stat_.since, now) >= 5000) {
+    char line[256];
+    unsigned n_ = std::max(1u, pace_stat_.n);
+    std::snprintf(line, sizeof(line), "ember-d11pace: frames=%u k=%.2f hold=%.2fms(max %.2f) held=%u late=%u no_phase=%u commit->gpu=%.2fms edge=%.0fus hold_ema=%.2f oversleep=%.2fms\n",
+                  pace_stat_.n, (double)pace_stat_.k_sum / n_, pace_stat_.hold_ms / n_, pace_stat_.max_hold_ms, pace_stat_.held,
