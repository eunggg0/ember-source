+    if (pace_free_last_.time_since_epoch().count() && item.handoff > pace_free_last_) {
+      double dt = std::chrono::duration<double>(item.handoff - pace_free_last_).count();
+      if (dt < 0.25) pace_free_ema_ = pace_free_ema_ > 0 ? pace_free_ema_ + (dt - pace_free_ema_) * 0.05 : dt;
+      else { pace_free_ema_ = 0; pace_free_k_ = 0; }
+    }
+    pace_free_last_ = item.handoff;
+    if (period > 0 && pace_free_ema_ > 0) {
+      double r = pace_free_ema_ / period;
+      if (pace_free_k_) {
+        if (std::abs(r - pace_free_k_) > 0.3) { if (++pace_free_hold_ >= 30) { pace_free_k_ = 0; pace_free_hold_ = 0; } }
+        else pace_free_hold_ = 0;
