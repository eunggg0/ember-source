+            double at = target - period * 2 + 0.0005;
+            if (at < now_u) at = 0;
+            follow.presentDrawableAtTime(drawable, at, flags);
+          } else {
+            // CPU 로 (target - 주기 - lead) 까지 잔 뒤 즉시 표시. 비트1 = 즉시 표시, time 은 기대 칸(정렬 통계용)
+            double sleep_s = target - period - lead - now_u;
+            if (sleep_s > 0)
+              std::this_thread::sleep_until(t_call + std::chrono::duration_cast<clock::duration>(std::chrono::duration<double>(sleep_s)));
+            // 실험 EMBER_FG_PHASE_MIN=<ms>: 즉시 표시 대신 afterMinimumDuration(ms) — 표시 파이프라인 차이 확인
+            static const uint64_t min_us = [] { const char *e = std::getenv("EMBER_FG_PHASE_MIN"); return e ? (uint64_t)(std::atof(e) * 1000.0) : 0ull; }();
+            follow.presentDrawableAtTime(drawable, target, flags | 2 | (min_us << 8));
+          }
+          follow.commit();
+          presented = true;
+          t_done = clock::now();
+          if (item.generated) last_gen_present_ = t_done;
+          p.releaseRingSlot(item.slot, !item.generated);
+          if (!item.generated && item.handoff.time_since_epoch().count() && item.commit.time_since_epoch().count()) {
+            auto ms = [](clock::time_point a, clock::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+            lat_enc_ += ms(item.handoff, item.commit);
+            lat_gpu_ += ms(item.commit, t_ready);
+            lat_draw_ += ms(t_ready, t_draw);
+            lat_blit_ += ms(t_draw, t_call);
+            lat_wait_ += wait_ms;
+          }
+          if (!item.generated) recordQueueLatency(item.handoff);
+          return;
+        } else if (item.generated)
+          cb.presentDrawableAfterMinimumDuration(drawable, -1.0);   // -1 = 보간 프레임 표식(지연 측정 제외)
