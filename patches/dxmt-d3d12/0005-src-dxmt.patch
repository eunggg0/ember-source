+    p.layers = r->render_target_array_length;
+    for (unsigned i = 0; i < r->colors.size(); i++) {
+      auto &c = r->colors[i];
+      if (!c.attachment)
+        continue;
+      if (!p.rts) {
+        p.tex0 = c.attachment.texture().handle;
+        p.fmt0 = EmberViewFormat(c.attachment);
+        p.load0 = c.load_action;
+        p.store0 = c.store_action;
+      }
+      p.rts++;
+    }
+    if (r->depth.attachment) {
+      p.has_depth = 1;
+      p.dtex = r->depth.attachment.texture().handle;
+      p.dfmt = EmberViewFormat(r->depth.attachment);
+      p.dload = r->depth.load_action;
+      p.dstore = r->depth.store_action;
+    } else if (r->stencil.attachment) {
+      p.has_depth = 1;
+      p.dtex = r->stencil.attachment.texture().handle;
+      p.dfmt = EmberViewFormat(r->stencil.attachment);
+      p.dload = r->stencil.load_action;
+      p.dstore = r->stencil.store_action;
+    }
+    p.cmds = EmberCountCommands((wmtcmd_base *)r->cmd_head.next.get(), p.draws, true);
+    break;
+  }
+  case EncoderType::Compute: {
+    auto c = static_cast<ComputeEncoderData *>(e);
+    p.cmds = EmberCountCommands((wmtcmd_base *)c->cmd_head.next.get(), p.dispatches, false);
+    break;
+  }
+  case EncoderType::Blit: {
+    auto b = static_cast<BlitEncoderData *>(e);
+    uint32_t dummy = 0;
+    p.cmds = EmberCountCommands((wmtcmd_base *)b->cmd_head.next.get(), dummy, false);
+    p.dispatches = 0;
+    break;
+  }
+  case EncoderType::Clear: {
+    auto c = static_cast<ClearEncoderData *>(e);
+    p.w = c->width;
+    p.h = c->height;
+    p.layers = c->array_length;
+    if (c->clear_dsv) {
+      p.has_depth = 1;
+      p.dtex = c->attachment.texture().handle;
+      p.dfmt = EmberViewFormat(c->attachment);
+      p.dload = WMTLoadActionClear;
+      p.dstore = WMTStoreActionStore;
+    } else {
+      p.rts = 1;
+      p.tex0 = c->attachment.texture().handle;
+      p.fmt0 = EmberViewFormat(c->attachment);
+      p.load0 = WMTLoadActionClear;
+      p.store0 = WMTStoreActionStore;
+    }
+    break;
+  }
+  case EncoderType::Resolve: {
+    auto r = static_cast<ResolveEncoderData *>(e);
+    p.rts = 1;
+    p.tex0 = r->src.texture().handle;
+    p.fmt0 = EmberViewFormat(r->src);
+    p.load0 = WMTLoadActionLoad;
+    p.store0 = WMTStoreActionStoreAndMultisampleResolve;
+    break;
+  }
+  default:
+    break;
+  }
+  return p;
+}
