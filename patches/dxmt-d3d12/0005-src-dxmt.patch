+      : previous.sample(s, input.uv);
+    if (present_sharpen)
+      prev = present_backbuffer_size_matched ? ember_cas_read(previous, uint2(input.position.xy), prev)
+                                             : ember_cas_sample(previous, input.uv, prev);
