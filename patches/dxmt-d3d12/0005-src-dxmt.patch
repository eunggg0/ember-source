+/* ---- Ember(loagpu2): 프레임 덤프·인코더 이름 ---- */
+std::string
+ArgumentEncodingContext::emberTexDesc(Texture *t) {
+  char b[160];
+  snprintf(b, sizeof(b), "fmt=%u %ux%ux%u arr=%u mip=%u s=%u use=%x", (unsigned)t->pixelFormat(), t->width(),
+           t->height(), t->depth(), t->arrayLength(), t->miplevelCount(), t->sampleCount(), (unsigned)t->usage());
+  return b;
+}
+
+void
+ArgumentEncodingContext::emberDumpRead(Texture *texture) {
+  if (!encoder_current || !texture || !texture->current())
+    return;
+  uint64_t h = texture->current()->texture().handle;
+  if (encoder_current->type == EncoderType::Render)
+    static_cast<RenderEncoderData *>(encoder_current)->ember_reads.push_back(h);
+  else if (encoder_current->type == EncoderType::Compute)
+    static_cast<ComputeEncoderData *>(encoder_current)->ember_reads.push_back(h);
+  if (!ember_dump_tex_.count(h))
+    ember_dump_tex_[h] = emberTexDesc(texture);
+}
+
+void
+ArgumentEncodingContext::emberNoteCopy(
+    const char *kind, Texture *src, unsigned src_level, unsigned src_slice, Texture *dst, unsigned dst_level,
+    unsigned dst_slice, WMTOrigin so, WMTSize size, WMTOrigin dto
+) {
+  if (!encoder_current || encoder_current->type != EncoderType::Blit)
+    return;
+  auto b = static_cast<BlitEncoderData *>(encoder_current);
+  Texture *t = src ? src : dst;
+  unsigned bpp = 4;
+  if (t) {
+    switch ((unsigned)t->pixelFormat()) {
+    case WMTPixelFormatRGBA16Float: case WMTPixelFormatRGBA16Unorm: case WMTPixelFormatRG32Float:
+    case WMTPixelFormatDepth32Float_Stencil8: bpp = 8; break;
+    case WMTPixelFormatRGBA32Float: bpp = 16; break;
+    case WMTPixelFormatR16Float: case WMTPixelFormatR16Unorm: case WMTPixelFormatDepth16Unorm: bpp = 2; break;
+    case WMTPixelFormatR8Unorm: bpp = 1; break;
+    default: break;
+    }
+  }
+  if (!b->ember_copies && t) {
+    b->ember_fmt = (uint32_t)t->pixelFormat();
+    b->ember_w = size.width;
+    b->ember_h = size.height;
+  }
+  b->ember_copies++;
+  b->ember_bytes += (uint64_t)size.width * size.height * std::max(1u, (unsigned)size.depth) * bpp;
+  if (!ember_dump_on_)
+    return;
+  uint64_t hs = src && src->current() ? src->current()->texture().handle : 0;
+  uint64_t hd = dst && dst->current() ? dst->current()->texture().handle : 0;
+  if (src && hs && !ember_dump_tex_.count(hs))
+    ember_dump_tex_[hs] = emberTexDesc(src);
+  if (dst && hd && !ember_dump_tex_.count(hd))
+    ember_dump_tex_[hd] = emberTexDesc(dst);
+  char line[256];
+  snprintf(line, sizeof(line), "    copy %s src=%llx[m%u s%u @%u,%u,%u] -> dst=%llx[m%u s%u @%u,%u,%u] size=%ux%ux%u",
+           kind, (unsigned long long)hs, src_level, src_slice, (unsigned)so.x, (unsigned)so.y, (unsigned)so.z,
+           (unsigned long long)hd, dst_level, dst_slice, (unsigned)dto.x, (unsigned)dto.y, (unsigned)dto.z,
+           (unsigned)size.width, (unsigned)size.height, (unsigned)size.depth);
+  ember_dump_copies_.emplace_back(encoder_current, line);
+}
+
+static uint64_t
+EmberBaseHandle(TextureViewRef const &v) {
+  if (!v)
+    return 0;
+  return v->allocation ? v->allocation->texture().handle : v.texture().handle;
+}
+
+void
+ArgumentEncodingContext::emberDumpChunk(EncoderData **encoders, unsigned count) {
+  static const char *kn[] = {"null", "render", "compute", "blit", "clear", "resolve", "present", "upscale",
+                             "signal", "tupscale", "wait", "timestamp"};
+  static const char *ld[] = {"D", "L", "C", "?"};
+  static const char *st[] = {"D", "S", "R", "SR", "U", "?", "?", "?"};
+  std::string out;
+  char line[512];
+  snprintf(line, sizeof(line), "== frame %llu seq %llu encoders %u\n", (unsigned long long)frame_id_,
+           (unsigned long long)seq_id_, count);
+  out += line;
+  for (unsigned i = 0; i < count; i++) {
+    auto e = encoders[i];
+    if (e->type == EncoderType::Null)
+      continue;
+    unsigned k = (unsigned)e->type;
+    snprintf(line, sizeof(line), "#%u %s", i, k < 12 ? kn[k] : "?");
+    out += line;
+    if (e->type == EncoderType::Render) {
+      auto r = static_cast<RenderEncoderData *>(e);
+      uint32_t draws = 0;
+      EmberCountCommands((wmtcmd_base *)r->cmd_head.next.get(), draws, true);
+      snprintf(line, sizeof(line), " %ux%u L%u m=%u clr=%u draws=%u ro=%u pf=%u", r->render_target_width,
+               r->render_target_height, r->render_target_array_length, r->ember_merged, r->ember_clears, draws,
+               r->dsv_readonly_flags, r->dsv_planar_flags);
+      out += line;
+      {
+        /* 그리기 종류·정점 수(인스턴스 곱) — 정점 단계가 무거운 패스 찾기 */
+        uint64_t verts = 0;
+        unsigned n_ind = 0, n_gs = 0, n_ts = 0, n_mesh = 0, n_inst = 0;
+        for (auto c = (wmtcmd_base *)r->cmd_head.next.get(); c; c = (wmtcmd_base *)c->next.get()) {
+          switch (c->type) {
+          case WMTRenderCommandDraw: {
+            auto d = (wmtcmd_render_draw *)c;
+            verts += (uint64_t)d->vertex_count * std::max(1u, (unsigned)d->instance_count);
+            if (d->instance_count > 1) n_inst++;
+            break;
+          }
+          case WMTRenderCommandDrawIndexed: {
+            auto d = (wmtcmd_render_draw_indexed *)c;
+            verts += (uint64_t)d->index_count * std::max(1u, (unsigned)d->instance_count);
+            if (d->instance_count > 1) n_inst++;
+            break;
+          }
+          case WMTRenderCommandDrawIndirect:
+          case WMTRenderCommandDrawIndexedIndirect:
+            n_ind++;
+            break;
+          case WMTRenderCommandDrawMeshThreadgroups:
+          case WMTRenderCommandDrawMeshThreadgroupsIndirect:
+            n_mesh++;
+            break;
+          case WMTRenderCommandDXMTGeometryDraw:
+          case WMTRenderCommandDXMTGeometryDrawIndexed:
+          case WMTRenderCommandDXMTGeometryDrawIndirect:
+          case WMTRenderCommandDXMTGeometryDrawIndexedIndirect:
+            n_gs++;
+            break;
+          case WMTRenderCommandDXMTTessellationMeshDraw:
+          case WMTRenderCommandDXMTTessellationMeshDrawIndexed:
+          case WMTRenderCommandDXMTTessellationMeshDrawIndirect:
+          case WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect:
+            n_ts++;
+            break;
+          default:
+            break;
+          }
+        }
+        snprintf(line, sizeof(line), " verts=%llu inst=%u ind=%u gs=%u ts=%u mesh=%u sd=%u", (unsigned long long)verts,
+                 n_inst, n_ind, n_gs, n_ts, n_mesh, (unsigned)r->ember_samples_ds);
+        out += line;
+      }
+      for (unsigned c = 0; c < 8; c++) {
+        auto &a = r->colors[c];
+        if (!a.attachment)
+          continue;
+        uint64_t h = EmberBaseHandle(a.attachment);
+        auto tex = a.attachment->allocation ? a.attachment->allocation->descriptor : nullptr;
+        if (tex && !ember_dump_tex_.count(h))
+          ember_dump_tex_[h] = emberTexDesc(tex);
+        snprintf(line, sizeof(line), " c%u=%llx:%u:%s%s", c, (unsigned long long)h, EmberViewFormat(a.attachment),
+                 ld[std::min<unsigned>(a.load_action, 3)], st[std::min<unsigned>(a.store_action, 7)]);
+        out += line;
+      }
+      auto &dv = r->depth.attachment ? r->depth.attachment : r->stencil.attachment;
+      if (dv) {
+        uint64_t h = EmberBaseHandle(dv);
+        auto tex = dv->allocation ? dv->allocation->descriptor : nullptr;
+        if (tex && !ember_dump_tex_.count(h))
+          ember_dump_tex_[h] = emberTexDesc(tex);
+        unsigned l = r->depth.attachment ? r->depth.load_action : r->stencil.load_action;
+        unsigned s2 = r->depth.attachment ? r->depth.store_action : r->stencil.store_action;
+        snprintf(line, sizeof(line), " ds=%llx:%u:%s%s", (unsigned long long)h, EmberViewFormat(dv),
+                 ld[std::min<unsigned>(l, 3)], st[std::min<unsigned>(s2, 7)]);
+        out += line;
+        if (r->stencil.attachment && r->depth.attachment)
+          out += std::string("/st:") + ld[std::min<unsigned>(r->stencil.load_action, 3)] +
+                 st[std::min<unsigned>(r->stencil.store_action, 7)];
+      }
+      std::vector<uint64_t> rd = r->ember_reads;
+      std::sort(rd.begin(), rd.end());
+      rd.erase(std::unique(rd.begin(), rd.end()), rd.end());
+      if (!rd.empty()) {
+        out += " reads=";
+        for (auto h : rd) {
+          snprintf(line, sizeof(line), "%llx,", (unsigned long long)h);
+          out += line;
+        }
+      }
+    } else if (e->type == EncoderType::Compute) {
+      auto c = static_cast<ComputeEncoderData *>(e);
+      uint32_t disp = 0;
+      EmberCountCommands((wmtcmd_base *)c->cmd_head.next.get(), disp, false);
+      snprintf(line, sizeof(line), " dispatches=%u", disp);
+      out += line;
+      std::vector<uint64_t> rd = c->ember_reads;
+      std::sort(rd.begin(), rd.end());
+      rd.erase(std::unique(rd.begin(), rd.end()), rd.end());
+      if (!rd.empty()) {
+        out += " reads=";
+        for (auto h : rd) {
+          snprintf(line, sizeof(line), "%llx,", (unsigned long long)h);
+          out += line;
+        }
+      }
+    } else if (e->type == EncoderType::Blit) {
+      auto b = static_cast<BlitEncoderData *>(e);
+      uint32_t dummy = 0;
+      unsigned cmds = EmberCountCommands((wmtcmd_base *)b->cmd_head.next.get(), dummy, false);
+      snprintf(line, sizeof(line), " cmds=%u copies=%u", cmds, b->ember_copies);
+      out += line;
+    } else if (e->type == EncoderType::Clear) {
+      auto c = static_cast<ClearEncoderData *>(e);
+      snprintf(line, sizeof(line), " %llx dsv=%u %ux%u", (unsigned long long)EmberBaseHandle(c->attachment), c->clear_dsv,
+               c->width, c->height);
+      out += line;
+    } else if (e->type == EncoderType::Resolve) {
+      auto r = static_cast<ResolveEncoderData *>(e);
+      snprintf(line, sizeof(line), " %llx -> %llx", (unsigned long long)EmberBaseHandle(r->src),
+               (unsigned long long)EmberBaseHandle(r->dst));
+      out += line;
+    }
+    out += "\n";
+    for (auto &[enc, l] : ember_dump_copies_)
+      if (enc == e) {
+        out += l;
+        out += "\n";
+      }
+  }
+  out += "  textures:\n";
+  for (auto &[h, d] : ember_dump_tex_) {
+    snprintf(line, sizeof(line), "  T %llx %s\n", (unsigned long long)h, d.c_str());
+    out += line;
+  }
+  ember_dump_copies_.clear();
+  ember_dump_tex_.clear();
+  EmberD11DumpWrite(out);
+}
+
+void
+ArgumentEncodingContext::emberLabel(EncoderData *e, WMT::CommandEncoder encoder) {
+  char b[128];
+  if (e->type == EncoderType::Render) {
+    auto r = static_cast<RenderEncoderData *>(e);
+    unsigned f0 = 0, rts = 0;
+    for (auto &c : r->colors)
+      if (c.attachment) {
+        if (!rts)
+          f0 = EmberViewFormat(c.attachment);
+        rts++;
+      }
+    auto &dv = r->depth.attachment ? r->depth.attachment : r->stencil.attachment;
+    snprintf(b, sizeof(b), "R %ux%u c%u:%u d%u ro%u", r->render_target_width, r->render_target_height, rts, f0,
+             dv ? EmberViewFormat(dv) : 0, r->dsv_readonly_flags);
+  } else if (e->type == EncoderType::Blit) {
+    auto bl = static_cast<BlitEncoderData *>(e);
+    if (bl->ember_copies)
+      snprintf(b, sizeof(b), "B n%u f%u %ux%u %lluKB", bl->ember_copies, bl->ember_fmt, bl->ember_w, bl->ember_h,
+               (unsigned long long)(bl->ember_bytes >> 10));
+    else
+      snprintf(b, sizeof(b), "B other");
+  } else if (e->type == EncoderType::Compute) {
+    snprintf(b, sizeof(b), "C game");
+  } else {
+    return;
+  }
+  encoder.setLabel(WMT::String::string(b, WMTUTF8StringEncoding));
+}
