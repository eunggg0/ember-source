+/* Ember 링 표시 — 큐 스레드 쪽. 슬롯·텍스처는 보간 엔진이 관리한다(링이 차면 엔진 안에서 기다린다). */
+bool
+Presenter::acquireRingSlots(bool need_gen, int &gen_slot, int &cur_slot) {
+  emberfg::RingReq req {};
+  req.size = sizeof(req);
+  req.need_generated = need_gen;
+  req.width = (uint64_t)layer_props_.drawable_width;
+  req.height = (uint64_t)layer_props_.drawable_height;
+  req.pixel_format = (uint64_t)ORIGINAL_FORMAT(layer_props_.pixel_format);
+  emberfg::RingSlots slots {};
+  if (!fg_.ringAcquire(req, slots)) return false;
+  gen_slot = slots.gen_slot;
+  cur_slot = slots.cur_slot;
+  if (gen_slot >= 0 && gen_slot < 4) ring_tex_[gen_slot] = slots.gen_texture;
+  if (cur_slot >= 0 && cur_slot < 4) ring_tex_[cur_slot] = slots.cur_texture;
+  return true;
+}
