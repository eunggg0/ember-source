+namespace dxmt {
+void CommandQueue::PacerThread() {
+  env::setThreadName("dxmt-pacer-thread");
+  SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+  for (;;) {
+    ArgumentEncodingContext::PendingPresent item;
+    {
+      std::unique_lock<std::mutex> lk(pacer_mutex_);
+      pacer_cv_.wait(lk, [&] { return pacer_pending_ || !pacer_items_.empty() || pacer_stop_; });
+      if (!pacer_items_.empty()) {
+        // Ember 링 표시 항목 — 멈출 때도 남은 것은 다 내보낸다(슬롯을 잡은 채 기다리는 큐 스레드가 풀리게)
+        PacerItem ring = std::move(pacer_items_.front());
+        pacer_items_.pop_front();
+        lk.unlock();
+        if (ring.direct) pacerDirectItem(ring);
+        else pacerRingItem(ring);
+        continue;
+      }
+      if (!pacer_pending_) break;   // 멈춤
+      item = pacer_item_;
+      // 표시 시각까지 기다리되, 다음 프레임이 오면(pacer_hurry_) 바로
+      pacer_cv_.wait_until(lk, pacer_due_, [&] { return pacer_hurry_ || pacer_stop_; });
+      pacer_hurry_ = false;
+    }
+    auto follow = commandQueue.commandBuffer();
+    follow.presentDrawable(item.deferred);
+    follow.commit();
+    item.deferred.release();
+    {
+      std::lock_guard<std::mutex> lk(pacer_mutex_);
+      last_present_time_ = std::chrono::steady_clock::now();
+      pacer_pending_ = false;
+    }
+    pacer_cv_.notify_all();
+    recordQueueLatency(item.handoff);
+  }
+}
