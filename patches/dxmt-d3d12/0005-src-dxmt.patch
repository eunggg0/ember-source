     constant DXMTPresentMetadata& meta [[buffer(0)]]
 ) {
   float4 output = float4(0);
@@ -335,6 +427,19 @@ float3 to_srgb(float3 linear) {
     output = present_backbuffer_size_matched
       ? source.read(uint2(input.position.xy))
