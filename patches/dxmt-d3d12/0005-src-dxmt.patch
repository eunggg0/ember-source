+/* Ember(cadence): 표시 박자 고정. 게임이 자체 상한(예: 60)으로 vsync Present 하면 최소 표시 간격이 한 칸(1/120)이라
+ * 게임 간격의 흔들림(14~19ms)이 그대로 1·2·3칸 표시로 번져 카메라를 돌릴 때 끊겨 보였다(Once Human, 120Hz, p99 29ms).
+ * Present 간격 EMA 가 화면 주기의 정수배 k(2~4)에 가까우면(±12%) 최소 간격을 k칸으로 건다 — 일찍 온 프레임은 k칸째까지 기다리고,
+ * 게임 스레드는 드로어블 대기열(2~3장)로 박자에 맞춰진다. EMA 가 k 에서 0.3칸 넘게 벗어난 상태가 30프레임 이어지면 푼다.
+ * 갇힘 탈출(cadtrap, 10-03): 박자를 건 뒤엔 게임이 그 박자에 막혀 Present 간격 EMA 가 계속 k 로 보인다 — 게임이 더 빨라져도
+ * 위 조건으로는 영영 못 푼다(원스휴먼 월드 입장 직후 k=4·30fps 에 70초, 그동안 페이서 hold 15~28ms = 2~3칸). 그래서 페이서가
+ * GPU 완료 뒤 붙잡은 시간 EMA(칸 단위, 박자에 딱 맞는 게임은 0~0.6칸)가 CADTRAP_HOLD(기본 1.2칸)를 30프레임 넘게 넘으면
+ * 박자를 풀고 Present 간격 EMA 를 새로 배우며 90프레임 동안 다시 걸지 않는다. 진짜 그 박자인 게임이면 90프레임 뒤 다시 걸린다.
+ * PACE=0(예전 최소 간격 표시)이면 붙잡은 시간을 알 수 없어 박자 고정도 쓰지 않는다.
+ * (Ember 고유 페이싱 — 나중에 EmberCore 로 옮길 후보) */
+bool
+ArgumentEncodingContext::emberPaceOn() {
+  int v = EmberD11Get(kEmberD11Pace);
+  if (v == 2)
+    return queue_.ember_pace_auto_on_.load(std::memory_order_relaxed) != 0;
+  return v != 0;
+}
+
+double
+ArgumentEncodingContext::emberCadence(PresentData *data) {
+  double period = data->after;
+  if (!EmberD11Get(kEmberD11Cadence) || !emberPaceOn() || period <= 0 || data->pace >= 0) {
+    ember_cad_k_ = 0;
+    ember_cad_ema_ = 0;
+    ember_cad_last_ = {};
+    ember_cad_trap_ = 0;
+    return period;
+  }
+  auto now = data->handoff;
+  if (ember_cad_last_.time_since_epoch().count() && now > ember_cad_last_) {
+    double dt = std::chrono::duration<double>(now - ember_cad_last_).count();
+    if (dt < 0.25) {
+      ember_cad_ema_ = ember_cad_ema_ > 0 ? ember_cad_ema_ + (dt - ember_cad_ema_) * 0.05 : dt;
+    } else {
+      ember_cad_ema_ = 0; /* 멈췄다 다시 — 처음부터 */
+      ember_cad_k_ = 0;
+    }
+  }
+  ember_cad_last_ = now;
+  if (ember_cad_cool_ > 0)
+    ember_cad_cool_--;
+  if (ember_cad_k_ && EmberD11Get(kEmberD11CadTrap)) {
+    float hold = queue_.ember_pace_hold_slots_.load(std::memory_order_relaxed);
+    if (hold * 100.0f > (float)EmberD11Get(kEmberD11CadTrapHold)) {
+      if (++ember_cad_trap_ >= 30) {
+        ember_cad_escapes_++;
+        char msg[160];
+        std::snprintf(msg, sizeof(msg), "ember-d11: cadence k=%d trapped (pacer hold %.2f slots) - released, relearning (escape #%u)",
+                      ember_cad_k_, hold, ember_cad_escapes_);
+        Logger::info(msg);
+        ember_cad_k_ = 0;
+        ember_cad_hold_ = 0;
+        ember_cad_trap_ = 0;
+        ember_cad_ema_ = 0;
+        ember_cad_last_ = {};
+        ember_cad_cool_ = 90;
+        queue_.ember_pace_hold_slots_.store(0, std::memory_order_relaxed);
+        return period;
+      }
+    } else
+      ember_cad_trap_ = 0;
+  } else
+    ember_cad_trap_ = 0;
+  if (ember_cad_ema_ <= 0)
+    return period;
+  double r = ember_cad_ema_ / period;
+  if (ember_cad_k_) {
+    if (std::abs(r - ember_cad_k_) > 0.3) {
+      if (++ember_cad_hold_ >= 30) {
+        ember_cad_k_ = 0;
+        ember_cad_hold_ = 0;
+      }
+    } else
+      ember_cad_hold_ = 0;
+  } else {
+    int k = (int)std::lround(r);
+    if (ember_cad_cool_ <= 0 && k >= 2 && k <= 4 && std::abs(r - k) < 0.12) {
+      ember_cad_k_ = k;
+      ember_cad_hold_ = 0;
+      ember_cad_trap_ = 0;
+    }
+  }
+  return ember_cad_k_ ? period * ember_cad_k_ : period;
+}
