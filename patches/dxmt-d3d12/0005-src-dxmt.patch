new file mode 100644
index 0000000..b2afd67
--- /dev/null
+++ b/src/dxmt/ember_spark.hpp
@@ -0,0 +1,85 @@
+/*
+ * Ember Spark hook (kiln 10-08): PE side. Forwards Present / GPU-completion events to the optional libEmberSpark.dylib
+ * (EmberCore, separate proprietary library, not part of this tree) through winemetal's EmberFG_call (ops 24..28, unix side
+ * ember_fg_unix.c). Spark itself decides how long Present holds; the sleep runs on the unix side. Without the library, with an
+ * older winemetal, with EMBER_SPARK off, or while Ember Flow is on, nothing is called and Present behaves as before.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+#include "dxmt_ember_d11.hpp"
+#include "../winemetal/ember_fg_thunks.h"
+#include <atomic>
+#include <cstring>
+#include <windows.h>
+
+namespace dxmt::emberspark {
+
+using call_fn = int32_t (*)(unixcall_ember_fg *);
+
+inline call_fn
+resolve() {
+  static call_fn fn = [] {
+    HMODULE wm = GetModuleHandleA("winemetal.dll");
+    return wm ? (call_fn)(void *)GetProcAddress(wm, "EmberFG_call") : nullptr;
+  }();
+  return fn;
+}
+
+inline int32_t
+call(uint32_t op, int64_t arg0 = 0, uint64_t arg1 = 0, int64_t arg_i64 = 0, double arg_f64 = 0) {
+  auto fn = resolve();
+  if (!fn) return 0;
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = op;
+  p.arg0 = arg0;
+  p.arg1 = arg1;
+  p.arg_i64 = arg_i64;
+  p.arg_f64 = arg_f64;
+  return fn(&p);
+}
+
+/* on/off, asked again whenever the C:\ember-d11.cfg override changes (EmberD11 reloads about once a second) */
+inline std::atomic<int> &
+state() { static std::atomic<int> s{-2}; return s; }   /* -2 unknown, 0 off, 1 on */
+
+inline bool
+active(bool frame_generation) {
+  static std::atomic<int> last_override{-100};
+  int ov = EmberD11Get(kEmberD11Spark);
+  if (ov != last_override.load(std::memory_order_relaxed)) {
+    last_override.store(ov, std::memory_order_relaxed);
+    state().store(call(EMBER_FG_OP_SPARK_STATE, ov) ? 1 : 0, std::memory_order_relaxed);
+  }
+  return !frame_generation && state().load(std::memory_order_relaxed) == 1;
+}
+
+/* the finish / commit threads only report while Present is driving Spark */
+inline std::atomic<bool> &
+driving() { static std::atomic<bool> d{false}; return d; }
+
+inline void enter(uint64_t frame, double period) { driving().store(true, std::memory_order_relaxed); call(EMBER_FG_OP_SPARK_ENTER, 0, frame, 0, period); }
+inline void exit(uint64_t frame) { call(EMBER_FG_OP_SPARK_EXIT, 0, frame); }
+inline void stop() { driving().store(false, std::memory_order_relaxed); }
+inline void gpu_done(uint64_t frame, uint64_t start_ns, uint64_t end_ns, double busy_s) {
+  if (driving().load(std::memory_order_relaxed)) call(EMBER_FG_OP_SPARK_GPU, (int64_t)end_ns, frame, (int64_t)start_ns, busy_s);
+}
+inline void slot(uint32_t kind, uint64_t frame, double t_minus_now) {
+  if (driving().load(std::memory_order_relaxed)) call(EMBER_FG_OP_SPARK_SLOT, kind, frame, 0, t_minus_now);
+}
+
+/* spark2: direct-pacer sequence → frame id (commit thread writes, pacer thread reads; no class layout change) */
+inline std::atomic<uint64_t> *
+seq_map() { static std::atomic<uint64_t> m[64]; return m; }
+inline void seq_frame(uint64_t seq, uint64_t frame) {
+  if (driving().load(std::memory_order_relaxed) && frame != ~0ull) seq_map()[seq % 64].store((frame << 8) | (seq & 0xff), std::memory_order_release);
+}
+inline uint64_t frame_of_seq(uint64_t seq) {
+  uint64_t v = seq_map()[seq % 64].load(std::memory_order_acquire);
+  return v && (v & 0xff) == (seq & 0xff) ? v >> 8 : 0;
+}
+
+} // namespace dxmt::emberspark
