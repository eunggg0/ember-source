+  const double V = lp.ember_vsync_time;
+  const double edge = EmberD11Get(kEmberD11PaceEdge) * 1e-6;
+  const double guard = 0.0004;
+  int k = 1;
+  double call_at = now_u, n = 0, n_min = 0;
