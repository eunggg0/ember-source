+      if (n < n_min) n = n_min;
+      else if (n > n_min) pace_stat_.late++;   // 앞 프레임 칸 + k 를 놓쳤다(게임·GPU 가 늦음)
+    }
+    // 이 칸으로 가는 구간의 시작(+guard), 기본은 구간 가운데 — 구간 안 어디서 불러도 같은 칸이라 지연은 같고 경계 오차에 강하다
+    double open = V + (n - 1) * period - edge + (EmberD11Get(kEmberD11PaceMid) ? period * 0.5 : guard);
+    call_at = std::max(now_u, open);
+    pace_last_land_ = V + n * period;
+    // spark2(10-08): 이 프레임이 뜰 칸(LANDED) — Spark 가 늦음이 화면 칸을 실제로 밀었는지 본다(밀었을 때만 늦음으로 센다)
+    if (item.seq && emberspark::driving().load(std::memory_order_relaxed)) {
+      uint64_t fr = emberspark::frame_of_seq(item.seq);
+      if (fr) {
+        double now_ca = now_u + std::chrono::duration<double>(clock::now() - t_props).count();
+        emberspark::slot(5 /* EMBER_SPARK_SLOT_LANDED */, fr, pace_last_land_ - now_ca);
+      }
+    }
+  } else {
+    pace_last_land_ = 0;
+    pace_stat_.no_phase++;
+  }
+  double hold = call_at - now_u;
+  // Ember(cadtrap): 붙잡은 시간 EMA(칸) — 박자 갇힘 판단용(emberCadence·아래 PACE_FREE)
+  if (period > 0) {
+    float hs = (float)(std::max(0.0, hold) / period);
+    float e = ember_pace_hold_slots_.load(std::memory_order_relaxed);
+    e += (hs - e) * 0.1f;
+    ember_pace_hold_slots_.store(e, std::memory_order_relaxed);
+    if (free_run && pace_free_k_ && EmberD11Get(kEmberD11CadTrap)) {
+      if (e * 100.0f > (float)EmberD11Get(kEmberD11CadTrapHold)) {
+        if (++pace_free_trap_ >= 30) {
+          char msg[128];
+          std::snprintf(msg, sizeof(msg), "ember-d11pace: free cadence k=%d trapped (hold %.2f slots) - released", pace_free_k_, e);
+          Logger::info(msg);
+          pace_free_k_ = 0;
+          pace_free_hold_ = 0;
+          pace_free_trap_ = 0;
+          pace_free_ema_ = 0;
+          pace_free_last_ = {};
+          pace_free_cool_ = 90;
+          ember_pace_hold_slots_.store(0, std::memory_order_relaxed);
+        }
+      } else
