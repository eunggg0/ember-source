   void
   STDMETHODCALLTYPE
   SwapDeviceContextState(ID3DDeviceContextState *pState, ID3DDeviceContextState **ppPreviousState) override {
-    UNIMPLEMENTED("SwapDeviceContextState");
+    /* Ember: 원래 UNIMPLEMENTED → abort. Wine d2d1(Direct2D)이 그릴 때마다 자기 상태로 바꿨다가 되돌린다 —
+     * DXMT 위에서 D2D 로 글자·UI 를 그리는 프로그램이 전부 죽었다. 지금 상태를 새 상태 객체에 담아 돌려주고,
+     * 받은 객체의 상태를 공개 Set* 메서드로 다시 입힌다(인코더 쪽 바인딩까지 정상 경로로 만들어지게). */
+    if (ppPreviousState)
+      *ppPreviousState = nullptr;
+    auto next = static_cast<MTLD3D11DeviceContextState *>(pState);
+    if (!next)
+      return;
+    /* 상태 구조체는 복사가 안 되고 옮기기만 된다. 지금 상태는 돌려줄 객체로 옮기고, 들어올 상태는 참조로 입힌다
+     * (d2d 는 자기 상태 객체를 매번 다시 쓰고 그릴 때 필요한 상태를 모두 다시 설정한다). */
+    Com<MTLD3D11DeviceContextState> prev = new MTLD3D11DeviceContextState(device);
+    {
+      std::lock_guard<mutex_t> lock(mutex);
+      prev->saved = std::move(state_);
+      state_ = {};
+    }
+    ClearState();
+    EmberApplyState(next->saved);
+    if (ppPreviousState)
+      *ppPreviousState = prev.ref();
+  }
+
+  static void *EmberQI(IUnknown *u, REFIID iid) {
+    void *p = nullptr;
+    if (u && SUCCEEDED(u->QueryInterface(iid, &p)) && p)
+      static_cast<IUnknown *>(p)->Release(); /* 상태 구조체가 참조를 쥐고 있다 */
+    return p;
+  }
+
+  void EmberApplyState(const D3D11ContextState &s) {
+    auto &ia = s.InputAssembler;
+    IASetInputLayout((ID3D11InputLayout *)EmberQI(ia.InputLayout.ptr(), __uuidof(ID3D11InputLayout)));
+    IASetPrimitiveTopology(ia.Topology);
+    if (ia.IndexBuffer)
+      IASetIndexBuffer((ID3D11Buffer *)EmberQI(ia.IndexBuffer.ptr(), __uuidof(ID3D11Buffer)), ia.IndexBufferFormat, ia.IndexBufferOffset);
+    for (unsigned slot = 0; slot < D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT; slot++) {   /* compat2: upstream 830eb41 이 16→32 */
+      if (!ia.VertexBuffers.test_bound(slot)) continue;
+      auto &e = const_cast<std::remove_cvref_t<decltype(ia.VertexBuffers)> &>(ia.VertexBuffers)[slot];
+      ID3D11Buffer *b = (ID3D11Buffer *)EmberQI(e.RawPointer, __uuidof(ID3D11Buffer));
+      UINT stride = e.Stride, offset = e.Offset;
+      IASetVertexBuffers(slot, 1, &b, &stride, &offset);
+    }
+    for (unsigned st = 0; st < 6; st++) {
+      auto &ss = s.ShaderStages[(PipelineStage)st];
+      static const IID *shader_iid[6] = {&__uuidof(ID3D11VertexShader), &__uuidof(ID3D11PixelShader), &__uuidof(ID3D11GeometryShader),
+                                         &__uuidof(ID3D11HullShader), &__uuidof(ID3D11DomainShader), &__uuidof(ID3D11ComputeShader)};
+      void *sh = EmberQI(ss.Shader.ptr(), *shader_iid[st]);
+      switch ((PipelineStage)st) {
+      case PipelineStage::Vertex: VSSetShader((ID3D11VertexShader *)sh, nullptr, 0); break;
+      case PipelineStage::Pixel: PSSetShader((ID3D11PixelShader *)sh, nullptr, 0); break;
+      case PipelineStage::Geometry: GSSetShader((ID3D11GeometryShader *)sh, nullptr, 0); break;
+      case PipelineStage::Hull: HSSetShader((ID3D11HullShader *)sh, nullptr, 0); break;
+      case PipelineStage::Domain: DSSetShader((ID3D11DomainShader *)sh, nullptr, 0); break;
+      case PipelineStage::Compute: CSSetShader((ID3D11ComputeShader *)sh, nullptr, 0); break;
+      }
+      for (unsigned slot = 0; slot < 128; slot++) {
+        if (!ss.SRVs.test_bound(slot)) continue;
+        ID3D11ShaderResourceView *v = (ID3D11ShaderResourceView *)EmberQI(const_cast<SRVBindingSet &>(ss.SRVs)[slot].RawPointer, __uuidof(ID3D11ShaderResourceView));
+        switch ((PipelineStage)st) {
+        case PipelineStage::Vertex: VSSetShaderResources(slot, 1, &v); break;
+        case PipelineStage::Pixel: PSSetShaderResources(slot, 1, &v); break;
+        case PipelineStage::Geometry: GSSetShaderResources(slot, 1, &v); break;
+        case PipelineStage::Hull: HSSetShaderResources(slot, 1, &v); break;
+        case PipelineStage::Domain: DSSetShaderResources(slot, 1, &v); break;
+        case PipelineStage::Compute: CSSetShaderResources(slot, 1, &v); break;
+        }
+      }
+      for (unsigned slot = 0; slot < 16; slot++) {
+        if (!ss.Samplers.test_bound(slot)) continue;
+        ID3D11SamplerState *v = (ID3D11SamplerState *)EmberQI(const_cast<SamplerBindingSet &>(ss.Samplers)[slot].RawPointer, __uuidof(ID3D11SamplerState));
+        switch ((PipelineStage)st) {
+        case PipelineStage::Vertex: VSSetSamplers(slot, 1, &v); break;
+        case PipelineStage::Pixel: PSSetSamplers(slot, 1, &v); break;
+        case PipelineStage::Geometry: GSSetSamplers(slot, 1, &v); break;
+        case PipelineStage::Hull: HSSetSamplers(slot, 1, &v); break;
+        case PipelineStage::Domain: DSSetSamplers(slot, 1, &v); break;
+        case PipelineStage::Compute: CSSetSamplers(slot, 1, &v); break;
+        }
+      }
+      for (unsigned slot = 0; slot < 14; slot++) {
+        if (!ss.ConstantBuffers.test_bound(slot)) continue;
+        auto &e = const_cast<ConstantBufferBindingSet &>(ss.ConstantBuffers)[slot];
+        ID3D11Buffer *b = (ID3D11Buffer *)EmberQI(e.RawPointer, __uuidof(ID3D11Buffer));
+        UINT first = e.FirstConstant, num = e.NumConstants;
+        switch ((PipelineStage)st) {
+        case PipelineStage::Vertex: VSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        case PipelineStage::Pixel: PSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        case PipelineStage::Geometry: GSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        case PipelineStage::Hull: HSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        case PipelineStage::Domain: DSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        case PipelineStage::Compute: CSSetConstantBuffers1(slot, 1, &b, &first, &num); break;
+        }
+      }
+    }
+    auto &om = s.OutputMerger;
+    ID3D11RenderTargetView *rtvs[D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT] = {};
+    for (unsigned i = 0; i < om.NumRTVs && i < D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT; i++)
+      rtvs[i] = (ID3D11RenderTargetView *)EmberQI(om.RTVs[i].ptr(), __uuidof(ID3D11RenderTargetView));
+    ID3D11DepthStencilView *dsv = (ID3D11DepthStencilView *)EmberQI(om.DSV.ptr(), __uuidof(ID3D11DepthStencilView));
+    OMSetRenderTargets(om.NumRTVs, rtvs, dsv);
+    for (unsigned slot = 0; slot < D3D11_1_UAV_SLOT_COUNT; slot++) {
+      if (!om.UAVs.test_bound(slot)) continue;
+      ID3D11UnorderedAccessView *u = (ID3D11UnorderedAccessView *)EmberQI(const_cast<UAVBindingSet &>(om.UAVs)[slot].RawPointer, __uuidof(ID3D11UnorderedAccessView));
+      OMSetRenderTargetsAndUnorderedAccessViews(D3D11_KEEP_RENDER_TARGETS_AND_DEPTH_STENCIL, nullptr, nullptr, slot, 1, &u, nullptr);
+    }
+    OMSetBlendState((ID3D11BlendState *)EmberQI(om.BlendState, __uuidof(ID3D11BlendState)), om.BlendFactor, om.SampleMask);
+    OMSetDepthStencilState((ID3D11DepthStencilState *)EmberQI(om.DepthStencilState, __uuidof(ID3D11DepthStencilState)), om.StencilRef);
+    auto &rs = s.Rasterizer;
+    RSSetState((ID3D11RasterizerState *)EmberQI(rs.RasterizerState, __uuidof(ID3D11RasterizerState)));
+    if (rs.NumViewports) RSSetViewports(rs.NumViewports, rs.viewports);
+    if (rs.NumScissorRects) RSSetScissorRects(rs.NumScissorRects, rs.scissor_rects);
+    for (unsigned slot = 0; slot < D3D11_1_UAV_SLOT_COUNT; slot++) {
+      if (!s.ComputeStageUAV.UAVs.test_bound(slot)) continue;
+      ID3D11UnorderedAccessView *u = (ID3D11UnorderedAccessView *)EmberQI(const_cast<UAVBindingSet &>(s.ComputeStageUAV.UAVs)[slot].RawPointer, __uuidof(ID3D11UnorderedAccessView));
