diff --git a/src/winemetal/ember_fg_thunks.h b/src/winemetal/ember_fg_thunks.h
new file mode 100644
index 0000000..b248d6a
--- /dev/null
+++ b/src/winemetal/ember_fg_thunks.h
@@ -0,0 +1,82 @@
+/*
+ * Ember FG hook: winemetal PE ↔ unix bridge to the optional libEmberFG.dylib (EmberCore, separate library).
+ * This file only forwards calls; the frame generation engine itself is not part of this tree.
+ * One unix call (EMBER_FG_UNIX_CALL) carries every operation, selected by `op`.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifndef __EMBER_FG_THUNKS_H
+#define __EMBER_FG_THUNKS_H
+
+#include "winemetal.h"
+
+#define EMBER_FG_UNIX_CALL 157
+
+enum ember_fg_op {
+  EMBER_FG_OP_VERSION = 0,     /* ret = library ABI version, 0 = library missing */
+  EMBER_FG_OP_CREATE = 1,      /* device, in = env block → ctx, out = config */
+  EMBER_FG_OP_DESTROY = 2,
+  EMBER_FG_OP_CONFIG = 3,      /* out = config */
+  EMBER_FG_OP_BEGIN = 4,       /* in = frame_in, out = frame_plan */
+  EMBER_FG_OP_ENCODE = 5,      /* in = encode_in, out = encode_out */
+  EMBER_FG_OP_RING_ACQUIRE = 6,/* in = ring_req, out = ring_slots */
+  EMBER_FG_OP_RING_RELEASE = 7,/* arg0 = slot, arg1 = frame_done */
+  EMBER_FG_OP_RING_IDLE = 8,
+  EMBER_FG_OP_NOTE_DROP = 9,   /* arg0 = kind */
+  EMBER_FG_OP_STATS = 10,      /* arg_i64 = now, out = stats */
+  EMBER_FG_OP_HUD = 11,        /* arg_i64 = now, arg_f64 = game fps, arg1 = generated frames, out = text */
+  EMBER_FG_OP_DRAIN_LOG = 12,
+  /* Ember in-game HUD (optional libEmberHUD.dylib next to winemetal.so). Independent of frame generation: these ops work
+   * without libEmberFG. ctx = HUD context (not an FG context). */
+  EMBER_FG_OP_HUD_CREATE = 13, /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_HUD_ENCODE = 14, /* in = ember_hud_encode_in, out = ember_hud_encode_out, ret = panels drawn */
+  EMBER_FG_OP_HUD_DESTROY = 15,
+  /* Ember Tone / Ember Flare (optional libEmberTone.dylib next to winemetal.so, EmberCore). Independent of frame generation.
+   * ctx = Tone or Flare context. in/out structs: EmberCore/tone/include/ember_tone.h (mirrored in src/dxmt/ember_neural.hpp). */
+  EMBER_FG_OP_TONE_NEURAL_CREATE = 16,  /* device, in = env block → ctx, ret = 1 */
+  EMBER_FG_OP_TONE_NEURAL_ENCODE = 17,  /* in = ember_tone_neural_in, out = ember_tone_neural_out, ret = processed */
+  EMBER_FG_OP_TONE_NEURAL_DESTROY = 18,
+  EMBER_FG_OP_TONE_AHDR_CREATE = 19,    /* device, in = env block → ctx, out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_ENCODE = 20,    /* in = ember_tone_ahdr_encode_in, out = ember_tone_ahdr_encode_out, ret = ok */
+  EMBER_FG_OP_TONE_AHDR_FRAME = 21,     /* in = ember_tone_ahdr_frame_in, out = ember_tone_ahdr_frame_out, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_CONFIG = 22,    /* out = ember_tone_ahdr_config, ret = 1 */
+  EMBER_FG_OP_TONE_AHDR_DESTROY = 23,
+  /* Ember Spark (optional libEmberSpark.dylib next to winemetal.so, EmberCore, kiln 10-08): delays the return from Present so the
+   * game's next frame starts just in time. One instance per process, no ctx. Times are taken on the unix side
+   * (mach_absolute_time seconds, the MTLCommandBuffer GPU time domain); the PE side passes none.
+   * Off unless the unix environment has EMBER_SPARK=1 (arg0 = 1 forces on, 0 forces off, -1 follows it — C:\ember-d11.cfg). */
+  EMBER_FG_OP_SPARK_STATE = 24,   /* arg0 = override → ret = 1 if Spark is on */
+  EMBER_FG_OP_SPARK_ENTER = 25,   /* arg1 = frame id, arg_f64 = period (s, 0 = uncapped) */
+  EMBER_FG_OP_SPARK_EXIT = 26,    /* arg1 = frame id → sleeps on the unix side, ret = slept µs */
+  EMBER_FG_OP_SPARK_GPU = 27,     /* arg1 = frame id, arg_i64 = GPU start ns, arg0 = GPU end ns, arg_f64 = GPU busy s */
+  EMBER_FG_OP_SPARK_SLOT = 28,    /* arg0 = kind (1 submit, 2 display), arg1 = frame id, arg_f64 = slot time − now (s) */
+  /* Ember(w3d12): DXIL 테셀레이션 파이프라인 — out = struct ember_dxil_tess_pipeline(ember_dxil_thunks.h) → ret 1 성공 */
+  EMBER_FG_OP_DXIL_TESS = 40,
+};
+
+#pragma pack(push, 8)
+struct unixcall_ember_fg {
+  uint32_t op;
+  int32_t ret;
+  obj_handle_t ctx;            /* in/out (create) */
+  obj_handle_t device;
+  struct WMTConstMemoryPointer in;
+  uint64_t in_size;
+  struct WMTMemoryPointer out;
+  uint64_t out_size;
+  struct WMTMemoryPointer log; /* optional: queued log lines are moved here after the call */
+  uint64_t log_cap;
+  uint64_t log_len;            /* out */
+  int64_t arg_i64;
+  double arg_f64;
+  int64_t arg0;
+  uint64_t arg1;
+};
+#pragma pack(pop)
+
+/* PE side: returns `ret` (0 if the unix side has no library). */
+WINEMETAL_API int32_t EmberFG_call(struct unixcall_ember_fg *params);
+
+#endif
diff --git a/src/winemetal/ember_neural_thunks.c b/src/winemetal/ember_neural_thunks.c
new file mode 100644
index 0000000..eafe05d
--- /dev/null
+++ b/src/winemetal/ember_neural_thunks.c
@@ -0,0 +1,88 @@
+/* Ember Neural: PE 쪽 썽크. 번호는 EMBER_NEURAL_UNIX_CALL_BASE 부터 open, close, begin, submit, cancel, latest, stats 순. */
+#ifdef _WIN32
+#define WINEMETAL_API __declspec(dllexport)
+#else
+#define WINEMETAL_API
+#endif
+
+#include "winemetal_thunks.h"
+#include "ember_neural_thunks.h"
+#include <wineunixlib.h>
+#include <string.h>
+
+#define EN_CALL(i, params) WINE_UNIX_CALL(EMBER_NEURAL_UNIX_CALL_BASE + (i), params)
+
+WINEMETAL_API obj_handle_t
+EmberNeural_open(
+    obj_handle_t device, const char *spec, const char *units, uint32_t want_w, uint32_t want_h, uint32_t log,
+    struct ember_neural_ane_desc *desc
+) {
+  struct unixcall_ember_neural_open params;
+  memset(&params, 0, sizeof(params));
+  params.device = device;
+  WMT_MEMPTR_SET(params.spec, spec);
+  WMT_MEMPTR_SET(params.units, units);
+  params.want_w = want_w;
+  params.want_h = want_h;
+  params.log = log;
+  WMT_MEMPTR_SET(params.desc, desc);
+  if (EN_CALL(0, &params)) return 0;   /* 유닉스 쪽이 없으면(옛 winemetal.so) 조용히 실패 */
+  return params.ret;
+}
+
+WINEMETAL_API void
+EmberNeural_close(obj_handle_t ctx) {
+  struct unixcall_generic_obj_noret params;
+  params.handle = ctx;
+  EN_CALL(1, &params);
+}
+
+WINEMETAL_API int32_t
+EmberNeural_begin(obj_handle_t ctx, obj_handle_t *input_texture) {
+  struct unixcall_ember_neural_begin params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.ret_slot = -1;
+  if (EN_CALL(2, &params)) return -1;
+  *input_texture = params.ret_texture;
+  return params.ret_slot;
+}
+
+WINEMETAL_API void
+EmberNeural_submit(obj_handle_t ctx, obj_handle_t cmdbuf, int32_t slot) {
+  struct unixcall_ember_neural_submit params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.cmdbuf = cmdbuf;
+  params.slot = slot;
+  EN_CALL(3, &params);
+}
+
+WINEMETAL_API void
+EmberNeural_cancel(obj_handle_t ctx, int32_t slot) {
+  struct unixcall_ember_neural_submit params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  params.slot = slot;
+  EN_CALL(4, &params);
+}
+
+WINEMETAL_API int32_t
+EmberNeural_latest(obj_handle_t ctx, obj_handle_t *lo_in, obj_handle_t *lo_out, uint64_t *seq, int32_t *age) {
+  struct unixcall_ember_neural_latest params;
+  memset(&params, 0, sizeof(params));
+  params.ctx = ctx;
+  if (EN_CALL(5, &params) || !params.ret_ok) return 0;
+  *lo_in = params.ret_in;
+  *lo_out = params.ret_out;
+  if (seq) *seq = params.ret_seq;
+  if (age) *age = params.ret_age;
+  return 1;
+}
+
+WINEMETAL_API void
+EmberNeural_stats(obj_handle_t ctx, struct unixcall_ember_neural_stats *st) {
+  memset(st, 0, sizeof(*st));
+  st->ctx = ctx;
+  EN_CALL(6, st);
+}
diff --git a/src/winemetal/ember_neural_thunks.h b/src/winemetal/ember_neural_thunks.h
new file mode 100644
index 0000000..aef209a
--- /dev/null
+++ b/src/winemetal/ember_neural_thunks.h
@@ -0,0 +1,73 @@
+/*
+ * Ember Neural: winemetal PE ↔ 유닉스 썽크(CoreML 워커). 유닉스 구현은 unix/ember_neural_unix.m(→ winemac.drv 의 ember_neural_ane.m).
+ * 호출 번호는 winemetal_unix.c 의 __wine_unix_call_funcs 끝에 덧붙인 순서(146~151)와 같아야 한다 — 통합 헝크 참고.
+ */
+#ifndef __EMBER_NEURAL_THUNKS_H
+#define __EMBER_NEURAL_THUNKS_H
+
+#include "winemetal.h"
+
+#pragma pack(push, 8)
+
+struct ember_neural_ane_desc {
+  uint32_t width, height, layout;   /* layout: 0 BGRA8 이미지, 1 planar fp16(R16Float, 3H 높이), 2 RGBA16F 이미지 */
+  uint32_t pad;
+  float in_scale, in_bias, out_scale, out_bias;
+};
+
+struct unixcall_ember_neural_open {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer spec;    /* NUL 종료 */
+  struct WMTConstMemoryPointer units;   /* NUL 종료, 비어 있으면 ane */
+  uint32_t want_w, want_h, log, pad;
+  struct WMTMemoryPointer desc;         /* out: ember_neural_ane_desc */
+  obj_handle_t ret;                     /* 컨텍스트 핸들, 0 이면 실패 */
+};
+
+struct unixcall_ember_neural_begin {
+  obj_handle_t ctx;
+  obj_handle_t ret_texture;
+  int32_t ret_slot;
+  uint32_t pad;
+};
+
+struct unixcall_ember_neural_submit {
+  obj_handle_t ctx;
+  obj_handle_t cmdbuf;
+  int32_t slot;
+  uint32_t pad;
+};
+
+struct unixcall_ember_neural_latest {
+  obj_handle_t ctx;
+  obj_handle_t ret_in, ret_out;
+  uint64_t ret_seq;
+  int32_t ret_age;
+  int32_t ret_ok;
+};
+
+struct unixcall_ember_neural_stats {
+  obj_handle_t ctx;
+  uint64_t done, skipped, failed;
+  double ms_ema, ms_max, open_ms;
+};
+
+#pragma pack(pop)
+
+#define EMBER_NEURAL_UNIX_CALL_BASE 146
+
+/* PE 쪽 API */
+WINEMETAL_API obj_handle_t EmberNeural_open(
+    obj_handle_t device, const char *spec, const char *units, uint32_t want_w, uint32_t want_h, uint32_t log,
+    struct ember_neural_ane_desc *desc
+);
+WINEMETAL_API void EmberNeural_close(obj_handle_t ctx);
+/* 빈 슬롯 → 슬롯 번호와 입력 텍스처 핸들(유닉스 쪽 소유, retain 하지 말 것). -1 이면 이번 프레임 건너뜀 */
+WINEMETAL_API int32_t EmberNeural_begin(obj_handle_t ctx, obj_handle_t *input_texture);
+/* 입력 텍스처에 그린 뒤: cmdbuf 에 이벤트 신호를 넣고 GPU 가 지나면 워커가 돈다 */
+WINEMETAL_API void EmberNeural_submit(obj_handle_t ctx, obj_handle_t cmdbuf, int32_t slot);
+WINEMETAL_API void EmberNeural_cancel(obj_handle_t ctx, int32_t slot);
+WINEMETAL_API int32_t EmberNeural_latest(obj_handle_t ctx, obj_handle_t *lo_in, obj_handle_t *lo_out, uint64_t *seq, int32_t *age);
+WINEMETAL_API void EmberNeural_stats(obj_handle_t ctx, struct unixcall_ember_neural_stats *st);
+
+#endif
diff --git a/src/winemetal/ember_tessellation.h b/src/winemetal/ember_tessellation.h
new file mode 100644
index 0000000..93cca86
--- /dev/null
+++ b/src/winemetal/ember_tessellation.h
@@ -0,0 +1,120 @@
+/* Ember private compatibility patch. CPU-only checks for MSC tessellation.
+ * Interface rules follow Apple's Apache-2.0 metal_irconverter_runtime.h
+ * IRRuntimeValidateTessellationPipeline. GS values here are IRInputPrimitive,
+ * not IRRuntimePrimitiveType (their point/line values differ).
+ */
+#ifndef EMBER_TESSELLATION_H
+#define EMBER_TESSELLATION_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+static inline const char *ember_tess_validate_interface(
+    uint32_t output, uint32_t gs_input, uint32_t hs_size, uint32_t ds_size,
+    uint32_t hs_constants, uint32_t ds_constants, uint32_t hs_cps, uint32_t ds_cps) {
+  if (output < 1 || output > 4)
+    return "tessellator output primitive";
+  uint32_t expected = output <= 2 ? output : 3;
+  if (gs_input != expected)
+    return "tessellator/geometry primitive mismatch";
+  if (hs_size != ds_size || hs_constants != ds_constants || hs_cps != ds_cps)
+    return "hull/domain interface mismatch";
+  if (!hs_cps || hs_cps > 32)
+    return "hull output control points";
+  return 0;
+}
+
+static inline const char *ember_tess_validate_shape(
+    uint32_t cps, uint32_t patches, uint32_t threads, uint32_t mesh_prims,
+    uint32_t output, uint32_t instances, uint32_t vs_size, float max_factor) {
+  uint32_t overlap = output == 1 ? 0 : output == 2 ? 1 : 2;
+  if (!cps || cps > 32 || !patches || patches > UINT16_MAX || !threads || threads > UINT8_MAX ||
+      (uint64_t)patches * threads > 1024 || (uint64_t)patches * cps > UINT16_MAX)
+    return "hull threadgroup shape";
+  if (output < 1 || output > 4 || mesh_prims <= overlap || mesh_prims > 1024)
+    return "mesh threadgroup shape";
+  if (!instances || instances > UINT16_MAX)
+    return "geometry instance count";
+  if (!(max_factor >= 1.0f && max_factor <= 64.0f))
+    return "max tessellation factor";
+  /* This becomes an MTLDataTypeInt function constant. It is not a separate
+   * scratch allocation: Apple's MSC 3.0 runtime reserves 15360 bytes at TG0.
+   * Defer memory checks until the compiled pipeline bindings are available.
+   */
+  /* Procedural patches may consume only SV_VertexID/SV_InstanceID and emit
+   * no VS payload. Real W3 sk001 reflects zero here and matching zero HS/DS
+   * control-point sizes; zero is a valid function constant. */
+  if (vs_size > INT32_MAX)
+    return "vertex output size";
+  return 0;
+}
+
+#define EMBER_TESS_OBJECT_MEMORY_BYTES 15360u
+static inline const char *ember_tess_validate_memory(
+    uint32_t binding_mask, uint32_t vs_size, uint32_t cps, uint32_t patches,
+    uint64_t device_limit, uint32_t *mem0, uint32_t *mem1) {
+  /* The public MSC 3.0 header uses only TG0. Preserve the prior converter
+   * compatibility layout only when the compiled reflection reports TG0+TG1.
+   * Never charge split-layout scratch to a single-slot pipeline.
+   */
+  *mem0 = *mem1 = 0;
+  if (binding_mask != 1 && binding_mask != 3)
+    return "object threadgroup memory layout";
+  uint64_t size0 = EMBER_TESS_OBJECT_MEMORY_BYTES, size1 = 0;
+  if (binding_mask == 3) {
+    if (!cps || cps > 32 || !patches || patches > UINT16_MAX)
+      return "object threadgroup scratch shape";
+    size0 = (uint64_t)vs_size * cps * patches;
+    size1 = EMBER_TESS_OBJECT_MEMORY_BYTES - 128;
+  }
+  if (size0 > UINT16_MAX || size1 > UINT16_MAX)
+    return "object threadgroup memory ABI limit";
+  if (size0 + size1 > device_limit)
+    return "object threadgroup memory device limit";
+  *mem0 = (uint32_t)size0;
+  *mem1 = (uint32_t)size1;
+  return 0;
+}
+static inline const char *ember_tess_validate_memory_binding(
+    uint32_t allocated, uint64_t reflected_size, uint64_t reflected_alignment) {
+  if (reflected_size > allocated ||
+      (reflected_alignment && allocated % reflected_alignment))
+    return "object threadgroup memory reflection size/alignment";
+  return 0;
+}
+/* Reject outputless UAV GS before calling MSC (including from the harness). */
+static inline int ember_tess_gs_has_outputs(const void *bytes, size_t n) {
+  const uint8_t *p = (const uint8_t *)bytes;
+  uint32_t parts;
+  if (!p || n < 32 || memcmp(p, "DXBC", 4)) return 0;
+  memcpy(&parts, p + 28, 4);
+  if (parts > 64 || 32 + 4ull * parts > n) return 0;
+  int has_outputs = 0;
+  for (uint32_t i = 0; i < parts; ++i) {
+    uint32_t off, size, count;
+    memcpy(&off, p + 32 + 4 * i, 4);
+    if ((uint64_t)off + 8 > n) return 0;
+    memcpy(&size, p + off + 4, 4);
+    if ((uint64_t)off + 8 + size > n) return 0;
+    if (!memcmp(p + off, "OSG1", 4) || !memcmp(p + off, "OSGN", 4) || !memcmp(p + off, "OSG5", 4)) {
+      if (size < 4) return 0;
+      memcpy(&count, p + off + 8, 4);
+      has_outputs |= count != 0;
+    }
+  }
+  return has_outputs;
+}
+
+struct ember_tess_draw_info {
+  uint16_t indexType;
+  uint8_t primitiveTopology, threadsPerPatch;
+  uint16_t maxInputPrimitivesPerMeshThreadgroup, objectThreadgroupVertexStride;
+  uint16_t meshThreadgroupPrimitiveStride, gsInstanceCount;
+  uint16_t patchesPerObjectThreadgroup, inputControlPointsPerPatch;
+  uint64_t indexBuffer;
+};
+
+static inline uint32_t ember_tess_grid_width(uint32_t count, uint32_t stride) {
+  return stride ? count / stride + (count % stride != 0) : 0;
+}
+#endif
