+static void
+ir_load(void) {
+  const char *env = getenv("EMBER_IRCONVERTER");
+  ir_log = getenv("EMBER_DXIL_LOG") != NULL;
+  char here[1024] = "";
+  Dl_info info;
+  if (dladdr((void *)&ir_load, &info) && info.dli_fname) {
+    snprintf(here, sizeof(here), "%s", info.dli_fname);
+    char *slash = strrchr(here, '/');
+    if (slash)
+      snprintf(slash + 1, sizeof(here) - (slash + 1 - here), "libmetalirconverter.dylib");
+    else
+      here[0] = 0;
+  }
+  /* 앱 번들 안 D3DMetal(애플 서명, x86_64 만) — 스팀처럼 먼저 떠 있던 런처가 띄운 게임에 EMBER_IRCONVERTER 가 안 갔을 때 */
+  char bundled[1100] = "";
+  if (here[0]) {
+    char *cut = strstr(here, "/Wine");
+    if (cut)
+      snprintf(bundled, sizeof(bundled), "%.*s/d3dmetal/external/D3DMetal.framework/Versions/A/Resources/libmetalirconverter.dylib",
+               (int)(cut - here), here);
+  }
+  const char *cands[] = {
+      env,
+      here[0] ? here : NULL,
+      bundled[0] ? bundled : NULL,
+      "/opt/metal-shaderconverter/lib/libmetalirconverter.dylib",
+      "/usr/local/lib/libmetalirconverter.dylib",
+  };
+  void *h = NULL;
+  for (unsigned i = 0; i < sizeof(cands) / sizeof(cands[0]) && !h; i++) {
+    if (!cands[i] || !cands[i][0])
+      continue;
+    h = dlopen(cands[i], RTLD_NOW | RTLD_LOCAL);
+    if (h && ir_log)
+      fprintf(stderr, "ember-dxil: loaded %s\n", cands[i]);
+  }
+  if (h && getenv("EMBER_DXIL_IMAGES")) { /* 진단: 불린 이미지 목록(폴트 주소 대조용) */
+    FILE *f = fopen(getenv("EMBER_DXIL_IMAGES"), "w");
+    if (f) {
+      for (uint32_t i = 0; i < _dyld_image_count(); i++)
+        fprintf(f, "%p %s\n", (void *)_dyld_get_image_header(i), _dyld_get_image_name(i));
+      fclose(f);
+    }
+  }
+  if (!h) {
+    fprintf(stderr, "ember-dxil: libmetalirconverter.dylib not found - DXIL shaders unsupported\n");
+    return;
+  }
+#define IR_LOAD(name)                                                                                                  \
+  p_##name = (__typeof__(p_##name))dlsym(h, #name);                                                                    \
+  if (!p_##name) {                                                                                                     \
+    fprintf(stderr, "ember-dxil: missing symbol %s\n", #name);                                                         \
+    return;                                                                                                            \
+  }
