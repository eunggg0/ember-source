+    IRFormatR11G11B10Float                     = 26,
+    IRFormatR8G8B8A8Typeless                   = 27,
+    IRFormatR8G8B8A8Unorm                      = 28,
+    IRFormatR8G8B8A8Unorm_sRGB                 = 29,
+    IRFormatR8G8B8A8Uint                       = 30,
+    IRFormatR8G8B8A8Snorm                      = 31,
