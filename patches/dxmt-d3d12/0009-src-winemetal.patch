From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 9/10] src-winemetal: Ember changes

Base: DXMT 7c8dee1 with submodules
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/src/winemetal/Metal.hpp b/src/winemetal/Metal.hpp
index 8224a0c..bb0c599 100644
--- a/src/winemetal/Metal.hpp
+++ b/src/winemetal/Metal.hpp
@@ -669,6 +669,11 @@ public:
     return MTLCommandBuffer_property(handle, WMTCommandBufferPropertyGPUEndTime);
   }
 
+  uint64_t
+  gpuStartTime() { /* Ember: D3D12 GPU 프로파일러(EMBER_D12_PROF) */
