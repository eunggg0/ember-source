+  p_IRMetalLibSynthesizeStageInFunction =
+      (__typeof__(p_IRMetalLibSynthesizeStageInFunction))dlsym(h, "IRMetalLibSynthesizeStageInFunction");
+  p_IRShaderReflectionCopyGeometryInfo =
+      (__typeof__(p_IRShaderReflectionCopyGeometryInfo))dlsym(h, "IRShaderReflectionCopyGeometryInfo");
+  p_IRShaderReflectionReleaseGeometryInfo =
+      (__typeof__(p_IRShaderReflectionReleaseGeometryInfo))dlsym(h, "IRShaderReflectionReleaseGeometryInfo");
+  p_IRCompilerSetVertexRenderTargetIndexID =
+      (void (*)(IRCompiler *, int32_t))dlsym(h, "IRCompilerSetVertexRenderTargetIndexID");
+  p_IRCompilerSetVertexViewportIndexID = (void (*)(IRCompiler *, int32_t))dlsym(h, "IRCompilerSetVertexViewportIndexID");
+  ir_v3 = dlsym(h, "IRCompilerSetFramebufferFetchResourceSpace") != NULL || dlsym(h, "IRCompilerSetFunctionConstantResourceSpace") != NULL;
+  if (ir_log)
+    fprintf(stderr, "ember-dxil: converter generation %s\n", ir_v3 ? "3.x (force texture array)" : "1.x/2.x");
+  const char *home = getenv("HOME");
+  if (getenv("EMBER_DXIL_NOCACHE"))
+    ir_cache_dir[0] = 0;
+  else if (home) {
+    snprintf(ir_cache_dir, sizeof(ir_cache_dir), "%s/Library/Caches/Ember", home);
+    mkdir(ir_cache_dir, 0755);
+    snprintf(ir_cache_dir, sizeof(ir_cache_dir), "%s/Library/Caches/Ember/dxil", home);
+    mkdir(ir_cache_dir, 0755);
+  }
+  {
+    Dl_info di;
+    struct stat st;
+    if (dladdr((void *)p_IRCompilerCreate, &di) && di.dli_fname && stat(di.dli_fname, &st) == 0)
+      snprintf(ir_ident, sizeof(ir_ident), "%s|%lld|%ld", di.dli_fname, (long long)st.st_size, (long)st.st_mtime);
