+}
+
+/* Ember: IRError 의 부가 정보는 대개 사람이 읽는 문자열이다(예: "IR contains unsupported instruction: ..."). 아니면 "" */
+static const char *
+ir_error_text(IRError *err) {
+  const char *p = p_IRErrorGetPayload ? (const char *)p_IRErrorGetPayload(err) : NULL;
+  if (!p)
+    return "";
+  for (int i = 0; i < 400; i++) {
+    unsigned char ch = (unsigned char)p[i];
+    if (!ch)
+      return i ? p : "";
+    if (ch < 0x20 && ch != '\n' && ch != '\t')
+      return "";
+  }
+  return "";
+}
