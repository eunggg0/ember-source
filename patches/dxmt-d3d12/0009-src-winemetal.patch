+/* Ember: 돌고 있는 macOS 가 15 이상인가 */
+static int
+ir_os_at_least_15(void) {
+  static int v = -1;
+  if (v < 0) {
+    NSOperatingSystemVersion want = {15, 0, 0};
+    v = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:want] ? 1 : 0;
+  }
+  return v;
+}
