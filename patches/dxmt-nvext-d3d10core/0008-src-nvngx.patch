--- /dev/null
+++ b/src/nvngx/ember_d3d12_upscale.hpp
@@ -0,0 +1,29 @@
+#pragma once
+/* Ember(d12ngx): D3D12 temporal upscale entry for nvngx (DLSS -> MetalFX), mirrors MTL_TEMPORAL_UPSCALE_D3D11_DESC.
+ * nvngx queries this from the ID3D12GraphicsCommandList it is handed and records the upscale into that list. */
+#include "com/com_guid.hpp"
+#include "d3d12.h"
+
+struct EMBER_D3D12_TEMPORAL_UPSCALE_DESC {
+  UINT InputContentWidth;  // 0 = full color width
+  UINT InputContentHeight; // 0 = full color height
+  BOOL AutoExposure;
+  BOOL InReset;
+  BOOL DepthReversed;
+  BOOL MotionVectorInDisplayRes;
+  ID3D12Resource *Color;
+  ID3D12Resource *Depth;
+  ID3D12Resource *MotionVector;
+  ID3D12Resource *Output;
+  FLOAT MotionVectorScaleX;
+  FLOAT MotionVectorScaleY;
+  FLOAT PreExposure;
+  ID3D12Resource *ExposureTexture; // optional
+  FLOAT JitterOffsetX;
+  FLOAT JitterOffsetY;
+};
+
+DEFINE_COM_INTERFACE("8d2f0c61-3b7e-4a5c-9f14-6e2b7d0a91c3", IEmberD3D12CommandListUpscale) : public IUnknown {
+  /* S_OK: recorded. E_NOTIMPL: no MetalFX temporal scaler / unsupported inputs (caller falls back). */
+  virtual HRESULT STDMETHODCALLTYPE TemporalUpscale(const EMBER_D3D12_TEMPORAL_UPSCALE_DESC *pDesc) = 0;
+};
