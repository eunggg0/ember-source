+/* ---- Ember(d12ngx): D3D12 entry points. DXMT d3d12 records the MetalFX temporal scaler into the command list
+ * through IEmberD3D12CommandListUpscale; everything else mirrors the D3D11 path above. ---- */
+
+static void
+TextureSize12(ID3D12Resource *res, UINT *w, UINT *h) {
+  *w = 0;
+  *h = 0;
+  if (res) {
+    auto desc = res->GetDesc();
+    *w = (UINT)desc.Width;
+    *h = desc.Height;
+  }
+}
