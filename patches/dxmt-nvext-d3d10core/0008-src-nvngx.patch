+NVNGX_API NVNGX_RESULT
+NVSDK_NGX_D3D12_EvaluateFeature(
+    ID3D12GraphicsCommandList *list, const unsigned int *handle, NVNGXParameter *params, void *callback
+) {
+  auto parameters = static_cast<ParametersImpl *>(params);
+  if (!list || !handle || !params)
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  if (static_cast<const CommonFeature *>((const void *)handle)->feature != NVNGX_FEATURE_SUPERSAMPLING)
+    return NVNGX_RESULT_FAIL;
+  auto dlss = static_cast<DLSSFeature *>((void *)handle);
+  Com<IEmberD3D12CommandListUpscale> ext = nullptr;
+  if (FAILED(list->QueryInterface(IID_PPV_ARGS(&ext))) || !ext) {
+    static std::atomic<bool> warned_qi{false};
+    if (!warned_qi.exchange(true))
+      ERR("NVSDK_NGX_D3D12_EvaluateFeature: command list has no IEmberD3D12CommandListUpscale (wrapped by a proxy?)");
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  }
+
+  EMBER_D3D12_TEMPORAL_UPSCALE_DESC desc = {};
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Color, &desc.Color)) ||
+      NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Output, &desc.Output)) ||
+      NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Depth, &desc.Depth)) ||
+      NVNGX_FAILED(parameters->Get(NVNGX_Parameter_MotionVectors, &desc.MotionVector)))
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  if (!desc.Color || !desc.Output || !desc.Depth || !desc.MotionVector)
+    return NVNGX_RESULT_INVALID_PARAMETER;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_ExposureTexture, &desc.ExposureTexture)))
+    desc.ExposureTexture = nullptr;
+
+  uint32_t width = 0, height = 0;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, &width)))
+    width = 0;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, &height)))
+    height = 0;
+  UINT color_width = 0, color_height = 0;
+  TextureSize12(desc.Color, &color_width, &color_height);
+  desc.InputContentWidth = (width == 0 || width > color_width) ? color_width : width;
+  desc.InputContentHeight = (height == 0 || height > color_height) ? color_height : height;
+
+  desc.DepthReversed = bool(dlss->flag & NVNGX_DLSS_FLAG_DEPTH_INVERTED);
+  desc.AutoExposure = bool(dlss->flag & NVNGX_DLSS_FLAG_AUTO_EXPOSURE);
+  desc.MotionVectorInDisplayRes = !bool(dlss->flag & NVNGX_DLSS_FLAG_MV_LOWRES);
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Jitter_Offset_X, &desc.JitterOffsetX)))
+    desc.JitterOffsetX = 0;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_Jitter_Offset_Y, &desc.JitterOffsetY)))
+    desc.JitterOffsetY = 0;
+  int reset = 0;
+  parameters->Get(NVNGX_Parameter_Reset, &reset);
+  desc.InReset = reset;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_MV_Scale_X, &desc.MotionVectorScaleX)))
+    desc.MotionVectorScaleX = 1.0;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_MV_Scale_Y, &desc.MotionVectorScaleY)))
+    desc.MotionVectorScaleY = 1.0;
+  if (NVNGX_FAILED(parameters->Get(NVNGX_Parameter_DLSS_Pre_Exposure, &desc.PreExposure)) || !(desc.PreExposure > 0.0f))
+    desc.PreExposure = 1.0f;
+  static const float jitter_sign = EnvSign("DXMT_NGX_JITTER_SIGN");
+  static const float mv_sign = EnvSign("DXMT_NGX_MV_SIGN");
+  desc.JitterOffsetX *= jitter_sign;
+  desc.JitterOffsetY *= jitter_sign;
+  desc.MotionVectorScaleX *= mv_sign;
+  desc.MotionVectorScaleY *= mv_sign;
+
+  if (!dlss->logged_first_eval) {
+    dlss->logged_first_eval = true;
+    UINT out_width = 0, out_height = 0;
+    TextureSize12(desc.Output, &out_width, &out_height);
+    Logger::info(str::format(
+        "NVSDK_NGX_D3D12_EvaluateFeature: DLSS #", dlss->handle, " color ", color_width, "x", color_height,
+        " content ", desc.InputContentWidth, "x", desc.InputContentHeight, " -> ", out_width, "x", out_height,
+        " mvScale=", desc.MotionVectorScaleX, ",", desc.MotionVectorScaleY, " exposureTex=", desc.ExposureTexture ? 1 : 0,
+        " depthInverted=", desc.DepthReversed, " mvDisplayRes=", desc.MotionVectorInDisplayRes
+    ));
+  }
+  HRESULT hr = ext->TemporalUpscale(&desc);
+  if (FAILED(hr)) {
+    static std::atomic<bool> warned{false};
+    if (!warned.exchange(true)) {
+      ERR("NVSDK_NGX_D3D12_EvaluateFeature: upscale not recorded, hr=", hr);
+    }
+    return NVNGX_RESULT_FAIL;
+  }
+  return NVNGX_RESULT_OK;
+}
