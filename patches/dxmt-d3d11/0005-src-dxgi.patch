+/* Ember: 2D 텍스처의 IDXGISurface(1/2). 없어서 Direct2D(CreateDxgiSurfaceRenderTarget)가 NULL 표면으로 죽었다.
+ * 집합(aggregated) 객체라 참조·QI 는 리소스에 맡긴다. Map 은 즉시 문맥 Map 으로(dxmtup), GetDC 는 GDI 호환 텍스처만. */
+template <typename IResource> class MTLDXGISurface : public IDXGISurface2 {
+public:
+  MTLDXGISurface(IResource *pResource) : resource_(pResource) {}
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) final { return resource_->QueryInterface(riid, ppvObject); }
+  ULONG STDMETHODCALLTYPE AddRef() final { return resource_->AddRef(); }
+  ULONG STDMETHODCALLTYPE Release() final { return resource_->Release(); }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID guid, UINT size, const void *data) final { return resource_->SetPrivateData(guid, size, data); }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID guid, const IUnknown *object) final { return resource_->SetPrivateDataInterface(guid, object); }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID guid, UINT *size, void *data) final { return resource_->GetPrivateData(guid, size, data); }
+  HRESULT STDMETHODCALLTYPE GetParent(REFIID riid, void **parent) final { return GetDevice(riid, parent); }
+  HRESULT STDMETHODCALLTYPE GetDevice(REFIID riid, void **ppDevice) final { return resource_->GetDeviceInterface(riid, ppDevice); }
+  HRESULT STDMETHODCALLTYPE GetDesc(DXGI_SURFACE_DESC *desc) final { return resource_->GetSurfaceDesc(desc); }
+  /* Ember dxmtup(업스트림 feat/d2d-interop 3a9a303 의 Map/Unmap 이식): 즉시 문맥 Map 으로 넘긴다.
+   * 스테이징·동적 텍스처만 성공하고(D3D11 Map 규칙 그대로), 기본(DEFAULT) 텍스처는 Map 이 오류를 돌려준다(예전처럼 죽지 않음). */
+  HRESULT STDMETHODCALLTYPE Map(DXGI_MAPPED_RECT *rect, UINT flags) final {
+    if (!rect)
+      return E_INVALIDARG;
+    rect->Pitch = 0;
+    rect->pBits = nullptr;
+    D3D11_MAP map_type;
+    if ((flags & DXGI_MAP_READ) && (flags & DXGI_MAP_WRITE))
+      map_type = D3D11_MAP_READ_WRITE;
+    else if (flags & DXGI_MAP_READ)
+      map_type = D3D11_MAP_READ;
+    else if ((flags & DXGI_MAP_WRITE) && (flags & DXGI_MAP_DISCARD))
+      map_type = D3D11_MAP_WRITE_DISCARD;
+    else if (flags & DXGI_MAP_WRITE)
+      map_type = D3D11_MAP_WRITE;
+    else
+      return DXGI_ERROR_INVALID_CALL;
+    ID3D11Resource *res = nullptr;
+    if (FAILED(resource_->QueryInterface(__uuidof(ID3D11Resource), (void **)&res)))
+      return DXGI_ERROR_INVALID_CALL;
+    ID3D11Device *dev = nullptr;
+    ID3D11DeviceContext *ctx = nullptr;
+    res->GetDevice(&dev);
+    dev->GetImmediateContext(&ctx);
+    D3D11_MAPPED_SUBRESOURCE sr = {};
+    HRESULT hr = ctx->Map(res, 0, map_type, 0, &sr);
+    if (hr == S_OK) {
+      rect->Pitch = (INT)sr.RowPitch;
+      rect->pBits = reinterpret_cast<BYTE *>(sr.pData);
+    } else {
+      ERR_ONCE("DXGISurface::Map: immediate context Map failed ", hr);
+    }
+    ctx->Release();
+    dev->Release();
+    res->Release();
+    return hr;
+  }
+  HRESULT STDMETHODCALLTYPE Unmap() final {
+    ID3D11Resource *res = nullptr;
+    if (FAILED(resource_->QueryInterface(__uuidof(ID3D11Resource), (void **)&res)))
+      return DXGI_ERROR_INVALID_CALL;
+    ID3D11Device *dev = nullptr;
+    ID3D11DeviceContext *ctx = nullptr;
+    res->GetDevice(&dev);
+    dev->GetImmediateContext(&ctx);
+    ctx->Unmap(res, 0);
+    ctx->Release();
+    dev->Release();
+    res->Release();
+    return S_OK;
+  }
+  /* GDI 호환(D3D11_RESOURCE_MISC_GDI_COMPATIBLE, BGRA8) 텍스처를 DIB 로 빌려준다. Wine d2d1 의 DC 렌더 타깃(ID2D1DCRenderTarget)이
+   * 이것으로 GDI DC 에 옮긴다. discard 가 아니면 텍스처 내용을 읽어 채우고, ReleaseDC 에서 다시 올린다. */
+  HRESULT STDMETHODCALLTYPE GetDC(BOOL discard, HDC *out) final {
+    if (!out) return E_INVALIDARG;
+    *out = nullptr;
+    if (dc_) return DXGI_ERROR_INVALID_CALL;
+    ID3D11Texture2D *tex = nullptr;
+    if (FAILED(resource_->QueryInterface(__uuidof(ID3D11Texture2D), (void **)&tex))) return DXGI_ERROR_INVALID_CALL;
+    D3D11_TEXTURE2D_DESC d; tex->GetDesc(&d);
+    if (!(d.MiscFlags & D3D11_RESOURCE_MISC_GDI_COMPATIBLE)) { tex->Release(); return DXGI_ERROR_INVALID_CALL; }
+    BITMAPINFO bi = {};
+    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER); bi.bmiHeader.biWidth = (LONG)d.Width; bi.bmiHeader.biHeight = -(LONG)d.Height;
+    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
+    dib_ = CreateDIBSection(nullptr, &bi, DIB_RGB_COLORS, &bits_, nullptr, 0);
+    if (!dib_) { tex->Release(); return E_OUTOFMEMORY; }
+    dc_ = CreateCompatibleDC(nullptr); old_ = SelectObject(dc_, dib_); w_ = d.Width; h_ = d.Height;
+    if (!discard) {
+      ID3D11Device *dev = nullptr; ID3D11DeviceContext *ctx = nullptr; ID3D11Texture2D *stg = nullptr;
+      tex->GetDevice(&dev); dev->GetImmediateContext(&ctx);
+      D3D11_TEXTURE2D_DESC sd = d; sd.Usage = D3D11_USAGE_STAGING; sd.BindFlags = 0; sd.CPUAccessFlags = D3D11_CPU_ACCESS_READ; sd.MiscFlags = 0;
+      sd.MipLevels = 1; sd.ArraySize = 1;
+      if (SUCCEEDED(dev->CreateTexture2D(&sd, nullptr, &stg))) {
+        ctx->CopySubresourceRegion(stg, 0, 0, 0, 0, tex, 0, nullptr);
+        D3D11_MAPPED_SUBRESOURCE m;
+        if (SUCCEEDED(ctx->Map(stg, 0, D3D11_MAP_READ, 0, &m))) {
+          for (UINT y = 0; y < h_; y++) memcpy((char *)bits_ + y * w_ * 4, (char *)m.pData + y * m.RowPitch, w_ * 4);
+          ctx->Unmap(stg, 0);
+        }
+        stg->Release();
+      }
+      ctx->Release(); dev->Release();
+    }
+    tex->Release();
+    *out = dc_;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE ReleaseDC(RECT *dirty) final {
+    if (!dc_) return DXGI_ERROR_INVALID_CALL;
+    ID3D11Texture2D *tex = nullptr;
+    if (SUCCEEDED(resource_->QueryInterface(__uuidof(ID3D11Texture2D), (void **)&tex))) {
+      ID3D11Device *dev = nullptr; ID3D11DeviceContext *ctx = nullptr;
+      tex->GetDevice(&dev); dev->GetImmediateContext(&ctx);
+      GdiFlush();
+      ctx->UpdateSubresource(tex, 0, nullptr, bits_, w_ * 4, 0);
+      ctx->Release(); dev->Release(); tex->Release();
+    }
+    SelectObject(dc_, old_); DeleteDC(dc_); DeleteObject(dib_);
+    dc_ = nullptr; dib_ = nullptr; bits_ = nullptr;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetResource(REFIID riid, void **parent, UINT *subresource) final {
+    if (subresource) *subresource = 0;
+    return resource_->QueryInterface(riid, parent);
+  }
+private:
+  IResource *resource_;
+  HDC dc_ = nullptr; HBITMAP dib_ = nullptr; HGDIOBJ old_ = nullptr; void *bits_ = nullptr; UINT w_ = 0, h_ = 0;
+};
+
