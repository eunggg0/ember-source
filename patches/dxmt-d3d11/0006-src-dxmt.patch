+    if (FILE *f = fopen("C:\\ember-d11pace.log", "ab")) {
+      fwrite(pace_stat_.lines.data(), 1, pace_stat_.lines.size(), f);
+      fclose(f);
+    }
+    pace_stat_ = {};
+    pace_stat_.since = now;
+  }
+}
