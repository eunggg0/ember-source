+++ b/src/dxmt/ember_neural.hpp
@@ -0,0 +1,87 @@
+#pragma once
+/*
+ * Ember Tone (EMBER_NEURAL) / Ember Flare (EMBER_AUTOHDR) glue, DXMT side.
+ *
+ * Both post-processing engines live in the optional libEmberTone.dylib (EmberCore, separate proprietary library, not part of
+ * this tree). The presenter calls them through winemetal's EmberFG_call (ops EMBER_FG_OP_TONE_*, unix side ember_fg_unix.c
+ * loads the library next to winemetal.so). When the library or the winemetal support is missing, frames pass through
+ * unchanged. The wire structs below mirror EmberCore/tone/include/ember_tone.h (ABI 1.x) byte for byte.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#include "Metal.hpp"
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace dxmt {
+
+namespace embertone {
+
+constexpr uint32_t kMaxWaitFences = 256;
+constexpr uint32_t kHostDXMT = 0;
+
+struct NeuralIn {
+  uint32_t size;
+  int32_t rt_mode;
+  uint64_t command_buffer, source, target;
+  uint32_t sample_count, n_wait_fences;
+  uint64_t wait_fences[kMaxWaitFences];
+};
+struct NeuralOut {
+  uint32_t size, processed;
+  uint64_t texture;
+};
+struct AhdrConfig {
+  uint32_t size, failed;
+  float strength, peak_cap, gamma22, wexp, peak, pad;
+};
+struct AhdrEncodeIn {
+  uint32_t size, flags;
+  uint64_t command_buffer, source;
+  uint32_t n_wait_fences, pad;
+  uint64_t wait_fences[kMaxWaitFences];
+};
+constexpr uint32_t kAhdrSrcSRGB = 1;
+struct AhdrEncodeOut {
+  uint32_t size, ok;
+  uint64_t gain;
+};
+struct AhdrFrameIn {
+  uint32_t size, log;
+  double edr_now, edr_potential;
+};
+struct AhdrFrameOut {
+  uint32_t size;
+  float peak;
+};
+static_assert(offsetof(NeuralIn, wait_fences) == 40 && sizeof(NeuralOut) == 16 && sizeof(AhdrConfig) == 32 &&
+              offsetof(AhdrEncodeIn, wait_fences) == 32 && sizeof(AhdrEncodeOut) == 16 && sizeof(AhdrFrameIn) == 24 &&
+              sizeof(AhdrFrameOut) == 8, "ember_tone.h layout");
+
+/// One EmberFG_call with a Tone op. ctx in/out (create). Queued library log lines go to the DXMT log. 0 = no support.
+int32_t call(uint32_t op, uint64_t &ctx, uint64_t device, const void *in, uint64_t in_size, void *out, uint64_t out_size);
+/// The EMBER_* switches from the Windows environment, as "KEY=VALUE\0...\0\0".
+std::string envBlock();
+
+} // namespace embertone
+
+class EmberNeural {
+public:
+  explicit EmberNeural(WMT::Device device);
+  ~EmberNeural();
+
+  /// EMBER_NEURAL=1 (read once)
+  static bool enabled();
+
+  /// backbuffer → processed copy (library-owned texture). Pass-through when off/failed/multisampled.
+  /// fences: this Present's game fences — passes that read the backbuffer wait for them.
+  WMT::Texture encode(WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, uint32_t sample_count, const uint64_t *fences, uint32_t n_fences);
+
+private:
+  uint64_t ctx_ = 0;
+};
+
+} // namespace dxmt
diff --git a/src/dxmt/ember_pace_policy.hpp b/src/dxmt/ember_pace_policy.hpp
new file mode 100644
index 0000000..b47d6c0
--- /dev/null
+++ b/src/dxmt/ember_pace_policy.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+namespace dxmt {
+
+// Match the direct-present branches in ArgumentEncodingContext: an explicit
+// minimum interval, or optional free-running pacing without a game cap.
+constexpr bool EmberPaceEligible(bool frame_generation, double after, double game_pace, bool pace_free) {
+  return !frame_generation && (after > 0 || (game_pace < 0 && pace_free));
+}
+
+constexpr bool EmberPaceNeedsTiming(int mode, bool log, bool idle_skip, bool eligible) {
+  return log || (mode == 2 && (!idle_skip || eligible));
+}
+
+} // namespace dxmt
diff --git a/src/dxmt/ember_present_drop.hpp b/src/dxmt/ember_present_drop.hpp
new file mode 100644
index 0000000..1737509
--- /dev/null
+++ b/src/dxmt/ember_present_drop.hpp
@@ -0,0 +1,13 @@
+#pragma once
+namespace dxmt {
+// A failed drawable must still finish the game's dependency chain. The queue
+// barrier drains earlier Ember encoders before the original may be overwritten.
+template <typename Buffer, typename Barrier, typename Wait, typename Update>
+void EmberEncodeDroppedPresent(Buffer cb, Barrier barrier, Wait wait, Update update) {
+  barrier(cb);
+  auto enc = cb.blitCommandEncoder();
+  wait(enc);
+  update(enc);
+  enc.endEncoding();
+}
+} // namespace dxmt
diff --git a/src/dxmt/ember_spark.hpp b/src/dxmt/ember_spark.hpp
new file mode 100644
index 0000000..8492301
--- /dev/null
+++ b/src/dxmt/ember_spark.hpp
@@ -0,0 +1,87 @@
+/*
+ * Ember Spark hook (kiln 10-08): PE side. Forwards Present / GPU-completion events to the optional libEmberSpark.dylib
+ * (EmberCore, separate proprietary library, not part of this tree) through winemetal's EmberFG_call (ops 24..28, unix side
+ * ember_fg_unix.c). Spark itself decides how long Present holds; the sleep runs on the unix side. Without the library, with an
+ * older winemetal, with EMBER_SPARK off, or while Ember Flow is on, nothing is called and Present behaves as before.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+#include "dxmt_ember_d11.hpp"
+#include "../winemetal/ember_fg_thunks.h"
+#include <atomic>
+#include <cstring>
+#include <windows.h>
+
+namespace dxmt::emberspark {
+
+using call_fn = int32_t (*)(unixcall_ember_fg *);
+
+inline call_fn
+resolve() {
+  static call_fn fn = [] {
+    HMODULE wm = GetModuleHandleA("winemetal.dll");
+    return wm ? (call_fn)(void *)GetProcAddress(wm, "EmberFG_call") : nullptr;
+  }();
+  return fn;
+}
+
+inline int32_t
+call(uint32_t op, int64_t arg0 = 0, uint64_t arg1 = 0, int64_t arg_i64 = 0, double arg_f64 = 0) {
+  auto fn = resolve();
+  if (!fn) return 0;
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = op;
+  p.arg0 = arg0;
+  p.arg1 = arg1;
+  p.arg_i64 = arg_i64;
+  p.arg_f64 = arg_f64;
+  return fn(&p);
+}
+
+/* on/off, asked again whenever the C:\ember-d11.cfg override changes (EmberD11 reloads about once a second) */
+inline std::atomic<int> &
+state() { static std::atomic<int> s{-2}; return s; }   /* -2 unknown, 0 off, 1 on */
+
+inline bool
+active(bool frame_generation) {
+  static std::atomic<int> last_override{-100};
+  int ov = EmberD11Get(kEmberD11Spark);
+  if (ov != last_override.load(std::memory_order_relaxed)) {
+    last_override.store(ov, std::memory_order_relaxed);
+    state().store(call(EMBER_FG_OP_SPARK_STATE, ov) ? 1 : 0, std::memory_order_relaxed);
+  }
+  // latq-1018: EMBER_D11_SPARK_FG=1/2 이면 보간 중에도(GPU 가 꽉 찬 게임에서 다음 프레임을 GPU 가 비기 직전에 시작 → 큐 대기↓)
+  if (frame_generation && EmberD11Get(kEmberD11SparkFg) <= 0) return false;
+  return state().load(std::memory_order_relaxed) == 1;
+}
+
+/* the finish / commit threads only report while Present is driving Spark */
+inline std::atomic<bool> &
+driving() { static std::atomic<bool> d{false}; return d; }
+
+inline void enter(uint64_t frame, double period) { driving().store(true, std::memory_order_relaxed); call(EMBER_FG_OP_SPARK_ENTER, 0, frame, 0, period); }
+inline int32_t exit(uint64_t frame) { return call(EMBER_FG_OP_SPARK_EXIT, 0, frame); }   /* 돌려준 값 = 잔 시간(µs) */
+inline void stop() { driving().store(false, std::memory_order_relaxed); }
+inline void gpu_done(uint64_t frame, uint64_t start_ns, uint64_t end_ns, double busy_s) {
+  if (driving().load(std::memory_order_relaxed)) call(EMBER_FG_OP_SPARK_GPU, (int64_t)end_ns, frame, (int64_t)start_ns, busy_s);
+}
+inline void slot(uint32_t kind, uint64_t frame, double t_minus_now) {
+  if (driving().load(std::memory_order_relaxed)) call(EMBER_FG_OP_SPARK_SLOT, kind, frame, 0, t_minus_now);
+}
+
+/* spark2: direct-pacer sequence → frame id (commit thread writes, pacer thread reads; no class layout change) */
+inline std::atomic<uint64_t> *
+seq_map() { static std::atomic<uint64_t> m[64]; return m; }
+inline void seq_frame(uint64_t seq, uint64_t frame) {
+  if (driving().load(std::memory_order_relaxed) && frame != ~0ull) seq_map()[seq % 64].store((frame << 8) | (seq & 0xff), std::memory_order_release);
+}
+inline uint64_t frame_of_seq(uint64_t seq) {
+  uint64_t v = seq_map()[seq % 64].load(std::memory_order_acquire);
+  return v && (v & 0xff) == (seq & 0xff) ? v >> 8 : 0;
+}
+
+} // namespace dxmt::emberspark
