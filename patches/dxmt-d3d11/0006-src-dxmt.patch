+void
+Presenter::reportAne(std::chrono::steady_clock::time_point now) {
+  // (dxmt-ane) 5초마다 한 줄. 엔진 쪽 ember-fg-ane 줄(flowq_used·flowq_fallback·flowq_ane_ms)과 같이 본다.
+  if (!ane_since_.time_since_epoch().count()) ane_since_ = now;
+  const double el = std::chrono::duration<double>(now - ane_since_).count();
+  if (el < 5) return;
+  if (ane_pairs_) {
+    char line[512];
+    std::snprintf(line, sizeof(line),
+                  "dxmt-fg-ane: mode=%s late_requested=%u pairs=%llu submitted=%llu rejected=%llu ready=%llu late=%llu unavailable=%llu "
+                  "skip_off=%llu skip_split=%llu skip_other=%llu skip_backoff=%llu backoffs=%llu resets=%llu waited=%llu "
+                  "wait_avg_ms=%.3f wait_max_ms=%.3f bound_avg_ms=%.3f size=%llux%llu window_s=%.1f latency_scope=cpu_schedule",
+                  fg_.aneSource(), (unsigned)fg_.aneLate(), (unsigned long long)ane_pairs_, (unsigned long long)ane_submitted_, (unsigned long long)ane_rejected_,
+                  (unsigned long long)ane_ready_, (unsigned long long)ane_late_, (unsigned long long)ane_unavail_,
+                  (unsigned long long)ane_skip_off_, (unsigned long long)ane_skip_split_, (unsigned long long)ane_skip_other_,
+                  (unsigned long long)ane_skip_backoff_, (unsigned long long)ane_backoffs_, (unsigned long long)ane_resets_, (unsigned long long)ane_waited_,
+                  ane_waited_ ? ane_wait_sum_ * 1000 / ane_waited_ : 0.0, ane_wait_max_ * 1000,
+                  ane_waited_ ? ane_bound_sum_ * 1000 / ane_waited_ : 0.0, (unsigned long long)ane_w_, (unsigned long long)ane_h_, el);
+    Logger::info(line);
+  }
+  ane_pairs_ = ane_submitted_ = ane_rejected_ = ane_ready_ = ane_late_ = ane_unavail_ = 0;
+  ane_skip_off_ = ane_skip_split_ = ane_skip_other_ = ane_skip_backoff_ = ane_resets_ = ane_waited_ = 0;  // backoffs 는 누적
+  ane_wait_sum_ = ane_wait_max_ = ane_bound_sum_ = 0;
+  ane_since_ = now;
+}
