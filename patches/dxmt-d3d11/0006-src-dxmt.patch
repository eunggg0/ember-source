+uint32_t
+CommandQueue::EmberEarlyReadback(uint64_t upto) {
+  uint32_t n = 0;
+  uint64_t signaled = event.signaledValue();
+  uint64_t from = cpu_coherent.signaledValue() + 1;
+  // 아직 기록 중이거나 커밋만 된 청크는 안 건드린다(upto < 지금 기록 중인 청크)
+  if (upto >= CurrentSeqId())
+    return 0;
+  for (uint64_t c = from; c <= upto; c++) {
+    auto &chunk = chunks[c % kCommandChunkCount];
+    std::lock_guard<std::mutex> g(chunk.ember_rb_mu);
+    // 청크 번호·끝 이벤트는 커밋하는 스레드(= 부르는 쪽)가 쓴 값. 완료 스레드가 이미 처리해 비웠으면 visibility 가 없다
+    if (chunk.chunk_id != c || chunk.chunk_event_id > signaled)
+      break;   // GPU 가 아직 — 순서를 지키려 여기서 멈춘다
+    if (chunk.readback.visibility && !chunk.readback.visibility->issued_) {
+      chunk.readback.visibility->ember_early_sum_ = chunk.readback.visibility->emberSum();
+      chunk.readback.visibility->ember_early_ = true;
+      chunk.readback.visibility->issueAll();
+      n++;
+    }
+  }
+  return n;
+}
