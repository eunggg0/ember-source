+/* Ember(loagpu3) 링 바로 쓰기용 MetalFX — 입력은 백버퍼(또는 같은 형식의 보간 결과), 출력은 링 슬롯 형식·드로어블 크기.
+ * MetalFX 는 입력·출력 형식이 달라도 된다(RGBA8 → BGRA8 실측 확인). 못 만들면 false(예전 길). */
+bool
+Presenter::ensureDirectScaler(WMT::Texture src, WMTPixelFormat out_fmt, uint64_t out_w, uint64_t out_h) {
+  WMTFXSpatialScalerInfo info {};
+  info.color_format = src.pixelFormat();
+  info.output_format = out_fmt;
+  info.input_width = (uint32_t)src.width();
+  info.input_height = (uint32_t)src.height();
+  info.output_width = (uint32_t)out_w;
+  info.output_height = (uint32_t)out_h;
+  if (direct_scaler_ && !std::memcmp(&info, &direct_scaler_info_, sizeof(info))) return true;
+  direct_scaler_info_ = info;
+  direct_scaler_ = device_.newSpatialScaler(info);
+  if (!direct_scaler_fence_) direct_scaler_fence_ = device_.newFence();
+  Logger::info(std::string("ember-d11: 링 바로 쓰기 MetalFX ") + (direct_scaler_ ? "만듦" : "못 만듦") + " " +
+               std::to_string(info.input_width) + "x" + std::to_string(info.input_height) + " fmt " + std::to_string((unsigned)info.color_format) +
+               " → " + std::to_string(info.output_width) + "x" + std::to_string(info.output_height) + " fmt " + std::to_string((unsigned)out_fmt));
+  return (bool)direct_scaler_;
+}
+
+void
+Presenter::directUpscale(WMT::CommandBuffer cmdbuf, WMT::Texture src, WMT::Texture dst, WMT::Fence wait, WMT::Fence done) {
+  // 스왑체인 업스케일 콜백과 같은 펜스 순서: 게임 펜스·wait → (MetalFX) → done
+  auto begin = cmdbuf.blitCommandEncoder();
+  emberLabel(begin, "EmberDirect-begin");
+  for (uint32_t i = 0; i < ember_wait_n_; i++) {
+    WMT::Fence f;
+    f.handle = ember_wait_[i];
+    begin.waitForFence(f);
+  }
+  if (wait) begin.waitForFence(wait);
+  begin.updateFence(direct_scaler_fence_);
+  begin.endEncoding();
+  cmdbuf.encodeSpatialScale(direct_scaler_, src, dst, direct_scaler_fence_);
+  auto end = cmdbuf.blitCommandEncoder();
+  emberLabel(end, "EmberDirect-end");
+  end.waitForFence(direct_scaler_fence_);
+  end.updateFence(done);
+  end.endEncoding();
+}
+
+/* Ember(loadisp 10-17) 값싼 확대 — Catmull-Rom(쌍선형 9탭) + 언샤프 한 렌더 패스. cur·prev 를 w 로 섞어(cur = prev 면 w = 1) dst 크기로.
+ * 게임 펜스(wait_game)·wait 를 기다리고 done 을 올린다. 파이프라인을 못 만들면 false(호출자는 MetalFX 로). */
+bool
+Presenter::cheapUpscale(WMT::CommandBuffer cmdbuf, WMT::Texture cur, WMT::Texture prev, float w, WMT::Texture dst,
+                        std::function<void(WMT::RenderCommandEncoder)> *wait_game, WMT::Fence wait, WMT::Fence done, const char *label) {
+  if (!cur || !prev || !dst) return false;
+  auto fmt = dst.pixelFormat();
+  if (!cheap_up_pso_ || cheap_up_format_ != fmt) {
+    auto pool = WMT::MakeAutoreleasePool();
+    auto library = lib_.getLibrary();
+    auto vs = library.newFunction("vs_present_quad");
+    auto fs = library.newFunction("fs_ember_gen_up");
+    cheap_up_pso_ = {};
+    if (vs && fs) {
+      WMT::Reference<WMT::Error> error;
+      WMTRenderPipelineInfo pinfo;
+      WMT::InitializeRenderPipelineInfo(pinfo);
+      pinfo.colors[0].pixel_format = fmt;
+      pinfo.vertex_function = vs;
+      pinfo.fragment_function = fs;
+      cheap_up_pso_ = device_.newRenderPipelineState(pinfo, error);
+    }
+    cheap_up_format_ = fmt;
+    Logger::info(std::string("ember-d11: 보간 프레임 값싼 확대 ") + (cheap_up_pso_ ? "켬" : "파이프라인 못 만듦(MetalFX 로)") +
+                 " fmt " + std::to_string((unsigned)fmt));
+  }
+  if (!cheap_up_pso_) return false;
+  WMTRenderPassInfo info;
+  WMT::InitializeRenderPassInfo(info);
+  info.colors[0].load_action = WMTLoadActionDontCare;
+  info.colors[0].store_action = WMTStoreActionStore;
+  info.colors[0].texture = dst;
+  auto enc = cmdbuf.renderCommandEncoder(info);
+  emberLabel(enc, label);
+  if (wait_game) (*wait_game)(enc);
+  if (wait) enc.waitForFence(wait, WMTRenderStageFragment);
+  enc.setRenderPipelineState(cheap_up_pso_);
+  enc.setFragmentTexture(cur, 0);
+  enc.setFragmentTexture(prev, 1);
+  float wk[2] = {w, EmberD11Get(kEmberD11GenUpK) / 100.0f};
+  enc.setFragmentBytes(wk, sizeof(wk), 0);
+  enc.setViewport({0, 0, (double)dst.width(), (double)dst.height(), 0, 1});
+  enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+  enc.updateFence(done, WMTRenderStageFragment);
+  enc.endEncoding();
+  return true;
+}
