+/* Ember 링 표시 — 한 항목(보간 또는 원본)을 드로어블로 복사해 내보낸다.
+ * 보간 켬이면 레이어가 수직동기 모드라(presenter.setFrameGeneration) CA 가 present 순서대로 한 칸씩 보여 준다:
+ * 보간은 GPU 완료 즉시, 원본은 그 바로 뒤에 내보내면 보간 → 다음 칸 원본이 된다. 시각 계산은 없다.
+ * 페이서가 뒤처져 다음 게임 프레임이 이미 GPU 에서 끝났으면 보간을 건너뛴다(예전 hurry — 원본을 늦추지 않는다).
+ * 대기열(드로어블 3장)이 차면 nextDrawable 에서 페이서만 기다린다. 게임 큐 스레드는 링이 찰 때만 기다린다. */
+void CommandQueue::pacerRingItem(PacerItem &item) {
+  using clock = std::chrono::steady_clock;
+  auto pool = WMT::MakeAutoreleasePool();
+  auto &p = *item.presenter;
+  // 1) 이 슬롯이 다 그려질 때까지(청크 이벤트) — 여기서부터가 "GPU 완료 시각"
+  // (realign-1020 A, R1·R9) 상한 넘으면 이 장은 버리고 슬롯을 돌려준다(원본이면 프레임 끝으로 셈 → encode 스레드가 풀린다)
+  if (!emberPacerWaitGpu(item.gpu_value)) {
+    if (item.generated) p.noteGenDrop(1);
+    p.releaseRingSlot(item.slot, !item.generated);
+    return;
+  }
+  auto t_ready = clock::now();
+  clock::time_point t_draw = t_ready, t_done = t_ready;
+  auto behind = [&] {
+    // 다음 게임 프레임(더 큰 이벤트 값)이 이미 끝났으면 뒤처진 것
+    std::lock_guard<std::mutex> lk(pacer_mutex_);
+    for (auto &n : pacer_items_)
+      if (n.gpu_value > item.gpu_value) return event.signaledValue() >= n.gpu_value;
+    return false;
+  };
+  if (item.generated && behind()) {
+    pacer_gen_skip_++;
+    p.noteGenDrop(0);   // Ember(fgq): stale
+    p.releaseRingSlot(item.slot, false);
+    return;
+  }
+  // Ember 위상 모드 3: 표시 대기열이 밀려 있으면 보간을 버려 원본이 그 칸을 쓰게 한다. 기준은 winemetal 이 세는
+  // "낸 뒤 아직 안 뜬 드로어블 수"(presented 핸들러). 정상 60→120 은 보간이 준비될 때 앞 원본 한 장만 남아 있다(1).
+  // 2 이상이면 앞 프레임의 보간·원본이 둘 다 안 떴다 = 한 칸 밀린 것 — 게임 70fps 에서 보간+원본 140장/s 가 120Hz 를
+  // 넘쳐 드로어블 3장 대기열이 늘 차 원본이 +2칸 늦었다(실측 GPU-bound 표시 28.9ms). 가상 시간표 방식은 CA 실제와
+  // 어긋나 폭주했다(실측, 버림).
+  if (p.ringPhase() == 3) {
+    WMTLayerProps lp {};
+    lp.ember_inflight = -3; // R21: backlog accounting needs presented handlers
+    p.layer().getProps(lp);
+    static const int backlog_max = [] { const char *e = std::getenv("EMBER_FG_PHASE_BACKLOG"); return e ? std::atoi(e) : 3; }();   // 잠정 3: 핸들러가 한 칸 늦게 와 이미 뜬 장 1이 늘 섞인다(실측 정상 상태 ≈2.9)
+    if (!item.generated) lat_wait_ += lp.ember_inflight;   // 원본 기준 평균 대기 장수(로그 wait=)
+    if (item.generated && lp.ember_inflight >= backlog_max) {
+      pacer_gen_backlog_++;
+      p.releaseRingSlot(item.slot, false);
+      return;
+    }
+  }
+  // 2) 드로어블(대기열이 차 있으면 앞 장이 화면에서 내려올 때까지). 가려진 창이면 1초 뒤 0.
+  auto drawable = p.layer().nextDrawable();
+  t_draw = clock::now();
+  EmberWait().note(kWaitPacerDrawable, (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(t_draw - t_ready).count());
+  bool presented = false;
+  const int phase = p.ringPhase();
+  double wait_ms = 0;
+  if (drawable.handle) {
+    if (item.generated && behind()) {
+      pacer_gen_skip_++;   // 기다리는 동안 다음 프레임이 끝났으면 이 보간은 버린다
+      p.noteGenDrop(1);    // Ember(fgq): late
+    } else {
+      auto cb = pacerQueue.commandBuffer();
+      cb.encodeWaitForEvent(event, item.gpu_value);   // GPU 쪽 순서 보장(이미 신호됐지만 큐가 달라 명시)
+      if (p.encodeRingBlit(cb, item.slot, drawable)) {
+        if (phase == 3) {
