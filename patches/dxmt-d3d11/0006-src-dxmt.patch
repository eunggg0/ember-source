+      }
+    } else {
+      pacer_no_drawable_++;
+      p.noteGenDrop(2);
+    }
+  }
+  WMT::MetalDrawable d = carry;
+  if (!d.handle) {
+    EmberWaitScope ws(kWaitPacerDrawable);
+    d = p.layer().nextDrawable();
+  }
+  t_draw = clock::now();
+  if (!d.handle) {
+    pacer_no_drawable_++;
+    p.dqDone(f, WMT::CommandBuffer{}, false);
+    return;
+  }
+  auto cb = pacerQueue.commandBuffer();
+  if (!gen_shown) cb.encodeWaitForEvent(ev, f.signal_value);
+  if (!p.dqComposeOrig(cb, f, d)) {
+    p.dqDone(f, cb, false);
+    cb.commit();
+    return;
+  }
+  const double defer = f.plan.defer > 0 ? f.plan.defer : item.defer;
+  if (!gen_shown && item.after > 0)
+    cb.presentDrawableAfterMinimumDuration(d, item.after - std::min(item.after * 0.25, 0.002));
+  else if (gen_shown && defer > 0 && !p.ringSynced())
