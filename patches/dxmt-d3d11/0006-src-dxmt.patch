+ * PSO 를 못 만들면 아무 명령도 넣지 않고 false(합치지 않음). */
+bool
+ArgumentEncodingContext::emberInpassClear(RenderEncoderData *r0, RenderEncoderData *r1, unsigned planes) {
+  if (!planes || r1->render_target_width == 0 || r1->render_target_height == 0)
+    return false;
+  WMTPixelFormat df = r1->depth.attachment ? (WMTPixelFormat)ORIGINAL_FORMAT(EmberViewFormat(r1->depth.attachment))
+                                           : WMTPixelFormatInvalid;
+  WMTPixelFormat sf = r1->stencil.attachment ? (WMTPixelFormat)ORIGINAL_FORMAT(EmberViewFormat(r1->stencil.attachment))
+                                             : WMTPixelFormatInvalid;
+  if (((planes & 1) && df == WMTPixelFormatInvalid) || ((planes & 2) && sf == WMTPixelFormatInvalid))
+    return false;
+  unsigned samples = std::max(1u, (unsigned)r1->tile_barrier_pso_key.raster_sample_count);
+  WMTPixelFormat cf[8];
+  for (unsigned i = 0; i < 8; i++)
+    cf[i] = r1->colors[i].attachment ? (WMTPixelFormat)ORIGINAL_FORMAT(EmberViewFormat(r1->colors[i].attachment))
+                                     : WMTPixelFormatInvalid;
+  std::string key((const char *)cf, sizeof(cf));
+  key.append((const char *)&df, sizeof(df));
+  key.append((const char *)&sf, sizeof(sf));
+  key.append((const char *)&samples, sizeof(samples));
+  auto it = ember_clear_pso_.find(key);
+  if (it == ember_clear_pso_.end()) {
+    auto pool = WMT::MakeAutoreleasePool();
+    if (!ember_vs_clear_) {
+      ember_vs_clear_ = lib.getLibrary().newFunction("vs_clear_rt");
+      ember_fs_clear_ = lib.getLibrary().newFunction("fs_clear_rt_depth");
+    }
+    WMT::Reference<WMT::RenderPipelineState> pso;
+    if (ember_vs_clear_ && ember_fs_clear_) {
+      WMTRenderPipelineInfo info;
+      WMT::InitializeRenderPipelineInfo(info);
+      for (unsigned i = 0; i < 8; i++) {
+        info.colors[i].pixel_format = cf[i];
+        info.colors[i].write_mask = 0;
+      }
+      info.raster_sample_count = samples;
+      info.depth_pixel_format = df;
+      info.stencil_pixel_format = sf;
+      info.vertex_function = ember_vs_clear_;
+      info.fragment_function = ember_fs_clear_;
+      info.rasterization_enabled = true;
+      info.input_primitive_topology = WMTPrimitiveTopologyClassTriangle;
+      WMT::Reference<WMT::Error> err;
+      pso = device_.newRenderPipelineState(info, err);
+      if (!pso)
+        ERR("ember clearmerge: PSO 실패 ", err ? err.description().getUTF8String() : "");
+    }
+    it = ember_clear_pso_.emplace(key, std::move(pso)).first;
+  }
+  if (!it->second)
+    return false;
+
+  auto saved = encoder_current;
+  encoder_current = r0;
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setpso>();
+    c.type = WMTRenderCommandSetPSO;
+    c.pso = it->second;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setdepthstencilstate>();
+    c.type = WMTRenderCommandSetDepthStencilState;
+    c.depth_stencil_state = planes == 3   ? clear_rt_cmd.depth_stencil_write_state_
+                            : planes == 2 ? clear_rt_cmd.stencil_write_state_
+                                          : clear_rt_cmd.depth_write_state_;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setstencilref>();
+    c.type = WMTRenderCommandSetStencilRef;
+    c.stencil_ref = r1->stencil.clear_stencil;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setrasterizerstate>();
+    c.type = WMTRenderCommandSetRasterizerState;
+    c.fill_mode = WMTTriangleFillModeFill;
+    c.cull_mode = WMTCullModeNone;
+    c.depth_clip_mode = WMTDepthClipModeClip;
+    c.winding = WMTWindingClockwise;
+    c.depth_bias = 0;
+    c.scole_scale = 0;
+    c.depth_bias_clamp = 0;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setviewport>();
+    c.type = WMTRenderCommandSetViewport;
+    c.viewport = {0.0, 0.0, (double)r1->render_target_width, (double)r1->render_target_height, 0.0, 1.0};
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setscissorrect>();
+    c.type = WMTRenderCommandSetScissorRect;
+    c.scissor_rect = {0, 0, r1->render_target_width, r1->render_target_height};
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_setbytes>();
+    c.type = WMTRenderCommandSetFragmentBytes;
+    float *v = (float *)allocate_cpu_heap(16, 16);
+    v[0] = v[1] = v[2] = v[3] = r1->depth.clear_depth;
+    c.bytes.set(v);
+    c.length = 16;
+    c.index = kCustomBufferArgumentIndex0;
+  }
+  {
+    auto &c = encodeRenderCommand<wmtcmd_render_draw>();
+    c.type = WMTRenderCommandDraw;
+    c.primitive_type = WMTPrimitiveTypeTriangle;
+    c.vertex_start = 0;
+    c.vertex_count = 3;
+    c.base_instance = 0;
+    c.instance_count = 1;
+  }
+  encoder_current = saved;
+  ember_inpass_clears_++;
+  if (ember_prof_level_)
+    queue_.ember_prof.noteApi(kApiInpassClear);
+  return true;
+}
