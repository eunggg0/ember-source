--- /dev/null
+++ b/src/dxmt/ember_autohdr.hpp
@@ -0,0 +1,46 @@
+#pragma once
+/*
+ * Ember Flare (Auto HDR, EMBER_AUTOHDR) glue, DXMT side.
+ *
+ * SDR swapchain + EDR-capable display (potential headroom > 1.25): the presenter switches the layer to RGBA16Float + extended
+ * linear sRGB and its present shader (fs_present_quad, present_autohdr branch) expands the highlights with a gain map. The gain
+ * map (1/4 size: stops G, knee k) comes from libEmberTone.dylib (EmberCore, separate proprietary library, not part of this tree)
+ * through winemetal's EmberFG_call (ember_neural.hpp). Without the library Flare reports failed() and the SDR path is used.
+ * Switches (Windows environment): EMBER_AUTOHDR=1, EMBER_AUTOHDR_STRENGTH, EMBER_AUTOHDR_PEAK, EMBER_AUTOHDR_GAMMA, EMBER_AUTOHDR_LOG.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#include "Metal.hpp"
+#include <cstdint>
+
+namespace dxmt {
+
+class EmberAutoHDR {
+public:
+  explicit EmberAutoHDR(WMT::Device device);
+  ~EmberAutoHDR();
+
+  /// EMBER_AUTOHDR=1 (read once)
+  static bool enabled();
+
+  /// game frame → gain map (RG16Float, 1/4 size). Empty texture on failure. fences: this Present's game fences.
+  WMT::Texture encode(WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, bool source_is_srgb, const uint64_t *fences, uint32_t n_fences);
+
+  bool failed() const { return failed_; }
+  float strength() const { return strength_; }
+  float peakCap() const { return peak_cap_; }
+  bool gamma22() const { return gamma22_; }
+  float wexp() const { return wexp_; }
+  /// once per presented frame while active: display peak (SDR-white multiple) following the headroom smoothly + periodic log
+  float frame(double edr_now, double edr_potential);
+
+private:
+  void sync();
+  uint64_t ctx_ = 0;
+  float strength_ = 1.f, peak_cap_ = 0.f, wexp_ = 1.f, peak_ = 1.f;
+  bool gamma22_ = false, failed_ = true;
+};
+
+} // namespace dxmt
diff --git a/src/dxmt/ember_dq_copy.hpp b/src/dxmt/ember_dq_copy.hpp
new file mode 100644
index 0000000..caad4b4
--- /dev/null
+++ b/src/dxmt/ember_dq_copy.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <cstdint>
+
+namespace dxmt {
+// Keep blit ineligible for MSAA/format conversion or a size-changing copy.
+constexpr bool EmberDqCanBlit(bool enabled, bool fences_ready, unsigned samples, uint64_t src_format, uint64_t dst_format,
+                             uint64_t src_w, uint64_t src_h, uint64_t dst_w, uint64_t dst_h) {
+  return enabled && fences_ready && samples == 1 && src_format == dst_format && src_w == dst_w && src_h == dst_h;
+}
+
+// Explicit fences carry the same producer/consumer edges as the old render
+// copy. A raw blit without both sides tears the source or releases it too soon.
+template <typename Fence, typename Encoder, typename Command>
+void EmberDqEncodeBlit(Encoder &enc, const Command *cmd, const uint64_t *waits, uint32_t nwait,
+                      const uint64_t *updates, uint32_t nupdate) {
+  for (uint32_t i = 0; i < nwait; i++) { Fence f{}; f.handle = waits[i]; enc.waitForFence(f); }
+  enc.encodeCommands(cmd);
+  for (uint32_t i = 0; i < nupdate; i++) { Fence f{}; f.handle = updates[i]; enc.updateFence(f); }
+  enc.endEncoding();
+}
+} // namespace dxmt
diff --git a/src/dxmt/ember_fg_hook.cpp b/src/dxmt/ember_fg_hook.cpp
new file mode 100644
index 0000000..4541f6c
--- /dev/null
+++ b/src/dxmt/ember_fg_hook.cpp
@@ -0,0 +1,434 @@
+/*
+ * Ember FG hook — see ember_fg_hook.hpp.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#include "ember_fg_hook.hpp"
+#include "dxmt_ember_d11.hpp"
+#include "log/log.hpp"
+#include "util_string.hpp"
+#include "../winemetal/ember_fg_thunks.h"
+#include <cstring>
+#include <cwctype>
+#include <string>
+#include <vector>
+#include <windows.h>
+
+namespace dxmt {
+
+namespace {
+using call_fn = int32_t (*)(unixcall_ember_fg *);
+
+// (dxmt-ane 10-16) C:\ember-d11.cfg 에 적으면 Windows 환경보다 먼저 엔진에 넘기는 문자열 키. 떠 있는 STOVE·스팀이 띄운 게임엔
+// ntdll 허용 목록 밖 환경 변수가 안 닿으므로 시험은 이 파일로 한다. 엔진은 만들 때 한 번만 읽는다(바꾸면 게임 재시작).
+// (llfi 10-17) EMBER_FG_ANE_RES(auto|540|720|1080)·EMBER_ANE_HELPER(macOS arm64 ember-ane-helper 절대 경로)도 같은 길로 넘긴다.
+constexpr const char *kCfgEngineKeys[] = {"EMBER_FG_ANE", "EMBER_FG_ANE_MODELS", "EMBER_FG_ANE_TIER", "EMBER_FG_ANE_CACHE",
+                                          "EMBER_FG_ANE_RES", "EMBER_FG_ANE_LATE", "EMBER_ANE_HELPER"};
+
+bool cfg_overrides(const std::string &entry) {
+  for (const char *k : kCfgEngineKeys) {
+    size_t n = std::strlen(k);
+    if (entry.size() > n && entry[n] == '=' && !_strnicmp(entry.c_str(), k, n)) return true;
+  }
+  return false;
+}
+
+// The EmberCore switches (EMBER_*) from the Windows environment, as "KEY=VALUE\0...\0\0".
+// cfg = C:\ember-d11.cfg 의 위 키(있는 것만) — 같은 키의 환경 값은 빼고 파일 값을 넣는다.
+std::string ember_env_block(std::string *ane_mode = nullptr, bool *ane_late = nullptr) {
+  std::string out;
+  std::vector<std::string> cfg;
+  {
+    const std::string file = EmberD11Options::readFile();
+    for (const char *k : kCfgEngineKeys) {
+      std::string v;
+      if (!file.empty() && EmberD11Options::lookup(file, k, v)) cfg.push_back(std::string(k) + "=" + v);
+    }
+  }
+  std::string mode, late;
+  constexpr size_t late_len = sizeof("EMBER_FG_ANE_LATE=") - 1;
+  LPWCH env = GetEnvironmentStringsW();
+  if (env) {
+    for (LPWCH p = env; *p; p += wcslen(p) + 1) {
+      if (*p == L'=') continue;
+      if (_wcsnicmp(p, L"EMBER_", 6)) continue;
+      std::string entry = str::fromws(p);
+      bool shadowed = false;
+      for (auto &c : cfg)
+        if (cfg_overrides(entry) && !_strnicmp(entry.c_str(), c.c_str(), c.find('=') + 1)) shadowed = true;
+      if (shadowed) continue;
+      if (!_strnicmp(entry.c_str(), "EMBER_FG_ANE=", 13)) mode = entry.substr(13);
+      if (!_strnicmp(entry.c_str(), "EMBER_FG_ANE_LATE=", late_len)) late = entry.substr(late_len);
+      out += entry;
+      out.push_back('\0');
+    }
+    FreeEnvironmentStringsW(env);
+  }
+  for (auto &c : cfg) {
+    if (!_strnicmp(c.c_str(), "EMBER_FG_ANE=", 13)) mode = c.substr(13);
+    if (!_strnicmp(c.c_str(), "EMBER_FG_ANE_LATE=", late_len)) late = c.substr(late_len);
+    out += c;
+    out.push_back('\0');
+  }
+  if (!cfg.empty() && ane_mode) Logger::info("dxmt-fg: C:\\ember-d11.cfg 의 엔진 키 " + std::to_string(cfg.size()) + "개를 환경보다 먼저 씀");
+  out.push_back('\0');
+  if (ane_mode) *ane_mode = mode;
+  if (ane_late) *ane_late = mode == "llfi" && late == "1";
+  return out;
+}
+
+void forward_log(const char *buf, size_t n) {
+  size_t start = 0;
+  while (start < n) {
+    const char *nl = (const char *)std::memchr(buf + start, '\n', n - start);
+    size_t end = nl ? (size_t)(nl - buf) : n;
+    if (end > start + 2) {
+      std::string line(buf + start + 2, end - start - 2);
+      if (buf[start] == 'E') Logger::err(line);
+      else Logger::info(line);
+    }
+    start = end + 1;
+  }
+}
+} // namespace
+
+int32_t
+EmberFgHook::call(uint32_t op, const void *in, uint64_t in_size, void *out, uint64_t out_size, bool drain_log, int64_t i64, double f64,
+                  int64_t a0, uint64_t a1) {
+  if (!fn_) return 0;
+  char log[4096];
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = op;
+  p.ctx = ctx_;
+  WMT_MEMPTR_SET(p.in, in);
+  p.in_size = in_size;
+  WMT_MEMPTR_SET(p.out, out);
+  p.out_size = out_size;
+  if (drain_log) {
+    WMT_MEMPTR_SET(p.log, log);
+    p.log_cap = sizeof(log);
+  } else {
+    WMT_MEMPTR_SET(p.log, nullptr);
+  }
+  p.arg_i64 = i64;
+  p.arg_f64 = f64;
+  p.arg0 = a0;
+  p.arg1 = a1;
+  int32_t r = ((call_fn)fn_)(&p);
+  if (drain_log && p.log_len) forward_log(log, (size_t)std::min<uint64_t>(p.log_len, sizeof(log) - 1));
+  return r;
+}
+
+bool
+EmberFgHook::create(WMT::Device device) {
+  // Resolved at run time so an older winemetal.dll without the thunk simply means "no frame generation".
+  HMODULE wm = GetModuleHandleA("winemetal.dll");
+  fn_ = wm ? (void *)GetProcAddress(wm, "EmberFG_call") : nullptr;
+  if (!fn_) {
+    Logger::info("dxmt-fg: EmberFG 연결 없음(winemetal) — 프레임 보간 끔");
+    return false;
+  }
+  if (!call(EMBER_FG_OP_VERSION, nullptr, 0, nullptr, 0, false)) {
+    Logger::info("dxmt-fg: libEmberFG 없음 — 프레임 보간 끔");
+    fn_ = nullptr;
+    return false;
+  }
+  std::string ane_mode;
+  auto env = ember_env_block(&ane_mode, &ane_late_);
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  config_.size = sizeof(config_);
+  char log[4096];
+  p.op = EMBER_FG_OP_CREATE;
+  p.device = device.handle;
+  WMT_MEMPTR_SET(p.in, env.data());
+  p.in_size = env.size();
+  WMT_MEMPTR_SET(p.out, &config_);
+  p.out_size = sizeof(config_);
+  WMT_MEMPTR_SET(p.log, log);
+  p.log_cap = sizeof(log);
+  ((call_fn)fn_)(&p);
+  if (p.log_len) forward_log(log, (size_t)std::min<uint64_t>(p.log_len, sizeof(log) - 1));
+  ctx_ = p.ret ? p.ctx : 0;
+  if (!ctx_) {
+    Logger::err("dxmt-fg: libEmberFG 를 시작하지 못해 프레임 보간을 끕니다");
+    fn_ = nullptr;
+    return false;
+  }
+  // (dxmt-ane) 정확히 "flowq" 또는 (llfi 10-17) "llfi" 일 때만. 미설정·0·1(옛 full_packed)은 DXMT 에서 op 29·30 을 부르지 않는다(예전 그대로).
+  // 두 공급원은 같은 op 29·30 다리(submit/status)를 쓴다 — 공급원 선택은 엔진(libEmberFG)이 EMBER_FG_ANE 로 한다.
+  ane_flowq_ = ane_mode == "flowq" || ane_mode == "llfi";
+  ane_source_ = ane_flowq_ ? ane_mode : std::string();
+  if (ane_flowq_)
+    Logger::info("dxmt-fg: " + ane_source_ + " 보간 공급원 켬(EMBER_FG_ANE=" + ane_source_ +
+                 ") — 부드러움 모드 원본 쌍만, 준비 안 되면 예전 MC");
+  return true;
+}
+
+bool
+EmberFgHook::aneSubmit(const emberfg::AneSubmitIn &in) {
+  if (!ane_flowq_) return false;
+  // arg0 = 1: deadline_ns 는 지금부터 ns(유닉스 쪽이 mach 시각으로 바꾼다)
+  const auto started = std::chrono::steady_clock::now();
+  const bool accepted = call(EMBER_FG_OP_ANE_SUBMIT, &in, sizeof(in), nullptr, 0, true, 0, 0, 1) == 1;
+  if (ane_late_ && (in.pair_id <= 8 || in.pair_id % 60 == 0)) {
+    char line[320];
+    std::snprintf(line, sizeof(line),
+      "dxmt-fg-llfi-stage: pair=%llu stage=submit accepted=%u submit_ns=%lld budget_ms=%.3f hook_ms=%.3f clock=dxmt_steady",
+      (unsigned long long)in.pair_id, (unsigned)accepted, (long long)emberfg::now_ns(started),
+      in.deadline_ns / 1e6,
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count());
+    Logger::info(line);
+  }
+  return accepted;
+}
+
+int
+EmberFgHook::aneStatus(uint64_t pair_id) {
+  if (!ane_flowq_ || !pair_id) return emberfg::ANE_UNAVAILABLE;
+  return call(EMBER_FG_OP_ANE_STATUS, nullptr, 0, nullptr, 0, false, 0, 0, 0, pair_id);
+}
+
+EmberFgHook::~EmberFgHook() {
+  if (ctx_) call(EMBER_FG_OP_DESTROY, nullptr, 0, nullptr, 0, false);
+  ctx_ = 0;
+}
+
+void
+EmberFgHook::beginFrame(const emberfg::FrameIn &in, emberfg::FramePlan &plan) {
+  plan.size = sizeof(plan);
+  if (!call(EMBER_FG_OP_BEGIN, &in, sizeof(in), &plan, sizeof(plan), true)) {
+    std::memset(&plan, 0, sizeof(plan));
+    plan.blend_weight = 0.5f;
+  }
+}
+
+bool
+EmberFgHook::encode(const emberfg::EncodeIn &in, emberfg::EncodeOut &out) {
+  out.size = sizeof(out);
+  out.ok = 0;
+  const auto started = std::chrono::steady_clock::now();
+  const bool ok = call(EMBER_FG_OP_ENCODE, &in, sizeof(in), &out, sizeof(out), true) && out.ok;
+  if (ane_late_ && in.ane_pair_id && (in.ane_pair_id <= 8 || in.ane_pair_id % 60 == 0)) {
+    char line[320];
+    std::snprintf(line, sizeof(line),
+      "dxmt-fg-llfi-stage: pair=%llu stage=encode ok=%u status_after=%d encode_ns=%lld cpu_ms=%.3f clock=dxmt_steady",
+      (unsigned long long)in.ane_pair_id, (unsigned)ok, aneStatus(in.ane_pair_id),
+      (long long)emberfg::now_ns(started),
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count());
+    Logger::info(line);
+  }
+  return ok;
+}
+
+bool
+EmberFgHook::ringAcquire(const emberfg::RingReq &in, emberfg::RingSlots &out) {
+  out.size = sizeof(out);
+  out.ok = 0;
+  return call(EMBER_FG_OP_RING_ACQUIRE, &in, sizeof(in), &out, sizeof(out), true) && out.ok;
+}
+
+void
+EmberFgHook::ringRelease(int slot, bool frame_done) {
+  call(EMBER_FG_OP_RING_RELEASE, nullptr, 0, nullptr, 0, false, 0, 0, slot, frame_done ? 1 : 0);
+}
+
+void
+EmberFgHook::ringWaitIdle() {
+  call(EMBER_FG_OP_RING_IDLE, nullptr, 0, nullptr, 0, false);
+}
+
+int
+EmberFgHook::ringWaitIdleTimed(int64_t timeout_ns) {
+  if (!ctx_) return 1;
+  return call(EMBER_FG_OP_RING_IDLE_TIMED, nullptr, 0, nullptr, 0, false, timeout_ns);
+}
+
+bool
+EmberFgHook::dqAvailable() {
+  if (!ctx_) return false;
+  if (dq_abi_ < 0) dq_abi_ = call(EMBER_FG_OP_DQ_ABI, nullptr, 0, nullptr, 0, false);
+  return dq_abi_ >= 1;
+}
+
+uint64_t
+EmberFgHook::dqCreate(const emberfg::DqDesc &desc) {
+  if (!dqAvailable()) return 0;
+  uint64_t dq = 0;
+  if (!call(EMBER_FG_OP_DQ_CREATE, &desc, sizeof(desc), &dq, sizeof(dq), true)) return 0;
+  return dq;
+}
+
+void
+EmberFgHook::dqDestroy(uint64_t dq, int64_t timeout_ns) {
+  if (dq) call(EMBER_FG_OP_DQ_DESTROY, nullptr, 0, nullptr, 0, true, timeout_ns, 0, 0, dq);
+}
+
+int
+EmberFgHook::dqTryAcquire(uint64_t dq, const emberfg::DqAcquireIn &in, emberfg::DqSlot &out) {
+  std::memset(&out, 0, sizeof(out));
+  out.size = sizeof(out);
+  out.slot = -1;
+  if (!dq) return -2;
+  return call(EMBER_FG_OP_DQ_TRY_ACQUIRE, &in, sizeof(in), &out, sizeof(out), false, 0, 0, 0, dq);
+}
+
+int
+EmberFgHook::dqSubmit(uint64_t dq, const emberfg::DqSubmitIn &in, emberfg::FramePlan &plan) {
+  std::memset(&plan, 0, sizeof(plan));
+  plan.size = sizeof(plan);
+  plan.blend_weight = 0.5f;
+  return call(EMBER_FG_OP_DQ_SUBMIT, &in, sizeof(in), &plan, sizeof(plan), false, 0, 0, 0, dq);
+}
+
+void
+EmberFgHook::dqAbandon(uint64_t dq, int32_t slot) {
+  call(EMBER_FG_OP_DQ_ABANDON, nullptr, 0, nullptr, 0, false, 0, 0, slot, dq);
+}
+
+int
+EmberFgHook::dqPull(uint64_t dq, int64_t timeout_ns, emberfg::DqFrame &out) {
+  std::memset(&out, 0, sizeof(out));
+  out.size = sizeof(out);
+  out.slot = out.prev_slot = -1;
+  emberfg::DqPullIn in {};
+  in.size = sizeof(in);
+  in.timeout_ns = timeout_ns;
+  int r = call(EMBER_FG_OP_DQ_PULL, &in, sizeof(in), &out, sizeof(out), false, 0, 0, 0, dq);
+  return r == 0 && out.slot >= 0 ? 0 : -1;
+}
+
+bool
+EmberFgHook::dqEncodeGen(uint64_t dq, uint64_t seq, uint64_t cmdbuf, emberfg::EncodeOut &out) {
+  out.size = sizeof(out);
+  out.ok = 0;
+  emberfg::DqGenIn in {};
+  in.size = sizeof(in);
+  in.seq = seq;
+  in.command_buffer = cmdbuf;
+  return call(EMBER_FG_OP_DQ_ENCODE_GEN, &in, sizeof(in), &out, sizeof(out), true, 0, 0, 0, dq) == 1 && out.ok;
+}
+
+void
+EmberFgHook::dqPresentDone(uint64_t dq, uint64_t seq, uint64_t cmdbuf, bool shown) {
+  emberfg::DqDoneIn in {};
+  in.size = sizeof(in);
+  in.shown = shown ? 1 : 0;
+  in.seq = seq;
+  in.command_buffer = cmdbuf;
+  call(EMBER_FG_OP_DQ_PRESENT_DONE, &in, sizeof(in), nullptr, 0, false, 0, 0, 0, dq);
+}
+
+int
+EmberFgHook::dqDrain(uint64_t dq, int64_t timeout_ns) {
+  if (!dq) return 1;
+  return call(EMBER_FG_OP_DQ_DRAIN, nullptr, 0, nullptr, 0, false, timeout_ns, 0, 0, dq);
+}
+
+void
+EmberFgHook::dqStats(uint64_t dq, emberfg::DqStats &out) {
+  std::memset(&out, 0, sizeof(out));
+  out.size = sizeof(out);
+  if (dq) call(EMBER_FG_OP_DQ_STATS, nullptr, 0, &out, sizeof(out), false, 0, 0, 0, dq);
+}
+
+void
+EmberFgHook::noteDrop(uint32_t kind) {
+  call(EMBER_FG_OP_NOTE_DROP, nullptr, 0, nullptr, 0, false, 0, 0, kind);
+}
+
+void
+EmberFgHook::stats(int64_t now, emberfg::Stats &out) {
+  std::memset(&out, 0, sizeof(out));
+  out.size = sizeof(out);
+  call(EMBER_FG_OP_STATS, nullptr, 0, &out, sizeof(out), false, now);
+}
+
+std::string
+EmberFgHook::hudText(int64_t now, double game_fps, uint64_t generated) {
+  char buf[128];
+  buf[0] = 0;
+  int32_t n = call(EMBER_FG_OP_HUD, nullptr, 0, buf, sizeof(buf), false, now, game_fps, 0, generated);
+  if (n <= 0) return {};
+  return std::string(buf, std::min<size_t>((size_t)n, sizeof(buf) - 1));
+}
+
+EmberHudHook::~EmberHudHook() {
+  if (ctx_ && fn_) {
+    unixcall_ember_fg p;
+    std::memset(&p, 0, sizeof(p));
+    p.op = EMBER_FG_OP_HUD_DESTROY;
+    p.ctx = ctx_;
+    p.arg1 = idle_gate_;
+    ((call_fn)fn_)(&p);
+  }
+  ctx_ = 0;
+  idle_gate_ = 0;
+}
+
+bool
+EmberHudHook::create(WMT::Device device) {
+  if (tried_) return ctx_ != 0;
+  tried_ = true;
+  HMODULE wm = GetModuleHandleA("winemetal.dll");
+  fn_ = wm ? (void *)GetProcAddress(wm, "EmberFG_call") : nullptr;
+  if (!fn_) return false;
+  auto env = ember_env_block();
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = EMBER_FG_OP_HUD_CREATE;
+  p.device = device.handle;
+  WMT_MEMPTR_SET(p.in, env.data());
+  p.in_size = env.size();
+  uint64_t gate = 0;
+  idle_enabled_ = EmberD11Get(kEmberD11HudIdle) != 0;
+  WMT_MEMPTR_SET(p.out, idle_enabled_ ? &gate : nullptr);
+  p.out_size = idle_enabled_ ? sizeof(gate) : 0;
+  WMT_MEMPTR_SET(p.log, nullptr);
+  ((call_fn)fn_)(&p);
+  ctx_ = p.ret ? p.ctx : 0;
+  idle_gate_ = ctx_ ? gate : 0;
+  if (ctx_) Logger::info("ember-hud: 게임 화면 안 HUD 준비됨(libEmberHUD)");
+  return ctx_ != 0;
+}
+
+int
+EmberHudHook::encode(WMT::CommandBuffer cmdbuf, WMT::Texture target, uint32_t transfer, uint32_t &drawn) {
+  drawn = 0;
+  if (!ctx_ || !fn_) return 1000;
+  if (idle()) return 100;
+  emberhud::EncodeIn in {};
+  in.size = sizeof(in);
+  in.transfer = transfer;
+  in.command_buffer = cmdbuf.handle;
+  in.target = target.handle;
+  emberhud::EncodeOut out {};
+  out.size = sizeof(out);
+  out.next_call_ms = 500;
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = EMBER_FG_OP_HUD_ENCODE;
+  p.ctx = ctx_;
+  p.arg1 = idle_gate_;
+  p.arg0 = EmberD11Get(kEmberD11HudIdle) != 0;
+  WMT_MEMPTR_SET(p.in, &in);
+  p.in_size = sizeof(in);
+  WMT_MEMPTR_SET(p.out, &out);
+  p.out_size = sizeof(out);
+  WMT_MEMPTR_SET(p.log, nullptr);
+  ((call_fn)fn_)(&p);
+  idle_enabled_ = p.arg0 != 0;
+  drawn = out.drawn;
+  return out.next_call_ms < 0 ? 0 : out.next_call_ms;
+}
+
+bool
+EmberHudHook::idle() const {
+  return idle_gate_ && idle_enabled_ && EmberD11Get(kEmberD11HudIdle) != 0 &&
+         !__atomic_load_n(reinterpret_cast<const uint32_t *>(static_cast<uintptr_t>(idle_gate_)), __ATOMIC_ACQUIRE);
+}
+
+} // namespace dxmt
diff --git a/src/dxmt/ember_fg_hook.hpp b/src/dxmt/ember_fg_hook.hpp
