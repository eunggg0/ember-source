+/* ---- Ember(d11prof) ---- */
+
+static uint32_t
+EmberCountCommands(wmtcmd_base *head, uint32_t &work, bool render) {
+  uint32_t cmds = 0;
+  for (auto c = head; c; c = (wmtcmd_base *)c->next.get()) {
+    cmds++;
+    if (render) {
+      switch (c->type) {
+      case WMTRenderCommandDraw:
+      case WMTRenderCommandDrawIndexed:
+      case WMTRenderCommandDrawIndirect:
+      case WMTRenderCommandDrawIndexedIndirect:
+      case WMTRenderCommandDrawMeshThreadgroups:
+      case WMTRenderCommandDrawMeshThreadgroupsIndirect:
+      case WMTRenderCommandDXMTGeometryDraw:
+      case WMTRenderCommandDXMTGeometryDrawIndexed:
+      case WMTRenderCommandDXMTGeometryDrawIndirect:
+      case WMTRenderCommandDXMTGeometryDrawIndexedIndirect:
+      case WMTRenderCommandDXMTTessellationMeshDraw:
+      case WMTRenderCommandDXMTTessellationMeshDrawIndexed:
+      case WMTRenderCommandDXMTTessellationMeshDrawIndirect:
+      case WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect:
+      case WMTRenderCommandDispatchThreadsPerTile:
+        work++;
+        break;
+      default:
+        break;
+      }
+    } else {
+      switch (c->type) {
+      case WMTComputeCommandDispatch:
+      case WMTComputeCommandDispatchIndirect:
+      case WMTComputeCommandDispatchThreads:
+        work++;
+        break;
+      default:
+        break;
+      }
+    }
+  }
+  return cmds;
+}
+
+static uint32_t
+EmberViewFormat(TextureViewRef const &view) {
+  if (!view)
+    return 0;
+  return (uint32_t)view->allocation->descriptor->pixelFormat(view->key);
+}
+
+EmberD11PassInfo
+ArgumentEncodingContext::emberDescribe(EncoderData *e) {
+  EmberD11PassInfo p{};
+  p.kind = (uint8_t)e->type;
+  switch (e->type) {
+  case EncoderType::Render: {
+    auto r = static_cast<RenderEncoderData *>(e);
+    p.merged = r->ember_merged;
+    p.clears = r->ember_clears;
+    p.w = r->render_target_width;
+    p.h = r->render_target_height;
+    p.layers = r->render_target_array_length;
+    for (unsigned i = 0; i < r->colors.size(); i++) {
+      auto &c = r->colors[i];
+      if (!c.attachment)
+        continue;
+      if (!p.rts) {
+        p.tex0 = c.attachment.texture().handle;
+        p.fmt0 = EmberViewFormat(c.attachment);
+        p.load0 = c.load_action;
+        p.store0 = c.store_action;
+      }
+      p.rts++;
+    }
+    if (r->depth.attachment) {
+      p.has_depth = 1;
+      p.dtex = r->depth.attachment.texture().handle;
+      p.dfmt = EmberViewFormat(r->depth.attachment);
+      p.dload = r->depth.load_action;
+      p.dstore = r->depth.store_action;
+    } else if (r->stencil.attachment) {
+      p.has_depth = 1;
+      p.dtex = r->stencil.attachment.texture().handle;
+      p.dfmt = EmberViewFormat(r->stencil.attachment);
+      p.dload = r->stencil.load_action;
+      p.dstore = r->stencil.store_action;
+    }
+    p.cmds = EmberCountCommands((wmtcmd_base *)r->cmd_head.next.get(), p.draws, true);
+    break;
+  }
+  case EncoderType::Compute: {
+    auto c = static_cast<ComputeEncoderData *>(e);
+    p.cmds = EmberCountCommands((wmtcmd_base *)c->cmd_head.next.get(), p.dispatches, false);
+    break;
+  }
+  case EncoderType::Blit: {
+    auto b = static_cast<BlitEncoderData *>(e);
+    uint32_t dummy = 0;
+    p.cmds = EmberCountCommands((wmtcmd_base *)b->cmd_head.next.get(), dummy, false);
+    p.dispatches = 0;
+    break;
+  }
+  case EncoderType::Clear: {
+    auto c = static_cast<ClearEncoderData *>(e);
+    p.w = c->width;
+    p.h = c->height;
+    p.layers = c->array_length;
+    if (c->clear_dsv) {
+      p.has_depth = 1;
+      p.dtex = c->attachment.texture().handle;
+      p.dfmt = EmberViewFormat(c->attachment);
+      p.dload = WMTLoadActionClear;
+      p.dstore = WMTStoreActionStore;
+    } else {
+      p.rts = 1;
+      p.tex0 = c->attachment.texture().handle;
+      p.fmt0 = EmberViewFormat(c->attachment);
+      p.load0 = WMTLoadActionClear;
+      p.store0 = WMTStoreActionStore;
+    }
+    break;
+  }
+  case EncoderType::Resolve: {
+    auto r = static_cast<ResolveEncoderData *>(e);
+    p.rts = 1;
+    p.tex0 = r->src.texture().handle;
+    p.fmt0 = EmberViewFormat(r->src);
+    p.load0 = WMTLoadActionLoad;
+    p.store0 = WMTStoreActionStoreAndMultisampleResolve;
+    break;
+  }
+  default:
+    break;
+  }
+  return p;
+}
+
+void
+ArgumentEncodingContext::emberProfPass(EncoderData *e, EmberD11PassInfo &info) {
+  auto &prof = queue_.ember_prof;
+  prof.notePass(info);
+  if (e->type == EncoderType::Render) {
+    auto r = static_cast<RenderEncoderData *>(e);
+    for (auto &c : r->colors)
+      if (c.attachment)
+        prof.noteColorAction(c.load_action, c.store_action);
+  }
+}
+
+unsigned
+ArgumentEncodingContext::emberSignatureMismatch(RenderEncoderData *r0, RenderEncoderData *r1) {
+  /* isEncoderSignatureMatched 와 같은 순서로 — 처음 어긋난 조건 */
+  if (r0->render_target_count != r1->render_target_count)
+    return kSplitRtCount;
+  if (r0->dsv_planar_flags != r1->dsv_planar_flags)
+    return kSplitDsvFlags;
+  if (r0->dsv_readonly_flags != r1->dsv_readonly_flags && (!ember_romerge_ || r0->ember_samples_ds || r1->ember_samples_ds))
+    return kSplitDsvFlags;
+  if (r0->render_target_array_length != r1->render_target_array_length)
+    return kSplitArrayLen;
+  if (r0->allocated_argbuf != r1->allocated_argbuf)
+    return kSplitArgbuf;
+  if (r0->dsv_planar_flags & 1) {
+    if (r0->depth.attachment != r1->depth.attachment)
+      return kSplitDepthTarget;
+    if (r0->dsv_readonly_flags & r1->dsv_readonly_flags & 1) {
+      if (r1->depth.load_action == WMTLoadActionClear)
+        return kSplitDepthLoadStore;
+    } else if (r0->depth.store_action != WMTStoreActionStore || r1->depth.load_action != WMTLoadActionLoad)
+      return kSplitDepthLoadStore;
+  }
+  if (r0->dsv_planar_flags & 2) {
+    if (r0->stencil.attachment != r1->stencil.attachment)
+      return kSplitStencil;
+    if (!(r0->dsv_readonly_flags & r1->dsv_readonly_flags & 2) &&
+        (r0->stencil.store_action != WMTStoreActionStore || r1->stencil.load_action != WMTLoadActionLoad))
+      return kSplitStencil;
+    if ((r0->dsv_readonly_flags & r1->dsv_readonly_flags & 2) && r1->stencil.load_action == WMTLoadActionClear)
+      return kSplitStencil;
+  }
+  for (unsigned i = 0; i < r0->render_target_count; i++) {
+    auto &a0 = r0->colors[i];
+    auto &a1 = r1->colors[i];
+    if (a0.attachment != a1.attachment || a0.depth_plane != a1.depth_plane)
+      return kSplitColorTarget;
+    if (!a0.attachment)
+      continue;
+    if (a0.store_action != WMTStoreActionStore || a1.load_action != WMTLoadActionLoad)
+      return kSplitColorLoadStore;
+  }
+  if (r1->fence_wait_vertex.intersectedWith(r0->fence_update))
+    return kSplitFenceVertex;
+  return kSplitUnknown;
+}
