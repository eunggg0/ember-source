+// spinless-1019: WaitOnAddress/WakeByAddressAll 은 kernelbase 에서 실행 중에 찾는다(가져오기 목록 그대로)
+typedef BOOL(WINAPI *ember_wait_on_address_t)(volatile void *, void *, SIZE_T, DWORD);
+typedef void(WINAPI *ember_wake_by_address_t)(void *);
+static ember_wait_on_address_t ember_wait_on_address;
+static ember_wake_by_address_t ember_wake_by_address_all;
+static bool
+emberAddrApis() {
+  static int state = 0;   // 0 모름, 1 있음, 2 없음
+  if (state == 0) {
+    HMODULE m = GetModuleHandleA("kernelbase.dll");
+    if (m) {
+      ember_wait_on_address = (ember_wait_on_address_t)(void *)GetProcAddress(m, "WaitOnAddress");
+      ember_wake_by_address_all = (ember_wake_by_address_t)(void *)GetProcAddress(m, "WakeByAddressAll");
+    }
+    state = (ember_wait_on_address && ember_wake_by_address_all) ? 1 : 2;
+  }
+  return state == 1;
+}
+
+void
+CommandQueue::emberWakeAddr(void *addr) {
+  if (emberAddrApis())
+    ember_wake_by_address_all(addr);
+}
