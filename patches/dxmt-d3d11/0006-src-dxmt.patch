+      ember_pace_auto_on_.store(on ? 0 : 1, std::memory_order_relaxed);
+      pa_switches_++;
+      pa_cnt_ = 0;
+      pa_dwell_ = 0;
+      char msg[128];
+      std::snprintf(msg, sizeof(msg), "ember-d11: pace auto %s (gpu util %.2f, switch #%u)", on ? "OFF" : "ON", e, pa_switches_);
+      Logger::info(msg);
+      if (EmberD11Get(kEmberD11PaceLog))
+        if (FILE *f = fopen("C:\\ember-d11pace.log", "ab")) { fprintf(f, "%s\n", msg); fclose(f); }
+    }
+  }
+  if (EmberD11Get(kEmberD11PaceLog)) {
+    auto now = std::chrono::steady_clock::now();
+    if (!pa_log_since_.time_since_epoch().count()) pa_log_since_ = now;
+    else if (std::chrono::duration<double>(now - pa_log_since_).count() >= 5.0) {
+      pa_log_since_ = now;
