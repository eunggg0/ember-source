+                  (unsigned long long)st.wedges, st.broken, st.max_acquire_wait_ns / 1e6, st.max_game_call_ns / 1e6,
+                  st.max_queue_ns / 1e6, st.max_display_ns / 1e6, st.max_gpu_wait_ns / 1e6, el);
+    Logger::info(line);
   }
+  dq_n_pull_ = dq_n_gen_ = dq_n_orig_ = dq_n_nogen_ = dq_n_srcwait_to_ = dq_n_setbusy_ = 0;
