+void
+Presenter::autoDrawables(std::chrono::steady_clock::time_point now, double target) {
+  if (!draw2_req_ || frame_generation_) return;
+  const int mode = EmberD11Get(kEmberD11Draw2);
+  int want = draw2_cur_;
+  if (mode == 0) want = 3;
+  else if (mode == 1) want = 2;
+  else {
+    if (draw2_last_.time_since_epoch().count()) {
+      const double dt = std::chrono::duration<double>(now - draw2_last_).count();
+      if (dt > 0 && dt < 0.25) draw2_ema_ = draw2_ema_ > 0 ? draw2_ema_ + (dt - draw2_ema_) * 0.05 : dt;
+    }
+    if (draw2_dwell_ < 1000000) draw2_dwell_++;
+    if (target > 0 && draw2_ema_ > 0) {
+      // 2장인데 목표보다 8% 넘게 느리면(GPU·CPU 한계) 60 프레임 뒤 3장, 3장인데 3% 안으로 따라오면 120 프레임 뒤 2장. 바꾼 뒤 180 프레임은 그대로
+      const bool slow = draw2_ema_ > target * 1.08, keep = draw2_ema_ < target * 1.03;
+      if (draw2_cur_ == 2 ? slow : keep) draw2_cnt_++;
+      else draw2_cnt_ = 0;
+      if (draw2_dwell_ >= 180 && draw2_cnt_ >= (draw2_cur_ == 2 ? 60 : 120)) want = draw2_cur_ == 2 ? 3 : 2;
+    }
+  }
+  draw2_last_ = now;
+  if (want != draw2_cur_ && (want == 2 || want == 3)) {
+    char msg[160];
+    std::snprintf(msg, sizeof(msg), "ember-d11: 화면 대기열 %d장 → %d장 (DRAW2=%d, 간격 %.2fms / 목표 %.2fms)", draw2_cur_, want, mode,
+                  draw2_ema_ * 1000, target * 1000);
+    Logger::info(msg);
+    draw2_cur_ = want;
+    draw2_cnt_ = 0;
+    draw2_dwell_ = 0;
+    layer_props_.ember_max_drawables = want;
+    layer_.setProps(layer_props_);   // 드물게(바뀔 때만) — 메인 스레드 동기 호출
+  }
 }
 
