+// Wine 은 유닉스 select 로 µs 정밀)을 쓴다. 없으면 Sleep(1).
+static void
+emberAneNap(std::chrono::steady_clock::duration d) {
+#ifdef _WIN32
+  using delay_fn = LONG(WINAPI *)(BOOLEAN, PLARGE_INTEGER);
+  static delay_fn delay = [] {
+    HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+    return ntdll ? (delay_fn)(void *)GetProcAddress(ntdll, "NtDelayExecution") : (delay_fn) nullptr;
+  }();
+  const int64_t units = std::max<int64_t>(1, std::chrono::duration_cast<std::chrono::nanoseconds>(d).count() / 100);
+  if (delay) {
+    LARGE_INTEGER li;
+    li.QuadPart = -units;
+    delay(FALSE, &li);
+  } else {
+    Sleep(1);
+  }
+#else
+  std::this_thread::sleep_for(d);
+#endif
+}
