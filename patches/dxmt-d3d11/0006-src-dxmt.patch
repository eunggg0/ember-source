+/* (realign-1020 A, R1·R3 계측) 대기 지점별 최대·횟수. 게임 경로는 원자 연산만 하고, 줄 쓰기는 설정 감시 스레드가 5초마다(EMBER_D11_WAITLOG=1).
+ * 값은 ns. 각 지점: 0 링 슬롯 대여(encode) 1 링 비우기(레이어 무효화) 2 페이서 GPU 이벤트 3 페이서 nextDrawable 4 페이서 복사 완료
+ * 5 프레임 지연 펜스(게임) 6 레이어 무효화 전체(게임) 7 encode nextDrawable(직접 경로) 8 커밋 격자 잠 9 설정 파일 읽기(감시 스레드) */
+enum EmberWaitPoint : unsigned {
+  kWaitRingAcquire, kWaitRingIdle, kWaitPacerEvent, kWaitPacerDrawable, kWaitPacerBlit,
+  kWaitFrameLatency, kWaitLayerSync, kWaitEncodeDrawable, kWaitCommitGrid, kWaitCfgRead, kWaitPointCount
+};
+struct EmberWaitStats {
+  std::atomic<uint64_t> max_ns[kWaitPointCount] = {};
+  std::atomic<uint64_t> sum_ns[kWaitPointCount] = {};
+  std::atomic<uint64_t> n[kWaitPointCount] = {};
+  std::atomic<uint64_t> over50[kWaitPointCount] = {};   /* 50ms 넘은 횟수 */
+  std::atomic<uint64_t> timeouts[kWaitPointCount] = {}; /* 상한에 걸려 포기한 횟수(원본만·버림) */
+  void note(unsigned k, uint64_t ns) {
+    n[k].fetch_add(1, std::memory_order_relaxed);
+    sum_ns[k].fetch_add(ns, std::memory_order_relaxed);
+    if (ns > 50000000ull) over50[k].fetch_add(1, std::memory_order_relaxed);
+    uint64_t m = max_ns[k].load(std::memory_order_relaxed);
+    while (ns > m && !max_ns[k].compare_exchange_weak(m, ns, std::memory_order_relaxed)) {}
+  }
+  void timeout(unsigned k) { timeouts[k].fetch_add(1, std::memory_order_relaxed); }
+};
+inline EmberWaitStats &
+EmberWait() {
+  static EmberWaitStats s;
+  return s;
+}
+/* 지점 이름(로그용) */
+inline const char *
+EmberWaitName(unsigned k) {
+  static const char *names[kWaitPointCount] = {"ring_acq", "ring_idle", "pacer_ev", "pacer_draw", "pacer_blit",
+                                               "frame_lat", "layer_sync", "enc_draw", "commit_grid", "cfg_read"};
+  return names[k];
+}
+/* 범위 계측: 생성~소멸 시간을 지점 k 에 적는다 */
+struct EmberWaitScope {
+  unsigned k;
+  std::chrono::steady_clock::time_point t0;
+  explicit EmberWaitScope(unsigned k_) : k(k_), t0(std::chrono::steady_clock::now()) {}
+  ~EmberWaitScope() {
+    EmberWait().note(k, (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+  }
+};
+
+/* 5초 요약 한 줄(설정 감시 스레드가 부른다). 읽은 값은 0 으로. */
+inline void
+EmberWaitReport(double el) {
+  auto &w = EmberWait();
+  std::string line = "ember-wait:";
+  char buf[128];
+  for (unsigned k = 0; k < kWaitPointCount; k++) {
+    uint64_t n = w.n[k].exchange(0, std::memory_order_relaxed), sum = w.sum_ns[k].exchange(0, std::memory_order_relaxed);
+    uint64_t mx = w.max_ns[k].exchange(0, std::memory_order_relaxed), o = w.over50[k].exchange(0, std::memory_order_relaxed);
+    uint64_t to = w.timeouts[k].exchange(0, std::memory_order_relaxed);
+    if (!n && !to) continue;
+    std::snprintf(buf, sizeof(buf), " %s=n%llu/avg%.2f/max%.2f/o50:%llu/to%llu", EmberWaitName(k), (unsigned long long)n,
+                  n ? sum / 1e6 / n : 0.0, mx / 1e6, (unsigned long long)o, (unsigned long long)to);
+    line += buf;
+  }
+  std::snprintf(buf, sizeof(buf), " window_s=%.1f", el);
+  line += buf;
+  Logger::info(line);
+}
+
+/* (realign-1020 A, R16~18) 설정 파일 감시: 예전엔 완료 스레드(TIME_CRITICAL)가 쿼리 신호(cpu_coherent) 앞에서 약 1초마다 fopen 했다.
+ * 이제 이 함수는 처음 불릴 때 낮은 우선순위 감시 스레드를 한 번 띄우기만 하고 바로 돌아온다(DllMain 밖에서 불려야 해서 지연 시작).
+ * 감시 스레드: 1초마다 C:\ember-d11.cfg 를 읽어 값 갱신, EMBER_D11_WAITLOG=1 이면 5초마다 ember-wait 줄. */
+inline void
+EmberD11MaybeReload() {
+  auto &o = EmberD11();
+  int64_t last = o.last_reload_ms.load(std::memory_order_relaxed);
+  if (last != 1)   // 1 = 생성자만 읽음(감시 스레드 아직 없음)
+    return;
+  if (!o.last_reload_ms.compare_exchange_strong(last, 2))
+    return;
+#ifdef _WIN32
+  HANDLE h = CreateThread(nullptr, 0, [](LPVOID) -> DWORD {
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    auto &opts = EmberD11();
+    auto since = std::chrono::steady_clock::now();
+    for (;;) {
+      Sleep(1000);
+      {
+        EmberWaitScope ws(kWaitCfgRead);
+        opts.reload();
+      }
+      auto now = std::chrono::steady_clock::now();
+      double el = std::chrono::duration<double>(now - since).count();
+      if (el >= 5.0) {
+        if (EmberD11Get(kEmberD11WaitLog)) EmberWaitReport(el);
+        since = now;
+      }
+    }
+    return 0;
+  }, nullptr, 0, nullptr);
+  if (h) CloseHandle(h);
+  else o.last_reload_ms.store(1, std::memory_order_relaxed);
+#endif
+}
+
+inline uint64_t
+EmberD11NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+/* 한 Metal 인코더(최적화로 합쳐진 뒤)의 요약 */
+struct EmberD11PassInfo {
+  uint8_t kind = 0; /* EncoderType 값 */
+  uint8_t rts = 0;  /* 실제 붙은 색 첨부 수 */
+  uint8_t load0 = 0, store0 = 0, dload = 0, dstore = 0;
+  uint8_t has_depth = 0;
+  uint16_t merged = 0; /* 합쳐진 D3D11 패스 수(자기 포함) */
+  uint16_t clears = 0; /* 접힌 지우기 수 */
+  uint32_t fmt0 = 0, dfmt = 0;
+  uint32_t w = 0, h = 0, layers = 0;
+  uint32_t draws = 0, dispatches = 0, cmds = 0;
+  uint64_t tex0 = 0, dtex = 0;
+
+  uint64_t
+  key() const {
+    uint64_t h1 = kind * 0x9E3779B97F4A7C15ull;
+    auto mix = [&](uint64_t v) { h1 = (h1 ^ v) * 0x100000001B3ull + (h1 >> 29); };
+    mix(rts);
+    mix(fmt0);
+    mix(dfmt);
+    mix(((uint64_t)w << 32) | h);
+    mix(tex0);
+    mix(dtex);
+    mix((load0 << 24) | (store0 << 16) | (dload << 8) | dstore);
+    return h1;
+  }
+};
