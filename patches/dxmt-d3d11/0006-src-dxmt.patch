+/* ---------------------------------------------------------------- (realign-1020 B) Ember 표시 큐 */
+
+Presenter::~Presenter() {
+  if (dq_) fg_.dqDestroy(dq_, 500000000ll);
+  dq_ = 0;
+}
+
+bool
+Presenter::dqWanted(bool framegen, bool pre_up) {
+  {
+    // 처음 한 번과 조건이 바뀔 때만 이유를 남긴다(진단)
+    static int last = -1;
+    int why = !framegen ? 1 : !frame_generation_ ? 2 : dq_failed_ ? 3 : !fg_.ok() ? 4 : EmberD11Get(kEmberD11Dq) != 1 ? 5
+            : fg_.config().ring_phase != 0 ? 6 : fg_.aneLate() ? 7 : fg_.config().smooth ? 8 : autohdr_active_ ? 9 : !dump_dir_.empty() ? 10 : 0;
+    if (why != last) {
+      static const char *k[] = {"켬", "보간 준비 안 됨", "보간 끔", "고장", "엔진 없음", "스위치 끔(EMBER_D11_DQ)", "위상 모드", "뉴럴 LATE",
+                                "부드러움 모드", "AutoHDR", "덤프"};
+      Logger::info(std::string("ember-d11: 표시 큐 조건 ") + k[why]);
+      last = why;
+    }
+  }
+  if (!framegen || !frame_generation_ || dq_failed_ || !fg_.ok()) return false;
+  if (EmberD11Get(kEmberD11Dq) != 1) return false;
+  // 옛 링에만 있는 실험 경로는 옛 길 그대로: 위상 모드·뉴럴(FlowQ/LLFI)·부드러움 HOLD·AutoHDR(이득 지도 1장)·덤프
+  // 뉴럴 길잡이(LLFI PRIOR, 로아 FEX 기본)는 엔진 encode 안에서 돌아 표시 큐에서도 그대로 — LATE(원본 한 장 늦게)만 옛 길
+  if (fg_.config().ring_phase != 0 || fg_.aneLate() || fg_.config().smooth || autohdr_active_ || !dump_dir_.empty()) return false;
+  (void)pre_up;
+  return true;
+}
+
+bool
+Presenter::encodeDqSource(WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, const DXMTPresentMetadata &metadata,
+                          std::function<void(WMT::RenderCommandEncoder)> &wait_fences,
+                          std::function<void(WMT::RenderCommandEncoder)> &update_fences, bool pre_up, double disp,
+                          std::chrono::steady_clock::time_point now, Drawables &out) {
+  if (!dq_) {
+    emberfg::DqDesc d {};
+    d.size = sizeof(d);
+    d.slots = 6;   // 페이서가 표시 cb 를 겹쳐 띄우므로(보간·원본 2장 + 앞 원본 보유) 빼앗을 여유를 둔다(EmberCore 권고)
+    d.width = backbuffer.width();
+    d.height = backbuffer.height();
+    d.pixel_format = (uint64_t)backbuffer.pixelFormat();
+    d.present_mode = emberfg::DQ_PRESENT_CPU_TIMED;
+    d.flags = emberfg::DQ_F_HOST_THREAD;
+    dq_ = fg_.dqCreate(d);
+    if (!dq_) {
+      dq_failed_ = true;
+      Logger::info("ember-d11: Ember 표시 큐 없음(libEmberFG 1.5 dq·winemetal 필요) — 옛 링 표시");
+      return false;
+    }
+    Logger::info("ember-d11: Ember 표시 큐 켬 — 게임 cb 는 원본 복사+신호만, 보간·확대·표시는 페이서 큐");
+  }
+  emberfg::DqAcquireIn ain {};
+  ain.size = sizeof(ain);
+  ain.width = backbuffer.width();
+  ain.height = backbuffer.height();
+  ain.pixel_format = (uint64_t)backbuffer.pixelFormat();
+  ain.max_wait_ns = 0;   // 게임은 기다리지 않는다(P1)
+  emberfg::DqSlot slot {};
+  int r;
+  {
+    EmberWaitScope ws(kWaitRingAcquire);
+    r = fg_.dqTryAcquire(dq_, ain, slot);
+  }
+  if (r == -2) {
+    dq_failed_ = true;
+    Logger::info("ember-d11: Ember 표시 큐 고장 표시(감시가 3번 연속 풀었음) — 옛 링 표시로");
+    return false;
+  }
+  auto fence_only = [&](const char *label) {
+    if (!fence_pass_tex_) {
+      WMTTextureInfo ti;
+      ti.type = WMTTextureType2D;
+      ti.pixel_format = WMTPixelFormatBGRA8Unorm;
+      ti.usage = WMTTextureUsageRenderTarget;
+      ti.options = WMTResourceStorageModePrivate;
+      ti.width = 16;
+      ti.height = 16;
+      ti.depth = 1;
+      ti.mipmap_level_count = 1;
+      ti.sample_count = 1;
+      ti.array_length = 1;
+      fence_pass_tex_ = device_.newTexture(ti);
+    }
+    WMTRenderPassInfo finfo;
+    WMT::InitializeRenderPassInfo(finfo);
+    finfo.colors[0].load_action = WMTLoadActionDontCare;
+    finfo.colors[0].store_action = WMTStoreActionDontCare;
+    finfo.colors[0].texture = fence_pass_tex_;
+    auto fenc = cmdbuf.renderCommandEncoder(finfo);
+    emberLabel(fenc, label);
+    wait_fences(fenc);
+    update_fences(fenc);
+    fenc.endEncoding();
+  };
+  if (r != 0 || slot.slot < 0) {
+    // 슬롯 없음(표시가 크게 밀림) — 이 원본은 버리고 게임은 진행
+    EmberWait().timeout(kWaitRingAcquire);
+    fence_only("EmberDq-drop");
+    out.dropped = true;
+    return true;
+  }
+  WMT::Texture dst;
+  dst.handle = slot.texture;
+  const WMTPixelFormat fmt = dst.pixelFormat();
+  // Raw blit preserves source bits and avoids a full-screen shader/sample/store pass.
+  // Explicit game fences are mandatory: queue order alone does not order Metal encoders.
+  const bool blit_copy = EmberDqCanBlit(EmberD11Get(kEmberD11DqBlit) == 1, ember_update_ready_, sample_count_,
+      backbuffer.pixelFormat(), fmt, backbuffer.width(), backbuffer.height(), dst.width(), dst.height());
+  if (blit_copy) {
+    auto enc = cmdbuf.blitCommandEncoder();
+    emberLabel(enc, "EmberDq-blit");
+    wmtcmd_blit_copy_from_texture_to_texture cmd {};
+    cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+    cmd.next.set(nullptr);
+    cmd.src = backbuffer.handle;
+    cmd.src_size = {backbuffer.width(), backbuffer.height(), 1};
+    cmd.dst = dst.handle;
+    EmberDqEncodeBlit<WMT::Fence>(enc, (const wmtcmd_blit_nop *)&cmd,
+        ember_wait_, ember_wait_n_, ember_update_, ember_update_n_);
+  } else {
+    if (!dq_copy_pso_ || dq_copy_format_ != fmt) {
+      auto pool = WMT::MakeAutoreleasePool();
+      auto library = lib_.getLibrary();
+      auto vs = library.newFunction("vs_present_quad");
+      auto fs = library.newFunction("fs_ember_fg_copy");
+      dq_copy_pso_ = {};
+      if (vs && fs) {
+        WMT::Reference<WMT::Error> error;
+        WMTRenderPipelineInfo pinfo;
+        WMT::InitializeRenderPipelineInfo(pinfo);
+        pinfo.colors[0].pixel_format = fmt;
+        pinfo.vertex_function = vs;
+        pinfo.fragment_function = fs;
+        dq_copy_pso_ = device_.newRenderPipelineState(pinfo, error);
+      }
+      dq_copy_format_ = fmt;
+    }
+    if (!dq_copy_pso_) {
+      fg_.dqAbandon(dq_, slot.slot);
+      dq_failed_ = true;
+      Logger::err("ember-d11: 표시 큐 복사 파이프라인을 못 만들어 옛 링 표시로");
+      return false;
+    }
+    // 1) 원본 → 슬롯(게임 펜스를 기다리고, 다 읽은 뒤 게임이 다음 프레임을 쓰게 펜스를 올린다)
+    WMTRenderPassInfo cinfo;
+    WMT::InitializeRenderPassInfo(cinfo);
+    cinfo.colors[0].load_action = WMTLoadActionDontCare;
+    cinfo.colors[0].store_action = WMTStoreActionStore;
+    cinfo.colors[0].texture = dst;
+    auto cenc = cmdbuf.renderCommandEncoder(cinfo);
+    emberLabel(cenc, "EmberDq-copy");
+    wait_fences(cenc);
+    cenc.setRenderPipelineState(dq_copy_pso_);
+    cenc.setFragmentTexture(backbuffer, 0);
+    cenc.setViewport({0, 0, (double)dst.width(), (double)dst.height(), 0, 1});
+    cenc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+    update_fences(cenc);
+    cenc.endEncoding();
+  }
+  // 2) 슬롯 이벤트 신호(표시 cb 가 GPU 에서 이것을 기다린다 — 게임 cb 는 아무것도 기다리지 않는다)
+  {
+    WMT::Event ev;
+    ev.handle = slot.event;
+    cmdbuf.encodeSignalEvent(ev, slot.signal_value);
+  }
+  // 3) 넘기기(엔진은 CPU 만, 짧음). host_tag 로 이 원본의 표시 메타를 페이서가 찾는다
+  const uint64_t tag = dq_tag_next_.fetch_add(1, std::memory_order_relaxed);
+  dq_tag_[tag % 32].meta = metadata;
+  dq_tag_[tag % 32].pre_up = pre_up;
+  emberfg::DqSubmitIn sin {};
+  sin.size = sizeof(sin);
+  sin.slot = slot.slot;
+  sin.frame.base.size = sizeof(sin.frame);
+  sin.frame.base.flags = emberfg::IN_FRAMEGEN | (pre_up ? emberfg::IN_PRE_UP : 0u);
+  sin.frame.base.now_ns = emberfg::now_ns(now);
+  sin.frame.base.frame_no = frame_no_;
+  sin.frame.base.display_interval = disp;
+  sin.frame.base.display_latency_ms = display_latency_ms_.load(std::memory_order_relaxed);
+  sin.host_tag = tag;
+  emberfg::FramePlan plan {};
+  {
+    std::lock_guard<std::mutex> lk(ring_gate_mu_);
+    dq_inflight_++;   // 페이서 항목이 끝나면 dqItemDone
+  }
+  if (fg_.dqSubmit(dq_, sin, plan) != 0) {
+    fg_.dqAbandon(dq_, slot.slot);
+    dqItemDone();
+    out.dropped = true;
+    return true;
+  }
+  cadence_hold_.store(plan.cadence_hold, std::memory_order_relaxed);
+  out.dq = true;
+  out.defer = plan.defer;
+  return true;
+}
+
+bool
+Presenter::dqPull(emberfg::DqFrame &f) {
+  if (!dq_) return false;
+  bool ok = fg_.dqPull(dq_, 0, f) == 0;
+  if (ok) dq_n_pull_++;
+  return ok;
+}
+
+bool
+Presenter::dqWaitSource(const emberfg::DqFrame &f, int ms) {
+  WMT::SharedEvent ev;
+  ev.handle = f.event;
+  if (ev.signaledValue() >= f.signal_value) return true;
+  {
+    EmberWaitScope ws(kWaitPacerEvent);
+    ev.waitUntilSignaledValue(f.signal_value, ms > 0 ? (uint64_t)ms : 1000);
+  }
+  if (ev.signaledValue() >= f.signal_value) return true;
+  EmberWait().timeout(kWaitPacerEvent);
+  dq_n_srcwait_to_++;
+  return false;
+}
+
+bool
+Presenter::dqComposeGen(WMT::CommandBuffer cb, const emberfg::DqFrame &f, WMT::MetalDrawable drawable) {
+  if (!(f.plan.flags & emberfg::PLAN_GENERATE) || !(f.plan.flags & emberfg::PLAN_MC) || f.prev_slot < 0) return false;
+  emberfg::EncodeOut eo {};
+  if (!fg_.dqEncodeGen(dq_, f.seq, cb.handle, eo) || !eo.texture) {
+    dq_n_nogen_++;
+    return false;
+  }
+  WMT::Texture src;
+  src.handle = eo.texture;
+  WMT::Fence fe;
+  fe.handle = eo.fence;
+  bool ok = dqComposeTo(cb, src, fe, f.host_tag, true, drawable.texture());
+  if (ok) { dq_n_gen_++; generated_frames_++; }
+  return ok;
+}
+
+bool
+Presenter::dqComposeOrig(WMT::CommandBuffer cb, const emberfg::DqFrame &f, WMT::MetalDrawable drawable) {
+  WMT::Texture src;
+  src.handle = f.texture;
+  bool ok = dqComposeTo(cb, src, WMT::Fence{}, f.host_tag, false, drawable.texture());
+  if (ok) dq_n_orig_++;
+  return ok;
+}
+
+void
+Presenter::dqDone(const emberfg::DqFrame &f, WMT::CommandBuffer cb, bool shown) {
+  fg_.dqPresentDone(dq_, f.seq, cb.handle, shown);
+}
+
+bool
+Presenter::dqComposeTo(WMT::CommandBuffer cb, WMT::Texture src, WMT::Fence src_fence, uint64_t host_tag, bool gen,
+                       WMT::Texture dst, WMT::Texture up_only) {
+  const DqTag tag = dq_tag_[host_tag % 32];
+  // up_only 가 있으면: 확대만 그 텍스처(원본 형식·dst 크기)에 하고 표시 패스는 안 한다(페이서가 드로어블에 한 번 — GENDIRECT)
+  if (up_only) dst = up_only;
+  if (!dst || !src) return false;
+  const uint64_t W = dst.width(), H = dst.height();
+  WMT::Texture show = src;
+  WMT::Fence show_fence = src_fence;
+  if (tag.pre_up && (src.width() != W || src.height() != H)) {
+    // MetalFX 앞 보간(EMBER_FG_PRE_UPSCALE): 원본·보간 모두 렌더 해상도 → 여기(페이서 큐)서 키운다. 형식은 원본과 같게(표시 패스 sRGB 처리 그대로)
+    const WMTPixelFormat ufmt = src.pixelFormat();
+    if (!up_only && (!dq_up_ || dq_up_.width() != W || dq_up_.height() != H || dq_up_.pixelFormat() != ufmt)) {
+      WMTTextureInfo info;
+      info.type = WMTTextureType2D;
+      info.pixel_format = ufmt;
+      info.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageRenderTarget | (EmberD11Get(kEmberD11DqSw) == 1 ? WMTTextureUsageShaderWrite : 0));   // ShaderWrite 면 무손실 압축 꺼짐(대역폭↑)
+      info.options = WMTResourceStorageModePrivate;
+      info.width = W;
+      info.height = H;
+      info.depth = 1;
+      info.mipmap_level_count = 1;
+      info.sample_count = 1;
+      info.array_length = 1;
+      dq_up_ = device_.newTexture(info);
+    }
+    if (!dq_up_fence_) dq_up_fence_ = device_.newFence();
+    WMT::Texture up_tex = up_only ? up_only : (WMT::Texture)dq_up_;
+    if (!dq_scaler_fence_) dq_scaler_fence_ = device_.newFence();
+    bool scaled = false;
+    if (up_tex && gen && EmberD11Get(kEmberD11GenUp) == 1) {
+      // 보간 장은 값싼 확대(Catmull-Rom+언샤프 한 패스) — 옛 길 genup 과 같은 셰이더
+      if (!dq_cheap_pso_ || dq_cheap_format_ != ufmt) {
+        auto pool = WMT::MakeAutoreleasePool();
+        auto library = lib_.getLibrary();
+        auto vs = library.newFunction("vs_present_quad");
+        auto fs = library.newFunction("fs_ember_gen_up");
+        dq_cheap_pso_ = {};
+        if (vs && fs) {
+          WMT::Reference<WMT::Error> error;
+          WMTRenderPipelineInfo pinfo;
+          WMT::InitializeRenderPipelineInfo(pinfo);
+          pinfo.colors[0].pixel_format = ufmt;
+          pinfo.vertex_function = vs;
+          pinfo.fragment_function = fs;
+          dq_cheap_pso_ = device_.newRenderPipelineState(pinfo, error);
+        }
+        dq_cheap_format_ = ufmt;
+      }
+      if (dq_cheap_pso_) {
+        WMTRenderPassInfo info;
+        WMT::InitializeRenderPassInfo(info);
+        info.colors[0].load_action = WMTLoadActionDontCare;
+        info.colors[0].store_action = WMTStoreActionStore;
+        info.colors[0].texture = up_tex;
+        auto enc = cb.renderCommandEncoder(info);
+        emberLabel(enc, "EmberDq-genup");
+        if (src_fence) enc.waitForFence(src_fence, WMTRenderStageFragment);
+        enc.setRenderPipelineState(dq_cheap_pso_);
+        enc.setFragmentTexture(src, 0);
+        enc.setFragmentTexture(src, 1);
+        float wk[2] = {1.0f, EmberD11Get(kEmberD11GenUpK) / 100.0f};
+        enc.setFragmentBytes(wk, sizeof(wk), 0);
+        enc.setViewport({0, 0, (double)W, (double)H, 0, 1});
+        enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+        enc.updateFence(dq_up_fence_, WMTRenderStageFragment);
+        enc.endEncoding();
+        scaled = true;
+      }
+    }
+    if (up_tex && !scaled) {
+      WMTFXSpatialScalerInfo si {};
+      si.color_format = src.pixelFormat();
+      si.output_format = ufmt;
+      si.input_width = (uint32_t)src.width();
+      si.input_height = (uint32_t)src.height();
+      si.output_width = (uint32_t)W;
+      si.output_height = (uint32_t)H;
+      if (!dq_scaler_ || std::memcmp(&si, &dq_scaler_info_, sizeof(si))) {
+        dq_scaler_info_ = si;
+        dq_scaler_ = device_.newSpatialScaler(si);
+      }
+      if (dq_scaler_) {
+        auto begin = cb.blitCommandEncoder();
+        emberLabel(begin, "EmberDq-up-begin");
+        if (src_fence) begin.waitForFence(src_fence);
+        begin.updateFence(dq_scaler_fence_);
+        begin.endEncoding();
+        cb.encodeSpatialScale(dq_scaler_, src, up_tex, dq_scaler_fence_);
+        auto end = cb.blitCommandEncoder();
+        emberLabel(end, "EmberDq-up-end");
+        end.waitForFence(dq_scaler_fence_);
+        end.updateFence(dq_up_fence_);
+        end.endEncoding();
+        scaled = true;
+      }
+    }
+    if (scaled) {
+      show = up_tex;
+      show_fence = dq_up_fence_;
+      if (up_only) return true;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lk(pso_mu_);
+    if (dst.pixelFormat() != pso_format_) return false;   // 레이어 형식이 바뀌는 중(옛 드로어블) — 이 장은 버린다
+    const bool matched = show.width() == W && show.height() == H;
+    WMT::RenderPipelineState pso = matched ? (WMT::RenderPipelineState)present_blit_ : (WMT::RenderPipelineState)present_scale_;
+    if (!pso) return false;
+    WMTRenderPassInfo info;
+    WMT::InitializeRenderPassInfo(info);
+    info.colors[0].load_action = WMTLoadActionDontCare;
+    info.colors[0].store_action = WMTStoreActionStore;
+    info.colors[0].texture = dst;
+    auto enc = cb.renderCommandEncoder(info);
+    emberLabel(enc, gen ? "EmberDq-gen" : "EmberDq-cur");
+    if (show_fence) enc.waitForFence(show_fence, WMTRenderStageFragment);
+    enc.setRenderPipelineState(pso);
+    enc.setFragmentTexture(show, 0);
+    enc.setFragmentTexture(gamma_lut_texture_, 1);
+    enc.setFragmentBytes(&tag.meta, sizeof(tag.meta), 0);
+    enc.setViewport({0, 0, (double)W, (double)H, 0, 1});
+    enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+    encodeOverlay(cb, dst, &enc);
+    enc.endEncoding();
+  }
+  encodeEmberHud(cb, dst);
+  return true;
+}
+
+bool
+Presenter::dqEnsureImg(WMT::Reference<WMT::Texture> &img) {
+  const uint64_t W = (uint64_t)layer_props_.drawable_width, H = (uint64_t)layer_props_.drawable_height;
+  const WMTPixelFormat fmt = layer_props_.pixel_format;
+  if (!W || !H) return false;
+  if (img && img.width() == W && img.height() == H && img.pixelFormat() == fmt) return true;
+  WMTTextureInfo info;
+  info.type = WMTTextureType2D;
+  info.pixel_format = fmt;
+  info.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageRenderTarget);
+  info.options = WMTResourceStorageModePrivate;
+  info.width = W;
+  info.height = H;
+  info.depth = 1;
+  info.mipmap_level_count = 1;
+  info.sample_count = 1;
+  info.array_length = 1;
+  img = device_.newTexture(info);   // 크기·형식이 바뀔 때만
+  return (bool)img;
+}
+
+bool
+Presenter::dqPrep(WMT::CommandBuffer cb, const emberfg::DqFrame &f, bool want_gen, bool &gen_ok, uint64_t mark) {
+  gen_ok = false;
+  const int k = (int)(mark % kDqSets);
+  // 이 벌을 3장 앞에 쓴 장의 드로어블 복사가 끝났는지(GPU) — 페이서가 늦을 때만 실제로 기다린다(역압)
+  if (mark > (uint64_t)kDqSets) {
+    if (dqBlitEvent().signaledValue() < mark - kDqSets) dq_n_setbusy_++;   // 계측: 이 cb 가 GPU 에서 페이서 복사를 기다리게 됨(게임 큐 막힘)
+    cb.encodeWaitForEvent(dqBlitEvent(), mark - kDqSets);
+  }
+  if (want_gen && (f.plan.flags & emberfg::PLAN_GENERATE) && (f.plan.flags & emberfg::PLAN_MC) && f.prev_slot >= 0) {
+    emberfg::EncodeOut eo {};
+    if (fg_.dqEncodeGen(dq_, f.seq, cb.handle, eo) && eo.texture) {
+      WMT::Texture src;
+      src.handle = eo.texture;
+      WMT::Fence fe;
+      fe.handle = eo.fence;
+      dq_gen_mode_[k] = 0;
+      const DqTag tag = dq_tag_[f.host_tag % 32];
+      const uint64_t W = (uint64_t)layer_props_.drawable_width, H = (uint64_t)layer_props_.drawable_height;
+      if (EmberD11Get(kEmberD11DqOrigDirect) == 1 && tag.pre_up && (src.width() != W || src.height() != H)) {
+        // GENDIRECT: 확대만 여기서(키운 보간 장), 표시 패스는 페이서가 드로어블에 — 중간 장 표시 패스+복사 두 번이 한 번이 된다
+        auto &gu = dq_gen_up_[k];
