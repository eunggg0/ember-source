+#include "dxmt_ember_d11.hpp"
+#include "log/log.hpp"
+#include "util_env.hpp"
+#include "util_string.hpp"
+#include "../winemetal/ember_fg_thunks.h"
+#include <algorithm>
+#include <cstring>
+#include <cwctype>
+#include <windows.h>
+
+namespace dxmt {
+
+namespace embertone {
+
+namespace {
+using call_fn = int32_t (*)(unixcall_ember_fg *);
+
+call_fn
+resolve() {
+  // Resolved at run time: an older winemetal.dll without the thunk simply means "Tone/Flare off".
+  static call_fn fn = [] {
+    HMODULE wm = GetModuleHandleA("winemetal.dll");
+    return wm ? (call_fn)(void *)GetProcAddress(wm, "EmberFG_call") : nullptr;
+  }();
+  return fn;
+}
+
+void
+forward_log(const char *buf, size_t n) {
+  size_t start = 0;
+  while (start < n) {
+    const char *nl = (const char *)std::memchr(buf + start, '\n', n - start);
+    size_t end = nl ? (size_t)(nl - buf) : n;
+    if (end > start + 2) {
+      std::string line(buf + start + 2, end - start - 2);
+      if (buf[start] == 'E') Logger::err(line);
+      else if (buf[start] == 'W') Logger::warn(line);
+      else Logger::info(line);
+    }
+    start = end + 1;
+  }
+}
+} // namespace
+
+int32_t
+call(uint32_t op, uint64_t &ctx, uint64_t device, const void *in, uint64_t in_size, void *out, uint64_t out_size) {
+  auto fn = resolve();
+  if (!fn) return 0;
+  char log[4096];
+  unixcall_ember_fg p;
+  std::memset(&p, 0, sizeof(p));
+  p.op = op;
+  p.ctx = ctx;
+  p.device = device;
+  WMT_MEMPTR_SET(p.in, in);
+  p.in_size = in_size;
+  WMT_MEMPTR_SET(p.out, out);
+  p.out_size = out_size;
+  WMT_MEMPTR_SET(p.log, log);
+  p.log_cap = sizeof(log);
+  int32_t r = fn(&p);
+  if (p.log_len) forward_log(log, (size_t)std::min<uint64_t>(p.log_len, sizeof(log) - 1));
+  ctx = p.ctx;
+  return r;
+}
+
+std::string
+envBlock() {
+  std::string out;
+  LPWCH env = GetEnvironmentStringsW();
+  if (!env) return out;
+  for (LPWCH p = env; *p; p += wcslen(p) + 1) {
+    if (*p == L'=') continue;
+    if (_wcsnicmp(p, L"EMBER_", 6)) continue;
+    out += str::fromws(p);
+    out.push_back('\0');
+  }
+  FreeEnvironmentStringsW(env);
+  out.push_back('\0');
+  return out;
+}
+
+} // namespace embertone
+
+bool
+EmberNeural::enabled() {
+  static int on = -1;
+  if (on < 0) on = env::getEnvVar("EMBER_NEURAL") == "1";
+  return on;
+}
+
+EmberNeural::EmberNeural(WMT::Device device) {
+  auto env = embertone::envBlock();
+  uint64_t ctx = 0;
+  if (embertone::call(EMBER_FG_OP_TONE_NEURAL_CREATE, ctx, device.handle, env.data(), env.size(), nullptr, 0) && ctx)
+    ctx_ = ctx;
+  else
+    Logger::warn("ember-neural: libEmberTone 없음(winemetal.so 옆) — AI 화질 다듬기 끔");
+}
+
+EmberNeural::~EmberNeural() {
+  if (ctx_) embertone::call(EMBER_FG_OP_TONE_NEURAL_DESTROY, ctx_, 0, nullptr, 0, nullptr, 0);
+  ctx_ = 0;
+}
+
+WMT::Texture
+EmberNeural::encode(
+    WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, uint32_t sample_count, const uint64_t *fences, uint32_t n_fences
+) {
+  if (!ctx_ || sample_count > 1 || !backbuffer.handle) return backbuffer;
+  embertone::NeuralIn in;
+  n_fences = std::min(n_fences, embertone::kMaxWaitFences);
+  in.size = (uint32_t)(offsetof(embertone::NeuralIn, wait_fences) + 8 * n_fences);
+  in.rt_mode = EmberD11Get(kEmberD11NeuralRt);   // fgneural: C:\ember-d11.cfg EMBER_NEURAL_RT live toggle
+  in.command_buffer = cmdbuf.handle;
+  in.source = backbuffer.handle;
+  in.target = 0;
+  in.sample_count = sample_count;
+  in.n_wait_fences = n_fences;
+  for (uint32_t i = 0; i < n_fences; i++) in.wait_fences[i] = fences[i];
+  embertone::NeuralOut out {};
+  out.size = sizeof(out);
+  uint64_t ctx = ctx_;
+  if (!embertone::call(EMBER_FG_OP_TONE_NEURAL_ENCODE, ctx, 0, &in, in.size, &out, sizeof(out)) || !out.processed ||
+      !out.texture)
+    return backbuffer;
+  WMT::Texture t;   // library-owned (lives until the next resize / destroy), borrowed here
+  t.handle = out.texture;
+  return t;
+}
+
+} // namespace dxmt
