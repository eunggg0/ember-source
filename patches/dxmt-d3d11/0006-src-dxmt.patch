+// ---- Ember: FG helpers ----
+// Ember: 움직임 보상 보간 커널(FG-MC)은 보간 엔진 EmberCore(libEmberFG.dylib)로 옮겼다. 여기에는 표시 쪽 복사·혼합만 남는다.
+// Ember: 이전 프레임 사본(렌더 패스). blit 은 게임 펜스를 기다릴 수 없어 게임이 다 그리기 전의 백버퍼를 베껴
+// 사본이 두 프레임 조각으로 찢어졌다(EMBER_FG_DUMP 로 확인, 2026-09-28). 렌더 패스는 wait_fences 로 기다린다.
+[[fragment]] float4 fs_ember_fg_copy(
+    present_data input [[stage_in]],
+    texture2d<float, access::read> source [[texture(0)]]
+) {
+  return source.read(uint2(input.position.xy));
+}
+// Ember: MetalFX 앞 보간(EMBER_FG_PRE_UPSCALE=1) — 렌더 해상도에서 이전·현재를 비중 w 로 섞는다(색 변환 없음, 표시 패스가 한다).
+// MC 결과를 옮길 때는 cur = prev = MC 결과, w = 1.
+[[fragment]] float4 fs_ember_fg_mix(
+    present_data input [[stage_in]],
+    texture2d<float, access::read> cur [[texture(0)]],
+    texture2d<float, access::read> prev [[texture(1)]],
+    constant float &w [[buffer(0)]]
+) {
+  uint2 q = uint2(input.position.xy);
+  return mix(prev.read(q), cur.read(q), w);
+}
+// Ember(loadisp 10-17): 보간 프레임 값싼 확대 — MetalFX(EASU+RCAS 두 패스) 대신 Catmull-Rom(쌍선형 9탭) + 언샤프 한 패스.
+// cur·prev 를 비중 wk.x 로 섞고(MC 결과면 cur = prev, w = 1) 링 슬롯(드로어블 크기)으로 키운다. wk.y = 언샤프 세기(CR − 쌍선형).
+// 선명화(CAS)·색 변환은 원본과 똑같이 페이서의 표시 패스가 한다.
+constexpr sampler ember_up_lin(coord::normalized, filter::linear, address::clamp_to_edge);
+static float4 ember_up_cr(texture2d<float, access::sample> t, float2 uv) {
+  float2 ts = float2(t.get_width(), t.get_height());
+  float2 sp = uv * ts;
+  float2 p1 = floor(sp - 0.5) + 0.5;
+  float2 f = sp - p1;
+  float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+  float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+  float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+  float2 w3 = f * f * (-0.5 + 0.5 * f);
+  float2 w12 = w1 + w2;
+  float2 t0 = (p1 - 1) / ts, t3 = (p1 + 2) / ts, t12 = (p1 + w2 / w12) / ts;
+  float4 r = t.sample(ember_up_lin, float2(t0.x, t0.y)) * (w0.x * w0.y);
+  r += t.sample(ember_up_lin, float2(t12.x, t0.y)) * (w12.x * w0.y);
+  r += t.sample(ember_up_lin, float2(t3.x, t0.y)) * (w3.x * w0.y);
+  r += t.sample(ember_up_lin, float2(t0.x, t12.y)) * (w0.x * w12.y);
+  r += t.sample(ember_up_lin, float2(t12.x, t12.y)) * (w12.x * w12.y);
+  r += t.sample(ember_up_lin, float2(t3.x, t12.y)) * (w3.x * w12.y);
+  r += t.sample(ember_up_lin, float2(t0.x, t3.y)) * (w0.x * w3.y);
+  r += t.sample(ember_up_lin, float2(t12.x, t3.y)) * (w12.x * w3.y);
+  r += t.sample(ember_up_lin, float2(t3.x, t3.y)) * (w3.x * w3.y);
+  return r;
+}
+[[fragment]] float4 fs_ember_gen_up(
+    present_data input [[stage_in]],
+    texture2d<float, access::sample> cur [[texture(0)]],
+    texture2d<float, access::sample> prev [[texture(1)]],
+    constant float2 &wk [[buffer(0)]]
+) {
+  float4 c = ember_up_cr(cur, input.uv);
+  float4 b = cur.sample(ember_up_lin, input.uv);
+  if (wk.x < 1.0) {
+    c = mix(ember_up_cr(prev, input.uv), c, wk.x);
+    b = mix(prev.sample(ember_up_lin, input.uv), b, wk.x);
+  }
+  return saturate(c + wk.y * (c - b));
+}
+// ---- Ember: FG helpers END ----
