+void
+CommandQueue::emberPaceAutoFrame(uint64_t busy_ns, uint64_t frame_end_ns) {
+  uint64_t prev = pa_prev_frame_end_;
+  pa_prev_frame_end_ = frame_end_ns;
+  if (!prev || frame_end_ns <= prev)
+    return;
+  double iv = (double)(frame_end_ns - prev);
