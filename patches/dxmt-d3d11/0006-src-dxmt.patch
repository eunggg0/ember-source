+bool
+Presenter::dqMetalFx(WMT::CommandBuffer cb, WMT::Texture src, WMT::Texture dst) {
+  WMTFXSpatialScalerInfo si {};
+  si.color_format = src.pixelFormat();
+  si.output_format = dst.pixelFormat();
+  si.input_width = (uint32_t)src.width();
+  si.input_height = (uint32_t)src.height();
+  si.output_width = (uint32_t)dst.width();
+  si.output_height = (uint32_t)dst.height();
+  if (!dq_scaler_ || std::memcmp(&si, &dq_scaler_info_, sizeof(si))) {
+    dq_scaler_info_ = si;
+    dq_scaler_ = device_.newSpatialScaler(si);
+  }
+  if (!dq_scaler_) return false;
+  if (!dq_scaler_fence_) dq_scaler_fence_ = device_.newFence();
+  cb.encodeSpatialScale(dq_scaler_, src, dst, dq_scaler_fence_);
+  return true;
+}
+
+bool
+Presenter::dqGenTo(WMT::CommandBuffer cb, const emberfg::DqFrame &f, WMT::MetalDrawable drawable, uint64_t mark) {
+  const int k = (int)(mark % kDqSets);
+  if (dq_gen_mode_[k] != 2) return dqBlitTo(cb, true, drawable, mark);
+  return dqComposeTo(cb, dq_gen_up_[k], WMT::Fence{}, f.host_tag, true, drawable.texture());
+}
+
+bool
+Presenter::dqOrigTo(WMT::CommandBuffer cb, const emberfg::DqFrame &f, WMT::MetalDrawable drawable, uint64_t mark) {
+  const int k = (int)(mark % kDqSets);
+  if (dq_orig_mode_[k] == 0) return dqBlitTo(cb, false, drawable, mark);
+  WMT::Texture src;
+  if (dq_orig_mode_[k] == 2) src = dq_orig_up_[k];
+  else src.handle = f.texture;
+  return dqComposeTo(cb, src, WMT::Fence{}, f.host_tag, false, drawable.texture());
+}
+
+bool
+Presenter::dqBlitTo(WMT::CommandBuffer cb, bool gen, WMT::MetalDrawable drawable, uint64_t mark) {
+  const int k = (int)(mark % kDqSets);
+  WMT::Texture src = gen ? (WMT::Texture)dq_gen_img_[k] : (WMT::Texture)dq_orig_img_[k];
+  WMT::Texture dst = drawable.texture();
+  if (!src || !dst || src.width() != dst.width() || src.height() != dst.height() || src.pixelFormat() != dst.pixelFormat())
+    return false;   // 크기·형식 바뀌는 중 — 이 장은 버린다
+  struct wmtcmd_blit_copy_from_texture_to_texture cmd;
+  cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+  cmd.next.set(nullptr);
+  cmd.src = src.handle;
+  cmd.src_slice = 0;
+  cmd.src_level = 0;
+  cmd.src_origin = {0, 0, 0};
+  cmd.src_size = {src.width(), src.height(), 1};
+  cmd.dst = dst.handle;
+  cmd.dst_slice = 0;
+  cmd.dst_level = 0;
+  cmd.dst_origin = {0, 0, 0};
+  auto blit = cb.blitCommandEncoder();
+  emberLabel(blit, gen ? "EmberDq-blit-gen" : "EmberDq-blit-cur");
+  blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  blit.endEncoding();
+  return true;
+}
+
+void
+Presenter::dqReport() {
+  auto now = std::chrono::steady_clock::now();
+  if (!dq_report_since_.time_since_epoch().count()) { dq_report_since_ = now; return; }
+  const double el = std::chrono::duration<double>(now - dq_report_since_).count();
+  if (el < 5.0) return;
+  static int on = -1;
+  if (on < 0) on = env::getEnvVar("EMBER_FG_LOG") == "1" || EmberD11Get(kEmberD11WaitLog);
+  if (on && dq_) {
