+    else if (gen_shown && defer > 0 && !p.ringSynced())
+      cb.presentDrawableAfterMinimumDuration(d, defer - std::min(defer * 0.25, 0.002));
+    else if (double hold = gen_shown ? f.plan.cadence_hold : 0; hold > 0)
+      cb.presentDrawableAfterMinimumDuration(d, hold);
+    else
+      cb.presentDrawable(d);
+    p.dqDone(f, cb, true);
+    cb.commit();
+    if (item.handoff.time_since_epoch().count() && item.commit.time_since_epoch().count()) {
+      auto ms = [](clock::time_point a, clock::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
