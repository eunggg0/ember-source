+          // Ember 박자: 보간이 hold 만큼 떠 있은 뒤 원본(고정 주사율 30~37fps = 2칸, VRR = 게임 간격 절반). presenter.updateCadence
+          cb.presentDrawableAfterMinimumDuration(drawable, hold);
+        else
+          cb.presentDrawable(drawable);
+        presented = true;
+      }
+      cb.commit();
+      {
+        EmberWaitScope ws(kWaitPacerBlit);
+        cb.waitUntilCompleted();   // 복사가 끝나 대기열에 들어갔다 — 슬롯을 돌려줄 수 있다
+      }
+      t_done = clock::now();
+    }
+  } else {
+    pacer_no_drawable_++;
+    if (item.generated) p.noteGenDrop(2);   // Ember(fgq): present-stall(드로어블 없음)
+  }
+  if (item.generated) last_gen_present_ = t_done;
+  p.releaseRingSlot(item.slot, !item.generated);
+  if (!item.generated && presented) {
+    if (item.handoff.time_since_epoch().count() && item.commit.time_since_epoch().count()) {
+      auto ms = [](clock::time_point a, clock::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+      lat_enc_ += ms(item.handoff, item.commit);
+      lat_gpu_ += ms(item.commit, t_ready);
+      lat_draw_ += ms(t_ready, t_draw);
+      lat_blit_ += ms(t_draw, t_done);
+    }
+    recordQueueLatency(item.handoff);
+  }
+}
