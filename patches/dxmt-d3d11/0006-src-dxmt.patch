+/* Ember-only smooth scheduling policy. No upstream submission.
+ * Same bounds as the D3DMetal HOLD experiment; no platform dependency. */
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+namespace dxmt::emberfg {
+// Seconds: -1 = automatic, 0 = unchanged. Invalid input fails closed.
+inline double smooth_hold_config(const char *value) {
+  if (!value || !*value) return 0;
+  if (!std::strcmp(value, "auto") || !std::strcmp(value, "자동")) return -1;
+  char *end = nullptr;
+  double ms = std::strtod(value, &end);
+  return end != value && !*end && std::isfinite(ms) && ms > 0 ? ms / 1000 : 0;
+}
+inline double smooth_hold_duration(double config, double interval, double display) {
+  if ((!std::isfinite(config) || config <= 0) && config != -1) return 0;
+  if (!std::isfinite(interval) || !std::isfinite(display) || interval <= 0 || display <= 0) return 0;
+  // Bound explicit values too: one source interval or two display periods.
+  return std::min(config == -1 ? interval * 0.75 : config, std::min(interval, display * 2));
+}
+} // namespace dxmt::emberfg
