+/* Ember 링 표시 — 큐 스레드 쪽. 슬롯·텍스처는 보간 엔진이 관리한다(링이 차면 엔진 안에서 기다린다). */
+bool
+Presenter::acquireRingSlots(bool need_gen, int &gen_slot, int &cur_slot, bool *timed_out) {
+  // (realign-1020 A, R1) 예전: 엔진 condvar 무기한 대기 → 페이서가 멈추면(가린 창·합성기 지연·GPU 행) encode 스레드 → 청크 32개 →
+  // 프레임 지연 펜스를 거쳐 게임 스레드가 device mutex 를 쥔 채 멈췄다. 이제 엔진과 같은 조건을 상한 있게 먼저 기다린다.
+  {
+    const uint32_t ahead = std::max<uint32_t>(1, fg_.config().ring_frames_ahead ? fg_.config().ring_frames_ahead : 2);
+    const int wait_ms = EmberD11Get(kEmberD11RingWaitMs);
+    std::unique_lock<std::mutex> lk(ring_gate_mu_);
+    if (ring_gate_frames_ >= ahead) {
+      EmberWaitScope ws(kWaitRingAcquire);
+      bool ok = wait_ms < 0 ? (ring_gate_cv_.wait(lk, [&] { return ring_gate_frames_ < ahead; }), true)
+                            : ring_gate_cv_.wait_for(lk, std::chrono::milliseconds(wait_ms), [&] { return ring_gate_frames_ < ahead; });
+      if (!ok) {
+        EmberWait().timeout(kWaitRingAcquire);
+        if (timed_out) *timed_out = true;
+        return false;
+      }
+    }
+  }
+  emberfg::RingReq req {};
+  req.size = sizeof(req);
+  req.need_generated = need_gen;
+  req.width = (uint64_t)layer_props_.drawable_width;
+  req.height = (uint64_t)layer_props_.drawable_height;
+  req.pixel_format = (uint64_t)ORIGINAL_FORMAT(layer_props_.pixel_format);
+  // (realign-1020) 엔진 1.5 상한: 문지기를 지났으니 보통 안 기다린다. 옛 엔진은 꼬리를 무시(옛 무기한 대기 — 문지기가 막음)
+  const int wait_ms2 = EmberD11Get(kEmberD11RingWaitMs);
+  req.timeout_ns = wait_ms2 < 0 ? ~0ull >> 1 : (uint64_t)(wait_ms2 + 50) * 1000000ull;
+  emberfg::RingSlots slots {};
+  const auto t_acq = std::chrono::steady_clock::now();
+  if (!fg_.ringAcquire(req, slots)) {
+    // 엔진이 상한에 걸렸으면(텍스처 실패와 구분: 오래 걸림) 버리는 길로
+    if (wait_ms2 >= 0 && std::chrono::steady_clock::now() - t_acq >= std::chrono::milliseconds(wait_ms2)) {
+      EmberWait().timeout(kWaitRingAcquire);
+      if (timed_out) *timed_out = true;
+    }
+    return false;
+  }
+  {
+    std::lock_guard<std::mutex> lk(ring_gate_mu_);
+    ring_gate_frames_++;
+  }
+  gen_slot = slots.gen_slot;
+  cur_slot = slots.cur_slot;
+  if (gen_slot >= 0 && gen_slot < kRingMax) ring_tex_[gen_slot] = slots.gen_texture;
+  if (cur_slot >= 0 && cur_slot < kRingMax) ring_tex_[cur_slot] = slots.cur_texture;
+  return true;
+}
+
+bool
+Presenter::waitRingIdleFor(int ms) {
+  if (!fg_.ok()) return true;
+  EmberWaitScope ws(kWaitRingIdle);
+  std::unique_lock<std::mutex> lk(ring_gate_mu_);
+  auto idle = [&] { return ring_gate_frames_ == 0 && dq_inflight_ == 0; };
+  bool ok = ms < 0 ? (ring_gate_cv_.wait(lk, idle), true) : ring_gate_cv_.wait_for(lk, std::chrono::milliseconds(ms), idle);
+  if (!ok) EmberWait().timeout(kWaitRingIdle);
+  return ok;
+}
