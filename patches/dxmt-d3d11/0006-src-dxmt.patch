+// CPU scheduling delay, not input-to-photon latency. Actual oversleep is visible.
+void
+Presenter::reportSmoothHold(std::chrono::steady_clock::time_point now, double interval) {
+  if (!fg_.config().smooth || (!smooth_hold_config_ && !smooth_hold_log_)) return;
+  if (!smooth_hold_since_.time_since_epoch().count()) smooth_hold_since_ = now;
+  if (std::chrono::duration<double>(now - smooth_hold_since_).count() < 5) return;
+  char line[512];
+  std::snprintf(line, sizeof(line), "dxmt-fg-smooth: mode=smooth hold_policy=%s hold_config_ms=%.3f "
+                "hold_pairs=%llu pairs=%llu hold_target_ms=%.3f added_latency_ms=%.3f "
+                "added_latency_max_ms=%.3f source_interval_ms=%.3f latency_scope=cpu_schedule",
+                smooth_hold_config_ == -1 ? "auto" : (smooth_hold_config_ > 0 ? "fixed" : "off"),
+                smooth_hold_config_ == -1 ? -1.0 : smooth_hold_config_ * 1000,
+                (unsigned long long)smooth_hold_pairs_, (unsigned long long)smooth_hold_samples_,
+                smooth_hold_pairs_ ? smooth_hold_target_ * 1000 / smooth_hold_pairs_ : 0,
+                smooth_hold_pairs_ ? smooth_hold_added_ * 1000 / smooth_hold_pairs_ : 0,
+                smooth_hold_max_ * 1000, interval * 1000);
+  Logger::info(line);
+  smooth_hold_pairs_ = smooth_hold_samples_ = 0;
+  smooth_hold_target_ = smooth_hold_added_ = smooth_hold_max_ = 0;
+  smooth_hold_since_ = now;
+}
