+  std::atomic<uint64_t> ev_waits{0}; /* GPU 이벤트로 잠든 수 */
+  std::atomic<uint64_t> rb_checked{0};  /* 앞당긴 청크를 완료 스레드가 다시 읽어 본 수 */
+  std::atomic<uint64_t> rb_mismatch{0}; /* 그때 값이 달랐던 수(0 이어야 함 — 아니면 앞당김이 이른 값을 읽음) */
+};
