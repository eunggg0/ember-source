+  }
+  auto t_ready = clock::now();
+  clock::time_point t_draw = t_ready;
+  WMT::Event ev;
+  ev.handle = f.event;
+  bool gen_shown = false;
+  WMT::MetalDrawable carry {};   // 보간을 못 만들었으면 그 드로어블을 원본에 쓴다
+  bool want_gen = (f.plan.flags & emberfg::PLAN_GENERATE) && f.prev_slot >= 0;
+  if (want_gen) {
+    // 뒤처짐(옛 behind): 뒤에 원본이 둘 넘게 쌓였으면 보간을 건너뛰어 원본이 늦지 않게
+    std::lock_guard<std::mutex> lk(pacer_mutex_);
+    int later = 0;
+    for (auto &n : pacer_items_) later += n.dq;
+    if (later >= 2) { want_gen = false; pacer_gen_skip_++; p.noteGenDrop(0); }
+  }
+  if (want_gen) {
+    WMT::MetalDrawable d;
+    {
+      EmberWaitScope ws(kWaitPacerDrawable);
+      d = p.layer().nextDrawable();
+    }
+    if (d.handle) {
+      auto cb = pacerQueue.commandBuffer();
+      cb.encodeWaitForEvent(ev, f.signal_value);
+      if (p.dqComposeGen(cb, f, d)) {
+        cb.presentDrawableAfterMinimumDuration(d, -1.0);   // -1 = 보간 프레임 표식(지연 측정 제외)
+        cb.commit();
+        gen_shown = true;
+        last_gen_present_ = clock::now();
+      } else {
+        cb.commit();   // 기다림만 든 빈 cb — 순서 유지
