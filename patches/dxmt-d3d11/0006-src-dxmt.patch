diff --git a/src/dxmt/ember_autohdr.cpp b/src/dxmt/ember_autohdr.cpp
new file mode 100644
index 0000000..839d3a7
--- /dev/null
+++ b/src/dxmt/ember_autohdr.cpp
@@ -0,0 +1,98 @@
+/*
+ * Ember Flare (Auto HDR) glue, DXMT side — see ember_autohdr.hpp. The engine is libEmberTone.dylib (EmberCore).
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#include "ember_autohdr.hpp"
+#include "ember_neural.hpp"
+#include "log/log.hpp"
+#include "util_env.hpp"
+#include "../winemetal/ember_fg_thunks.h"
+#include <algorithm>
+
+namespace dxmt {
+
+bool
+EmberAutoHDR::enabled() {
+  static int on = -1;
+  if (on < 0) on = env::getEnvVar("EMBER_AUTOHDR") == "1";
+  return on;
+}
+
+EmberAutoHDR::EmberAutoHDR(WMT::Device device) {
+  auto env = embertone::envBlock();
+  embertone::AhdrConfig cfg {};
+  cfg.size = sizeof(cfg);
+  cfg.failed = 1;
+  uint64_t ctx = 0;
+  if (embertone::call(EMBER_FG_OP_TONE_AHDR_CREATE, ctx, device.handle, env.data(), env.size(), &cfg, sizeof(cfg)) && ctx) {
+    ctx_ = ctx;
+    failed_ = cfg.failed != 0;
+    strength_ = cfg.strength;
+    peak_cap_ = cfg.peak_cap;
+    gamma22_ = cfg.gamma22 > 0.5f;
+    wexp_ = cfg.wexp;
+    peak_ = cfg.peak;
+  } else {
+    Logger::warn("ember-autohdr: libEmberTone 없음(winemetal.so 옆) — 자동 HDR 끔");
+  }
+}
+
+EmberAutoHDR::~EmberAutoHDR() {
+  if (ctx_) embertone::call(EMBER_FG_OP_TONE_AHDR_DESTROY, ctx_, 0, nullptr, 0, nullptr, 0);
+  ctx_ = 0;
+}
+
+void
+EmberAutoHDR::sync() {
+  embertone::AhdrConfig cfg {};
+  cfg.size = sizeof(cfg);
+  cfg.failed = 1;
+  uint64_t ctx = ctx_;
+  if (embertone::call(EMBER_FG_OP_TONE_AHDR_CONFIG, ctx, 0, nullptr, 0, &cfg, sizeof(cfg))) failed_ = cfg.failed != 0;
+}
+
+WMT::Texture
+EmberAutoHDR::encode(
+    WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, bool source_is_srgb, const uint64_t *fences, uint32_t n_fences
+) {
+  if (!ctx_ || failed_ || !backbuffer.handle) return {};
+  embertone::AhdrEncodeIn in;
+  n_fences = std::min(n_fences, embertone::kMaxWaitFences);
+  in.size = (uint32_t)(offsetof(embertone::AhdrEncodeIn, wait_fences) + 8 * n_fences);
+  in.flags = source_is_srgb ? embertone::kAhdrSrcSRGB : 0;
+  in.command_buffer = cmdbuf.handle;
+  in.source = backbuffer.handle;
+  in.n_wait_fences = n_fences;
+  in.pad = 0;
+  for (uint32_t i = 0; i < n_fences; i++) in.wait_fences[i] = fences[i];
+  embertone::AhdrEncodeOut out {};
+  out.size = sizeof(out);
+  uint64_t ctx = ctx_;
+  if (!embertone::call(EMBER_FG_OP_TONE_AHDR_ENCODE, ctx, 0, &in, in.size, &out, sizeof(out)) || !out.ok || !out.gain) {
+    sync();   // texture allocation failure turns Flare off (as before)
+    return {};
+  }
+  WMT::Texture t;   // library-owned, borrowed
+  t.handle = out.gain;
+  return t;
+}
+
+float
+EmberAutoHDR::frame(double edr_now, double edr_potential) {
+  if (!ctx_) return peak_;
+  embertone::AhdrFrameIn in {};
+  in.size = sizeof(in);
+  in.log = 1;
+  in.edr_now = edr_now;
+  in.edr_potential = edr_potential;
+  embertone::AhdrFrameOut out {};
+  out.size = sizeof(out);
+  uint64_t ctx = ctx_;
+  if (embertone::call(EMBER_FG_OP_TONE_AHDR_FRAME, ctx, 0, &in, sizeof(in), &out, sizeof(out))) peak_ = out.peak;
+  return peak_;
+}
+
+} // namespace dxmt
