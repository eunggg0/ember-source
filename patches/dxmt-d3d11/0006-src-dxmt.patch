+    ev.handle = f.event;
+    auto t0 = clock::now();
+    bool gen_shown = false;
+    WMT::MetalDrawable carry {};
+    bool want_gen = (f.plan.flags & emberfg::PLAN_GENERATE) && f.prev_slot >= 0;
+    if (want_gen) {
+      std::lock_guard<std::mutex> lk(pacer_mutex_);
+      int later = 0;
+      for (auto &n : pacer_items_) later += n.dq;
+      if (later >= 2) { want_gen = false; pacer_gen_skip_++; p.noteGenDrop(0); }
+    }
+    if (want_gen) {
+      WMT::MetalDrawable d;
+      {
+        EmberWaitScope ws(kWaitPacerDrawable);
+        d = p.layer().nextDrawable();
+      }
+      if (d.handle) {
+        auto cb = pacerQueue.commandBuffer();
+        cb.encodeWaitForEvent(ev, f.signal_value);
+        if (p.dqComposeGen(cb, f, d)) {
+          cb.presentDrawableAfterMinimumDuration(d, -1.0);
+          cb.commit();
+          gen_shown = true;
+          last_gen_present_ = clock::now();
+        } else {
+          cb.commit();
+          carry = d;
+        }
+      } else {
+        pacer_no_drawable_++;
+        p.noteGenDrop(2);
+      }
+    }
+    WMT::MetalDrawable d = carry;
+    if (!d.handle) {
+      EmberWaitScope ws(kWaitPacerDrawable);
+      d = p.layer().nextDrawable();
+    }
+    auto t_draw = clock::now();
+    if (!d.handle) {
+      pacer_no_drawable_++;
+      // 원본 신호 전이면 엔진이 슬롯을 바로 넘기면 안 된다 — 빈 cb 로 GPU 순서를 지켜 넘긴다
+      auto cb = pacerQueue.commandBuffer();
+      cb.encodeWaitForEvent(ev, f.signal_value);
+      p.dqDone(f, cb, false);
+      cb.commit();
+      return;
+    }
+    auto cb = pacerQueue.commandBuffer();
+    if (!gen_shown) cb.encodeWaitForEvent(ev, f.signal_value);
+    if (!p.dqComposeOrig(cb, f, d)) {
