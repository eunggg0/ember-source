+      lat_gpu_ += ms(item.commit, t_ready);
+      lat_draw_ += ms(t_ready, t_draw);
+      lat_blit_ += ms(t_draw, t_done);
+    }
+    recordQueueLatency(item.handoff);
+    return;
+  }
+  if (EmberD11Get(kEmberD11DqEarly) == 1) {
+    // (realign B, EMBER_D11_DQ_EARLY=1 기본) 표시 cb 를 원본 GPU 완료 전에 미리 올린다 — cb 맨 앞 encodeWait 로 GPU 가 신호 즉시
