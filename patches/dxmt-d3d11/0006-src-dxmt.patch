+/* Ember 링 표시 — 페이싱 스레드 쪽 */
+bool
+Presenter::encodeRingBlit(WMT::CommandBuffer cmdbuf, int slot, WMT::MetalDrawable drawable) {
+  if (slot < 0 || slot >= kRingMax) return false;
+  WMT::Texture src;
+  src.handle = ring_tex_[slot];
+  WMT::Texture dst = drawable.texture();
+  if (!src || !dst) return false;
+  if (src.width() != dst.width() || src.height() != dst.height() || src.pixelFormat() != dst.pixelFormat())
+    return false;   // 크기 바꾸는 중 — 이 프레임은 버린다
+  // (realign-1020 A, R3) 게임 스레드가 레이어 무효화 때 링을 다 기다리지 않고(상한) 파이프라인을 바꿔 끼울 수 있어 잠근다(바꾸기만 잠금 안, 컴파일은 밖)
+  std::lock_guard<std::mutex> pso_lk(pso_mu_);
+  if (ring_mode_[slot].load(std::memory_order_acquire) == 1 && present_blit_) {
+    // Ember(loagpu3): 링 바로 쓰기 — 슬롯엔 MetalFX 결과 그대로. 큐 스레드가 하던 표시 패스(같은 파이프라인·같은 입력이라 값이 같다)를
+    // 여기서 드로어블에 바로 그리고 글자 상자를 얹는다: 4K 표시 패스 + 슬롯→드로어블 복사 두 번이 한 번이 된다.
+    // 파이프라인은 링이 빈 뒤에만 다시 만든다(synchronizeLayerProperties → waitRingIdle).
+    WMTRenderPassInfo info;
+    WMT::InitializeRenderPassInfo(info);
+    info.colors[0].load_action = WMTLoadActionDontCare;
+    info.colors[0].store_action = WMTStoreActionStore;
+    info.colors[0].texture = dst;
+    auto enc = cmdbuf.renderCommandEncoder(info);
+    emberLabel(enc, "EmberRing-present");
+    enc.setRenderPipelineState(present_blit_);
+    enc.setFragmentTexture(src, 0);
+    enc.setFragmentTexture(gamma_lut_texture_, 1);
+    enc.setFragmentBytes(&ring_meta_[slot], sizeof(DXMTPresentMetadata), 0);
+    enc.setViewport({0, 0, (double)dst.width(), (double)dst.height(), 0, 1});
+    enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+    encodeOverlay(cmdbuf, dst, &enc);
+    enc.endEncoding();
+    return true;
+  }
+  int ring_draw = EmberD11Get(kEmberD11RingDraw);   // Ember(loagpu3): -1 = 엔진 설정
+  if (ring_draw < 0 ? (bool)fg_.config().ring_copy_draw : ring_draw == 1) {
+    auto fmt = dst.pixelFormat();
+    if (!ring_copy_pso_ || ring_copy_format_ != fmt) {
+      auto pool = WMT::MakeAutoreleasePool();
+      auto library = lib_.getLibrary();
+      auto vs = library.newFunction("vs_present_quad");
+      auto fs = library.newFunction("fs_ember_fg_copy");
+      ring_copy_pso_ = {};
+      if (vs && fs) {
+        WMT::Reference<WMT::Error> error;
+        WMTRenderPipelineInfo pinfo;
+        WMT::InitializeRenderPipelineInfo(pinfo);
+        pinfo.colors[0].pixel_format = fmt;
+        pinfo.vertex_function = vs;
+        pinfo.fragment_function = fs;
+        ring_copy_pso_ = device_.newRenderPipelineState(pinfo, error);
+      }
+      ring_copy_format_ = fmt;
+    }
+    if (ring_copy_pso_) {
+      WMTRenderPassInfo info;
+      WMT::InitializeRenderPassInfo(info);
+      info.colors[0].load_action = WMTLoadActionDontCare;
+      info.colors[0].store_action = WMTStoreActionStore;
+      info.colors[0].texture = dst;
+      auto enc = cmdbuf.renderCommandEncoder(info);
+      emberLabel(enc, "EmberRing-copy");
+      enc.setRenderPipelineState(ring_copy_pso_);
+      enc.setFragmentTexture(src, 0);
+      enc.setViewport({0, 0, (double)dst.width(), (double)dst.height(), 0, 1});
+      enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+      enc.endEncoding();
+      return true;
+    }
+  }
+  struct wmtcmd_blit_copy_from_texture_to_texture cmd;
+  cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+  cmd.next.set(nullptr);
+  cmd.src = src.handle;
+  cmd.src_slice = 0;
+  cmd.src_level = 0;
+  cmd.src_origin = {0, 0, 0};
+  cmd.src_size = {src.width(), src.height(), 1};
+  cmd.dst = dst.handle;
+  cmd.dst_slice = 0;
+  cmd.dst_level = 0;
+  cmd.dst_origin = {0, 0, 0};
+  auto blit = cmdbuf.blitCommandEncoder();
+  emberLabel(blit, "EmberRing-blit");
+  blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  blit.endEncoding();
+  return true;
+}
+
+/* Ember 게임 화면 안 HUD — 판 그리기는 EmberCore(libEmberHUD)가 한다. 여기서는 부를지만 정한다. */
+void
+Presenter::encodeEmberHud(WMT::CommandBuffer cmdbuf, WMT::Texture target) {
+  auto now = std::chrono::steady_clock::now();
+  if (!hud_drawing_ && now < hud_next_) return;
+  if (!hud_.create(device_)) {
+    hud_next_ = now + std::chrono::hours(24);
+    return;
+  }
+  uint32_t drawn = 0;
+  int ms = hud_.encode(cmdbuf, target, hud_transfer_, drawn);
+  hud_drawing_ = ms == 0;
+  hud_next_ = now + std::chrono::milliseconds(ms);
+}
+
+/* Ember 프레임 오버레이. 드로어블 위에 알파 블렌딩으로 텍스트 상자를 얹는다.
+ * (loagpu, 10-03) in_pass 가 있으면 그 표시 패스 안에서 글자 상자 영역만 그린다(EMBER_D11_OVERLAY_INPASS=1, 기본).
+ * 예전엔 표시 프레임마다(보간·원본 둘 다) 화면 전체를 Load/Store 하는 패스를 따로 열고 전체 화면 삼각형으로 모든 픽셀을
+ * 블렌딩했다 — 4K 에서 한 장에 66MB 읽고 쓰기 + 830만 조각. 0 이면 예전 방식. */
+void
+Presenter::encodeOverlay(WMT::CommandBuffer cmdbuf, WMT::Texture target, WMT::RenderCommandEncoder *in_pass, bool box_pass,
+                         WMT::Fence wait) {
+  std::string text;
+  {
+    std::lock_guard<std::mutex> lock(overlay_mutex_);
+    text = overlay_text_;
+  }
+  if (text.empty() || !overlay_pso_) return;
+
+  // 줄 나누기, 열 수 = 가장 긴 줄
+  std::vector<std::string> lines;
+  size_t start = 0, cols = 0;
+  while (start <= text.size()) {
+    size_t nl = text.find('\n', start);
+    std::string line = text.substr(start, nl == std::string::npos ? std::string::npos : nl - start);
+    cols = std::max(cols, line.size());
+    lines.push_back(std::move(line));
+    if (nl == std::string::npos) break;
+    start = nl + 1;
+  }
+  if (!cols || lines.empty()) return;
+  cols = std::min<size_t>(cols, 120);
+  size_t rows = std::min<size_t>(lines.size(), 16);
+  std::vector<unsigned char> cells(cols * rows, ' ');
+  for (size_t r = 0; r < rows; r++)
+    for (size_t c = 0; c < cols && c < lines[r].size(); c++)
+      cells[r * cols + c] = (unsigned char)lines[r][c];
+
+  struct {
+    uint32_t origin_x, origin_y, cols, rows, scale, pad0, pad1, pad2;
+    float bg[4];
+    float fg[4];
+  } params;
+  uint32_t height = (uint32_t)target.height();
+  params.scale = std::max<uint32_t>(1, height / 720);   // 720p → 1배, 1440p → 2배, 4K → 3배
+  params.origin_x = 12 * params.scale;
+  params.origin_y = 12 * params.scale;
+  params.cols = (uint32_t)cols;
+  params.rows = (uint32_t)rows;
+  params.pad0 = params.pad1 = params.pad2 = 0;
+  params.bg[0] = 0; params.bg[1] = 0; params.bg[2] = 0; params.bg[3] = 0.55f;
+  params.fg[0] = 1; params.fg[1] = 1; params.fg[2] = 1; params.fg[3] = 1;
+  // Ember(hdr12): PQ 레이어에선 1.0 이 10000nit(눈부신 흰 글자) — SDR 흰색(100nit = EDR 1.0)의 PQ 값으로
+  if (hud_transfer_ == emberhud::TRANSFER_PQ) params.fg[0] = params.fg[1] = params.fg[2] = 0.5081f;
+
+  auto draw = [&](WMT::RenderCommandEncoder &encoder, bool box) {
+    encoder.setRenderPipelineState(overlay_pso_);
+    encoder.setFragmentBytes(&params, sizeof(params), 0);
+    encoder.setFragmentBytes(cells.data(), cells.size(), 1);
+    encoder.setFragmentBytes(ember_hud_font, sizeof(ember_hud_font), 2);
+    const uint64_t tw = target.width(), th = target.height();
+    if (box) {
+      // 글자 상자만 래스터화: 뷰포트·가위를 상자에 맞춘다(조각 위치는 화면 좌표 그대로라 셰이더는 같다)
+      uint64_t x0 = std::min<uint64_t>(params.origin_x, tw), y0 = std::min<uint64_t>(params.origin_y, th);
+      uint64_t bw = std::min<uint64_t>((uint64_t)params.cols * 8 * params.scale, tw - x0);
+      uint64_t bh = std::min<uint64_t>((uint64_t)params.rows * 16 * params.scale, th - y0);
+      if (!bw || !bh) return;
+      encoder.setViewport({(double)x0, (double)y0, (double)bw, (double)bh, 0, 1});
+      struct wmtcmd_render_setscissorrect sc;
+      sc.type = WMTRenderCommandSetScissorRect;
+      sc.next.set(nullptr);
+      sc.scissor_rect = {x0, y0, bw, bh};
+      encoder.encodeCommands((const wmtcmd_render_nop *)&sc);
+    } else {
+      encoder.setViewport({0, 0, (double)tw, (double)th, 0, 1});
+    }
+    encoder.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+    if (box && in_pass) {
+      // 같은 패스의 뒤 그리기(HUD 등)를 위해 전체 화면으로 되돌린다
+      struct wmtcmd_render_setscissorrect sc;
+      sc.type = WMTRenderCommandSetScissorRect;
+      sc.next.set(nullptr);
+      sc.scissor_rect = {0, 0, tw, th};
+      encoder.encodeCommands((const wmtcmd_render_nop *)&sc);
+      encoder.setViewport({0, 0, (double)tw, (double)th, 0, 1});
+    }
+  };
+  if (in_pass) {
+    draw(*in_pass, true);
+    return;
+  }
+  WMTRenderPassInfo info;
+  WMT::InitializeRenderPassInfo(info);
+  info.colors[0].load_action = WMTLoadActionLoad;
+  info.colors[0].store_action = WMTStoreActionStore;
+  info.colors[0].texture = target;
+  auto encoder = cmdbuf.renderCommandEncoder(info);
+  emberLabel(encoder, "EmberOverlay");
+  if (wait) encoder.waitForFence(wait, WMTRenderStageFragment);
+  draw(encoder, box_pass);
+  encoder.endEncoding();
+}
+
+void
+Presenter::queueFrameDump(WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, DXMTPresentMetadata blend_meta, bool mc,
+                          std::function<void(WMT::RenderCommandEncoder)> &wait_fences) {
+  auto shared = [&](WMTPixelFormat fmt, bool rt) {
+    WMTTextureInfo info;
+    info.type = WMTTextureType2D;
+    info.pixel_format = fmt;
+    info.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | (rt ? WMTTextureUsageRenderTarget : 0));
+    info.options = WMTResourceStorageModeShared;
+    info.width = backbuffer.width();
+    info.height = backbuffer.height();
+    info.depth = 1;
+    info.mipmap_level_count = 1;
+    info.sample_count = 1;
+    info.array_length = 1;
+    return device_.newTexture(info);
+  };
+  PendingDump d;
+  d.frame = frame_no_;
+  d.alpha = blend_meta.blend_weight;
+  d.mc = mc;
+  d.prev = shared(previous_frame_.pixelFormat(), false);
+  d.cur = shared(backbuffer.pixelFormat(), false);
+  d.gen_blend = shared(layer_props_.pixel_format, true);
+  if (mc) d.gen_mc = shared(layer_props_.pixel_format, true);
+  if (!d.prev || !d.cur || !d.gen_blend || (mc && !d.gen_mc)) return;
+  // Ember: 표시 패스와 같은 파이프라인(크기 일치 변형)으로 백버퍼 크기 그대로 그린다 — 드로어블 크기와 무관하게 비교
+  auto render = [&](WMT::Texture target, bool use_mc) {
+    WMTRenderPassInfo info;
+    WMT::InitializeRenderPassInfo(info);
+    info.colors[0].load_action = WMTLoadActionDontCare;
+    info.colors[0].store_action = WMTStoreActionStore;
+    info.colors[0].texture = target;
+    auto enc = cmdbuf.renderCommandEncoder(info);
+    wait_fences(enc);
+    if (use_mc) enc.waitForFence(mc_fence_, WMTRenderStageFragment);
+    enc.setFragmentTexture(gamma_lut_texture_, 1);
+    if (autohdr_active_ && ahdr_gain_.handle) enc.setFragmentTexture(ahdr_gain_, 3);   // Ember Auto HDR
+    enc.setFragmentBytes(&blend_meta, sizeof(blend_meta), 0);
+    if (use_mc) {
+      enc.setFragmentTexture(mc_out_, 0);
+      enc.setRenderPipelineState(present_blit_);
+    } else {
+      enc.setFragmentTexture(backbuffer, 0);
+      enc.setFragmentTexture(previous_frame_, 2);
+      enc.setRenderPipelineState(present_blend_blit_);
+    }
+    enc.setViewport({0, 0, (double)backbuffer.width(), (double)backbuffer.height(), 0, 1});
+    enc.drawPrimitives(WMTPrimitiveTypeTriangle, 0, 3);
+    enc.endEncoding();
+  };
+  render(d.gen_blend, false);
+  if (mc) render(d.gen_mc, true);
+  // Ember: 현재 프레임(백버퍼) 사본은 이전 프레임 사본 패스 뒤에 펜스를 기다려 뜬다(copyDumpCurrent)
+  auto copy = [&](WMT::Texture src, WMT::Texture dst) {
+    struct wmtcmd_blit_copy_from_texture_to_texture cmd;
+    cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+    cmd.next.set(nullptr);
+    cmd.src = src.handle;
+    cmd.src_slice = 0;
+    cmd.src_level = 0;
+    cmd.src_origin = {0, 0, 0};
+    cmd.src_size = {src.width(), src.height(), 1};
+    cmd.dst = dst.handle;
+    cmd.dst_slice = 0;
+    cmd.dst_level = 0;
+    cmd.dst_origin = {0, 0, 0};
+    auto blit = cmdbuf.blitCommandEncoder();
+    blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+    blit.endEncoding();
+  };
+  copy(previous_frame_, d.prev);
+  pending_dumps_.push_back(std::move(d));
+  dumps_queued_++;
+  last_dump_frame_ = frame_no_;
+}
+
+void
+Presenter::copyDumpCurrent(WMT::CommandBuffer cmdbuf, WMT::Texture backbuffer, bool wait_copy) {
+  auto &d = pending_dumps_.back();
+  struct wmtcmd_blit_copy_from_texture_to_texture cmd;
+  cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+  cmd.next.set(nullptr);
+  cmd.src = backbuffer.handle;
+  cmd.src_slice = 0;
+  cmd.src_level = 0;
+  cmd.src_origin = {0, 0, 0};
+  cmd.src_size = {backbuffer.width(), backbuffer.height(), 1};
+  cmd.dst = d.cur.handle;
+  cmd.dst_slice = 0;
+  cmd.dst_level = 0;
+  cmd.dst_origin = {0, 0, 0};
+  auto blit = cmdbuf.blitCommandEncoder();
+  if (wait_copy) blit.waitForFence(copy_fence_);
+  blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  if (wait_copy) blit.updateFence(copy_fence_);   // Ember: 현재 프레임 패스가 이 읽기까지 기다리게
+  blit.endEncoding();
+}
+
+void
+Presenter::copyDumpUpscaled(WMT::CommandBuffer cmdbuf, WMT::Texture upscaled) {
+  auto &d = pending_dumps_.back();
+  auto shared = [&](WMT::Texture like) {
+    WMTTextureInfo info;
+    info.type = WMTTextureType2D;
+    info.pixel_format = like.pixelFormat();
+    info.usage = WMTTextureUsageShaderRead;
+    info.options = WMTResourceStorageModeShared;
+    info.width = like.width();
+    info.height = like.height();
+    info.depth = 1;
+    info.mipmap_level_count = 1;
+    info.sample_count = 1;
+    info.array_length = 1;
+    return device_.newTexture(info);
+  };
+  d.up_gen = shared(gen_up_);
+  d.up_cur = shared(upscaled);
+  if (!d.up_gen || !d.up_cur) return;
+  auto copy = [&](WMT::Texture src, WMT::Texture dst, WMT::Fence wait) {
+    struct wmtcmd_blit_copy_from_texture_to_texture cmd;
+    cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+    cmd.next.set(nullptr);
+    cmd.src = src.handle;
+    cmd.src_slice = 0;
+    cmd.src_level = 0;
+    cmd.src_origin = {0, 0, 0};
+    cmd.src_size = {src.width(), src.height(), 1};
+    cmd.dst = dst.handle;
+    cmd.dst_slice = 0;
+    cmd.dst_level = 0;
+    cmd.dst_origin = {0, 0, 0};
+    auto blit = cmdbuf.blitCommandEncoder();
+    blit.waitForFence(wait);   // Ember: MetalFX 출력(EndScaler 가 올린 펜스)을 기다린다
+    blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+    blit.endEncoding();
+  };
+  copy(gen_up_, d.up_gen, up_gen_fence_);
+  copy(upscaled, d.up_cur, up_fence_);
+}
