--- /dev/null
+++ b/src/dxmt/ember_fg_hook.hpp
@@ -0,0 +1,264 @@
+/*
+ * Ember FG hook — thin connection from the DXMT presenter to the optional EmberCore frame generation engine
+ * (libEmberFG.dylib, loaded by winemetal's unix side). All frame generation decisions and the motion-compensated
+ * interpolation run inside that library; this file only marshals calls. Without the library frame generation is off.
+ *
+ * The wire structs below mirror EmberCore/include/ember_fg.h (ABI 1.x) byte for byte.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#pragma once
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include "Metal.hpp"
+
+namespace dxmt {
+
+namespace emberfg {
+struct Config {
+  uint32_t size;
+  uint32_t ring_enabled, ring_drawables, ring_sync;
+  int32_t ring_phase;
+  uint32_t ring_copy_draw;
+  double ring_phase_lead;
+  uint32_t mc_enabled, queue_guard, smooth, log, ring_slots, ring_frames_ahead;
+};
+enum : uint32_t { IN_FRAMEGEN = 1, IN_PREV_VALID = 2, IN_TEST_DUP = 4, IN_PRE_UP = 8 };
+struct FrameIn {
+  uint32_t size, flags;
+  int64_t now_ns;
+  uint64_t frame_no;
+  double display_interval, display_latency_ms;
+};
+enum : uint32_t { PLAN_GENERATE = 1, PLAN_MC = 2, PLAN_KEEP_PREVIOUS = 4 };
+struct FramePlan {
+  uint32_t size, flags;
+  float blend_weight, pad0;
+  double defer, cadence_hold;
+};
+constexpr uint32_t kMaxWaitFences = 256;
+struct EncodeIn {
+  uint32_t size, n_wait_fences;
+  uint64_t command_buffer, current, previous, current_iosurface, current_format;
+  float alpha, pad0;
+  uint64_t wait_fences[kMaxWaitFences];
+  /* ABI 1.4 꼬리: AneSubmit 의 짝 번호(0 = 예전과 같음). 쓰지 않을 때는 size 를 kEncodeInV10Size 로 보내 옛 엔진과 같은 바이트만 넘긴다. */
+  uint64_t ane_pair_id;
+};
+/* ane_pair_id 앞까지 = ABI 1.0~1.3 크기 */
+constexpr uint32_t kEncodeInV10Size = 56 + 8 * kMaxWaitFences;
+/* (dxmt-ane 10-16) ember_fg_ane_submit_in(ABI 1.4) — FlowQ 뉴럴 엔진 흐름 미리 보내기(EMBER_FG_OP_ANE_SUBMIT) */
+struct AneSubmitIn {
+  uint32_t size, n_wait_fences;
+  uint64_t command_buffer, current, previous;
+  uint64_t pair_id;
+  int64_t deadline_ns;            /* EmberFgHook::aneSubmit 은 "지금부터 ns" 로 넘긴다(유닉스 쪽이 mach 시각으로 바꿈) */
+  uint64_t wait_fences[kMaxWaitFences];
+  int64_t source_time_ns, interval_ns;   /* 0 = 예전 호출(쓰지 않음) */
+  uint32_t reuse_previous, reserved;     /* FlowQ 는 reuse 를 무시한다 — 0 */
+};
+enum : int { ANE_UNAVAILABLE = -1, ANE_PENDING = 0, ANE_READY = 1, ANE_ENCODED = 2 };
+struct EncodeOut {
+  uint32_t size, ok;
+  uint64_t texture, fence;
+};
+struct RingReq {
+  uint32_t size, need_generated;
+  uint64_t width, height, pixel_format;
+  uint64_t timeout_ns;   /* 1.5 꼬리(realign-1020): 옛 엔진은 앞 32 바이트만 읽는다 */
+};
+struct RingSlots {
+  uint32_t size, ok;
+  int32_t gen_slot, cur_slot;
+  uint64_t gen_texture, cur_texture;
+};
+enum : uint32_t { DROP_STALE = 0, DROP_LATE = 1, DROP_NO_DRAWABLE = 2, DROP_RING = 3 };
+struct Stats {
+  uint32_t size, guard_active;
+  int32_t guard_reason, backoff_level;
+  double guard_cost, guard_native_fps, guard_hold_left;
+  uint32_t active, fast;
+  double game_interval, mc_confidence, dump_mean_conf;
+};
+static_assert(sizeof(Config) == 56 && sizeof(FrameIn) == 40 && sizeof(FramePlan) == 32 && sizeof(EncodeIn) == kEncodeInV10Size + 8 &&
+              offsetof(EncodeIn, ane_pair_id) == kEncodeInV10Size && sizeof(AneSubmitIn) == 2120 &&
+              offsetof(AneSubmitIn, wait_fences) == 48 && offsetof(AneSubmitIn, source_time_ns) == 48 + 8 * kMaxWaitFences &&
+              sizeof(EncodeOut) == 24 && sizeof(RingReq) == 40 && sizeof(RingSlots) == 32 && sizeof(Stats) == 72, "EmberFG wire layout");
+
+/* (realign-1020 B) Ember 표시 큐(libEmberFG ABI 1.5 ember_fg_dq.h, HOST_THREAD) 거울 */
+enum : uint32_t { DQ_PRESENT_AFTER_MIN = 0, DQ_PRESENT_CPU_TIMED = 1 };
+enum : uint32_t { DQ_F_HOST_PRESENTS = 1, DQ_F_NO_FG = 2, DQ_F_HOST_THREAD = 4 };
+struct DqDesc {
+  uint32_t size, slots;
+  uint64_t width, height, pixel_format;
+  uint64_t layer, queue;
+  uint32_t present_mode, flags;
+  uint64_t compose, compose_user;   /* HOST_THREAD: 0 */
+  uint32_t wedge_ms, pad0;
+  int64_t clock_offset_ns;
+};
+struct DqAcquireIn {
+  uint32_t size, pad0;
+  uint64_t width, height, pixel_format;
+  int64_t max_wait_ns;   /* 빈 슬롯 기다림 상한(0 = 바로) */
+};
+struct DqSlot {
+  uint32_t size;
+  int32_t slot;
+  uint64_t texture, event, signal_value;
+  uint32_t stolen, pad0;
+};
+struct FrameIn12 {   /* ember_fg_frame_in 1.2 전체(64) — 앞 40 은 FrameIn 과 같음, 뒤 24 는 0 */
+  FrameIn base;
+  int64_t latency_sample_ns, transport_start_ns;
+  uint32_t transport_outstanding, telemetry_flags;
+};
+struct DqSubmitIn {
+  uint32_t size;
+  int32_t slot;
+  FrameIn12 frame;
+  uint64_t host_tag;
+  uint32_t no_fg, pad0;
+  uint64_t host_event, host_value;   /* 0 = 슬롯 이벤트 */
+};
+struct DqPullIn {
+  uint32_t size, pad0;
+  int64_t timeout_ns;
+};
+struct DqFrame {
+  uint32_t size;
+  int32_t slot;
+  uint64_t seq;
+  uint64_t texture, event, signal_value;
+  int32_t prev_slot;
+  uint32_t stolen;
+  uint64_t prev_texture;
+  FramePlan plan;
+  int64_t arrival_ns;
+  uint64_t host_tag;
+};
+struct DqGenIn {
+  uint32_t size, pad0;
+  uint64_t seq, command_buffer;
+};
+struct DqDoneIn {
+  uint32_t size;
+  int32_t shown;
+  uint64_t seq, command_buffer;
+};
+struct DqStats {
+  uint32_t size, broken;
+  uint64_t submitted, pulled, presented, generated, acquire_fail, stolen, abandoned, wedges;
+  int64_t max_acquire_wait_ns, max_game_call_ns, max_queue_ns, max_display_ns, max_gpu_wait_ns;
+};
+static_assert(sizeof(FrameIn12) == 64 && offsetof(DqFrame, plan) == 56 && offsetof(DqFrame, arrival_ns) == 88 &&
+              offsetof(DqSubmitIn, host_event) == 88, "dq offsets");
+static_assert(sizeof(DqDesc) == 88 && sizeof(DqAcquireIn) == 40 && sizeof(DqSlot) == 40 && sizeof(DqSubmitIn) == 104 &&
+              sizeof(DqPullIn) == 16 && sizeof(DqFrame) == 104 && sizeof(DqGenIn) == 24 && sizeof(DqDoneIn) == 24 &&
+              sizeof(DqStats) == 112, "Ember display queue wire layout");
+
+inline int64_t now_ns(std::chrono::steady_clock::time_point t) {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(t.time_since_epoch()).count();
+}
+} // namespace emberfg
+
+class EmberFgHook {
+public:
+  EmberFgHook() = default;
+  EmberFgHook(const EmberFgHook &) = delete;
+  ~EmberFgHook();
+  /// Loads the engine for this presenter. false = library missing/failed (frame generation stays off).
+  bool create(WMT::Device device);
+  bool ok() const { return ctx_ != 0; }
+  const emberfg::Config &config() const { return config_; }
+  void beginFrame(const emberfg::FrameIn &in, emberfg::FramePlan &plan);
+  bool encode(const emberfg::EncodeIn &in, emberfg::EncodeOut &out);
+  bool ringAcquire(const emberfg::RingReq &in, emberfg::RingSlots &out);
+  void ringRelease(int slot, bool frame_done);
+  void ringWaitIdle();
+  void noteDrop(uint32_t kind);
+  void stats(int64_t now, emberfg::Stats &out);
+  std::string hudText(int64_t now, double game_fps, uint64_t generated);
+  /// (dxmt-ane 10-16) EMBER_FG_ANE=flowq 로 엔진을 만들었는가(환경 또는 C:\ember-d11.cfg, 만들 때 한 번 읽음). false 면 아래 둘은 부르지 않는다.
+  bool aneFlowq() const { return ctx_ != 0 && ane_flowq_; }
+  /// Exact LLFI opt-in from the same env/config snapshot passed to the engine.
+  bool aneLate() const { return ctx_ != 0 && ane_late_; }
+  /// (llfi 10-17) 켜진 공급원 이름("flowq"|"llfi") — 로그용. 꺼져 있으면 "off".
+  const char *aneSource() const { return ane_flowq_ ? ane_source_.c_str() : "off"; }
+  /// 원본 쌍을 뉴럴 엔진으로 미리 보낸다(in.deadline_ns = 지금부터 ns). true = 받음(아직 준비 아님). 옛 winemetal/엔진이면 false.
+  bool aneSubmit(const emberfg::AneSubmitIn &in);
+  /// 짝 번호 상태(emberfg::ANE_*). 소비하지 않는다.
+  int aneStatus(uint64_t pair_id);
+
+  /// (realign-1020 A) 엔진 상한 링 비우기(ABI 1.5). 1 비었음, 0 시간 초과, -1 엔진에 없음
+  int ringWaitIdleTimed(int64_t timeout_ns);
+  /// (realign-1020 B) Ember 표시 큐 — 엔진에 있으면(ABI 1.5 dq) true
+  bool dqAvailable();
+  uint64_t dqCreate(const emberfg::DqDesc &desc);
+  void dqDestroy(uint64_t dq, int64_t timeout_ns);
+  int dqTryAcquire(uint64_t dq, const emberfg::DqAcquireIn &in, emberfg::DqSlot &out);
+  int dqSubmit(uint64_t dq, const emberfg::DqSubmitIn &in, emberfg::FramePlan &plan);
+  void dqAbandon(uint64_t dq, int32_t slot);
+  int dqPull(uint64_t dq, int64_t timeout_ns, emberfg::DqFrame &out);
+  bool dqEncodeGen(uint64_t dq, uint64_t seq, uint64_t cmdbuf, emberfg::EncodeOut &out);
+  void dqPresentDone(uint64_t dq, uint64_t seq, uint64_t cmdbuf, bool shown);
+  int dqDrain(uint64_t dq, int64_t timeout_ns);
+  void dqStats(uint64_t dq, emberfg::DqStats &out);
+
+private:
+  int32_t call(uint32_t op, const void *in, uint64_t in_size, void *out, uint64_t out_size, bool drain_log, int64_t i64 = 0,
+               double f64 = 0, int64_t a0 = 0, uint64_t a1 = 0);
+  void *fn_ = nullptr;
+  uint64_t ctx_ = 0;
+  emberfg::Config config_{};
+  bool ane_flowq_ = false; // (llfi 10-17) flowq|llfi 공급원 켬 — 이름은 옛 그대로
+  std::string ane_source_;
+  bool ane_late_ = false;
+  int dq_abi_ = -1;   /* -1 모름 */
+};
+
+/// Ember in-game HUD — thin connection to the optional EmberCore HUD library (libEmberHUD.dylib, loaded by winemetal's unix side).
+/// The library maps the Ember app's shared panel images for this process and blends visible panels onto the frame that goes
+/// to the screen (one small render pass). Without the library (or an older winemetal) nothing is drawn.
+namespace emberhud {
+enum : uint32_t { TRANSFER_AUTO = 0, TRANSFER_LINEAR = 1, TRANSFER_PQ = 2 };
+struct EncodeIn {
+  uint32_t size, transfer;
+  uint64_t command_buffer, target;
+  float sdr_white, pad0;
+};
+struct EncodeOut {
+  uint32_t size, drawn;
+  int32_t next_call_ms;
+  uint32_t attached;
+};
+static_assert(sizeof(EncodeIn) == 32 && sizeof(EncodeOut) == 16, "EmberHUD wire layout");
+} // namespace emberhud
+
+class EmberHudHook {
+public:
+  EmberHudHook() = default;
+  EmberHudHook(const EmberHudHook &) = delete;
+  ~EmberHudHook();
+  /// Creates the HUD context once (later calls return the first result).
+  bool create(WMT::Device device);
+  bool ok() const { return ctx_ != 0; }
+  /// True only when the negotiated native watcher sees no visible panels.
+  /// A config transition returns false until encode has notified the watcher.
+  bool idle() const;
+  /// Draws visible panels onto target. Returns how long (ms) the caller may skip calls (0 = every frame).
+  int encode(WMT::CommandBuffer cmdbuf, WMT::Texture target, uint32_t transfer, uint32_t &drawn);
+
+private:
+  void *fn_ = nullptr;
+  uint64_t ctx_ = 0;
+  bool tried_ = false;
+  uint64_t idle_gate_ = 0;
+  bool idle_enabled_ = false;
+};
+
+} // namespace dxmt
diff --git a/src/dxmt/ember_fg_late.hpp b/src/dxmt/ember_fg_late.hpp
new file mode 100644
index 0000000..3227a09
--- /dev/null
+++ b/src/dxmt/ember_fg_late.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace dxmt::emberfg {
+// Presenter clock only. The hook passes a relative budget to the native clock.
+// Reserve the existing 1ms grace for take/compose after the last status poll.
+struct AneLateWindow {
+  uint64_t pair = 0;
+  int64_t submitted_ns = 0, collect_until_ns = 0;
+  bool accepted = false;
+
+  void submit(uint64_t id, int64_t now, int64_t budget, bool admitted) {
+    pair = id;
+    submitted_ns = now;
+    collect_until_ns = now + std::max(int64_t(0), budget - 1000000);
+    accepted = admitted;
+  }
+  int64_t nap_ns(uint64_t id, int64_t now, int status) const {
+    if (!accepted || !id || id != pair || status != 0 || now >= collect_until_ns) return 0;
+    return std::min(int64_t(250000), collect_until_ns - now);
+  }
+};
+}
diff --git a/src/dxmt/ember_fg_smooth_hold.hpp b/src/dxmt/ember_fg_smooth_hold.hpp
new file mode 100644
