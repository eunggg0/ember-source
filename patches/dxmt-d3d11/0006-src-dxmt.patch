+  p.dqDone(f, cb, true);   // 이 원본(과 앞 원본)을 읽는 마지막 cb — 엔진이 완료 처리기에서 슬롯을 넘긴다
+  cb.commit();
+  auto t_done = clock::now();
+  if (item.handoff.time_since_epoch().count() && item.commit.time_since_epoch().count()) {
+    auto ms = [](clock::time_point a, clock::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+    lat_enc_ += ms(item.handoff, item.commit);
+    lat_gpu_ += ms(item.commit, t_ready);
+    lat_draw_ += ms(t_ready, t_draw);
+    lat_blit_ += ms(t_draw, t_done);
+  }
+  recordQueueLatency(item.handoff);
+}
+
+void CommandQueue::recordQueueLatency(std::chrono::steady_clock::time_point handoff) {
+  static int on = -1;
+  if (on < 0) {
+    const char *e = std::getenv("EMBER_FG_LOG");
+    if (!e) e = std::getenv("EMBER_D3DM_FG_LOG");
+    on = e && !std::strcmp(e, "1");
+  }
+  if (!handoff.time_since_epoch().count()) return;
+  auto now = std::chrono::steady_clock::now();
+  double d = std::chrono::duration<double>(now - handoff).count();
+  if (d > 0 && d < 1.0) {   // 오버레이용 지수 평균(로그와 무관하게 늘)
+    double e = queue_lat_ema_.load(std::memory_order_relaxed);
+    queue_lat_ema_.store(e > 0 ? e * 0.9 + d * 0.1 : d, std::memory_order_relaxed);
+  }
+  if (!on) return;
+  if (d > 0 && d < 1.0) { lat_queue_sum_ += d; lat_queue_n_++; }
+  if (!lat_since_.time_since_epoch().count()) lat_since_ = now;
+  else if (std::chrono::duration<double>(now - lat_since_).count() >= 5.0) {
+    double n = lat_queue_n_ ? lat_queue_n_ : 1;
+    char line[300];
+    std::snprintf(line, sizeof(line), "dxmt-lat: queue=%.1fms frames=%u gen_skip=%u no_drawable=%u enc=%.1f gpu=%.1f draw=%.1f blit=%.1f wait=%.1f no_phase=%u backlog_skip=%u",
+                 lat_queue_n_ ? lat_queue_sum_ / lat_queue_n_ * 1000 : 0.0, lat_queue_n_, pacer_gen_skip_, pacer_no_drawable_,
+                 lat_enc_ / n, lat_gpu_ / n, lat_draw_ / n, lat_blit_ / n, lat_wait_ / n, pacer_no_phase_, pacer_gen_backlog_);
+    Logger::info(line);   // Ember(fgguard): stderr 대신 로거(스팀이 띄운 게임에서도 남게)
+    lat_queue_sum_ = 0; lat_queue_n_ = 0; lat_since_ = now; pacer_gen_skip_ = 0; pacer_no_drawable_ = 0; pacer_no_phase_ = 0; pacer_gen_backlog_ = 0;
+    lat_enc_ = lat_gpu_ = lat_draw_ = lat_blit_ = lat_wait_ = 0;
+  }
+}
