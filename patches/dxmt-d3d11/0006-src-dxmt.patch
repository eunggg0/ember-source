+namespace {
+float ember_half_to_float(uint16_t h) {
+  uint32_t s = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 1023;
+  float v = e == 0 ? std::ldexp((float)m, -24) : e == 31 ? 65504.f : std::ldexp((float)(m | 1024), (int)e - 25);
+  return s ? -v : v;
+}
+
+bool ember_write_ppm(const std::string &path, WMT::Texture t) {
+  uint32_t w = (uint32_t)t.width(), h = (uint32_t)t.height();
+  auto fmt = t.pixelFormat();
+  uint32_t bpp;
+  switch (fmt) {
+  case WMTPixelFormatRGBA8Unorm: case WMTPixelFormatRGBA8Unorm_sRGB:
+  case WMTPixelFormatBGRA8Unorm: case WMTPixelFormatBGRA8Unorm_sRGB: bpp = 4; break;
+  case WMTPixelFormatRGBA16Float: bpp = 8; break;
+  default: return false;
+  }
+  std::vector<uint8_t> raw((size_t)w * h * bpp);
+  t.getBytes({0, 0, 0}, {w, h, 1}, 0, 0, raw.data(), w * bpp, 0);
+  FILE *f = std::fopen(path.c_str(), "wb");
+  if (!f) return false;
+  std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+  std::vector<uint8_t> row((size_t)w * 3);
+  bool bgr = fmt == WMTPixelFormatBGRA8Unorm || fmt == WMTPixelFormatBGRA8Unorm_sRGB;
+  for (uint32_t y = 0; y < h; y++) {
+    for (uint32_t x = 0; x < w; x++) {
+      const uint8_t *p = &raw[((size_t)y * w + x) * bpp];
+      if (bpp == 4) {
+        row[x * 3 + 0] = bgr ? p[2] : p[0];
+        row[x * 3 + 1] = p[1];
+        row[x * 3 + 2] = bgr ? p[0] : p[2];
+      } else {
+        const uint16_t *q = (const uint16_t *)p;
+        for (int c = 0; c < 3; c++)
+          row[x * 3 + c] = (uint8_t)std::clamp(ember_half_to_float(q[c]) * 255.f + 0.5f, 0.f, 255.f);
+      }
+    }
+    std::fwrite(row.data(), 1, row.size(), f);
+  }
+  std::fclose(f);
+  return true;
+}
+} // namespace
+
+void
+Presenter::flushFrameDumps(bool force) {
+  for (auto it = pending_dumps_.begin(); it != pending_dumps_.end();) {
+    // Ember: 8 프레임 뒤면 그 커맨드 버퍼는 GPU 에서 끝났다(드로어블이 3장뿐이라 더 앞서 갈 수 없다)
+    if (!force && frame_no_ < it->frame + 8) { ++it; continue; }
+    char base[64];
+    std::snprintf(base, sizeof(base), "/fg_%06llu", (unsigned long long)it->frame);
+    std::string b = dump_dir_ + base;
+    bool ok = ember_write_ppm(b + "_prev.ppm", it->prev) && ember_write_ppm(b + "_cur.ppm", it->cur) &&
+              ember_write_ppm(b + "_blend.ppm", it->gen_blend);
+    if (ok && it->mc) ok = ember_write_ppm(b + "_mc.ppm", it->gen_mc);
+    if (ok && it->up_gen && it->up_cur)   // Ember: MetalFX 앞 보간 — 키운 보간 프레임·키운 원본
+      ok = ember_write_ppm(b + "_up_gen.ppm", it->up_gen) && ember_write_ppm(b + "_up_cur.ppm", it->up_cur);
+    float conf = -1;
+    if (fg_.ok()) {   // Ember: 마지막 MC 프레임의 평균 신뢰도(엔진 통계)
+      emberfg::Stats st;
+      fg_.stats(emberfg::now_ns(std::chrono::steady_clock::now()), st);
+      conf = (float)st.dump_mean_conf;
+    }
+    if (FILE *f = std::fopen((b + "_meta.txt").c_str(), "w")) {
+      std::fprintf(f, "frame=%llu\nalpha=%.6f\nmc=%d\nmean_conf=%.4f\nwidth=%llu\nheight=%llu\nfmt_cur=%d\nfmt_gen=%d\n",
+                   (unsigned long long)it->frame, it->alpha, (int)it->mc, conf,
+                   (unsigned long long)it->cur.width(), (unsigned long long)it->cur.height(),
+                   (int)it->cur.pixelFormat(), (int)it->gen_blend.pixelFormat());
+      std::fclose(f);
+    }
+    std::fprintf(stderr, "dxmt-fg-dump: %s %s alpha=%.3f mc=%d\n", b.c_str(), ok ? "ok" : "FAILED", it->alpha, (int)it->mc);
+    it = pending_dumps_.erase(it);
+  }
 }
 
 void
 Presenter::buildRenderPipelineState(bool is_pq, bool with_hdr_metadata, bool is_ms, bool gamma_enable) {
+  // (realign-1020 A, R3) 조합별 보관: 감마 램프·AutoHDR 켬끔·HDR 메타가 오갈 때마다 게임 스레드에서 다시 컴파일하던 것을 한 번만.
+  // 컴파일은 잠금 밖, 바꿔 끼우기만 pso_mu_ 안(페이서 encodeRingBlit 이 같은 멤버를 읽는다).
+  uint32_t sharp_bits;
+  {
+    float sh = sharpness_;
+    std::memcpy(&sharp_bits, &sh, sizeof(sh));
+  }
+  const uint64_t key = (uint64_t)is_pq | ((uint64_t)with_hdr_metadata << 1) | ((uint64_t)is_ms << 2) | ((uint64_t)gamma_enable << 3) |
+                       ((uint64_t)Is_sRGBVariant(source_format_) << 4) | ((uint64_t)autohdr_active_ << 5) |
+                       ((uint64_t)(layer_props_.pixel_format & 0xffff) << 8) | ((uint64_t)sharp_bits << 24) | (1ull << 63);
+  const bool use_cache = EmberD11Get(kEmberD11PsoCache) == 1;
+  PsoSet set;
+  bool found = false;
+  if (use_cache)
+    for (auto &c : pso_cache_)
+      if (c.key == key) { set = c; found = true; break; }
+  if (!found) {
+    set = compilePresentPsos(is_pq, with_hdr_metadata, is_ms, gamma_enable);
+    set.key = key;
+    if (use_cache && set.blit) {
+      if (pso_cache_.size() >= 8) pso_cache_.erase(pso_cache_.begin());
+      pso_cache_.push_back(set);
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lk(pso_mu_);
+    present_blit_ = set.blit;
+    present_scale_ = set.scale;
+    present_blend_blit_ = set.blend_blit;
+    present_blend_scale_ = set.blend_scale;
+    overlay_pso_ = set.overlay;
+    present_identity_ = set.identity;
+    pso_format_ = layer_props_.pixel_format;
+  }
+  previous_valid_ = false;
+}
