+static int ember_child_holes_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv("EMBER_CHILD_HOLES");
+        enabled = !(e && e[0] == '0');
+    }
+    return enabled;
+}
+
+static int ember_holes_used;
+
+static int ember_collect_child_holes(HWND hwnd, LONG width, LONG height, CGRect *holes, int max)
+{
+    int count = 0;
+    HWND child;
+    UINT dpi;
+
+    if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_CLIPCHILDREN)) return 0;
+    dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child && count < max;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        DWORD style = NtUserGetWindowLongW(child, GWL_STYLE);
+        DWORD ex_style = NtUserGetWindowLongW(child, GWL_EXSTYLE);
+        struct macdrv_win_data *cdata;
+        BOOL gpu = FALSE;
+        RECT rc;
+
+        if (!(style & WS_VISIBLE) || (ex_style & (WS_EX_TRANSPARENT | WS_EX_LAYERED))) continue;
+        if ((cdata = get_win_data(child)))
+        {
+            gpu = cdata->client_view != NULL;
+            release_win_data(cdata);
+        }
+        if (gpu) continue;
+        if (!NtUserGetWindowRect(child, &rc, dpi)) continue;
+        NtUserMapWindowPoints(0, hwnd, (POINT *)&rc, 2, dpi);
+        if (rc.left < 0) rc.left = 0;
+        if (rc.top < 0) rc.top = 0;
+        if (rc.right > width) rc.right = width;
+        if (rc.bottom > height) rc.bottom = height;
+        if (rc.left >= rc.right || rc.top >= rc.bottom) continue;
+        holes[count++] = cgrect_from_rect(rc);
+    }
+    return count;
+}
+
+static void ember_send_view_holes(WineContentView *view, HWND hwnd, const CGRect *holes, int count)
+{
+    if (!count && !ember_holes_used) return;
+    if (count)
