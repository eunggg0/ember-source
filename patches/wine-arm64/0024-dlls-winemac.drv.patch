diff --git a/dlls/winemac.drv/keyboard_layout.h b/dlls/winemac.drv/keyboard_layout.h
new file mode 100644
index 0000000..7dc81b3
--- /dev/null
+++ b/dlls/winemac.drv/keyboard_layout.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Keep virtual-key character tables independent of IME composition.
+ */
+#ifndef __WINE_MACDRV_KEYBOARD_LAYOUT_H
+#define __WINE_MACDRV_KEYBOARD_LAYOUT_H
+
+#include <Carbon/Carbon.h>
+
+static TISInputSourceRef macdrv_copy_layout_for_virtual_keys(void)
+{
+    TISInputSourceRef current = TISCopyCurrentKeyboardInputSource();
+    TISInputSourceRef layout = NULL;
+    CFStringRef type = current ? TISGetInputSourceProperty(current, kTISPropertyInputSourceType) : NULL;
+
+    /* An IME's layout may translate W to a Hangul jamo. Games still need
+     * Latin virtual-key characters; composition uses the original input
+     * source and NSTextInputContext separately. Physical layouts stay as-is. */
+    if (type && !CFEqual(type, kTISTypeKeyboardLayout))
+    {
+        layout = TISCopyCurrentASCIICapableKeyboardLayoutInputSource();
+        if (layout && !TISGetInputSourceProperty(layout, kTISPropertyUnicodeKeyLayoutData))
+        {
+            CFRelease(layout);
+            layout = NULL;
+        }
+    }
+    if (current) CFRelease(current);
+    if (!layout) layout = TISCopyCurrentKeyboardLayoutInputSource();
+    return layout;
+}
+
+#endif
