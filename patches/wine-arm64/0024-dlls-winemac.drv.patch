+        ember_holes_used = 1;
+        TRACE("%p: %d child hole(s), first %s\n", hwnd, count, wine_dbgstr_cgrect(holes[0]));
+    }
+    macdrv_set_view_holes(view, holes, count);
+}
+
+static void macdrv_client_surface_update_holes(struct macdrv_client_surface *surface, HWND hwnd, const RECT *client)
+{
+    CGRect holes[32];
+    int count;
+
+    if (!ember_child_holes_enabled() || !surface->cocoa_view) return;
+    count = ember_collect_child_holes(hwnd, client->right - client->left, client->bottom - client->top,
+                                      holes, ARRAY_SIZE(holes));
+    ember_send_view_holes(surface->cocoa_view, hwnd, holes, count);
+}
