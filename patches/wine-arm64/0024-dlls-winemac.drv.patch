+/* Ember: 창 모드 전체화면 스냅(EMBER_FS_SNAP, 기본 켬, "0" 이면 끔).
+ * 게임 해상도를 비정수 Retina 배율(QHD = EMBER_RETINA_SCALE 1.333333)로 만들면 2560x1440 창이 1920.0005pt 가 되고
+ * AppKit 이 바깥쪽으로 올려 1921x1081 창이 된다. 오른쪽 1pt 가 옆 모니터(x=1920)에 걸치면 WindowServer 가
+ * 전체화면으로 보지 않는다 — SkyLight DetachmentDetails::evaluate_detachment_details_for_window 는 창이
+ * 정확히 디스플레이 하나에만 걸치고 그 디스플레이와 같거나 감쌀 때만 FullScreenStatus 를 참으로 둔다.
+ * 그게 gamepolicyd 의 FullScreenGrant("Full screen gaming session is now active")이고 없으면 게임 모드가 안 켜진다.
+ * 그래서 테두리 없는 창의 네 변이 한 화면의 네 변과 각각 2pt 안이면 Cocoa 프레임만 그 화면 프레임에 딱 맞춘다.
+ * Wine 이 아는 크기(wineFrame)는 그대로 둔다 → wine_fractionalFrame 이 원래 값을 돌려주므로 되먹임이 없다. */
+static BOOL ember_fs_snap_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char* e = getenv("EMBER_FS_SNAP");
+        enabled = !(e && e[0] == '0');
+    }
+    return enabled;
+}
+
+static BOOL ember_fs_snap_frame(NSWindow* window, NSRect frame, NSRect* snapped)
+{
+    const CGFloat tol = 2.0;
+
+    if (!ember_fs_snap_enabled() || NSIsEmptyRect(frame)) return FALSE;
+    /* 테두리 있는 창·네이티브 전체화면·비활성 패널(툴팁 등)은 건드리지 않는다 */
+    if ([window styleMask] & (NSWindowStyleMaskTitled | NSWindowStyleMaskFullScreen | NSWindowStyleMaskNonactivatingPanel))
+        return FALSE;
+
+    for (NSScreen* screen in [NSScreen screens])
+    {
+        NSRect s = [screen frame];
+        if (fabs(NSMinX(frame) - NSMinX(s)) <= tol && fabs(NSMaxX(frame) - NSMaxX(s)) <= tol &&
+            fabs(NSMinY(frame) - NSMinY(s)) <= tol && fabs(NSMaxY(frame) - NSMaxY(s)) <= tol)
+        {
+            if (NSEqualRects(frame, s)) return FALSE;   /* 이미 딱 맞다 */
+            *snapped = s;
+            {
+                static BOOL logged;
+                if (!logged)
+                {
+                    logged = TRUE;
+                    fprintf(stderr, "ember-fs-snap: %.4fx%.4f @ %.4f,%.4f -> %.0fx%.0f @ %.0f,%.0f\n",
+                            frame.size.width, frame.size.height, frame.origin.x, frame.origin.y,
+                            s.size.width, s.size.height, s.origin.x, s.origin.y);
+                }
+            }
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+
 /* We rely on the supposedly device-dependent modifier flags to distinguish the
