+/* Timers poll the existing private IPC; the server event loop never waits. */
+static void shield_send_timer( void *private )
+{
+    struct send_req *req = private;
+    struct async *async = req->async;
+    struct sock *sock = req->sock;
+    int result;
+    req->shield_timer = NULL;
+    if (req->iosb->status != STATUS_PENDING) return;
+    result = es_gate_poll( &req->shield_gate, monotonic_time / 10000 );
+    if (!result)
+    {
+        req->shield_timer = add_timeout_user( -200000, shield_send_timer, req );
+        if (req->shield_timer) return;
+        result = 1;
+        es_gate_message( &req->shield_gate, "question.result", 1, 1 );
+    }
+    es_gate_close( &req->shield_gate );
+    req->shield_counted = 0;
+    --shield_pending_count;
+    /* Requeue before alerting: an EAGAIN client retry must regain normal POLLOUT. */
+    requeue_async( &sock->write_q, async );
+    grab_object( sock );
+    async_terminate( async, result < 0 ? STATUS_ACCESS_DENIED : STATUS_ALERTED );
+    sock_reselect( sock );
+    release_object( sock );
+}
