+static int shield_hold_send( struct send_req *req, const struct WS_sockaddr *address, unsigned int length )
+{
+    static unsigned long long sequence;
+    union unix_sockaddr unix_address;
+    socklen_t len;
+    char host[108], numeric[128];
+    uint64_t instance;
+    unsigned int verified, signed_valid, same_signer;
+    if (shield_pending_count >= 64 || req->sock->type != WS_SOCK_DGRAM || !length ||
+        length > sizeof(union win_sockaddr) ||
+        !es_route_read( config_dir_fd, current->process->unix_pid, host, sizeof(host),
+                        &instance, &verified, &signed_valid, &same_signer )) return 0;
+    len = sockaddr_to_unix( address, length, &unix_address );
+    if (!len || (unix_address.addr.sa_family != AF_INET && unix_address.addr.sa_family != AF_INET6) ||
+        getnameinfo( &unix_address.addr, len, numeric, sizeof(numeric), NULL, 0, NI_NUMERICHOST )) return 0;
+    if (!es_gate_open( &req->shield_gate, host, current->process->unix_pid, numeric,
+                       ((unsigned long long)getpid() << 32) ^ ++sequence, instance,
+                       verified, signed_valid, same_signer, monotonic_time / 10000 )) return 0;
+    req->shield_timer = add_timeout_user( -200000, shield_send_timer, req );
+    if (!req->shield_timer) { es_gate_close( &req->shield_gate ); return 0; }
+    req->shield_counted = 1;
+    ++shield_pending_count;
+    return 1;
+}
