+static void shield_connect_timer( void *private )
+{
+    struct shield_pending *p = private;
+    struct sock *sock = p->sock;
+    int result, ret, error = 0, unix_fd = get_unix_fd( sock->fd );
+    socklen_t len;
+    union unix_sockaddr local;
+    p->timer = NULL;
+    result = es_gate_poll( &p->gate, monotonic_time / 10000 );
+    if (!result)
+    {
+        p->timer = add_timeout_user( -200000, shield_connect_timer, p );
+        if (p->timer) return;
+        /* Allocation failure follows the same fail-open contract. */
+        result = 1;
+        es_gate_message( &p->gate, "question.result", 1, 1 );
+    }
+    if (result < 0) error = EACCES;
+    else
+    {
+        ret = connect( unix_fd, &p->address.addr, p->address_len );
+        if (ret < 0 && errno == ECONNABORTED)
+            ret = connect( unix_fd, &p->address.addr, p->address_len );
+        if (ret < 0 && errno != EINPROGRESS) error = errno;
+        sock->peer_addr_len = sockaddr_from_unix( &p->address, &sock->peer_addr.addr, sizeof(sock->peer_addr) );
+        len = sizeof(local);
+        if (!getsockname( unix_fd, &local.addr, &len ))
+            sock->addr_len = sockaddr_from_unix( &local, &sock->addr.addr, sizeof(sock->addr) );
+        sock->bound = 1;
+    }
+    grab_object( sock );
+    shield_cancel( sock );
+    if (error)
+    {
+        sock->state = SOCK_UNCONNECTED;
+        sock->errors[AFD_POLL_BIT_CONNECT_ERR] = error;
+        if (sock->connect_req) async_terminate( sock->connect_req->async, sock_get_ntstatus( error ) );
+        post_socket_event( sock, AFD_POLL_BIT_CONNECT_ERR );
+        post_sock_messages( sock );
+        complete_async_polls( sock, POLLERR, error );
+    }
+    else if (sock->type == WS_SOCK_DGRAM)
+    {
+        sock->state = SOCK_CONNECTIONLESS;
+        if (sock->connect_req) complete_async_connect( sock );
+    }
+    else
+    {
+        sock->state = SOCK_CONNECTING;
+        /* For immediate success the regular writable poll completes async/FD_CONNECT. */
+    }
+    sock_reselect( sock );
+    release_object( sock );
+}
