+static int shield_hold_connect( struct sock *sock, struct async *async,
+                                const struct afd_connect_params *params,
+                                union unix_sockaddr *address, socklen_t len, unsigned int send_len )
+{
+    static unsigned long long sequence;
+    char host[108];
+    uint64_t instance;
+    unsigned int verified, signed_valid, same_signer;
+    struct shield_pending *p;
+    struct connect_req *req = NULL;
+    char numeric[128];
+    if (shield_pending_count >= 64 || !es_route_read( config_dir_fd, current->process->unix_pid, host, sizeof(host), &instance, &verified, &signed_valid, &same_signer )) return 0;
+    /* Datagram sendto has a separate path; never misrepresent a held UDP connect as protection. */
+    if (sock->type != WS_SOCK_STREAM && sock->type != WS_SOCK_DGRAM) return 0;
+    if (getnameinfo( &address->addr, len, numeric, sizeof(numeric), NULL, 0, NI_NUMERICHOST )) return 0;
+    if (!(p = calloc( 1, sizeof(*p) ))) return 0;
+    if (!es_gate_open( &p->gate, host, current->process->unix_pid, numeric,
+                       ((unsigned long long)getpid() << 32) ^ ++sequence, instance, verified, signed_valid, same_signer, monotonic_time / 10000 ))
+    { free( p ); return 0; }
+    p->gate.instance = instance;
+    p->sock = sock; p->address = *address; p->address_len = len;
+    p->timer = add_timeout_user( -200000, shield_connect_timer, p );
+    if (!p->timer) { es_gate_close( &p->gate ); free( p ); return 0; }
+    if (!(params->synchronous && sock->nonblocking))
+    {
+        if (!(req = mem_alloc( sizeof(*req) )))
+        { remove_timeout_user( p->timer ); es_gate_close( &p->gate ); free( p ); return 0; }
+        req->async = (struct async *)grab_object( async );
+        req->iosb = async_get_iosb( async );
+        req->sock = (struct sock *)grab_object( sock );
+        req->addr_len = params->addr_len; req->send_len = send_len; req->send_cursor = 0;
+        async_set_completion_callback( async, free_connect_req, req );
+        sock->connect_req = req;
+        queue_async( &sock->connect_q, async );
+    }
+    sock->shield = p; ++shield_pending_count;
+    sock->state = SOCK_CONNECTING;
+    allow_fd_caching( sock->fd );
+    sock_reselect( sock );
+    set_error( req ? STATUS_PENDING : STATUS_DEVICE_NOT_READY );
+    return 1;
+}
