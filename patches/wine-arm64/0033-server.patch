@@ -213,6 +224,62 @@ error:
     exit(1);
 }
 
+#ifdef __APPLE__
+/* Ember (gmserver): raise the server thread's scheduling priority on macOS.
+ *
+ * Every game thread blocks on server round-trips, so the server is on the critical path of each frame.
+ * On macOS it ended up behind the game:
+ *  - open_master_socket() daemonizes with fork(). The child's main thread loses its QoS class, falls back
+ *    to the legacy band (31 - nice) and pthread_set_qos_class_self_np() is refused afterwards (EPERM).
+ *    A launcher started from a niced shell left the server at priority 26 while game threads ran at 31-47.
+ *  - macOS Game Mode favours the game's coalition; the server lives in the launcher's coalition.
+ * The legacy precedence policy needs no privileges and ignores nice, so put the thread at a fixed
+ * (non-timeshare) priority in the foreground UI band, like CrossOver's msync message thread.
+ *   EMBER_SERVER_PRIO=0      leave the thread alone
+ *   EMBER_SERVER_PRIO=<n>    target base priority (default 47, max 63)
+ *   EMBER_SERVER_TIMESHARE=1 keep timeshare decay
+ *   EMBER_SERVER_ROLE=<n>    also set PRIO_DARWIN_ROLE on the process (1 = UI focal) */
+static void ember_raise_server_priority(void)
+{
+    const char *env = getenv( "EMBER_SERVER_PRIO" );
+    int target = env && *env ? atoi( env ) : 47;
+    thread_act_t self = mach_thread_self();
+    struct thread_precedence_policy precedence;
+    struct thread_extended_policy extended;
+    struct policy_timeshare_info info;
+    mach_msg_type_number_t count = POLICY_TIMESHARE_INFO_COUNT;
+    integer_t latency = LATENCY_QOS_TIER_0, throughput = THROUGHPUT_QOS_TIER_0;
+    int base = 31;
+
+    if ((env = getenv( "EMBER_SERVER_ROLE" )) && *env)
+    {
+        int role = atoi( env );
+        if (setpriority( 6 /* PRIO_DARWIN_ROLE */, 0, role ) && debug_level)
+            fprintf( stderr, "wineserver: PRIO_DARWIN_ROLE %d: %s\n", role, strerror( errno ));
+    }
+    if (target <= 0) goto done;
+    if (target > 63) target = 63;
+
+    /* importance 0 puts the thread on the legacy path; its base priority is then the task's (31 - nice) */
+    precedence.importance = 0;
+    thread_policy_set( self, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&precedence, THREAD_PRECEDENCE_POLICY_COUNT );
