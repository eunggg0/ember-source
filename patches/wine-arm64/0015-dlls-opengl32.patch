From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 15/36] dlls-opengl32: Ember changes

Base: Wine 11.18
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/opengl32/unix_private.h b/dlls/opengl32/unix_private.h
index ba3ffb2..8beaeeb 100644
--- a/dlls/opengl32/unix_private.h
+++ b/dlls/opengl32/unix_private.h
@@ -83,6 +83,22 @@ static inline TEB *get_teb64( ULONG teb32 )
 
 extern NTSTATUS return_wow64_string( const void *str, PTR32 *wow64_str );
 
+#ifdef WINE_WOW64_BASE_RT
+/* Ember fex32 gl32off(10-23): 32비트 게스트 창(guest base)에서는 ULongToPtr 가 0x10000 이상 값에 창 기준을 OR 한다.
+ * GL 의 "포인터" 인자는 버퍼가 묶여 있으면 실제로는 그 버퍼 안 오프셋(정수)이라, 창 기준을 더하면 엉뚱한 큰 값이 된다
+ * (wined3d 동적 정점 버퍼: 오프셋 64KB 이상에서 그리기·잠금 실패). 해당 바인딩을 물어 묶여 있으면 그대로 넘긴다.
+ * 창이 없는 프로세스(64비트 전용, Rosetta 쪽 빌드)에서는 예전과 똑같다. */
+static inline void *wow64_gl_offset_ptr( TEB *teb, PTR32 ptr, GLenum binding )
+{
+    GLint bound = 0;
+    if (ptr < 0x10000 || !WINE_WOW64_BASE_RT) return ULongToPtr( ptr );
+    ((const struct opengl_funcs *)teb->glTable)->p_glGetIntegerv( binding, &bound );
+    return bound ? (void *)(ULONG_PTR)ptr : ULongToPtr( ptr );
+}
+#else
+static inline void *wow64_gl_offset_ptr( TEB *teb, PTR32 ptr, GLenum binding ) { return ULongToPtr( ptr ); }
+#endif
+
 #endif
 
 extern NTSTATUS process_attach( void *args );
