+/* Ember: 공유 텍스처 요청은 리더 속성뿐 아니라 변환(디코더·영상 처리기)의 출력 스트림 속성으로도 온다.
+ * 유니티 WindowsVideoMedia 는 SetCurrentMediaType 뒤 IMFSourceReaderEx::GetTransformForStream 으로 변환을 받아
+ * GetOutputStreamAttributes 에 MF_SA_D3D11_SHARED_WITHOUT_MUTEX 를 건다. 윈도우 리더는 변환의 표본을 그대로 넘겨서
+ * 그 텍스처가 공유 가능하지만, Wine 리더는 자기 할당기 표본으로 복사하므로 그 요청을 여기서도 따라야 한다.
+ * 안 그러면 IDXGIResource::GetSharedHandle 이 NULL 이라 발헤임 인트로·메뉴가 검은 화면이었다(DXMT, 2026-10-02). */
+static UINT32 media_stream_get_shared_mask(const struct source_reader *reader, struct media_stream *stream)
+{
+    UINT32 shared = 0, shared_without_mutex = 0, value, mask = 0;
+    struct transform_entry *entry;
+    IMFAttributes *attributes;
+
+    if (reader->attributes)
+    {
+        IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED, &shared);
+        IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &shared_without_mutex);
+    }
+    if (shared) mask |= 1;
+    if (shared_without_mutex) mask |= 2;
+
+    if (stream)
+    {
+        LIST_FOR_EACH_ENTRY(entry, &stream->transforms, struct transform_entry, entry)
+        {
+            if (!entry->transform || FAILED(IMFTransform_GetOutputStreamAttributes(entry->transform, 0, &attributes)))
+                continue;
+            if (SUCCEEDED(IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED, &value)) && value) mask |= 1;
+            if (SUCCEEDED(IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &value)) && value) mask |= 2;
+            IMFAttributes_Release(attributes);
+        }
+    }
+    return mask;
+}
+
 static HRESULT source_reader_create_sample_allocator_attributes(const struct source_reader *reader,
-        IMFAttributes **attributes)
+        struct media_stream *stream, IMFAttributes **attributes)
 {
-    UINT32 shared = 0, shared_without_mutex = 0;
+    UINT32 mask, shared, shared_without_mutex;
     HRESULT hr;
 
     if (FAILED(hr = MFCreateAttributes(attributes, 1)))
         return hr;
 
-    IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED, &shared);
-    IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &shared_without_mutex);
+    mask = media_stream_get_shared_mask(reader, stream);
+    if (stream) stream->allocator_shared = mask;
+    shared = !!(mask & 1);
+    shared_without_mutex = !!(mask & 2);
 
     if (shared_without_mutex)
         hr = IMFAttributes_SetUINT32(*attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, TRUE);
@@ -2038,7 +2077,7 @@ static HRESULT source_reader_setup_sample_allocator(struct source_reader *reader
         return hr;
     }
 
-    if (FAILED(hr = source_reader_create_sample_allocator_attributes(reader, &attributes)))
+    if (FAILED(hr = source_reader_create_sample_allocator_attributes(reader, stream, &attributes)))
         WARN("Failed to create allocator attributes, hr %#lx.\n", hr);
 
     if (FAILED(hr = IMFVideoSampleAllocatorEx_InitializeSampleAllocatorEx(stream->allocator, 2, 8,
@@ -2053,6 +2092,27 @@ static HRESULT source_reader_setup_sample_allocator(struct source_reader *reader
     return hr;
 }
 
+/* Ember: 앱이 SetCurrentMediaType 뒤에 변환 출력 속성으로 공유를 요청하면 할당기를 그 설정으로 다시 만든다. */
+static void media_stream_update_allocator_sharing(struct source_reader *reader, struct media_stream *stream)
+{
+    IMFAttributes *attributes = NULL;
+    UINT32 mask;
+
+    if (!stream->allocator || stream->allocator_shared)
+        return;
+    if (!(mask = media_stream_get_shared_mask(reader, stream)))
+        return;
+
+    TRACE("stream %u: transform asked for shared textures (%#x), reinitializing allocator.\n", stream->index, mask);
+    IMFVideoSampleAllocatorEx_UninitializeSampleAllocator(stream->allocator);
+    if (SUCCEEDED(source_reader_create_sample_allocator_attributes(reader, stream, &attributes)))
+    {
+        if (FAILED(IMFVideoSampleAllocatorEx_InitializeSampleAllocatorEx(stream->allocator, 2, 8, attributes, stream->current)))
+            WARN("Failed to reinitialize sample allocator.\n");
+        IMFAttributes_Release(attributes);
+    }
+}
