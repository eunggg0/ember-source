From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 6/34] dlls-kerberos: Ember changes

Base: wine-11.18.tar.xz
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/kerberos/unixlib.c b/dlls/kerberos/unixlib.c
index 6f58857..13f78a6 100644
--- a/dlls/kerberos/unixlib.c
+++ b/dlls/kerberos/unixlib.c
@@ -55,6 +55,36 @@
 #include "wine/debug.h"
 #include "unixlib.h"
 
+#ifdef __APPLE__
+#include <dlfcn.h>
+/* macOS 의 dlopen 은 맨 이름만 주면 DYLD_FALLBACK_LIBRARY_PATH 만 본다.
+ * 그 환경변수는 실행하는 쪽이 빠뜨리기 쉽다. 우리 .so 위치를 기준으로
+ * 절대 경로를 만들어 한 번 더 시도한다.
+ *   <root>/lib/wine/<arch>-unix/*.so  →  <root>/lib/<soname> */
+static void *dlopen_beside_wine( const char *soname )
+{
+    Dl_info info;
+    char path[1024];
+    size_t len;
+    char *p;
+    int i;
+
+    if (!dladdr( (void *)dlopen_beside_wine, &info ) || !info.dli_fname) return NULL;
+    len = strlen( info.dli_fname );
+    if (len >= sizeof(path)) return NULL;
+    memcpy( path, info.dli_fname, len + 1 );
+    for (i = 0; i < 3; i++)   /* 파일명, <arch>-unix, wine 을 차례로 벗긴다 */
+    {
+        if (!(p = strrchr( path, '/' ))) return NULL;
+        *p = 0;
+    }
+    if (strlen( path ) + strlen( soname ) + 2 >= sizeof(path)) return NULL;
+    strcat( path, "/" );
+    strcat( path, soname );
+    return dlopen( path, RTLD_NOW );
+}
+#endif
+
 WINE_DEFAULT_DEBUG_CHANNEL(kerberos);
 WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
@@ -89,7 +119,13 @@ MAKE_FUNCPTR( krb5_unparse_name_flags );
 
 static BOOL load_krb5(void)
 {
+#ifdef __APPLE__
     if (!(libkrb5_handle = dlopen( SONAME_LIBKRB5, RTLD_NOW )))
+        libkrb5_handle = dlopen_beside_wine( SONAME_LIBKRB5 );
+    if (!libkrb5_handle)
+#else
+    if (!(libkrb5_handle = dlopen( SONAME_LIBKRB5, RTLD_NOW )))
+#endif
     {
         WARN_(winediag)( "failed to load %s, Kerberos support will be disabled\n", SONAME_LIBKRB5 );
         return FALSE;
@@ -419,7 +455,13 @@ MAKE_FUNCPTR( gss_wrap_iov );
 
 static BOOL load_gssapi_krb5(void)
 {
+#ifdef __APPLE__
     if (!(libgssapi_krb5_handle = dlopen( SONAME_LIBGSSAPI_KRB5, RTLD_NOW )))
+        libgssapi_krb5_handle = dlopen_beside_wine( SONAME_LIBGSSAPI_KRB5 );
+    if (!libgssapi_krb5_handle)
+#else
+    if (!(libgssapi_krb5_handle = dlopen( SONAME_LIBGSSAPI_KRB5, RTLD_NOW )))
+#endif
     {
         WARN_(winediag)( "failed to load %s, Kerberos support will be disabled\n", SONAME_LIBGSSAPI_KRB5 );
         return FALSE;
