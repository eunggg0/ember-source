             return TRUE;
         }
 
+    /* fex32: 포인터 인자 → 게스트 창 (구조 배치가 32/64 같은 것들) */
+    case NtUserCallTwoParam_GetMonitorInfo:
+    case NtUserCallTwoParam_SetIMECompositionRect:
