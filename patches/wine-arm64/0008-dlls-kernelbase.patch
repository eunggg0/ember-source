+    if (i != nt_name.Length / sizeof(WCHAR) - 1 && is_mounted_folder( &nt_name ))
+    {
+        /* Ember: mounted folder (unix mount point such as Z:\Volumes\Disk\) — query the volume
+         * mounted there, as Windows does for volumes mounted in a folder. */
