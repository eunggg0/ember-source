+/* Ember: 예외가 난 모듈 이름(" in d3d11.dll"). 튕김 원인 줄에 붙인다. */
+static void ember_crash_module( const EXCEPTION_POINTERS *ptr, char *out, int size )
+{
+    void *base = NULL;
+    char path[MAX_PATH], *name;
+
+    out[0] = 0;
+    if (!RtlPcToFileHeader( ptr->ExceptionRecord->ExceptionAddress, &base ) || !base) return;
+    if (!GetModuleFileNameA( base, path, sizeof(path) )) return;
+    name = strrchr( path, '\\' );
+    snprintf( out, size, " in %s", name ? name + 1 : path );
+}
+
+/* Ember: 디버거(AeDebug: winedbg 미니덤프)를 띄우지 않을 실행 파일인가. EMBER_NODEBUG_EXE="a.exe;b.exe"(이름만, 대소문자 무시).
+ * 런처가 스스로 다시 띄우는 도우미(스팀 steamwebhelper.exe)가 대상이다. 덤프를 쓰는 동안(로제타 2.8초·FEX 3.8초) 죽은 프로세스가
+ * 남아 스팀 창이 멈춰 있다가 그만큼 늦게 다시 떴고, FEX 에서는 게임 실행 단계(ShowInterstitials)가 스팀 창을 기다리며 같이 늦었다
+ * (2026-10-02 startup 측정). 덤프는 쓰이지 않는 알려진 튕김이라 바로 끝내는 쪽이 낫다. */
+static BOOL ember_nodebug_exe(void)
+{
+    WCHAR list[512], *p, *tok, *next;
+    const UNICODE_STRING *img = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    const WCHAR *name;
+    DWORD n, i, len;
+
+    n = GetEnvironmentVariableW( L"EMBER_NODEBUG_EXE", list, ARRAY_SIZE(list) );
+    if (!n || n >= ARRAY_SIZE(list) || !img->Buffer) return FALSE;
+    len = img->Length / sizeof(WCHAR);
+    for (i = len; i > 0; i--) if (img->Buffer[i - 1] == '\\' || img->Buffer[i - 1] == '/') break;
+    name = img->Buffer + i;
+    len -= i;
+    for (p = list; p && *p; p = next)
+    {
+        tok = p;
+        next = wcschr( p, ';' );
+        if (next) *next++ = 0;
+        if (wcslen( tok ) == len && !wcsnicmp( tok, name, len )) return TRUE;
+    }
+    return FALSE;
+}
+
