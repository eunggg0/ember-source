+/* Ember: is this NT path (with trailing backslash) a mounted folder? ntdll reports a unix mount point
+ * (e.g. Z:\Volumes\ExternalDisk) as a directory reparse point with IO_REPARSE_TAG_MOUNT_POINT, and
+ * GetVolumePathNameW returns it as the volume path, so the volume APIs must accept it like Windows does. */
+static BOOL is_mounted_folder( UNICODE_STRING *nt_name )
+{
+    FILE_ATTRIBUTE_TAG_INFORMATION tag;
+    FILE_BASIC_INFORMATION basic;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    HANDLE file;
+    NTSTATUS status;
+    BOOL ret = FALSE;
+
+    if (nt_name->Length < 2 * sizeof(WCHAR) || nt_name->Buffer[nt_name->Length / sizeof(WCHAR) - 1] != '\\')
+        return FALSE;
+    nt_name->Length -= sizeof(WCHAR);
+    InitializeObjectAttributes( &attr, nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!NtQueryAttributesFile( &attr, &basic )
+            && (basic.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)
+            && (basic.FileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            && !NtOpenFile( &file, SYNCHRONIZE | FILE_READ_ATTRIBUTES, &attr, &io,
+                            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                            FILE_OPEN_REPARSE_POINT | FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT ))
+    {
+        status = NtQueryInformationFile( file, &io, &tag, sizeof(tag), FileAttributeTagInformation );
+        NtClose( file );
+        ret = !status && tag.ReparseTag == IO_REPARSE_TAG_MOUNT_POINT;
+    }
+    nt_name->Length += sizeof(WCHAR);
+    return ret;
+}
+
