-    MESSAGE( "wine: %s (thread %04lx), starting debugger...\n", buffer, GetCurrentThreadId() );
+    {
+        char mod[MAX_PATH + 8];
+        ember_crash_module( epointers, mod, sizeof(mod) );
+        MESSAGE( "wine: %s%s (thread %04lx), starting debugger...\n", buffer, mod, GetCurrentThreadId() );
+    }
 
     InitializeObjectAttributes( &attr, &nameW, 0, 0, NULL );
     if (!NtOpenKey( &dbg_key, KEY_READ, &attr ))
@@ -706,9 +750,34 @@ LONG WINAPI UnhandledExceptionFilter( EXCEPTION_POINTERS *epointers )
         if (top_filter && !nested)
         {
             LONG ret = top_filter( epointers );
+            if (ret == EXCEPTION_EXECUTE_HANDLER)
+            {
+                /* Ember: 게임 자체 크래시 처리기가 받아 끝내는 경우도 표시 */
+                char buffer[256], mod[MAX_PATH + 8];
+                format_exception_msg( epointers, buffer, sizeof(buffer) );
+                ember_crash_module( epointers, mod, sizeof(mod) );
+                MESSAGE( "wine: %s%s (thread %04lx), handled by application crash filter\n", buffer, mod, GetCurrentThreadId() );
+            }
             if (ret != EXCEPTION_CONTINUE_SEARCH) return ret;
         }
 
+        if (GetErrorMode() & SEM_NOGPFAULTERRORBOX)
+        {
+            /* Ember: 디버거 없이 끝나는 튕김도 한 줄 남긴다(안 남기면 조용한 종료로 보인다) */
+            char buffer[256], mod[MAX_PATH + 8];
+            format_exception_msg( epointers, buffer, sizeof(buffer) );
+            ember_crash_module( epointers, mod, sizeof(mod) );
+            MESSAGE( "wine: %s%s (thread %04lx), no debugger (SEM_NOGPFAULTERRORBOX)\n", buffer, mod, GetCurrentThreadId() );
+        }
+        if (!(GetErrorMode() & SEM_NOGPFAULTERRORBOX) && ember_nodebug_exe())
+        {
+            /* Ember: 다시 띄워질 도우미는 덤프 없이 바로 끝낸다(ember_nodebug_exe). 튕김 줄은 그대로 남긴다. */
+            char buffer[256], mod[MAX_PATH + 8];
+            format_exception_msg( epointers, buffer, sizeof(buffer) );
+            ember_crash_module( epointers, mod, sizeof(mod) );
+            MESSAGE( "wine: %s%s (thread %04lx), no debugger (EMBER_NODEBUG_EXE)\n", buffer, mod, GetCurrentThreadId() );
+            return nested ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER;
+        }
         if ((GetErrorMode() & SEM_NOGPFAULTERRORBOX) ||
             !start_debugger_atomic( epointers ) || !NtCurrentTeb()->Peb->BeingDebugged)
             return nested ? EXCEPTION_CONTINUE_SEARCH : EXCEPTION_EXECUTE_HANDLER;
