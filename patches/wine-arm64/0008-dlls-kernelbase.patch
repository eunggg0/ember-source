+/* Ember: 스팀 CEF 브라우저 프로세스(steamwebhelper.exe, --type 없는 것)에 EMBER_CEF_ARGS 를 덧붙인다.
+ * 스팀은 -cef-in-process-gpu 를 전달하지 않는다. viz 합성기가 별도 gpu 프로세스에서 돌면 브라우저
+ * 프로세스 소유의 창에 다른 프로세스가 GDI 로 그리게 되는데, Wine 의 창 표면은 프로세스마다 따로라
+ * 화면이 검게 남는다. --in-process-gpu 로 합성기를 창 주인 프로세스 안에 두면 그려진다. */
+/* EMBER_CEF_EXE: 대상 실행파일 이름 목록(';' 로 나눔, 대소문자 무시). 없으면 steamwebhelper.exe.
+ * 배틀넷처럼 브라우저 프로세스가 런처 자신(Battle.net.exe)인 CEF 앱에도 같은 인자를 주려고 쓴다. */
+static BOOL ember_cef_target( const WCHAR *base )
+{
+    WCHAR list[256], *p, *next;
+    DWORD n = GetEnvironmentVariableW( L"EMBER_CEF_EXE", list, ARRAY_SIZE(list) );
+
+    if (!n || n >= ARRAY_SIZE(list)) return !wcsicmp( base, L"steamwebhelper.exe" );
+    for (p = list; p && *p; p = next)
+    {
+        if ((next = wcschr( p, ';' ))) *next++ = 0;
+        if (*p && !wcsicmp( base, p )) return TRUE;
+    }
+    return FALSE;
+}
+
+static WCHAR *ember_append_cef_args( const WCHAR *app_name, WCHAR *cmdline, const WCHAR *orig )
+{
+    WCHAR extra[512], *out;
+    const WCHAR *base;
+    DWORD len, extra_len, cmd_len;
+
+    if (!app_name || !cmdline) return cmdline;
+    for (base = app_name; *app_name; app_name++) if (*app_name == '\\' || *app_name == '/') base = app_name + 1;
+    if (!ember_cef_target( base )) return cmdline;
+    if (wcsstr( cmdline, L"--type=" )) return cmdline;
+    if (!(extra_len = GetEnvironmentVariableW( L"EMBER_CEF_ARGS", extra, ARRAY_SIZE(extra) )) ||
+        extra_len >= ARRAY_SIZE(extra)) return cmdline;
+    cmd_len = lstrlenW( cmdline );
+    len = cmd_len + 1 + extra_len + 1;
+    if (!(out = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return cmdline;
+    memcpy( out, cmdline, cmd_len * sizeof(WCHAR) );
+    out[cmd_len] = ' ';
+    memcpy( out + cmd_len + 1, extra, (extra_len + 1) * sizeof(WCHAR) );
+    if (cmdline != orig) RtlFreeHeap( GetProcessHeap(), 0, cmdline );
+    TRACE( "ember cef args: %s\n", debugstr_w(out) );
+    return out;
+}
+
