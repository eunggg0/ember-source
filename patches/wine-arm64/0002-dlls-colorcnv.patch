From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 2/34] dlls-colorcnv: Ember changes

Base: wine-11.18.tar.xz
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/colorcnv/color_converter.c b/dlls/colorcnv/color_converter.c
index 38981e4..905567f 100644
--- a/dlls/colorcnv/color_converter.c
+++ b/dlls/colorcnv/color_converter.c
@@ -35,6 +35,7 @@
 #include "wmcodecdsp.h"
 
 #include <libavutil/avutil.h>
+#include <libavutil/cpu.h>
 #include <libavutil/imgutils.h>
 #include <libavutil/opt.h>
 #include <libswscale/swscale.h>
@@ -591,6 +592,13 @@ static HRESULT color_convert_init(struct color_convert *impl)
         goto failed;
     video_frame_init_aperture(&impl->output_frame, &impl->output_format);
 
+#ifdef __arm64ec__
+    /* Ember(10-03 compat2): ARM64EC 용 swscale NEON 이 NV12→RGB32 에서 세로 줄무늬를 만든다(msvproc 와 같은 수정). EMBER_SWS_CPU=1 이면 NEON. */
+    {
+        char buf[8];
+        if (!GetEnvironmentVariableA("EMBER_SWS_CPU", buf, sizeof(buf)) || buf[0] != '1') av_force_cpu_flags(0);
+    }
+#endif
     av_opt_set(impl->context, "sws_flags", "neighbor", 0);
     av_opt_set_int(impl->context, "threads", 0, 0);
     av_opt_set_int(impl->context, "srcw", impl->input_frame.width, 0);
