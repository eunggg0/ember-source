From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 36/36] top: Ember changes

Base: Wine 11.18
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/configure b/configure
index ef273cd..0201228 100755
--- a/configure
+++ b/configure
@@ -12345,7 +12345,7 @@ case $host_os in
     SYSTEMCONFIGURATION_LIBS="-framework SystemConfiguration"
 
 
-    WINELOADER_LDFLAGS="-Wl,-segalign,0x1000,-pagezero_size,0x1000,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+    WINELOADER_LDFLAGS="-Wl,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
 
     case $HOST_ARCH in
       i386) wine_use_preloader=yes ;;
diff --git a/configure.ac b/configure.ac
index b415d1c..c15981b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -981,7 +981,7 @@ case $host_os in
     AC_SUBST(SECURITY_LIBS,"-framework Security -framework CoreFoundation")
     AC_SUBST(SYSTEMCONFIGURATION_LIBS,"-framework SystemConfiguration")
 
-    WINELOADER_LDFLAGS="-Wl,-segalign,0x1000,-pagezero_size,0x1000,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+    WINELOADER_LDFLAGS="-Wl,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
 
     case $HOST_ARCH in
       i386) wine_use_preloader=yes ;;
