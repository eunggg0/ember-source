From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 4/34] dlls-dwrite: Ember changes

Base: wine-11.18.tar.xz
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
index 13d9a07..e9aec61 100644
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -43,6 +43,38 @@
 
 #include "dwrite_private.h"
 
+#ifdef __APPLE__
+#include <dlfcn.h>
+/* macOS 의 dlopen 은 맨 이름만 주면 DYLD_FALLBACK_LIBRARY_PATH 만 본다.
+ * 그 환경변수는 실행하는 쪽이 빠뜨리기 쉽고, 빠지면 폰트와 TLS 가 통째로 죽는다
+ * (실측: 폰트가 없으면 캡션 높이가 32769 로 계산돼 레지스트리에 박히고,
+ *  schannel 이 없으면 게임 런처가 "네트워크 점검" 에서 멈춘다).
+ * 그래서 우리 .so 위치를 기준으로 절대 경로를 만들어 한 번 더 시도한다.
+ *   <root>/lib/wine/<arch>-unix/*.so  →  <root>/lib/<soname> */
+static void *dlopen_beside_wine( const char *soname )
+{
+    Dl_info info;
+    char path[1024];
+    size_t len;
+    char *p;
+    int i;
+
+    if (!dladdr( (void *)dlopen_beside_wine, &info ) || !info.dli_fname) return NULL;
+    len = strlen( info.dli_fname );
+    if (len >= sizeof(path)) return NULL;
+    memcpy( path, info.dli_fname, len + 1 );
+    for (i = 0; i < 3; i++)   /* 파일명, <arch>-unix, wine 을 차례로 벗긴다 */
+    {
+        if (!(p = strrchr( path, '/' ))) return NULL;
+        *p = 0;
+    }
+    if (strlen( path ) + strlen( soname ) + 2 >= sizeof(path)) return NULL;
+    strcat( path, "/" );
+    strcat( path, soname );
+    return dlopen( path, RTLD_NOW );
+}
+#endif
+
 #ifdef SONAME_LIBFREETYPE
 
 WINE_DEFAULT_DEBUG_CHANNEL(dwrite);
@@ -116,6 +148,9 @@ static NTSTATUS process_attach(void *args)
     FT_Version_t FT_Version;
 
     ft_handle = dlopen(SONAME_LIBFREETYPE, RTLD_NOW);
+#ifdef __APPLE__
+    if (!ft_handle) ft_handle = dlopen_beside_wine( SONAME_LIBFREETYPE );
+#endif
     if (!ft_handle)
     {
         WINE_MESSAGE("Wine cannot find the FreeType font library.\n");
diff --git a/dlls/dwrite/opentype.c b/dlls/dwrite/opentype.c
index f4faaa5..eb13dce 100644
--- a/dlls/dwrite/opentype.c
+++ b/dlls/dwrite/opentype.c
@@ -3149,20 +3149,22 @@ static unsigned int opentype_get_sbix_formats(IDWriteFontFace5 *fontface)
                 if (!glyph_data)
                     continue;
 
-                switch (glyph_data->graphic_type)
+                /* Ember: 크기(strike)마다 실제 이미지가 있는 첫 글자의 형식만 본다. 원본은 모든 크기 × 모든 글자를 읽어,
+                 * 애플 컬러 이모지(크기 여러 개 × 글자 수천, 파일 수백 MB)를 열 때 수만 번 읽고 'flip' 경고를 9720줄 찍었다.
+                 * 로아 FEX 로딩 중 이 스레드가 dwrite 잠금을 몇 분 쥐어 다른 스레드가 60초 대기를 반복했다(실측 2026-09-24).
+                 * 'flip'(다른 글자를 뒤집어 쓰라는 참조)·'dupe'(다른 글자 재사용)는 형식이 아니므로 건너뛴다. */
+                if (glyph_data->graphic_type == MS_PNG__TAG) ret |= DWRITE_GLYPH_IMAGE_FORMATS_PNG;
+                else if (glyph_data->graphic_type == MS_JPG__TAG) ret |= DWRITE_GLYPH_IMAGE_FORMATS_JPEG;
+                else if (glyph_data->graphic_type == MS_TIFF_TAG) ret |= DWRITE_GLYPH_IMAGE_FORMATS_TIFF;
+                else
                 {
-                    case MS_PNG__TAG:
-                        ret |= DWRITE_GLYPH_IMAGE_FORMATS_PNG;
-                        break;
-                    case MS_JPG__TAG:
-                        ret |= DWRITE_GLYPH_IMAGE_FORMATS_JPEG;
-                        break;
-                    case MS_TIFF_TAG:
-                        ret |= DWRITE_GLYPH_IMAGE_FORMATS_TIFF;
-                        break;
-                    default:
-                        FIXME("unexpected bitmap format %s\n", debugstr_fourcc(GET_BE_DWORD(glyph_data->graphic_type)));
+                    static int once;
+                    unsigned int type = glyph_data->graphic_type;   /* 파일 바이트 그대로(원본 비교와 같게) */
+                    if (type != DWRITE_MAKE_OPENTYPE_TAG('f','l','i','p') && type != DWRITE_MAKE_OPENTYPE_TAG('d','u','p','e') && !once++)
+                        FIXME("unexpected bitmap format %s\n", debugstr_fourcc(GET_BE_DWORD(type)));
+                    continue;
                 }
+                break;
             }
         }
     }
