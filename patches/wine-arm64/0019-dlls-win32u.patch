diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 6ed5b77..260c5dd 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -4177,6 +4177,22 @@ static BOOL source_get_full_mode( const struct source *source, const DEVMODEW *d
         full_mode->dmPosition = position;
     }
 
+    /* Ember: 가상 해상도(EmulateModeset)를 앱별로(AppDefaults) 켜면 가상 모드 목록은 이 프로세스가 아니라 화면 장치를
+     * 갱신하는 데스크톱 프로세스가 만든다 — 그쪽은 앱 설정을 안 보니 목록엔 맥의 실제 모드(32비트뿐)만 있어 640×480×8 같은
+     * 고전 게임 모드가 BADMODE 로 거절됐다(ddprobe 실측). 가상 모드는 실제 화면에 늘려 보이므로 물리 해상도 이하면 받아 준다. */
+    if (!source_mode && emulate_modeset && !is_detached_mode( full_mode ) &&
+        full_mode->dmPelsWidth <= max( source->physical.dmPelsWidth, source->current.dmPelsWidth ) &&
+        full_mode->dmPelsHeight <= max( source->physical.dmPelsHeight, source->current.dmPelsHeight ))
+    {
+        if (!(full_mode->dmFields & DM_BITSPERPEL) || !full_mode->dmBitsPerPel)
+            full_mode->dmBitsPerPel = source->current.dmBitsPerPel;
+        if (!(full_mode->dmFields & DM_DISPLAYFREQUENCY) || full_mode->dmDisplayFrequency <= 1)
+            full_mode->dmDisplayFrequency = 60;
+        full_mode->dmFields |= DM_BITSPERPEL | DM_DISPLAYFREQUENCY | DM_DISPLAYORIENTATION | DM_DISPLAYFLAGS;
+        full_mode->dmDisplayOrientation = source->current.dmDisplayOrientation;
+        return TRUE;
+    }
+
     return source_mode != NULL;
 }
 
@@ -5488,7 +5504,13 @@ static void get_text_metr_size( HDC hdc, LOGFONTW *lf, TEXTMETRICW *metric, UINT
         if (hfont) NtGdiDeleteObjectApp( hfont );
         return;
     }
+    /* Ember: get_char_dimensions leaves metric untouched when GetTextMetrics fails (fonts not ready yet during the
+     * first wineboot). The stack garbage (32767) then became CaptionHeight/MenuHeight and was saved to the
+     * registry for good: every CW_USEDEFAULT window was 32863x32808. */
+    metric->tmHeight = -1;
+    metric->tmExternalLeading = 0;
     ret = get_char_dimensions( hdc, metric, NULL );
+    if (metric->tmHeight > 0x1000) metric->tmHeight = -1;
     if (psz) *psz = ret ? ret : 10;
     NtGdiSelectFont( hdc, hfontsav );
     NtGdiDeleteObjectApp( hfont );
