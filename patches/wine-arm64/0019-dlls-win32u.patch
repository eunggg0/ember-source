From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 19/36] dlls-win32u: Ember changes

Base: Wine 11.18
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index 832043a..e63a117 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -71,6 +71,37 @@
 #include "wine/list.h"
 
 #ifdef SONAME_LIBFREETYPE
+#ifdef __APPLE__
+#include <dlfcn.h>
+/* macOS 의 dlopen 은 맨 이름만 주면 DYLD_FALLBACK_LIBRARY_PATH 만 본다.
+ * 그 환경변수는 실행하는 쪽이 빠뜨리기 쉽고, 빠지면 폰트와 TLS 가 통째로 죽는다
+ * (실측: 폰트가 없으면 캡션 높이가 32769 로 계산돼 레지스트리에 박히고,
+ *  schannel 이 없으면 게임 런처가 "네트워크 점검" 에서 멈춘다).
+ * 그래서 우리 .so 위치를 기준으로 절대 경로를 만들어 한 번 더 시도한다.
+ *   <root>/lib/wine/<arch>-unix/*.so  →  <root>/lib/<soname> */
+static void *dlopen_beside_wine( const char *soname )
+{
+    Dl_info info;
+    char path[1024];
+    size_t len;
+    char *p;
+    int i;
+
+    if (!dladdr( (void *)dlopen_beside_wine, &info ) || !info.dli_fname) return NULL;
+    len = strlen( info.dli_fname );
+    if (len >= sizeof(path)) return NULL;
+    memcpy( path, info.dli_fname, len + 1 );
+    for (i = 0; i < 3; i++)   /* 파일명, <arch>-unix, wine 을 차례로 벗긴다 */
+    {
+        if (!(p = strrchr( path, '/' ))) return NULL;
+        *p = 0;
+    }
+    if (strlen( path ) + strlen( soname ) + 2 >= sizeof(path)) return NULL;
+    strcat( path, "/" );
+    strcat( path, soname );
+    return dlopen( path, RTLD_NOW );
+}
+#endif
 
 WINE_DEFAULT_DEBUG_CHANNEL(font);
 
@@ -1236,6 +1267,9 @@ static void fontconfig_add_font( FcPattern *pattern, UINT flags )
 static void init_fontconfig(void)
 {
     void *fc_handle = dlopen(SONAME_LIBFONTCONFIG, RTLD_NOW);
+#ifdef __APPLE__
+    if (!fc_handle) fc_handle = dlopen_beside_wine( SONAME_LIBFONTCONFIG );
+#endif
 
     if (!fc_handle)
     {
@@ -1455,6 +1489,9 @@ static void load_mac_fonts(void)
 static BOOL init_freetype(void)
 {
     ft_handle = dlopen(SONAME_LIBFREETYPE, RTLD_NOW);
+#ifdef __APPLE__
+    if (!ft_handle) ft_handle = dlopen_beside_wine( SONAME_LIBFREETYPE );
+#endif
     if(!ft_handle) {
         WINE_MESSAGE(
       "Wine cannot find the FreeType font library.  To enable Wine to\n"
