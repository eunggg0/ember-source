diff --git a/dlls/winegstreamer/quartz_parser.c b/dlls/winegstreamer/quartz_parser.c
index 5cddd7b..8e973db 100644
--- a/dlls/winegstreamer/quartz_parser.c
+++ b/dlls/winegstreamer/quartz_parser.c
@@ -1011,6 +1011,7 @@ static bool amt_to_wg_format_video(const AM_MEDIA_TYPE *mt, struct wg_format *fo
     format_map[] =
     {
         {&MEDIASUBTYPE_ARGB32,  WG_VIDEO_FORMAT_BGRA},
+        {&MEDIASUBTYPE_ABGR32,  WG_VIDEO_FORMAT_RGBA},   /* Ember(parity-avi): amt_from_wg_format 의 역. 8비트 팔레트 AVI(MS RLE·RGB8)가 RGBA 로 풀려 이 형식으로 연결되면 Run 에서 assert(abort) */
         {&MEDIASUBTYPE_RGB32,   WG_VIDEO_FORMAT_BGRx},
         {&MEDIASUBTYPE_RGB24,   WG_VIDEO_FORMAT_BGR},
         {&MEDIASUBTYPE_RGB555,  WG_VIDEO_FORMAT_RGB15},
@@ -2530,6 +2531,14 @@ static BOOL avi_splitter_filter_init_gst(struct parser *filter)
     return TRUE;
 }
 
+/* Ember: avidemux 뒤 decodebin 이 직접 푼 스트림(MJPEG 등, Wine 이 압축 형식으로 모르는 코덱)은 YUV 로 나온다.
+ * 이 핀은 그 형식 하나만 내놓는데 MJPEG 의 4:2:2(Y42B) 는 DirectShow 형식이 없어 영상이 통째로 빠졌다(소리만 재생).
+ * decodebin 파서처럼 YUV·RGB 여러 형식을 내놓는다 — 변환은 파서 뒤 videoconvert 가 한다. */
+static BOOL avi_splitter_decoded_video(const struct wg_format *format)
+{
+    return format->major_type == WG_MAJOR_TYPE_VIDEO && !wg_video_format_is_rgb(format->u.video.format);
+}
+
 static HRESULT avi_splitter_source_query_accept(struct parser_source *pin, const AM_MEDIA_TYPE *mt)
 {
     struct wg_format format;
@@ -2537,6 +2546,8 @@ static HRESULT avi_splitter_source_query_accept(struct parser_source *pin, const
     HRESULT hr;
 
     wg_parser_stream_get_current_format(pin->wg_stream, &format);
+    if (avi_splitter_decoded_video(&format))
+        return decodebin_parser_source_query_accept(pin, mt);
     if (wg_video_format_is_rgb(format.u.video.format))
         format.u.video.height = -format.u.video.height;
     if (!amt_from_wg_format(&pad_mt, &format, false))
@@ -2564,10 +2575,13 @@ static HRESULT avi_splitter_source_get_media_type(struct parser_source *pin,
 {
     struct wg_format format;
 
+    wg_parser_stream_get_current_format(pin->wg_stream, &format);
+    if (avi_splitter_decoded_video(&format))
+        return decodebin_parser_source_get_media_type(pin, index, mt);
+
     if (index > 1)
         return VFW_S_NO_MORE_ITEMS;
 
-    wg_parser_stream_get_current_format(pin->wg_stream, &format);
     if (format.major_type == WG_MAJOR_TYPE_VIDEO
         && format.u.video.format == WG_VIDEO_FORMAT_BGRx)
     {
