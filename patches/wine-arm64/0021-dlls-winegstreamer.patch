+    EMBER_FCC_GUID('M','P','4','S'), EMBER_FCC_GUID('3','I','V','2'), EMBER_FCC_GUID('D','I','V','5'),
+    EMBER_FCC_GUID('I','V','3','1'), EMBER_FCC_GUID('I','V','3','2'), EMBER_FCC_GUID('I','V','4','1'),
+    EMBER_FCC_GUID('I','2','6','3'), EMBER_FCC_GUID('C','V','I','D'),
