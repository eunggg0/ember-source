diff --git a/dlls/winegstreamer/unixlib.c b/dlls/winegstreamer/unixlib.c
index ac671bb..3b37709 100644
--- a/dlls/winegstreamer/unixlib.c
+++ b/dlls/winegstreamer/unixlib.c
@@ -127,6 +127,26 @@ done:
     return factories;
 }
 
+/* Ember: 애플 하드웨어 디코더가 못 푸는 옛 형식. 건너뛰면 libav(avdec_*)가 받는다.
+ * - vtdec: AVI MJPEG(허프만 표 없는 프레임)을 -12910 으로 거부 → 파일 전체가 안 열렸다.
+ * - atdec: MPEG-1 오디오(MP2)를 몇 프레임 쥐고 내놓지 않아 DirectShow 버퍼가 바닥나 멈췄다(2026-09-26 실측). */
+bool ember_skip_factory(const char *name, GstCaps *caps)
+{
+    const GstStructure *st;
+    const char *mime;
+    gint version;
+
+    if (!name || !caps || gst_caps_is_empty(caps) || gst_caps_is_any(caps)) return false;
+    st = gst_caps_get_structure(caps, 0);
+    mime = gst_structure_get_name(st);
+    if (!strncmp(name, "vtdec", 5) && !strcmp(mime, "image/jpeg"))
+        return true;
+    if (!strcmp(name, "atdec") && !strcmp(mime, "audio/mpeg")
+            && gst_structure_get_int(st, "mpegversion", &version) && version == 1)
+        return true;
+    return false;
+}
+
 GstElement *find_element(GstElementFactoryListType type, GstCaps *element_sink_caps, GstCaps *element_src_caps)
 {
     GstElement *element = NULL;
@@ -148,6 +168,11 @@ GstElement *find_element(GstElementFactoryListType type, GstCaps *element_sink_c
             GST_WARNING("Ignoring vaapidecodebin decoder.");
             continue;
         }
+        if (ember_skip_factory(name, element_sink_caps))
+        {
+            GST_WARNING("Ember: skipping %s for %" GST_PTR_FORMAT ".", name, element_sink_caps);
+            continue;
+        }
 
         element = factory_create_element(GST_ELEMENT_FACTORY(tmp->data));
     }
