From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 17/36] dlls-sechost: Ember changes

Base: Wine 11.18
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/sechost/Makefile.in b/dlls/sechost/Makefile.in
index ec1eb10..4eeddd2 100644
--- a/dlls/sechost/Makefile.in
+++ b/dlls/sechost/Makefile.in
@@ -1,7 +1,11 @@
 MODULE    = sechost.dll
 IMPORTLIB = sechost
-IMPORTS   = kernelbase
-DELAYIMPORTS = rpcrt4
+IMPORTS   = kernelbase rpcrt4
+# rpcrt4 를 지연 임포트로 두면 ARM64EC 에서 깨진다.
+# 지연 임포트의 첫 호출은 링커가 만든 x64 헬퍼를 거치는데, 가변인자 함수를
+# EC→x64→EC 로 왕복시키면 인자가 망가진다(나가는 썽크가 실제 인자 대신
+# x4·x5 를 스택에 올린다). NdrClientCall2 가 정확히 그 경우라
+# OpenSCManagerW 가 널 포인터로 죽었다. 보통 임포트로 두면 문제없다.
 
 SOURCES = \
 	plugplay.idl \
