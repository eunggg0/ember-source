+{
+    uint32_t n;
+    char *str;
+    if (!ember_ls_read( s, &n, 4 ) || n > (1u << 20) || !(str = malloc( n + 1 ))) return NULL;
+    if (!ember_ls_read( s, str, n )) { free( str ); return NULL; }
+    str[n] = 0;
+    return str;
