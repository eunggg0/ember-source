+/***********************************************************************
+ *           ember_exc_stats
+ *
+ * Ember 진단: 사용자 모드로 넘기는 예외를 (코드, 읽기/쓰기, 폴트 페이지)별로 세어 5초마다 stderr 에 찍는다.
+ * EMBER_EXC_STATS=1 일 때만. FEX 에서 예외 한 번은 시그널 + 문맥 변환 + SEH + NtContinue(SIGUSR2)라 매우 비싸다.
+ * 실측(2026-09-24): STOVE CEF 렌더러가 게임 중에도 코어 하나를 예외 왕복에 썼다 — 정체를 찾기 위한 것.
+ * 시그널 핸들러 안이라 잠금 없이 CAS 로만 센다.
+ */
+struct ember_exc_slot { ULONG64 key; LONG count; ULONG_PTR last_pc; };
+static struct ember_exc_slot ember_exc_table[64];
+static LONG ember_exc_total;
+
+static void ember_exc_stats( const EXCEPTION_RECORD *rec )
+{
+    static int enabled = -1;
+    static ULONG64 last_ns;
+    struct timespec ts;
+    ULONG64 key, now;
+    unsigned int i, h;
+
+    if (enabled < 0) { const char *e = getenv( "EMBER_EXC_STATS" ); enabled = e && *e == '1'; }
+    if (!enabled) return;
+
+    key = (ULONG64)rec->ExceptionCode << 32;
+    if (rec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && rec->NumberParameters >= 2)
+        key |= ((rec->ExceptionInformation[0] & 0xf) << 28) | ((rec->ExceptionInformation[1] >> 14) & 0x0fffffff);
+    else  /* 그 밖의 예외는 일어난 코드 위치(16K 페이지)로 묶는다. rw=f 로 표시 */
+        key |= (0xfull << 28) | (((ULONG_PTR)rec->ExceptionAddress >> 14) & 0x0fffffff);
+    InterlockedIncrement( &ember_exc_total );
+    h = (unsigned int)((key * 0x9e3779b97f4a7c15ull) >> 58);
+    for (i = 0; i < ARRAY_SIZE(ember_exc_table); i++)
+    {
+        struct ember_exc_slot *slot = &ember_exc_table[(h + i) % ARRAY_SIZE(ember_exc_table)];
+        ULONG64 cur = __atomic_load_n( &slot->key, __ATOMIC_RELAXED );
+        if (cur == key || (!cur && __atomic_compare_exchange_n( &slot->key, &cur, key, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) || cur == key)
+        {
+            InterlockedIncrement( &slot->count );
+            slot->last_pc = (ULONG_PTR)rec->ExceptionAddress;
+            break;
+        }
+    }
+
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    now = ts.tv_sec * 1000000000ull + ts.tv_nsec;
+    if (!last_ns) { last_ns = now; return; }
+    if (now - last_ns < 5000000000ull) return;
+    last_ns = now;
+    {
+        char buf[2048];
+        int len = snprintf( buf, sizeof(buf), "ember-exc-stats (5s, pid %d): total=%d;", getpid(),
+                            (int)InterlockedExchange( &ember_exc_total, 0 ) );
+        for (i = 0; i < ARRAY_SIZE(ember_exc_table) && len < (int)sizeof(buf) - 64; i++)
+        {
+            LONG n = InterlockedExchange( &ember_exc_table[i].count, 0 );
+            ULONG64 k = ember_exc_table[i].key;
+            if (n < 20) continue;
+            len += snprintf( buf + len, sizeof(buf) - len, " code=%08x rw=%x page=%#llx n=%d pc=%p;", (unsigned int)(k >> 32),
+                             (unsigned int)((k >> 28) & 0xf), (unsigned long long)((k & 0x0fffffff) << 14), (int)n,
+                             (void *)ember_exc_table[i].last_pc );
+        }
+        buf[len++] = '\n';
+        write( 2, buf, len );
+    }
+}
