+ * 하면 호스트·LS 도우미 exec 가 이렇게 실패해 조용히 일반 로더로 떴다(LS·호스트 정체 없음, 2026-10-02 gmfd 실측). 작업 스레드는 됐다. */
+#ifdef __APPLE__
+static void ember_execv_static( const char *path, char **argv )
+{
+    static char strbuf[262144];
+    static char *sargv[1024];
+    static char *senvp[4096];
+    char **e = *_NSGetEnviron(), *spath;
+    size_t pos = 0, len;
+    int i, n = 0, en = 0;
+
+    len = strlen( path ) + 1;
+    if (len > sizeof(strbuf)) goto plain;
+    spath = memcpy( strbuf, path, len );
+    pos = len;
+    for (i = 0; argv[i]; i++)
+    {
+        len = strlen( argv[i] ) + 1;
+        if (n >= (int)ARRAY_SIZE(sargv) - 1 || pos + len > sizeof(strbuf)) goto plain;
+        sargv[n++] = memcpy( strbuf + pos, argv[i], len );
+        pos += len;
+    }
+    sargv[n] = NULL;
+    for (i = 0; e && e[i]; i++)
+    {
+        len = strlen( e[i] ) + 1;
+        if (en >= (int)ARRAY_SIZE(senvp) - 1 || pos + len > sizeof(strbuf)) goto plain;
+        senvp[en++] = memcpy( strbuf + pos, e[i], len );
+        pos += len;
+    }
+    senvp[en] = NULL;
+    execve( spath, sargv, senvp );
+    return;
+plain:  /* 다 못 담으면 예전처럼 */
+    execv( path, argv );
+}
+#endif
