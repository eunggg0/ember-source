+/***********************************************************************
+ *           fixup_lost_x18
+ *
+ * macOS 는 x18 을 "플랫폼 예약" 으로 두고 예외에서 복귀할 때마다 0 으로 지운다.
+ * 시스템콜이나 시그널만이 아니라 타이머 선점만으로도 지워진다(실측: 2~4ms).
+ * 윈도우 ARM64 ABI 는 x18 에 TEB 를 두므로, PE 코드는 선점 직후 x18 로 TEB 를
+ * 읽다가 낮은 주소에서 폴트한다.
+ *
+ * **시그널 문맥의 x18 에 값을 써 넣는 것은 소용이 없다.** 커널이 복귀할 때
+ * 다시 지우기 때문에 같은 명령이 끝없이 폴트한다(실측 확인). 그래서 여기서는
+ * 폴트를 낸 명령을 **대신 실행해 주고** PC 를 다음으로 넘긴다.
+ *
+ * 다루는 것은 두 가지다.
+ *   1) `ldr xN|wN, [x18, #imm]`  — Wine 과 FEX 의 ARM64EC 경로가 쓰는 형태.
+ *      대신 읽어 주고 PC 를 넘긴다.
+ *   2) `mov xN, x18` 로 옮겨 놓고 `ldr ..., [xN, #imm]` 로 읽는 형태
+ *      — llvm-mingw 의 _CRT_INIT 이 이렇게 한다(실측: DXMT ARM64EC 의
+ *      winemetal.dll 이 여기서 죽었다). 이 경우는 xN 에 TEB 를 넣고 다시
+ *      실행시킨다. 일반 레지스터는 복귀해도 지워지지 않으므로 그 뒤로도 멀쩡하다.
+ * 그 밖의 형태는 가리지 말고 진짜 폴트로 올려서 드러나게 한다.
+ */
+/* macOS 자신의 라이브러리가 들어 있는 dyld 공유 캐시 범위.
+ * 그 안에서 난 폴트는 손대지 않는다. 시스템 코드의 x18 은 우리 것이 아니다. */
+extern const void *_dyld_get_shared_cache_range( size_t *length ) __attribute__((weak_import));
+
+static BOOL pc_in_shared_cache( ULONG_PTR pc )
+{
+    static ULONG_PTR cache_base, cache_end;
+
+    if (!cache_end)
+    {
+        size_t len = 0;
+        const void *base = _dyld_get_shared_cache_range ? _dyld_get_shared_cache_range( &len ) : NULL;
+        cache_base = (ULONG_PTR)base;
+        cache_end = cache_base + len;
+        if (!len) cache_end = ~(ULONG_PTR)0;   /* 못 구하면 아예 끄는 쪽이 안전하다 */
+    }
+    return pc >= cache_base && pc < cache_end;
+}
+
+extern BOOL virtual_handle_jit_fault( void *addr, void *pc, void *lr, BOOL exec );
+
+static BOOL fixup_lost_x18( struct thread_data *data, ucontext_t *sigcontext, siginfo_t *siginfo )
+{
+    ULONG_PTR addr = (ULONG_PTR)siginfo->si_addr;
+    UINT instr, rn, rt, imm;
+    const char *teb = (const char *)(data ? data->teb : NULL);
+
+    if (!teb) return FALSE;
+    /* TEB 크기 밖이면 진짜 널 참조다. 가리지 않는다. */
+    if (addr >= 0x2000) return FALSE;
+    if (pc_in_shared_cache( PC_sig(sigcontext) )) return FALSE;
+    if (REGn_sig( 18, sigcontext ) != 0) return FALSE;
+
+    instr = *(UINT *)PC_sig(sigcontext);
+    rn = (instr >> 5) & 0x1f;
+    rt = instr & 0x1f;
+
+    /* 컴파일러가 x18 을 다른 레지스터에 복사해 두고 그걸로 읽는 경우가 있다
+     * (llvm-mingw 의 _CRT_INIT: `mov x8, x18` 뒤 `ldr x25, [x8, #8]`).
+     * 그 레지스터는 0 이 돼 있으니, 바로 앞 명령이 x18 복사였는지 보고
+     * 그 레지스터에 TEB 를 넣어 준 뒤 같은 명령을 다시 실행시킨다.
+     * x18 과 달리 일반 레지스터는 복귀해도 값이 지워지지 않는다. */
+    if (rn != 18 && rn != 31 && !REGn_sig( rn, sigcontext ))
+    {
+        const UINT *pc = (const UINT *)PC_sig(sigcontext);
+        int i;
+
+        /* mov xN, x18  ==  orr xN, xzr, x18. 복사와 사용 사이에 다른 명령이
+         * 끼어 있을 수 있어 몇 칸 되짚는다(llvm-mingw 는 adrp 를 사이에 둔다). */
+        for (i = 1; i <= 8; i++)
+        {
+            UINT prev = pc[-i];
+            if (prev == (0xaa1203e0u | rn))
+            {
+                REGn_sig( rn, sigcontext ) = (ULONG_PTR)teb;
+                return TRUE;                         /* PC 는 그대로. 다시 실행한다 */
+            }
+            /* 사이 명령이 xN 을 바꿨을 수 있으면(`add x8, x8, #imm` 등) TEB 만 넣고 다시 실행하면 틀린 주소를 읽는다 —
+             * 튕기는 쪽이 낫다. 보수적으로: 목적 칸(비트 4:0)이 xN 이거나 LDP 의 둘째 목적(비트 14:10)이 xN 이면 포기. */
+            if ((prev & 0x1f) == rn) break;
+            if ((prev & 0x3a400000) == 0x28400000 && ((prev >> 10) & 0x1f) == rn) break;
+        }
+    }
+    if (rn != 18) return FALSE;
+
+    if ((instr & 0xffc00000) == 0xf9400000)          /* ldr xT, [x18, #imm*8] */
