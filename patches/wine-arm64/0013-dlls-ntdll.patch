index aaae9a2..8436fe7 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2101,6 +2101,76 @@ static DWORD get_core_id_regs_arm64( struct smbios_wine_id_reg_value_arm64 *regs
     return regidx;
 }
 
+#elif defined(__APPLE__)
+
+/* macOS 는 EL0 에서 ID 레지스터를 못 읽는다(트랩). 대신 sysctl 의 hw.optional.arm.FEAT_* 로
+ * ID_AA64* 값을 합성한다. FEX 같은 에뮬레이터가 이 레지스트리 값(CP 40xx)에서 호스트 기능을
+ * 읽어 CRC32/AES/LSE 유무를 정하고, 거기에 맞춰 x86 CPUID(SSE4.2·AES-NI 등)를 켠다.
+ * 비워 두면 "기능 없음"으로 보여 게스트가 SSE4.2 없는 CPU 로 오인한다(실측). */
+static DWORD get_core_id_regs_arm64( struct smbios_wine_id_reg_value_arm64 *regs,
+                                     WORD logical_thread_id )
+{
+    DWORD regidx = 0;
+    unsigned long long v;
+#define F(name) (has_feature( name ) ? 1ull : 0ull)
+#define FIELD(val, shift) (((unsigned long long)(val)) << (shift))
+
+    /* MIDR_EL1: 구현자 Apple(0x61). 파트 번호는 노출되지 않으므로 0 */
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4000, 0x61000000ull };
+
+    /* ID_AA64PFR0_EL1: EL0/EL1 AArch64, FP·AdvSIMD(FP16 이면 1), DIT, CSV2/3 */
+    v = FIELD(1, 0) | FIELD(1, 4)
+      | FIELD(F("FEAT_FP16"), 16) | FIELD(F("FEAT_FP16"), 20)
+      | FIELD(F("FEAT_DIT"), 48) | FIELD(F("FEAT_CSV2"), 56) | FIELD(F("FEAT_CSV3"), 60);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4020, v };
+    /* ID_AA64PFR1_EL1: BTI, SSBS */
+    v = FIELD(F("FEAT_BTI"), 0) | FIELD(F("FEAT_SSBS") ? 2 : 0, 4);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4021, v };
+    /* ID_AA64ZFR0_EL1: SVE 없음 */
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4024, 0 };
+    /* ID_AA64ISAR0_EL1 */
+    v = FIELD(F("FEAT_AES") ? (F("FEAT_PMULL") ? 2 : 1) : 0, 4)
+      | FIELD(F("FEAT_SHA1"), 8)
+      | FIELD(F("FEAT_SHA256") ? (F("FEAT_SHA512") ? 2 : 1) : 0, 12)
+      | FIELD(F("FEAT_CRC32"), 16)
+      | FIELD(F("FEAT_LSE") ? 2 : 0, 20)
+      | FIELD(F("FEAT_RDM"), 28)
+      | FIELD(F("FEAT_SHA3"), 32)
+      | FIELD(F("FEAT_DotProd"), 44)
+      | FIELD(F("FEAT_FHM"), 48)
+      | FIELD(F("FEAT_FlagM") ? (F("FEAT_FlagM2") ? 2 : 1) : 0, 52);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4030, v };
+    /* ID_AA64ISAR1_EL1 */
+    v = FIELD(F("FEAT_DPB") ? (F("FEAT_DPB2") ? 2 : 1) : 0, 0)
+      | FIELD(F("FEAT_JSCVT"), 12)
+      | FIELD(F("FEAT_FCMA"), 16)
+      | FIELD(F("FEAT_LRCPC") ? (F("FEAT_LRCPC2") ? 2 : 1) : 0, 20)
+      | FIELD(F("FEAT_FRINTTS"), 32)
+      | FIELD(F("FEAT_SB"), 36)
+      | FIELD(F("FEAT_SPECRES"), 40)
+      | FIELD(F("FEAT_BF16") ? (F("FEAT_EBF16") ? 2 : 1) : 0, 44)
+      | FIELD(F("FEAT_I8MM"), 52);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4031, v };
+    /* ID_AA64ISAR2_EL1: WFxT, RPRES */
+    v = FIELD(F("FEAT_WFxT") ? 2 : 0, 0) | FIELD(F("FEAT_RPRES"), 4);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4032, v };
+    /* ID_AA64MMFR0_EL1: PARange 48비트(5), ASIDBits 16(2), TGran16 지원(1), TGran4 미지원(0xf) */
+    v = FIELD(5, 0) | FIELD(2, 4) | FIELD(1, 20) | FIELD(0xf, 28);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4038, v };
+    /* ID_AA64MMFR1_EL1: AFP */
+    v = FIELD(F("FEAT_AFP"), 44);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4039, v };
+    /* ID_AA64MMFR2_EL1: AT(LSE2 — 정렬 안 된 원자 연산), ...  */
+    v = FIELD(F("FEAT_LSE2"), 32);
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x403a, v };
+    /* CTR_EL0 도 macOS 에선 EL0 읽기가 트랩된다(실측 SIGILL). Apple Silicon 의 값(M1~M4 동일:
+     * 캐시라인 64B, PIPT, ERG/CWG 64B)을 상수로 둔다. */
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x5801, 0x8444C004ull };
+#undef F
+#undef FIELD
+    return regidx;
+}
+
 #else
 
 static DWORD get_core_id_regs_arm64( struct smbios_wine_id_reg_value_arm64 *regs,
