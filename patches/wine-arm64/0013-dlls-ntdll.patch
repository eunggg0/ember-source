+    {
+        void *m = mmap( NULL, (size_t)st.st_size + 1, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0 );
+        if (m != MAP_FAILED) { data = m; maplen = (size_t)st.st_size + 1; cap = maplen; }
+    }
+    for (len = 0; len < (ssize_t)cap - 1; len += got)
+        if ((got = read( fd, data + len, cap - 1 - len )) <= 0) break;
+    close( fd );
+    if (len <= 0) { if (maplen) munmap( data, maplen ); return; }
+    data[len] = 0;
+
+    end = image->Buffer + image->Length / sizeof(WCHAR);
+    for (p = name = image->Buffer; p < end; p++) if (*p == '\\' || *p == '/') name = p + 1;
+    n = end - name;
+    if (n >= sizeof(buf)) n = 0;
+    for (i = 0; i < n; i++) buf[i] = name[i] > 127 ? '?' : (char)name[i];
+    buf[n] = 0;
+
+    for (line = data; line && *line; line = next)
+    {
+        char *tab, *eq;
+        size_t flen;
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        if (!(tab = strchr( line, '\t' ))) continue;
+        *tab = 0;
+        flen = tab - line;
+        if (!flen) continue;
+        if (line[0] == '\\' || line[0] == '/')
+        {
+            if (!ember_path_contains( image->Buffer, end, line, flen )) continue;
+        }
+        else if (flen != n || strncasecmp( line, buf, flen )) continue;
+        if (!(eq = strchr( tab + 1, '=' )) || eq == tab + 1) continue;
+        *eq = 0;
+        if (eq[1]) setenv( tab + 1, eq + 1, 1 );
+        else unsetenv( tab + 1 );
+        /* 규칙이 하나라도 입혀졌다 — 새 프로세스의 윈도우 환경도 맞추게 표시(env.c ember_sync_pe_environment) */
+        setenv( "EMBER_EXE_ENV_APPLIED", "1", 1 );
+        /* 보틀 규칙 파일로 입혔으면 이 프로세스부터는 규칙 파일을 아는 세션처럼(윈도우 환경 동기화·자손 규칙) 다룬다 */
+        if (path == bottle_rules) setenv( "EMBER_EXE_ENV_FILE", bottle_rules, 1 );
+    }
+    if (maplen) munmap( data, maplen );
+}
