+            close( high[k] );
+            high[k] = -1;
+        }
+    }
+    /* 2차: 자리를 못 잡은 것은 빈 낮은 번호로 옮기고 번호를 담은 환경 변수를 고친다. 서버 소켓을 못 옮기면 포기. */
+    for (k = 0; k < ngot; k++)
+    {
+        char num[16];
+        int nfdn;
+
+        if (high[k] < 0) continue;
+        nfdn = fcntl( high[k], F_DUPFD, 3 );
+        close( high[k] );
+        high[k] = -1;
+        if (nfdn < 0)
+        {
+            if (targets[k] == srv_target) _exit( 1 );
+            continue;
+        }
+        snprintf( num, sizeof(num), "%d", nfdn );
+        for (j = 0; j < ARRAY_SIZE(num_envs); j++)
+            if ((e = getenv( num_envs[j] )) && atoi( e ) == targets[k]) setenv( num_envs[j], num, 1 );
+    }
+    free( targets );
+    free( got );
+    free( high );
+    /* 다 앉힌 뒤에 받았다고 알린다 — 그 전에 실패하면 도우미가 예전 exec 로 띄운다 */
+    dummy = 'K';
+    if (write( s, &dummy, 1 ) != 1) _exit( 1 );
+    close( s );
+}
