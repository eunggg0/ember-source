+static int ember_ls_read( int s, void *buf, size_t n )
+{
+    char *p = buf;
+    while (n)
+    {
+        ssize_t r = read( s, p, n );
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) return 0;
+        p += r; n -= r;
+    }
+    return 1;
