+    if (chdir( cwd )) chdir( "/" );
+    free( cwd );
+
+    /* 받은 fd 와 소켓을 모두 목표 번호 최댓값 위로 옮긴다 — 받은 번호·소켓 번호가 다른 목표와 겹칠 수 있다. */
