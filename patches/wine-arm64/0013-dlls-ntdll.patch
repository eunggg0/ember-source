+    {
+        if (targets[k] == -2)  /* 종료 코드 파이프: 높은 번호 그대로, 자식에게는 안 물려준다 */
+        {
+            fcntl( high[k], F_SETFD, FD_CLOEXEC );
+            ember_ls_status_fd = high[k];
+            high[k] = -1;
+            continue;
+        }
+        if (targets[k] < 0) { close( high[k] ); high[k] = -1; continue; }
+        if (targets[k] > 2 && fcntl( targets[k], F_GETFD ) != -1) continue;
+        if (dup2( high[k], targets[k] ) == targets[k] || targets[k] <= 2)
