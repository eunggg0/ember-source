+static void ember_ls_handoff(void)
+{
+    static const char *num_envs[] = { "WINESERVERSOCKET", "WINE_WAIT_CHILD_PIPE" };
+    const char *v = getenv( "EMBER_LS_HANDOFF" );
+    struct sockaddr_un sa;
+    char magic[5], *cwd, *e, *eq, cbuf[CMSG_SPACE(sizeof(int) * EMBER_LS_CHUNK)], dummy;
+    uint32_t ne, nfd, i;
+    int s, k, maxt = 2, base, ngot = 0, srv_target = -1, *targets, *got, *high;
+    struct iovec iov;
+    struct msghdr msg;
+    struct cmsghdr *c;
+    unsigned int j;
+
+    if (!v || !*v) return;
+    memset( &sa, 0, sizeof(sa) );
+    sa.sun_family = AF_UNIX;
+    if (strlen( v ) >= sizeof(sa.sun_path)) _exit( 1 );
+    strcpy( sa.sun_path, v );
+    unsetenv( "EMBER_LS_HANDOFF" );
+    if ((s = socket( AF_UNIX, SOCK_STREAM, 0 )) < 0) _exit( 1 );
+    for (k = 0; k < 100; k++)
+    {
+        if (!connect( s, (struct sockaddr *)&sa, sizeof(sa) )) break;
+        usleep( 20000 );
+    }
+    if (k == 100) _exit( 1 );
+    if (!ember_ls_read( s, magic, 5 ) || memcmp( magic, "EMLS1", 5 )) _exit( 1 );
+    if (!(cwd = ember_ls_read_str( s ))) _exit( 1 );
+    if (!ember_ls_read( s, &ne, 4 ) || ne > 100000) _exit( 1 );
+    for (i = 0; i < ne; i++)
+    {
+        if (!(e = ember_ls_read_str( s ))) _exit( 1 );
+        if ((eq = strchr( e, '=' )) && strncmp( e, "EMBER_LS_HANDOFF=", 17 ))
+        {
+            *eq = 0;
+            setenv( e, eq + 1, 1 );
+        }
+        free( e );
+    }
+    if (!ember_ls_read( s, &nfd, 4 ) || nfd > EMBER_LS_MAX_FDS) _exit( 1 );
+    if (!(targets = malloc( sizeof(int) * (nfd + 1) )) || !(got = malloc( sizeof(int) * (nfd + 1) )) ||
+        !(high = malloc( sizeof(int) * (nfd + 1) ))) _exit( 1 );
+    if (nfd && !ember_ls_read( s, targets, sizeof(int) * nfd )) _exit( 1 );
+    for (i = 0; i < nfd; i++) if (targets[i] > maxt) maxt = targets[i];
+    if ((e = getenv( "WINESERVERSOCKET" ))) srv_target = atoi( e );
+
+    /* 받기 전에 fd 한도부터: 목표 번호 최댓값 위로 받은 fd 를 잠시 옮겨 둘 자리까지. 못 올리면 넘겨받기를 포기한다
+     * (응답 'K' 전이라 도우미가 예전 exec 로 다시 띄운다). */
+    if (!ember_ls_raise_nofile( (rlim_t)maxt + 1 + nfd + 64 )) _exit( 1 );
+
+    /* fd 는 64개씩 여러 번에 나눠 온다(각 1바이트 'F' + SCM_RIGHTS) */
+    while (ngot < (int)nfd)
+    {
+        int n = 0;
+        iov.iov_base = &dummy; iov.iov_len = 1;
+        memset( &msg, 0, sizeof(msg) );
+        msg.msg_iov = &iov; msg.msg_iovlen = 1;
+        msg.msg_control = cbuf; msg.msg_controllen = sizeof(cbuf);
+        for (;;)
+        {
+            ssize_t r = recvmsg( s, &msg, 0 );
+            if (r == 1) break;
+            if (r < 0 && errno == EINTR) continue;
+            _exit( 1 );
+        }
+        for (c = CMSG_FIRSTHDR( &msg ); c; c = CMSG_NXTHDR( &msg, c ))
+            if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+            {
+                n = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+                if (n > EMBER_LS_CHUNK || ngot + n > (int)nfd) _exit( 1 );
+                memcpy( got + ngot, CMSG_DATA( c ), sizeof(int) * n );
+                ngot += n;
+            }
+        if (!n || (msg.msg_flags & MSG_CTRUNC)) _exit( 1 );
