+static int ember_loader_has_ntdll( const char *loader )
+{
+    char buf[1024];
+    const char *slash = strrchr( loader, '/' );
+    struct stat st;
+    size_t len;
+
+    if (!slash) return 0;
+    len = slash - loader + 1;
+    if (len + sizeof("ntdll.so") > sizeof(buf)) return 0;
+    memcpy( buf, loader, len );
+    memcpy( buf + len, "ntdll.so", sizeof("ntdll.so") );
+    if (stat( buf, &st ) || !S_ISREG( st.st_mode )) return 0;
+    /* 링크가 살아 있어도 다른 런타임의 ntdll 이면 안 된다. 게임 번들(Data/Apps/<게임>.app)은 엔진과 상관없이 게임 이름 하나라,
