+/* Hangul Jamo, Compatibility Jamo, Jamo Extended-A/B and syllables. */
+static BOOL ime_text_is_hangul(NSString* text)
+{
+    NSUInteger i, length = [text length];
+
+    if (!length)
+        return NO;
+    for (i = 0; i < length; i++)
+    {
+        unichar c = [text characterAtIndex:i];
+        if (!((c >= 0x1100 && c <= 0x11ff) || (c >= 0x3131 && c <= 0x318e) ||
+              (c >= 0xa960 && c <= 0xa97f) || (c >= 0xac00 && c <= 0xd7a3) ||
+              (c >= 0xd7b0 && c <= 0xd7ff)))
+            return NO;
+    }
+    return YES;
+}
 
 
