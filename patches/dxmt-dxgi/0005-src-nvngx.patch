+// Sign overrides for convention mismatches between DLSS and MetalFX (default: pass through).
+// DXMT_NGX_JITTER_SIGN=-1 negates the jitter offsets, DXMT_NGX_MV_SIGN=-1 negates motion vectors.
+static float
+EnvSign(const char *name) {
+  return env::getEnvVar(name) == "-1" ? -1.0f : 1.0f;
+}
+
+static void
+TextureSize(ID3D11Resource *res, UINT *w, UINT *h) {
+  *w = 0;
+  *h = 0;
+  Com<ID3D11Texture2D> tex;
+  if (res && SUCCEEDED(res->QueryInterface(IID_PPV_ARGS(&tex)))) {
+    D3D11_TEXTURE2D_DESC desc;
+    tex->GetDesc(&desc);
+    *w = desc.Width;
+    *h = desc.Height;
+  }
+}
