+// Resources set through the generic void* setter (SetVoidPointer) and read back as a typed resource, and vice versa.
+template <>
+inline bool
+castable(void *val, ID3D11Resource **out) {
+  *out = (ID3D11Resource *)val;
+  return true;
+}
+
+template <>
+inline bool
+castable(ID3D11Resource *val, void **out) {
+  *out = (void *)val;
+  return true;
+}
+
+template <>
+inline bool
+castable(void *val, ID3D12Resource **out) {
+  *out = (ID3D12Resource *)val;
+  return true;
+}
+
+template <>
+inline bool
+castable(ID3D12Resource *val, void **out) {
+  *out = (void *)val;
+  return true;
+}
