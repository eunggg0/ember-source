 #define NVNGX_API extern "C"
 
+// Values must match nvsdk_ngx_defs.h: the SDK tests failure with
+// ((r & 0xFFF00000) == 0xBAD00000). The old 0xbad0000 (one zero short) made every
+// failure look like success to the game (e.g. CreateFeature failing -> null handle used).
+// Verified against nvngx_dlss.dll 310.4 which returns 0xBAD00005 for invalid parameters.
 enum NVNGX_RESULT : unsigned int {
   NVNGX_RESULT_OK = 1,
-  NVNGX_RESULT_FAIL = 0xbad0000,
-  NVNGX_RESULT_FEATURE_NOT_SUPPORTED = 0xbad0001,
-  NVNGX_RESULT_INVALID_PARAMETER = 0xbad0005,
+  NVNGX_RESULT_FAIL = 0xBAD00000,
+  NVNGX_RESULT_FEATURE_NOT_SUPPORTED = 0xBAD00001,
+  NVNGX_RESULT_PLATFORM_ERROR = 0xBAD00002,
+  NVNGX_RESULT_INVALID_PARAMETER = 0xBAD00005,
+  NVNGX_RESULT_NOT_INITIALIZED = 0xBAD0000E,
 };
 
-#define NVNGX_FAILED(result) (result & NVNGX_RESULT_FAIL) == NVNGX_RESULT_FAIL
+#define NVNGX_FAILED(result) ((((unsigned int)(result)) & 0xFFF00000u) == NVNGX_RESULT_FAIL)
 
 enum NVNGX_FEATURE : unsigned int {
   NVNGX_FEATURE_SUPERSAMPLING = 1,
