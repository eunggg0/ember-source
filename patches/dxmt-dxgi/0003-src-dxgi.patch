From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 3/7] src-dxgi: Ember changes

Base: DXMT 7c8dee1 with submodules; retained verified DXGI lineage
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/src/dxgi/dxgi.cpp b/src/dxgi/dxgi.cpp
index e9d8100..d5185b7 100644
--- a/src/dxgi/dxgi.cpp
+++ b/src/dxgi/dxgi.cpp
@@ -33,9 +33,13 @@ static void InitializeVendorExtensionNV() {
     goto cleanup;
   }
   if (env::getEnvVar("DXMT_ENABLE_NVEXT") != "1") {
-    RegDeleteValueW(key1, name1);
-    RegDeleteValueW(key2, name1);
-    RegDeleteValueW(key3, name2);
+    // Ember: a process started later without NVEXT (launcher child, CEF helper, overlay) must not
+    // wipe the NGX core path a running DLSS game in the same prefix relies on.
+    if (env::getEnvVar("DXMT_NVEXT_KEEP_REGISTRY") != "1") {
+      RegDeleteValueW(key1, name1);
+      RegDeleteValueW(key2, name1);
+      RegDeleteValueW(key3, name2);
+    }
   } else {
     DWORD _1 = 1;
     RegSetValueExW(key1, name1, 0, REG_DWORD, (const BYTE *)&_1, sizeof(_1));
