         if (!retv)
             status = STATUS_DLL_INIT_FAILED;
     }
@@ -2142,12 +2042,6 @@
         if (result) *result = 1;
     }
     *magic = GetCurrentThreadId();
-    /* Ember loahang: an app/DLL (anti-cheat, CEF, FEX…) holding the loader lock itself shows up in the report */
-    if (!ember_ldr_cur.what && loader_section.RecursionCount == 1)
