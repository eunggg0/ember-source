-/* Ember loahang (10-16): what the loader-lock owner is doing right now. 10-16 18:30 STOVE (FEX) sat for minutes with
- * "loader_section ... blocked by 1044" while 1044 itself never printed anything (it was not waiting on another critical
- * section) and no debugger could be attached. The owner writes a small fixed-size record (no pointers - a waiter may
- * read it at any time) at each step that can block: load_dll, DllMain / TLS callbacks, LDR notifications, FEX thread
- * init. RtlpWaitForCriticalSection prints it when a thread times out on loader_section. */
-struct ember_ldr_mark
-{
-    const char *what;        /* static string */
-    WCHAR       dll[48];
-    void       *module;
-    UINT        reason;
-    ULONG       since;       /* NtGetTickCount() */
-};
-static struct ember_ldr_mark ember_ldr_cur;
-
-static void ember_ldr_push( struct ember_ldr_mark *save, const char *what, const WCHAR *dll, USHORT dll_bytes,
-                            void *module, UINT reason )
-{
-    struct ember_ldr_mark m;
-    size_t n = 0;
-
-    *save = ember_ldr_cur;
-    m.what = what;
-    if (dll)
-    {
-        const WCHAR *p = dll;
-        size_t i, len = dll_bytes ? dll_bytes / sizeof(WCHAR) : wcslen( dll );
-        for (i = 0; i < len; i++) if (dll[i] == '\\' || dll[i] == '/') p = dll + i + 1;
-        len -= p - dll;
-        for (; n < len && n < ARRAY_SIZE(m.dll) - 1; n++) m.dll[n] = p[n];
-    }
-    m.dll[n] = 0;
-    m.module = module;
-    m.reason = reason;
-    m.since = NtGetTickCount();
-    ember_ldr_cur = m;
-}
-
-static void ember_ldr_pop( const struct ember_ldr_mark *save )
-{
-    ember_ldr_cur = *save;
-}
-
-/* is this thread gone (exited, or its id now belongs to another process)? */
-BOOL ember_thread_gone( ULONG tid )
-{
-    OBJECT_ATTRIBUTES attr;
-    CLIENT_ID cid;
-    THREAD_BASIC_INFORMATION tbi;
-    HANDLE handle;
-    NTSTATUS status;
-
-    if (!tid) return FALSE;
-    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
-    cid.UniqueProcess = 0;
-    cid.UniqueThread = ULongToHandle( tid );
-    status = NtOpenThread( &handle, THREAD_QUERY_LIMITED_INFORMATION, &attr, &cid );
-    if (status == STATUS_INVALID_CID || status == STATUS_INVALID_PARAMETER) return TRUE;
-    if (status) return FALSE;
-    status = NtQueryInformationThread( handle, ThreadBasicInformation, &tbi, sizeof(tbi), NULL );
-    NtClose( handle );
-    if (status) return FALSE;
-    if (HandleToULong( tbi.ClientId.UniqueProcess ) != HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess )) return TRUE;
-    return tbi.ExitStatus != STATUS_PENDING;
-}
-
-void ember_loader_lock_report( ULONG owner )
-{
-    struct ember_ldr_mark m = ember_ldr_cur;   /* may be torn; fixed-size data only, so harmless */
-
-    m.dll[ARRAY_SIZE(m.dll) - 1] = 0;
-    ERR( "loader lock owner %04lx: %s %s module %p reason %u, for %lu ms; owner thread %s\n", owner,
-         m.what ? m.what : "(not in a marked loader step)", debugstr_w(m.dll), m.module, m.reason,
-         m.what ? NtGetTickCount() - m.since : 0, ember_thread_gone( owner ) ? "GONE" : "alive" );
-}
-
-/* Take over a loader lock whose owner thread no longer exists (default on; EMBER_LDR_ORPHAN=0 turns it off).
- * A dead owner can never release it, so without this the process is stuck for good. */
-BOOL ember_loader_lock_orphan_ok(void)
-{
-    WCHAR buf[8];
-    UNICODE_STRING name = RTL_CONSTANT_STRING( L"EMBER_LDR_ORPHAN" ), value;
-
-    value.Buffer = buf;
-    value.Length = 0;
-    value.MaximumLength = sizeof(buf);
-    if (!RtlQueryEnvironmentVariable_U( NULL, &name, &value ) && value.Length && buf[0] == '0') return FALSE;
-    return TRUE;
-}
-
