-        struct ember_ldr_mark unused;
-        ember_ldr_push( &unused, "LdrLockLoaderLock (held by caller code)", NULL, 0, NULL, 0 );
-    }
     return STATUS_SUCCESS;
 }
 
@@ -2160,9 +2054,6 @@
     if (magic)
     {
         if (magic != GetCurrentThreadId()) return STATUS_INVALID_PARAMETER_2;
-        if (loader_section.RecursionCount == 1 && ember_ldr_cur.what &&
