diff --git a/dlls/wmp/events.c b/dlls/wmp/events.c
index 3dff0a2c52363efb73c96f5e3a7dfddf12778fcc..9f2b1cb4b296cf485bb5c2da2d82d0905c15e991 100644
--- a/dlls/wmp/events.c
+++ b/dlls/wmp/events.c
@@ -402,24 +402,11 @@
 
 void call_sink(ConnectionPoint *This, DISPID dispid, DISPPARAMS *dispparams)
 {
-    IDispatch **sinks;
-    DWORD i, count = This->sinks_size;
-
-    if (!count) return;
-    sinks = malloc(count * sizeof(*sinks));
-    if (!sinks) return;
-    /* Sinks may Advise/Unadvise (including themselves) during Invoke. */
-    for (i = 0; i < count; ++i)
-    {
-        sinks[i] = This->sinks[i];
-        if (sinks[i]) IDispatch_AddRef(sinks[i]);
-    }
-    for (i = 0; i < count; ++i)
-    {
-        if (!sinks[i]) continue;
-        IDispatch_Invoke(sinks[i], dispid, &IID_NULL, LOCALE_SYSTEM_DEFAULT,
-                DISPATCH_METHOD, dispparams, NULL, NULL, NULL);
-        IDispatch_Release(sinks[i]);
-    }
-    free(sinks);
-}
+    DWORD i;
+
+    for(i=0; i<This->sinks_size; i++) {
+        if(This->sinks[i])
+            IDispatch_Invoke(This->sinks[i], dispid, &IID_NULL, LOCALE_SYSTEM_DEFAULT,
+                    DISPATCH_METHOD, dispparams, NULL, NULL, NULL);
+    }
+}
