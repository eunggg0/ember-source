-static HRESULT WINAPI WMPErrorItem_Invoke(IWMPErrorItem *iface, DISPID id, REFIID riid,
-        LCID lcid, WORD flags, DISPPARAMS *params, VARIANT *result,
-        EXCEPINFO *exception, UINT *arg_error)
-{
-    if (!IsEqualIID(riid, &IID_NULL)) return DISP_E_UNKNOWNINTERFACE;
-    if (!params || !result) return E_POINTER;
-    if (params->cNamedArgs) return DISP_E_NONAMEDARGS;
-    if (!(flags & DISPATCH_PROPERTYGET) || id < 0x385 || id > 0x389)
-        return DISP_E_MEMBERNOTFOUND;
-    if (params->cArgs) return DISP_E_BADPARAMCOUNT;
-    VariantInit(result);
-    switch (id)
-    {
-    case 0x385:
-        V_VT(result) = VT_I4;
-        return WMPErrorItem_get_errorCode(iface, &V_I4(result));
-    case 0x386:
-        V_VT(result) = VT_BSTR;
-        return WMPErrorItem_get_errorDescription(iface, &V_BSTR(result));
-    case 0x387:
-        return WMPErrorItem_get_errorContext(iface, result);
-    case 0x388:
-        V_VT(result) = VT_I4;
-        return WMPErrorItem_get_remedy(iface, &V_I4(result));
-    default:
-        V_VT(result) = VT_BSTR;
-        return WMPErrorItem_get_customUrl(iface, &V_BSTR(result));
-    }
-}
