-    return CONTAINING_RECORD(iface, WindowsMediaPlayer, IWMPError_iface);
-}
-
-static inline WindowsMediaPlayer *impl_from_IWMPErrorItem(IWMPErrorItem *iface)
-{
-    return CONTAINING_RECORD(iface, WindowsMediaPlayer, IWMPErrorItem_iface);
-}
-
-static HRESULT WINAPI WMPError_QueryInterface(IWMPError *iface, REFIID riid, void **out)
-{
-    WindowsMediaPlayer *This = impl_from_IWMPError(iface);
-
-    if (!out) return E_POINTER;
-    if (IsEqualIID(riid, &IID_IWMPError) || IsEqualIID(riid, &IID_IDispatch))
-    {
-        *out = iface;
-        IWMPError_AddRef(iface);
-        return S_OK;
-    }
-    return IOleObject_QueryInterface(&This->IOleObject_iface, riid, out);
-}
-
-static ULONG WINAPI WMPError_AddRef(IWMPError *iface)
-{
-    return IOleObject_AddRef(&impl_from_IWMPError(iface)->IOleObject_iface);
-}
-
-static ULONG WINAPI WMPError_Release(IWMPError *iface)
-{
-    return IOleObject_Release(&impl_from_IWMPError(iface)->IOleObject_iface);
-}
-
-static HRESULT WINAPI WMPError_GetTypeInfoCount(IWMPError *iface, UINT *count)
-{
-    if (!count) return E_POINTER;
-    *count = 0;
-    return S_OK;
-}
-
-static HRESULT WINAPI WMPError_GetTypeInfo(IWMPError *iface, UINT index, LCID lcid, ITypeInfo **out)
-{
-    if (!out) return E_POINTER;
-    *out = NULL;
-    return DISP_E_BADINDEX;
-}
-
-static HRESULT WINAPI WMPError_GetIDsOfNames(IWMPError *iface, REFIID riid,
-        WCHAR **names, UINT count, LCID lcid, DISPID *ids)
-{
-    if (!IsEqualIID(riid, &IID_NULL)) return DISP_E_UNKNOWNINTERFACE;
-    if (!names || !ids) return E_POINTER;
-    if (count != 1) return DISP_E_UNKNOWNNAME;
-    if (!lstrcmpiW(names[0], L"clearErrorQueue")) *ids = 0x353;
-    else if (!lstrcmpiW(names[0], L"errorCount")) *ids = 0x354;
-    else if (!lstrcmpiW(names[0], L"Item")) *ids = 0x355;
-    else if (!lstrcmpiW(names[0], L"webHelp")) *ids = 0x356;
-    else { *ids = DISPID_UNKNOWN; return DISP_E_UNKNOWNNAME; }
-    return S_OK;
-}
-
-static HRESULT WINAPI WMPError_clearErrorQueue(IWMPError *iface)
-{
-    impl_from_IWMPError(iface)->last_error = S_OK;
-    return S_OK;
-}
-
-static HRESULT WINAPI WMPError_get_errorCount(IWMPError *iface, LONG *count)
-{
-    if (!count) return E_POINTER;
-    *count = FAILED(impl_from_IWMPError(iface)->last_error) ? 1 : 0;
-    return S_OK;
-}
-
-static HRESULT WINAPI WMPError_get_Item(IWMPError *iface, LONG index, IWMPErrorItem **out)
-{
-    WindowsMediaPlayer *This = impl_from_IWMPError(iface);
-
-    if (!out) return E_POINTER;
-    *out = NULL;
-    if (index || SUCCEEDED(This->last_error)) return E_INVALIDARG;
-    *out = &This->IWMPErrorItem_iface;
-    IWMPErrorItem_AddRef(*out);
-    return S_OK;
-}
-
-static HRESULT WINAPI WMPError_webHelp(IWMPError *iface)
-{
-    return E_NOTIMPL;
-}
-
-static HRESULT WINAPI WMPError_Invoke(IWMPError *iface, DISPID id, REFIID riid,
-        LCID lcid, WORD flags, DISPPARAMS *params, VARIANT *result,
-        EXCEPINFO *exception, UINT *arg_error)
-{
-    HRESULT hr;
-    VARIANT index;
-
-    if (!IsEqualIID(riid, &IID_NULL)) return DISP_E_UNKNOWNINTERFACE;
-    if (!params) return E_POINTER;
-    if (params->cNamedArgs) return DISP_E_NONAMEDARGS;
-    if (id == 0x353 || id == 0x356)
-    {
-        if (!(flags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
-        if (params->cArgs) return DISP_E_BADPARAMCOUNT;
-        if (result) VariantInit(result);
-        return id == 0x353 ? WMPError_clearErrorQueue(iface) : WMPError_webHelp(iface);
-    }
-    if (!(flags & DISPATCH_PROPERTYGET)) return DISP_E_MEMBERNOTFOUND;
-    if (id != 0x354 && id != 0x355) return DISP_E_MEMBERNOTFOUND;
-    if (params->cArgs != (id == 0x355 ? 1 : 0)) return DISP_E_BADPARAMCOUNT;
-    if (!result) return E_POINTER;
-    VariantInit(result);
-    if (id == 0x354)
-    {
-        V_VT(result) = VT_I4;
-        return WMPError_get_errorCount(iface, &V_I4(result));
-    }
-    VariantInit(&index);
-    if (!params->rgvarg) return E_POINTER;
-    if (FAILED(hr = VariantChangeType(&index, params->rgvarg, 0, VT_I4)))
-    {
-        if (arg_error) *arg_error = 0;
-        return hr;
-    }
-    hr = WMPError_get_Item(iface, V_I4(&index), (IWMPErrorItem **)&V_DISPATCH(result));
-    VariantClear(&index);
-    if (SUCCEEDED(hr)) V_VT(result) = VT_DISPATCH;
-    return hr;
-}
