From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 2/74] dlls-avifil32: Ember changes

Base: CrossOver 26.3.0 FOSS source, sources/wine (crossover-sources-26.3.0.tar.gz)
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/avifil32/avifile.c b/dlls/avifil32/avifile.c
index 6aae473..cd10428 100644
--- a/dlls/avifil32/avifile.c
+++ b/dlls/avifil32/avifile.c
@@ -1054,6 +1054,12 @@ static HRESULT WINAPI IAVIStream_fnRead(IAVIStream *iface, LONG start, LONG samp
 
     while (samples > 0 && buffersize > 0) {
       LONG blocksize;
+      if (block > This->lLastFrame) {
+        /* Ember(parity-avi): 색인 끝 — 머리의 dwLength 가 실제 데이터보다 길다. 읽은 만큼 돌려준다. */
+        if (bytesread != NULL && *bytesread > 0) return AVIERR_OK;
+        if (samplesread != NULL && *samplesread > 0) return AVIERR_OK;
+        return AVIERR_NODATA;
+      }
       if (block != This->dwCurrentFrame) {
 	hr = AVIFILE_ReadBlock(This, block, NULL, 0);
 	if (FAILED(hr))
@@ -1088,7 +1094,8 @@ static HRESULT WINAPI IAVIStream_fnRead(IAVIStream *iface, LONG start, LONG samp
     if (samples > 1)
       samples = 1;
 
-    assert(start <= This->lLastFrame);
+    if (start > This->lLastFrame || !This->idxFrames)
+      return AVIERR_NODATA;  /* Ember(parity-avi): assert 대신 */
     size = This->idxFrames[start].dwChunkLength;
     if (buffer != NULL && buffersize >= size) {
       hr = AVIFILE_ReadBlock(This, start, buffer, size);
@@ -2001,7 +2008,9 @@ static HRESULT AVIFILE_ReadBlock(IAVIStreamImpl *This, DWORD pos,
   assert(This->paf->hmmio != NULL);
   if (!This->sInfo.dwSampleSize)
     assert(This->sInfo.dwStart <= pos && pos < This->sInfo.dwLength);
-  assert(pos <= This->lLastFrame);
+  /* Ember(parity-avi): 머리 길이 > 색인(옛 인코더·OpenDML) — abort 대신 데이터 없음 */
+  if (pos > This->lLastFrame || !This->idxFrames)
+    return AVIERR_NODATA;
 
   /* should we read as much as block gives us? */
   if (size == 0 || size > This->idxFrames[pos].dwChunkLength)
