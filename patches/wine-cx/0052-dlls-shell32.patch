From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 52/74] dlls-shell32: Ember changes

Base: CrossOver 26.3.0 FOSS sources/wine
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/shell32/brsfolder.c b/dlls/shell32/brsfolder.c
index ebaf01e..36607ca 100644
--- a/dlls/shell32/brsfolder.c
+++ b/dlls/shell32/brsfolder.c
@@ -50,6 +50,7 @@ typedef struct tagbrowse_info
     HWND          hwndTreeView;
     LPBROWSEINFOW lpBrowseInfo;
     LPITEMIDLIST  pidlRet;
+    LPITEMIDLIST  pidlRoot;
     LAYOUT_DATA  *layout;  /* filled by LayoutInit, used by LayoutUpdate */
     SIZE          szMin;
     ULONG         hNotify; /* change notification handle */
@@ -169,16 +170,6 @@ static void LayoutUpdate(HWND hwnd, LAYOUT_DATA *data, const LAYOUT_INFO *layout
     }
 }
 
-
-/******************************************************************************
- * InitializeTreeView [Internal]
- *
- * Called from WM_INITDIALOG handler.
- * 
- * PARAMS
- *  hwndParent [I] The BrowseForFolder dialog
- *  root       [I] ITEMIDLIST of the root shell folder
- */
 static void InitializeTreeView( browse_info *info )
 {
     LPITEMIDLIST pidlParent, pidlChild;
@@ -188,7 +179,7 @@ static void InitializeTreeView( browse_info *info )
     IEnumIDList * pEnumChildren = NULL;
     HTREEITEM item;
     DWORD flags;
-    LPCITEMIDLIST root = info->lpBrowseInfo->pidlRoot;
+    LPCITEMIDLIST root = info->pidlRoot;
 
     TRACE("%p\n", info );
     
@@ -925,7 +916,7 @@ static BOOL BrsFolder_OnSetExpanded(browse_info *info, LPVOID selection,
 
     /* Move pidlCurrent behind the SHITEMIDs in pidlSelection, which are the root of
      * the sub-tree currently displayed. */
-    pidlRoot = info->lpBrowseInfo->pidlRoot;
+    pidlRoot = info->pidlRoot;
     pidlCurrent = pidlSelection;
     while (!_ILIsEmpty(pidlRoot) && _ILIsEqualSimple(pidlRoot, pidlCurrent)) {
         pidlRoot = ILGetNext(pidlRoot);
@@ -1030,6 +1021,8 @@ static INT BrsFolder_OnDestroy(browse_info *info)
         info->layout = NULL;
     }
 
+    ILFree(info->pidlRoot);
+    info->pidlRoot = NULL;
     SHChangeNotifyDeregister(info->hNotify);
 
     return 0;
@@ -1230,15 +1223,35 @@ LPITEMIDLIST WINAPI SHBrowseForFolderW (LPBROWSEINFOW lpbi)
     hr = OleInitialize(NULL);
 
     if (lpbi->ulFlags & BIF_NEWDIALOGSTYLE)
+    {
         templateName = L"SHNEWBRSFORFOLDER_MSGBOX";
+        info.pidlRoot = ILClone(lpbi->pidlRoot);
+    }
     else
+    {
         templateName = L"SHBRSFORFOLDER_MSGBOX";
+
+        if (IS_INTRESOURCE(lpbi->pidlRoot))
+        {
+            hr = SHGetFolderLocation(NULL, LOWORD(lpbi->pidlRoot) | CSIDL_FLAG_CREATE, NULL, 0, &info.pidlRoot);
+            if (FAILED(hr))
+            {
+                WARN("Failed to create a PIDL for folder %#x, hr %#lx.\n", LOWORD(lpbi->pidlRoot), hr);
+                return NULL;
+            }
+        }
+        else
+        {
+            info.pidlRoot = ILClone(lpbi->pidlRoot);
+        }
+    }
     r = DialogBoxParamW( shell32_hInstance, templateName, lpbi->hwndOwner,
 	                 BrsFolderDlgProc, (LPARAM)&info );
     if (SUCCEEDED(hr)) 
         OleUninitialize();
     if (!r)
     {
+        ILFree(info.pidlRoot);
         ILFree(info.pidlRet);
         return NULL;
     }
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index adfa296..d531dbf 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -2632,8 +2632,13 @@ static HRESULT _SHExpandEnvironmentStrings(LPCWSTR szSrc, LPWSTR szDest)
         }
         else if (!wcsnicmp(szTemp, L"%USERPROFILE%", lstrlenW(L"%USERPROFILE%")))
         {
-            /* CrossOver Hack 12735 */
-            static const WCHAR userName[] = {'c','r','o','s','s','o','v','e','r',0};
+            /* CrossOver Hack 12735: 프로필 폴더를 늘 "crossover" 로 둔다.
+             * Ember: GetUserNameW 가 돌려주는 이름을 쓴다. CX_REPORT_REAL_USERNAME 이 없으면 그것도 "crossover" 라
+             * 크로스오버와 같고, Ember 는 그 변수를 켜서 기존 보틀의 users/<이름> 을 그대로 쓴다. */
+            WCHAR userName[256];
+            DWORD userLen = ARRAY_SIZE(userName);
+
+            if (!GetUserNameW(userName, &userLen)) lstrcpyW(userName, L"crossover");
 
             lstrcpyW(szDest, szProfilesPrefix);
             PathAppendW(szDest, userName);
@@ -4681,12 +4686,19 @@ static HRESULT foldermanager_create( void **ppv )
     }
     for (i = j = 0; i < ARRAY_SIZE(CSIDL_Data); i++)
     {
-        if (!IsEqualGUID( CSIDL_Data[i].id, &GUID_NULL ))
-        {
-            fm->ids[j] = *CSIDL_Data[i].id;
-            j++;
-        }
+        UINT k;
+
+        if (IsEqualGUID( CSIDL_Data[i].id, &GUID_NULL )) continue;
+        /* Ember nexon2: several CSIDLs share one known folder (Desktop, Favorites); Windows lists
+         * each id once. Duplicates made the Nexon Plug installer stop its search early and miss
+         * FOLDERID_ProgramData. */
+        for (k = 0; k < j; k++)
+            if (IsEqualGUID( &fm->ids[k], CSIDL_Data[i].id )) break;
+        if (k < j) continue;
+        fm->ids[j] = *CSIDL_Data[i].id;
+        j++;
     }
+    fm->num_ids = j;
     TRACE("found %u known folders\n", fm->num_ids);
     *ppv = &fm->IKnownFolderManager_iface;
 
