diff --git a/dlls/ntdll/thread.c b/dlls/ntdll/thread.c
index 3d1e6e0..868cd96 100644
--- a/dlls/ntdll/thread.c
+++ b/dlls/ntdll/thread.c
@@ -691,6 +691,14 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
 
     if (flags & 1)
     {
+        /* Ember: 콜백은 fls_section 을 놓고 부른다. 콜백(CRT _freefls 등)이 로더 잠금을 잡는 동안, 다른 스레드가
+         * 로더 잠금을 쥔 채(DllMain THREAD_ATTACH) FlsSetValue 로 fls_section 을 기다리면 교착이다.
+         * 실측(2026-09-24, 로아 FEX): fls_section 을 쥔 스레드 하나에 4개가 60초 넘게 막히고 loader_section 까지
+         * 얽혀 게임이 종료됐다. 먼저 잠금 안에서 (콜백, 인자) 쌍을 모으고 목록에서 뺀 뒤, 잠금 밖에서 호출한다. */
+        struct fls_call { PFLS_CALLBACK_FUNCTION callback; void *arg; };
+        struct fls_call stack_calls[64], *calls = stack_calls;
+        unsigned int ncalls = 0, cap = ARRAY_SIZE(stack_calls);
+
         lock_fls_data();
         for (i = 0; i < ARRAY_SIZE(fls->fls_data_chunks); ++i)
         {
@@ -701,24 +709,36 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
             for (index = 0; index < fls_chunk_size( i ); ++index)
             {
                 PFLS_CALLBACK_FUNCTION callback = fls_data.fls_callback_chunks[i]->callbacks[index].callback;
+                void *arg = fls->fls_data_chunks[i][index + 1];
 
-                if (!fls->fls_data_chunks[i][index + 1])
-                    continue;
-
-                if (callback && callback != (void *)~(ULONG_PTR)0)
+                if (!arg) continue;
+                fls->fls_data_chunks[i][index + 1] = NULL;
+                if (!callback || callback == (void *)~(ULONG_PTR)0) continue;
+                if (ncalls == cap)
                 {
-                    TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback,
-                            fls->fls_data_chunks[i][index + 1]);
-
-                    callback( fls->fls_data_chunks[i][index + 1] );
+                    struct fls_call *grown = RtlAllocateHeap( GetProcessHeap(), 0, cap * 2 * sizeof(*calls) );
+                    if (!grown) continue;
+                    memcpy( grown, calls, ncalls * sizeof(*calls) );
+                    if (calls != stack_calls) RtlFreeHeap( GetProcessHeap(), 0, calls );
+                    calls = grown;
+                    cap *= 2;
                 }
-                fls->fls_data_chunks[i][index + 1] = NULL;
+                calls[ncalls].callback = callback;
+                calls[ncalls].arg = arg;
+                ncalls++;
             }
         }
         /* Not using RemoveEntryList() as Windows does not zero list entry here. */
         fls->fls_list_entry.Flink->Blink = fls->fls_list_entry.Blink;
         fls->fls_list_entry.Blink->Flink = fls->fls_list_entry.Flink;
         unlock_fls_data();
+
+        for (i = 0; i < ncalls; ++i)
+        {
+            TRACE_(relay)("Calling FLS callback %p, arg %p.\n", calls[i].callback, calls[i].arg);
+            calls[i].callback( calls[i].arg );
+        }
+        if (calls != stack_calls) RtlFreeHeap( GetProcessHeap(), 0, calls );
     }
 
     if (flags & 2)
diff --git a/dlls/ntdll/threadpool.c b/dlls/ntdll/threadpool.c
index 4f707bd..b591f46 100644
--- a/dlls/ntdll/threadpool.c
+++ b/dlls/ntdll/threadpool.c
@@ -3068,6 +3068,27 @@ VOID WINAPI TpSetTimer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LO
        tp_object_submit( this, FALSE );
 }
 
+/***********************************************************************
+ *           TpSetTimerEx    (NTDLL.@)
+ *
+ * Ember: 11.18 에서(윈도우 8+ SetThreadpoolTimerEx 가 부른다). 이전에 설정돼 있었는지 돌려준다.
+ */
+BOOL WINAPI TpSetTimerEx( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LONG window_length )
+{
+    struct threadpool_object *this = impl_from_TP_TIMER( timer );
+    BOOL was_timer_set;
+
+    TRACE( "%p %p %lu %lu\n", timer, timeout, period, window_length );
+
+    /* timerqueue.cs 는 재진입 가능 — 읽기와 설정을 한 번에 */
+    RtlEnterCriticalSection( &timerqueue.cs );
+    was_timer_set = this->u.timer.timer_set;
+    TpSetTimer( timer, timeout, period, window_length );
+    RtlLeaveCriticalSection( &timerqueue.cs );
+
+    return was_timer_set;
+}
+
 /***********************************************************************
  *           TpSetWait    (NTDLL.@)
  */
diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 105a6cf..90a0f03 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -29,6 +29,9 @@
 #include <string.h>
 #include <limits.h>
 #include <time.h>
+#if (defined(__x86_64__) || defined(__i386__)) && !defined(__arm64ec__)
+#include <intrin.h>
+#endif
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -380,8 +383,133 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
 /******************************************************************************
  *  RtlQueryPerformanceCounter   [NTDLL.@]
  */
+/* Ember perfpush2: QueryPerformanceCounter 를 시스템 호출 없이 읽는다.
+ * Wine 은 매번 NtQueryPerformanceCounter(유닉스 쪽 mach_continuous_time)를 불러 로제타 58ns·FEX 21ns 가 들었다(timeGetTime 도 이 길).
+ *  - x86_64(로제타, CPUID 상표 "VirtualApple"): rdtsc 가 1GHz(mach 시계, 7ns) → rdtsc/100 + 치우침.
+ *  - ARM64/ARM64EC: cntvct_el0(24MHz, mach 시계의 바탕) → ×10⁷/cntfrq + 치우침.
+ * 치우침 = 유닉스 단조 시계 − 하드웨어 시계. 처음에 한 번 재고, user_shared_data->InterruptTime(서버가 16ms 마다 같은 단조 시계로 씀)보다
+ * 50ms 넘게 뒤지면(맥이 잠들었다 깨 연속 시계만 앞서 간 것) 다시 잰다 — 치우침은 늘기만 해서 값이 뒤로 가지 않는다.
+ * 처음 잴 때 두 번 맞춰 봐서 1us 넘게 어긋나면 옛 길(시스템 호출). EMBER_QPC=0 이면 옛 길. */
+#if defined(__x86_64__) || defined(__i386__) || defined(__aarch64__) || defined(__arm64ec__)
+static LONGLONG ember_qpc_bias;
+static int ember_qpc_mode;            /* 0 = 아직, 1 = 하드웨어 시계, -1 = 시스템 호출 */
+#if defined(__aarch64__) || defined(__arm64ec__)
+static ULONGLONG ember_qpc_freq, ember_qpc_mul;   /* 틱 = (cntvct × mul) >> 64, mul = 10⁷·2⁶⁴ / cntfrq */
+#endif
+
+static inline ULONGLONG ember_qpc_raw(void)
+{
+#if defined(__aarch64__) || defined(__arm64ec__)
+    ULONGLONG c;
+    __asm__ __volatile__( "isb" ::: "memory" );   /* 앞선 읽기보다 먼저 시계를 읽지 않게(스레드 간 단조성) */
+    c = __builtin_arm_rsr64( "cntvct_el0" );
+    return (ULONGLONG)(((unsigned __int128)c * ember_qpc_mul) >> 64);
+#else
+    return __rdtsc() / 100;
+#endif
+}
+
+static inline ULONGLONG ember_qpc_interrupt_time(void)
+{
+    ULONG high, low;
+    do
+    {
+        high = user_shared_data->InterruptTime.High1Time;
+        low = user_shared_data->InterruptTime.LowPart;
+    }
+    while (high != user_shared_data->InterruptTime.High2Time);
+    return (ULONGLONG)high << 32 | low;
+}
+
+static void ember_qpc_resync(void)
+{
+    LARGE_INTEGER c;
+    LONGLONG bias;
+    NtQueryPerformanceCounter( &c, NULL );
+    bias = c.QuadPart - (LONGLONG)ember_qpc_raw();
+    if (bias > ember_qpc_bias) ember_qpc_bias = bias;    /* 늘기만(뒤로 가지 않게) */
+}
+
+static void ember_qpc_init(void)
+{
+    int mode = -1;
+    WCHAR buf[4];
+    SIZE_T len = 0;
+
+    if (!RtlQueryEnvironmentVariable( NULL, L"EMBER_QPC", 9, buf, ARRAY_SIZE(buf), &len ) && len && buf[0] == '0')
+        mode = -1;
+    else
+    {
+#if defined(__aarch64__) || defined(__arm64ec__)
+        ember_qpc_freq = __builtin_arm_rsr64( "cntfrq_el0" );
+        if (ember_qpc_freq >= 1000000 && ember_qpc_freq > TICKSPERSEC)
+        {
+            ember_qpc_mul = (ULONGLONG)(((unsigned __int128)TICKSPERSEC << 64) / ember_qpc_freq);
+            mode = 1;
+        }
+#else
+        int regs[4];
+        char brand[49];
+        unsigned int i;
+        __cpuid( regs, 0x80000000 );
+        if ((unsigned int)regs[0] >= 0x80000004)
+        {
+            for (i = 0; i < 3; i++) __cpuid( (int *)(brand + 16 * i), 0x80000002 + i );
+            brand[48] = 0;
+            if (strstr( brand, "VirtualApple" )) mode = 1;
+        }
+#endif
+        if (mode > 0)
+        {
+            LARGE_INTEGER c;
+            LONGLONG d;
+            int k, ok = 0;
+            ember_qpc_bias = LLONG_MIN;
+            for (k = 0; k < 3; k++) ember_qpc_resync();   /* 사이에 선점되면 치우침이 작게 나온다 → 최댓값 */
+            {
+                /* 반올림 위상이 시스템 호출판과 달라 1틱 뒤지는 일이 있다(32비트 로제타에서 잦음) → 뒤진 만큼(최대 1us) 올린다 */
+                LONGLONG deficit = 0;
+                for (k = 0; k < 16; k++)
+                {
+                    NtQueryPerformanceCounter( &c, NULL );
+                    d = c.QuadPart - ((LONGLONG)ember_qpc_raw() + ember_qpc_bias);
+                    if (d > deficit) deficit = d;
+                }
+#if defined(__aarch64__) || defined(__arm64ec__)
+                /* 24MHz→100ns 양자화 경계가 유닉스 쪽(×125/3÷100)과 어긋나 드물게(0.1%) 1틱 뒤진다 — 한 틱 앞당겨 둔다(뒤쪽 여유는 늘 1틱 있음) */
+                if (!deficit) deficit = 1;
+#endif
+                if (deficit <= 10) ember_qpc_bias += deficit;
+            }
+            for (k = 0; k < 4 && !ok; k++)                 /* 맞는지 확인(한 번이라도 1us 안이면 통과) */
+            {
+                NtQueryPerformanceCounter( &c, NULL );
+                d = (LONGLONG)ember_qpc_raw() + ember_qpc_bias - c.QuadPart;
+                if (d <= 10 && d >= -10) ok = 1;
+            }
+            if (!ok) mode = -1;
+        }
+    }
+    ember_qpc_mode = mode;
+}
+#endif
+
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(__x86_64__) || defined(__i386__) || defined(__aarch64__) || defined(__arm64ec__)
+    if (__builtin_expect( !ember_qpc_mode, 0 )) ember_qpc_init();
+    if (ember_qpc_mode > 0)
+    {
+        LONGLONG v = (LONGLONG)ember_qpc_raw() + ember_qpc_bias;
+        if (__builtin_expect( v + 500000 < (LONGLONG)ember_qpc_interrupt_time(), 0 ))
+        {
+            ember_qpc_resync();
+            v = (LONGLONG)ember_qpc_raw() + ember_qpc_bias;
+        }
+        counter->QuadPart = v;
+        return TRUE;
+    }
+#endif
     NtQueryPerformanceCounter( counter, NULL );
     return TRUE;
 }
diff --git a/dlls/ntdll/unix/ember_hintnop.h b/dlls/ntdll/unix/ember_hintnop.h
new file mode 100644
index 0000000..a4e15a8
--- /dev/null
+++ b/dlls/ntdll/unix/ember_hintnop.h
@@ -0,0 +1,57 @@
+/* Rosetta hint-NOP compatibility decoder.
+ * Copyright 2026 Ember contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef EMBER_HINTNOP_H
+#define EMBER_HINTNOP_H
+
+/* Long mode only. Returns zero for incomplete, overlong or unsupported bytes.
+ * No effective address is evaluated and no operand memory is accessed.
+ */
+static unsigned int ember_hintnop_length( const unsigned char *instr, unsigned int available )
+{
+    unsigned int i = 0, mod, rm, sib_base = 0, displacement = 0;
+
+    if (available > 15) available = 15;
+    while (i < available)
+    {
+        switch (instr[i])
+        {
+        case 0x66: case 0x67: case 0xf2: case 0xf3:
+        case 0x2e: case 0x36: case 0x3e: case 0x26: case 0x64: case 0x65:
+            i++;
+            continue;
+        }
+        break;
+    }
+    /* Accept one REX, only immediately before the opcode. In compatibility
+     * mode these bytes are INC/DEC, hence the caller's CS check is essential.
+     */
+    if (i < available && instr[i] >= 0x40 && instr[i] <= 0x4f) i++;
+    if (available - i < 3 || instr[i] != 0x0f || instr[i + 1] < 0x18 || instr[i + 1] > 0x1f)
+        return 0;
+
+    mod = instr[i + 2] >> 6;
+    rm = instr[i + 2] & 7;
+    i += 3;
+    if (mod == 3) return i;
+
+    /* 67 changes 64-bit to 32-bit addressing, not 16-bit. Both have the
+     * same SIB/displacement lengths. rm=5,mod=0 is RIP-relative without
+     * 67 and EIP-relative with 67; SIB base=5,mod=0 always needs disp32.
+     * REX.B does not remove either disp32 escape.
+     */
+    if (rm == 4)
+    {
+        if (i == available) return 0;
+        sib_base = instr[i++] & 7;
+    }
+    if (!mod && (rm == 5 || (rm == 4 && sib_base == 5))) displacement = 4;
+    else if (mod == 1) displacement = 1;
+    else if (mod == 2) displacement = 4;
+
+    if (displacement > available - i) return 0;
+    return i + displacement;
+}
+
+#endif
diff --git a/dlls/ntdll/unix/ember_level_infinite.h b/dlls/ntdll/unix/ember_level_infinite.h
new file mode 100644
index 0000000..2fc8013
--- /dev/null
+++ b/dlls/ntdll/unix/ember_level_infinite.h
@@ -0,0 +1,171 @@
+/* Ember nikkefix-1025: original compatibility code; LGPL-2.1-or-later when
+ * integrated into Wine. Called in the spawn grandchild before exec/PE imports. */
+#ifndef EMBER_LEVEL_INFINITE_H
+#define EMBER_LEVEL_INFINITE_H
+#include <dirent.h>
+#include <limits.h>
+
+static int ember_li_member( const char *dir, const char *name, char *out, size_t cap )
+{
+    DIR *d = opendir( dir );
+    struct dirent *e;
+    int found = 0;
+    if (!d) return 0;
+    while ((e = readdir( d ))) if (!strcasecmp( e->d_name, name ))
+    {
+        int n = snprintf( out, cap, "%s/%s", dir, e->d_name );
+        found = n > 0 && (size_t)n < cap;
+        break;
+    }
+    closedir( d );
+    return found;
+}
+
+static int ember_li_i386( int fd )
+{
+    unsigned char dos[64], pe[6];
+    unsigned int off;
+    if (pread( fd, dos, sizeof(dos), 0 ) != sizeof(dos) || dos[0] != 'M' || dos[1] != 'Z') return 0;
+    off = dos[60] | dos[61] << 8 | dos[62] << 16 | (unsigned int)dos[63] << 24;
+    return off >= 64 && pread( fd, pe, sizeof(pe), off ) == sizeof(pe)
+        && !memcmp( pe, "PE\0\0\x4c\x01", sizeof(pe) );
+}
+
+static int ember_li_target( const char *image, char *dir, size_t cap )
+{
+    const char *base = strrchr( image, '/' ), *p;
+    char lower[256], tiny[PATH_MAX], proxy[PATH_MAX];
+    size_t i, n;
+    if (!base || (n = base - image) >= cap || strlen( base + 1 ) >= sizeof(lower)) return 0;
+    memcpy( dir, image, n ); dir[n] = 0;
+    for (i = 0; base[1+i]; i++) lower[i] = base[1+i] >= 'A' && base[1+i] <= 'Z' ? base[1+i] + 32 : base[1+i];
+    lower[i] = 0;
+    if (i < 4 || strcmp( lower + i - 4, ".exe" )) return 0;
+    if (!strcmp( lower, "nikke_miniloader.exe" ) || !strncmp( lower, "nikkeminiloader", 15 )) return 1;
+    if (strstr( lower, "miniloader" ) && ember_li_member( dir, "tiny_dl", tiny, sizeof(tiny) )
+        && ember_li_member( tiny, "VersionService.exe", proxy, sizeof(proxy) )) return 1;
+    p = strrchr( dir, '/' );
+    return p && !strcasecmp( p + 1, "Launcher" ) && strstr( lower, "launcher" )
+        && ember_li_member( dir, "VersionServiceProxy.dll", proxy, sizeof(proxy) );
+}
+
+static int ember_li_same( int a, int b )
+{
+    char aa[8192], bb[8192];
+    ssize_t n, m;
+    struct stat sa, sb;
+    if (fstat( a, &sa ) || fstat( b, &sb ) || !S_ISREG(sa.st_mode) || !S_ISREG(sb.st_mode)
+        || sa.st_size != sb.st_size || lseek( a, 0, SEEK_SET ) == -1 || lseek( b, 0, SEEK_SET ) == -1) return 0;
+    do
+    {
+        n = read( a, aa, sizeof(aa) ); m = read( b, bb, sizeof(bb) );
+        if (n < 0 || n != m || (n && memcmp( aa, bb, n ))) return 0;
+    } while (n);
+    return 1;
+}
+
+static int ember_li_prepare( const char *image, const char *asset )
+{
+    char dir[PATH_MAX], dest[PATH_MAX], tmp[PATH_MAX], buf[8192];
+    int imagefd = -1, src = -1, dst = -1, fd = -1, ok = 0;
+    ssize_t n, off, m;
+    struct stat st;
+    tmp[0] = 0;
+    if (!asset || !*asset || !ember_li_target( image, dir, sizeof(dir) )) return 0;
+    if ((imagefd = open( image, O_RDONLY | O_NOFOLLOW )) == -1 || !ember_li_i386( imagefd )) goto done;
+    if ((src = open( asset, O_RDONLY | O_NOFOLLOW )) == -1 || !ember_li_i386( src )
+        || fstat( src, &st ) || !S_ISREG(st.st_mode) || st.st_size > 16*1024*1024) goto done;
+    if (ember_li_member( dir, "version.dll", dest, sizeof(dest) ))
+    {
+        if ((dst = open( dest, O_RDONLY | O_NOFOLLOW )) != -1) ok = ember_li_same( src, dst );
+        goto done;
+    }
+    if ((size_t)snprintf( dest, sizeof(dest), "%s/version.dll", dir ) >= sizeof(dest)
+        || (size_t)snprintf( tmp, sizeof(tmp), "%s/.ember-li-XXXXXX", dir ) >= sizeof(tmp)) goto done;
+    if ((fd = mkstemp( tmp )) == -1 || fchmod( fd, 0644 ) || lseek( src, 0, SEEK_SET ) == -1) goto done;
+    while ((n = read( src, buf, sizeof(buf) )) > 0)
+        for (off = 0; off < n; off += m)
+            if ((m = write( fd, buf + off, n - off )) <= 0) goto done;
+    if (n < 0) goto done;
+    /* link is an atomic CREATE_NEW publication; a racing existing file wins. */
+    if (!link( tmp, dest )) ok = 1;
+    else if (errno == EEXIST && (dst = open( dest, O_RDONLY | O_NOFOLLOW )) != -1) ok = ember_li_same( src, dst );
+done:
+    if (imagefd != -1) close( imagefd );
+    if (src != -1) close( src );
+    if (dst != -1) close( dst );
+    if (fd != -1) close( fd );
+    if (*tmp) unlink( tmp );
+    return ok;
+}
+
+/* Preserve other names even in grouped clauses such as version,winhttp=b. */
+static char *ember_li_overrides( const char *base )
+{
+    char *copy = strdup( base ), *out = malloc( strlen(base) + 32 ), *clause, *next;
+    if (!copy || !out) { free(copy); free(out); return NULL; }
+    *out = 0;
+    for (clause = copy; clause; clause = next)
+    {
+        char *eq, *name, *comma, names[4096] = "";
+        if ((next = strchr( clause, ';' ))) *next++ = 0;
+        if (!(eq = strchr( clause, '=' ))) continue;
+        *eq++ = 0;
+        for (name = clause; name; name = comma)
+        {
+            char *end;
+            if ((comma = strchr( name, ',' ))) *comma++ = 0;
+            while (*name == ' ' || *name == '\t') name++;
+            end = name + strlen(name);
+            while (end > name && (end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+            if (!*name || !strcasecmp( name, "version" )) continue;
+            if (strlen(names) + strlen(name) + 2 >= sizeof(names)) { free(copy); free(out); return NULL; }
+            if (*names) strcat( names, "," );
+            strcat( names, name );
+        }
+        if (*names)
+        {
+            if (*out) strcat( out, ";" );
+            strcat( out, names ); strcat( out, "=" ); strcat( out, eq );
+        }
+    }
+    if (*out) strcat( out, ";" );
+    strcat( out, "version=n,b" );
+    free(copy);
+    return out;
+}
+
+static void ember_li_restore( void )
+{
+    /* Reset only our own inherited override before evaluating this child. */
+    if (getenv( "EMBER_LI_VERSION_ACTIVE" ))
+    {
+        const char *prior = getenv( "EMBER_LI_VERSION_BASE" );
+        if (prior && *prior) setenv( "WINEDLLOVERRIDES", prior, 1 );
+        else unsetenv( "WINEDLLOVERRIDES" );
+        unsetenv( "EMBER_LI_VERSION_ACTIVE" );
+        unsetenv( "EMBER_LI_VERSION_BASE" );
+        setenv( "EMBER_EXE_ENV_APPLIED", "1", 1 );
+    }
+ }
+
+static void ember_li_child( const char *image )
+{
+    const char *asset = getenv( "EMBER_LEVEL_INFINITE_PROXY" );
+    char *base, *overrides;
+    if (!asset || !*asset) return;
+    if (!ember_li_prepare( image, asset )) return;
+    base = strdup( getenv( "WINEDLLOVERRIDES" ) ? getenv( "WINEDLLOVERRIDES" ) : "" );
+    if (!base) return;
+    overrides = ember_li_overrides( base );
+    if (overrides)
+    {
+        setenv( "EMBER_LI_VERSION_BASE", base, 1 );
+        setenv( "EMBER_LI_VERSION_ACTIVE", "1", 1 );
+        setenv( "WINEDLLOVERRIDES", overrides, 1 );
+        setenv( "EMBER_EXE_ENV_APPLIED", "1", 1 );
+        free(overrides);
+    }
+    free(base);
+}
+#endif
diff --git a/dlls/ntdll/unix/ember_memstat.h b/dlls/ntdll/unix/ember_memstat.h
new file mode 100644
index 0000000..2efa014
--- /dev/null
+++ b/dlls/ntdll/unix/ember_memstat.h
@@ -0,0 +1,82 @@
+/* Ember-only Wine compatibility patch. LGPL-2.1-or-later; no upstream submission. */
+#ifndef EMBER_MEMSTAT_H
+#define EMBER_MEMSTAT_H
+
+#include <stdint.h>
+#include <string.h>
+
+struct ember_memstat
+{
+    uint64_t available_pages, committed_pages, limit_pages;
+};
+
+static inline uint64_t ember_memstat_min( uint64_t a, uint64_t b )
+{
+    return a < b ? a : b;
+}
+
+static inline uint64_t ember_memstat_add( uint64_t a, uint64_t b )
+{
+    return b > UINT64_MAX - a ? UINT64_MAX : a + b;
+}
+
+static inline int ember_memstat_enabled( const char *value )
+{
+    return !value || strcmp( value, "0" );
+}
+
+/* disk_available is zero on sampling failure. Keep a 4 GiB reserve and half
+ * the remaining free space. This projects growth, it does not reserve backing
+ * storage or reproduce a Windows current commit limit. */
+static inline struct ember_memstat ember_memstat_calculate( uint64_t ram, uint64_t available,
+        uint64_t swap, uint64_t swap_free, uint64_t disk_available, uint64_t page )
+{
+    const uint64_t reserve = UINT64_C(4) * 1024 * 1024 * 1024;
+    struct ember_memstat result = {0, 0, 0};
+    uint64_t committed, projected, growth, cap;
+
+    if (!page) return result;
+    available = ember_memstat_min( available, ram );
+    swap_free = ember_memstat_min( swap_free, swap );
+    /* Preserve Wine's one-page Titan Quest workaround, including its baseline
+     * committed count, when no swap is currently allocated. */
+    if (!swap) swap = page;
+    committed = ember_memstat_add( ram - available, swap - swap_free );
+    cap = ember_memstat_add( ram, ember_memstat_add( ram, ram ) );
+    growth = disk_available > reserve ? (disk_available - reserve) / 2 : 0;
+    projected = ember_memstat_min( cap, ember_memstat_add( swap, growth ) );
+    if (projected < swap) projected = swap;
+
+    /* SYSTEM_PERFORMANCE_INFORMATION uses ULONG page counts on every ABI. */
+    result.limit_pages = ember_memstat_min( ember_memstat_add( ram, projected ) / page, UINT32_MAX );
+    result.committed_pages = ember_memstat_min( committed / page, result.limit_pages );
+    result.available_pages = ember_memstat_min( available / page, UINT32_MAX );
+    return result;
+}
+
+#ifdef __APPLE__
+#include <errno.h>
+#include <sys/mount.h>
+
+static inline uint64_t ember_memstat_disk_available(void)
+{
+    struct statfs fs;
+
+    /* Modern macOS puts swap on the startup APFS VM volume. Never use the
+     * bottle, cwd or external build disk. Fail closed on access/query errors. */
+    if (!statfs( "/System/Volumes/VM", &fs ))
+    {
+        if (strcmp( fs.f_mntonname, "/System/Volumes/VM" )) return 0;
+    }
+    else
+    {
+        if (errno != ENOENT) return 0;
+        /* Older macOS, before a separate VM volume. */
+        if (statfs( "/private/var/vm", &fs )) return 0;
+    }
+    if ((fs.f_flags & MNT_RDONLY) || !fs.f_bsize) return 0;
+    if (fs.f_bavail > UINT64_MAX / fs.f_bsize) return 0;
+    return fs.f_bavail * (uint64_t)fs.f_bsize;
+}
+#endif
+#endif
diff --git a/dlls/ntdll/unix/ember_shield_adapter.h b/dlls/ntdll/unix/ember_shield_adapter.h
new file mode 100644
index 0000000..8cbb236
--- /dev/null
+++ b/dlls/ntdll/unix/ember_shield_adapter.h
@@ -0,0 +1,34 @@
+/* Thin Wine integration only. Policy and storage remain in EmberCore. */
+#ifndef EMBER_SHIELD_ADAPTER_H
+#define EMBER_SHIELD_ADAPTER_H
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <stdint.h>
+typedef int (*ember_shield_observer)(unsigned,int,const char *,unsigned,const void *,unsigned,uint64_t);
+static ember_shield_observer ember_shield_observer_fn;
+static pthread_once_t ember_shield_once = PTHREAD_ONCE_INIT;
+static void ember_shield_load(void)
+{
+    const char *path = getenv("EMBER_SHIELD_LIBRARY");
+    void *module;
+    if (!path || path[0] != '/' || !getenv("EMBER_SHIELD_EVENT_FILE")) return;
+    module = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (module) ember_shield_observer_fn = (ember_shield_observer)dlsym(module,"ember_shield_v1_observe");
+}
+static inline int ember_shield_observe(unsigned kind,int fd,const char *path,unsigned child,const void *address,unsigned len,uint64_t bytes)
+{
+    pthread_once(&ember_shield_once,ember_shield_load);
+    return ember_shield_observer_fn ? ember_shield_observer_fn(kind,fd,path,child,address,len,bytes) : 0;
+}
+static inline void ember_shield_registry(HANDLE key)
+{
+    union { KEY_NAME_INFORMATION info; char storage[4096]; } data;
+    ULONG needed; char text[1024]; unsigned i,n;
+    if (!ember_shield_observer_fn) { pthread_once(&ember_shield_once,ember_shield_load); if (!ember_shield_observer_fn) return; }
+    if (NtQueryKey(key,KeyNameInformation,&data,sizeof(data),&needed)) return;
+    n=data.info.NameLength/sizeof(WCHAR); if(n>=sizeof(text))n=sizeof(text)-1;
+    for(i=0;i<n;i++)text[i]=data.info.Name[i]<128?(char)data.info.Name[i]:'?';text[n]=0;
+    ember_shield_observe(2,-1,text,0,NULL,0,0);
+}
+#endif
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 832adfc..f7ffbf0 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1064,6 +1064,97 @@ static void add_dynamic_environment( WCHAR **env, SIZE_T *pos, SIZE_T *size )
 }
 
 
+/* Ember (liftenv 10-28): 이름 앞부분이 같은 변수 묶음을 유닉스 → 윈도우 환경으로 옮긴다.
+ * Ember Stoke(작업명 Lift: EMBER_LIFT·EMBER_LIFT_MODE·EMBER_LIFT_*)와 보간 바깥 광류(EMBER_FG_GUIDE·EMBER_FG_GUIDE_*)는
+ * DXMT d3d11·libEmberFG 가 윈도우 환경에서 읽는다. 아래 고정 목록은 정확한 이름만 보므로 새 키가 생길 때마다 빠졌다
+ * (Tone 10-08, Detail 10-22). 윈도우 쪽의 같은 접두어 값을 먼저 모두 지우고 유닉스 값으로 다시 채워 두 쪽 집합을 같게 한다
+ * — 규칙 줄의 빈 값(유닉스에서 지움)이 떠 있는 런처의 옛 값을 지우는 것도 그대로 이어진다.
+ * append_envW 의 이름 칸이 WCHAR[32] 라 31자를 넘는 이름은 건너뛴다. */
+static void ember_sync_pe_prefix( WCHAR **env, SIZE_T *pos, SIZE_T *size, const char *prefix )
+{
+    WCHAR prefixW[32], *p;
+    char nameA[32], **e;
+    const char *eq;
+    SIZE_T plen = strlen( prefix ), len;
+
+    if (!plen || plen >= ARRAY_SIZE(prefixW)) return;
+    ascii_to_unicode( prefixW, prefix, plen + 1 );
+    p = *env;
+    while (p < *env + *pos)
+    {
+        len = wcslen( p ) + 1;
+        if (!wcsnicmp( p, prefixW, plen ))
+        {
+            memmove( p, p + len, (*pos - (p + len - *env)) * sizeof(WCHAR) );
+            *pos -= len;
+        }
+        else p += len;
+    }
+    for (e = environ; e && *e; e++)
+    {
+        if (strncmp( *e, prefix, plen ) || !(eq = strchr( *e, '=' ))) continue;
+        if ((SIZE_T)(eq - *e) >= sizeof(nameA)) continue;
+        memcpy( nameA, *e, eq - *e );
+        nameA[eq - *e] = 0;
+        append_envA( env, pos, size, nameA, eq + 1 );
+    }
+}
+
+/* Ember: 부모(이미 떠 있는 스팀·배틀넷·STOVE)가 만든 윈도우 환경은 Ember 가 exec 직전에 유닉스 쪽에 입힌 게임별 규칙
+ * (ember_exe_env_child, process.c)을 모른다. 그러면 윈도우 쪽에서 설정을 읽는 변환기(DXMT 의 DXMT_CONFIG 등)가
+ * 옛 런처의 값을 받는다(2026-09-28 실측: 떠 있는 스팀으로 띄운 게임에 EMBER_FPS_LOG 가 안 닿음).
+ * EMBER_EXE_ENV_FILE 로 규칙이 입혀진 프로세스에서만, 아래 이름들의 유닉스 값을 윈도우 환경에 그대로 옮긴다(없으면 지운다). */
+static void ember_sync_pe_environment( WCHAR **env, SIZE_T *pos, SIZE_T *size )
+{
+    static const char *names[] = { "DXMT_CONFIG", "DXMT_METALFX_SPATIAL_SWAPCHAIN", "DXVK_CONFIG_FILE",
+                                   "DXVK_HUD", "EMBER_FPS_LOG", "EMBER_FG_LOG", "EMBER_FG_MODE",
+                                   "EMBER_LOW_LATENCY", "EMBER_DRAWABLES", "EMBER_FG_QUEUE_GUARD", "EMBER_FG_PROBE",
+                                   /* (coremove 10-08) Ember Tone·Flare: DXMT 연결부는 윈도우 환경에서 읽는다 — 앱 규칙 줄이 있어도
+                                    * 떠 있는 STOVE·스팀이 띄운 게임(로아 등)엔 안 닿아 AI 화질·자동 HDR 이 꺼져 있었다 */
+                                   "EMBER_NEURAL", "EMBER_NEURAL_STRENGTH", "EMBER_NEURAL_RES", "EMBER_NEURAL_MODEL",
+                                   "EMBER_NEURAL_UNITS", "EMBER_NEURAL_GUARD", "EMBER_NEURAL_LOG",
+                                   "EMBER_AUTOHDR", "EMBER_AUTOHDR_STRENGTH", "EMBER_AUTOHDR_PEAK", "EMBER_AUTOHDR_GAMMA",
+                                   "EMBER_AUTOHDR_LOG",
+                                   /* (fexcompat1 10-08) 앱이 규칙 파일(.ember-exe-env)에 적는 값 중 윈도우 쪽(DXMT PE·kernelbase)이 읽는 나머지 —
+                                    * 보간 세부(박자·가드·링·VRR·MC·최소 fps…)·DXMT 박자(EMBER_D11_PACE)·CEF 인자(kernelbase 가 자식 CEF 에 붙임) */
+                                   "EMBER_D11_PACE", "EMBER_VSYNC_TRACE", "EMBER_FG_CADENCE", "EMBER_FG_DUMP", "EMBER_FG_DUMP_AT",
+                                   "EMBER_FG_DUMP_COUNT", "EMBER_FG_GUARD_MODE", "EMBER_FG_MAX_COST", "EMBER_FG_MC", "EMBER_FG_MC_MIN_FPS",
+                                   "EMBER_FG_MIN_FPS", "EMBER_FG_PRE_UPSCALE", "EMBER_FG_RING", "EMBER_FG_VRR", "EMBER_FG_GAME_CAP",
+                                   "EMBER_FG_NN", "EMBER_FG_NN_AUTO", "EMBER_D3DM_FG_LOG", "EMBER_D3DM_FG_MODE", "EMBER_MODELS_DIR",
+                                   "EMBER_RETINA_SCALE", "EMBER_UP_AI", "EMBER_CEF_EXE", "EMBER_CEF_ARGS", "WINEDEBUG",
+                                   "WINEDLLOVERRIDES", "EMBER_LEVEL_INFINITE_PROXY",
+                                   "EMBER_LI_VERSION_BASE", "EMBER_LI_VERSION_ACTIVE" };
+    unsigned int i;
+
+    if (!getenv( "EMBER_EXE_ENV_FILE" ) || !getenv( "EMBER_EXE_ENV_APPLIED" )) return;
+    for (i = 0; i < ARRAY_SIZE(names); i++) append_envA( env, pos, size, names[i], getenv( names[i] ) );
+    /* (liftenv 10-28) 접두어 묶음 — EMBER_EXE_ENV_KEYS 가 없는 규칙(시험용 줄·옛 앱)에서도 닿게 */
+    ember_sync_pe_prefix( env, pos, size, "EMBER_LIFT" );
+    ember_sync_pe_prefix( env, pos, size, "EMBER_FG_GUIDE" );
+
+    /* Ember: rules may contain explicit profile/game keys beyond the legacy list.
+     * Import only names recorded by the matching rule, never the whole host env.
+     * Empty rule values were unset in process.c; propagate those deletions too. */
+    {
