+/***********************************************************************
+ *           handle_hint_nop
+ *
+ * Rosetta rejects register forms of the reserved 0f 18..1f hint space.
+ * Decode the complete instruction without touching its operand memory.
+ * Keep TF and non-long-mode execution on the existing exception path.
+ */
+static BOOL handle_hint_nop( ucontext_t *sigcontext )
+{
+    const void *rip = (const void *)RIP_sig(sigcontext);
+    BYTE instr[15];
+    unsigned int available, length;
+
+    if (!is_rosetta2 || !ember_hintnop_enabled || CS_sig(sigcontext) != cs64_sel ||
+        (EFL_sig(sigcontext) & 0x100)) return FALSE;
+    available = virtual_uninterrupted_read_memory( rip, instr, sizeof(instr) );
+    if (!(length = ember_hintnop_length( instr, available ))) return FALSE;
+
+    RIP_sig(sigcontext) += length;
+    if (InterlockedIncrement64( &ember_hintnop_count ) == 1)
+        WARN_(seh)( "Rosetta 힌트 NOP 건너뜀 rip=%p len=%u\n", rip, length );
+    leave_handler( sigcontext );
+    return TRUE;
+}
