+/* Ember: ReadConsoleInputExA/W(Wine 11.18 에서 들어온 API). CX 에는 스텁이라 부르면 튕겼다.
+ * 콘솔 드라이버를 바꾸지 않고 기존 Peek/Read 로: NOREMOVE → Peek, NOWAIT 이고 쌓인 입력이 없으면 0개로 즉시 돌아온다. */
+#define EMBER_CONSOLE_READ_NOREMOVE 0x0001
+#define EMBER_CONSOLE_READ_NOWAIT   0x0002
+
+BOOL WINAPI ReadConsoleInputExW( HANDLE handle, INPUT_RECORD *buffer, DWORD length, DWORD *count, WORD flags )
+{
+    if (flags & EMBER_CONSOLE_READ_NOREMOVE) return PeekConsoleInputW( handle, buffer, length, count );
+    if (flags & EMBER_CONSOLE_READ_NOWAIT)
+    {
+        DWORD pending = 0;
+        if (!GetNumberOfConsoleInputEvents( handle, &pending )) return FALSE;
+        if (!pending)
+        {
+            if (count) *count = 0;
+            return TRUE;
+        }
+    }
+    return ReadConsoleInputW( handle, buffer, length, count );
+}
+
+BOOL WINAPI ReadConsoleInputExA( HANDLE handle, INPUT_RECORD *buffer, DWORD length, DWORD *count, WORD flags )
+{
+    if (flags & EMBER_CONSOLE_READ_NOREMOVE) return PeekConsoleInputA( handle, buffer, length, count );
+    if (flags & EMBER_CONSOLE_READ_NOWAIT)
+    {
+        DWORD pending = 0;
+        if (!GetNumberOfConsoleInputEvents( handle, &pending )) return FALSE;
+        if (!pending)
+        {
+            if (count) *count = 0;
+            return TRUE;
+        }
+    }
+    return ReadConsoleInputA( handle, buffer, length, count );
+}
diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
