+static inline void rect_round_from_gp_rect_f(RECT *rc, const GpRectF *rect)
+{
+    rc->left = rgn_round(rect->X);
+    rc->top = rgn_round(rect->Y);
+    rc->right = rgn_round(rect->X + rect->Width);
+    rc->bottom = rgn_round(rect->Y + rect->Height);
+}
