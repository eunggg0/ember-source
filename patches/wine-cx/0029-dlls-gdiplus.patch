+static size_t grow_capacity_geometric(size_t capacity, size_t max_capacity, size_t count)
+{
+    size_t new_capacity = max(4, capacity);
+    while (new_capacity < count && new_capacity <= max_capacity / 2)
+        new_capacity *= 2;
+    if (new_capacity < count)
+        return max_capacity;
+    return new_capacity;
+}
