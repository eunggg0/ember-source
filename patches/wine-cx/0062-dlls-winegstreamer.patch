diff --git a/dlls/winegstreamer/wg_media_type.c b/dlls/winegstreamer/wg_media_type.c
index b5ce04e..7696413 100644
--- a/dlls/winegstreamer/wg_media_type.c
+++ b/dlls/winegstreamer/wg_media_type.c
@@ -336,8 +336,69 @@ static void init_caps_from_video_mpeg(GstCaps *caps, const struct mpeg_video_for
     gst_caps_set_simple(caps, "parsed", G_TYPE_BOOLEAN, TRUE, NULL);
 }
 
+/* Ember: VfW 시절 AVI 코덱(ir50_32 가 VfW 드라이버로 받는다) — MJPEG, MS MPEG-4 v1~3, MPEG-4 ASP(DivX·XviD). */
+static BOOL init_caps_from_video_fourcc(GstCaps *caps, const GUID *subtype, const MFVIDEOFORMAT *format, UINT format_size)
+{
+    GUID base = *subtype;
+    DWORD fcc;
+    base.Data1 = 0;
+    if (!IsEqualGUID(&base, &MFVideoFormat_Base)) return FALSE;
+    fcc = subtype->Data1;
+    { /* 글자만 대문자로(숫자는 그대로 — 0x20 을 지우면 '4' 가 깨진다) */
+        unsigned int i; BYTE *b = (BYTE *)&fcc;
+        for (i = 0; i < 4; i++) if (b[i] >= 'a' && b[i] <= 'z') b[i] -= 0x20;
+    }
+
+    switch (fcc)
+    {
+    case MAKEFOURCC('M','J','P','G'): case MAKEFOURCC('A','V','R','N'): case MAKEFOURCC('A','V','D','J'):
+    case MAKEFOURCC('D','M','B','1'): case MAKEFOURCC('J','P','E','G'):
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "image/jpeg");
+        /* AVI 청크 하나 = JPEG 한 장. avdec_mjpeg 는 parsed 만 받는다(jpegparse 는 없다). */
+        gst_caps_set_simple(caps, "parsed", G_TYPE_BOOLEAN, TRUE, NULL);
+        return TRUE;
+    case MAKEFOURCC('M','P','G','4'): case MAKEFOURCC('M','P','4','1'):
+    case MAKEFOURCC('M','P','4','2'): case MAKEFOURCC('M','P','4','3'): case MAKEFOURCC('D','I','V','3'):
+    case MAKEFOURCC('D','I','V','4'): case MAKEFOURCC('M','P','G','3'):
+        init_caps_codec_data(caps, format + 1, format_size - sizeof(*format));
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "video/x-msmpeg");
+        gst_caps_set_simple(caps, "msmpegversion", G_TYPE_INT,
+                fcc == MAKEFOURCC('M','P','G','4') || fcc == MAKEFOURCC('M','P','4','1') ? 41
+                : fcc == MAKEFOURCC('M','P','4','2') ? 42 : 43, NULL);
+        return TRUE;
+    case MAKEFOURCC('D','I','V','X'): case MAKEFOURCC('D','X','5','0'): case MAKEFOURCC('X','V','I','D'):
+    case MAKEFOURCC('F','M','P','4'): case MAKEFOURCC('M','P','4','V'): case MAKEFOURCC('M','4','S','2'):
+    case MAKEFOURCC('M','P','4','S'): case MAKEFOURCC('3','I','V','2'): case MAKEFOURCC('D','I','V','5'):
+        init_caps_codec_data(caps, format + 1, format_size - sizeof(*format));
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "video/mpeg");
+        gst_caps_set_simple(caps, "mpegversion", G_TYPE_INT, 4, "systemstream", G_TYPE_BOOLEAN, FALSE, NULL);
+        return TRUE;
+    /* Ember(parity-avi): Indeo 3·4(avdec_indeo3/4), Intel H.263(avdec_h263i) — riff-media 와 같은 caps */
+    case MAKEFOURCC('I','V','3','1'): case MAKEFOURCC('I','V','3','2'): case MAKEFOURCC('I','V','4','1'):
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "video/x-indeo");
+        gst_caps_set_simple(caps, "indeoversion", G_TYPE_INT, fcc == MAKEFOURCC('I','V','4','1') ? 4 : 3, NULL);
+        return TRUE;
+    case MAKEFOURCC('C','V','I','D'): /* Ember(parity-avi): VfW 경로(ir50_32)는 FourCC 를 대문자로 넘긴다 */
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "video/x-cinepak");
+        return TRUE;
+    case MAKEFOURCC('I','2','6','3'):
+        gst_structure_remove_field(gst_caps_get_structure(caps, 0), "format");
+        gst_structure_set_name(gst_caps_get_structure(caps, 0), "video/x-intel-h263");
+        gst_caps_set_simple(caps, "variant", G_TYPE_STRING, "intel", NULL);
+        return TRUE;
+    }
+    return FALSE;
+}
+
 static void init_caps_from_video_subtype(GstCaps *caps, const GUID *subtype, const void *format, UINT format_size)
 {
+    if (init_caps_from_video_fourcc(caps, subtype, format, format_size))
+        return;
     if (IsEqualGUID(subtype, &MFVideoFormat_CVID))
         return init_caps_from_video_cinepak(caps, format, format_size);
     if (IsEqualGUID(subtype, &MFVideoFormat_H264))
diff --git a/dlls/winegstreamer/wg_parser.c b/dlls/winegstreamer/wg_parser.c
