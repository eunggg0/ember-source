     TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
 
+    if (!type)
+    {
+        /* Ember: NULL 은 형식 지우기(DMO 와 같다). 전에는 check_media_type 이 NULL 을 읽어 튕겼다. */
