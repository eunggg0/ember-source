+    EMBER_FCC_GUID('I','2','6','3'), EMBER_FCC_GUID('C','V','I','D'),
+};
 static const GUID *const iv50_decoder_input_types[] =
 {
     &MFVideoFormat_IV50,
+    &ember_vfw_types[0], &ember_vfw_types[1], &ember_vfw_types[2], &ember_vfw_types[3], &ember_vfw_types[4],
