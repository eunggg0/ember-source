+/* winemac encodes host input methods with 0xe000 in the high word.
+ * Additional layouts for the same language can use the low bits of that word. */
+static inline BOOL is_mac_korean_ime_layout( HKL hkl )
+{
+    return (HIWORD(hkl) & 0xf000) == 0xe000 &&
+           LOWORD(hkl) == MAKELANGID(LANG_KOREAN, SUBLANG_DEFAULT);
+}
