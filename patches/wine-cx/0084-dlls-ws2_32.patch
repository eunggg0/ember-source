diff --git a/dlls/ws2_32/socket.c b/dlls/ws2_32/socket.c
index d4223e9..43554ba 100644
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -33,6 +33,9 @@
 WINE_DEFAULT_DEBUG_CHANNEL(winsock);
 WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
+/* ember_netfast.h 는 TRACE 를 쓰므로 디버그 채널 선언 뒤에 둔다 */
+#include "ember_netfast.h"
+
 #define TIMEOUT_INFINITE _I64_MAX
 
 #define u64_from_user_ptr(ptr) ((ULONGLONG)(uintptr_t)(ptr))
@@ -1262,6 +1265,15 @@ int WINAPI closesocket( SOCKET s )
     return 0;
 }
 
+static BOOL is_mhy(void)
+{
+    WCHAR enabled[2], disabled[2];
+    return GetEnvironmentVariableW( L"WINE_ENABLE_DISCONNECT", enabled, ARRAY_SIZE(enabled) ) == 1 &&
+           enabled[0] == '1' &&
+           !(GetEnvironmentVariableW( L"WINE_DISABLE_DISCONNECT", disabled, ARRAY_SIZE(disabled) ) == 1 &&
+             disabled[0] == '1');
+}
+
 
 /***********************************************************************
  *      connect   (ws2_32.4)
@@ -1272,9 +1284,23 @@ int WINAPI connect( SOCKET s, const struct sockaddr *addr, int len )
     IO_STATUS_BLOCK io;
     HANDLE sync_event;
     NTSTATUS status;
+    static LONG disconnect_once;
+
+    /* DWProton 0ca19edf5: first connection refusal, explicit opt-in only. */
+    if (is_mhy() && !InterlockedCompareExchange( &disconnect_once, 1, 0 ))
+    {
+        WSASetLastError( WSAECONNREFUSED );
+        return SOCKET_ERROR;
+    }
 
     TRACE( "socket %#Ix, addr %s, len %d\n", s, debugstr_sockaddr(addr), len );
 
+    if (!addr && len)
+    {
+        SetLastError( WSAEFAULT );
+        return -1;
+    }
+
     if (!(sync_event = get_sync_event())) return -1;
 
     if (!(params = malloc( sizeof(*params) + len )))
@@ -1284,7 +1310,8 @@ int WINAPI connect( SOCKET s, const struct sockaddr *addr, int len )
     }
     params->addr_len = len;
     params->synchronous = TRUE;
-    memcpy( params + 1, addr, len );
+    if (len)
+        memcpy( params + 1, addr, len );
 
     status = NtDeviceIoControlFile( (HANDLE)s, sync_event, NULL, NULL, &io, IOCTL_AFD_WINE_CONNECT,
                                     params, sizeof(*params) + len, NULL, 0 );
@@ -3879,6 +3906,51 @@ int WINAPI WSAAsyncSelect( SOCKET s, HWND window, UINT message, LONG mask )
     return status ? -1 : 0;
 }
 
+static BOOL is_need_timeout_fix(void)
+{
+    WCHAR enabled[2];
+    return GetEnvironmentVariableW( L"WINE_ENABLE_TIMEOUT_FIX", enabled, ARRAY_SIZE(enabled) ) == 1 &&
+           enabled[0] == '1';
+}
+
+static void fix_curl_timeout(void)
+{
+    static LONG count;
+    static const BYTE timeout_buf[] = {0x60, 0xea, 0x00, 0x00, 0x60, 0xea, 0x00, 0x00};
+    HANDLE heap;
+    BYTE *data;
+    PROCESS_HEAP_ENTRY entry;
+
+    if (!is_need_timeout_fix() || InterlockedIncrement( &count ) > 2)
+        return;
+
+    TRACE("HACK: WSACreateEvent fixing curl timeout :xdd:\n");
+
+    heap = GetProcessHeap();
+    HeapLock(heap);
+
+    entry.lpData = NULL;
+    entry.wFlags = PROCESS_HEAP_REGION;
+
+    while (HeapWalk(heap, &entry))
+    {
+        if (entry.cbData < 4)
+            continue;
+        if (!(entry.wFlags & PROCESS_HEAP_ENTRY_BUSY))
+            continue;
+
+        data = entry.lpData;
+        if (data[0] == 0xAD && data[1] == 0xDB && data[2] == 0xDE && data[3] == 0xC0)
+        {
+            if (entry.cbData < 0x300)
+                continue;
+            memcpy(data + 0x2f8, timeout_buf, sizeof(timeout_buf));
+            TRACE("HACK: WSACreateEvent adjusted curl timeout to 60000ms in memory at %p\n", data + 0x2f8);
+        }
+    }
+
+    HeapUnlock(heap);
+}
 
 /***********************************************************************
  *      WSACreateEvent          (WS2_32.31)
@@ -3889,6 +3961,8 @@ WSAEVENT WINAPI WSACreateEvent(void)
     /* Create a manual-reset event, with initial state: unsignaled */
     TRACE("\n");
 
+    fix_curl_timeout();
+
     return CreateEventW(NULL, TRUE, FALSE, NULL);
 }
 
@@ -4055,6 +4129,7 @@ SOCKET WINAPI WSASocketW(int af, int type, int protocol,
         CloseHandle(handle);
         return INVALID_SOCKET;
     }
+    ember_netfast_socket_defaults( ret, af, type, protocol );
     WSASetLastError(0);
     return ret;
 }
