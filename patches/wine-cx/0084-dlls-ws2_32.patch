From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 84/95] dlls-ws2_32: Ember changes

Base: CrossOver 26.3.0 FOSS sources/wine
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/ws2_32/ember_netfast.h b/dlls/ws2_32/ember_netfast.h
new file mode 100644
index 0000000..e134a40
--- /dev/null
+++ b/dlls/ws2_32/ember_netfast.h
@@ -0,0 +1,52 @@
+/* Ember Link socket defaults. Independently implemented from public APIs.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Included after ws2_32_private.h; uses the existing AFD socket-option path.
+ */
+#ifndef EMBER_NETFAST_H
+#define EMBER_NETFAST_H
+
+static void ember_netfast_socket_defaults( SOCKET socket, int family, int type, int protocol )
+{
+    WCHAR value[2];
+    DWORD saved_error;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    int enabled = 1, sndbuf;
+
+    if ((family != AF_INET && family != AF_INET6) || type != SOCK_STREAM || protocol != IPPROTO_TCP)
+        return;
+
+    /* Read the calling Windows process environment, never shared wineserver state.
+     * Only the exact value "1" opts in. Do not cache: child exe rules and explicit
+     * process environment changes must remain independent within a bottle.
+     */
+    saved_error = GetLastError();
+    if (GetEnvironmentVariableW( L"EMBER_NETFAST", value, ARRAY_SIZE(value) ) == 1 && value[0] == '1')
+    {
+        status = NtDeviceIoControlFile( (HANDLE)socket, NULL, NULL, NULL, &io,
+                IOCTL_AFD_WINE_SET_TCP_NODELAY, &enabled, sizeof(enabled), NULL, 0 );
+        if (status) WARN( "Ember Link: TCP_NODELAY unavailable, status %#lx\n", status );
+    }
+    /* Research-only opt-in: bound a larger send queue, never enlarge it.
+     * This is independent of NODELAY and must be measured under queue pressure.
+     * Logical Winsock buffer values are not host queue occupancy measurements.
+     */
+    if (GetEnvironmentVariableW( L"EMBER_NET_SNDBUF_16K", value, ARRAY_SIZE(value) ) == 1 && value[0] == '1')
+    {
+        status = NtDeviceIoControlFile( (HANDLE)socket, NULL, NULL, NULL, &io,
+                IOCTL_AFD_WINE_GET_SO_SNDBUF, NULL, 0, &sndbuf, sizeof(sndbuf) );
+        if (!status && sndbuf > 16384)
+        {
+            sndbuf = 16384;
+            status = NtDeviceIoControlFile( (HANDLE)socket, NULL, NULL, NULL, &io,
+                    IOCTL_AFD_WINE_SET_SO_SNDBUF, &sndbuf, sizeof(sndbuf), NULL, 0 );
+        }
+        if (status) WARN( "Ember Link research: send buffer unavailable, status %#lx\n", status );
+    }
+    SetLastError( saved_error );
+    /* Best effort, once at creation. A game's later setsockopt wins. No payload,
+     * ACK, traffic-class, timer, thread-priority, or system-wide changes.
+     * Send-buffer research is separately opt-in above; default remains unchanged.
+     */
+}
+#endif
