@@ -2235,6 +2235,56 @@ static inline struct console *impl_from_IWineMSHTMLConsole(IWineMSHTMLConsole *i
 
 DISPEX_IDISPATCH_IMPL(console, IWineMSHTMLConsole, impl_from_IWineMSHTMLConsole(iface)->dispex)
 
+
+/* Ember (2026-10-07 launch4): show what pages print to console.* in the Wine log (fixme+mshtml), so blank web UIs
+ * (installers, launchers) can be diagnosed. Only the first argument is available here. */
+static void console_print_arg(const char *func, VARIANT *v)
+{
+    if(!v || V_VT(v) == VT_ERROR || V_VT(v) == VT_EMPTY) {
+        FIXME("console.%s()\n", func);
+        return;
+    }
+    if(V_VT(v) == VT_BSTR) {
+        FIXME("console.%s(%s)\n", func, debugstr_w(V_BSTR(v)));
+        return;
+    }
+    if(V_VT(v) == VT_DISPATCH && V_DISPATCH(v)) {
+        static const WCHAR *props[] = { L"message", L"stack", L"name" };
+        IDispatchEx *dispex;
+        unsigned i;
+        if(SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(v), &IID_IDispatchEx, (void**)&dispex))) {
+            for(i = 0; i < ARRAY_SIZE(props); i++) {
+                DISPPARAMS noargs = {NULL, NULL, 0, 0};
+                VARIANT r, str;
+                DISPID id;
+                BSTR n = SysAllocString(props[i]);
+                HRESULT hres = IDispatchEx_GetDispID(dispex, n, fdexNameCaseSensitive, &id);
+                SysFreeString(n);
+                if(FAILED(hres)) continue;
+                V_VT(&r) = VT_EMPTY;
+                if(FAILED(IDispatchEx_InvokeEx(dispex, id, LOCALE_NEUTRAL, DISPATCH_PROPERTYGET, &noargs, &r, NULL, NULL)))
+                    continue;
+                V_VT(&str) = VT_EMPTY;
+                if(SUCCEEDED(VariantChangeType(&str, &r, 0, VT_BSTR)))
+                    FIXME("console.%s(object).%s = %s\n", func, debugstr_w(props[i]), debugstr_wn(V_BSTR(&str), 1500));
+                VariantClear(&str);
+                VariantClear(&r);
+            }
+            IDispatchEx_Release(dispex);
+        }
+        return;
+    }
+    {
+        VARIANT str;
+        V_VT(&str) = VT_EMPTY;
+        if(SUCCEEDED(VariantChangeType(&str, v, 0, VT_BSTR)))
+            FIXME("console.%s(%s)\n", func, debugstr_w(V_BSTR(&str)));
+        else
+            FIXME("console.%s(vt %d)\n", func, V_VT(v));
+        VariantClear(&str);
+    }
+}
