From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 60/74] dlls-winecoreaudio.drv: Ember changes

Base: CrossOver 26.3.0 FOSS source, sources/wine (crossover-sources-26.3.0.tar.gz)
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/winecoreaudio.drv/coreaudio.c b/dlls/winecoreaudio.drv/coreaudio.c
index 3199887..d353d84 100644
--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -48,6 +48,7 @@
 #include <AudioToolbox/AudioConverter.h>
 #include <AudioUnit/AudioUnit.h>
 #include <os/lock.h>
+#include <dispatch/dispatch.h>
 
 #undef LoadResource
 #undef CompareString
@@ -500,6 +501,88 @@ static OSStatus ca_capture_cb(void *user, AudioUnitRenderActionFlags *flags,
     return noErr;
 }
 
+/* Ember: 입력(마이크) 장치를 AudioUnit 에 거는 호출에 시간 제한을 둔다.
+ * 다른 앱의 마이크 권한 창이 답 없이 떠 있으면(예: 게임 번들이 마이크를 요청한 채 꺼짐) coreaudiod 가 그 마이크 장치의
+ * 작업을 붙잡아, 이 맥의 모든 프로세스에서 입력 장치에 kAudioOutputUnitProperty_CurrentDevice 를 거는 호출이 끝없이 멈춘다
+ * (2026-10-03 실측: 네이티브 시험 프로그램도 30초+). 스팀은 시작 때 모든 엔드포인트의 IsFormatSupported 를 물어서
+ * IPC 스레드가 여기서 멈추고 "BMainLoop stalled → fatal stalled cross-thread pipe" 로 꺼졌다.
+ * 제한 시간 안에 안 끝나면 그 장치는 지금 못 쓰는 것으로 돌려준다. 멈춘 호출은 작업 스레드에 남기고, 끝나면 그쪽이 정리한다. */
+struct ember_capdev_job
+{
+    AudioComponentInstance unit;
+    AudioDeviceID dev;
+    OSStatus sc;
+    dispatch_semaphore_t done;
+    int state; /* 0 진행 중, 1 끝남, 2 기다리던 쪽이 포기 */
+};
+
+static void ember_capdev_work(void *ctx)
+{
+    struct ember_capdev_job *job = ctx;
+    job->sc = AudioUnitSetProperty(job->unit, kAudioOutputUnitProperty_CurrentDevice,
+                                   kAudioUnitScope_Global, 0, &job->dev, sizeof(job->dev));
+    if (__atomic_exchange_n(&job->state, 1, __ATOMIC_ACQ_REL) == 2)
+    {
+        AudioComponentInstanceDispose(job->unit);
+        dispatch_release(job->done);
+        free(job);
+        return;
+    }
+    dispatch_semaphore_signal(job->done);
+}
+
+static OSStatus ember_set_capture_device(AudioComponentInstance unit, AudioDeviceID dev, BOOL *abandoned)
+{
+    static int timeout_ms = -1;
+    struct ember_capdev_job *job;
+    OSStatus sc;
+
+    *abandoned = FALSE;
+    if (timeout_ms < 0)
+    {
+        const char *e = getenv("EMBER_CAPTURE_DEV_TIMEOUT_MS");
+        timeout_ms = e ? atoi(e) : 3000;
+    }
+    if (timeout_ms == 0)
+        return AudioUnitSetProperty(unit, kAudioOutputUnitProperty_CurrentDevice,
+                                    kAudioUnitScope_Global, 0, &dev, sizeof(dev));
+
+    /* 한 번 멈춘 장치는 30초 동안 곧바로 '못 씀'으로 — 같은 장치를 여러 형식으로 물을 때마다 3초씩 쌓이지 않게 */
+    {
+        static AudioDeviceID wedged_dev;
+        static uint64_t wedged_until;
+        uint64_t now = dispatch_time(DISPATCH_TIME_NOW, 0);
+        if (__atomic_load_n(&wedged_dev, __ATOMIC_ACQUIRE) == dev && now < __atomic_load_n(&wedged_until, __ATOMIC_ACQUIRE))
+        {
+            *abandoned = TRUE;
+            AudioComponentInstanceDispose(unit);
+            return kAudioHardwareNotRunningError;
+        }
+        if (!(job = calloc(1, sizeof(*job))))
+            return AudioUnitSetProperty(unit, kAudioOutputUnitProperty_CurrentDevice,
+                                        kAudioUnitScope_Global, 0, &dev, sizeof(dev));
+        job->unit = unit;
+        job->dev = dev;
+        job->done = dispatch_semaphore_create(0);
+        dispatch_async_f(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), job, ember_capdev_work);
+        if (dispatch_semaphore_wait(job->done, dispatch_time(DISPATCH_TIME_NOW, (int64_t)timeout_ms * 1000000)) != 0 &&
+            __atomic_exchange_n(&job->state, 2, __ATOMIC_ACQ_REL) == 0)
+        {
+            /* 작업 스레드가 끝나면 유닛·작업을 치운다 */
+            __atomic_store_n(&wedged_until, dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), __ATOMIC_RELEASE);
+            __atomic_store_n(&wedged_dev, dev, __ATOMIC_RELEASE);
+            ERR_(winediag)("Capture device %u did not respond in %d ms (a microphone permission prompt may be pending); "
+                           "treating it as unavailable.\n", (unsigned int)dev, timeout_ms);
+            *abandoned = TRUE;
+            return kAudioHardwareNotRunningError;
+        }
+        sc = job->sc;
+        dispatch_release(job->done);
+        free(job);
+        return sc;
+    }
+}
+
 static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid)
 {
     AudioComponentInstance unit;
@@ -507,9 +590,24 @@ static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID ad
     AudioComponentDescription desc;
     OSStatus sc;
 
+    BOOL follow_default = FALSE;
+
+    /* Ember: 기본 출력 장치로 연 재생 스트림은 기본 장치 변경을 따라가게 한다.
+     * 원본은 장치 번호에 고정해서, 게임 중 이어폰을 꽂아도 소리가 스피커로 계속 나갔다(2026-09-24 사용자 보고).
+     * 윈도우에서는 기본 장치로 연 소리가 새 기본 장치로 옮겨 간다. DefaultOutput 유닛은 macOS 가 알아서 옮겨 준다. */
+    if(dataflow == eRender){
+        AudioObjectPropertyAddress addr = { kAudioHardwarePropertyDefaultOutputDevice,
+                                            kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain };
+        AudioDeviceID default_id = 0;
+        UInt32 size = sizeof(default_id);
+        if(AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &default_id) == noErr &&
+           default_id == adevid)
+            follow_default = TRUE;
+    }
+
     memset(&desc, 0, sizeof(desc));
     desc.componentType = kAudioUnitType_Output;
-    desc.componentSubType = kAudioUnitSubType_HALOutput;
+    desc.componentSubType = follow_default ? kAudioUnitSubType_DefaultOutput : kAudioUnitSubType_HALOutput;
     desc.componentManufacturer = kAudioUnitManufacturer_Apple;
 
     if(!(comp = AudioComponentFindNext(NULL, &desc))){
@@ -545,8 +643,15 @@ static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID ad
         }
     }
 
-    sc = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_CurrentDevice,
-            kAudioUnitScope_Global, 0, &adevid, sizeof(adevid));
+    if(follow_default) return unit;   /* DefaultOutput 유닛에는 장치를 지정하지 않는다 */
+
+    if(dataflow == eCapture){
+        BOOL abandoned;
+        sc = ember_set_capture_device(unit, adevid, &abandoned);
+        if(abandoned) return NULL;   /* 멈춘 호출이 끝나면 작업 스레드가 unit 을 치운다 */
+    }else
+        sc = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_CurrentDevice,
+                kAudioUnitScope_Global, 0, &adevid, sizeof(adevid));
     if(sc != noErr){
         WARN("Couldn't set audio unit device\n");
         AudioComponentInstanceDispose(unit);
@@ -742,6 +847,13 @@ static NTSTATUS unix_create_stream(void *args)
         goto end;
     }
 
+    /* Ember: 표본율·블록 정렬·채널 0 은 지원 안 하는 형식. 전에는 독점 모드에서 period_frames 0 으로 나눠
+     * 유닉스 쪽 0나누기로 프로세스가 통째로 죽었다(예외를 게임에 돌려줄 수 없는 자리). */
+    if(!stream->fmt->nSamplesPerSec || !stream->fmt->nBlockAlign || !stream->fmt->nChannels){
+        params->result = AUDCLNT_E_UNSUPPORTED_FORMAT;
+        goto end;
+    }
+
     stream->period = params->period;
     stream->period_frames = muldiv(params->period, stream->fmt->nSamplesPerSec, 10000000);
     stream->dev_id = dev_id_from_device(params->device);
@@ -750,7 +862,7 @@ static NTSTATUS unix_create_stream(void *args)
     stream->share = params->share;
 
     stream->bufsize_frames = muldiv(params->duration, stream->fmt->nSamplesPerSec, 10000000);
-    if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
+    if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE && stream->period_frames)
         stream->bufsize_frames -= stream->bufsize_frames % stream->period_frames;
 
     if(!(stream->unit = get_audiounit(stream->flow, stream->dev_id))){
@@ -1130,6 +1242,10 @@ static NTSTATUS unix_is_format_supported(void *args)
     const AudioDeviceID dev_id = dev_id_from_device(params->device);
 
     unit = get_audiounit(params->flow, dev_id);
+    if(!unit){
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        return STATUS_SUCCESS;
+    }
 
     converter = NULL;
     params->result = ca_setup_audiounit(params->flow, unit, params->fmt_in, &dev_desc, &converter);
