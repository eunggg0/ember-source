diff --git a/dlls/winecoreaudio.drv/ember_capture_adapter.h b/dlls/winecoreaudio.drv/ember_capture_adapter.h
new file mode 100644
index 0000000..1ae58d1
--- /dev/null
+++ b/dlls/winecoreaudio.drv/ember_capture_adapter.h
@@ -0,0 +1,221 @@
+/* LGPL-2.1-or-later. Included after capture-facing native functions.
+ * Every pointer crossing a timeout belongs to the job; no caller/guest buffer
+ * is accessed after return. The render entry points retain their old path. */
+#include "ember_capture_job.h"
+extern int ember_capture_authorized(int request);
+
+enum ember_capture_op { EMBER_ENDPOINTS, EMBER_FORMAT, EMBER_MIX, EMBER_PERIOD, EMBER_CREATE };
+struct ember_capture_call
+{
+    struct ember_capture_job job;
+    enum ember_capture_op op;
+    char *device;
+    WAVEFORMATEX *format;
+    WAVEFORMATEXTENSIBLE mix;
+    REFERENCE_TIME def_period, min_period;
+    UINT32 channels;
+    stream_handle stream;
+    union
+    {
+        struct get_endpoint_ids_params endpoints;
+        struct is_format_supported_params format;
+        struct get_mix_format_params mix;
+        struct get_device_period_params period;
+        struct create_stream_params create;
+    } p;
+};
+
+static void ember_capture_free_stream(void *ctx)
+{
+    struct coreaudio_stream *stream = ctx;
+    /* This stream was never handed to Wine: no timer, local/guest buffer or
+     * playing=true. Stop/dispose finishes callbacks before freeing their user. */
+    if (stream->unit)
+    {
+        AudioOutputUnitStop(stream->unit);
+        AudioComponentInstanceDispose(stream->unit);
+    }
+    if (stream->converter) AudioConverterDispose(stream->converter);
+    free(stream->cap_buffer);
+    free(stream->wrap_buffer);
+    free(stream->fmt);
+    free(stream);
+}
+
+static void ember_capture_call_destroy(struct ember_capture_job *base)
+{
+    struct ember_capture_call *call = (struct ember_capture_call *)base;
+    if (call->op == EMBER_CREATE && call->stream)
+        ember_capture_free_stream(handle_get_stream(call->stream));
+    if (call->op == EMBER_ENDPOINTS) free(call->p.endpoints.endpoints);
+    free(call->format);
+    free(call->device);
+    free(call);
+}
+
+static void ember_capture_call_work(struct ember_capture_job *base)
+{
+    struct ember_capture_call *call = (struct ember_capture_call *)base;
+    /* This preflight itself is inside the deadline. Discovery never prompts. */
+    if ((call->op == EMBER_FORMAT || call->op == EMBER_CREATE) &&
+        !ember_capture_authorized(call->op == EMBER_CREATE))
+    {
+        if (call->op == EMBER_ENDPOINTS) call->p.endpoints.result = S_OK;
+        return;
+    }
+    switch (call->op)
+    {
+    case EMBER_ENDPOINTS: unix_get_endpoint_ids_native(&call->p.endpoints); break;
+    case EMBER_FORMAT: unix_is_format_supported_native(&call->p.format); break;
+    case EMBER_MIX: unix_get_mix_format_native(&call->p.mix); break;
+    case EMBER_PERIOD: unix_get_device_period_native(&call->p.period); break;
+    case EMBER_CREATE: ember_create_capture_native(&call->p.create); break;
+    }
+}
+
+static struct ember_capture_call *ember_capture_call_new(enum ember_capture_op op, const char *device)
+{
+    struct ember_capture_call *call = calloc(1, sizeof(*call));
+    if (!call) return NULL;
+    call->op = op;
+    call->job.work = ember_capture_call_work;
+    call->job.destroy = ember_capture_call_destroy;
+    if (device && !(call->device = strdup(device))) { free(call); return NULL; }
+    return call;
+}
+
+static NTSTATUS unix_get_endpoint_ids(void *args)
+{
+    struct get_endpoint_ids_params *p = args;
+    struct ember_capture_call *call;
+    if (p->flow != eCapture) return unix_get_endpoint_ids_native(args);
+    p->num = p->default_idx = 0;
+    if (!(call = ember_capture_call_new(EMBER_ENDPOINTS, NULL))) { p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    call->p.endpoints = *p;
+    call->p.endpoints.result = AUDCLNT_E_DEVICE_INVALIDATED;
+    call->p.endpoints.endpoints = calloc(1, p->size ? p->size : 1);
+    if (!call->p.endpoints.endpoints) { free(call); p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    if (ember_capture_run(&call->job))
+    {
+        p->result = call->p.endpoints.result;
+        p->num = call->p.endpoints.num;
+        p->default_idx = call->p.endpoints.default_idx;
+        if (SUCCEEDED(p->result) && p->size) memcpy(p->endpoints, call->p.endpoints.endpoints, p->size);
+        p->size = call->p.endpoints.size;
+        ember_capture_claim(&call->job);
+    }
+    else p->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    ember_capture_release(&call->job);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS unix_is_format_supported(void *args)
+{
+    struct is_format_supported_params *p = args;
+    struct ember_capture_call *call;
+    if (p->flow != eCapture) return unix_is_format_supported_native(args);
+    if (!(call = ember_capture_call_new(EMBER_FORMAT, p->device))) { p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    if (!(call->format = clone_format(p->fmt_in))) { free(call->device); free(call); p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    call->p.format = *p;
+    call->p.format.device = call->device;
+    call->p.format.fmt_in = call->format;
+    call->p.format.result = AUDCLNT_E_DEVICE_INVALIDATED;
+    if (ember_capture_run(&call->job))
+    {
+        p->result = call->p.format.result;
+        ember_capture_claim(&call->job);
+    }
+    else p->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    ember_capture_release(&call->job);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS unix_get_mix_format(void *args)
+{
+    struct get_mix_format_params *p = args;
+    struct ember_capture_call *call;
+    if (p->flow != eCapture) return unix_get_mix_format_native(args);
+    if (!(call = ember_capture_call_new(EMBER_MIX, p->device))) { p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    call->p.mix = *p;
+    call->p.mix.device = call->device;
+    call->p.mix.fmt = &call->mix;
+    call->p.mix.result = AUDCLNT_E_DEVICE_INVALIDATED;
+    if (ember_capture_run(&call->job))
+    {
+        p->result = call->p.mix.result;
+        if (SUCCEEDED(p->result)) *p->fmt = call->mix;
+        ember_capture_claim(&call->job);
+    }
+    else p->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    ember_capture_release(&call->job);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS unix_get_device_period(void *args)
+{
+    struct get_device_period_params *p = args;
+    struct ember_capture_call *call;
+    if (p->flow != eCapture) return unix_get_device_period_native(args);
+    if (!(call = ember_capture_call_new(EMBER_PERIOD, p->device))) { p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    call->p.period = *p;
+    call->p.period.device = call->device;
+    call->p.period.def_period = p->def_period ? &call->def_period : NULL;
+    call->p.period.min_period = p->min_period ? &call->min_period : NULL;
+    call->p.period.result = AUDCLNT_E_DEVICE_INVALIDATED;
+    if (ember_capture_run(&call->job))
+    {
+        p->result = call->p.period.result;
+        if (SUCCEEDED(p->result))
+        {
+            if (p->def_period) *p->def_period = call->def_period;
+            if (p->min_period) *p->min_period = call->min_period;
+        }
+        ember_capture_claim(&call->job);
+    }
+    else p->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    ember_capture_release(&call->job);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS unix_create_stream(void *args)
+{
+    struct create_stream_params *p = args;
+    struct ember_capture_call *call;
+    struct coreaudio_stream *stream;
+    SIZE_T size;
+    if (p->flow != eCapture) return unix_create_stream_render(args);
+    if (!(call = ember_capture_call_new(EMBER_CREATE, p->device))) { p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    if (!(call->format = clone_format(p->fmt))) { free(call->device); free(call); p->result = E_OUTOFMEMORY; return STATUS_SUCCESS; }
+    call->p.create = *p;
+    call->p.create.name = NULL; /* Not used by the native preparation. */
+    call->p.create.device = call->device;
+    call->p.create.fmt = call->format;
+    call->p.create.stream = &call->stream;
+    call->p.create.channel_count = &call->channels;
+    call->p.create.result = AUDCLNT_E_DEVICE_INVALIDATED;
+    if (ember_capture_run(&call->job))
+    {
+        p->result = call->p.create.result;
+        if (SUCCEEDED(p->result))
+        {
+            stream = handle_get_stream(call->stream);
+            /* Wine VM operations remain on the Wine caller thread, never GCD.
+             * Until handover playing is false, so callbacks do not use local_buffer. */
+            size = stream->bufsize_frames * stream->fmt->nBlockAlign;
+            if (NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, zero_bits,
+                                        &size, MEM_COMMIT, PAGE_READWRITE)) p->result = E_OUTOFMEMORY;
+            else
+            {
+                silence_buffer(stream, stream->local_buffer, stream->bufsize_frames);
+                *p->channel_count = call->channels;
+                *p->stream = call->stream;
+                call->stream = 0; /* Native resources now belong to Wine. */
+            }
+        }
+        /* An allocation failure keeps ownership in the asynchronous destructor. */
+        if (!call->stream) ember_capture_claim(&call->job);
+    }
+    else p->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    ember_capture_release(&call->job);
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winecoreaudio.drv/ember_capture_job.h b/dlls/winecoreaudio.drv/ember_capture_job.h
new file mode 100644
index 0000000..02cdccf
--- /dev/null
+++ b/dlls/winecoreaudio.drv/ember_capture_job.h
@@ -0,0 +1,91 @@
+/* LGPL-2.1-or-later. Bounded native capture transactions, micwedge2-1023.
+ * A caller and a worker each own a reference. A completion signal is not a
+ * transfer of the worker reference: it must survive signal() returning.
+ * No cancellation of CoreAudio, no stack/guest pointers in a queued job. */
+#include <dispatch/dispatch.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+struct ember_capture_job
+{
+    dispatch_semaphore_t done;
+    void (*work)(struct ember_capture_job *);
+    void (*destroy)(struct ember_capture_job *);
+    unsigned int refs;
+    int holds_gate;
+};
+static int ember_capture_busy;
+static uint64_t ember_capture_retry_ms;
+
+static uint64_t ember_capture_now_ms(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static void ember_capture_destroy(void *ctx)
+{
+    struct ember_capture_job *job = ctx;
+    int holds_gate = job->holds_gate;
+    dispatch_semaphore_t done = job->done;
+    job->destroy(job); /* May block disposing an abandoned unit. Worker only. */
+    if (done) dispatch_release(done);
+    if (holds_gate) __atomic_store_n(&ember_capture_busy, 0, __ATOMIC_RELEASE);
+}
+
+static void ember_capture_release(struct ember_capture_job *job)
+{
+    if (__atomic_sub_fetch(&job->refs, 1, __ATOMIC_ACQ_REL) == 0)
+        dispatch_async_f(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), job, ember_capture_destroy);
+}
+
+static void ember_capture_work(void *ctx)
+{
+    struct ember_capture_job *job = ctx;
+    ember_capture_native_thread = 1;
+    job->work(job);
+    ember_capture_native_thread = 0;
+    dispatch_semaphore_signal(job->done);
+    ember_capture_release(job);
+}
+
+/* On success the caller owns the outputs until release(). On failure it must
+ * not read them. Always release the initial caller reference, even on failure.
+ * busy remains set through abandoned cleanup, bounding stuck work to one job.
+ * Successful callers detach their outputs before opening the gate. */
+static int ember_capture_run(struct ember_capture_job *job)
+{
+    int expected = 0, timeout_ms = 3000;
+    char *end;
+    const char *env = getenv("EMBER_CAPTURE_DEV_TIMEOUT_MS");
+    long value;
+    job->refs = 1;
+    if (env && *env)
+    {
+        value = strtol(env, &end, 10);
+        if (!*end && value > 0 && value <= 3000) timeout_ms = value;
+    }
+    job->done = dispatch_semaphore_create(0);
+    if (!job->done) return 0;
+    if (ember_capture_now_ms() < __atomic_load_n(&ember_capture_retry_ms, __ATOMIC_ACQUIRE) ||
+        !__atomic_compare_exchange_n(&ember_capture_busy, &expected, 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+        return 0;
+    job->holds_gate = 1;
+    __atomic_add_fetch(&job->refs, 1, __ATOMIC_RELAXED);
+    dispatch_async_f(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), job, ember_capture_work);
+    if (dispatch_semaphore_wait(job->done, dispatch_time(DISPATCH_TIME_NOW, (int64_t)timeout_ms * 1000000)))
+    {
+        __atomic_store_n(&ember_capture_retry_ms, ember_capture_now_ms() + 30000, __ATOMIC_RELEASE);
+        return 0;
+    }
+    return 1;
+}
+
+static void ember_capture_claim(struct ember_capture_job *job)
+{
+    /* The worker has signalled and no longer accesses outputs/holds_gate. */
+    job->holds_gate = 0;
+    __atomic_store_n(&ember_capture_busy, 0, __ATOMIC_RELEASE);
+}
