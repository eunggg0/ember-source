+/* Ember: EMBER_SURFACE_DUMP=<폴더> 면 창 표면을 BMP 로 남긴다(창마다 1초에 한 번, 덮어씀). 맥 화면이 잠겨 있거나 창이 가려져
+ * 있어도 Wine 이 그린 그대로를 본다 — 화면 캡처 없이 런처 UI 를 확인하는 진단용. 변수가 없으면 비용 0. */
+static void ember_dump_surface(HWND hwnd, const BITMAPINFO *info, const void *bits)
+{
+    static int state = -1; static const char *dir;
+    static struct { HWND hwnd; ULONGLONG t; } last[32];
+    char path[1024]; BITMAPFILEHEADER fh; ULONGLONG now = NtGetTickCount(); int i, slot = -1, fd;
+    if (state < 0) { dir = getenv( "EMBER_SURFACE_DUMP" ); state = dir && *dir; }
+    if (!state || !bits || info->bmiHeader.biBitCount != 32) return;
+    for (i = 0; i < 32; i++) if (last[i].hwnd == hwnd || (!last[i].hwnd && slot < 0)) { slot = i; if (last[i].hwnd == hwnd) break; }
+    if (slot < 0) slot = (UINT_PTR)hwnd % 32;
+    if (last[slot].hwnd == hwnd && now - last[slot].t < 1000) return;
+    last[slot].hwnd = hwnd; last[slot].t = now;
+    snprintf( path, sizeof(path), "%s/surface-%d-%p.bmp", dir, (int)getpid(), hwnd );
+    if ((fd = open( path, O_WRONLY | O_CREAT | O_TRUNC, 0644 )) < 0) return;
+    memset( &fh, 0, sizeof(fh) );
+    fh.bfType = 0x4d42; fh.bfOffBits = sizeof(fh) + sizeof(BITMAPINFOHEADER);
+    fh.bfSize = fh.bfOffBits + info->bmiHeader.biSizeImage;
+    write( fd, &fh, sizeof(fh) ); write( fd, &info->bmiHeader, sizeof(BITMAPINFOHEADER) );
+    write( fd, bits, info->bmiHeader.biSizeImage );
+    close( fd );
+}
