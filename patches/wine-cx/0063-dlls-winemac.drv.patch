+            !CGSizeEqualToSize(drawable_extent, extent) ||
+            format != layer.pixelFormat ||
+            backing_scale != window.backingScaleFactor) {
+            fprintf(stderr, "ember-d3dm-link: host epoch=%llu->%llu reason=surface "
+                "window=%d display=%u->%u flags=0x%x->0x%x source=%ux%u->%ux%u "
+                "drawable=%.0fx%.0f->%.0fx%.0f format=%lu->%lu scale=%.2f->%.2f refresh_changed=%d\n",
+                (unsigned long long)surface.epoch, (unsigned long long)(surface.epoch + 1),
+                observed_window != window, surface.display_id, display, surface.flags, flags,
+                surface.width, surface.height, source_width, source_height,
+                drawable_extent.width, drawable_extent.height, extent.width, extent.height,
+                (unsigned long)format, (unsigned long)layer.pixelFormat, backing_scale, window.backingScaleFactor, refresh_changed);
