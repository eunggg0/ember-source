+         * plus the current ARMING producer CB are required at the Present boundary. */
+        [self updateIdle:NO];
+    }
+}
+/* Direct real-layer bypass has no EmberFGLayer::pending counter. Preserve its
+ * ownership barrier until both rendering and compositor acknowledgement finish.
+ * Metal error completion may omit presented; late/duplicate callbacks cannot
+ * release the barrier twice. Every callback uses the same adapter monitor. */
+- (void)trackLegacyPresentation:(id<MTLCommandBuffer>)cb drawable:(id<CAMetalDrawable>)drawable {
+    @synchronized (self) { ++legacy_gpu; }
+    __block BOOL gpu_done = NO, presented_done = NO, released = NO;
+    void (^finish)(void) = ^{
+        if (!released && gpu_done && presented_done) {
+            released = YES;
+            --legacy_gpu;
+        }
+    };
+    if (@available(macOS 10.15.4, *)) {
+        [drawable addPresentedHandler:^(id<MTLDrawable> shown) {
+            (void)shown;
+            @synchronized (self) { presented_done = YES; finish(); }
+        }];
+    } else {
+        /* This OS cannot create the macOS 14 link service. Keep legacy GPU
+         * lifetime tracking, but permanently disable ownership admission. */
+        presented_done = YES;
+        [self retire];
+    }
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        @synchronized (self) {
+            gpu_done = YES;
+            if (done.status == MTLCommandBufferStatusError) presented_done = YES;
+            finish();
+        }
+    }];
+}
+- (void)trackLegacy:(id<MTLCommandBuffer>)cb {
+    @synchronized (self) { ++legacy_gpu; }
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        @synchronized (self) { --legacy_gpu; }
+    }];
+}
+- (BOOL)consume:(id<MTLCommandBuffer>)cb texture:(id<MTLTexture>)texture
+          time:(double)now legacyIdle:(BOOL)idle {
+    @synchronized (self) {
+        ++meter_inputs;
+        if (retired) { /* Closing windows never re-arm; let an already drained host finish. */
+            return state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_DRAINING;
+        }
+        /* Source-sized candidates are independent of the final drawable extent.
+         * Revoke once per input change; the main-thread probe logs every gate. */
+        BOOL compatible = texture && texture.pixelFormat == layer.pixelFormat &&
+            texture.device == cb.device && cb.device == layer.device && texture.sampleCount == 1;
+        if (source_width != texture.width || source_height != texture.height ||
+            source_format != texture.pixelFormat || source_compatible != compatible) {
+            source_width = (uint32_t)texture.width; source_height = (uint32_t)texture.height;
+            source_format = texture.pixelFormat; source_compatible = compatible;
+            [self revokeReason:"source-format/device/extent"];
+        }
+        if (!probe_pending) {
+            probe_pending = YES;
+            dispatch_async(dispatch_get_main_queue(), ^{ [self probe]; });
+        }
+        if (needs_probe || !source_compatible || !ember_fg_dl_source_fits(source_width, source_height, source_format, fg_link_output8())) {
+            if (state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_DRAINING) {
+                [self schedulePoll]; return YES;
+            }
+            [self trackLegacy:cb]; return NO;
+        }
+        if (service && (device != cb.device || service_format != layer.pixelFormat)) {
+            [self revokeReason:"service-device/format"];
+            if (!fg_link_api.destroy(service)) { [self schedulePoll]; return YES; }
+            service = NULL; state = EMBER_FG_DL_LEGACY; [device release]; device = nil;
+        }
+        if (!service && !needs_probe && surface.flags ==
+            (EMBER_FG_DL_FULLSCREEN | EMBER_FG_DL_VISIBLE | EMBER_FG_DL_SDR)) {
+            const char *m = getenv("EMBER_FG_DISPLAY_LINK_MULT");
+            if (!m || !*m) m = getenv("EMBER_FG_ANE_MULT");
+            ember_fg_dl_config c = { .size = sizeof(c), .multiplier = m && !strcmp(m, "4") ? 4 : 3,
+                .device = (ember_fg_handle)(uintptr_t)cb.device, .layer = (ember_fg_handle)(uintptr_t)layer };
+            service = fg_link_api.create(&c);
+            if (service) {
+                device = [cb.device retain]; service_format = layer.pixelFormat; create_failed = NO;
+                fprintf(stderr, "ember-d3dm-link: service created multiplier=%u source=%ux%u drawable=%.0fx%.0f\n",
+                    c.multiplier, source_width, source_height, drawable_extent.width, drawable_extent.height);
+            } else if (!create_failed) {
+                create_failed = YES;
+                fprintf(stderr, "ember-d3dm-link: service create failed (OS/device/queues/pipeline/engine); legacy\n");
+            }
+        }
+        [self updateIdle:idle];
+        if ((state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_ARMING) &&
+            (!(surface.flags & EMBER_FG_DL_SDR) ||
+             !ember_fg_dl_layer_sdr(layer.pixelFormat, layer.wantsExtendedDynamicRangeContent, layer.colorspace))) {
+            metadata_paused = YES;
+            [self schedulePoll];
+            return YES; /* Grace holds ownership but submits neither link nor legacy. */
+        }
+        if (metadata_paused) {
+            metadata_paused = NO;
+            if (state == EMBER_FG_DL_ARMING) {
+                arming_barrier_recorded = metadata_rearming; arming_superseded = 0; arming_started = now;
+            }
+        }
+        if (state == EMBER_FG_DL_LINK_OWNS) {
+            uint64_t lease = 0;
+            ember_fg_dl_source s = { .size = sizeof(s), .epoch = surface.epoch, .sequence = ++sequence,
+                .command_buffer = (ember_fg_handle)(uintptr_t)cb, .texture = (ember_fg_handle)(uintptr_t)texture,
+                .source_ns = (int64_t)(now * 1e9) };
+            if (fg_link_api.enqueue(service, &s, &lease)) {
+                ++lease_accepted;
+                const char *log = getenv("EMBER_FG_LOG");
+                if (log && !strcmp(log, "1")) fprintf(stderr,
+                    "ember-d3dm-link: enqueue lease=%llu epoch=%llu seq=%llu\n",
+                    (unsigned long long)lease, (unsigned long long)s.epoch, (unsigned long long)s.sequence);
+            } else {
+                // D3DMetal may mutate the real layer between update and enqueue.
+                // Reobserve before treating that quiescent metadata rejection as
+                // a transport failure; a new epoch must rearm, never revoke.
+                [self updateIdle:NO];
+                if (surface.epoch != s.epoch || state != EMBER_FG_DL_LINK_OWNS ||
+                    !ember_fg_dl_layer_sdr(layer.pixelFormat, layer.wantsExtendedDynamicRangeContent, layer.colorspace)) {
+                    [self schedulePoll]; return YES;
+                }
+                // try_enqueue is explicitly nonblocking. Lock contention or
+                // bounded backpressure drops this source, not the ownership epoch.
+                // Service rejection reasons are reported in five-second stats.
+                [self schedulePoll];
+            }
+            return YES; /* The caller commits its own CB, including the snapshot. */
+        }
+        if (state == EMBER_FG_DL_DRAINING) { [self schedulePoll]; return YES; }
+        if (state == EMBER_FG_DL_ARMING && arming_barrier_recorded) {
+            if (metadata_rearming) {
+                [self schedulePoll];
+                return YES; // Old service readers drain without legacy presentation.
+            }
+            /* Continuing to legacy-present at 60fps while compositor feedback
+             * takes >16.7ms can keep pending permanently nonzero. Quiesce at most
+             * 8 source calls / 250ms, without waiting or presenting via link.
+             * The initial ARMING frame's CB remains part of the drain barrier. */
+            if (arming_superseded >= 8 || now - arming_started >= 0.250) {
+                fprintf(stderr, "ember-d3dm-link: arming drain budget exhausted superseded=%u; session legacy\n",
+                    arming_superseded);
+                [self retire];
+                return state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_DRAINING;
+            }
+            ++arming_superseded;
+            fprintf(stderr, "ember-d3dm-link: arming superseded original=%u legacy_gpu=%llu; no present\n",
+                arming_superseded, (unsigned long long)legacy_gpu);
+            return YES;
+        }
+        if (state == EMBER_FG_DL_ARMING) arming_barrier_recorded = YES;
+        /* Must be inside this lock: a second Present cannot claim ownership
+         * before this ARMING frame's producer completion has been registered. */
+        [self trackLegacy:cb];
+        return NO;
+    }
+}
+- (void)retire {
+    @synchronized (self) {
+        if (retired) return;
+        fprintf(stderr, "ember-d3dm-link: adapter retired; revoke/drain to legacy\n");
+        retired = YES;
+        [prefetched release]; prefetched = nil;
+        [self revokeReason:"retire"];
+        [[NSNotificationCenter defaultCenter] removeObserver:self];
+        if (service) [self schedulePoll];
+        else objc_setAssociatedObject(layer, &fg_link_adapter_key, nil, OBJC_ASSOCIATION_RETAIN);
+    }
+}
+@end
+#endif
