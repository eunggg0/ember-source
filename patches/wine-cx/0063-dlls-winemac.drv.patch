+/* Ember: Dock 타일은 번들 정체(+Wine 접두사)마다 하나만 (EMBER_DOCK_ONE, 기본 켬, "0" 이면 예전처럼 창을 띄운 프로세스마다).
+ * 왜: transformProcessToForeground 가 창을 띄운 모든 프로세스를 보통 앱(Regular)으로 올려, 스팀을 켜면 Steam.exe(부트스트래퍼 창)와
+ * steamwebhelper.exe(실제 스팀 창)가 저마다 "Steam" 아이콘을 가졌다(2026-10-01 lsappinfo: Foreground 2개). 사용자는 런처·게임마다
+ * Dock 아이콘 하나를 원한다.
+ * 어떻게: 처음 창을 띄운 프로세스가 /tmp/.ember-dock-<uid>/<번들ID>@<접두사 dev-ino>.lock 에 flock 을 잡아 타일 주인(Regular)이
+ * 되고, 나머지는 Accessory(Dock·앱 전환기에 없음, 그래도 활성·키 창·키보드 입력은 된다)로 둔다. flock 은 프로세스가 죽으면 풀린다.
+ * 주인 넘기기: 주인이 아닌데 실제 창이 보이는 프로세스는 1.5초마다 잠금을 다시 시도하고, 못 잡으면 notify(3) "want" 를 보낸다.
+ * 주인이 3초 넘게 창이 없는데 want 를 받으면 놓는다(Accessory) → 창 가진 쪽이 잡는다. 아무도 원하지 않으면(트레이로 숨은 스팀)
+ * 주인이 타일을 그대로 가진다. 그래서 스팀은 부트스트래퍼(Steam.exe)가 먼저 잡았다가 창이 사라지면 steamwebhelper 로 넘어간다.
+ * 번들 ID 가 정확히 dev.eung.ember(= "런처를 따로 표시" 끔, Ember 본체 정체를 물려받음)면 Wine 쪽은 타일을 아예 갖지 않는다.
+ * 처음부터 Regular 로 뜬 프로세스(게임 모드 번들 주 실행파일)는 applicationDidFinishLaunching 에서 같은 규칙으로 다툰다. */
+#include <notify.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+
+static int ember_dock_state = -1;       /* -1 모름, 0 끔, 1 켬 */
+static BOOL ember_dock_noicon;          /* Ember 본체 정체 — 타일을 아예 갖지 않는다 */
+static BOOL ember_dock_started;         /* 한 번 앞 앱 준비(메뉴·App Nap)를 마쳤다 */
+static int ember_dock_fd = -1;          /* 타일 주인이면 flock 을 쥔 fd */
+static int ember_dock_token = -1;       /* notify "want" 토큰(notify_check 로 읽는다) */
+static int ember_dock_windowless;       /* 주인이 창 없이 지난 틱 수 */
+static char ember_dock_path[PATH_MAX];
+static char ember_dock_want[PATH_MAX];
+
+static BOOL ember_dock_enabled(void)
+{
+    const char* e;
+    NSString* bid;
+    const char* prefix;
+    struct stat st;
+    unsigned long long dev = 0, ino = 0;
+    char dir[64], bidc[256];
+    size_t i, n = 0;
+
+    if (ember_dock_state >= 0) return ember_dock_state;
+    ember_dock_state = 0;
+
+    e = getenv("EMBER_DOCK_ONE");
+    if (e && !strcmp(e, "0")) return NO;
+
+    bid = [[NSRunningApplication currentApplication] bundleIdentifier];
+    if (![bid length]) bid = [[NSBundle mainBundle] bundleIdentifier];
+    if (!([bid isEqualToString:@"dev.eung.ember"] || [bid hasPrefix:@"dev.eung.ember."])) return NO;
+    ember_dock_noicon = [bid isEqualToString:@"dev.eung.ember"];
+
+    for (i = 0; i < [bid length] && n < sizeof(bidc) - 1; i++)
+    {
+        unichar c = [bid characterAtIndex:i];
+        bidc[n++] = (isascii(c) && (isalnum(c) || c == '.' || c == '-' || c == '_')) ? (char)c : '_';
+    }
+    bidc[n] = 0;
+
+    /* wineserver 와 같은 열쇠: 접두사 디렉터리의 dev/ino. 같은 번들이라도 보틀이 다르면 따로. */
+    prefix = getenv("WINEPREFIX");
+    if (prefix && !stat(prefix, &st)) { dev = st.st_dev; ino = st.st_ino; }
+
+    snprintf(dir, sizeof(dir), "/tmp/.ember-dock-%u", (unsigned)getuid());
+    if (mkdir(dir, 0700) && errno != EEXIST) return NO;
+    if (lstat(dir, &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid()) return NO;
+
+    snprintf(ember_dock_path, sizeof(ember_dock_path), "%s/%s@%llx-%llx.lock", dir, bidc, dev, ino);
+    snprintf(ember_dock_want, sizeof(ember_dock_want), "dev.eung.ember.dock.want.%s@%llx-%llx", bidc, dev, ino);
+    if (notify_register_check(ember_dock_want, &ember_dock_token) == NOTIFY_STATUS_OK)
+    {
+        int dummy;
+        notify_check(ember_dock_token, &dummy);  /* 첫 호출은 늘 1 — 비운다 */
+    }
+    else
+        ember_dock_token = -1;
+
+    ember_dock_state = 1;
+    return YES;
+}
+
+/* 타일 잠금을 잡는다. 잠금 파일을 못 만들면 예전처럼 타일을 가진다(YES). */
+static BOOL ember_dock_try_claim(void)
+{
+    int fd;
+
+    if (ember_dock_noicon) return NO;
+    if (ember_dock_fd >= 0) return YES;
+    fd = open(ember_dock_path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return YES;
+    if (flock(fd, LOCK_EX | LOCK_NB))
+    {
+        close(fd);
+        return NO;
+    }
+    ember_dock_fd = fd;
+    ember_dock_windowless = 0;
+    return YES;
+}
+
+static void ember_dock_release(void)
+{
+    if (ember_dock_fd < 0) return;
+    flock(ember_dock_fd, LOCK_UN);  /* fork 뒤 exec 전 자식이 같은 fd 를 쥐고 있어도 풀리게 */
+    close(ember_dock_fd);
+    ember_dock_fd = -1;
+}
+
+static void ember_dock_set_owner(BOOL own)
+{
+    NSApplicationActivationPolicy want = own ? NSApplicationActivationPolicyRegular : NSApplicationActivationPolicyAccessory;
+    if ([NSApp activationPolicy] != want)
+        [NSApp setActivationPolicy:want];
+}
+
+/* 사용자가 실제로 보는 창이 있나: 보이거나 최소화된 WineWindow 중 화면에 걸친 32pt 이상. */
+static BOOL ember_dock_has_windows(void)
+{
+    NSArray* screens = [NSScreen screens];
+
+    for (NSWindow* w in [NSApp windows])
+    {
+        NSRect f;
+        BOOL onScreen = NO;
+
+        if (![w isKindOfClass:[WineWindow class]]) continue;
+        if ([w isMiniaturized]) return YES;
+        if (![w isVisible] || [w alphaValue] <= 0) continue;
+        f = [w frame];
+        if (f.size.width < 32 || f.size.height < 32) continue;
+        for (NSScreen* s in screens)
+            if (NSIntersectsRect(f, [s frame])) { onScreen = YES; break; }
+        if (onScreen) return YES;
+    }
+    return NO;
+}
+
+static void ember_dock_tick(void)
+{
+    BOOL hasWin = ember_dock_has_windows();
+    int wanted = 0;
+
+    if (ember_dock_token >= 0)
+        notify_check(ember_dock_token, &wanted);
+
+    if (ember_dock_fd >= 0)
+    {
+        if (hasWin)
+        {
+            ember_dock_windowless = 0;
+            return;
+        }
+        ember_dock_windowless++;
+        if (wanted && ember_dock_windowless >= 2)
+        {
+            /* 창 가진 형제에게 넘긴다. 그쪽이 다음 틱에 잡는다. */
+            ember_dock_set_owner(NO);
+            ember_dock_release();
+        }
+    }
+    else if (hasWin)
+    {
+        if (ember_dock_try_claim())
+            ember_dock_set_owner(YES);
+        else if (ember_dock_token >= 0)
+            notify_post(ember_dock_want);
+    }
+}
+
+/* 처음 앞 앱이 될 때: 잠금을 잡으면 Regular, 아니면 Accessory. 넘기기 타이머를 건다. */
+static void ember_dock_start(void)
+{
+    NSTimer* timer;
+
+    ember_dock_started = YES;
+    ember_dock_set_owner(ember_dock_try_claim());
+    if (ember_dock_noicon) return;
+
+    timer = [NSTimer timerWithTimeInterval:1.5 repeats:YES block:^(NSTimer* t){ ember_dock_tick(); }];
+    timer.tolerance = 0.5;
+    [[NSRunLoop mainRunLoop] addTimer:timer forMode:NSRunLoopCommonModes];
+}
+
+/* 앞 앱 준비를 마친 뒤 또 창을 띄울 때: 주인이 없으면 바로 잡고, 있으면 want 를 보낸다. */
+static void ember_dock_window_shown(void)
+{
+    if (ember_dock_noicon || ember_dock_fd >= 0) return;
+    if (ember_dock_try_claim())
+        ember_dock_set_owner(YES);
+    else if (ember_dock_token >= 0)
+        notify_post(ember_dock_want);
+}
+
+/* 게임 모드 번들(주 실행파일 = 로더 복사본)은 Info.plist 로 처음부터 Regular 다. 같은 게임 정체로 뜬 다른 프로세스
+ * (예: 스텔라 블레이드 데모의 crs-handler.exe, 2026-10-01 lsappinfo Foreground 2개)도 타일을 가지므로, 뜰 때 바로 다툰다:
+ * 먼저 뜬 쪽(보통 게임 본체)이 잡고 나머지는 Accessory. */
+static void ember_dock_launched(void)
+{
+    if (ember_dock_started) return;
+    if ([NSApp activationPolicy] != NSApplicationActivationPolicyRegular) return;
+    if (!ember_dock_enabled()) return;
+    ember_dock_start();
+}
+
+/* Dock 아이콘을 눌렀는데 주인에게 창이 없으면, 같은 정체에서 화면에 창이 가장 많은 형제 프로세스를 앞으로. */
+static void ember_dock_forward_reopen(void)
+{
+    NSRunningApplication* me = [NSRunningApplication currentApplication];
+    NSArray* sibs;
+    NSMutableDictionary* counts;
+    NSArray* list;
+    NSRunningApplication* best = nil;
+    NSInteger bestCount = 0;
+
+    if (ember_dock_state != 1 || ember_dock_fd < 0 || ember_dock_has_windows()) return;
+    sibs = [NSRunningApplication runningApplicationsWithBundleIdentifier:me.bundleIdentifier];
+    if ([sibs count] < 2) return;
+
+    counts = [NSMutableDictionary dictionary];
+    list = [(NSArray*)CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+                                                 kCGNullWindowID) autorelease];
+    for (NSDictionary* info in list)
+    {
+        NSNumber* pid = info[(id)kCGWindowOwnerPID];
+        if ([info[(id)kCGWindowLayer] integerValue] != 0 || !pid) continue;
+        counts[pid] = @([counts[pid] integerValue] + 1);
+    }
+    for (NSRunningApplication* app in sibs)
+    {
+        NSInteger c;
+        if ([app isEqual:me] || app.terminated) continue;
+        c = [counts[@(app.processIdentifier)] integerValue];
+        if (c > bestCount) { best = app; bestCount = c; }
+    }
+    if (!best) return;
+
+    if (@available(macOS 14.0, *))
+    {
+        [NSApp yieldActivationToApplication:best];
+        [best activateFromApplication:me options:NSApplicationActivateAllWindows];
+    }
+    else
+        [best activateWithOptions:NSApplicationActivateAllWindows];
+}
+
