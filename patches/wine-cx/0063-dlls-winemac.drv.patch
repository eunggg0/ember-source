+/***********************************************************************
+ *              macdrv_set_view_holes
+ *
+ * Ember(launch3, 2026-10-03): 윈도우에서는 WS_CLIPCHILDREN 부모의 스왑체인 위에 자식 창(GDI)이 보인다. 맥 드라이버는
+ * GPU 로 그리는 창(클라이언트 표면 = Metal/GL/Vulkan 뷰)을 창 표면 위 하위 뷰로 얹어서, 그 안의 GDI 자식 창
+ * (예: EA 앱 Qt 창 안의 CEF 로그인 화면)이 통째로 가려졌다. 자식 창 자리에 마스크 구멍을 내 아래 창 표면이 보이게 한다.
+ * 구멍이 없으면(대부분의 게임) 마스크가 있을 때만 걷어 낸다 — 레이어를 건드리지 않는다.
+ * 구멍 목록은 뷰에 붙여 두고(연관 객체), 그 안에 나중에 GPU 로 그리기 시작한 자식 뷰가 생기면 그 자리 구멍만 메운다.
+ */
+static char ember_holes_key;
+
+/* 메인 스레드. 뷰에 붙인 구멍 목록으로 마스크를 다시 만든다. WineContentView 는 isFlipped(위가 0)이고 그 레이어 좌표도
+ * 위가 0으로 그려진다(10-03 EA 실측: 뒤집으면 구멍이 아래위로 어긋나 제목 막대 자리에 창 표면이 비쳤다). */
+static void ember_apply_view_holes(NSView* view)
+{
+    NSArray* rects = objc_getAssociatedObject(view, &ember_holes_key);
+    CALayer* layer = [view layer];
+    CAShapeLayer* mask;
+    CGMutablePathRef path;
+    CGRect bounds;
+
+    if (!layer) return;
+    if (![rects count])
+    {
+        if ([layer mask]) [layer setMask:nil];
+        return;
+    }
+    bounds = [layer bounds];
+    mask = [CAShapeLayer layer];
+    path = CGPathCreateMutable();
+    CGPathAddRect(path, NULL, bounds);
+    for (NSValue* value in rects)
+        CGPathAddRect(path, NULL, NSRectToCGRect([value rectValue]));
+    [mask setFrame:bounds];
+    [mask setPath:path];
+    [mask setFillRule:kCAFillRuleEvenOdd];
+    [layer setMask:mask];
+    CGPathRelease(path);
+}
+
+void macdrv_set_view_holes(macdrv_view v, const CGRect *holes, int count)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    NSMutableArray* rects = nil;
+    int i;
+
+    if (count > 0)
+    {
+        rects = [NSMutableArray arrayWithCapacity:count];
+        for (i = 0; i < count; i++)
+            [rects addObject:[NSValue valueWithRect:NSRectFromCGRect(cgrect_mac_from_win(holes[i]))]];
+    }
+
+    OnMainThreadAsync(^{
+        if (!rects && !objc_getAssociatedObject(view, &ember_holes_key) && ![[view layer] mask]) return;
+        objc_setAssociatedObject(view, &ember_holes_key, rects, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        ember_apply_view_holes(view);
+    });
+}
+}
+
+/***********************************************************************
+ *              macdrv_view_fill_hole_for_subview
+ *
+ * Ember(launch3): 구멍을 낸 GPU 창 안의 자식 창이 나중에 자기 클라이언트 뷰(GPU)로 그리기 시작하면, 그 뷰는 부모
+ * 클라이언트 뷰의 하위 뷰라 부모 마스크 구멍에 같이 잘려 안 보인다 — 그 자식 자리 구멍을 메운다.
+ */
+void macdrv_view_fill_hole_for_subview(macdrv_view v)
+{
+@autoreleasepool
+{
+    NSView* view = (NSView*)v;
+
+    OnMainThreadAsync(^{
+        NSView* parent = [view superview];
+        NSArray* rects;
+        NSMutableArray* kept;
+        NSRect frame;
+
+        if (!parent || !(rects = objc_getAssociatedObject(parent, &ember_holes_key))) return;
+        frame = [view frame];
+        kept = [NSMutableArray arrayWithCapacity:[rects count]];
+        for (NSValue* value in rects)
+            if (!NSIntersectsRect([value rectValue], frame)) [kept addObject:value];
+        if ([kept count] == [rects count]) return;
+        objc_setAssociatedObject(parent, &ember_holes_key, [kept count] ? kept : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        ember_apply_view_holes(parent);
+    });
+}
+}
+
