+{
+    pthread_once(&fg_stability_once, fg_stability_init);
+    if (!fg_stability_config.enabled) return;
+    uint64_t dev = (uint64_t)(uintptr_t)cur.device;
+    if (s->device != dev || s->width != cur.width || s->height != cur.height || s->format != cur.pixelFormat) {
+        memset(s, 0, sizeof(*s));
+        s->device = dev; s->width = cur.width; s->height = cur.height; s->format = cur.pixelFormat;
+    }
+    uint32_t before = *flags;
+    efs_route_step(s, &fg_stability_config, route, now, flags, hold);
+    /* Return the engine's virtual-queue credit for an optional frame we vetoed.
+     * ABI 1.x has no policy-veto bin: use its host/ring cancellation bin (3).
+     * Dedicated stability counters distinguish this from physical ring pressure. */
+    if (ctx && (before & FGE_PLAN_GENERATE) && !(*flags & FGE_PLAN_GENERATE))
+        fge.note_drop(ctx, EMBER_FG_DROP_RING);
+}
+#endif
