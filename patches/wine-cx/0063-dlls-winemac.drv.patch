+static struct
+{
+    int (*ane_status)(void *ctx, uint64_t pair);
+    int (*ane_submit)(void *ctx, const ember_fg_ane_submit_in *in);
+    ember_fg_capabilities_fn get_capabilities;
+    ember_fg_plan_batch_fn plan_batch;
+    ember_fg_encode_batch_fn encode_batch;
+    ember_fg_output_release_fn output_release;
+    ember_fg_output_feedback_fn output_feedback;
+    ember_fg_batch_ready_fn batch_ready;
+    uint32_t (*abi_version)(void);
+    void *(*create2)(uint64_t device, const char *env, size_t len, uint32_t host);
+    void (*destroy)(void *ctx);
+    void (*get_config)(void *ctx, struct fge_config *out);
+    int (*begin_frame)(void *ctx, const struct fge_frame_in *in, struct fge_frame_plan *out);
+    int (*encode)(void *ctx, const struct fge_encode_in *in, struct fge_encode_out *out);
+    void (*note_drop)(void *ctx, uint32_t kind);
