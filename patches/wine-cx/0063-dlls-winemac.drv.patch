+static BOOL fg_serial_present_impl(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<CAMetalDrawable> proxy,
+                              id<MTLTexture> cur, double now, double disp, const struct fge_frame_plan *plan) {
+    EmberFGSerial *s = p->serial;
+    if (!s || fg_serial_ended(s) || !fg_serial_owns(p)) {
+        if (s) {
+            pthread_mutex_lock(&s->lock);
+            if (s->previous >= 0) efp_unref(&s->state, s->previous);
+            s->previous = -1;
+            pthread_mutex_unlock(&s->lock);
+        }
+        return NO;
+    }
+    pthread_mutex_lock(&s->lock);
+    BOOL full = s->state.pending != 0;
+    if (full) efp_fault(&s->state, EFP_DEPTH);
+    pthread_mutex_unlock(&s->lock);
+    /* Exceptional depth-one backpressure ONLY. Never wait for GPU completion.
+     * In particular, no same-CB or other-queue producer drain is introduced. */
+    if (full) dispatch_sync(s->submit, ^{});
+    if (fg_serial_ended(s) || !fg_serial_owns(p)) return NO;
+    if (cur.width != s->width || cur.height != s->height || cur.pixelFormat != s->format) {
+        if (s->width) fg_serial_invalidate(p);
+        s->width = cur.width; s->height = cur.height; s->format = cur.pixelFormat;
+    }
+    pthread_mutex_lock(&s->lock);
+    int slot = efp_slot(&s->state);
+    pthread_mutex_unlock(&s->lock);
+    /* Bound slot waiting to ONE display interval. Original submission waiting
+     * above is separate and has legacy's preservation-first behaviour. */
+    if (slot < 0) {
+        dispatch_time_t until = dispatch_time(DISPATCH_TIME_NOW, (int64_t)(disp * 1e9));
+        do {
+            if (dispatch_semaphore_wait(s->released, until)) break;
+            pthread_mutex_lock(&s->lock); slot = efp_slot(&s->state); pthread_mutex_unlock(&s->lock);
+        } while (slot < 0);
+        if (slot < 0) fg_serial_fault(s, EFP_SLOT);
+    }
+    id<MTLTexture> texture = nil; id<MTLEvent> ready = nil;
+    uint64_t value = 1;
+    if (slot >= 0 && cb.device == s->device) {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:cur.pixelFormat
+                                    width:cur.width height:cur.height mipmapped:NO];
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget; td.storageMode = MTLStorageModePrivate;
+        if (!s->textures[slot] || s->textures[slot].width != cur.width || s->textures[slot].height != cur.height || s->textures[slot].pixelFormat != cur.pixelFormat) {
+            [s->textures[slot] release]; s->textures[slot] = [cb.device newTextureWithDescriptor:td];
+        }
+        /* Independent event per slot. Its value advances ONLY after every GPU
+         * consumer and history pin released the preceding lease. Events are
+         * allocated before entry, not on the normal hook path. */
+        texture = s->textures[slot]; ready = s->events[slot]; value = ++s->values[slot];
+    }
+    id<CAMetalDrawable> borrowed = nil;
+    if (!texture || !ready) {
+        fg_serial_fault(s, EFP_RESOURCE);
+        if (!ready) slot = -1;
+        /* Once empty, the caller can safely take the legacy route. If submitted
+         * originals remain, preserve order using the retained proxy drawable. */
+        pthread_mutex_lock(&s->lock); BOOL empty = !s->state.inflight; pthread_mutex_unlock(&s->lock);
+        if (empty) return NO;
+        borrowed = proxy; texture = cur;
+        /* Existing per-slot event remains usable on texture allocation failure.
+         * Actual slot exhaustion requires an independent borrowed-original event.
+         * OOM retries preserve order; they are not a no-wait recovery guarantee. */
+        while (!ready) {
+            if (fg_serial_ended(s)) return NO;
+            ready = [[cb.device newEvent] autorelease];
+            if (!ready) usleep(1000);
+        }
+    }
+    EmberFGSerialJob *job = nil;
+    while (!(job = [[EmberFGSerialJob alloc] init])) {
+        fg_serial_fault(s, EFP_RESOURCE);
+        pthread_mutex_lock(&s->lock); BOOL empty = !s->state.inflight; pthread_mutex_unlock(&s->lock);
+        if (empty || fg_serial_ended(s)) return NO;
+        usleep(1000); /* preservation-first exceptional allocation pressure */
+    }
+    pthread_mutex_lock(&s->lock);
+    uint64_t sequence = efp_accept(&s->state), epoch = s->state.epoch;
+    if (!sequence) { pthread_mutex_unlock(&s->lock); [job release]; return NO; } /* terminal lifecycle race only */
+    id<MTLBlitCommandEncoder> blit = slot >= 0 && !borrowed ? [cb blitCommandEncoder] : nil;
+    if (slot >= 0 && !blit) {
+        efp_fault(&s->state, EFP_RESOURCE);
+        borrowed = proxy; texture = cur;
+    }
+    if (blit) { [blit copyFromTexture:cur toTexture:texture]; [blit endEncoding]; }
+    [cb encodeSignalEvent:ready value:value];
+    int prev_slot = s->previous;
+    if (slot >= 0) { efp_ref(&s->state, slot); if (!borrowed) efp_ref(&s->state, slot); }
+    if (prev_slot >= 0) { efp_ref(&s->state, prev_slot); efp_unref(&s->state, prev_slot); }
+    s->previous = borrowed ? -1 : slot;
+    pthread_mutex_unlock(&s->lock);
+    id<MTLTexture> previous = prev_slot >= 0 ? s->textures[prev_slot] : nil;
+    id<MTLEvent> previous_ready = prev_slot >= 0 ? s->events[prev_slot] : nil;
+    uint64_t previous_value = prev_slot >= 0 ? s->values[prev_slot] : 0;
+    struct fge_frame_plan captured_plan = *plan;
+    if (borrowed) captured_plan.flags &= ~FGE_PLAN_GENERATE;
+    struct fge_frame_in input = {0}; input.size = sizeof(input);
+    input.now_ns = fge_ns(now); input.frame_no = p->frame_no; input.display_interval = disp;
+    input.flags = FGE_IN_FRAMEGEN | (previous ? FGE_IN_PREV_VALID : 0); fg_feedback(p, now, &input);
+    pthread_mutex_lock(&fg_stat_lock); p->outstanding++; p->transport_start = now; pthread_mutex_unlock(&fg_stat_lock);
+    job->owner = [s retain]; job->layer = [p retain];
+    job->current = [texture retain]; job->previous = [previous retain];
+    job->ready = [ready retain]; job->previous_ready = [previous_ready retain];
+    job->borrowed = [borrowed retain]; job->slot = slot; job->prev_slot = prev_slot;
+    job->sequence = sequence;
+    if (s->ane_enabled && s->encoder && previous && !borrowed &&
+        (captured_plan.flags & FGE_PLAN_GENERATE) && (captured_plan.flags & FGE_PLAN_MC)) {
+        ember_fg_ane_submit_in ane = {0};
+        ane.size = sizeof(ane); ane.command_buffer = (uint64_t)(uintptr_t)cb;
+        ane.current = (uint64_t)(uintptr_t)texture;
+        ane.previous = (uint64_t)(uintptr_t)previous;
+        ane.pair_id = sequence;
+        /* Best effort only. Do not defer original submission to obtain ANE flow.
+         * This exact pair expires after one effective display interval. */
+        ane.deadline_ns = fge_ns(now + disp);
+        fg_ane_submit(p, s->encoder, &ane);
+    }
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) { [job producerCompleted]; }];
+    dispatch_async(s->submit, ^{
+        fg_serial_run(job, value, previous_value, epoch, now, disp, captured_plan, input);
+    });
+    [job release];
+    /* Legacy ring was not updated; do not interpolate stale legacy history after exit. */
+    p->ring_prev = NO; p->have_prev = NO;
+    return YES;
+}
+
+/* Pin host allocation activity separately from GPU leases so terminal cleanup
+ * cannot release a slot/event between host allocation and acceptance. */
+static BOOL fg_serial_present(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<CAMetalDrawable> proxy,
+                              id<MTLTexture> cur, double now, double disp, const struct fge_frame_plan *plan) {
+    EmberFGSerial *s = p->serial;
+    if (!s) return NO;
+    pthread_mutex_lock(&s->lock); ++s->hooks; pthread_mutex_unlock(&s->lock);
+    @try { return fg_serial_present_impl(p, cb, proxy, cur, now, disp, plan); }
+    @finally {
+        pthread_mutex_lock(&s->lock);
+        --s->hooks;
+        BOOL cleanup = s->state.lifecycle != EFP_ACTIVE && !s->hooks;
+        pthread_mutex_unlock(&s->lock);
+        if (cleanup) fg_serial_cleanup(s);
+    }
+}
diff --git a/dlls/winemac.drv/fg_prism_cfg.h b/dlls/winemac.drv/fg_prism_cfg.h
new file mode 100644
index 0000000..b53963c
--- /dev/null
+++ b/dlls/winemac.drv/fg_prism_cfg.h
@@ -0,0 +1,49 @@
+/* Shared cfg worker. Render consumers load one coherent atomic flags word.
+ * Constructor does not open files; all stat/read work runs on this worker. */
+#ifndef EMBER_FG_PRISM_CFG_H
+#define EMBER_FG_PRISM_CFG_H
+#include "../../common/fg_live_cfg.h"
+#include <pthread.h>
+#include <time.h>
+static unsigned fg_prism_cfg_flags;
+static unsigned fg_prism_cfg_stop, fg_prism_cfg_ready;
+static int fg_prism_cfg_started;
+static pthread_t fg_prism_cfg_thread;
+static unsigned fg_prism_cfg_pack(fg_live_cfg_values v) { return (v.prism?1u:0u)|(v.pair?2u:0u); }
+static void *fg_prism_cfg_worker(void *unused) {
+    (void)unused;
+    fg_live_cfg_reader reader; fg_live_cfg_values v=fg_live_cfg_env_defaults();
+    const char *prefix=getenv("WINEPREFIX"); char path[4096]={0};
+    if(prefix && *prefix && snprintf(path,sizeof(path),"%s/drive_c/ember-d11.cfg",prefix)>=(int)sizeof(path)) path[0]=0;
+    fg_live_cfg_reader_init(&reader,path,v);
+    while(!__atomic_load_n(&fg_prism_cfg_stop,__ATOMIC_ACQUIRE)) {
+        struct timespec now; clock_gettime(CLOCK_MONOTONIC,&now);
+        unsigned old=__atomic_load_n(&fg_prism_cfg_flags,__ATOMIC_ACQUIRE);
+        fg_live_cfg_poll(&reader,(uint64_t)now.tv_sec*1000000000ULL+now.tv_nsec,&v);
+        unsigned next=fg_prism_cfg_pack(v);
+        __atomic_store_n(&fg_prism_cfg_flags,next,__ATOMIC_RELEASE);
+        __atomic_store_n(&fg_prism_cfg_ready,1,__ATOMIC_RELEASE);
+        if(old!=next) fprintf(stderr,"ember-fg-prism-cfg: prism=%u->%u pair=%u->%u\n",old&1,next&1,(old>>1)&1,(next>>1)&1);
+        struct timespec wait={1,0}; nanosleep(&wait,NULL);
+    }
+    return NULL;
+}
+#ifndef FG_PRISM_CFG_MANUAL_LIFECYCLE
+__attribute__((constructor))
+#endif
+static void fg_prism_cfg_start(void) {
+    /* Fail closed until cfg priority has been evaluated by the worker. */
+    fg_prism_cfg_flags=0;
+    if(!pthread_create(&fg_prism_cfg_thread,NULL,fg_prism_cfg_worker,NULL))fg_prism_cfg_started=1;
+    else fprintf(stderr,"ember-fg-prism-cfg: worker unavailable; Prism/PAIR disabled\n");
+}
+#ifndef FG_PRISM_CFG_MANUAL_LIFECYCLE
+__attribute__((destructor))
+#endif
+static void fg_prism_cfg_finish(void) {
+    __atomic_store_n(&fg_prism_cfg_stop,1,__ATOMIC_RELEASE);
+    if(fg_prism_cfg_started)pthread_join(fg_prism_cfg_thread,NULL);
+    fg_prism_cfg_started=0;
+}
+static unsigned fg_prism_cfg_snapshot(void) { return __atomic_load_n(&fg_prism_cfg_flags,__ATOMIC_ACQUIRE); }
+#endif
diff --git a/dlls/winemac.drv/fg_stability.h b/dlls/winemac.drv/fg_stability.h
new file mode 100644
index 0000000..d172534
--- /dev/null
+++ b/dlls/winemac.drv/fg_stability.h
@@ -0,0 +1,166 @@
+/* Ember-owned, CPU-only, veto-only fill/LLFI admission. No present/sleep/GPU work.
+ * A denied engine plan can never become a generated/repeated frame here. */
+#ifndef EMBER_FG_STABILITY_H
+#define EMBER_FG_STABILITY_H
+#ifndef EMBER_FG_STABILITY
+#define EMBER_FG_STABILITY 1
+#endif
+#if EMBER_FG_STABILITY
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+    int enabled, lowfps, shape, cadence, llfi;
+    double min_fps, resume_fps, low_dwell, hold, recovery, tau, jitter, ramp, cadence_max;
+} efs_config;
+typedef struct {
+    double last, mean, deviation, low_since, high_since, until;
+    double ratio, credit, calm_since, low_fraction;
+    uint64_t width, height, format, device;
+    uint64_t low_veto, shape_veto, entries;
+    unsigned samples;
+    int held, shaping;
+} efs_state;
+
+static inline double efs_number(const char *text, double fallback, double lo, double hi)
+{
+    char *end;
+    if (!text || !*text) return fallback;
+    double v = strtod(text, &end);
+    return end != text && !*end && isfinite(v) && v >= lo && v <= hi ? v : fallback;
+}
+static inline int efs_on(const char *v) { return !v || strcmp(v, "0"); }
+static inline efs_config efs_defaults(void)
+{
+    efs_config c = {1, 1, 1, 0, 1, 38, 42, .250, 1.500, 1.000, .350, .20, .500, 0};
+    return c;
+}
+static inline efs_config efs_environment(void)
+{
+    efs_config c = efs_defaults();
+    c.enabled = efs_on(getenv("EMBER_FG_STABILITY"));
+    c.lowfps = efs_on(getenv("EMBER_FG_STABILITY_LOWFPS"));
+    /* (fgnight-1023 r3) Ember QuickBeat (EMBER_FG_CADENCE=quick) exists to interpolate 30-40 fps games: the
+     * 38 fps original-only latch would keep it off for good. The engine latency guard still admits each frame;
+     * an explicit EMBER_FG_STABILITY_LOWFPS keeps its meaning. */
+    { const char *q = getenv("EMBER_FG_CADENCE"), *l = getenv("EMBER_FG_STABILITY_LOWFPS");
+      if (q && !strcmp(q, "quick") && !(l && *l)) c.lowfps = 0; }
+    c.shape = efs_on(getenv("EMBER_FG_STABILITY_SHAPE"));
+    c.llfi = efs_on(getenv("EMBER_FG_STABILITY_LLFI"));
+    c.min_fps = efs_number(getenv("EMBER_FG_STABILITY_MIN_FPS"), c.min_fps, 1, 120);
+    c.resume_fps = efs_number(getenv("EMBER_FG_STABILITY_RESUME_FPS"), fmax(c.resume_fps, c.min_fps + 4), c.min_fps, 240);
+    c.low_dwell = efs_number(getenv("EMBER_FG_STABILITY_LOW_MS"), 250, 0, 5000) / 1000;
+    c.hold = efs_number(getenv("EMBER_FG_STABILITY_HOLD_MS"), 1500, 0, 30000) / 1000;
+    c.recovery = efs_number(getenv("EMBER_FG_STABILITY_RECOVER_MS"), 1000, 0, 10000) / 1000;
+    c.tau = efs_number(getenv("EMBER_FG_STABILITY_WINDOW_MS"), 350, 50, 2000) / 1000;
+    c.jitter = efs_number(getenv("EMBER_FG_STABILITY_JITTER"), .20, .05, 1);
+    c.ramp = efs_number(getenv("EMBER_FG_STABILITY_RAMP_MS"), 500, 50, 5000) / 1000;
+    /* Any added original hold needs BOTH the existing latency opt-in and an
+     * explicit nonzero bound. Merely enabling stability never adds a delay. */
+    const char *relax = getenv("EMBER_FG_LATGUARD_CADENCE");
+    c.cadence_max = efs_number(getenv("EMBER_FG_STABILITY_CADENCE_MS"), 0, 0, 25) / 1000;
+    c.cadence = relax && !strcmp(relax, "1") && c.cadence_max > 0;
+    return c;
+}
+
+enum { EFS_BYPASS = 0, EFS_FILL = 1, EFS_LLFI = 2 };
+/* LLFI smooth/job and fill/DQ consume the same vetoed host flags. Other
+ * transports keep their existing contract; disabling LLFI must not opt it
+ * back into the ordinary fill policy. HDR is guarded before any of these. */
+static inline int efs_route(const efs_config *c, const char *source,
+                           int smooth, int link, int serial)
+{
+    if (!c->enabled || link || serial) return EFS_BYPASS;
+    if (source && !strcmp(source, "llfi")) return c->llfi ? EFS_LLFI : EFS_BYPASS;
+    return !source && !smooth ? EFS_FILL : EFS_BYPASS;
+}
+
+/* Flags match the versioned frame_plan ABI: GENERATE=1, MC=2, KEEP=4,
+ * LATGUARD_PAUSED=8. Preserve every other flag/timing field on normal paths. */
+static inline void efs_step(efs_state *s, const efs_config *c, double now,
+                           uint32_t *flags, double *cadence_hold)
+{
+    if (!c->enabled) return;  /* byte-for-byte plan and state passthrough */
+    if (!isfinite(now) || !(now > 0)) return;
+    double dt = now - s->last;
+    if (!(s->last > 0) || dt <= 0 || dt > .250) {
+        /* Lifecycle discontinuities do not reuse credits or recovery time. */
+        s->last = now; s->mean = s->deviation = s->low_fraction = 0; s->samples = 0;
+        s->ratio = 1; s->credit = 0; s->shaping = 0;
+        s->low_since = s->high_since = s->calm_since = 0;
+        if (s->held) {
+            s->until = now + c->hold;
+            if (c->lowfps) { *flags &= ~7u; ++s->low_veto; }
+        }
+        return;
+    }
+    s->last = now;
+    if (!s->samples) s->mean = dt;
+    /* Per-frame bounded EMA: one long hitch cannot redefine native cadence. */
+    const double a = fmin(dt / c->tau, .10);
+    const double error = fabs(dt - s->mean);
+    s->mean += a * (dt - s->mean);
+    s->deviation += a * (error - s->deviation);
+    s->low_fraction += a * ((dt > 1 / c->min_fps ? 1 : 0) - s->low_fraction);
+    ++s->samples;
+    if (c->lowfps && s->samples >= 4) {
+        /* Require a slow recent mean AND repeated slow arrivals, rather than
+         * one long hitch. Short/long alternation may still be a 33fps workload.
+         * A stale loading-screen baseline is never used as the current rate. */
+        int low = s->low_fraction >= .45 && s->mean > 1 / c->min_fps;
+        int high = dt < 1 / c->resume_fps && s->mean < 1 / c->resume_fps;
+        if (!low) s->low_since = 0;
+        else if (!s->low_since) s->low_since = now;
+        if (!s->held && s->low_since && now - s->low_since >= c->low_dwell) {
+            s->held = 1; s->until = now + c->hold; s->high_since = 0; ++s->entries;
+        }
+        if (!high) s->high_since = 0;
+        else if (!s->high_since) s->high_since = now;
+        if (s->held && now >= s->until && s->high_since && now - s->high_since >= c->recovery)
+            s->held = 0;
+    }
+    if (s->held && c->lowfps) {
+        *flags &= ~7u; /* no optional encode/history copy while latched */
+        s->credit = 0; ++s->low_veto; return;
+    }
+    if (c->shape && s->samples >= 8 && s->mean > 0) {
+        const double jitter = s->deviation / s->mean;
+        if (jitter >= c->jitter) { s->shaping = 1; s->calm_since = 0; }
+        else if (jitter < c->jitter * .5) {
+            if (!s->calm_since) s->calm_since = now;
+            if (now - s->calm_since >= c->recovery) s->shaping = 0;
+        } else s->calm_since = 0;
+        /* Veto extras during short native bursts: target <= twice the recent
+         * native rate, subtracting this frame's native contribution. Credits
+         * never accumulate across engine denials, so recovery has no catch-up. */
+        const double target = s->shaping ? fmax(0, fmin(1, 2 * dt / s->mean - 1)) : 1;
+        const double slope = dt / (target < s->ratio ? fmin(c->ramp, .120) : c->ramp);
+        s->ratio += fmax(-slope, fmin(slope, target - s->ratio));
+        if (!(*flags & 1) || (*flags & 8)) s->credit = 0;
+        else if (s->ratio < .999999) {
+            s->credit += s->ratio;
+            if (s->credit + 1e-9 < 1) { *flags &= ~3u; ++s->shape_veto; }
+            else s->credit -= 1;
+        } else s->credit = 0;
+    }
+    if (c->cadence && (*flags & 1) && !(*flags & 8) && s->mean > 0)
+        *cadence_hold = fmax(*cadence_hold, fmin(c->cadence_max, .5 * s->mean));
+}
+
+static inline void efs_route_step(efs_state *s, const efs_config *c, int route,
+                                 double now, uint32_t *flags, double *cadence_hold)
+{
+    if (route == EFS_BYPASS) return;
+    if (route == EFS_LLFI) {
+        /* LLFI's inference deadlines, original spacing and waits stay owned by
+         * its transport. Even the optional fill cadence experiment adds no
+         * hold on this route. Admission can only remove optional work. */
+        efs_config admission = *c;
+        admission.cadence = 0;
+        efs_step(s, &admission, now, flags, cadence_hold);
+    } else efs_step(s, c, now, flags, cadence_hold);
+}
+#endif
+#endif
diff --git a/dlls/winemac.drv/fg_transport.h b/dlls/winemac.drv/fg_transport.h
new file mode 100644
index 0000000..9e89ed5
--- /dev/null
+++ b/dlls/winemac.drv/fg_transport.h
@@ -0,0 +1,157 @@
+/* Producer admission shared by the Wine adapter and CPU tests, followed by the
+ * historical single-pair output primitive. That primitive alone cannot prove
+ * original preservation or producer/hook deadlock freedom. No Metal types. */
+#ifndef EMBER_FG_TRANSPORT_H
+#define EMBER_FG_TRANSPORT_H
+#include <stdint.h>
+#include <string.h>
+
+/* Observed producer behaviour is necessary, but cannot certify the NEXT
+ * commit. A host also needs structural proofs before it may submit n>=2.
+ * These are host transport guarantees, not engine texture capabilities. */
+enum {
+    EFT_ORIGINAL_LEGACY_BOUND = 1u,
+    EFT_GENERATED_BEFORE_ORIGINAL = 2u,
+    EFT_NO_PRODUCER_WAIT_CYCLE = 4u,
+    EFT_MULTI_PROOFS = 7u
+};
+typedef struct ember_fg_producer_contract {
+    uint64_t epoch, sequence, queue, producer;
+    int64_t since, last;
+    unsigned clean, scheduled, violations, disabled;
+} ember_fg_producer_contract;
+
+static inline void eft_contract_reset(ember_fg_producer_contract *s, uint64_t epoch)
+{
+    unsigned violations = s->violations, disabled = s->disabled;
+    memset(s, 0, sizeof(*s));
+    s->epoch = epoch; s->violations = violations; s->disabled = disabled;
+}
+/* Scheduled is a conservative observation of commit: a committed but not yet
+ * scheduled buffer cannot earn a clean sample. Late callbacks cannot certify
+ * another pair or epoch. No original texture/drawable is owned by this state. */
+static inline void eft_contract_scheduled(ember_fg_producer_contract *s,
+                                         uint64_t epoch, uint64_t sequence)
+{
+    if (s->epoch == epoch && s->sequence == sequence) s->scheduled = 1;
+}
+static inline int eft_contract_observe(ember_fg_producer_contract *s,
+                                      uint64_t epoch, uint64_t sequence,
+                                      uint64_t queue, uint64_t producer, int64_t now)
+{
+    int violation;
+    if (s->disabled) return 0;
+    if (s->epoch != epoch) eft_contract_reset(s, epoch);
+    violation = !epoch || !sequence || !queue || !producer || now <= 0 ||
+        (s->sequence && (!s->scheduled || queue != s->queue || producer == s->producer ||
+                        sequence <= s->sequence || now <= s->last));
+    if (violation) {
+        ++s->violations;
+        if (s->violations >= 2) s->disabled = 1;
+        s->clean = 0; s->since = 0;
+    } else if (!s->clean || now - s->last > 250000000LL) {
+        s->since = now; s->clean = 1;
+    } else if (s->clean < 120) ++s->clean;
+    s->epoch = epoch; s->sequence = sequence; s->queue = queue;
+    s->producer = producer; s->last = now; s->scheduled = 0;
+    return !violation;
+}
+static inline int eft_contract_allow(const ember_fg_producer_contract *s,
+                                    unsigned n, unsigned proofs,
+                                    uint64_t epoch, uint64_t sequence)
+{
+    /* n=0/1 uses the unchanged legacy route, never the deferred batch route. */
+    if (n <= 1) return 1;
+    return n <= 3 && !s->disabled && s->epoch == epoch && s->sequence == sequence &&
+        s->scheduled && s->clean >= 120 && s->last - s->since >= 2000000000LL &&
+        (proofs & EFT_MULTI_PROOFS) == EFT_MULTI_PROOFS;
+}
+
+typedef struct ember_fg_transport {
+    uint64_t epoch, sequence;
+    uint32_t count, cursor, ready, valid, submitted, consumed, released, feedback;
+    uint32_t drawable_held, original_submitted, failed;
+    int64_t target[4], deadline;
+} ember_fg_transport;
+
+static inline int eft_begin(ember_fg_transport *s, uint64_t epoch, uint64_t sequence,
+                            unsigned count, const int64_t *targets, int64_t original, int64_t deadline)
+{
+    unsigned i;
+    if (!s || !epoch || !sequence || count > 3 || original <= 0 || deadline < original) return 0;
+    for (i = 0; i < count; ++i)
+        if (targets[i] <= 0 || targets[i] >= original || (i && targets[i] <= targets[i-1])) return 0;
+    memset(s, 0, sizeof(*s)); s->epoch = epoch; s->sequence = sequence; s->count = count;
+    s->deadline = deadline; s->target[count] = original;
+    for (i = 0; i < count; ++i) s->target[i] = targets[i];
+    return 1;
+}
+static inline void eft_ready(ember_fg_transport *s, unsigned index, int valid)
+{
+    if (index <= s->count) { s->ready |= 1u << index; if (valid) s->valid |= 1u << index; else s->valid &= ~(1u << index); }
+}
+/* A missing/late output expires in place, never compressing the remaining targets. */
+static inline int eft_drop(ember_fg_transport *s, unsigned index)
+{
+    if (index != s->cursor || index > s->count || s->drawable_held || (s->submitted & (1u << index))) return 0;
+    ++s->cursor; return 1;
+}
+static inline int eft_acquire(ember_fg_transport *s, unsigned index, uint64_t epoch, int64_t now)
+{
+    unsigned bit;
+    if (index > s->count) return 0;
+    bit = 1u << index;
+    if (index > s->count || index != s->cursor || s->drawable_held || epoch != s->epoch ||
+        (s->released & bit) || !(s->ready & s->valid & bit) || (index < s->count &&
+        (s->original_submitted || s->failed || now > s->target[index] || now > s->deadline))) return 0;
+    s->drawable_held = bit; return 1;
+}
+/* Revalidate AFTER nextDrawable (which may block/change epoch). */
+static inline int eft_submit(ember_fg_transport *s, unsigned index, uint64_t epoch, int64_t now)
+{
+    unsigned bit;
+    if (index > s->count) return 0;
+    bit = 1u << index;
+    if (index > s->count || s->drawable_held != bit) return 0;
+    s->drawable_held = 0;
+    if (index != s->cursor || epoch != s->epoch || (s->submitted & bit) ||
+        (index < s->count && (s->original_submitted || s->failed || now > s->target[index] || now > s->deadline))) return 0;
+    s->submitted |= bit; ++s->cursor;
+    if (index == s->count) s->original_submitted = 1;
+    return 1;
+}
+static inline int eft_consume(ember_fg_transport *s, unsigned index)
+{
+    unsigned bit;
+    if (index > s->count) return 0;
+    bit = 1u << index;
+    if (index > s->count || !(s->submitted & bit) || (s->consumed & bit)) return 0;
+    s->consumed |= bit; return 1;
+}
+static inline int eft_release(ember_fg_transport *s, unsigned index)
+{
+    unsigned bit;
+    if (index > s->count) return 0;
+    bit = 1u << index;
+    if (index >= s->count || s->drawable_held == bit || (s->released & bit) ||
+        ((s->submitted & bit) && !(s->consumed & bit))) return 0;
+    s->released |= bit; return 1;
+}
+static inline int eft_feedback(ember_fg_transport *s, unsigned index, int64_t presented)
+{
+    unsigned bit;
+    if (index > s->count) return 0;
+    bit = 1u << index;
+    if (index > s->count || (s->feedback & bit)) return 0;
+    s->feedback |= bit;
+    return presented > 0 && (s->submitted & bit) ? 2 : 1;
+}
+static inline int eft_done(const ember_fg_transport *s)
+{
+    unsigned generated = (1u << s->count) - 1;
+    return !s->drawable_held && s->cursor == s->count + 1 &&
+        (s->released & generated) == generated &&
+        (s->consumed & s->submitted) == s->submitted &&
+        (s->feedback & ((1u << (s->count + 1)) - 1)) == ((1u << (s->count + 1)) - 1);
+}
+#endif
diff --git a/dlls/winemac.drv/gdi.c b/dlls/winemac.drv/gdi.c
index 7342494..da4fa41 100644
--- a/dlls/winemac.drv/gdi.c
