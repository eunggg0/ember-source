+/* 보간을 실제로 하는가(EMBER_D3DM_FRAMEGEN=1). 선명화만 켜면 프록시는 쓰되 이것은 거짓. */
+static int fg_generate(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *v = getenv("EMBER_D3DM_FRAMEGEN"); on = v && !strcmp(v, "1"); }
+    return on;
+}
