new file mode 100644
index 0000000..be9f884
--- /dev/null
+++ b/dlls/winemac.drv/ember_autohdr_d3dm.h
@@ -0,0 +1,114 @@
+/*
+ * Ember Flare (Auto HDR, EMBER_AUTOHDR) glue for the D3DMetal path (winemac proxy layer). The gain-map passes, the trained
+ * highlight net and the EDR output pass live in libEmberTone.dylib (EmberCore, separate proprietary library); this header only
+ * forwards to it (ember_tone_load.h). Without the library Flare stays off (create returns NULL).
+ *
+ * When the game is SDR and the screen can do EDR (potential headroom > 1.25), ember_framegen.m switches the real layer to
+ * RGBA16Float + extended linear sRGB, calls ember_ahdr_encode once per game frame and ember_ahdr_draw for the final pass.
+ * Switches (same as DXMT): EMBER_AUTOHDR=1, EMBER_AUTOHDR_STRENGTH, EMBER_AUTOHDR_PEAK, EMBER_AUTOHDR_GAMMA=2.2, EMBER_AUTOHDR_LOG=1.
+ * Included by ember_framegen.m.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#include "ember_tone_load.h"
+
+static int ember_ahdr_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *v = getenv("EMBER_AUTOHDR"); on = v && !strcmp(v, "1"); }
+    return on;
+}
+static int ember_ahdr_log(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *v = getenv("EMBER_AUTOHDR_LOG"); on = v && !strcmp(v, "1"); }
+    return on;
+}
+
+struct ember_ahdr
+{
+    void *ctx;
+    BOOL failed;     /* mirrors the library state (read by ember_framegen.m) */
+    float peak;      /* current display peak (log line in ember_framegen.m) */
+};
+
+static void ember_ahdr_sync(struct ember_ahdr *a)
+{
+    struct etone_ahdr_config c;
+    memset(&c, 0, sizeof(c));
+    c.size = sizeof(c);
+    etone.ahdr_get_config(a->ctx, &c);
+    a->failed = c.failed ? YES : NO;
+    a->peak = c.peak;
+}
+
+static struct ember_ahdr *ember_ahdr_create(id<MTLDevice> dev)
+{
+    struct ember_ahdr *a;
+    void *ctx;
+    if (!ember_ahdr_enabled() || !dev || !etone_available()) return NULL;
+    ctx = etone.ahdr_create((uint64_t)(uintptr_t)dev, NULL, 0, ETONE_HOST_D3DMETAL);
+    if (!ctx) return NULL;
+    a = calloc(1, sizeof(*a));
+    if (!a) { etone.ahdr_destroy(ctx); return NULL; }
+    a->ctx = ctx;
+    ember_ahdr_sync(a);
+    return a;
+}
+
+static void ember_ahdr_destroy(struct ember_ahdr *a)
+{
+    if (!a) return;
+    etone.ahdr_destroy(a->ctx);
+    free(a);
+}
+
+/* game frame → gain map (1/4 size), same command buffer, no CPU wait */
+static void ember_ahdr_encode(struct ember_ahdr *a, id<MTLCommandBuffer> cb, id<MTLTexture> cur)
+{
+    struct etone_ahdr_encode_in in;
+    struct etone_ahdr_encode_out out;
+    if (!a || a->failed || !cur) return;
+    memset(&in, 0, offsetof(struct etone_ahdr_encode_in, wait_fences));
+    in.size = offsetof(struct etone_ahdr_encode_in, wait_fences);
+    in.flags = ETONE_AHDR_SRC_AUTO;
+    in.command_buffer = (uint64_t)(uintptr_t)cb;
+    in.source = (uint64_t)(uintptr_t)cur;
+    memset(&out, 0, sizeof(out));
+    out.size = sizeof(out);
+    if (!etone.ahdr_encode(a->ctx, &in, &out)) ember_ahdr_sync(a);
+}
+
+/* screen output: only into an RGBA16Float (EDR) target. NO → the caller draws its normal pass */
+static BOOL ember_ahdr_draw(struct ember_ahdr *a, id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float w,
+                            id<MTLTexture> dst, float sharp)
+{
+    struct etone_ahdr_draw_in in;
+    if (!a || a->failed || !dst) return NO;
+    memset(&in, 0, sizeof(in));
+    in.size = sizeof(in);
+    in.blend = w;
+    in.sharp = sharp;
+    in.command_buffer = (uint64_t)(uintptr_t)cb;
+    in.current = (uint64_t)(uintptr_t)cur;
+    in.previous = (uint64_t)(uintptr_t)prv;
+    in.target = (uint64_t)(uintptr_t)dst;
+    return etone.ahdr_draw(a->ctx, &in) ? YES : NO;
+}
+
+/* follow the display headroom (now value) smoothly */
+static void ember_ahdr_update_peak(struct ember_ahdr *a, double edr_now)
+{
+    struct etone_ahdr_frame_in in;
+    struct etone_ahdr_frame_out out;
+    if (!a) return;
+    memset(&in, 0, sizeof(in));
+    in.size = sizeof(in);
+    in.edr_now = edr_now;
+    memset(&out, 0, sizeof(out));
+    out.size = sizeof(out);
+    etone.ahdr_frame(a->ctx, &in, &out);
+    a->peak = out.peak;
+}
