+/* Ember(launch3, 2026-10-03): GPU 로 그리는 창(WS_CLIPCHILDREN)의 보이는 GDI 자식 창 자리를 클라이언트 뷰에서 뚫는다.
+ * 윈도우는 자식 창을 부모 스왑체인 위에 보여 준다. 맥 드라이버는 클라이언트 뷰가 창 표면(자식 창 GDI 그림 포함)을 덮어
+ * EA 앱(Qt 가 ANGLE→D3D11 로 그리는 창 안의 CEF 자식 창) 로그인 화면이 화면에는 비어 보였다(창 표면 덤프에는 정상).
+ * 자기 클라이언트 뷰가 있는 자식(게임 렌더 자식 창 등)·투명·숨은 자식은 빼고, 자식이 없으면 아무 일도 하지 않는다.
+ * EMBER_CHILD_HOLES=0 이면 끈다. */
+static void macdrv_client_surface_update_holes(struct macdrv_client_surface *surface, HWND hwnd, const RECT *client)
+{
+    static int enabled = -1;
+    CGRect holes[32];
+    int count = 0;
+    HWND child;
+    UINT dpi;
+    LONG width = client->right - client->left, height = client->bottom - client->top;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv("EMBER_CHILD_HOLES");
+        enabled = !(e && e[0] == '0');
+    }
+    if (!enabled || !surface->cocoa_view) return;
+
+    dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    if (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_CLIPCHILDREN)
+    {
+        for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child && count < ARRAY_SIZE(holes);
+             child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+        {
+            DWORD style = NtUserGetWindowLongW(child, GWL_STYLE);
+            DWORD ex_style = NtUserGetWindowLongW(child, GWL_EXSTYLE);
+            struct macdrv_win_data *cdata;
+            BOOL gpu = FALSE;
+            RECT rc;
+
+            if (!(style & WS_VISIBLE) || (ex_style & (WS_EX_TRANSPARENT | WS_EX_LAYERED))) continue;
+            if ((cdata = get_win_data(child)))
+            {
+                gpu = cdata->client_view != NULL;
+                release_win_data(cdata);
+            }
+            if (gpu) continue;
+            if (!NtUserGetWindowRect(child, &rc, dpi)) continue;
+            NtUserMapWindowPoints(0, hwnd, (POINT *)&rc, 2, dpi);
+            if (rc.left < 0) rc.left = 0;
+            if (rc.top < 0) rc.top = 0;
+            if (rc.right > width) rc.right = width;
+            if (rc.bottom > height) rc.bottom = height;
+            if (rc.left >= rc.right || rc.top >= rc.bottom) continue;
+            holes[count++] = cgrect_from_rect(rc);
+        }
+    }
+    if (count) TRACE("%p: %d child hole(s), first %s\n", hwnd, count, wine_dbgstr_cgrect(holes[0]));
+    macdrv_set_view_holes(surface->cocoa_view, holes, count);
+}
