+/* 화면 대기열 길이(진짜 레이어). 보간이 쉬는 동안(게임이 주사율 근처)은 보간 끔+저지연과 같은 2장 — 그래야 통과 지연이 보간 끔과 같다.
+ * 보간 중엔 보간 프레임과 원본을 함께 잡아야 하므로 3장(2장이면 5.8fps 로 무너짐, README 117). vsync 끈 게임은 3장 그대로(README 125).
+ * EMBER_LOW_LATENCY=1(Ember 가 보간을 켜면 같이 켠다)이고 보충형일 때만. 켜기/끄기 순간에 바뀌므로 프레임마다 읽지 않는다. */
+static void fg_apply_drawables(EmberFGLayer *p)
+{
+    NSUInteger n;
+    if (!p->real || !fg_generate() || (p->fge_ctx ? (BOOL)p->fge_cfg.smooth : (BOOL)fg_smooth()) || !fg_low_latency()) return;
+    n = p->game_drawables ? p->game_drawables : 3;
+    if (!p->active && p->real.displaySyncEnabled && n > 2) n = 2;
+    if (p->real.maximumDrawableCount != n)
+    {
+        unsigned long was = (unsigned long)p->real.maximumDrawableCount;
+        p->real.maximumDrawableCount = n;
+        if (fg_log()) fprintf(stderr, "ember-d3dm-fg: drawables %lu -> %lu (active=%d sync=%d)\n",
+                              was, (unsigned long)p->real.maximumDrawableCount, p->active, p->real.displaySyncEnabled);
+    }
+}
+
+/* ---- 합성 셰이더: out = mix(cur, prev, w) ---- */
+
+static NSString * const fg_shader =
+    @"#include <metal_stdlib>\n"
+     "using namespace metal;\n"
+     "struct V { float4 pos [[position]]; float2 uv; };\n"
+     "vertex V ember_fg_vs(uint id [[vertex_id]]) {\n"
+     "  float2 p = float2((id << 1) & 2, id & 2);\n"
+     "  V o; o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0); o.uv = float2(p.x, 1.0 - p.y); return o; }\n"
+     /* Ember 선명화: AMD FidelityFX CAS 방식(MIT) — DXMT 와 같은 식. sharp 0 이면 그대로 */
+     "struct P { float w; float sharp; };\n"
+     "float4 cas(texture2d<float> t, float2 uv, float sharp) {\n"
+     "  constexpr sampler s(filter::linear, address::clamp_to_edge);\n"
+     "  float4 e = t.sample(s, uv);\n"
+     "  if (sharp <= 0.0) return e;\n"
+     "  float2 px = 1.0 / float2(t.get_width(), t.get_height());\n"
+     "  float3 b = t.sample(s, uv + float2(0, -px.y)).rgb, d = t.sample(s, uv + float2(-px.x, 0)).rgb;\n"
+     "  float3 f = t.sample(s, uv + float2(px.x, 0)).rgb, h = t.sample(s, uv + float2(0, px.y)).rgb;\n"
+     "  float3 mn = min(min(min(d, e.rgb), min(f, b)), h), mx = max(max(max(d, e.rgb), max(f, b)), h);\n"
+     "  float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-5)));\n"
+     "  float3 w = amp * (-1.0 / mix(8.0, 5.0, saturate(sharp)));\n"
+     "  return float4(max((b * w + d * w + f * w + h * w + e.rgb) / (1.0 + 4.0 * w), 0.0), e.a); }\n"
+     "fragment float4 ember_fg_fs(V in [[stage_in]], texture2d<float> cur [[texture(0)]],\n"
+     "                            texture2d<float> prv [[texture(1)]], constant P &p [[buffer(0)]]) {\n"
+     "  float4 c = cas(cur, in.uv, p.sharp);\n"
+     "  if (p.w <= 0.0) return c;\n"
+     "  return mix(c, cas(prv, in.uv, p.sharp), p.w); }\n";
+
+static pthread_mutex_t fg_lock = PTHREAD_MUTEX_INITIALIZER;
+static NSMutableDictionary *fg_pipelines;   /* "<device ptr>-<format>" -> pipeline */
+static id<MTLLibrary> fg_library;
+
+static id<MTLRenderPipelineState> fg_pipeline(id<MTLDevice> dev, MTLPixelFormat fmt)
+{
+    id<MTLRenderPipelineState> ps;
+    NSString *key;
+
+    pthread_mutex_lock(&fg_lock);
+    if (!fg_pipelines) fg_pipelines = [[NSMutableDictionary alloc] init];
+    key = [NSString stringWithFormat:@"%p-%lu", dev, (unsigned long)fmt];
+    ps = [fg_pipelines objectForKey:key];
+    if (!ps)
+    {
+        NSError *err = nil;
+        MTLRenderPipelineDescriptor *desc;
+        if (!fg_library || fg_library.device != dev)
+        {
+            [fg_library release];
+            fg_library = [dev newLibraryWithSource:fg_shader options:nil error:&err];
+        }
+        desc = [[MTLRenderPipelineDescriptor alloc] init];
+        desc.vertexFunction = [[fg_library newFunctionWithName:@"ember_fg_vs"] autorelease];
+        desc.fragmentFunction = [[fg_library newFunctionWithName:@"ember_fg_fs"] autorelease];
+        desc.colorAttachments[0].pixelFormat = fmt;
+        ps = [dev newRenderPipelineStateWithDescriptor:desc error:&err];
+        [desc release];
+        if (ps) { [fg_pipelines setObject:ps forKey:key]; [ps release]; }
+        else fprintf(stderr, "ember-d3dm-fg: pipeline failed: %s\n", err ? [[err description] UTF8String] : "?");
+    }
+    pthread_mutex_unlock(&fg_lock);
+    return ps;
+}
+
+/* EMBER_D3DM_SHARPNESS(0~1): 화면으로 나가는 프레임에만 선명화(내부 사본에는 안 한다 — 두 번 먹지 않게). */
+static float fg_sharpness(void)
+{
+    static float v = -1;
+    if (v < 0) { const char *e = getenv("EMBER_D3DM_SHARPNESS"); v = e ? (float)atof(e) : 0; if (v < 0) v = 0; if (v > 1) v = 1; }
+    return v;
+}
+
+static BOOL fg_draw_sharp(id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float w, id<MTLTexture> dst, float sharp);
+/* 화면으로 나가는 모든 프레임(원본·보간, 게임 스레드·보조 스레드)이 여기를 지난다.
+ * 화면 확대(EMBER_D3DM_UPSCALE, ember_upscale.m)가 켜져 있고 진짜 drawable 이 더 크면: 보간 혼합은 게임 해상도에서 먼저 한 장으로
+ * (싸다), 그 한 장을 MetalFX 로 한 번 키우고, 선명화(CAS)는 모니터 해상도에서. 못 키우면(형식·메모리) 예전처럼 이중선형. */
+static BOOL fg_draw_frame(id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float w, id<MTLTexture> dst)
+{
+    if (ember_up_enabled() && (dst.width > cur.width || dst.height > cur.height))
+    {
+        id<MTLTexture> src = cur, up;
+        if (w > 0)
+        {
+            id<MTLTexture> t = ember_up_scratch(cb, cur);
+            if (t && fg_draw_sharp(cb, cur, prv, w, t, 0)) src = t;
+        }
+        if ((src != cur || w <= 0) && (up = ember_up_encode(cb, src, dst.width, dst.height)))
+        {
+            if (ember_ahdr_draw(fg_ahdr_now, cb, up, up, 0.0f, dst, fg_sharpness())) return YES;
+            return fg_draw_sharp(cb, up, up, 0.0f, dst, fg_sharpness());
+        }
+    }
+    if (ember_ahdr_draw(fg_ahdr_now, cb, cur, prv, w, dst, fg_sharpness())) return YES;   /* Ember Auto HDR */
+    return fg_draw_sharp(cb, cur, prv, w, dst, fg_sharpness());
+}
+
+/* 화면으로 나가는 프레임 한 장 + Ember 게임 화면 안 HUD(보스 기믹·엠버 말풍선·토스트 판, 있을 때만 — ember_hud_d3dm.h) */
+static BOOL fg_draw(id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float w, id<MTLTexture> dst)
+{
+    BOOL ok = fg_draw_frame(cb, cur, prv, w, dst);
+    ember_hud_draw(cb, dst, ehud_proxy_real);
+    return ok;
+}
+
+static BOOL fg_draw_sharp(id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float w, id<MTLTexture> dst, float sharp)
+{
+    struct { float w, sharp; } params = { w, sharp };
+    id<MTLRenderPipelineState> ps = fg_pipeline(cb.device, dst.pixelFormat);
+    MTLRenderPassDescriptor *rp;
+    id<MTLRenderCommandEncoder> enc;
+
+    if (!ps) return NO;
+    rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture = dst;
+    rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    enc = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!enc) return NO;
+    [enc setRenderPipelineState:ps];
+    [enc setFragmentTexture:cur atIndex:0];
+    [enc setFragmentTexture:prv atIndex:1];
+    [enc setFragmentBytes:&params length:sizeof(params) atIndex:0];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [enc endEncoding];
+    return YES;
+}
+
+static double fg_envf(const char *name, double def)
+{
+    const char *e = getenv(name);
+    return e && *e ? atof(e) : def;
+}
+
+/* ---- EMBER_FG_DUMP: 보간 프레임과 앞뒤 원본을 PPM 으로(DXMT queueFrameDump/flushFrameDumps 와 같은 파일 이름·meta) ---- */
+static const char *fg_dump_dir(void)
+{
+    static const char *dir; static int init;
+    if (!init) { dir = getenv("EMBER_FG_DUMP"); if (dir && !*dir) dir = NULL; init = 1; }
+    return dir;
+}
+
+static BOOL fg_write_ppm(const char *path, id<MTLTexture> t)
+{
+    NSUInteger w = t.width, h = t.height, i;
+    unsigned char *px = malloc(w * h * 4);
+    FILE *f;
+    if (!px) return NO;
+    [t getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    if (!(f = fopen(path, "wb"))) { free(px); return NO; }
+    fprintf(f, "P6\n%lu %lu\n255\n", (unsigned long)w, (unsigned long)h);
+    for (i = 0; i < w * h; i++) fwrite(px + i * 4, 1, 3, f);
+    fclose(f);
+    free(px);
+    return YES;
+}
+
+static void fg_dump_queue(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<MTLTexture> prev, id<MTLTexture> cur, float w_prev, id<MTLTexture> mc_tex)
+{
+    BOOL mc = mc_tex != nil;
+    const char *dir = fg_dump_dir();
+    NSUInteger w = cur.width, h = cur.height;
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+    id<MTLTexture> dprev, dcur, dblend, dmc = nil;
+    uint64_t frame = p->frame_no;
+    float alpha = 1.0f - w_prev;
+    td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    td.storageMode = MTLStorageModeShared;
+    dprev = [cb.device newTextureWithDescriptor:td];
+    dcur = [cb.device newTextureWithDescriptor:td];
+    dblend = [cb.device newTextureWithDescriptor:td];
+    if (mc) dmc = [cb.device newTextureWithDescriptor:td];
+    if (!dprev || !dcur || !dblend || (mc && !dmc)) { [dprev release]; [dcur release]; [dblend release]; [dmc release]; return; }
+    fg_draw_sharp(cb, prev, prev, 0.0f, dprev, 0);
+    fg_draw_sharp(cb, cur, cur, 0.0f, dcur, 0);
+    fg_draw_sharp(cb, cur, prev, w_prev, dblend, 0);
+    if (mc) fg_draw_sharp(cb, mc_tex, mc_tex, 0.0f, dmc, 0);
+    p->dumps_queued++;
+    p->last_dump_frame = frame;
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_LOW, 0), ^{
+            char base[1024];
+            char path[1100];
+            FILE *f;
+            BOOL ok;
+            float conf = -1;
+            /* 레이어를 붙잡아 엔진 컨텍스트가 살아 있게. 마지막 MC 프레임의 평균 신뢰도(엔진 통계) */
+            if (p->fge_ctx)
+            {
+                struct fge_stats st;
+                memset(&st, 0, sizeof(st));
+                st.size = sizeof(st);
+                fge.get_stats(p->fge_ctx, fge_ns(CACurrentMediaTime()), &st);
+                conf = (float)st.dump_mean_conf;
+            }
+            snprintf(base, sizeof(base), "%s/fg_%06llu", dir, (unsigned long long)frame);
+            snprintf(path, sizeof(path), "%s_prev.ppm", base); ok = fg_write_ppm(path, dprev);
+            snprintf(path, sizeof(path), "%s_cur.ppm", base); ok = fg_write_ppm(path, dcur) && ok;
+            snprintf(path, sizeof(path), "%s_blend.ppm", base); ok = fg_write_ppm(path, dblend) && ok;
+            if (dmc) { snprintf(path, sizeof(path), "%s_mc.ppm", base); ok = fg_write_ppm(path, dmc) && ok; }
+            snprintf(path, sizeof(path), "%s_meta.txt", base);
+            if ((f = fopen(path, "w")))
+            {
+                fprintf(f, "frame=%llu\nalpha=%.6f\nmc=%d\nmean_conf=%.4f\nwidth=%lu\nheight=%lu\nfmt_cur=%d\nfmt_gen=%d\n",
+                        (unsigned long long)frame, alpha, (int)mc, conf, (unsigned long)w, (unsigned long)h, (int)cur.pixelFormat, (int)dblend.pixelFormat);
+                fclose(f);
+            }
+            fprintf(stderr, "ember-d3dm-fg-dump: %s %s alpha=%.3f mc=%d\n", base, ok ? "ok" : "FAILED", alpha, (int)mc);
+            [dprev release]; [dcur release]; [dblend release]; [dmc release];
+        });
+    }];
+}
+
+/* ---- MTLCommandBuffer presentDrawable: 가로채기 ---- */
+
+static IMP orig_present, orig_present_min, orig_present_at;
+
+static pthread_mutex_t fg_stat_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* This lock is also used by the original-only feedback snapshot below. */
+static void fg_stage(EmberFGLayer *p, unsigned int stage)
+{
+    pthread_mutex_lock(&fg_stat_lock);
+    p->stage[stage]++;
+    pthread_mutex_unlock(&fg_stat_lock);
+}
+
+static int fg_transport_pending(EmberFGLayer *p)
+{
+    int count;
+    pthread_mutex_lock(&fg_stat_lock);
+    count = p->outstanding;
+    pthread_mutex_unlock(&fg_stat_lock);
+    return count;
+}
+
+static void fg_observe_gpu(EmberFGLayer *p, id<MTLCommandBuffer> cb, BOOL auxiliary)
+{
+    if (p->link_adapter && auxiliary) [p->link_adapter trackLegacy:cb];
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        double dt = done.GPUEndTime - done.GPUStartTime;
+        if (done.status == MTLCommandBufferStatusCompleted && done.GPUStartTime > 0 && dt > 0 && dt < 10)
+        {
+            pthread_mutex_lock(&fg_stat_lock);
+            if (auxiliary) { p->aux_gpu_sum += dt; p->aux_gpu_n++; }
+            else { p->game_gpu_sum += dt; p->game_gpu_n++; }
+            pthread_mutex_unlock(&fg_stat_lock);
+        }
+    }];
+}
+
+static void fg_observe_presented(EmberFGLayer *p, double handed, double t)
+{
+    BOOL original = handed > 0;
+    pthread_mutex_lock(&fg_stat_lock);
+    if (t > 0) p->stage[original ? FGS_PRESENT_O : FGS_PRESENT_G]++;
+    else p->stage[original ? FGS_ZERO_O : FGS_ZERO_G]++;
+    if (original && t > handed && t - handed < 1.0)
+    {
+        unsigned int i = p->recent_i++ % FG_LAT_SAMPLES;
+        p->lat_sum += t - handed;
+        p->lat_n++;
+        if (t - handed > p->lat_max) p->lat_max = t - handed;
+        p->recent_lat[i] = t - handed;
+        /* presentedTime uses the CACurrentMediaTime clock. Receipt can be delayed or reordered:
+         * it must not refresh stale feedback or relabel a pre-pause image as a native baseline. */
+        p->recent_at[i] = t;
+        if (t > p->latest_sample) p->latest_sample = t;
+    }
+    pthread_mutex_unlock(&fg_stat_lock);
+}
+
+/* Snapshot is taken before interpolation copy/encode. ABI 1.1 keeps latency=0 so its old
+ * absolute 2.8-display-period guard cannot misclassify a normal ~21ms baseline. */
+static void fg_feedback(EmberFGLayer *p, double now, struct fge_frame_in *in)
+{
+    unsigned int i, n = 0;
+    double sum = 0;
+    if (!fge_telemetry) return;
+    pthread_mutex_lock(&fg_stat_lock);
+    for (i = 0; i < FG_LAT_SAMPLES; ++i)
+        if (p->recent_at[i] > 0 && now >= p->recent_at[i] && now - p->recent_at[i] <= FG_LAT_WINDOW)
+        { sum += p->recent_lat[i]; n++; }
+    in->display_latency_ms = n ? sum * 1000 / n : 0;
+    in->latency_sample_ns = fge_ns(p->latest_sample);
+    in->transport_start_ns = fge_ns(p->transport_start);
+    in->transport_outstanding = p->outstanding;
+    in->telemetry_flags = 1;
+    pthread_mutex_unlock(&fg_stat_lock);
+}
+
+/* drawable 을 내보내고 실제 표시를 센다. presentedTime 0은 취소이며 표시 지연 표본에 넣지 않는다. */
+static void fg_submit(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<CAMetalDrawable> d, double min_dur, double handed)
+{
+#if EMBER_FG_HDR_GUARD
+    /* Old asynchronous jobs must not present after HDR takes ownership. */
+    if (__sync_add_and_fetch(&p->hdr_original_only, 0)) return;
+#endif
+
+    @synchronized (p->link_adapter) {
+    if (p->link_adapter && ![p->link_adapter allowLegacyPresent]) return;
+    fg_stage(p, handed > 0 ? FGS_SUBMIT_O : FGS_SUBMIT_G);
+    if (@available(macOS 10.15.4, *))
+    {
+        __sync_fetch_and_add(&p->pending, 1);
+        [d addPresentedHandler:^(id<MTLDrawable> dr) {
+            __sync_fetch_and_sub(&p->pending, 1);
+            fg_observe_presented(p, handed, dr.presentedTime);
+        }];
+    }
+    if (min_dur > 0)
+        ((void (*)(id, SEL, id, CFTimeInterval))orig_present_min)(cb, @selector(presentDrawable:afterMinimumDuration:), d, min_dur);
+    else
+        ((void (*)(id, SEL, id))orig_present)(cb, @selector(presentDrawable:), d);
+    }
+}
+
+/* Ember(표시 방식 고정, 10-02): 보충형은 보간 프레임을 평범한 present 로, 원본을 presentDrawable:afterMinimumDuration: 으로 냈다.
+ * macOS 는 최소 간격 표시를 늘 합성(Composited, FramePacing detach 0xE0017)으로, 평범한 present 는 직접 표시(Direct)로 돌려서
+ * Metal HUD 가 프레임마다 Direct↔Composited 를 오갔다(원스휴먼 실측: 걷기 17초에 전환 1791번, 사용자 관찰 "번갈아 표시").
+ * 수직동기 끈 레이어의 Direct 는 화면 칸과 상관없이 바로 바꿔 단다(실측: 원본이 보간 3ms 뒤에 뜸 = 찢김·3ms/13.6ms 박자).
+ * EMBER_FG_PRESENT 0 = 예전, 1(기본) = 보간이 켜진 동안 진짜 레이어 수직동기 켬 — 모든 프레임이 합성·수직동기 칸에 차례대로
+ *   (DXMT 링 표시와 같은 방식, 전환·찢김 없음). 보간이 쉬면 게임이 준 값으로 돌아간다(켜고 끌 때만 한 번 바뀜).
+ * 2 = 실험: 원본을 앞 보간 프레임이 뜬 직후 평범한 present(Direct 유지, 대신 위 찢김). 시험: C:\ember-d11.cfg 의 EMBER_FG_PRESENT=. */
+static int fg_present_mode(void)
+{
+    static int env = -2, file_v = -1;
+    static double next_read;
+    double now = CACurrentMediaTime();
+    if (env == -2) { const char *v = getenv("EMBER_FG_PRESENT"); env = v && *v ? atoi(v) : 1; }
+    /* 보틀의 C:\ember-d11.cfg 에 EMBER_FG_PRESENT= 이 있으면 그 값(약 1초마다 다시 읽음 — 같은 장면 A/B) */
+    if (now >= next_read)
+    {
+        const char *pfx = getenv("WINEPREFIX");
+        char path[1024], line[256];
+        int v = -1;
+        FILE *f;
+        next_read = now + 1.0;
+        if (pfx && *pfx)
+        {
+            snprintf(path, sizeof(path), "%s/drive_c/ember-d11.cfg", pfx);
+            if ((f = fopen(path, "r")))
+            {
+                while (fgets(line, sizeof(line), f))
+                    if (!strncmp(line, "EMBER_FG_PRESENT=", 17)) v = atoi(line + 17);
+                fclose(f);
+            }
+        }
+        if (v != file_v && fg_log()) fprintf(stderr, "ember-d3dm-fg: EMBER_FG_PRESENT(cfg)=%d\n", v);
+        file_v = v;
+    }
+    return file_v >= 0 ? file_v : env;
+}
+
+/* 진짜 레이어 수직동기: 게임(D3DMetal)이 준 값, 보간 중(방식 1)에는 켬 */
+static void fg_apply_sync(EmberFGLayer *p)
+{
+    BOOL want = p->game_sync || (p->active && fg_present_mode() == 1 && fg_generate());
+    if (p->real && p->real.displaySyncEnabled != want)
+    {
+        p->real.displaySyncEnabled = want;
+        if (fg_log()) fprintf(stderr, "ember-d3dm-fg: display sync %d (game %d, active %d)\n", want, p->game_sync, p->active);
+    }
+}
+
+/* 보간 프레임이 화면에 뜬 시각을 보조 스레드에 넘기는 표(처리기 스레드 → 보조 스레드). 버려지면 t = 0 */
+@interface EmberFGTicket : NSObject
+{
+@public
+    dispatch_semaphore_t sem;
+    volatile double t;
+}
+@end
+@implementation EmberFGTicket
+- (id)init { if ((self = [super init])) sem = dispatch_semaphore_create(0); return self; }
+- (void)dealloc { dispatch_release(sem); [super dealloc]; }
+@end
+
+static unsigned int fg_direct_late, fg_direct_timeout, fg_direct_n;   /* 5초 통계(로그) */
+
+/* fg_submit 과 같은 지연 측정, 표시는 drawable 의 평범한 present(GPU 작업은 이미 끝남) */
+static void fg_submit_direct(EmberFGLayer *p, id<CAMetalDrawable> d, double handed)
+{
+#if EMBER_FG_HDR_GUARD
+    /* Old asynchronous jobs must not present after HDR takes ownership. */
+    if (__sync_add_and_fetch(&p->hdr_original_only, 0)) return;
+#endif
+
+    @synchronized (p->link_adapter) {
+    if (p->link_adapter && ![p->link_adapter allowLegacyPresent]) return;
+    fg_stage(p, FGS_SUBMIT_O);
+    if (@available(macOS 10.15.4, *))
+    {
+        __sync_fetch_and_add(&p->pending, 1);
+        [d addPresentedHandler:^(id<MTLDrawable> dr) {
+            __sync_fetch_and_sub(&p->pending, 1);
+            fg_observe_presented(p, handed, dr.presentedTime);
+        }];
+    }
+    [d present];
+    }
+}
+
+static id<CAMetalDrawable> fg_next(EmberFGLayer *p)
+{
+    if (p->link_adapter) return [p->link_adapter takeLegacyDrawable];
+    double t0 = CACurrentMediaTime();
+    id<CAMetalDrawable> d = [p->real nextDrawable];
+    p->wait_sum += CACurrentMediaTime() - t0;
+    return d;
+}
+
+static BOOL fg_ensure_ring(EmberFGLayer *p, id<MTLTexture> cur)
+{
+    int i;
+    if (!p->ring[0] || p->ring[0].width != cur.width || p->ring[0].height != cur.height ||
+        p->ring[0].pixelFormat != cur.pixelFormat)
+    {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:cur.pixelFormat
+                                                                                       width:cur.width
+                                                                                      height:cur.height
+                                                                                   mipmapped:NO];
+        if (fg_transport_pending(p) > 0) return NO;   /* 보조 스레드가 옛 링을 읽는 중 — 이번 프레임은 예전 경로로 */
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModePrivate;
+        for (i = 0; i < 4; i++) { [p->ring[i] release]; p->ring[i] = [cur.device newTextureWithDescriptor:td]; }
+        p->ring_i = 0;
+        p->ring_prev = NO;
+    }
+    if (!p->hq) p->hq = [cur.device newCommandQueue];
+    if (!p->ev) p->ev = [cur.device newEvent];
+    if (!p->dq) p->dq = dispatch_queue_create("ember.framegen", DISPATCH_QUEUE_SERIAL);
+    return p->ring[0] && p->hq && p->ev && p->dq;
+}
+
+/* 엔진 MC: cur·prv(같은 크기) 사이 보간 프레임을 같은 커맨드 버퍼에 만든다. 결과는 엔진 소유 텍스처(추적 텍스처라 뒤의 표시 패스와
+ * GPU 순서가 저절로 맞는다). 못 만들면 nil — 혼합으로. */
+static id<MTLTexture> fg_engine_mc(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<MTLTexture> cur, id<MTLTexture> prv, float alpha)
+{
+    static struct fge_encode_in in;   /* 게임 스레드 하나(present 가로채기)에서만 — 2KB 를 스택에 두지 않는다 */
+    struct fge_encode_out o;
+    memset(&in, 0, sizeof(in));
+    in.size = sizeof(in);
+    in.command_buffer = (uint64_t)(uintptr_t)cb;
+    in.current = (uint64_t)(uintptr_t)cur;
+    in.previous = (uint64_t)(uintptr_t)prv;
+    in.alpha = alpha;
+    memset(&o, 0, sizeof(o));
+    o.size = sizeof(o);
+    if (!fge.encode(p->fge_ctx, &in, &o) || !o.ok || !o.texture) return nil;
+    return (id<MTLTexture>)(uintptr_t)o.texture;
+}
+
+/* ANE is an engine service, independent of serial-presenter admission. This
+ * context is only entered when legacy work is idle. It is retained by the
+ * helper and GPU completion; device replacement cannot destroy live resources. */
+@interface EmberFGLegacyANE : NSObject {
+@public
+    void *encoder;
+    id<MTLDevice> device;
+    id<MTLTexture> previous;
+    id<MTLCommandBuffer> producer;
+    uint64_t snapshot_sequence;
+    volatile uint64_t latest;
+    double arrival, logged;
+    unsigned smooth_busy, smooth_drawable_busy;
+    uint64_t smooth_pairs, smooth_used, smooth_late, smooth_over, smooth_samples;
+    uint64_t pair_reason[4], pair_admitted, pair_rejected;
+    double smooth_sum, smooth_max, smooth_interval;
+    uint64_t prism_submitted, prism_used, prism_samples;
+    double prism_sum, prism_max, prism_budget, prism_extra_cap;
+    BOOL prism_transport;
+    BOOL smooth_hold_only;
+    int64_t smooth_hold_config;
+    uint64_t smooth_hold_samples;
+    double smooth_hold_sum;
+}
+- (id)initWithDevice:(id<MTLDevice>)dev;
+@end
+@implementation EmberFGLegacyANE
+- (id)initWithDevice:(id<MTLDevice>)dev {
+    if ((self = [super init])) {
+        device = [dev retain];
+        encoder = fge.create2((uint64_t)(uintptr_t)dev, NULL, 0, FGE_HOST_D3DMETAL);
+    }
+    return self;
+}
+- (void)dealloc {
+    if (encoder) fge.destroy(encoder);
+    [device release]; [previous release]; [producer release]; [super dealloc];
+}
+@end
+static BOOL fg_legacy_ane_previous(EmberFGLayer *p) {
+    EmberFGLegacyANE *s = p->legacy_ane;
+    return s && s->previous && s->snapshot_sequence + 1 == p->frame_no;
+}
+static int fg_ane_submit(EmberFGLayer *p, void *encoder, const ember_fg_ane_submit_in *request)
+{
+    const char *source = fg_ane_source();
+    if (source && !strcmp(source, "llfi")) {
+        unsigned reason = fg_llfi_color_rejection(p.colorspace);
+        if (reason) {
+            if (reason & FG_LLFI_COLOR_EXTENDED) ++p->llfi_reject_extended;
+            if (reason & FG_LLFI_COLOR_HDR_TF) ++p->llfi_reject_hdr_tf;
+            double now = CACurrentMediaTime();
+            if (!p->llfi_color_logged || now - p->llfi_color_logged >= 5.0) {
+                id<MTLTexture> texture = (id<MTLTexture>)(uintptr_t)request->current;
+                fprintf(stderr, "ember-fg-ane-host: source=llfi reject=color-space format=%lu edr=%d "
+                        "reject_extended=%llu reject_hdr_tf=%llu layer=%p\n",
+                        (unsigned long)texture.pixelFormat, (int)p.wantsExtendedDynamicRangeContent,
+                        (unsigned long long)p->llfi_reject_extended,
+                        (unsigned long long)p->llfi_reject_hdr_tf, (void *)p);
+                p->llfi_color_logged = now;
+            }
+            return 0;
+        }
+    }
+    return fge.ane_submit(encoder, request);
+}
+static BOOL fg_legacy_ane(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<MTLTexture> cur,
+                          double now, double disp, const struct fge_frame_plan *plan) {
+    /* Rejected admission must release any reserved drawable/output CB before
+     * the caller immediately retries the legacy path. Accepted dispatch blocks
+     * retain these objects across this pool. */
+    @autoreleasepool {
+    const char *reuse = getenv("EMBER_FG_ANE_REUSE");
+    if (!reuse || strcmp(reuse, "1")) return NO;
+    const char *requested = getenv("EMBER_FG_ANE");
+    if (!requested || strcmp(requested, "1") || !fge.ane_submit || fg_present_mode() != 1 ||
+        p->neural || p->ahdr || ember_up_enabled() || !p->real.allowsNextDrawableTimeout ||
+        fg_transport_pending(p) || cb.status >= MTLCommandBufferStatusCommitted ||
+        cur.device != cb.device || p->hq.device != cb.device || p->ev.device != cb.device ||
+        !((cur.width == 1920 && cur.height == 1080) || (cur.width == 2560 && cur.height == 1440))) return NO;
+    EmberFGLegacyANE *s = p->legacy_ane;
+    if (!s || s->device != cb.device) {
+        [s release]; p->legacy_ane = s = [[EmberFGLegacyANE alloc] initWithDevice:cb.device];
+        fprintf(stderr, "ember-fg-ane-legacy: independent=1 no-inference-wait=1\n");
+    }
+    if (!s->encoder) return NO;
+    __sync_lock_test_and_set(&s->latest, p->frame_no);
+    const int64_t previous_arrival = fge_ns(s->arrival);
+    double interval = s->arrival > 0 ? now - s->arrival : 0; s->arrival = now;
+    BOOL pair = fg_legacy_ane_previous(p) && s->previous.width == cur.width &&
+        s->previous.height == cur.height && s->previous.pixelFormat == cur.pixelFormat &&
+        s->producer.commandQueue == cb.commandQueue && s->producer != cb &&
+        s->producer.status >= MTLCommandBufferStatusCommitted;
+    if (!(plan->flags & (FGE_PLAN_KEEP_PREVIOUS | FGE_PLAN_GENERATE))) {
+        [s->previous release]; s->previous = nil; return NO;
+    }
+    /* Immutable per-frame snapshot: a retained ring texture can still be
+     * overwritten four arrivals later while ANE or the helper GPU reads it. */
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:cur.pixelFormat
+        width:cur.width height:cur.height mipmapped:NO];
+    td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+    td.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> current = [cb.device newTextureWithDescriptor:td];
+    id<MTLTexture> previous = [s->previous retain];
+    id<MTLBlitCommandEncoder> blit = current ? [cb blitCommandEncoder] : nil;
+    if (!blit) { [current release]; [previous release]; return NO; }
+    [blit copyFromTexture:cur toTexture:current]; [blit endEncoding];
+    [s->previous release]; s->previous = [current retain]; s->snapshot_sequence = p->frame_no;
+    [s->producer release]; s->producer = [cb retain];
+    if (!pair || !(plan->flags & FGE_PLAN_GENERATE) || !(plan->flags & FGE_PLAN_MC)) {
+        [current release]; [previous release]; return NO;
+    }
+    struct fge_frame_in input = {0}; struct fge_frame_plan ignored = {0};
+    input.size = sizeof(input); input.flags = FGE_IN_FRAMEGEN | FGE_IN_PREV_VALID;
+    input.now_ns = fge_ns(now); input.frame_no = p->frame_no; input.display_interval = disp;
+    fg_feedback(p, now, &input); ignored.size = sizeof(ignored);
+    fge.begin_frame(s->encoder, &input, &ignored);
+    ember_fg_ane_submit_in request = {0}; request.size = sizeof(request);
+    request.command_buffer = (uint64_t)(uintptr_t)cb;
+    request.current = (uint64_t)(uintptr_t)current; request.previous = (uint64_t)(uintptr_t)previous;
+    request.pair_id = p->frame_no;
+    const int64_t optional_deadline = efal_deadline(fge_ns(now), fge_ns(interval), fge_ns(disp));
+    request.source_time_ns = fge_ns(now);
+    /* Subtract converted timestamps, not converted doubles, for exact adjacency. */
+    request.interval_ns = previous_arrival > 0 ? fge_ns(now) - previous_arrival : 0;
+    request.reuse_previous = 1;
+    int64_t inference_gap = request.interval_ns;
+    if (inference_gap < 4000000LL || inference_gap > 50000000LL) inference_gap = fge_ns(disp);
+    request.deadline_ns = request.source_time_ns + 2 * inference_gap;
+    /* Reserve and encode the ORIGINAL before accepting this route. Failures
+     * here return to legacy while the producer is still editable. The helper
+     * can never lose an admitted original through optional drawable failure. */
+    id<CAMetalDrawable> original = fg_next(p);
+    id<MTLCommandBuffer> output = original ? [p->hq commandBuffer] : nil;
+    const uint64_t value = ++p->ev_value;
+    id<MTLEvent> ready = p->ev;
+    if (!output || original.texture.device != s->device || output.device != s->device) {
+        [current release]; [previous release]; return NO;
+    }
+    [output encodeWaitForEvent:ready value:value];
+    if (!fg_draw(output, current, current, 0, original.texture)) {
+        [current release]; [previous release]; return NO;
+    }
+    /* Busy inference is a dropped prefetch, not a rejected original or seed lookup. */
+    fg_ane_submit(p, s->encoder, &request);
+    [cb encodeSignalEvent:ready value:value];
+    /* Existing helper submission point; no timer, inference wait, producer
+     * commit interception. The previous pair is a seed; original is already safe. */
+    const struct fge_frame_plan captured = *plan;
+    pthread_mutex_lock(&fg_stat_lock);
+    if (!p->outstanding) p->transport_start = now;
+    ++p->outstanding; pthread_mutex_unlock(&fg_stat_lock);
+    p->ring_prev = NO; /* legacy ring does not contain this snapshot */
+    dispatch_async(p->dq, ^{ @autoreleasepool {
+        id<CAMetalDrawable> generated = nil;
+        BOOL optional = p->real.device == s->device &&
+            efal_optional(request.pair_id, __sync_add_and_fetch(&s->latest, 0),
+                          fge_ns(CACurrentMediaTime()), optional_deadline);
+        if (optional && p->real.maximumDrawableCount >= 3 && p->pending == 0)
+            generated = p->link_adapter ? [p->link_adapter takeLegacyDrawable] : [p->real nextDrawable]; /* (wm-merge) off = 배포판 그대로(wait_sum 미포함) */
+        optional = optional && generated && generated.texture.device == s->device &&
+            efal_optional(request.pair_id, __sync_add_and_fetch(&s->latest, 0),
+                          fge_ns(CACurrentMediaTime()), optional_deadline);
+        const double decision = CACurrentMediaTime();
+        {
+            if (optional) {
+                struct fge_encode_in in = {0}; struct fge_encode_out result = {0};
+                in.size = sizeof(in); result.size = sizeof(result);
+                in.command_buffer = (uint64_t)(uintptr_t)output;
+                in.current = request.current; in.previous = request.previous;
+                in.ane_pair_id = request.pair_id; in.alpha = captured.blend_weight;
+                id<MTLTexture> mc = nil;
+                if (fge.encode(s->encoder, &in, &result) && result.ok)
+                    mc = (id<MTLTexture>)(uintptr_t)result.texture;
+                optional = fg_draw(output, mc ? mc : current, mc ? mc : previous,
+                    mc ? 0 : 1.0f - captured.blend_weight, generated.texture);
+                /* Drawable acquisition/encode can consume the whole budget. */
+                optional = optional && efal_optional(request.pair_id, __sync_add_and_fetch(&s->latest, 0),
+                                                      fge_ns(CACurrentMediaTime()), optional_deadline);
+            }
+            if (optional) {
+                fg_stage(p, FGS_ENCODE_G); fg_submit(p, output, generated, 0, 0);
+                __sync_fetch_and_add(&p->count_out, 1); __sync_fetch_and_add(&p->gen_total, 1);
+            } else { fg_stage(p, FGS_CANCEL_STALE); __sync_fetch_and_add(&p->dropped, 1); }
+            fg_stage(p, FGS_ENCODE_O); fg_observe_gpu(p, output, YES);
+            fg_submit(p, output, original, optional ? (captured.cadence_hold > 0 ? captured.cadence_hold : disp * 0.9) : 0, now);
+            __sync_fetch_and_add(&p->count_out, 1);
+            /* Objects must survive GPU work even if the next arrival/device
+             * replaces the snapshot/context. Retaining the source alone does
+             * not retain its engine output or event. */
+            [output addCompletedHandler:^(id<MTLCommandBuffer> done) {
+                (void)s; (void)current; (void)previous; (void)ready;
+                if (done.status != MTLCommandBufferStatusCompleted)
+                    fprintf(stderr, "ember-fg-ane-legacy: command-buffer-error pair=%llu\n", (unsigned long long)request.pair_id);
+            }];
+            [output commit];
+        }
+        double consumed = CACurrentMediaTime();
+        if (consumed - s->logged >= 5) {
+            s->logged = consumed;
+            fprintf(stderr, "ember-fg-ane-legacy: pair=%llu decision_ms=%.3f submit_ms=%.3f budget_ms=%.3f optional=%d\n",
+                (unsigned long long)request.pair_id, (decision-now)*1000, (consumed-now)*1000, (optional_deadline-fge_ns(now))/1e6, optional);
+        }
+        [current release]; [previous release];
+        pthread_mutex_lock(&fg_stat_lock);
+        if (!--p->outstanding) p->transport_start = 0;
+        pthread_mutex_unlock(&fg_stat_lock);
+    }});
+    return YES;
+    }
+}
+
+#include "fg_ane_smooth_metal.h"
+
+/* 보충형 한 프레임(운반). 보간할지·MC·박자는 엔진이 정한 plan 대로.
+ * 게임 스레드: 원본을 링에 복사 → (보간이면) 보간 프레임만 바로 표시 → 돌아간다.
+ * 보조 스레드: 화면 버퍼가 날 때 원본을 표시(보간 뒤 한 칸, 박자가 2칸이면 두 칸). 보조 스레드에 아직 못 낸 원본이 있으면
+ * (원본이 앞섬) 보간을 버리고 원본도 그 뒤에 줄 세운다 — 순서를 지키고 대기열을 늘리지 않는다. */
+static void fg_present_fill(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<MTLTexture> cur, double now, double disp,
+                            const struct fge_frame_plan *plan)
+{
+    if (fg_legacy_ane(p, cb, cur, now, disp, plan)) return;
+    int i = (p->ring_i + 1) % 4, prev = p->ring_i;
+    BOOL generate = (plan->flags & FGE_PLAN_GENERATE) != 0;
+    /* 링 복사는 보간이 켜져 있거나 곧 켜질 때만(엔진 KEEP_PREVIOUS — 쉴 때·가드 중엔 프레임마다 전체 화면 복사 한 장을 아낀다) */
+    BOOL copy = generate || (plan->flags & FGE_PLAN_KEEP_PREVIOUS);
+    BOOL interp = generate && p->ring_prev;
+    id<MTLBlitCommandEncoder> blit;
+    id<CAMetalDrawable> out = nil;
+    EmberFGTicket *ticket = nil;
+
+    if (copy)
+    {
+        blit = [cb blitCommandEncoder];
+        [blit copyFromTexture:cur toTexture:p->ring[i]];
+        [blit endEncoding];
+    }
+    if (interp && fg_transport_pending(p) > 0) { interp = NO; p->dropped++; fg_stage(p, FGS_CANCEL_STALE); fge.note_drop(p->fge_ctx, FGE_DROP_STALE); }
+    if (interp && !(out = fg_next(p))) { interp = NO; p->dropped++; fg_stage(p, FGS_CANCEL_DRAWABLE); fge.note_drop(p->fge_ctx, FGE_DROP_NO_DRAWABLE); }
+    if (interp)
+    {
+        float w = 1.0f - plan->blend_weight;   /* 혼합일 때 이전 프레임 비중(엔진 기본 반반, EMBER_FG_ALPHA=1 이면 표시 시각 비중) */
+        id<MTLTexture> mc_tex = (plan->flags & FGE_PLAN_MC) ? fg_engine_mc(p, cb, p->ring[i], p->ring[prev], plan->blend_weight) : nil;
+        if (mc_tex) { fg_draw(cb, mc_tex, mc_tex, 0.0f, out.texture); p->mc_frames++; }
+        else fg_draw(cb, p->ring[i], p->ring[prev], w, out.texture);
+        if (fg_dump_dir() && p->dumps_queued < (int)fg_envf("EMBER_FG_DUMP_COUNT", 3) &&
+            p->frame_no >= (uint64_t)fg_envf("EMBER_FG_DUMP_AT", 120) && p->frame_no >= p->last_dump_frame + 5)
+            fg_dump_queue(p, cb, p->ring[prev], p->ring[i], w, mc_tex);
+        if (fg_present_mode() == 2 && !p->real.displaySyncEnabled)
+        {
+            if (@available(macOS 10.15.4, *))
+            {
+                EmberFGTicket *tk = [[EmberFGTicket alloc] init];
+                [out addPresentedHandler:^(id<MTLDrawable> dr) { tk->t = dr.presentedTime; dispatch_semaphore_signal(tk->sem); }];
+                ticket = tk;
+            }
+        }
+        fg_stage(p, FGS_ENCODE_G);
+        fg_submit(p, cb, out, 0, 0);
+        __sync_fetch_and_add(&p->count_out, 1);
+        p->gen_total++;
+    }
+
+    if (interp)
+    {
+        uint64_t v = ++p->ev_value;
+        id<MTLTexture> tex = [p->ring[i] retain];
+        EmberFGTicket *tk = ticket;   /* 블록이 가져간다(release 는 블록 안에서) */
+        /* 원본은 보간 프레임이 최소 이만큼 떠 있은 뒤 — 엔진 박자(고정 주사율 30~37fps 면 2칸, VRR 이면 게임 간격 절반), 아니면 한 칸 */
+        double handed = now, min_dur = plan->cadence_hold > 0 ? plan->cadence_hold : disp * 0.9;
+        [cb encodeSignalEvent:p->ev value:v];
+        pthread_mutex_lock(&fg_stat_lock);
+        if (!p->outstanding) p->transport_start = now;
+        p->outstanding++;
+        pthread_mutex_unlock(&fg_stat_lock);
+        dispatch_async(p->dq, ^{
+            @autoreleasepool
+            {
+                id<CAMetalDrawable> d2 = p->link_adapter ? [p->link_adapter takeLegacyDrawable] : [p->real nextDrawable]; /* (wm-merge) off = 배포판 그대로 */
+                if (d2)
+                {
+                    id<MTLCommandBuffer> hc = [p->hq commandBuffer];
+                    [hc encodeWaitForEvent:p->ev value:v];
+                    fg_draw(hc, tex, tex, 0.0f, d2.texture);
+                    fg_stage(p, FGS_ENCODE_O);
+                    fg_observe_gpu(p, hc, YES);
+                    if (tk)
+                    {
+                        /* Direct 유지: 복사를 끝내 두고, 보간 프레임이 뜬 직후(그 칸이 열린 뒤) 평범한 present → 다음 칸 */
+                        int k = (int)floor(min_dur / disp + 0.15);
+                        long w;
+                        if (k < 1) k = 1;
+                        [hc commit];
+                        [hc waitUntilCompleted];
+                        w = dispatch_semaphore_wait(tk->sem, dispatch_time(DISPATCH_TIME_NOW, (int64_t)((3 * disp + 0.02) * 1e9)));
+                        if (w) fg_direct_timeout++;
+                        else if (tk->t > 0)
+                        {
+                            double at = tk->t + (k - 1) * disp + 0.0005, now2 = CACurrentMediaTime();
+                            if (k > 1 && at > now2) usleep((useconds_t)((at - now2) * 1e6));
+                            else if (now2 - tk->t > disp * 0.6) fg_direct_late++;   /* 처리기가 늦게 와 다음 칸을 놓쳤을 수 있다 */
+                        }
+                        fg_direct_n++;
+                        fg_submit_direct(p, d2, handed);
+                    }
+                    else
+                    {
+                        fg_submit(p, hc, d2, min_dur, handed);
+                        [hc commit];
+                    }
+                    __sync_fetch_and_add(&p->count_out, 1);
+                }
+                else fg_stage(p, FGS_CANCEL_DRAWABLE);
+                [tk release];
+                [tex release];
+                pthread_mutex_lock(&fg_stat_lock);
+                if (!--p->outstanding) p->transport_start = 0;
+                pthread_mutex_unlock(&fg_stat_lock);
+            }
+        });
+    }
+    else
+    {
+        /* 통과(원본만, 보간 없음·쉼·버림 모두): 게임 스레드가 직접 화면 버퍼를 받아 낸다 — 보간 끔과 같은 경로·같은 되먹임(vsync 에 막힘).
+         * 보조 스레드에 아직 못 낸 원본이 있으면(직전 프레임이 보간이었다) 그것이 나갈 때까지만 기다려 순서를 지킨다(길어야 화면 한 칸).
+         * (예전에 원본을 또 보조 스레드에 넘기던 방식은 원본이 dispatch 큐에 한없이 쌓였다 — 09-29 Frame Check 120Hz: lat 58→235ms) */
+        if (fg_transport_pending(p) > 0) dispatch_sync(p->dq, ^{});
+        if ((out = fg_next(p)))
+        {
+            fg_draw(cb, cur, cur, 0.0f, out.texture);
+            fg_stage(p, FGS_ENCODE_O);
+            fg_submit(p, cb, out, 0, now);
+            __sync_fetch_and_add(&p->count_out, 1);
+        }
+        else fg_stage(p, FGS_CANCEL_DRAWABLE);
+    }
+    if (copy) p->ring_i = i;
+    p->ring_prev = copy;
+}
+
+/* Batch transport is fail-closed. Engine output leases do not prove original
+ * ordering, the legacy original lifetime bound, or absence of a producer wait
+ * cycle. The removed deferred-original presenter violated all three under
+ * legal precommit/cross-queue callers. Warmup alone cannot prove the next CB.
+ * No batch is encoded, no extra drawable acquired, and no original retained.
+ * This value must stay zero until a new transport supplies all three proofs. */
+static const unsigned fg_multi_host_proofs = 0;
+static void fg_multi_invalidate(EmberFGLayer *p)
+{
+    fg_serial_invalidate(p);
+    if (!p->multi_observe) return;
+    pthread_mutex_lock(&fg_stat_lock);
+    ++p->multi_epoch;
+    eft_contract_reset(&p->multi_contract, p->multi_epoch);
+    pthread_mutex_unlock(&fg_stat_lock);
+}
+static void fg_multi_observe(EmberFGLayer *p, id<MTLCommandBuffer> cb, double now)
+{
+    uint64_t epoch, sequence;
+    unsigned before, after;
+    pthread_mutex_lock(&fg_stat_lock);
+    if (p->multi_contract.disabled) {
+        pthread_mutex_unlock(&fg_stat_lock);
+        return;
+    }
+    epoch = p->multi_epoch;
+    sequence = p->multi_contract.sequence + 1;
+    before = p->multi_contract.violations;
+    eft_contract_observe(&p->multi_contract, epoch, sequence,
+                         (uint64_t)(uintptr_t)cb.commandQueue,
+                         (uint64_t)(uintptr_t)cb, fge_ns(now));
+    after = p->multi_contract.violations;
+    pthread_mutex_unlock(&fg_stat_lock);
+    if (after != before)
+        fprintf(stderr, "ember-d3dm-fg: multi contract violation %u; legacy transport%s\n",
+                after, after >= 2 ? " (multi off for session)" : "");
+    /* Scheduling is stronger than just committing, hence safe to count but
+     * conservative: delayed scheduling may reject a valid caller. Stale callbacks
+     * only update their matching observation and never restore a disabled session. */
+    [cb addScheduledHandler:^(id<MTLCommandBuffer> scheduled) {
+        (void)scheduled;
+        pthread_mutex_lock(&fg_stat_lock);
+        eft_contract_scheduled(&p->multi_contract, epoch, sequence);
+        pthread_mutex_unlock(&fg_stat_lock);
+    }];
+}
+
+#include "fg_presenter_metal.h" /* Ember-owned opt-in transport */
+
+/* 안정 방식(엔진 제한기)이 정한 시각까지 잔다. 시각은 CACurrentMediaTime(mach 시계) 나노초. */
+static void fg_sleep_until_ns(int64_t due)
+{
+    double left = due * 1e-9 - CACurrentMediaTime();
+    if (left > 0 && left < 1.0)
+    {
+        struct timespec ts;
+        ts.tv_sec = 0;
+        ts.tv_nsec = (long)(left * 1e9);
+        nanosleep(&ts, NULL);
+    }
+}
+
+/* Ember(hdr12): 진짜 레이어의 지금 colorspace·EDR 을 "우리가 아는 값"으로 적어 둔다(우리가 쓴 뒤마다) */
+static void fg_seen_real(EmberFGLayer *p)
+{
+    CGColorSpaceRef cs = p->real.colorspace;
+    if (cs) CGColorSpaceRetain(cs);
+    if (p->seen_cs) CGColorSpaceRelease(p->seen_cs);
+    p->seen_cs = cs;
+    p->seen_edr = p->real.wantsExtendedDynamicRangeContent;
+}
+
+static void fg_ahdr_layer(EmberFGLayer *p);
+
+/* Ember(hdr12): D3DMetal 이 SetColorSpace1 로 진짜 레이어를 HDR(PQ·확장 선형)로 바꿨으면 대리 레이어도 같은 값으로 맞춘다 —
+ * 그래야 Auto HDR 이 이 게임을 SDR 로 보고 PQ 신호 위에 또 HDR 을 씌우지 않는다. 게임 스레드에서 프레임마다(속성 두 개 읽기). */
+static void fg_follow_real(EmberFGLayer *p)
+{
+    CGColorSpaceRef cs = p->real.colorspace;
+    BOOL edr = p->real.wantsExtendedDynamicRangeContent;
+    CFStringRef n;
+    if (cs == p->seen_cs && edr == p->seen_edr) return;
+    if (cs && p->seen_cs && CFEqual(cs, p->seen_cs) && edr == p->seen_edr) { fg_seen_real(p); return; }
+    n = cs ? CGColorSpaceCopyName(cs) : NULL;
+    fprintf(stderr, "ember-hdr: D3DMetal set the real layer to %s (EDR %d) — following on the proxy\n",
+            n ? [(NSString *)n UTF8String] : "(null)", (int)edr);
+    if (n) CFRelease(n);
+    [p emberAdoptColorspace:cs edr:edr];
+    fg_seen_real(p);
+    if (p->ahdr) { p->ahdr_applied = NO; fg_ahdr_layer(p); }
+}
+
+/* Ember Auto HDR: 게임이 SDR(대리 레이어의 EDR 끔·확장/PQ 색공간 아님)이고 화면이 EDR 을 낼 수 있으면 진짜 레이어를 EDR 로.
+ * 아니면 게임이 준 설정(대리 레이어 값)을 그대로 진짜 레이어에. 바뀔 때만 손댄다. 게임 스레드에서 부른다. */
+static void fg_ahdr_layer(EmberFGLayer *p)
+{
+    CGColorSpaceRef gcs = [p colorspace];
+    BOOL game_hdr = [p wantsExtendedDynamicRangeContent];
+    if (gcs && !game_hdr) { if (@available(macOS 11.0, *)) game_hdr = CGColorSpaceUsesExtendedRange(gcs) || CGColorSpaceUsesITUR_2100TF(gcs); }
+    BOOL want = p->ahdr && !p->ahdr->failed && !game_hdr && p->edr_pot > (p->ahdr_on ? 1.15 : 1.25);
+#if EMBER_FG_HDR_GUARD
+    if (__sync_add_and_fetch(&p->hdr_original_only, 0)) want = NO;
+#endif
+    if (want == p->ahdr_on && p->ahdr_applied) return;
+    p->ahdr_on = want;
+    p->ahdr_applied = YES;
+    if (want)
+    {
+        CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearSRGB);
+        p->real.pixelFormat = MTLPixelFormatRGBA16Float;
+        p->real.colorspace = cs;
+        p->real.wantsExtendedDynamicRangeContent = YES;
+        CGColorSpaceRelease(cs);
+    }
+    else
+    {
+        p->real.pixelFormat = [p pixelFormat];
+        p->real.colorspace = gcs;
+        p->real.wantsExtendedDynamicRangeContent = [p wantsExtendedDynamicRangeContent];
+    }
+    fprintf(stderr, "ember-autohdr: d3dmetal layer %s (game_hdr=%d potential=%.2f)\n", want ? "EDR on" : "SDR", (int)game_hdr, p->edr_pot);
+    fg_seen_real(p);
+}
+
+#if EMBER_FG_HDR_GUARD
+/* Fail closed for the layer lifetime. Recreating the swapchain permits SDR
+ * interpolation again; no encoded HDR history can leak back into an SDR pair.
+ * No producer commit, GPU wait, shader, Tone, AutoHDR or HUD is used here. */
+static BOOL fg_hdr_original(EmberFGLayer *p, id<MTLCommandBuffer> cb,
+                            id<MTLTexture> cur, double now)
+{
+    static int policy = -1;
+    if (policy < 0) policy = fg_hdr_parse_policy(getenv("EMBER_FG_HDR_POLICY"));
+    if (policy == FG_HDR_OFF) return NO;
+    if (!__sync_add_and_fetch(&p->hdr_original_only, 0)) {
+        CGColorSpaceRef pcs = p.colorspace, rcs = p->real.colorspace;
+        BOOL redr = p->real.wantsExtendedDynamicRangeContent;
+        BOOL changed = redr != p->seen_edr ||
+            (rcs != p->seen_cs && (!rcs || !p->seen_cs || !CFEqual(rcs, p->seen_cs)));
+        unsigned reason = fg_hdr_block_reason(policy,
+            fg_hdr_color_reason(pcs, p.wantsExtendedDynamicRangeContent),
+            fg_hdr_color_reason(rcs, redr), p->ahdr_on, changed);
+        if (!reason) return NO; /* Ordinary SDR takes the unchanged legacy route. */
+        __sync_lock_test_and_set(&p->hdr_original_only, 1);
+        CGColorSpaceRef cs = changed ? rcs : pcs;
+        CFStringRef name = cs ? CGColorSpaceCopyName(cs) : NULL;
+        fprintf(stderr, "ember-fg-hdr: original-only reason=0x%x colorspace=%s policy=%d; "
+                "HDR transfer function unsupported by interpolation ABI; Tone/AutoHDR bypassed; "
+                "latched until layer recreation (EMBER_FG_HDR_POLICY=off restores legacy)\n",
+                reason, name ? [(NSString *)name UTF8String] : "(null)", policy);
+        if (name) CFRelease(name);
+        p->have_prev = p->ring_prev = NO;
+        p->active = NO;
+        fg_multi_invalidate(p);
+        fg_serial_end(p->serial, EFP_TERMINATED);
+        if (p->legacy_ane) {
+            __sync_add_and_fetch(&p->legacy_ane->latest, 1);
+        }
+        /* Permanently revoke the opt-in owner. Its polling drain stays async. */
+        [p->link_adapter retire];
+        /* Installed helper jobs share dq. A queue marker and GPU completion
+         * marker cover work admitted before this gate; outstanding also covers
+         * smooth jobs that reschedule behind the marker. No new DQ/acq owner. */
+        if (p->dq) dispatch_async(p->dq, ^{
+            id<MTLCommandBuffer> fence = [p->hq commandBuffer];
+            if (fence) {
+                [fence addCompletedHandler:^(id<MTLCommandBuffer> done) {
+                    __sync_lock_test_and_set(&p->hdr_drain_ready, 1);
+                }];
+                [fence commit];
+            } else if (!p->hq) __sync_lock_test_and_set(&p->hdr_drain_ready, 1);
+        });
+        else __sync_lock_test_and_set(&p->hdr_drain_ready, 1);
+    }
+    BOOL busy = !__sync_add_and_fetch(&p->hdr_drain_ready, 0) || fg_transport_pending(p) ||
+                __sync_add_and_fetch(&p->pending, 0);
+    if (p->serial) {
+        pthread_mutex_lock(&p->serial->lock);
+        busy |= p->serial->state.pending || p->serial->state.inflight || p->serial->hooks;
+        pthread_mutex_unlock(&p->serial->lock);
+    }
+    /* The installed smooth transport has a one-slot optional acquisition
+     * worker. It can outlive its output CB/outstanding count after timeout. */
+    if (p->legacy_ane)
+        busy |= __sync_add_and_fetch(&p->legacy_ane->smooth_drawable_busy, 0) != 0;
+    @synchronized (p->link_adapter) {
+        busy |= p->link_adapter && ![p->link_adapter mayMutate];
+        if (busy) goto skipped;
+        /* Adopt a direct SetColorSpace1 before writing anything back. No EDR
+         * metadata is added: the game's PQ/HLG/linear declaration is preserved. */
+        fg_follow_real(p);
+        p->ahdr_on = NO;
+        p->ahdr_applied = YES;
+        p->real.colorspace = p.colorspace;
+        p->real.wantsExtendedDynamicRangeContent = p.wantsExtendedDynamicRangeContent;
+        p->real.pixelFormat = cur.pixelFormat;
+        fg_seen_real(p);
+        p->real.drawableSize = CGSizeMake(cur.width, cur.height);
+        p->real.displaySyncEnabled = p->game_sync;
+        fg_ahdr_now = NULL;
+        id<CAMetalDrawable> out = [p->real nextDrawable];
+        if (!out || out.texture.device != cur.device || out.texture.pixelFormat != cur.pixelFormat ||
+            out.texture.width != cur.width || out.texture.height != cur.height) goto skipped;
+        id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+        if (!blit) goto skipped;
+        [blit copyFromTexture:cur toTexture:out.texture];
+        [blit endEncoding];
+        /* Bypass fg_submit: it intentionally rejects the old helper jobs. */
+        ((void (*)(id, SEL, id))orig_present)(cb, @selector(presentDrawable:), out);
+        ++p->hdr_originals;
+        if (p->hdr_originals == 1)
+            fprintf(stderr, "ember-fg-hdr: original blit active format=%lu size=%lux%lu; no generated frames\n",
+                    (unsigned long)cur.pixelFormat, (unsigned long)cur.width, (unsigned long)cur.height);
+        return YES;
+    }
+skipped:
+    ++p->hdr_skipped;
+    if (!p->hdr_logged || now - p->hdr_logged >= 5.0) {
+        fprintf(stderr, "ember-fg-hdr: original deferred drain/resource busy=%d skipped=%llu originals=%llu; no CPU wait\n",
+                busy, (unsigned long long)p->hdr_skipped, (unsigned long long)p->hdr_originals);
+        p->hdr_logged = now;
+    }
+    return YES;
+}
+#endif
+
+static void fg_present_impl(id<MTLCommandBuffer> cb, id<CAMetalDrawable> d)
+{
+    EmberFGLayer *p = (EmberFGLayer *)d.layer;
+    id<MTLTexture> cur = d.texture;
+    double now = CACurrentMediaTime(), disp;
+    id<CAMetalDrawable> out;
+    BOOL was_active = p->active, smooth, use_ring, framegen, generate;
+    struct fge_frame_plan plan;
+
+#if EMBER_FG_HDR_GUARD
+    if (fg_hdr_original(p, cb, cur, now)) return;
+#endif
+    /* Opt-in owns originals and generated frames together. Run before legacy
+     * layer writes, pacing, snapshot pools or presentation can touch the layer. */
+    if (p->link_adapter) {
+      @synchronized (p->link_adapter) {
+        if (p->link_surface_dirty && [p->link_adapter mayMutate]) {
+            [p->link_adapter revoke];
+            p->real.device = p.device;
+            p->real.pixelFormat = p.pixelFormat;
+            p->real.drawableSize = ember_up_layer_size(p->real, p.drawableSize);
+            p->real.colorspace = p.colorspace;
+            p->real.wantsExtendedDynamicRangeContent = p.wantsExtendedDynamicRangeContent;
+            p->real.displaySyncEnabled = p->game_sync;
+            p->real.maximumDrawableCount = p->game_drawables ? p->game_drawables : 3;
+            p->link_surface_dirty = NO;
+        }
+        if ([p->link_adapter consume:cb texture:cur time:now
+             legacyIdle:(!p->link_surface_dirty && !fg_transport_pending(p) && !p->pending)]) {
+            ++p->frame_no; ++p->count_in;
+            return;
+        }
+      }
+    }
+    if (p->legacy_ane) __sync_lock_test_and_set(&p->legacy_ane->latest, p->frame_no + 1);
+    fg_serial_observe(p, cb, now);
+    if (p->multi_observe) fg_multi_observe(p, cb, now);
+    disp = p->display_interval > 0 ? p->display_interval : 1.0 / 60.0;
+    /* 실제 화면 주사율로 묶는다: 시작 때 주 화면 값(EMBER_D3DM_FG_HZ)은 창이 다른 모니터에 있거나 모니터를 끊고 붙이면 틀린다
+     * (60Hz 모니터에서 120 을 만들면 절반은 버려지고 지연만 는다 — DXMT 에서 실측, README 117). AppKit 은 메인 스레드에서만. */
+    if (now >= p->next_screen_check)
+    {
+        EmberFGLayer *pp = [p retain];
+        p->next_screen_check = now + 2.0;
+        fg_apply_drawables(p);   /* D3DMetal 이 나중에 값을 덮어도 2초 안에 규칙을 되돌린다(값이 같으면 아무 일도 없음) */
+        ember_up_resync_layer(p->real, [p drawableSize]);   /* 화면 확대: winemac 이 contentsScale 을 되돌렸으면 다시(꺼져 있으면 아무 일도 없음) */
+        dispatch_async(dispatch_get_main_queue(), ^{
+            NSScreen *screen = nil;
+            id delegate = pp->real.delegate;
+            if ([delegate isKindOfClass:[NSView class]]) screen = [[(NSView *)delegate window] screen];
+            if (!screen) screen = [NSScreen mainScreen];
+            if (pp->multi_observe) {
+                uint64_t screen_id = [[screen.deviceDescription objectForKey:@"NSScreenNumber"] unsignedLongLongValue];
+                NSWindow *window = [delegate isKindOfClass:[NSView class]] ? [(NSView *)delegate window] : nil;
+                BOOL occluded = window && !(window.occlusionState & NSWindowOcclusionStateVisible);
+                if (screen_id != pp->multi_screen || occluded != pp->multi_occluded) fg_multi_invalidate(pp);
+                pp->multi_screen = screen_id; pp->multi_occluded = occluded;
+            }
+            /* Ember Auto HDR: 화면 헤드룸(지금 값·잠재 값) */
+            pp->edr_now = screen.maximumExtendedDynamicRangeColorComponentValue;
+            pp->edr_pot = screen.maximumPotentialExtendedDynamicRangeColorComponentValue;
+            if (pp->ahdr && ember_ahdr_log())
+                fprintf(stderr, "ember-autohdr: d3dmetal on=%d peak=%.2f edr=%.2f potential=%.2f\n", (int)pp->ahdr_on,
+                        pp->ahdr->peak, pp->edr_now, pp->edr_pot);
+            if (@available(macOS 12.0, *))
+            {
+                NSInteger fps = screen.maximumFramesPerSecond;
+                if (fps > 1) {
+                    double interval = 1.0 / (double)fps;
+                    if (interval != pp->screen_interval) fg_multi_invalidate(pp);
+                    pp->screen_interval = interval;
+                }
+            }
+            [pp release];
+        });
+    }
+    if (p->screen_interval > disp) disp = p->screen_interval;
+
+    /* 안정 방식(EMBER_FG_GAME_CAP): present 쪽 제한기 — 엔진이 정한 시각까지 게임의 present 를 붙잡는다(DXMT d3d11.gameFrameCap 과 같은 규칙) */
+    if (p->fge_ctx && fg_generate() && !fg_meter() && p->fge_cfg.game_cap_fps > 0)
+    {
+        int64_t due = fge.pace_present(p->fge_ctx, fge_ns(now), disp);
+        if (due > fge_ns(now))
+        {
+            double t;
+            fg_sleep_until_ns(due);
+            t = CACurrentMediaTime();
+            p->pace_sum += t - now;
+            now = t;
+        }
+    }
+
+    /* Ember Neural: 게임 해상도 원본에 후처리(같은 커맨드 버퍼, CPU 대기 없음). 아래 모든 경로(링 복사·보간·표시·이전 프레임)가
+     * 처리본을 읽는다. 꺼져 있거나 못 하면 cur 그대로. */
+    if (p->neural) cur = ember_neural_encode(p->neural, cb, cur, nil);
+    /* Ember(hdr12): 게임이 진짜 레이어에 바로 준 HDR 색공간을 대리 레이어로 + PQ 면 EDR 메타데이터(하이라이트를 지금 헤드룸에 맞춰 접는다) */
+    fg_follow_real(p);
+    ember_hdr_meta_apply(p->real, p->edr_pot > 0 ? p->edr_pot : -1);
+    /* Ember Auto HDR: 레이어 전환 판단 + 이득 지도(처리본 기준, 모든 표시 경로가 같은 지도를 쓴다) */
+    if (p->ahdr)
+    {
+        fg_ahdr_layer(p);
+        if (p->ahdr_on) { ember_ahdr_update_peak(p->ahdr, p->edr_now); ember_ahdr_encode(p->ahdr, cb, cur); }
+        fg_ahdr_now = p->ahdr_on ? p->ahdr : NULL;
+    }
+
+    if (p->last_time > 0)
+    {
+        double dt = now - p->last_time;
+        if (dt > 0 && dt < 2.0 && p->ft_n < sizeof(p->ft) / sizeof(p->ft[0])) p->ft[p->ft_n++] = (float)dt;
+    }
+    p->last_time = now;
+
+    /* 이전 프레임을 담아 둘 텍스처(부드러움 방식·링을 못 만들 때). 크기·형식이 바뀌면 다시 만든다.
+     * Ember perf3: 보간을 안 하는 프록시(Frame Check 미터·선명화·Neural·화면 확대만 켬)는 이전 프레임이 필요 없다. */
+    if (fg_generate() && p->fge_ctx && (!p->prev || p->prev.width != cur.width || p->prev.height != cur.height || p->prev.pixelFormat != cur.pixelFormat))
+    {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:cur.pixelFormat
+                                                                                       width:cur.width
+                                                                                      height:cur.height
+                                                                                   mipmapped:NO];
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModePrivate;
+        [p->prev release];
+        p->prev = [cb.device newTextureWithDescriptor:td];
+        p->have_prev = NO;
+    }
+
+    p->count_in++;
+    p->frame_no++;
+    smooth = p->fge_ctx ? (BOOL)p->fge_cfg.smooth : (BOOL)fg_smooth();
+    use_ring = p->fge_ctx && fg_generate() && !smooth && !fg_meter() && fg_ensure_ring(p, cur);   /* 엔진이 없으면 링(4장)도 안 만든다 */
+    framegen = p->fge_ctx && fg_generate() && !fg_meter() && (use_ring || p->prev);
+
+    /* 보간 판단은 엔진이(켜고 끔·칸 예산·가드 2·비용 탐침·박자). 여기서는 plan 대로 운반만 한다. */
+    memset(&plan, 0, sizeof(plan));
+    plan.blend_weight = 0.5f;
+    if (framegen)
+    {
+        struct fge_frame_in in;
+        struct fge_stats st;
+        memset(&in, 0, sizeof(in));
+        in.size = sizeof(in);
+        in.flags = FGE_IN_FRAMEGEN | ((fg_serial_previous(p) || fg_legacy_ane_previous(p) || (use_ring ? p->ring_prev : p->have_prev)) ? FGE_IN_PREV_VALID : 0);
+        in.now_ns = fge_ns(now);
+        in.frame_no = p->frame_no;
+        in.display_interval = disp;
+        fg_feedback(p, now, &in);
+        plan.size = sizeof(plan);
+        if (!fge.begin_frame(p->fge_ctx, &in, &plan)) { memset(&plan, 0, sizeof(plan)); plan.blend_weight = 0.5f; }
+        memset(&st, 0, sizeof(st));
+        st.size = sizeof(st);
+        fge.get_stats(p->fge_ctx, in.now_ns, &st);
+#if EMBER_FG_STABILITY
+        /* Installed fill and LLFI smooth/job consume these vetoed flags without new
+         * waits or deadlines. Link/serial/other ANE remain excluded.
+         * HDR original-only guard must run earlier than this block. */
+        const int stability_route = fg_stability_route(fg_ane_source(), smooth, p->link_adapter != nil, fg_serial_owns(p));
+        if (stability_route)
+            fg_stability_plan(&p->stability, p->fge_ctx, cur, now, &plan.flags, &plan.cadence_hold, stability_route);
+#endif
+        p->active = st.active != 0 && !(plan.flags & FGE_PLAN_LATGUARD_PAUSED);
+#if EMBER_FG_STABILITY
+        if (stability_route && fg_stability_config.lowfps && p->stability.held) p->active = NO;
+#endif
+        fge_flush_log(p->fge_ctx);
+    }
+    else p->active = NO;
+    fg_stage(p, FGS_PLAN_O);
+    if (plan.flags & FGE_PLAN_GENERATE) fg_stage(p, FGS_PLAN_G);
+    fg_observe_gpu(p, cb, NO);
+    fg_apply_sync(p);   /* 보간 켬/끔·방식 전환 때만 실제로 바뀐다 */
+    if (p->active != was_active) fg_apply_drawables(p);  /* 쉼 → 2장(보간 끔과 같은 지연), 보간 → 3장 */
+
+    if ((smooth || fg_llfi_fill_requested(p)) && framegen && fg_smooth_ane(p, cb, cur, now, disp, &plan)) goto stats;
+    if (fg_serial_present(p, cb, d, cur, now, disp, &plan)) goto stats;
+
+    if (use_ring)
+    {
+        /* Even EMBER_FG_MULTI=1 uses the exact legacy n=1 route. No deferred
+         * original batch or cancellation escape is reachable from this host. */
+        fg_present_fill(p, cb, cur, now, disp, &plan);
+        goto stats;
+    }
+    generate = (plan.flags & FGE_PLAN_GENERATE) && p->have_prev;
+    {
+        BOOL interp = generate;
+        /* 보충형(링을 못 만든 경우): 앞서 낸 화면이 아직 안 떴으면(원본이 앞서 옴) 보간을 버리고 원본을 바로 낸다 — 대기열을 쌓지 않는다. */
+        if (interp && !smooth && p->pending > 0) { interp = NO; p->dropped++; fg_stage(p, FGS_CANCEL_STALE); fge.note_drop(p->fge_ctx, FGE_DROP_STALE); }
+        if (!(out = fg_next(p))) { fg_stage(p, FGS_CANCEL_DRAWABLE); return; }
+        if (interp)
+        {
+            id<CAMetalDrawable> next;
+            id<MTLTexture> mc_tex = (plan.flags & FGE_PLAN_MC) ? fg_engine_mc(p, cb, cur, p->prev, plan.blend_weight) : nil;
+            if (mc_tex) { fg_draw(cb, mc_tex, mc_tex, 0.0f, out.texture); p->mc_frames++; }
+            else fg_draw(cb, cur, p->prev, 1.0f - plan.blend_weight, out.texture);
+            fg_stage(p, FGS_ENCODE_G);
+            fg_submit(p, cb, out, 0, 0);
+            p->count_out++;
+            p->gen_total++;
+            if ((next = fg_next(p)))
+            {
+                /* 보간 프레임 뒤 원본까지의 간격(엔진 defer: 부드러움 = 게임 간격 절반, 보충형 = 한 칸)을 화면 주기 단위로 **내림**한다
+                 * (최소 1주기, 조금 앞당김). 올림하면 25ms 게임이 3주기(=40fps)에 묶여 영영 못 빠져나왔다(스텔라 블레이드 실측). */
+                double steps = floor(plan.defer / disp + 0.05), min_dur;
+                if (steps < 1) steps = 1;
+                min_dur = steps * disp - 0.1 * disp;
+                if (!smooth && plan.cadence_hold > min_dur) min_dur = plan.cadence_hold;
+                fg_draw(cb, cur, cur, 0.0f, next.texture);
+                fg_stage(p, FGS_ENCODE_O);
+                fg_submit(p, cb, next, min_dur, now);
+                p->count_out++;
+            }
+            else fg_stage(p, FGS_CANCEL_DRAWABLE);
+        }
+        else
+        {
+            fg_draw(cb, cur, cur, 0.0f, out.texture);
+            fg_stage(p, FGS_ENCODE_O);
+            fg_submit(p, cb, out, 0, now);
+            p->count_out++;
+        }
+    }
+    /* 진단: EMBER_D3DM_FG_DUMP=<경로> 이면 120번째 프레임에서 합성 결과(보간 중이면 중간 프레임)를 PPM 으로 남긴다. */
+    if (p->count_in == 120 && getenv("EMBER_D3DM_FG_DUMP"))
+    {
+        const char *path = getenv("EMBER_D3DM_FG_DUMP");
+        NSUInteger w = cur.width, h = cur.height;
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                       width:w height:h mipmapped:NO];
+        id<MTLTexture> snap;
+        td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        td.storageMode = MTLStorageModeShared;
+        snap = [cb.device newTextureWithDescriptor:td];
+        fg_draw_sharp(cb, cur, p->prev ? p->prev : cur, generate ? 0.5f : 0.0f, snap, 0);
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+            unsigned char *px = malloc(w * h * 4);
+            FILE *f;
+            [snap getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+            if ((f = fopen(path, "wb")))
+            {
+                NSUInteger i;
+                fprintf(f, "P6\n%lu %lu\n255\n", (unsigned long)w, (unsigned long)h);
+                for (i = 0; i < w * h; i++) fwrite(px + i * 4, 1, 3, f);
+                fclose(f);
+            }
+            free(px);
+            [snap release];
+        }];
+    }
+    /* 이번 원본을 다음 보간의 "이전 프레임"으로(엔진이 보간 중이거나 곧 켜질 때만 — 쉴 때는 전체 화면 사본 한 장을 아낀다) */
+    if (framegen && p->prev && (plan.flags & (FGE_PLAN_KEEP_PREVIOUS | FGE_PLAN_GENERATE)))
+    {
+        fg_draw_sharp(cb, cur, cur, 0.0f, p->prev, 0);
+        p->have_prev = YES;
+    }
+    else p->have_prev = NO;
+
+stats:
+
+    if ((fg_log() || fg_meter() || ((smooth || fg_llfi_fill_requested(p)) && p->legacy_ane)) && now - p->count_since >= 5.0)
+    {
+        if (p->count_since > 0)
+        {
+            double lat, latmax, p99 = 0, el = now - p->count_since;
+            int n, outstanding;
+            uint64_t stages[FGS_COUNT], game_gpu_n, aux_gpu_n;
+            double recent = 0, sample_age, transport_age, game_gpu_ms, aux_gpu_ms;
+            unsigned int recent_n = 0, k;
+            struct fge_stats st;
+            char hud[96];
+            const char *reason = "off";
+            memset(&st, 0, sizeof(st));
+            st.size = sizeof(st);
+            hud[0] = 0;
+            if (p->fge_ctx)
+            {
+                size_t k;
+                fge.get_stats(p->fge_ctx, fge_ns(now), &st);
+                /* HUD 이유(DXMT 오버레이와 같은 문구: FG ON OUT n / WAIT (GAME FAST) / CHECK / OFF (GPU xC) / RETRY ns / PAUSE (LOW FPS n)) */
+                k = fge.hud_text(p->fge_ctx, fge_ns(now), p->count_in / el, p->gen_total, hud, sizeof(hud));
+                reason = k > 0 && hud[0] == '\n' ? hud + 1 : hud;
+            }
+            /* p99 프레임 시간: 이 구간 게임 프레임 간격의 99번째 백분위(끝에 붙인다 — 앞 필드를 읽는 쪽이 그대로 동작) */
+            if (p->ft_n)
+            {
+                unsigned int j, k = p->ft_n;
+                qsort(p->ft, k, sizeof(p->ft[0]), fg_cmp_float);
+                j = (unsigned int)(k * 0.99); if (j >= k) j = k - 1;
+                p99 = p->ft[j];
+            }
+            pthread_mutex_lock(&fg_stat_lock);
+            n = p->lat_n; lat = n ? p->lat_sum / n : 0; latmax = p->lat_max;
+            p->lat_sum = 0; p->lat_n = 0; p->lat_max = 0;
+            memcpy(stages, p->stage, sizeof(stages));
+            for (k = 0; k < FG_LAT_SAMPLES; ++k)
+                if (p->recent_at[k] > 0 && now >= p->recent_at[k] && now - p->recent_at[k] <= FG_LAT_WINDOW)
+                { recent += p->recent_lat[k]; recent_n++; }
+            recent = recent_n ? recent * 1000 / recent_n : 0;
+            sample_age = p->latest_sample > 0 ? fmax(0, now - p->latest_sample) * 1000 : -1;
+            transport_age = p->transport_start > 0 ? fmax(0, now - p->transport_start) * 1000 : 0;
+            outstanding = p->outstanding;
+            game_gpu_n = p->game_gpu_n; aux_gpu_n = p->aux_gpu_n;
+            game_gpu_ms = game_gpu_n ? p->game_gpu_sum * 1000 / game_gpu_n : 0;
+            aux_gpu_ms = aux_gpu_n ? p->aux_gpu_sum * 1000 / aux_gpu_n : 0;
+            pthread_mutex_unlock(&fg_stat_lock);
+            /* game/base/conf/guard/cost/skip/blocked 는 엔진 값(skip = 칸 예산 부족, blocked = 가드·탐침이 원본만 낸 게임 프레임),
+             * drop = 운반 계층이 버린 보간, pace = 안정 방식 제한기가 게임을 붙잡은 평균 ms, mcgen = MC 로 만든 보간 수, fg = HUD 이유 */
+#if EMBER_FG_STABILITY
+            const int stability_route = fg_stability_route(fg_ane_source(), smooth, p->link_adapter != nil, fg_serial_owns(p));
+            if (stability_route && p->stability.last > 0)
+                fprintf(stderr, "ember-fg-stability%s: owner=main source=%s held=%d native_ema=%.2f ratio=%.3f entries=%llu low_veto=%llu shape_veto=%llu cadence=%d\n",
+                    stability_route == EFS_LLFI ? "-llfi" : "", fg_ane_source() ?: "mc",
+                    p->stability.held, p->stability.mean > 0 ? 1 / p->stability.mean : 0, p->stability.ratio,
+                    (unsigned long long)p->stability.entries, (unsigned long long)p->stability.low_veto,
+                    (unsigned long long)p->stability.shape_veto,
+                    stability_route != EFS_LLFI && fg_stability_config.cadence);
+#endif
+            fg_smooth_report(p, disp);
+            fprintf(stderr, "ember-d3dm-fg: in=%.1f/s out=%.1f/s active=%d game=%.1fms display=%.1fms "
+                    "lat=%.1fms max=%.1fms wait=%.1fms drop=%u skip=%u base=%.1fms dr=%lu mode=%s "
+                    "mc=%d conf=%.2f guard=%d blocked=%u cost=%.2f pace=%.1fms mcgen=%u p99=%.1fms fg=%s "
+                    "plan_o=%llu plan_g=%llu enc_o=%llu enc_g=%llu submit_o=%llu submit_g=%llu presented_o=%llu presented_g=%llu "
+                    "cancel_stale=%llu cancel_drawable=%llu presented0_o=%llu presented0_g=%llu "
+                    "lat_recent=%.2fms lat_age=%.1fms transport_age=%.1fms outstanding=%d pause_reason=%d "
+                    "game_cb_gpu=%.2fms aux_cb_gpu=%.2fms game_cb_n=%llu aux_cb_n=%llu "
+                    "lg_state=%u lg_reason=%u lg_base=%.2fms lg_fps=%.2f lg_pauses=%llu lg_skips=%llu layer=%p\n",
+                    p->count_in / el, p->count_out / el, p->active,
+                    st.game_interval * 1000, disp * 1000, lat * 1000, latmax * 1000,
+                    p->count_in ? p->wait_sum * 1000 / p->count_in : 0, p->dropped,
+                    (unsigned)(st.frames_budget_skipped - p->log_skip0), st.base_interval * 1000,
+                    (unsigned long)p->real.maximumDrawableCount,
+                    p->fge_cfg.game_cap_fps > 0 ? "stable" : (smooth ? "smooth" : "fill"),
+                    (int)(p->fge_ctx && p->fge_cfg.mc_enabled), p->fge_ctx ? st.mc_confidence : -1.0, (int)st.guard_active,
+                    (unsigned)(st.frames_guard_blocked - p->log_block0), p->fge_ctx ? st.guard_cost : 1.0,
+                    p->count_in ? p->pace_sum * 1000 / p->count_in : 0, p->mc_frames, p99 * 1000, reason,
+                    (unsigned long long)stages[FGS_PLAN_O], (unsigned long long)stages[FGS_PLAN_G],
+                    (unsigned long long)stages[FGS_ENCODE_O], (unsigned long long)stages[FGS_ENCODE_G],
+                    (unsigned long long)stages[FGS_SUBMIT_O], (unsigned long long)stages[FGS_SUBMIT_G],
+                    (unsigned long long)stages[FGS_PRESENT_O], (unsigned long long)stages[FGS_PRESENT_G],
+                    (unsigned long long)stages[FGS_CANCEL_STALE], (unsigned long long)stages[FGS_CANCEL_DRAWABLE],
+                    (unsigned long long)stages[FGS_ZERO_O], (unsigned long long)stages[FGS_ZERO_G],
+                    recent, sample_age, transport_age, outstanding, st.guard_reason,
+                    game_gpu_ms, aux_gpu_ms, (unsigned long long)game_gpu_n, (unsigned long long)aux_gpu_n,
+                    st.latguard_state, st.latguard_reason, st.latguard_baseline_ms, st.latguard_baseline_fps,
+                    (unsigned long long)st.latguard_pauses, (unsigned long long)st.latguard_skips, (void *)p);
+            if (fg_direct_n || fg_direct_timeout)   /* Direct 유지: 평범한 present 로 낸 원본 수·처리기 늦음·시간 초과 */
+                fprintf(stderr, "ember-d3dm-fg: direct=%u late=%u timeout=%u\n", fg_direct_n, fg_direct_late, fg_direct_timeout);
+            fg_direct_n = fg_direct_late = fg_direct_timeout = 0;
+            p->log_skip0 = st.frames_budget_skipped;
+            p->log_block0 = st.frames_guard_blocked;
+        }
+        p->count_in = p->count_out = 0;
+        p->ft_n = 0;
+        p->wait_sum = 0;
+        p->pace_sum = 0;
+        p->dropped = 0;
+        p->mc_frames = 0;
+        /* 첫 구간: HUD 의 보간 수 기준점을 잡아 둔다(다음 줄의 OUT 이 이 구간부터 센다) */
+        if (p->count_since <= 0 && p->fge_ctx)
+        {
+            char hud[96];
+            fge.hud_text(p->fge_ctx, fge_ns(now), 0, p->gen_total, hud, sizeof(hud));
+        }
+        p->count_since = now;
+    }
+}
+
+static int fg_cmp_float(const void *a, const void *b)
+{
+    float x = *(const float *)a, y = *(const float *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* Opt-in calls share one admission/slot transaction per layer, including legacy
+ * fallback. Concurrent callers cannot both accept the one original cell. */
+static void fg_present(id<MTLCommandBuffer> cb, id<CAMetalDrawable> d)
+{
+    if (fg_link_requested() || fg_serial_requested() || fg_ane_source()) {
+        @synchronized ((EmberFGLayer *)d.layer) { fg_present_impl(cb, d); }
+    } else fg_present_impl(cb, d);
+}
+
+static BOOL is_proxy(id d)
+{
+    return [d respondsToSelector:@selector(layer)] && [[(id<CAMetalDrawable>)d layer] isKindOfClass:[EmberFGLayer class]];
+}
+
+/* All real-layer entry points share the owner guard, including direct presents
+ * that bypass the proxy. The service's dedicated display CB is explicitly
+ * labelled and must never re-enter HUD/HDR legacy hooks. */
+static void fg_present_real(id cb, SEL cmd, id d, CFTimeInterval t, unsigned mode)
+{
+    /* (wm-merge-1017) switch off: skip the association lookup so every present is the deployed path. */
+    static int link_on = -1;
+    if (link_on < 0) link_on = fg_link_requested();
+    CAMetalLayer *layer = link_on && [d respondsToSelector:@selector(layer)] ? [(id<CAMetalDrawable>)d layer] : nil;
+    EmberDisplayLinkAdapter *adapter = layer ? [[objc_getAssociatedObject(layer, &fg_link_adapter_key) retain] autorelease] : nil;
+    @synchronized (adapter) {
+        BOOL service = adapter && [[(id<MTLCommandBuffer>)cb label] isEqualToString:@"ember.fg.display-link"];
+        if (adapter && !service) {
+            if (![adapter allowLegacyPresent]) return;
+            [adapter trackLegacyPresentation:cb drawable:d];
+        }
+        if (!service) { ember_hud_on_present(cb, d); ember_hdr_on_present(d); }
+        if (mode == 1) ((void (*)(id, SEL, id, CFTimeInterval))orig_present_min)(cb, cmd, d, t);
+        else if (mode == 2) ((void (*)(id, SEL, id, CFTimeInterval))orig_present_at)(cb, cmd, d, t);
+        else ((void (*)(id, SEL, id))orig_present)(cb, cmd, d);
+    }
+}
+static void my_present(id self, SEL cmd, id d)
+{
+    if (is_proxy(d)) fg_present(self, d);
+    else fg_present_real(self, cmd, d, 0, 0);
+}
+static void my_present_min(id self, SEL cmd, id d, CFTimeInterval t)
+{
+    if (is_proxy(d)) fg_present(self, d);
+    else fg_present_real(self, cmd, d, t, 1);
+}
+static void my_present_at(id self, SEL cmd, id d, CFTimeInterval t)
+{
+    if (is_proxy(d)) fg_present(self, d);
+    else fg_present_real(self, cmd, d, t, 2);
+}
+
+static void fg_hook_device(id<MTLDevice> dev)
+{
+    static pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER;
+    static Class hooked;
+    id<MTLCommandQueue> q;
+    Class c;
+    Method a, b, t;
+
+    if (!dev) return;
+    q = [dev newCommandQueue];
+    c = [[q commandBuffer] class];
+    [q release];
+    pthread_mutex_lock(&m);
+    if (c && c != hooked && !hooked)
+    {
+        a = class_getInstanceMethod(c, @selector(presentDrawable:));
+        b = class_getInstanceMethod(c, @selector(presentDrawable:afterMinimumDuration:));
+        t = class_getInstanceMethod(c, @selector(presentDrawable:atTime:));
+        if (a && b && t)
+        {
+            orig_present = method_setImplementation(a, (IMP)my_present);
+            orig_present_min = method_setImplementation(b, (IMP)my_present_min);
+            orig_present_at = method_setImplementation(t, (IMP)my_present_at);
+            hooked = c;
+            fprintf(stderr, "ember-d3dm-fg: hooked %s\n", class_getName(c));
+        }
+    }
+    pthread_mutex_unlock(&m);
+}
+
+@implementation EmberFGLayer
+
+- (id<CAMetalDrawable>)nextDrawable
+{
+    if (!link_adapter) return [super nextDrawable];
+    EmberFGProxyAcquire *ticket = [[link_adapter beginProxyAcquisition:self] retain];
+    id<CAMetalDrawable> drawable = nil;
+    @try {
+        /* This is the proxy's own CA pool, distinct from p->real and the
+         * adapter's off-thread legacy pool. Do not hold the adapter monitor. */
+        drawable = [super nextDrawable];
+        return drawable;
+    } @finally {
+        [link_adapter endProxyAcquisition:ticket drawable:drawable != nil];
+        [ticket release];
+    }
+}
+
+- (void)dealloc
+{
+    int i;
+    [link_adapter retire]; [link_adapter release];
+    fg_serial_end(serial, EFP_TERMINATED);
+    fg_multi_invalidate(self);
+    [serial release];
+    [legacy_ane release];
+    [real release];
+    [prev release];
+    for (i = 0; i < 4; i++) [ring[i] release];
+    [hq release];
+    [ev release];
+    if (dq) dispatch_release(dq);
+    ember_neural_destroy(neural);
+    ember_ahdr_destroy(ahdr);
+    if (fge_ctx) fge.destroy(fge_ctx);
+    if (seen_cs) CGColorSpaceRelease(seen_cs);
+    [super dealloc];
+}
+
+/* D3DMetal 이 대리 레이어에 주는 설정을 진짜 레이어에도 그대로 준다. */
+- (void)setDevice:(id<MTLDevice>)device
+{
+    @synchronized (link_adapter) {
+    if ((multi_observe || serial) && device != fge_dev) fg_multi_invalidate(self);
+    EmberFGSerial *old_serial = serial;
+    if (old_serial && device != old_serial->device) {
+        fg_serial_end(old_serial, device ? EFP_DEVICE_REPLACED : EFP_SURFACE_LOST);
+        pthread_mutex_lock(&old_serial->surface_lock);
+    }
+    if (link_adapter && device != self.device) [link_adapter revoke];
+    [super setDevice:device];
+    if (!link_adapter || [link_adapter mayMutate]) real.device = device;
+    else link_surface_dirty = YES;
+    if (old_serial && device != old_serial->device) pthread_mutex_unlock(&old_serial->surface_lock);
+    fg_hook_device(device);
+    if (!neural) neural = ember_neural_create(device);   /* EMBER_NEURAL=1 이 아니면 NULL */
+    if (!ahdr) ahdr = ember_ahdr_create(device);         /* EMBER_AUTOHDR=1 이 아니면 NULL */
+    /* 보간 엔진(EmberCore): 보간을 켠 게임에서만, 장치마다 하나. 없으면 보간 끔(원본만 통과). 스위치(EMBER_FG_*)는 엔진이 읽는다. */
+    if (device && device != fge_dev && fg_generate() && !fg_meter() && fge_available())
+    {
+        if (fge_ctx) { fge.destroy(fge_ctx); fge_ctx = NULL; }
+        memset(&fge_cfg, 0, sizeof(fge_cfg));
+        fge_ctx = fge.create2((uint64_t)(uintptr_t)device, NULL, 0, FGE_HOST_D3DMETAL);
+        fge_dev = device;   /* 엔진이 장치를 붙잡는다 — 여기서는 비교에만 쓴다 */
+        if (fge_ctx)
+        {
+            fge_cfg.size = sizeof(fge_cfg);
+            fge.get_config(fge_ctx, &fge_cfg);
+            fge_flush_log(fge_ctx);
+            multi_observe = fg_multi_requested();
+            if (multi_observe) {
+                fg_multi_invalidate(self);
+                if ((fg_multi_host_proofs & EFT_MULTI_PROOFS) != EFT_MULTI_PROOFS)
+                    fprintf(stderr, "ember-d3dm-fg: multi transport off: original lifetime/order/producer safety unproven; legacy n=1 retained\n");
+            }
+            fprintf(stderr, "ember-d3dm-fg: EmberFG 엔진 v%u.%u (mc=%d mode=%s game_cap=%.0f)\n", fge.abi_version() >> 16,
+                    fge.abi_version() & 0xffff, (int)fge_cfg.mc_enabled, fge_cfg.smooth ? "smooth" : "fill", fge_cfg.game_cap_fps);
+        }
+        else fprintf(stderr, "ember-d3dm-fg: EmberFG 엔진을 시작하지 못해 프레임 보간을 끕니다\n");
+    }
+
+    }
+}
+- (void)setPixelFormat:(MTLPixelFormat)f
+{
+    @synchronized (link_adapter) {
+    if (ember_up_log()) fprintf(stderr, "ember-d3dm-up: D3DMetal setPixelFormat %lu\n", (unsigned long)f);
+    if (f != self.pixelFormat) { fg_multi_invalidate(self); [link_adapter revoke]; }
+    [super setPixelFormat:f];
+    if (!ahdr_on && (!link_adapter || [link_adapter mayMutate])) real.pixelFormat = f;
+    else if (link_adapter) link_surface_dirty = YES;   /* Auto HDR 중엔 진짜 레이어는 RGBA16Float 그대로 */
+    if (ahdr) { ahdr_applied = NO; fg_ahdr_layer(self); }
+
+    }
+}
+/* 화면 확대가 켜져 있으면 게임(대리 레이어)은 게임 크기, 진짜 레이어는 × 배율(모니터 픽셀) — ember_up_layer_size. 꺼져 있으면 s 그대로. */
+- (void)setDrawableSize:(CGSize)s {
+    @synchronized (link_adapter) {
+    if (!CGSizeEqualToSize(s, self.drawableSize)) { fg_multi_invalidate(self); [link_adapter revoke]; }
+    [super setDrawableSize:s];
+    if (!link_adapter || [link_adapter mayMutate]) real.drawableSize = ember_up_layer_size(real, s);
+    else link_surface_dirty = YES;
+
+    }
+}
+- (void)setHidden:(BOOL)v {
+    @synchronized (link_adapter) { if (v != self.hidden) { fg_multi_invalidate(self); [link_adapter hostHidden:v]; } [super setHidden:v];
+    }
+}
+- (void)setColorspace:(CGColorSpaceRef)c
+{
+    @synchronized (link_adapter) {
+    if (ember_up_log())
+    {
+        CFStringRef n = c ? CGColorSpaceCopyName(c) : NULL;
+        fprintf(stderr, "ember-d3dm-up: D3DMetal setColorspace %s\n", n ? [(NSString *)n UTF8String] : "(null)");
+        if (n) CFRelease(n);
+    }
+    [super setColorspace:c];
+    if (!ahdr_on) { real.colorspace = c; [link_adapter metadataChanged]; }
+    else if (link_adapter) { [link_adapter revoke]; link_surface_dirty = YES; }
+    fg_seen_real(self);
+    if (ahdr) { ahdr_applied = NO; fg_ahdr_layer(self); }
+
+    }
+}
+/* Ember(hdr12): 게임이 진짜 레이어에 바로 준 값을 대리 레이어에만 적는다(진짜 레이어로 되돌려 쓰지 않는다) */
+- (void)emberAdoptColorspace:(CGColorSpaceRef)c edr:(BOOL)v
+{
+    @synchronized (link_adapter) {
+        /* Proxy-only adoption still changes source interpretation. Cancel old
+         * epoch candidates, without writing the actual layer back. */
+        if (c != self.colorspace || v != self.wantsExtendedDynamicRangeContent) [link_adapter metadataChanged];
+        [super setColorspace:c];
+        [super setWantsExtendedDynamicRangeContent:v];
+    }
+}
+- (void)setDisplaySyncEnabled:(BOOL)v {
+    @synchronized (link_adapter) {
+        [link_adapter revoke]; [super setDisplaySyncEnabled:v]; game_sync = v;
+        if (!link_adapter || [link_adapter mayMutate]) { fg_apply_sync(self); fg_apply_drawables(self); }
+        else link_surface_dirty = YES;
+    }
+}
+- (void)setMaximumDrawableCount:(NSUInteger)n
+{
+    @synchronized (link_adapter) {
+    if (n != game_drawables) [link_adapter revoke];
+    [super setMaximumDrawableCount:n];
+    if (!link_adapter || [link_adapter mayMutate]) real.maximumDrawableCount = n;
+    else link_surface_dirty = YES;
+    game_drawables = n;            /* D3DMetal 이 스왑체인을 만들 때마다 3 을 다시 준다 → 규칙을 다시 적용 */
+    if (!link_adapter || [link_adapter mayMutate]) fg_apply_drawables(self);
+
+    }
+}
+- (void)setWantsExtendedDynamicRangeContent:(BOOL)v
+{
+    @synchronized (link_adapter) {
+    if (ember_up_log()) fprintf(stderr, "ember-d3dm-up: D3DMetal setWantsExtendedDynamicRangeContent %d\n", v);
+    [super setWantsExtendedDynamicRangeContent:v];
+    if (!ahdr_on) { real.wantsExtendedDynamicRangeContent = v; [link_adapter metadataChanged]; }
+    else if (link_adapter) { [link_adapter revoke]; link_surface_dirty = YES; }
+    fg_seen_real(self);
+    if (ahdr) { ahdr_applied = NO; fg_ahdr_layer(self); }
+    }
+}
+/* 셰이더로 읽어야 하므로 대리 레이어의 drawable 은 늘 읽을 수 있게 둔다. */
+- (void)setFramebufferOnly:(BOOL)v { [super setFramebufferOnly:NO]; }
+/* 크기·배율은 화면에 붙은 진짜 레이어를 따른다. */
+- (CGRect)bounds { return real ? real.bounds : [super bounds]; }
+- (CGRect)frame { return real ? real.frame : [super frame]; }
+/* 화면 확대 중엔 진짜 레이어 contentsScale 을 올려 두므로, 게임 쪽에는 원래(게임이 보는) 배율을 알려 준다. */
+- (CGFloat)contentsScale { return real ? ember_up_game_scale(real) : [super contentsScale]; }
+
+@end
+
+void *ember_fg_wrap_layer(void *layer)
+{
+    CAMetalLayer *real = (CAMetalLayer *)layer;
+    static char key;
+    EmberFGLayer *p;
+    const char *hz;
+
+    if (!real) return layer;
+    if (!fg_enabled())
+    {
+        /* Ember HUD: 대리 레이어 없이도 D3DMetal 의 presentDrawable: 에서 판을 얹는다(가로채기만 설치, 판이 없으면 그대로 통과) */
+        if ((ember_hud_mark_layer(real) | ember_hdr_meta_on()) && real.device) fg_hook_device(real.device);   /* (hdr12) PQ EDR 메타데이터도 */
+        return layer;
+    }
+    if ((p = objc_getAssociatedObject(real, &key))) return p;
+
+    p = [[EmberFGLayer alloc] init];
+    p->real = [real retain];
+    ehud_proxy_real = p->real;
+    p->game_sync = real.displaySyncEnabled;
+    [p setFramebufferOnly:NO];
+    if (real.device) [p setDevice:real.device];
+    if ((hz = getenv("EMBER_D3DM_FG_HZ")) && atof(hz) > 1) p->display_interval = 1.0 / atof(hz);
+    else
+    {
+        /* D3DMetal 스레드에서 불리므로 AppKit 대신 CoreGraphics 로 읽는다. ProMotion 은 0 을 돌려주므로 120 으로 본다. */
+        CGDisplayModeRef mode = CGDisplayCopyDisplayMode(CGMainDisplayID());
+        double r = mode ? CGDisplayModeGetRefreshRate(mode) : 0;
+        if (mode) CGDisplayModeRelease(mode);
+        p->display_interval = 1.0 / (r > 1 ? r : 120);
+    }
+    objc_setAssociatedObject(real, &key, p, OBJC_ASSOCIATION_RETAIN);
+    [p release];
+    if (fg_link_requested()) {
+        if (!fge_available() || !ember_fg_dl_api_valid(&fg_link_api)) {
+            fprintf(stderr, "ember-d3dm-link: host engine/optional ABI unavailable; legacy\n");
+        } else {
+            /* The service has a simple SDR copy output. Preserve existing postprocess
+             * contracts by rejecting incompatible host configurations as a whole. */
+            /* (wm-merge-1017) any ANE source (1|flowq|llfi) rejects the link as a whole. */
+            const char *serial = getenv("EMBER_FG_PRESENTER");
+            if (!ember_up_enabled() && !ember_neural_enabled() && !ember_ahdr_enabled() &&
+                fg_sharpness() <= 0 && !(serial && !strcmp(serial, "1")) && !fg_ane_source())
+                p->link_adapter = [[EmberDisplayLinkAdapter alloc] initWithLayer:real];
+            else fprintf(stderr, "ember-d3dm-link: incompatible postprocess/presenter; legacy\n");
+        }
+    }
+    fg_seen_real(p);         /* (hdr12) 진짜 레이어의 처음 색공간 */
+    fg_apply_drawables(p);   /* 첫 nextDrawable 전에 2장으로 — 대기열 풀이 만들어진 뒤 바꾸는 것보다 확실하다 */
+    fprintf(stderr, "ember-d3dm-fg: proxy layer for %p (display %.1fms, drawables %lu, engine=%d)\n", real,
+            p->display_interval * 1000, (unsigned long)real.maximumDrawableCount, p->fge_ctx != NULL);
+    return p;
+}
diff --git a/dlls/winemac.drv/ember_hdr_d3dm.h b/dlls/winemac.drv/ember_hdr_d3dm.h
new file mode 100644
index 0000000..8f9e3d8
--- /dev/null
+++ b/dlls/winemac.drv/ember_hdr_d3dm.h
@@ -0,0 +1,81 @@
+/*
+ * Ember(hdr12): D3DMetal HDR 표시 보조 — winemac 연결부(LGPL). 
+ *
+ * D3DMetal 은 IDXGISwapChain3::SetColorSpace1(G2084 = HDR10 PQ / G10 = scRGB)을 받으면 창 뷰의 CAMetalLayer 를
+ * ITUR_2100_PQ(또는 확장 선형 sRGB) + wantsExtendedDynamicRangeContent 로 바꾼다(3.0 실측·역어셈블). 하지만 EDR 메타데이터를
+ * 주지 않아, 게임이 출력 최대 밝기(GetDesc1 MaxLuminance = 화면 잠재 헤드룸 × 100nit)에 맞춰 만든 하이라이트가 지금 화면이 낼 수
+ * 있는 밝기(현재 헤드룸, 예: MAG 272U 3.9 = 390nit)를 넘으면 그대로 잘린다. PQ 레이어에 HDR10 EDR 메타데이터를 주면 macOS 가
+ * 지금 헤드룸에 맞춰 톤 매핑한다(중간 밝기는 그대로, opticalOutputScale 100 = 100nit 가 EDR 1.0).
+ *
+ * 기본 꺼짐(EMBER_HDR_EDRMETA=1 로 켬): 10-03 실측(hdrcap HDR 캡처) — HDR10 메타데이터를 주면 macOS 가 PQ 를 다른 기준 흰색으로 읽어
+ * 화면 전체가 절반 밝기가 됐다(100nit → EDR 0.50, 1000nit → 5.0). 하이라이트를 접는 효과보다 손해가 커서 실험으로만 남긴다.
+ * 진짜 레이어에만 쓴다(대리 레이어는 화면에 안 붙는다).
+ */
+#ifndef EMBER_HDR_D3DM_H
+#define EMBER_HDR_D3DM_H
+
+static int ember_hdr_meta_on(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        /* D3DMetal 일 때만(DXMT 는 자기 표시 셰이더가 지금 헤드룸에 맞춰 톤 매핑한다 — 겹치면 두 번 접힌다) */
+        const char *v = getenv("EMBER_HDR_EDRMETA"), *b = getenv("CX_ACTIVE_GRAPHICS_BACKEND");
+        on = (v && *v ? atoi(v) != 0 : 0) && b && !strcmp(b, "d3dmetal");
+    }
+    return on;
+}
+
+static char ember_hdr_meta_key;
+
+/* 레이어 색공간이 PQ 면 HDR10 EDR 메타데이터를 둔다(없을 때만), PQ 가 아니게 되면 우리가 둔 것을 걷는다.
+ * potential = 창 화면의 잠재 EDR 헤드룸(0 = 모름 → 1000nit, 음수 = 필요할 때 주 화면에서 읽음). 게임 스레드에서 불러도 된다(CALayer 속성). */
+static void ember_hdr_meta_apply(CAMetalLayer *l, double potential)
+{
+    CGColorSpaceRef cs;
+    CFStringRef name;
+    BOOL pq = NO, ours;
+    if (!l || !ember_hdr_meta_on()) return;
+    if (@available(macOS 11.0, *))
+    {
+        cs = l.colorspace;
+        if (cs && (name = CGColorSpaceCopyName(cs)))
+        {
+            pq = CFEqual(name, kCGColorSpaceITUR_2100_PQ);
+            CFRelease(name);
+        }
+        ours = objc_getAssociatedObject(l, &ember_hdr_meta_key) != nil;
+        if (pq && !l.EDRMetadata)
+        {
+            float maxl;
+            if (potential < 0) potential = [[NSScreen mainScreen] maximumPotentialExtendedDynamicRangeColorComponentValue];
+            maxl = potential > 1.0 ? (float)(potential * 100.0) : 1000.0f;
+            l.EDRMetadata = [CAEDRMetadata HDR10MetadataWithMinLuminance:0.0001f maxLuminance:maxl opticalOutputScale:100.0f];
+            objc_setAssociatedObject(l, &ember_hdr_meta_key, (id)kCFBooleanTrue, OBJC_ASSOCIATION_ASSIGN);
+            fprintf(stderr, "ember-hdr: PQ layer %p — HDR10 EDR metadata max %.0f nit (system tone mapping to current headroom)\n", l, maxl);
+        }
+        else if (!pq && ours && l.EDRMetadata)
+        {
+            l.EDRMetadata = nil;
+            objc_setAssociatedObject(l, &ember_hdr_meta_key, nil, OBJC_ASSOCIATION_ASSIGN);
+            fprintf(stderr, "ember-hdr: layer %p left PQ — EDR metadata removed\n", l);
+        }
+    }
+}
+
+/* 대리 레이어 없이(보간·확대 끔) D3DMetal 이 진짜 레이어로 바로 낼 때: presentDrawable: 가로채기에서 0.5초에 한 번만 본다. */
+static void ember_hdr_on_present(id d)
+{
+    static double next;
+    double now;
+    CAMetalLayer *l;
+    if (!ember_hdr_meta_on() || ![d respondsToSelector:@selector(layer)]) return;
+    now = CACurrentMediaTime();
+    if (now < next) return;
+    next = now + 0.5;
+    l = [(id<CAMetalDrawable>)d layer];
+    if (![l isKindOfClass:[CAMetalLayer class]]) return;
+    ember_hdr_meta_apply(l, -1);   /* 잠재 헤드룸은 메타데이터를 둘 때만 묻는다 */
+}
+
+#endif
diff --git a/dlls/winemac.drv/ember_hud_d3dm.h b/dlls/winemac.drv/ember_hud_d3dm.h
new file mode 100644
index 0000000..9bb58d7
--- /dev/null
+++ b/dlls/winemac.drv/ember_hud_d3dm.h
@@ -0,0 +1,179 @@
+/*
+ * Ember in-game HUD for D3DMetal — thin connection to the optional EmberCore HUD library (libEmberHUD.dylib next to
+ * winemac.so, or EMBER_HUD_LIB). The library maps the Ember app's shared panel images for this process and blends the
+ * visible panels (boss mechanics, Ember speech bubble, toasts) onto the frame that goes to the screen with one small
+ * render pass, so the app does not need a separate window above the game (a window above the game forces macOS to
+ * composite the game instead of presenting it directly).
+ *
+ * Where it draws:
+ *   - frame generation / upscale / Auto HDR proxy layer (ember_framegen.m): every frame that goes to the real layer,
+ *     real and interpolated (fg_draw);
+ *   - plain D3DMetal (no proxy): D3DMetal's own [commandBuffer presentDrawable:] on the window's layer — the HUD pass is
+ *     appended to that command buffer just before the present (the same interception ember_framegen.m already uses).
+ * EMBER_HUD=0 turns it off. Without the library nothing changes.
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifndef __EMBER_HUD_D3DM_H
+#define __EMBER_HUD_D3DM_H
+
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* same layout as EmberCore/hud/include/ember_hud.h (ABI 1.x) */
+struct ehud_encode_in { uint32_t size, transfer; uint64_t command_buffer, target; float sdr_white, pad0; };
+struct ehud_encode_out { uint32_t size, drawn; int32_t next_call_ms; uint32_t attached; };
+enum { EHUD_TRANSFER_AUTO = 0, EHUD_TRANSFER_LINEAR = 1, EHUD_TRANSFER_PQ = 2 };
+#define EHUD_HOST_D3DMETAL 1
+
+static struct
+{
+    uint32_t (*abi_version)(void);
+    void *(*create)(uint64_t device, const char *env, size_t len, uint32_t host);
+    int (*encode)(void *ctx, const struct ehud_encode_in *in, struct ehud_encode_out *out);
+} ehud;
+static pthread_once_t ehud_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t ehud_lock = PTHREAD_MUTEX_INITIALIZER;
+static void *ehud_ctx;
+static id ehud_dev;                     /* device the context was made for (not retained — the library retains it) */
+static volatile double ehud_next;       /* CACurrentMediaTime() before which calls are skipped (nothing visible) */
+static volatile int ehud_drawing;       /* last call drew something → call every frame */
+static char ehud_layer_key;             /* associated object: this real layer gets the HUD on presentDrawable: */
+static CAMetalLayer *volatile ehud_proxy_real;   /* real layer behind the frame-generation proxy (colour space for fg_draw) */
+
+static void ehud_load(void)
+{
+    char path[4096];
+    const char *v = getenv("EMBER_HUD"), *override = getenv("EMBER_HUD_LIB");
+    void *lib = NULL;
+    Dl_info info;
+    if (v && !strcmp(v, "0")) return;
+    path[0] = 0;
+    if (override && *override) snprintf(path, sizeof(path), "%s", override);
+    else if (dladdr((const void *)&ehud_load, &info) && info.dli_fname)
+    {
+        const char *slash = strrchr(info.dli_fname, '/');
+        if (slash) snprintf(path, sizeof(path), "%.*s/libEmberHUD.dylib", (int)(slash - info.dli_fname), info.dli_fname);
+    }
+    if (path[0]) lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!lib) return;
+    *(void **)&ehud.abi_version = dlsym(lib, "ember_hud_abi_version");
+    *(void **)&ehud.create = dlsym(lib, "ember_hud_create");
+    *(void **)&ehud.encode = dlsym(lib, "ember_hud_encode");
+    if (!ehud.abi_version || (ehud.abi_version() >> 16) != 1 || !ehud.create || !ehud.encode)
+    {
+        memset(&ehud, 0, sizeof(ehud));
+        dlclose(lib);
+    }
+}
+
+static int ehud_available(void)
+{
+    pthread_once(&ehud_once, ehud_load);
+    return ehud.encode != NULL;
+}
+
+/* Transfer of the layer the frame goes to: PQ / extended-linear colour spaces, else sRGB-encoded (the library handles *_sRGB). */
+static uint32_t ehud_transfer_for(CAMetalLayer *layer, MTLPixelFormat fmt)
+{
+    uint32_t t = EHUD_TRANSFER_AUTO;
+    CGColorSpaceRef cs = layer ? layer.colorspace : NULL;
+    if (cs)
+    {
+        CFStringRef n = CGColorSpaceCopyName(cs);
+        if (n)
+        {
+            if (CFStringFind(n, CFSTR("PQ"), 0).location != kCFNotFound) t = EHUD_TRANSFER_PQ;
+            else if (CFStringFind(n, CFSTR("Linear"), 0).location != kCFNotFound) t = EHUD_TRANSFER_LINEAR;
+            CFRelease(n);
+        }
+    }
+    else if (fmt == MTLPixelFormatRGBA16Float) t = EHUD_TRANSFER_LINEAR;
+    return t;
+}
+
+/* Append the HUD pass for dst (a texture that goes to the screen) to cb. Cheap when nothing is shown (one time check). */
+static void ember_hud_draw(id<MTLCommandBuffer> cb, id<MTLTexture> dst, CAMetalLayer *layer)
+{
+    struct ehud_encode_in in;
+    struct ehud_encode_out out;
+    double now;
+    if (!cb || !dst) return;
+    now = CACurrentMediaTime();
+    if (!ehud_drawing && now < ehud_next) return;
+    if (!ehud_available()) { ehud_next = now + 3600; return; }
+    pthread_mutex_lock(&ehud_lock);
+    if (!ehud_ctx || ehud_dev != (id)cb.device)
+    {
+        /* one context per process (the device of D3DMetal's queue); a new device replaces it — rare, the old one is leaked */
+        ehud_ctx = ehud.create((uint64_t)(uintptr_t)cb.device, NULL, 0, EHUD_HOST_D3DMETAL);
+        ehud_dev = (id)cb.device;
+        if (ehud_ctx) fprintf(stderr, "ember-hud: d3dmetal HUD ready\n");
+    }
+    if (!ehud_ctx) { pthread_mutex_unlock(&ehud_lock); ehud_next = now + 3600; return; }
+    memset(&in, 0, sizeof(in));
+    in.size = sizeof(in);
+    in.transfer = ehud_transfer_for(layer, dst.pixelFormat);
+    in.command_buffer = (uint64_t)(uintptr_t)cb;
+    in.target = (uint64_t)(uintptr_t)dst;
+    memset(&out, 0, sizeof(out));
+    out.size = sizeof(out);
+    out.next_call_ms = 500;
+    ehud.encode(ehud_ctx, &in, &out);
+    pthread_mutex_unlock(&ehud_lock);
+    ehud_drawing = out.next_call_ms <= 0;
+    ehud_next = now + (out.next_call_ms > 0 ? out.next_call_ms : 0) / 1000.0;
+}
+
+/* Plain D3DMetal (no proxy layer): mark the window's real layer. Returns 1 if the presentDrawable: hook must be installed. */
+/* DXMT also asks winemac for the window's layer (winemetal.so → macdrv_view_get_metal_layer), but its presenter draws the
+ * HUD itself (EmberHudHook, host DXMT). Marking that layer too drew every panel twice (10-03 inhud2: d11fs "d3dmetal HUD
+ * ready"). winemetal.so is DXMT's unix side and D3DMetal never loads it, so: loaded → this layer is DXMT's → leave it. */
+static int ehud_dxmt_in_process(void)
+{
+    uint32_t i, n = _dyld_image_count();
+    for (i = 0; i < n; i++)
+    {
+        const char *name = _dyld_get_image_name(i);
+        size_t len = name ? strlen(name) : 0;
+        if (len >= 13 && !strcmp(name + len - 13, "/winemetal.so")) return 1;
+    }
+    return 0;
+}
+
+static int ember_hud_mark_layer(CAMetalLayer *layer)
+{
+    if (!layer || !ehud_available()) return 0;
+    if (ehud_dxmt_in_process())
+    {
+        static int said;
+        if (!said++) fprintf(stderr, "ember-hud: DXMT in this process — winemac leaves the HUD to DXMT\n");
+        return 0;
+    }
+    if (objc_getAssociatedObject(layer, &ehud_layer_key)) return 1;
+    objc_setAssociatedObject(layer, &ehud_layer_key, (id)kCFBooleanTrue, OBJC_ASSOCIATION_ASSIGN);
+    fprintf(stderr, "ember-hud: d3dmetal layer %p marked for in-game HUD\n", layer);
+    return 1;
+}
+
+/* presentDrawable: hook, drawable of a marked real layer: draw the HUD into it before the present. */
+static void ember_hud_on_present(id<MTLCommandBuffer> cb, id d)
+{
+    CAMetalLayer *layer;
+    if (!ehud.encode || ![d respondsToSelector:@selector(layer)]) return;
+    layer = [(id<CAMetalDrawable>)d layer];
+    if (!layer || !objc_getAssociatedObject(layer, &ehud_layer_key)) return;
+    ember_hud_draw(cb, [(id<CAMetalDrawable>)d texture], layer);
+}
+
+#endif
diff --git a/dlls/winemac.drv/ember_neural.h b/dlls/winemac.drv/ember_neural.h
new file mode 100644
index 0000000..359d298
--- /dev/null
+++ b/dlls/winemac.drv/ember_neural.h
@@ -0,0 +1,51 @@
+/*
+ * Ember Neural: 완성된 게임 프레임에 거는 "사실감" 후처리(ForgePlay 2.0 의 DLSS5 흉내 기능에 대응).
+ *
+ *  - 게임 해상도 원본에 프레임마다 한 번, 보간(프레임 생성) 앞에서 건다. 보간·표시 패스는 모두 처리본을 읽는다.
+ *  - 표시 경로에 들어가는 것은 Metal 패스 셋뿐(다운스케일·통계·적용, 전부 같은 커맨드 버퍼, CPU 동기화 없음).
+ *  - CoreML(뉴럴 엔진)은 완전히 비동기: 720p 로 줄인 프레임을 IOSurface 로 넘기고(복사 0), "가장 최근 완료 결과" 의
+ *    저주파 색 차이(delta = 모델 출력 - 모델 입력)를 현재 프레임에 얹는다. 원본의 고주파 디테일은 그대로 남는다
+ *    (out = x + up(y_lo - x_lo) = up(y_lo) + (x - up(x_lo))). 결과가 늦으면 그냥 이전 결과를 쓴다 — fps·지연 영향 0.
+ *  - 색 일관성 가드: 처리본의 채널별 평균·분산을 원본에 맞춘다(초록 끼 같은 색 쏠림 제거). 세기 0~100%.
+ *  - 모델이 없어도 비 ML 기본 패스(필름 S 커브·국소 대비·바이브런스·그레인)로 바로 쓸 수 있다.
+ *
+ * 환경 변수: EMBER_NEURAL=1 켬. EMBER_NEURAL_STRENGTH 0~100(기본 60). EMBER_NEURAL_RES 분석 세로 해상도(기본 720, 0=원본).
+ *  EMBER_NEURAL_MODEL 모델 이름/경로(없으면 기본 패스만). EMBER_NEURAL_UNITS ane|all|gpu|cpu. EMBER_NEURAL_GUARD 0~100(기본 100).
+ *  EMBER_NEURAL_CONTRAST/CLARITY/VIBRANCE/GRAIN 0~100(기본 35/25/20/0, 모델이 있으면 대비·바이브런스 기본 0).
+ *  EMBER_NEURAL_LOG=1 5초마다 통계.
+ */
+#ifndef __EMBER_NEURAL_H
+#define __EMBER_NEURAL_H
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ember_neural ember_neural_t;
+
+/* EMBER_NEURAL=1 인가(한 번만 읽는다) */
+int ember_neural_enabled(void);
+/* 켜져 있지 않으면 NULL. */
+ember_neural_t *ember_neural_create(id<MTLDevice> dev);
+void ember_neural_destroy(ember_neural_t *n);
+/* src → dst(같은 크기, 렌더 타깃). dst 가 nil 이면 내부 스크래치 텍스처를 쓰고 그것을 돌려준다.
+ * 실패(멀티샘플·형식 불가)하면 src 를 그대로 돌려준다(호출자는 돌려받은 텍스처를 쓰면 된다). */
+id<MTLTexture> ember_neural_encode(ember_neural_t *n, id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst);
+/* neuralbench: 파라미터 덮어쓰기 / 통계 */
+struct ember_neural_info {
+    uint64_t frames, ane_done, ane_skipped, ane_failed;
+    double ane_ms_ema, ane_ms_max, ane_open_ms;
+    int model_loaded, lo_w, lo_h, layout;
+    char model_path[512];
+};
+void ember_neural_info(ember_neural_t *n, struct ember_neural_info *info);
+/* 표시 프레임이 끝나기를 기다려야 하는 도구용: 모델 결과가 최소 하나 있을 때까지(최대 ms) */
+int ember_neural_wait_model(ember_neural_t *n, double timeout_ms);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* __OBJC__ */
+#endif
diff --git a/dlls/winemac.drv/ember_neural.m b/dlls/winemac.drv/ember_neural.m
new file mode 100644
index 0000000..80c7b71
--- /dev/null
+++ b/dlls/winemac.drv/ember_neural.m
@@ -0,0 +1,82 @@
+/*
+ * Ember Tone (EMBER_NEURAL) glue for the D3DMetal path. The look passes and the CoreML worker live in libEmberTone.dylib
+ * (EmberCore, separate proprietary library); this file only loads it and forwards the calls (API: ember_neural.h).
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ember_neural.h"
+#include "ember_tone_load.h"
+
+struct ember_neural { void *ctx; };
+
+int ember_neural_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *v = getenv("EMBER_NEURAL"); on = v && !strcmp(v, "1"); }
+    return on;
+}
+
+ember_neural_t *ember_neural_create(id<MTLDevice> dev)
+{
+    struct ember_neural *n;
+    void *ctx;
+    if (!dev || !ember_neural_enabled() || !etone_available()) return NULL;
+    ctx = etone.neural_create((uint64_t)(uintptr_t)dev, NULL, 0, ETONE_HOST_D3DMETAL);
+    if (!ctx) return NULL;
+    n = calloc(1, sizeof(*n));
+    if (!n) { etone.neural_destroy(ctx); return NULL; }
+    n->ctx = ctx;
+    return n;
+}
+
+void ember_neural_destroy(ember_neural_t *n)
+{
+    if (!n) return;
+    etone.neural_destroy(n->ctx);
+    free(n);
+}
+
+id<MTLTexture> ember_neural_encode(ember_neural_t *n, id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst)
+{
+    struct etone_neural_in in;
+    struct etone_neural_out out;
+    if (!n || !src) return src;
+    memset(&in, 0, offsetof(struct etone_neural_in, wait_fences));
+    in.size = offsetof(struct etone_neural_in, wait_fences);   /* no fences on this path */
+    in.rt_mode = -1;
+    in.command_buffer = (uint64_t)(uintptr_t)cb;
+    in.source = (uint64_t)(uintptr_t)src;
+    in.target = (uint64_t)(uintptr_t)dst;
+    memset(&out, 0, sizeof(out));
+    out.size = sizeof(out);
+    if (!etone.neural_encode(n->ctx, &in, &out)) return src;
+    return (id<MTLTexture>)(uintptr_t)out.texture;
+}
+
+void ember_neural_info(ember_neural_t *n, struct ember_neural_info *info)
+{
+    struct etone_neural_info r;
+    memset(info, 0, sizeof(*info));
+    if (!n) return;
+    memset(&r, 0, sizeof(r));
+    r.size = sizeof(r);
+    etone.neural_get_info(n->ctx, &r);
+    info->frames = r.frames;
+    info->model_loaded = r.model_loaded;
+    info->ane_done = r.ane_done; info->ane_skipped = r.ane_skipped; info->ane_failed = r.ane_failed;
+    info->ane_ms_ema = r.ane_ms_ema; info->ane_ms_max = r.ane_ms_max; info->ane_open_ms = r.ane_open_ms;
+    info->lo_w = r.lo_w; info->lo_h = r.lo_h; info->layout = r.layout;
+    strlcpy(info->model_path, r.model_path, sizeof(info->model_path));
+}
+
+int ember_neural_wait_model(ember_neural_t *n, double timeout_ms)
+{
+    return n ? etone.neural_wait_model(n->ctx, timeout_ms) : 0;
+}
diff --git a/dlls/winemac.drv/ember_tone_load.h b/dlls/winemac.drv/ember_tone_load.h
new file mode 100644
index 0000000..5870dcd
--- /dev/null
+++ b/dlls/winemac.drv/ember_tone_load.h
@@ -0,0 +1,112 @@
+/*
+ * Ember Tone / Ember Flare glue (winemac.drv, D3DMetal path): loads the optional libEmberTone.dylib (EmberCore, separate
+ * proprietary library, not part of this tree) from the directory of winemac.so (override: EMBER_TONE_LIB) and resolves its
+ * C ABI. When the library is missing or has another ABI major version, Tone (EMBER_NEURAL) and Flare (EMBER_AUTOHDR) stay off.
+ * The structs below have the same layout as EmberCore/tone/include/ember_tone.h (ABI 1.x).
+ *
+ * This library is free software; you can redistribute it and/or modify it under the terms of the GNU Lesser
+ * General Public License as published by the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#ifndef __EMBER_TONE_LOAD_H
+#define __EMBER_TONE_LOAD_H
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define ETONE_HOST_D3DMETAL 1
+#define ETONE_MAX_WAIT_FENCES 256
+
+struct etone_neural_in {
+    uint32_t size; int32_t rt_mode;
+    uint64_t command_buffer, source, target;
+    uint32_t sample_count, n_wait_fences;
+    uint64_t wait_fences[ETONE_MAX_WAIT_FENCES];
+};
+struct etone_neural_out { uint32_t size, processed; uint64_t texture; };
+struct etone_neural_info {
+    uint32_t size, model_loaded;
+    uint64_t frames, ane_done, ane_skipped, ane_failed;
+    double ane_ms_ema, ane_ms_max, ane_open_ms;
+    int32_t lo_w, lo_h, layout, lut_mode;
+    char model_path[512];
+};
+struct etone_ahdr_config { uint32_t size, failed; float strength, peak_cap, gamma22, wexp, peak, pad; };
+struct etone_ahdr_encode_in {
+    uint32_t size, flags;
+    uint64_t command_buffer, source;
+    uint32_t n_wait_fences, pad;
+    uint64_t wait_fences[ETONE_MAX_WAIT_FENCES];
+};
+#define ETONE_AHDR_SRC_AUTO 2
+struct etone_ahdr_encode_out { uint32_t size, ok; uint64_t gain; };
+struct etone_ahdr_frame_in { uint32_t size, log; double edr_now, edr_potential; };
+struct etone_ahdr_frame_out { uint32_t size; float peak; };
+struct etone_ahdr_draw_in { uint32_t size; float blend, sharp; uint32_t pad; uint64_t command_buffer, current, previous, target; };
+
+static struct
+{
+    uint32_t (*abi_version)(void);
+    void *(*neural_create)(uint64_t device, const char *env, size_t len, uint32_t host);
+    void (*neural_destroy)(void *ctx);
+    int (*neural_encode)(void *ctx, const struct etone_neural_in *in, struct etone_neural_out *out);
+    void (*neural_get_info)(void *ctx, struct etone_neural_info *info);
+    int (*neural_wait_model)(void *ctx, double timeout_ms);
+    void *(*ahdr_create)(uint64_t device, const char *env, size_t len, uint32_t host);
+    void (*ahdr_destroy)(void *ctx);
+    void (*ahdr_get_config)(void *ctx, struct etone_ahdr_config *cfg);
+    int (*ahdr_encode)(void *ctx, const struct etone_ahdr_encode_in *in, struct etone_ahdr_encode_out *out);
+    void (*ahdr_frame)(void *ctx, const struct etone_ahdr_frame_in *in, struct etone_ahdr_frame_out *out);
+    int (*ahdr_draw)(void *ctx, const struct etone_ahdr_draw_in *in);
+} etone;
+static pthread_once_t etone_once = PTHREAD_ONCE_INIT;
+
+static void etone_load(void)
+{
+    char path[4096];
+    const char *override = getenv("EMBER_TONE_LIB");
+    void *lib = NULL;
+    Dl_info info;
+    path[0] = 0;
+    if (override && *override) snprintf(path, sizeof(path), "%s", override);
+    else if (dladdr((const void *)&etone_load, &info) && info.dli_fname)
+    {
+        const char *slash = strrchr(info.dli_fname, '/');
+        if (slash) snprintf(path, sizeof(path), "%.*s/libEmberTone.dylib", (int)(slash - info.dli_fname), info.dli_fname);
+    }
+    if (path[0]) lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!lib) { fprintf(stderr, "ember-tone: libEmberTone.dylib not found — Tone/Flare off\n"); return; }
+#define ETONE_SYM(f, n) *(void **)&etone.f = dlsym(lib, n)
+    ETONE_SYM(abi_version, "ember_tone_abi_version");
+    ETONE_SYM(neural_create, "ember_tone_neural_create");
+    ETONE_SYM(neural_destroy, "ember_tone_neural_destroy");
+    ETONE_SYM(neural_encode, "ember_tone_neural_encode");
+    ETONE_SYM(neural_get_info, "ember_tone_neural_get_info");
+    ETONE_SYM(neural_wait_model, "ember_tone_neural_wait_model");
+    ETONE_SYM(ahdr_create, "ember_tone_ahdr_create");
+    ETONE_SYM(ahdr_destroy, "ember_tone_ahdr_destroy");
+    ETONE_SYM(ahdr_get_config, "ember_tone_ahdr_get_config");
+    ETONE_SYM(ahdr_encode, "ember_tone_ahdr_encode");
+    ETONE_SYM(ahdr_frame, "ember_tone_ahdr_frame");
+    ETONE_SYM(ahdr_draw, "ember_tone_ahdr_draw");
+#undef ETONE_SYM
+    if (!etone.abi_version || (etone.abi_version() >> 16) != 1 || !etone.neural_create || !etone.neural_destroy ||
+        !etone.neural_encode || !etone.neural_get_info || !etone.neural_wait_model || !etone.ahdr_create || !etone.ahdr_destroy ||
+        !etone.ahdr_get_config || !etone.ahdr_encode || !etone.ahdr_frame || !etone.ahdr_draw)
+    {
+        fprintf(stderr, "ember-tone: libEmberTone.dylib has an incompatible ABI — Tone/Flare off\n");
+        memset(&etone, 0, sizeof(etone));
+        dlclose(lib);
+    }
+}
+
+static int etone_available(void)
+{
+    pthread_once(&etone_once, etone_load);
+    return etone.abi_version != NULL;
+}
+
+#endif
diff --git a/dlls/winemac.drv/ember_upscale.h b/dlls/winemac.drv/ember_upscale.h
new file mode 100644
index 0000000..236851e
--- /dev/null
+++ b/dlls/winemac.drv/ember_upscale.h
@@ -0,0 +1,59 @@
+/*
+ * Ember: D3DMetal 화면 확대 (MetalFX 공간 업스케일)
+ *
+ * DXMT 의 d3d11.metalSpatialUpscaleFactor 와 같은 일을 D3DMetal 에 한다. 게임은 EMBER_RETINA_SCALE 로 작은 화면(FHD·QHD)을 보고
+ * 그 크기로 그린다. 대리 레이어(EmberFGLayer, ember_framegen.m)가 D3DMetal 의 setDrawableSize: 를 받을 때
+ *   - 대리 레이어(게임이 그리는 곳) = 게임 크기 그대로
+ *   - 진짜 레이어(화면)             = 게임 크기 × 배율(모니터 픽셀), contentsScale 도 같은 배율(macOS 가 다시 늘이지 않게)
+ * 로 가르고, 화면으로 나가는 모든 프레임(원본·보간)을 표시 직전에 MTLFXSpatialScaler 로 한 번씩 키운다.
+ * 보간(혼합·MC)·Ember Neural 은 게임 해상도에서 그대로 하고(싸다) 확대는 맨 끝 — DXMT 의 EMBER_FG_PRE_UPSCALE=1 과 같은 순서.
+ * 선명화(EMBER_D3DM_SHARPNESS, CAS)는 확대된 모니터 해상도에서 건다.
+ *
+ * 환경 변수:
+ *   EMBER_D3DM_UPSCALE=1            켬(CX_ACTIVE_GRAPHICS_BACKEND=d3dmetal 일 때만)
+ *   EMBER_D3DM_UPSCALE_FACTOR=<f>   배율(모니터 backingScale / 게임 retina 배율, FHD on 4K = 2, QHD = 1.5). 1.01 이하면 꺼짐.
+ *   EMBER_D3DM_UPSCALE_LOG=1        레이어 설정 호출(크기·형식·색공간·EDR)과 5초마다 확대 수·스케일러 재생성 수
+ *   EMBER_D3DM_UPSCALE_MODE=metalfx|bilinear   bilinear = MetalFX 없이 같은 경로(비교용)
+ */
+#ifndef __WINE_EMBER_UPSCALE_H
+#define __WINE_EMBER_UPSCALE_H
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* EMBER_D3DM_UPSCALE=1 + d3dmetal + 배율 > 1.01 + MetalFX 지원(macOS 13+, 애플 GPU). 한 번만 판정. */
+int ember_up_enabled(void);
+/* 배율(꺼져 있으면 1) */
+double ember_up_factor(void);
+/* EMBER_D3DM_UPSCALE_LOG=1 */
+int ember_up_log(void);
+
+/* 대리 레이어가 D3DMetal 의 setDrawableSize: 를 받았을 때: 진짜 레이어 크기(=게임 크기 × 배율)를 돌려주고,
+ * 진짜 레이어 contentsScale 을 (원래 값 × 배율)로 한 번 올린다. 꺼져 있으면 game 을 그대로 돌려주고 아무것도 안 바꾼다. */
+CGSize ember_up_layer_size(CAMetalLayer *real, CGSize game);
+/* 진짜 레이어의 원래(게임이 보는) contentsScale. 올리기 전이면 지금 값. */
+CGFloat ember_up_game_scale(CAMetalLayer *real);
+/* 2초마다(대리 레이어 화면 점검 때) 부른다: winemac(setRetinaMode·창 이동)이 contentsScale 을 되돌렸으면 다시 올린다. */
+void ember_up_resync_layer(CAMetalLayer *real, CGSize game);
+
+/* src(게임 해상도) → out_w × out_h 로 MetalFX 확대. 결과는 커맨드 큐마다 하나인 전용(private) 텍스처(src 와 같은 형식)라
+ * 같은 커맨드 버퍼에서 바로 읽으면 된다(추적 자원 → 순서 자동). 스케일러는 (입력 형식·크기, 출력 크기)가 바뀌면 다시 만든다.
+ * 못 하면(형식 미지원·메모리) nil — 호출자는 원래처럼 이중선형으로 그린다. 여러 스레드(게임 스레드·보간 보조 스레드)에서 불러도 된다. */
+id<MTLTexture> ember_up_encode(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger out_w, NSUInteger out_h);
+/* 보간 혼합처럼 확대 앞에 한 장을 그려야 할 때 쓰는 게임 해상도 렌더 타깃(큐마다 하나, like 와 같은 크기·형식). */
+id<MTLTexture> ember_up_scratch(id<MTLCommandBuffer> cb, id<MTLTexture> like);
+
+/* 도구(d3dmup)용: 마지막으로 만든 스케일러의 요구 용도·처리 모드 */
+struct ember_up_info { unsigned long color_usage, output_usage; int mode; unsigned long created, encoded; };
+void ember_up_get_info(struct ember_up_info *info);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* __OBJC__ */
+#endif
diff --git a/dlls/winemac.drv/ember_upscale.m b/dlls/winemac.drv/ember_upscale.m
new file mode 100644
index 0000000..682349a
--- /dev/null
+++ b/dlls/winemac.drv/ember_upscale.m
@@ -0,0 +1,549 @@
+/*
+ * Ember: D3DMetal 화면 확대 (MetalFX 공간 업스케일). 설명은 ember_upscale.h.
+ * 수동 참조 계수(MRC) — winemac 의 다른 .m 과 같다.
+ */
+
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+
+#include "ember_upscale.h"
+#include <dlfcn.h>
+
+/* ---- Ember AI 업스케일(EmberCore libEmberUp.dylib, winemac.so 옆 또는 EMBER_UP_LIB) — 기본 꺼짐, EMBER_UP_AI=1 로 켬.
+ * MetalFX 결과(정확히 2배)에 렌더 해상도 작은 망의 휘도 잔차를 더한다. 라이브러리가 없거나 ABI 가 다르면 MetalFX 만. ---- */
+static struct
+{
+    unsigned int (*abi)(void);
+    void *(*create)(uint64_t dev);
+    void (*destroy)(void *ctx);
+    int (*supported)(void *ctx, unsigned int lw, unsigned int lh, unsigned int hw, unsigned int hh, unsigned int fmt);
+    int (*post)(void *ctx, uint64_t cb, uint64_t lo, uint64_t hi, unsigned int flags, uint64_t *out);
+    size_t (*drain_log)(void *ctx, char *buf, size_t cap);
+} eup;
+static int eup_ok;
+static pthread_once_t eup_once = PTHREAD_ONCE_INIT;
+static void eup_load(void)
+{
+    char path[4096];
+    const char *ov = getenv("EMBER_UP_LIB"), *on = getenv("EMBER_UP_AI");
+    void *lib = NULL;
+    Dl_info info;
+    if (!on || strcmp(on, "1")) return;
+    path[0] = 0;
+    if (ov && *ov) snprintf(path, sizeof(path), "%s", ov);
+    else if (dladdr((const void *)&eup_load, &info) && info.dli_fname)
+    {
+        const char *slash = strrchr(info.dli_fname, '/');
+        if (slash) snprintf(path, sizeof(path), "%.*s/libEmberUp.dylib", (int)(slash - info.dli_fname), info.dli_fname);
+    }
+    if (path[0]) lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!lib) { fprintf(stderr, "ember-d3dm-up: libEmberUp 없음 — AI 업스케일 끔\n"); return; }
+    *(void **)&eup.abi = dlsym(lib, "emberup_abi_version");
+    *(void **)&eup.create = dlsym(lib, "emberup_create");
+    *(void **)&eup.destroy = dlsym(lib, "emberup_destroy");
+    *(void **)&eup.supported = dlsym(lib, "emberup_supported");
+    *(void **)&eup.post = dlsym(lib, "emberup_post");
+    *(void **)&eup.drain_log = dlsym(lib, "emberup_drain_log");
+    if (!eup.abi || (eup.abi() >> 16) != 1 || !eup.create || !eup.destroy || !eup.supported || !eup.post || !eup.drain_log)
+    {
+        fprintf(stderr, "ember-d3dm-up: libEmberUp ABI 가 맞지 않음 — AI 업스케일 끔\n");
+        memset(&eup, 0, sizeof(eup));
+        dlclose(lib);
+        return;
+    }
+    eup_ok = 1;
+    fprintf(stderr, "ember-d3dm-up: AI 업스케일 켬(libEmberUp)\n");
+}
+static int eup_available(void)
+{
+    pthread_once(&eup_once, eup_load);
+    return eup_ok;
+}
+static void eup_flush_log(void *ctx)
+{
+    char buf[2048];
+    while (ctx && eup.drain_log(ctx, buf, sizeof(buf)) > 0) fputs(buf, stderr);
+}
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+static double up_env_factor(void)
+{
+    const char *e = getenv("EMBER_D3DM_UPSCALE_FACTOR");
+    double f = e && *e ? atof(e) : 2.0;
+    if (f > 4.0) f = 4.0;
+    return f;
+}
+
+int ember_up_log(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("EMBER_D3DM_UPSCALE_LOG"); on = e && *e == '1'; }
+    return on;
+}
+
+static int up_bilinear(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("EMBER_D3DM_UPSCALE_MODE"); on = e && !strcmp(e, "bilinear"); }
+    return on;
+}
+
+int ember_up_enabled(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *v = getenv("EMBER_D3DM_UPSCALE"), *b = getenv("CX_ACTIVE_GRAPHICS_BACKEND");
+        on = v && !strcmp(v, "1") && b && !strcmp(b, "d3dmetal") && up_env_factor() > 1.01;
+        if (on && !up_bilinear())
+        {
+            on = 0;
+            if (@available(macOS 13.0, *))
+            {
+                id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+                if (dev && NSClassFromString(@"MTLFXSpatialScalerDescriptor") && [MTLFXSpatialScalerDescriptor supportsDevice:dev]) on = 1;
+                [dev release];
+            }
+            if (!on) fprintf(stderr, "ember-d3dm-up: MetalFX spatial scaler not supported, upscale off\n");
+        }
+        if (on) fprintf(stderr, "ember-d3dm-up: on, factor %.3f, mode %s\n", up_env_factor(), up_bilinear() ? "bilinear" : "metalfx");
+    }
+    return on;
+}
+
+double ember_up_factor(void)
+{
+    return ember_up_enabled() ? up_env_factor() : 1.0;
+}
+
+/* ---- 레이어 크기·배율 ---- */
+
+static char up_scale_key;   /* 진짜 레이어의 원래 contentsScale(NSNumber) */
+
+CGFloat ember_up_game_scale(CAMetalLayer *real)
+{
+    NSNumber *n = real ? objc_getAssociatedObject(real, &up_scale_key) : nil;
+    return n ? (CGFloat)n.doubleValue : (real ? real.contentsScale : 1.0);
+}
+
+static NSUInteger up_round(double v)
+{
+    NSUInteger r = (NSUInteger)(v + 0.5);
+    if (r > 16384) r = 16384;
+    return r ? r : 1;
+}
+
+static void up_apply_scale(CAMetalLayer *real)
+{
+    CGFloat base = ember_up_game_scale(real), want = base * ember_up_factor();
+    if (!objc_getAssociatedObject(real, &up_scale_key))
+        objc_setAssociatedObject(real, &up_scale_key, [NSNumber numberWithDouble:base], OBJC_ASSOCIATION_RETAIN);
+    if (real.contentsScale != want)
+    {
+        if (ember_up_log()) fprintf(stderr, "ember-d3dm-up: contentsScale %.3f -> %.3f\n", real.contentsScale, want);
+        real.contentsScale = want;
+    }
+}
+
+CGSize ember_up_layer_size(CAMetalLayer *real, CGSize game)
+{
+    CGSize out = game;
+    if (!real || !ember_up_enabled() || game.width < 1 || game.height < 1) return game;
+    out.width = up_round(game.width * up_env_factor());
+    out.height = up_round(game.height * up_env_factor());
+    up_apply_scale(real);
+    if (ember_up_log())
+        fprintf(stderr, "ember-d3dm-up: setDrawableSize game %.0fx%.0f -> screen %.0fx%.0f\n", game.width, game.height, out.width, out.height);
+    return out;
+}
+
+void ember_up_resync_layer(CAMetalLayer *real, CGSize game)
+{
+    CGSize want;
+    if (!real || !ember_up_enabled() || game.width < 1 || game.height < 1) return;
+    up_apply_scale(real);
+    want = CGSizeMake(up_round(game.width * up_env_factor()), up_round(game.height * up_env_factor()));
+    if (!CGSizeEqualToSize(real.drawableSize, want))
+    {
+        if (ember_up_log()) fprintf(stderr, "ember-d3dm-up: resync drawableSize %.0fx%.0f -> %.0fx%.0f\n",
+                                    real.drawableSize.width, real.drawableSize.height, want.width, want.height);
+        real.drawableSize = want;
+    }
+}
+
+/* ---- 스케일러: 커맨드 큐마다 문맥 하나(게임 스레드 큐·보간 보조 큐가 동시에 인코딩해도 서로 안 건드린다) ---- */
+
+#define UP_SCALERS 3   /* 문맥마다 (형식·크기) 조합 몇 개를 들고 있나 — 원본(BGRA8)·MC 결과(RGBA16F)가 번갈아 와도 다시 안 만든다 */
+#define UP_CTXS 4
+/* 스케일러 종류(10-02 upscale 작업, 화질 측정 Tools/dev/upscale):
+ *  NORMAL   : 형식 그대로(8/10비트 감마 부호 → perceptual, 게임 자체 부동소수 HDR → HDR)
+ *  CONV16   : sRGB 원본을 RGBA16F 선형 사본으로 바꾼 것 → Linear 모드(옛 HDR 모드는 선형 [0,1] 값에서 과선명·PSNR -1.8 dB)
+ *  SRGBVIEW : sRGB 원본을 복사 없이 unorm 보기로 → perceptual, 출력은 sRGB 저장 텍스처에 unorm 보기로 쓴다
+ *             (MetalFX 가 sRGB 형식 스케일러를 못 만드는 문제의 기본 해법 — 사본·16F 대역폭이 없어 더 빠르다) */
+#define UP_KIND_NORMAL 0
+#define UP_KIND_CONV16 1
+#define UP_KIND_SRGBVIEW 2
+/* EMBER_D3DM_UPSCALE_SRGB=view(기본)|linear(사본+Linear)|hdr(사본+HDR, 옛 동작) */
+static int up_srgb_mode(void)
+{
+    static int m = -1;
+    if (m < 0)
+    {
+        const char *e = getenv("EMBER_D3DM_UPSCALE_SRGB");
+        m = !e || !*e || !strcmp(e, "view") ? 0 : !strcmp(e, "linear") ? 1 : 2;
+    }
+    return m;
+}
+static MTLPixelFormat up_unorm_of(MTLPixelFormat f)
+{
+    switch (f)
+    {
+    case MTLPixelFormatBGRA8Unorm_sRGB: return MTLPixelFormatBGRA8Unorm;
+    case MTLPixelFormatRGBA8Unorm_sRGB: return MTLPixelFormatRGBA8Unorm;
+    default: return MTLPixelFormatInvalid;
+    }
+}
+static MTLPixelFormat up_srgb_of(MTLPixelFormat f)
+{
+    switch (f)
+    {
+    case MTLPixelFormatBGRA8Unorm: return MTLPixelFormatBGRA8Unorm_sRGB;
+    case MTLPixelFormatRGBA8Unorm: return MTLPixelFormatRGBA8Unorm_sRGB;
+    default: return MTLPixelFormatInvalid;
+    }
+}
+
+struct up_scaler
+{
+    id scaler;                     /* id<MTLFXSpatialScaler> */
+    MTLPixelFormat fmt;            /* 스케일러 입력·출력 형식 */
+    int kind;                      /* UP_KIND_* */
+    NSUInteger in_w, in_h, out_w, out_h;
+    id<MTLTexture> out;            /* 전용 출력(모니터 해상도). SRGBVIEW 면 sRGB 저장 형식(표시 패스가 읽으면 선형) */
+    id<MTLTexture> out_view;       /* SRGBVIEW: out 의 unorm 보기(스케일러가 쓰는 곳) */
+    uint64_t used;
+};
+
+struct up_ctx
+{
+    void *queue;                   /* 키(참조 안 함) */
+    id<MTLDevice> device;
+    struct up_scaler s[UP_SCALERS];
+    id<MTLTexture> scratch;        /* 확대 앞 혼합용(게임 해상도) */
+    id<MTLTexture> conv;           /* MetalFX 가 못 받는 형식(sRGB)을 RGBA16F 로 바꾼 사본 */
+    void *ai;                      /* libEmberUp 문맥(EMBER_UP_AI=1) */
+    int ai_tried;
+    uint64_t used;
+};
+
+static pthread_mutex_t up_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct up_ctx up_ctxs[UP_CTXS];
+static uint64_t up_tick;
+static struct ember_up_info up_info;
+static double up_log_since;
+static unsigned long up_log_frames, up_log_created;
+
+/* 옛 스케일러·텍스처는 지금 커맨드 버퍼가 끝난 뒤 푼다 — D3DMetal 커맨드 버퍼가 참조를 안 붙잡는(unretained) 경우에도
+ * 앞서 낸 프레임이 아직 읽는 중일 수 있다. 같은 큐라 이 버퍼가 끝나면 그 앞 것도 끝났다. */
+static void up_defer_release(id<MTLCommandBuffer> cb, id a, id b)
+{
+    if (!a && !b) return;
+    if (!cb) { [a release]; [b release]; return; }
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) { [a release]; [b release]; }];
+}
+
+static void up_scaler_release(struct up_scaler *s, id<MTLCommandBuffer> cb)
+{
+    up_defer_release(cb, s->scaler, s->out);
+    up_defer_release(cb, s->out_view, nil);
+    memset(s, 0, sizeof(*s));
+}
+
+static struct up_ctx *up_ctx_for(id<MTLCommandBuffer> cb)
+{
+    void *q = (void *)cb.commandQueue;
+    struct up_ctx *c = NULL, *old = &up_ctxs[0];
+    int i;
+    for (i = 0; i < UP_CTXS; i++)
+    {
+        if (up_ctxs[i].queue == q && up_ctxs[i].device == cb.device) { c = &up_ctxs[i]; break; }
+        if (up_ctxs[i].used < old->used) old = &up_ctxs[i];
+    }
+    if (!c)
+    {
+        /* 새 큐: 가장 오래 안 쓴 문맥을 비워 쓴다 */
+        c = old;
+        for (i = 0; i < UP_SCALERS; i++) up_scaler_release(&c->s[i], nil);   /* 다른 큐 것 — 오래 안 쓴 문맥만 비운다 */
+        [c->scratch release];
+        [c->conv release];
+        if (c->ai) eup.destroy(c->ai);
+        [c->device release];
+        memset(c, 0, sizeof(*c));
+        c->queue = q;
+        c->device = [cb.device retain];
+    }
+    c->used = ++up_tick;
+    return c;
+}
+
+/* MetalFX 처리 모드: 부동소수(scRGB·EDR, 1 넘는 값) → HDR(가역 톤매핑), sRGB 저장 형식(읽으면 선형) → Linear, 그 밖(감마·PQ 부호화된 8/10비트) → Perceptual */
+static NSInteger up_mode_for(MTLPixelFormat f)
+{
+    if (@available(macOS 13.0, *))
+    {
+        switch (f)
+        {
+        case MTLPixelFormatRGBA16Float: case MTLPixelFormatRGBA32Float: case MTLPixelFormatRG11B10Float: case MTLPixelFormatRGB9E5Float:
+            return MTLFXSpatialScalerColorProcessingModeHDR;
+        case MTLPixelFormatBGRA8Unorm_sRGB: case MTLPixelFormatRGBA8Unorm_sRGB:
+            return MTLFXSpatialScalerColorProcessingModeLinear;
+        default:
+            return MTLFXSpatialScalerColorProcessingModePerceptual;
+        }
+    }
+    return 0;
+}
+
+static BOOL up_make(struct up_ctx *c, id<MTLCommandBuffer> cb, struct up_scaler *s, MTLPixelFormat fmt, int kind, NSUInteger in_w, NSUInteger in_h, NSUInteger out_w, NSUInteger out_h)
+{
+    if (@available(macOS 13.0, *))
+    {
+        MTLFXSpatialScalerDescriptor *d = [[MTLFXSpatialScalerDescriptor alloc] init];
+        MTLTextureDescriptor *td;
+        id<MTLFXSpatialScaler> sc;
+        up_scaler_release(s, cb);
+        d.colorTextureFormat = fmt;
+        d.outputTextureFormat = fmt;
+        d.inputWidth = in_w; d.inputHeight = in_h;
+        d.outputWidth = out_w; d.outputHeight = out_h;
+        d.colorProcessingMode = kind == UP_KIND_SRGBVIEW ? MTLFXSpatialScalerColorProcessingModePerceptual
+                              : kind == UP_KIND_CONV16 && up_srgb_mode() != 2 ? MTLFXSpatialScalerColorProcessingModeLinear
+                              : (MTLFXSpatialScalerColorProcessingMode)up_mode_for(fmt);
+        sc = [d newSpatialScalerWithDevice:c->device];
+        [d release];
+        if (!sc)
+        {
+            fprintf(stderr, "ember-d3dm-up: scaler failed fmt=%lu %lux%lu -> %lux%lu\n", (unsigned long)fmt,
+                    (unsigned long)in_w, (unsigned long)in_h, (unsigned long)out_w, (unsigned long)out_h);
+            s->fmt = fmt; s->kind = kind; s->in_w = in_w; s->in_h = in_h; s->out_w = out_w; s->out_h = out_h;   /* 같은 조합으로 매 프레임 다시 시도하지 않게 */
+            return NO;
+        }
+        td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:(kind == UP_KIND_SRGBVIEW ? up_srgb_of(fmt) : fmt)
+                                                              width:out_w height:out_h mipmapped:NO];
+        td.usage = sc.outputTextureUsage | MTLTextureUsageShaderRead | (kind == UP_KIND_SRGBVIEW ? MTLTextureUsagePixelFormatView : 0);
+        td.storageMode = MTLStorageModePrivate;
+        s->out = [c->device newTextureWithDescriptor:td];
+        if (s->out && kind == UP_KIND_SRGBVIEW)
+        {
+            s->out_view = [s->out newTextureViewWithPixelFormat:fmt];
+            if (!s->out_view) { [s->out release]; s->out = nil; }
+        }
+        if (!s->out)
+        {
+            [sc release];
+            s->fmt = fmt; s->kind = kind; s->in_w = in_w; s->in_h = in_h; s->out_w = out_w; s->out_h = out_h;
+            return NO;
+        }
+        s->out.label = @"ember-d3dm-upscaled";
+        s->scaler = sc;
+        s->fmt = fmt; s->kind = kind; s->in_w = in_w; s->in_h = in_h; s->out_w = out_w; s->out_h = out_h;
+        up_info.color_usage = sc.colorTextureUsage;
+        up_info.output_usage = sc.outputTextureUsage;
+        up_info.mode = (int)sc.colorProcessingMode;
+        up_info.created++;
+        up_log_created++;
+        if (ember_up_log())
+            fprintf(stderr, "ember-d3dm-up: scaler fmt=%lu kind=%d mode=%d %lux%lu -> %lux%lu (usage in=%lx out=%lx)\n", (unsigned long)fmt, kind,
+                    (int)sc.colorProcessingMode, (unsigned long)in_w, (unsigned long)in_h, (unsigned long)out_w, (unsigned long)out_h,
+                    (unsigned long)sc.colorTextureUsage, (unsigned long)sc.outputTextureUsage);
+        return YES;
+    }
+    return NO;
+}
+
+static struct up_scaler *up_find(struct up_ctx *c, id<MTLCommandBuffer> cb, MTLPixelFormat fmt, int kind, NSUInteger in_w, NSUInteger in_h,
+                                 NSUInteger out_w, NSUInteger out_h)
+{
+    struct up_scaler *old = &c->s[0];
+    int i;
+    for (i = 0; i < UP_SCALERS; i++)
+    {
+        struct up_scaler *t = &c->s[i];
+        if (t->fmt == fmt && t->kind == kind && t->in_w == in_w && t->in_h == in_h && t->out_w == out_w && t->out_h == out_h)
+        { t->used = ++up_tick; return t; }
+        if (t->used < old->used) old = t;
+    }
+    up_make(c, cb, old, fmt, kind, in_w, in_h, out_w, out_h);
+    old->used = ++up_tick;
+    return old;
+}
+
+/* MetalFX 가 못 받는 형식(실측 M4: BGRA8Unorm_sRGB 는 스케일러 생성 실패)은 RGBA16Float 사본으로 바꿔 키운다.
+ * sRGB 텍스처를 읽으면 선형 값이 나오므로 16F 에 선형으로 담고, 표시 패스가 sRGB drawable 에 쓸 때 다시 부호화된다. */
+static NSString * const up_conv_src =
+    @"#include <metal_stdlib>\n"
+     "using namespace metal;\n"
+     "struct V { float4 pos [[position]]; float2 uv; };\n"
+     "vertex V ember_up_vs(uint id [[vertex_id]]) {\n"
+     "  float2 p = float2((id << 1) & 2, id & 2);\n"
+     "  V o; o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0); o.uv = float2(p.x, 1.0 - p.y); return o; }\n"
+     "fragment float4 ember_up_fs(V in [[stage_in]], texture2d<float> t [[texture(0)]]) {\n"
+     "  constexpr sampler s(filter::nearest, address::clamp_to_edge);\n"
+     "  return t.sample(s, in.uv); }\n";
+static id<MTLRenderPipelineState> up_conv_ps;
+static id<MTLDevice> up_conv_dev;
+
+static id<MTLTexture> up_convert(struct up_ctx *c, id<MTLCommandBuffer> cb, id<MTLTexture> src)
+{
+    MTLRenderPassDescriptor *rp;
+    id<MTLRenderCommandEncoder> enc;
+    if (!up_conv_ps || up_conv_dev != c->device)
+    {
+        NSError *err = nil;
+        id<MTLLibrary> lib = [c->device newLibraryWithSource:up_conv_src options:nil error:&err];
+        MTLRenderPipelineDescriptor *d = [[MTLRenderPipelineDescriptor alloc] init];
+        d.vertexFunction = [[lib newFunctionWithName:@"ember_up_vs"] autorelease];
+        d.fragmentFunction = [[lib newFunctionWithName:@"ember_up_fs"] autorelease];
+        d.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA16Float;
+        [up_conv_ps release];
+        up_conv_ps = lib ? [c->device newRenderPipelineStateWithDescriptor:d error:&err] : nil;
+        up_conv_dev = c->device;
+        [d release];
+        [lib release];
+        if (!up_conv_ps) { fprintf(stderr, "ember-d3dm-up: convert pipeline failed: %s\n", err ? [[err description] UTF8String] : "?"); return nil; }
+    }
+    if (!c->conv || c->conv.width != src.width || c->conv.height != src.height)
+    {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float
+                                                                                       width:src.width height:src.height mipmapped:NO];
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModePrivate;
+        up_defer_release(cb, c->conv, nil);
+        c->conv = [c->device newTextureWithDescriptor:td];
+        if (!c->conv) return nil;
+    }
+    rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture = c->conv;
+    rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    enc = [cb renderCommandEncoderWithDescriptor:rp];
+    [enc setRenderPipelineState:up_conv_ps];
+    [enc setFragmentTexture:src atIndex:0];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [enc endEncoding];
+    return c->conv;
+}
+
+id<MTLTexture> ember_up_encode(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger out_w, NSUInteger out_h)
+{
+    struct up_ctx *c;
+    struct up_scaler *s;
+    id<MTLTexture> out = nil, view = nil;
+
+    if (!ember_up_enabled() || up_bilinear() || !cb || !src || src.sampleCount > 1) return nil;
+    if (out_w <= src.width || out_h <= src.height) return nil;   /* 줄이거나 같은 크기는 평범한 표시 패스로 */
+    if (!(src.usage & MTLTextureUsageShaderRead)) return nil;
+
+    pthread_mutex_lock(&up_lock);
+    c = up_ctx_for(cb);
+    s = NULL;
+    if (up_srgb_mode() == 0 && up_unorm_of(src.pixelFormat) != MTLPixelFormatInvalid)
+    {
+        /* sRGB 원본: 복사 없이 unorm 보기 → perceptual(감마 부호값 그대로, DXMT·8비트 원본과 같은 화질) */
+        view = [src newTextureViewWithPixelFormat:up_unorm_of(src.pixelFormat)];
+        if (view)
+        {
+            s = up_find(c, cb, view.pixelFormat, UP_KIND_SRGBVIEW, src.width, src.height, out_w, out_h);
+            if (!s->scaler) { [view release]; view = nil; s = NULL; }
+        }
+    }
+    if (!s) s = up_find(c, cb, src.pixelFormat, UP_KIND_NORMAL, src.width, src.height, out_w, out_h);
+    if (!s->scaler && !view && src.pixelFormat != MTLPixelFormatRGBA16Float)
+    {
+        id<MTLTexture> conv = up_convert(c, cb, src);
+        if (conv)
+        {
+            src = conv;
+            s = up_find(c, cb, MTLPixelFormatRGBA16Float, UP_KIND_CONV16, src.width, src.height, out_w, out_h);
+        }
+    }
+    if (@available(macOS 13.0, *))
+    {
+        id<MTLFXSpatialScaler> sc = s->scaler;
+        if (sc && s->out)
+        {
+            sc.colorTexture = view ? view : src;
+            sc.inputContentWidth = src.width;
+            sc.inputContentHeight = src.height;
+            sc.outputTexture = view ? s->out_view : s->out;
+            [sc encodeToCommandBuffer:cb];
+            /* 스케일러가 텍스처를 붙잡고 있지 않게 — 드로어블이 풀리는 것을 막지 않는다 */
+            sc.colorTexture = nil;
+            sc.outputTexture = nil;
+            out = s->out;
+            /* Ember AI 업스케일: 원본이 sRGB 를 바꾼 선형 16F 사본(conv)이면 lo·hi 모두 선형. 게임 자체의 부동소수 HDR 백버퍼는 건너뛴다. */
+            if (eup_available() && (src == c->conv || (src.pixelFormat != MTLPixelFormatRGBA16Float && src.pixelFormat != MTLPixelFormatRGBA32Float)))
+            {
+                uint64_t ai_out = 0;
+                if (!c->ai && !c->ai_tried) { c->ai_tried = 1; c->ai = eup.create((uint64_t)(uintptr_t)c->device); }
+                if (c->ai && eup.supported(c->ai, src.width, src.height, out.width, out.height, (view ? s->out_view : out).pixelFormat) &&
+                    eup.post(c->ai, (uint64_t)(uintptr_t)cb, (uint64_t)(uintptr_t)(view ? view : src),
+                             (uint64_t)(uintptr_t)(view ? s->out_view : out), view ? 4u : src == c->conv ? 3u : 0u, &ai_out) == 0 && ai_out)
+                    out = (id<MTLTexture>)(uintptr_t)ai_out;
+                if (ember_up_log()) eup_flush_log(c->ai);
+            }
+            up_info.encoded++;
+            up_log_frames++;
+        }
+    }
+    if (view) up_defer_release(cb, view, nil);   /* 보기는 이 커맨드 버퍼가 끝난 뒤 푼다 */
+    if (ember_up_log())
+    {
+        double now = CACurrentMediaTime();
+        if (!up_log_since) up_log_since = now;
+        if (now - up_log_since >= 5.0)
+        {
+            fprintf(stderr, "ember-d3dm-up: %.1f upscales/s, scalers created %lu, %lux%lu -> %lux%lu fmt=%lu\n",
+                    up_log_frames / (now - up_log_since), up_log_created, (unsigned long)src.width, (unsigned long)src.height,
+                    (unsigned long)out_w, (unsigned long)out_h, (unsigned long)src.pixelFormat);
+            up_log_since = now; up_log_frames = 0; up_log_created = 0;
+        }
+    }
+    pthread_mutex_unlock(&up_lock);
+    return out;
+}
+
+id<MTLTexture> ember_up_scratch(id<MTLCommandBuffer> cb, id<MTLTexture> like)
+{
+    struct up_ctx *c;
+    id<MTLTexture> t;
+    if (!cb || !like) return nil;
+    pthread_mutex_lock(&up_lock);
+    c = up_ctx_for(cb);
+    if (!c->scratch || c->scratch.width != like.width || c->scratch.height != like.height || c->scratch.pixelFormat != like.pixelFormat)
+    {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:like.pixelFormat
+                                                                                       width:like.width height:like.height mipmapped:NO];
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        td.storageMode = MTLStorageModePrivate;
+        up_defer_release(cb, c->scratch, nil);
+        c->scratch = [c->device newTextureWithDescriptor:td];
+    }
+    t = c->scratch;
+    pthread_mutex_unlock(&up_lock);
+    return t;
+}
+
+void ember_up_get_info(struct ember_up_info *info)
+{
+    pthread_mutex_lock(&up_lock);
+    *info = up_info;
+    pthread_mutex_unlock(&up_lock);
+}
diff --git a/dlls/winemac.drv/fg_ane_legacy.h b/dlls/winemac.drv/fg_ane_legacy.h
new file mode 100644
index 0000000..83a158d
--- /dev/null
+++ b/dlls/winemac.drv/fg_ane_legacy.h
@@ -0,0 +1,16 @@
+/* Legacy ANE optional-work window; does not schedule or delay an original.
+ * C compatible so the host and CPU tests use the same deadline decision. */
+#ifndef EMBER_FG_ANE_LEGACY_H
+#define EMBER_FG_ANE_LEGACY_H
+#include <stdint.h>
+static inline int64_t efal_deadline(int64_t now, int64_t interval, int64_t display) {
+    if (now <= 0 || display <= 0 || display > 100000000LL) return now;
+    if (interval < 4000000LL || interval > 50000000LL) interval = display;
+    /* At most two display slots; this is expiry, never an instruction to wait. */
+    if (interval > 2 * display) interval = 2 * display;
+    return now + interval;
+}
+static inline int efal_optional(uint64_t pair, uint64_t latest, int64_t now, int64_t deadline) {
+    return pair && pair == latest && now > 0 && now < deadline;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_ane_smooth.h b/dlls/winemac.drv/fg_ane_smooth.h
new file mode 100644
index 0000000..b9d0324
--- /dev/null
+++ b/dlls/winemac.drv/fg_ane_smooth.h
@@ -0,0 +1,54 @@
+/* Smooth-only exact-pair scheduling and HOLD control. Shared by host/CPU tests. */
+#ifndef EMBER_FG_ANE_SMOOTH_H
+#define EMBER_FG_ANE_SMOOTH_H
+#include <stdint.h>
+#include <limits.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+/* Configuration is nanoseconds: -1 is automatic, 0 is the unchanged path.
+ * Invalid/negative/nonfinite values fail closed to preserve the default. */
+static inline int64_t efas_hold_config(const char *value) {
+    if (!value || !*value) return 0;
+    if (!strcmp(value, "auto") || !strcmp(value, "자동")) return -1;
+    char *end = NULL;
+    double ms = strtod(value, &end);
+    if (end == value || *end || !isfinite(ms) || ms <= 0 ||
+        ms >= (double)INT64_MAX / 1000000.0) return 0;
+    return (int64_t)(ms * 1000000.0);
+}
+static inline int64_t efas_budget(int64_t interval, int64_t display) {
+    if (interval <= 0 || display <= 0 || display > INT64_MAX / 2) return 0;
+    return interval < 2 * display ? interval : 2 * display;
+}
+/* Bound even an explicit large hold to one source interval/two refreshes.
+ * Integer arithmetic avoids overflow for synthetic/extreme clock inputs. */
+static inline int64_t efas_hold_duration(int64_t config, int64_t interval, int64_t display) {
+    int64_t budget = efas_budget(interval, display);
+    if (!budget || !config || config < -1) return 0;
+    int64_t hold = config == -1 ? interval / 4 * 3 + interval % 4 * 3 / 4 : config;
+    return hold < budget ? hold : budget;
+}
+/* Holding is independent of ANE status and optional drawable readiness. Only
+ * a candidate owning the encoder may delay; missing-history/busy originals go. */
+static inline int efas_hold_wait(int candidate, int owns_encoder, int64_t now, int64_t deadline) {
+    return candidate && owns_encoder && now > 0 && now < deadline;
+}
+static inline int64_t efas_deadline(int64_t arrival, int64_t interval, int64_t display) {
+    int64_t budget = efas_budget(interval, display);
+    return arrival > 0 && budget > 0 && arrival <= INT64_MAX - budget ? arrival + budget : arrival;
+}
+/* Leave CPU encoding/submission slack inside the original bound. OS scheduling
+ * and actual GPU/display latency still require measurement; never clamp logs. */
+static inline int64_t efas_work_deadline(int64_t arrival, int64_t interval, int64_t display) {
+    int64_t end = efas_deadline(arrival, interval, display);
+    int64_t reserve = (end - arrival) / 4;
+    if (reserve > 2000000) reserve = 2000000;
+    return end - reserve;
+}
+/* 0: poll again; 1: exact result; -1: MC now. Deadline always wins. */
+static inline int efas_decide(int admitted, int status, int64_t now, int64_t deadline) {
+    if (!admitted || now <= 0 || now >= deadline || status < 0) return -1;
+    return status == 1 ? 1 : 0;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_ane_smooth_metal.h b/dlls/winemac.drv/fg_ane_smooth_metal.h
new file mode 100644
index 0000000..36e6790
--- /dev/null
+++ b/dlls/winemac.drv/fg_ane_smooth_metal.h
@@ -0,0 +1,336 @@
+/* Ember-owned D3DMetal transport extension. Included after the legacy adapter.
+ * Producer is never committed/waited by us. A separate queue's enqueued output
+ * preserves arrival order even when later pairs finish or time out first. */
+#include "fg_ane_smooth.h"
+#include "fg_llfi_host_pair.h"
+/* Candidate only: opt-in, exact LLFI only. Prior, serial and link retain their
+ * original transport. The main policy flags remain hard vetoes. */
+static int fg_serial_requested(void);
+static int fg_prism_requested(void) {
+    return eflp_prism_enabled(fg_prism_cfg_snapshot()&1,fg_ane_source(),
+        getenv("EMBER_FG_LLFI_PRIOR"),fg_serial_requested(),fg_link_requested());
+}
+static int fg_llfi_pair_requested(void) {
+    unsigned flags=fg_prism_cfg_snapshot();
+    return fg_prism_requested() || eflp_enabled(flags&2?"1":"0", fg_ane_source(), getenv("EMBER_FG_LLFI_PRIOR"));
+}
+static int fg_llfi_fill_requested(EmberFGLayer *p) {
+    /* Switching off never lets a new direct original overtake an already
+     * enqueued Prism original. Drain-only jobs submit no helper requests. */
+    if(!p->fge_cfg.smooth && p->legacy_ane && p->legacy_ane->prism_transport) {
+        if(fg_transport_pending(p)>0)return 1;
+        p->legacy_ane->prism_transport=NO;
+    }
+    return eflp_route(fg_llfi_pair_requested(), p->fge_cfg.smooth, fg_serial_requested(), fg_link_requested());
+}
+@interface EmberFGSmoothJob : NSObject {
+@public
+    EmberFGLayer *layer;
+    EmberFGLegacyANE *state;
+    id<MTLTexture> current, previous;
+    id<MTLCommandBuffer> output;
+    id<CAMetalDrawable> original, generated;
+    id<MTLSharedEvent> event;
+    ember_fg_ane_submit_in request;
+    double arrival, interval, display, spacing;
+    int64_t hold_ns;
+    BOOL admitted, candidate, owns_encoder, closed, acquiring, hold_only, job_only, prism;
+}
+@end
+@implementation EmberFGSmoothJob
+- (void)dealloc {
+    [layer release]; [state release]; [current release]; [previous release];
+    [output release]; [original release]; [generated release]; [event release];
+    [super dealloc];
+}
+@end
+
+/* (smoothjob-1018) EMBER_FG_SMOOTH_JOB: 뉴럴 엔진·HOLD 없이도 부드러움 보간을 이 작업(job) 표시 방식으로.
+ * 원본 화면 버퍼를 게임 스레드에서 먼저 잡아 두고(보간 버퍼는 따로 받음) 보간 프레임을 원본보다 먼저 내보낸다.
+ * 스텔라 FHD 실측: 예전 경로(게임 커맨드 버퍼 안에서 버퍼 두 장 대기) 24ms → 이 방식 17ms(같은 fps).
+ * "0" = 끔(예전), 그 밖(기본) = 켬. HOLD 와 같이 쓰면 HOLD 시간만큼 기다린 뒤 학습형/MC(설정대로)를 쓴다(hold_nn).
+ * 1 회만 읽는다(게임 도중 바뀌지 않음). */
+static int fg_smooth_job(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("EMBER_FG_SMOOTH_JOB"); v = !(e && !strcmp(e, "0")); }
+    return v;
+}
+/* 원본까지의 간격: 0 = 붙여 냄(예전 job 과 같음), 1 = 늘 엔진 박자, 2(기본) = 박자가 화면 2칸 이상일 때만(240Hz 등) */
+static int fg_smooth_job_space(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("EMBER_FG_SMOOTH_JOB_SPACE"); v = e && *e ? atoi(e) : 2; }
+    return v;
+}
+/* HOLD 때도 엔진 설정(학습형)을 쓸지: "1" = 학습형 허용, 그 밖(기본) = 예전처럼 MC 고정 */
+static int fg_smooth_hold_nn(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("EMBER_FG_SMOOTH_HOLD_NN"); v = e && !strcmp(e, "1"); }
+    return v;
+}
+static void fg_smooth_poll(EmberFGSmoothJob *j) {
+    @autoreleasepool {
+    EmberFGLayer *p = j->layer;
+    EmberFGLegacyANE *s = j->state;
+    int status = j->admitted ? fge.ane_status(s->encoder, j->request.pair_id) : -1;
+    int64_t now = fge_ns(CACurrentMediaTime());
+    BOOL drawable_ready, acquiring;
+    @synchronized(j) { drawable_ready = j->generated != nil; acquiring = j->acquiring; }
+    /* Missing helper still gets the existing MC path as soon as its optional
+     * drawable arrives; acquisition can never extend the decision deadline. */
+    BOOL wait_drawable = !drawable_ready && acquiring;
+    int decision = j->hold_only ?
+        (efas_hold_wait(j->candidate, j->owns_encoder, now, j->request.deadline_ns) ? 0 : -1) :
+        efas_decide((drawable_ready || acquiring) && (j->admitted || wait_drawable),
+                    wait_drawable ? 0 : status, now, j->request.deadline_ns);
+    if (!decision) {
+        int64_t delay = j->request.deadline_ns - now;
+        if (delay > 250000) delay = 250000;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delay), p->dq, ^{ fg_smooth_poll(j); });
+        return;
+    }
+    /* Close the optional acquisition before consuming it; a tardy drawable is
+     * released by its worker and can never resurrect an already emitted pair. */
+    @synchronized(j) { j->closed = YES; }
+    BOOL encoded = NO, used = NO;
+    if (j->generated && j->owns_encoder) {
+        struct fge_encode_in in = {0}; struct fge_encode_out out = {0};
+        in.size = sizeof(in); out.size = sizeof(out);
+        in.command_buffer = (uint64_t)(uintptr_t)j->output;
+        in.current = j->request.current; in.previous = j->request.previous;
+        /* Keep the exact-pair token for HOLD too: it selects smooth MC fallback
+         * even if EMBER_FG_NN is inherited. ANE=0 creates no ANE service, so this
+         * token cannot submit or retrieve ANE work. */
+        /* (smoothjob-1018) job_only: 뉴럴 엔진 쌍 표식 없이 = 엔진 설정(학습형 NN=3 등)대로 */
+        in.ane_pair_id = (j->job_only || (j->hold_only && fg_smooth_hold_nn())) ? 0 : j->request.pair_id; in.alpha = 0.5f;
+        id<MTLTexture> mc = nil;
+        if (fge.encode(s->encoder, &in, &out) && out.ok) mc = (id<MTLTexture>)(uintptr_t)out.texture;
+        used = !j->hold_only && !j->job_only && mc && fge.ane_status(s->encoder, j->request.pair_id) == 2;
+        encoded = fg_draw(j->output, mc ? mc : j->current, mc ? mc : j->previous,
+                          mc ? 0 : 0.5f, j->generated.texture);
+        if (encoded) {
+            fg_stage(p, FGS_ENCODE_G); fg_submit(p, j->output, j->generated, 0, 0);
+            __sync_fetch_and_add(&p->count_out, 1); __sync_fetch_and_add(&p->gen_total, 1);
+        }
+    }
+    /* The original was reserved and encoded before ANE submission. Timeout or
+     * missing result never drops it, and adds no further cadence delay. */
+    fg_stage(p, FGS_ENCODE_O); fg_observe_gpu(p, j->output, YES);
+    double space = used && encoded ? j->spacing : 0;
+    if (j->job_only && encoded) {
+        int mode = fg_smooth_job_space();
+        if (mode == 1 || (mode == 2 && j->spacing > 1.5 * j->display)) space = j->spacing;
+    }
+    fg_submit(p, j->output, j->original, space, j->arrival);
+    __sync_fetch_and_add(&p->count_out, 1);
+    [j->output addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        if (j->owns_encoder) __sync_lock_test_and_set(&s->smooth_busy, 0);
+        pthread_mutex_lock(&fg_stat_lock);
+        if (!--p->outstanding) p->transport_start = 0;
+        pthread_mutex_unlock(&fg_stat_lock);
+        if (done.status != MTLCommandBufferStatusCompleted)
+            fprintf(stderr, "ember-fg-ane-smooth: command-buffer-error pair=%llu\n", (unsigned long long)j->request.pair_id);
+        /* j keeps snapshots, event, encoder and output resources alive. */
+    }];
+    [j->output commit];
+    const double added = fmax(0, CACurrentMediaTime() - j->arrival);
+    @synchronized(s) {
+        if(j->prism) {
+            s->prism_used+=used && encoded;
+            if(j->candidate && j->owns_encoder) {
+                ++s->prism_samples; s->prism_sum+=added; s->prism_max=fmax(s->prism_max,added);
+            }
+        }
+        if (j->candidate) {
+            ++s->smooth_pairs;
+            s->smooth_used += used && encoded;
+            s->smooth_late += j->admitted && now >= j->request.deadline_ns;
+        }
+        if (j->hold_only && j->candidate && j->owns_encoder) {
+            ++s->smooth_hold_samples;
+            s->smooth_hold_sum += j->hold_ns / 1e9;
+        }
+        if (j->interval > 0) {
+            ++s->smooth_samples;
+            s->smooth_over += added > j->interval;
+            s->smooth_sum += added; s->smooth_max = fmax(s->smooth_max, added);
+        }
+    }
+    }
+}
+static void fg_smooth_report(EmberFGLayer *p, double disp) {
+    EmberFGLegacyANE *s = p->legacy_ane;
+    if (!s || (!p->fge_cfg.smooth && !fg_llfi_fill_requested(p))) return;
+    @synchronized(s) {
+        fprintf(stderr, "ember-fg-ane-smooth: layer=%p mode=%s experiment=%s hold_policy=%s hold_config_ms=%.3f "
+            "hold_pairs=%llu hold_target_ms=%.3f ane_used=%llu ane_late=%llu pairs=%llu "
+            "latency_samples=%llu added_latency_ms=%.3f added_latency_max_ms=%.3f latency_over_budget=%llu source_interval_ms=%.3f budget_ms=%.3f\n",
+            (void *)p, p->fge_cfg.smooth ? "smooth" : "fill-exact", s->smooth_hold_only ? "hold-only" : (fg_ane_source() ? fg_ane_source() : (fg_smooth_job() ? "job" : "ane")),
+            !s->smooth_hold_only ? "off" : (s->smooth_hold_config == -1 ? "auto" : "fixed"),
+            s->smooth_hold_config == -1 ? -1.0 : s->smooth_hold_config / 1e6,
+            (unsigned long long)s->smooth_hold_samples,
+            s->smooth_hold_samples ? s->smooth_hold_sum * 1000 / s->smooth_hold_samples : 0,
+            (unsigned long long)s->smooth_used, (unsigned long long)s->smooth_late,
+            (unsigned long long)s->smooth_pairs, (unsigned long long)s->smooth_samples,
+            s->smooth_samples ? s->smooth_sum*1000/s->smooth_samples : 0,
+            s->smooth_max*1000, (unsigned long long)s->smooth_over, s->smooth_interval*1000,
+            (p->fge_cfg.smooth ? efas_budget(fge_ns(s->smooth_interval), fge_ns(disp)) :
+                eflp_deadline(1, 1, fge_ns(s->smooth_interval), fge_ns(disp)) - 1)/1e6);
+        if (fg_llfi_pair_requested()) {
+            fprintf(stderr, "ember-fg-llfi-host-pair: history=%llu policy=%llu busy=%llu submit_calls=%llu admitted=%llu rejected=%llu layer=%p\n",
+                (unsigned long long)s->pair_reason[0], (unsigned long long)s->pair_reason[1],
+                (unsigned long long)s->pair_reason[2], (unsigned long long)s->pair_reason[3],
+                (unsigned long long)s->pair_admitted, (unsigned long long)s->pair_rejected, (void *)p);
+            memset(s->pair_reason, 0, sizeof(s->pair_reason)); s->pair_admitted=s->pair_rejected=0;
+        }
+        if(s->prism_samples || s->prism_submitted || fg_prism_requested()) {
+            fprintf(stderr,"ember-fg-prism: budget_ms=%.3f extra_wait_cap_ms=%.3f added_latency_ms=%.3f added_latency_max_ms=%.3f used=%llu submitted=%llu latency_kind=arrival-to-output-commit display_latency=unmeasured layer=%p\n",
+                s->prism_budget*1000,s->prism_extra_cap*1000,
+                s->prism_samples?s->prism_sum*1000/s->prism_samples:0,s->prism_max*1000,
+                (unsigned long long)s->prism_used,(unsigned long long)s->prism_submitted,(void*)p);
+            s->prism_submitted=s->prism_used=s->prism_samples=0; s->prism_sum=s->prism_max=0;
+        }
+        s->smooth_pairs=s->smooth_used=s->smooth_late=s->smooth_over=s->smooth_samples=0;
+        s->smooth_sum=s->smooth_max=0;
+        s->smooth_hold_samples=0; s->smooth_hold_sum=0;
+    }
+}
+static BOOL fg_smooth_ane(EmberFGLayer *p, id<MTLCommandBuffer> cb, id<MTLTexture> cur,
+                           double now, double disp, const struct fge_frame_plan *plan) {
+    @autoreleasepool {
+    const BOOL fill_exact = fg_llfi_fill_requested(p);
+    const BOOL prism = fg_prism_requested();
+    const BOOL drain_only=fill_exact && !prism && !fg_llfi_pair_requested();
+    const char *requested = getenv("EMBER_FG_ANE");
+    const BOOL flowq_requested = requested && !strcmp(requested,"flowq");
+    const BOOL ane_requested = fg_ane_source() != NULL; /* 1|flowq|llfi */
+    // FlowQ has fixed native model buckets; unsupported sizes use ordinary MC.
+    if (flowq_requested && !((cur.width == 1920 && cur.height == 1080) ||
+        (cur.width == 2560 && cur.height == 1440) || (cur.width == 1280 && cur.height == 720))) return NO;
+    /* ANE wins if both switches are set; HOLD never silently adds to its wait. */
+    const int64_t hold_config = efas_hold_config(getenv("EMBER_FG_SMOOTH_HOLD_MS"));
+    const BOOL hold_only = !ane_requested && hold_config != 0;
+    const BOOL job_only = !ane_requested && !hold_only && fg_smooth_job();
+    if ((!ane_requested && !hold_only && !job_only) || (!p->fge_cfg.smooth && !fill_exact) || (!fill_exact && p->fge_cfg.game_cap_fps > 0) ||
+        (ane_requested && (!fge.ane_submit || !fge.ane_status)) || !p->fge_cfg.mc_enabled ||
+        p->neural || p->ahdr || ember_up_enabled() || !p->real.allowsNextDrawableTimeout ||
+        cb.status >= MTLCommandBufferStatusCommitted || cur.device != cb.device ||
+        cur.textureType != MTLTextureType2D || cur.sampleCount != 1) return NO;
+    /* (smoothjob-1018 v2) 작업 방식인데 이번 프레임은 보간도 이전 프레임 보관도 없음(GAME FAST·쉼) →
+     * 앞선 작업이 다 끝났으면 예전 통과 경로(게임 커맨드 버퍼에 바로)가 더 빠르다(레퀴엠 FHD 17.2→15.9ms). 순서 지키려고 남은 작업이 있으면 작업 경로. */
+    if (job_only && !(plan->flags & (FGE_PLAN_GENERATE | FGE_PLAN_KEEP_PREVIOUS)) && fg_transport_pending(p) == 0) return NO;
+    if (!p->hq) p->hq = [cb.device newCommandQueue];
+    if (!p->dq) p->dq = dispatch_queue_create("ember.framegen.smooth", DISPATCH_QUEUE_SERIAL);
+    /* No cross-queue cycle: only the producer signals; output queue never feeds it. */
+    if (!p->hq || !p->dq || p->hq == cb.commandQueue || p->hq.device != cb.device) return NO;
+    EmberFGLegacyANE *s = p->legacy_ane;
+    if (!s || s->device != cb.device) {
+        [s release]; p->legacy_ane = s = [[EmberFGLegacyANE alloc] initWithDevice:cb.device];
+    }
+    if (!s->encoder) return NO;
+    if(prism && fill_exact)s->prism_transport=YES;
+    const double interval = s->arrival > 0 ? now - s->arrival : 0;
+    BOOL pair = fg_legacy_ane_previous(p) && s->previous.width == cur.width &&
+        s->previous.height == cur.height && s->previous.pixelFormat == cur.pixelFormat &&
+        s->producer != cb && s->producer.commandQueue == cb.commandQueue &&
+        s->producer.status >= MTLCommandBufferStatusCommitted;
+    s->arrival = now;
+    @synchronized(s) {
+        s->smooth_interval = interval;
+        s->smooth_hold_only = hold_only;
+        s->smooth_hold_config = hold_only ? hold_config : 0;
+    }
+    EmberFGSmoothJob *j = [[[EmberFGSmoothJob alloc] init] autorelease];
+    j->layer = [p retain]; j->state = [s retain]; j->previous = [s->previous retain];
+    j->arrival=now; j->interval=interval; j->display=disp;
+    j->hold_only=hold_only; j->job_only=job_only;
+    j->prism=prism;
+    j->hold_ns=hold_only ? efas_hold_duration(hold_config, fge_ns(interval), fge_ns(disp)) : 0;
+    j->spacing=fmax(1, floor(plan->defer/disp+0.05))*disp-0.1*disp;
+    j->candidate = !drain_only && pair && (plan->flags & FGE_PLAN_GENERATE) && (plan->flags & FGE_PLAN_MC);
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:cur.pixelFormat
+        width:cur.width height:cur.height mipmapped:NO];
+    td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget; td.storageMode = MTLStorageModePrivate;
+    j->current = [cb.device newTextureWithDescriptor:td];
+    j->original = [fg_next(p) retain];
+    j->output = [[p->hq commandBuffer] retain]; j->event = [cb.device newSharedEvent];
+    if (!j->current || !j->original || !j->output || !j->event || j->original.texture.device != cb.device) return NO;
+    const uint64_t value = 1;
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> producer) {
+        if (producer.status == MTLCommandBufferStatusError) {
+            /* A failed producer may never execute its encoded signal. Release
+             * the output queue on the CPU; no later original is held forever. */
+            j->event.signaledValue = value;
+            fprintf(stderr, "ember-fg-ane-smooth: producer-error pair=%llu\n",
+                (unsigned long long)j->request.pair_id);
+        }
+    }];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    if (!blit) return NO;
+    [blit copyFromTexture:cur toTexture:j->current]; [blit endEncoding];
+    [j->output encodeWaitForEvent:j->event value:value];
+    if (!fg_draw(j->output, j->current, j->current, 0, j->original.texture)) return NO;
+    j->request.size = sizeof(j->request); j->request.command_buffer=(uint64_t)(uintptr_t)cb;
+    j->request.current=(uint64_t)(uintptr_t)j->current; j->request.previous=(uint64_t)(uintptr_t)j->previous;
+    j->request.pair_id=p->frame_no;
+    j->request.source_time_ns=fge_ns(now); j->request.interval_ns=fge_ns(interval);
+    j->request.deadline_ns=eflp_prism_deadline(prism,fill_exact, fge_ns(now), fge_ns(interval), fge_ns(disp));
+    if(prism) {
+        j->request.reserved=EFLP_PRISM_MARKER;
+        @synchronized(s) {
+            s->prism_budget=(j->request.deadline_ns-fge_ns(now))/1e9;
+            s->prism_extra_cap=fmax(0,(j->request.deadline_ns-eflp_deadline(fill_exact,fge_ns(now),fge_ns(interval),fge_ns(disp)))/1e9);
+        }
+    }
+    if (hold_only) j->request.deadline_ns=efas_deadline(fge_ns(now), j->hold_ns, fge_ns(disp));
+    /* reuse_previous stays zero even if the rejected experiment is enabled. */
+    if (j->candidate && __sync_bool_compare_and_swap(&s->smooth_busy, 0, 1)) {
+        j->owns_encoder = YES;
+        struct fge_frame_in input={0}; struct fge_frame_plan ignored={0};
+        input.size=sizeof(input); input.flags=FGE_IN_FRAMEGEN|FGE_IN_PREV_VALID;
+        input.now_ns=fge_ns(now); input.frame_no=p->frame_no; input.display_interval=disp;
+        ignored.size=sizeof(ignored); fg_feedback(p,now,&input);
+        fge.begin_frame(s->encoder,&input,&ignored);
+        if (!hold_only && !job_only) j->admitted=fg_ane_submit(p,s->encoder,&j->request);
+        if(prism) { @synchronized(s) { s->prism_submitted+=j->admitted; } }
+        /* HOLD uses the identical snapshot/output queue and MC fallback, but
+         * no ANE capture/submit/status work. Deferring commit lets the producer
+         * GPU queue advance before MC competes for GPU time and shifts display
+         * phase; neither mechanism nor the FPS gain is proven without A/B. */
+        /* nextDrawable has no nonblocking variant. Only this independent,
+         * one-slot worker may acquire OPTIONAL output. Its timeout never holds
+         * the producer, decision queue, or reserved original. */
+        if (p->real.maximumDrawableCount >= 3 &&
+            __sync_bool_compare_and_swap(&s->smooth_drawable_busy, 0, 1)) {
+            j->acquiring = YES;
+            CAMetalLayer *real = p->real;
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{ @autoreleasepool {
+                id<CAMetalDrawable> d = [real nextDrawable];
+                @synchronized(j) {
+                    j->acquiring = NO;
+                    if (!j->closed && d.texture.device == s->device &&
+                        fge_ns(CACurrentMediaTime()) < j->request.deadline_ns)
+                        j->generated = [d retain];
+                }
+                __sync_lock_test_and_set(&s->smooth_drawable_busy, 0);
+            }});
+        }
+    }
+    if (fg_llfi_pair_requested()) {
+        @synchronized(s) {
+            ++s->pair_reason[eflp_reason(pair, plan->flags & FGE_PLAN_GENERATE, plan->flags & FGE_PLAN_MC, j->owns_encoder)];
+            if (j->owns_encoder) { s->pair_admitted += j->admitted; s->pair_rejected += !j->admitted; }
+        }
+    }
+    [cb encodeSignalEvent:j->event value:value];
+    [s->previous release]; s->previous=[j->current retain]; s->snapshot_sequence=p->frame_no;
+    [s->producer release]; s->producer=[cb retain]; p->have_prev=NO; p->ring_prev=NO;
+    pthread_mutex_lock(&fg_stat_lock);
+    if (!p->outstanding) p->transport_start=now;
+    ++p->outstanding; pthread_mutex_unlock(&fg_stat_lock);
+    /* All originals, including busy/missing-history cases, reserve queue order
+     * before dispatch. Only one job may use the context-owned synth target. */
+    [j->output enqueue];
+    dispatch_async(p->dq, ^{ fg_smooth_poll(j); });
+    return YES;
+    }
+}
diff --git a/dlls/winemac.drv/fg_display_link_format.h b/dlls/winemac.drv/fg_display_link_format.h
new file mode 100644
index 0000000..0e6728c
--- /dev/null
+++ b/dlls/winemac.drv/fg_display_link_format.h
@@ -0,0 +1,65 @@
+#ifndef EMBER_FG_DISPLAY_LINK_FORMAT_H
+#define EMBER_FG_DISPLAY_LINK_FORMAT_H
+#include <stdint.h>
+
+/* Metal enum values kept CPU-testable in C and C++. */
+enum {
+    EMBER_DL_BGRA8 = 80, EMBER_DL_BGRA8_SRGB = 81,
+    EMBER_DL_RGB10A2 = 90, EMBER_DL_BGR10A2 = 94, EMBER_DL_RGBA16F = 115
+};
+
+static inline int ember_fg_dl_format_sdr(uint64_t format, int edr, int extended,
+                                        int itu2100, int named_srgb)
+{
+    /* Historical name: eligibility now means bounded UNORM, not SDR metadata.
+     * The same CAMetalLayer retains its EDR/colorspace; copy/blend values as-is
+     * and write its original format, with no added colorspace conversion.
+     * Extended-range spaces remain unsupported even with a UNORM texture. */
+    (void)edr;
+    (void)itu2100;
+    (void)named_srgb;
+    if (extended) return 0;
+    return format == EMBER_DL_BGRA8 || format == EMBER_DL_BGRA8_SRGB ||
+        format == EMBER_DL_RGB10A2 || format == EMBER_DL_BGR10A2;
+}
+
+static inline uint32_t ember_fg_dl_format_bytes(uint64_t format)
+{
+    switch (format) {
+        case EMBER_DL_BGRA8: case EMBER_DL_BGRA8_SRGB:
+        case EMBER_DL_RGB10A2: case EMBER_DL_BGR10A2: return 4;
+        case EMBER_DL_RGBA16F: return 8;
+        default: return 0;
+    }
+}
+
+/* Match MC's output selection. RGBA16F round-trips every 10-bit UNORM code;
+ * the final render pass writes the original layer format, never BGRA8. */
+static inline uint64_t ember_fg_dl_candidate_format(uint64_t source, int output8)
+{
+    return output8 && source == EMBER_DL_BGRA8 ? source : EMBER_DL_RGBA16F;
+}
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#import <CoreGraphics/CoreGraphics.h>
+_Static_assert(MTLPixelFormatBGRA8Unorm == EMBER_DL_BGRA8 &&
+    MTLPixelFormatBGRA8Unorm_sRGB == EMBER_DL_BGRA8_SRGB &&
+    MTLPixelFormatRGB10A2Unorm == EMBER_DL_RGB10A2 &&
+    MTLPixelFormatBGR10A2Unorm == EMBER_DL_BGR10A2 &&
+    MTLPixelFormatRGBA16Float == EMBER_DL_RGBA16F, "Metal format values changed");
+
+static inline int ember_fg_dl_layer_sdr(MTLPixelFormat format, int edr, CGColorSpaceRef cs)
+{
+    int extended = 0, itu2100 = 0;
+    if (@available(macOS 11.0, *)) {
+        extended = cs && CGColorSpaceUsesExtendedRange(cs);
+        itu2100 = cs && CGColorSpaceUsesITUR_2100TF(cs);
+    }
+    CFStringRef name = cs ? CGColorSpaceCopyName(cs) : NULL;
+    const int srgb = name && CFEqual(name, kCGColorSpaceSRGB);
+    if (name) CFRelease(name);
+    return ember_fg_dl_format_sdr(format, edr, extended, itu2100, srgb);
+}
+#endif
+#endif
diff --git a/dlls/winemac.drv/fg_display_link_geometry.h b/dlls/winemac.drv/fg_display_link_geometry.h
new file mode 100644
index 0000000..1a2d1d6
--- /dev/null
+++ b/dlls/winemac.drv/fg_display_link_geometry.h
@@ -0,0 +1,69 @@
+#ifndef EMBER_FG_DISPLAY_LINK_GEOMETRY_H
+#define EMBER_FG_DISPLAY_LINK_GEOMETRY_H
+
+/* CPU-only surface eligibility shared by the host adapter and presenter. */
+#include <math.h>
+#include <stdint.h>
+#include "fg_display_link_format.h"
+
+typedef struct ember_fg_dl_rect {
+    double x, y, width, height;
+} ember_fg_dl_rect;
+
+static inline int ember_fg_dl_rect_valid(ember_fg_dl_rect rect)
+{
+    return isfinite(rect.x) && isfinite(rect.y) &&
+           isfinite(rect.width) && isfinite(rect.height) &&
+           rect.width > 0.0 && rect.height > 0.0 &&
+           isfinite(rect.x + rect.width) && isfinite(rect.y + rect.height);
+}
+
+/* AppKit screen/window frames are in points, including negative screen origins.
+ * A larger window may cover the screen; allow at most half a point at an edge. */
+static inline int ember_fg_dl_covers_screen(int native_fullscreen,
+                                          ember_fg_dl_rect window,
+                                          ember_fg_dl_rect screen)
+{
+    const double tolerance = 0.5;
+    if (!ember_fg_dl_rect_valid(window) || !ember_fg_dl_rect_valid(screen)) return 0;
+    return native_fullscreen ||
+           (window.x <= screen.x + tolerance &&
+            window.y <= screen.y + tolerance &&
+            window.x + window.width >= screen.x + screen.width - tolerance &&
+            window.y + window.height >= screen.y + screen.height - tolerance);
+}
+
+/* Conservative source-sized envelope: 12 admitted lease textures at the larger
+ * of source/candidate formats, 2 retained source-pair snapshots, and the existing
+ * 14 RGBA16F-equivalent engine scratch allowance. Drawable storage is separate.
+ * Saturation/unknown formats fail closed rather than wrap under the cap. */
+static inline uint64_t ember_fg_dl_source_bytes(uint32_t width, uint32_t height,
+                                                 uint64_t source_format, int output8)
+{
+    const uint64_t pixels = (uint64_t)width * height;
+    const uint64_t source = ember_fg_dl_format_bytes(source_format);
+    if (!source) return UINT64_MAX;
+    const uint64_t candidate = ember_fg_dl_format_bytes(ember_fg_dl_candidate_format(source_format, output8));
+    const uint64_t bytes_per_pixel = 12 * (source > candidate ? source : candidate) + 2 * source + 14 * 8;
+    return pixels > UINT64_MAX / bytes_per_pixel ? UINT64_MAX : pixels * bytes_per_pixel;
+}
+
+static inline int ember_fg_dl_source_fits(uint32_t width, uint32_t height,
+                                            uint64_t source_format, int output8)
+{
+    return width && height &&
+           ember_fg_dl_source_bytes(width, height, source_format, output8) <= UINT64_C(768) * 1024 * 1024;
+}
+
+/* Final-pass linear sampling supports a drawable larger than the source.
+ * The drawable belongs to CAMetalLayer, outside the source texture pool cap. */
+static inline int ember_fg_dl_output_extent_valid(uint32_t source_width,
+                                                 uint32_t source_height,
+                                                 uint32_t output_width,
+                                                 uint32_t output_height,
+                                                 uint64_t source_format, int output8)
+{
+    return output_width && output_height && ember_fg_dl_source_fits(source_width, source_height, source_format, output8);
+}
+
+#endif
diff --git a/dlls/winemac.drv/fg_display_link_metadata.h b/dlls/winemac.drv/fg_display_link_metadata.h
new file mode 100644
index 0000000..570eced
--- /dev/null
+++ b/dlls/winemac.drv/fg_display_link_metadata.h
@@ -0,0 +1,20 @@
+/* CPU-only metadata identity. Caller retains the observed colorspace so an
+ * address cannot be recycled before the next observation. */
+#ifndef EMBER_FG_DISPLAY_LINK_METADATA_H
+#define EMBER_FG_DISPLAY_LINK_METADATA_H
+#include <stdint.h>
+typedef struct ember_fg_dl_metadata {
+    uintptr_t color;
+    int edr, known;
+} ember_fg_dl_metadata;
+static inline int ember_fg_dl_metadata_matches(const ember_fg_dl_metadata *m, uintptr_t color, int edr)
+{
+    return m->known && m->color == color && m->edr == !!edr;
+}
+static inline int ember_fg_dl_metadata_observe(ember_fg_dl_metadata *m, uintptr_t color, int edr)
+{
+    const int changed = m->known && !ember_fg_dl_metadata_matches(m, color, edr);
+    m->color = color; m->edr = !!edr; m->known = 1;
+    return changed;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_hdr_policy.h b/dlls/winemac.drv/fg_hdr_policy.h
new file mode 100644
index 0000000..90cec72
--- /dev/null
+++ b/dlls/winemac.drv/fg_hdr_policy.h
@@ -0,0 +1,41 @@
+/* D3DMetal host admission policy only; no image processing in the Wine glue. */
+#ifndef EMBER_FG_HDR_POLICY_H
+#define EMBER_FG_HDR_POLICY_H
+#ifndef EMBER_FG_HDR_GUARD
+#define EMBER_FG_HDR_GUARD 1
+#endif
+#if EMBER_FG_HDR_GUARD
+#include <string.h>
+#include <CoreGraphics/CoreGraphics.h>
+enum { FG_HDR_AUTO, FG_HDR_OFF, FG_HDR_ON };
+enum { FG_HDR_TF = 1, FG_HDR_EXTENDED = 2, FG_HDR_EDR = 4, FG_HDR_FORCED = 8 };
+/* OFF restores the entire legacy path. ON forces original-only even if the
+ * producer has not supplied HDR metadata. Unknown values fail safe to AUTO. */
+static int fg_hdr_parse_policy(const char *v)
+{
+    if (v && (!strcmp(v, "off") || !strcmp(v, "0"))) return FG_HDR_OFF;
+    if (v && (!strcmp(v, "on") || !strcmp(v, "1"))) return FG_HDR_ON;
+    return FG_HDR_AUTO;
+}
+static unsigned fg_hdr_color_reason(CGColorSpaceRef cs, int edr)
+{
+    unsigned reason = edr ? FG_HDR_EDR : 0;
+    if (cs) {
+        if (@available(macOS 11.0, *)) {
+            if (CGColorSpaceUsesITUR_2100TF(cs)) reason |= FG_HDR_TF;
+            if (CGColorSpaceUsesExtendedRange(cs)) reason |= FG_HDR_EXTENDED;
+        }
+    }
+    return reason;
+}
+static unsigned fg_hdr_block_reason(int policy, unsigned proxy, unsigned real,
+                                    int own_autohdr, int real_changed)
+{
+    if (policy == FG_HDR_OFF) return 0;
+    if (policy == FG_HDR_ON) return FG_HDR_FORCED;
+    /* Our SDR AutoHDR target is extended-linear, but its INPUT is still SDR.
+     * A direct D3DMetal change on that target is authoritative again. */
+    return proxy | ((!own_autohdr || real_changed) ? real : 0);
+}
+#endif
+#endif
diff --git a/dlls/winemac.drv/fg_llfi_color.h b/dlls/winemac.drv/fg_llfi_color.h
new file mode 100644
index 0000000..652717b
--- /dev/null
+++ b/dlls/winemac.drv/fg_llfi_color.h
@@ -0,0 +1,20 @@
+/* LLFI quantizes bounded UNORM code values to 8-bit 420v. PQ and HLG stay
+ * encoded throughout that round trip; do not apply a linear-light conversion.
+ * EDR on a layer alone does not imply extended samples. */
+#ifndef EMBER_FG_LLFI_COLOR_H
+#define EMBER_FG_LLFI_COLOR_H
+#include <CoreGraphics/CoreGraphics.h>
+/* Keep HDR_TF and its host counter for diagnostic compatibility. Bounded
+ * PQ/HLG no longer sets it; extended spaces still set EXTENDED. */
+enum { FG_LLFI_COLOR_EXTENDED = 1, FG_LLFI_COLOR_HDR_TF = 2 };
+static unsigned fg_llfi_color_rejection(CGColorSpaceRef colorspace)
+{
+    unsigned reason = 0;
+    if (colorspace) {
+        if (@available(macOS 11.0, *)) {
+            if (CGColorSpaceUsesExtendedRange(colorspace)) reason |= FG_LLFI_COLOR_EXTENDED;
+        }
+    }
+    return reason;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_llfi_host_pair.h b/dlls/winemac.drv/fg_llfi_host_pair.h
new file mode 100644
index 0000000..9b06db8
--- /dev/null
+++ b/dlls/winemac.drv/fg_llfi_host_pair.h
@@ -0,0 +1,47 @@
+/* Thin host routing contract; CPU-only, shared with regression tests. */
+#ifndef EMBER_FG_LLFI_HOST_PAIR_H
+#define EMBER_FG_LLFI_HOST_PAIR_H
+#include "fg_ane_smooth.h"
+static inline int eflp_enabled(const char *value, const char *source, const char *prior) {
+    return value && !strcmp(value, "1") && source && !strcmp(source, "llfi") &&
+           !(prior && !strcmp(prior, "1"));
+}
+static inline int eflp_route(int enabled, int smooth, int serial, int link) {
+    return enabled && !smooth && !serial && !link;
+}
+/* Fill borrows at most one display slot, including CPU submission reserve.
+ * Smooth keeps its established two-slot/source-interval bound. */
+static inline int64_t eflp_deadline(int fill, int64_t arrival, int64_t interval, int64_t display) {
+    if (!fill) return efas_work_deadline(arrival, interval, display);
+    if (interval <= 0 || display <= 0) return arrival;
+    return efas_work_deadline(arrival, interval < display ? interval : display, display);
+}
+/* Prism adds no more than one measured original interval to the existing
+ * decision budget, and never exceeds original+display (including reserve).
+ * This bounds CPU decision wait; GPU/OS/display latency is measured separately. */
+#define EFLP_PRISM_MARKER 0x50524953u
+static inline int eflp_prism_enabled(int prism, const char *source, const char *prior,
+                                  int serial, int link) {
+    return prism && eflp_enabled("1",source,prior) && !serial && !link;
+}
+static inline int64_t eflp_prism_deadline(int prism, int fill, int64_t arrival,
+                                        int64_t interval, int64_t display) {
+    const int64_t baseline=eflp_deadline(fill,arrival,interval,display);
+    if(!prism) return baseline;
+    if(arrival<=0 || interval<=0 || display<=0 || interval>INT64_MAX-display) return arrival;
+    int64_t total=interval+display, reserve=total/4;
+    if(reserve>2000000)reserve=2000000;
+    total-=reserve;
+    if(arrival>INT64_MAX-total || baseline<arrival) return arrival;
+    int64_t base=baseline-arrival;
+    int64_t extra=total>base?total-base:0;
+    if(extra>interval)extra=interval;
+    return base>INT64_MAX-arrival-extra?arrival:baseline+extra;
+}
+enum { EFLP_HISTORY=0, EFLP_POLICY=1, EFLP_BUSY=2, EFLP_SUBMIT=3 };
+static inline unsigned eflp_reason(int pair, int generate, int mc, int owns) {
+    if (!pair) return EFLP_HISTORY;
+    if (!generate || !mc) return EFLP_POLICY;
+    return owns ? EFLP_SUBMIT : EFLP_BUSY;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_presenter.h b/dlls/winemac.drv/fg_presenter.h
new file mode 100644
index 0000000..787ecba
--- /dev/null
+++ b/dlls/winemac.drv/fg_presenter.h
@@ -0,0 +1,149 @@
+/* Ember serial presenter admission/ownership. Pure C so CPU tests exercise the
+ * exact transitions used by the Metal adapter. All calls require the host lock.
+ * Observations do NOT prove future producer behaviour; see RUN.md exception. */
+#ifndef EMBER_FG_PRESENTER_H
+#define EMBER_FG_PRESENTER_H
+#include <stdint.h>
+#include <string.h>
+#define EFP_SLOTS 8
+#define EFP_WARMUP_NS 2000000000LL
+#define EFP_WARMUP_COUNT 120
+#define EFP_DRAWABLE_BUCKETS 50
+#define EFP_DRAWABLE_BUCKET_NS 100000000LL
+#define EFP_DRAWABLE_MIN_SAMPLES 30
+/* These proofs are conditional on the admitted same-queue producer contract. */
+enum { EFP_PROOFS = 7 };
+enum { EFP_QUEUE, EFP_PRECOMMIT, EFP_DEPTH, EFP_SLOT, EFP_DRAWABLE,
+       EFP_EPOCH, EFP_RESOURCE, EFP_REASON_COUNT };
+/* A resize, transient nil drawable, or admission fault is NOT a terminal
+ * lifecycle. Only the host's explicit loss of the display permits cancellation. */
+enum { EFP_ACTIVE = 0, EFP_TERMINATED, EFP_DEVICE_REPLACED, EFP_SURFACE_LOST };
+typedef struct ember_fg_presenter {
+    uint64_t epoch, sequence, submitted, queue, producer;
+    int64_t since, last;
+    unsigned clean, enabled, stopped, violations, pending, inflight, lifecycle;
+    unsigned refs[EFP_SLOTS];
+    uint64_t bypass[EFP_REASON_COUNT], risk_window, accepted, completed, lifecycle_cancel;
+    int64_t drawable_tick;
+    unsigned drawable_samples[EFP_DRAWABLE_BUCKETS], drawable_failures[EFP_DRAWABLE_BUCKETS];
+} ember_fg_presenter;
+static inline void efp_init(ember_fg_presenter *s) {
+    memset(s, 0, sizeof(*s)); s->epoch = 1; s->drawable_tick = -1;
+}
+static inline void efp_fault(ember_fg_presenter *s, unsigned reason) {
+    if (reason >= EFP_REASON_COUNT) return;
+    ++s->bypass[reason];
+    /* Drawable failures have their own rate policy. They never contribute to
+     * the two-strike admission-fault budget or discard an owned original. */
+    if (reason == EFP_DRAWABLE) return;
+    s->clean = 0; s->since = 0; s->enabled = 0;
+    if (reason == EFP_QUEUE) {
+        if (s->pending || s->inflight) ++s->risk_window;
+        s->stopped = 1;
+    } else if (reason != EFP_EPOCH && ++s->violations >= 2) s->stopped = 1;
+}
+/* One sample per acquisition attempt, including successful attempts; original
+ * and optional acquisition failures in that attempt count only once. Retry
+ * attempts count independently. Sliding 5 s window quantized to 100 ms (oldest
+ * partial bucket expires, so effective history is 4.9--5.0 s). At least 30
+ * attempts are needed: two startup failures cannot permanently stop a session.
+ * No waits, ownership changes, or terminal lifecycle transitions occur here. */
+static inline void efp_drawable_result(ember_fg_presenter *s, int64_t now, int failed) {
+    if (now < 0) now = 0;
+    const int64_t tick = now / EFP_DRAWABLE_BUCKET_NS;
+    if (s->drawable_tick < 0 || tick < s->drawable_tick ||
+        tick - s->drawable_tick >= EFP_DRAWABLE_BUCKETS) {
+        memset(s->drawable_samples, 0, sizeof(s->drawable_samples));
+        memset(s->drawable_failures, 0, sizeof(s->drawable_failures));
+    } else {
+        for (int64_t t = s->drawable_tick + 1; t <= tick; ++t) {
+            s->drawable_samples[t % EFP_DRAWABLE_BUCKETS] = 0;
+            s->drawable_failures[t % EFP_DRAWABLE_BUCKETS] = 0;
+        }
+    }
+    s->drawable_tick = tick;
+    ++s->drawable_samples[tick % EFP_DRAWABLE_BUCKETS];
+    if (failed) {
+        ++s->drawable_failures[tick % EFP_DRAWABLE_BUCKETS];
+        efp_fault(s, EFP_DRAWABLE);
+    }
+    uint64_t samples = 0, failures = 0;
+    for (unsigned i = 0; i < EFP_DRAWABLE_BUCKETS; ++i) {
+        samples += s->drawable_samples[i]; failures += s->drawable_failures[i];
+    }
+    if (samples >= EFP_DRAWABLE_MIN_SAMPLES && failures * 5 > samples) {
+        s->stopped = 1; s->enabled = 0; s->clean = 0; s->since = 0;
+    }
+}
+static inline void efp_invalidate(ember_fg_presenter *s) {
+    ++s->epoch; efp_fault(s, EFP_EPOCH);
+}
+static inline int efp_end_lifecycle(ember_fg_presenter *s, unsigned reason) {
+    if (reason < EFP_TERMINATED || reason > EFP_SURFACE_LOST) return 0;
+    if (s->lifecycle == EFP_ACTIVE) s->lifecycle = reason;
+    s->enabled = 0; s->stopped = 1; s->clean = 0; s->since = 0;
+    return 1;
+}
+/* previous_committed is read from the retained preceding command buffer's
+ * status at the next present. No commit interception and no GPU-ready wait. */
+static inline int efp_observe(ember_fg_presenter *s, uint64_t queue,
+                              uint64_t producer, int previous_committed,
+                              int64_t now, int legacy_idle) {
+    int bad = 0;
+    if (s->queue && queue != s->queue) { efp_fault(s, EFP_QUEUE); bad = 1; }
+    else if (s->producer && (!previous_committed || producer == s->producer)) {
+        efp_fault(s, EFP_PRECOMMIT); bad = 1;
+    }
+    if (!bad && !s->stopped) {
+        if (!s->clean || now <= s->last || now - s->last > 250000000LL) {
+            s->clean = 1; s->since = now;
+        } else if (s->clean < EFP_WARMUP_COUNT) ++s->clean;
+        if (s->clean >= EFP_WARMUP_COUNT && now - s->since >= EFP_WARMUP_NS && legacy_idle)
+            s->enabled = 1;
+    }
+    s->queue = queue; s->producer = producer; s->last = now;
+    return s->enabled && !s->stopped;
+}
+static inline unsigned efp_proofs(const ember_fg_presenter *s) {
+    return s->enabled && !s->stopped && s->clean >= EFP_WARMUP_COUNT &&
+           s->last - s->since >= EFP_WARMUP_NS && !s->pending ? EFP_PROOFS : 0;
+}
+/* Submitted GPU reads stay on the presenter too: pending==0 alone is not enough
+ * to mix a direct caller with older helper submissions from another queue. */
+static inline int efp_owns_originals(const ember_fg_presenter *s) {
+    return s->enabled || s->pending || s->inflight;
+}
+static inline int efp_slot(const ember_fg_presenter *s) {
+    unsigned i; for (i = 0; i < EFP_SLOTS; ++i) if (!s->refs[i]) return (int)i;
+    return -1;
+}
+static inline int efp_ref(ember_fg_presenter *s, int i) {
+    if (i < 0 || i >= EFP_SLOTS) return 0;
+    ++s->refs[i]; return 1;
+}
+static inline int efp_unref(ember_fg_presenter *s, int i) {
+    if (i < 0 || i >= EFP_SLOTS || !s->refs[i]) return 0;
+    --s->refs[i]; return 1;
+}
+static inline uint64_t efp_accept(ember_fg_presenter *s) {
+    if (s->pending || s->lifecycle != EFP_ACTIVE) return 0;
+    s->pending = 1; ++s->inflight; ++s->accepted;
+    return ++s->sequence;
+}
+static inline int efp_submit(ember_fg_presenter *s, uint64_t seq) {
+    if (!s->pending || seq != s->submitted + 1) return 0;
+    s->submitted = seq; s->pending = 0; return 1;
+}
+/* Cancellation retires only the ordered pending original, not its GPU leases.
+ * The adapter must call efp_complete and release those leases only after the
+ * producer GPU completion callback, including when cancellation precedes commit. */
+static inline int efp_cancel(ember_fg_presenter *s, uint64_t seq) {
+    if (s->lifecycle == EFP_ACTIVE || !s->pending || seq != s->submitted + 1) return 0;
+    s->submitted = seq; s->pending = 0; ++s->lifecycle_cancel;
+    return 1;
+}
+static inline int efp_complete(ember_fg_presenter *s) {
+    if (!s->inflight) return 0;
+    --s->inflight; ++s->completed; return 1;
+}
+#endif
diff --git a/dlls/winemac.drv/fg_presenter_metal.h b/dlls/winemac.drv/fg_presenter_metal.h
new file mode 100644
index 0000000..66721f5
--- /dev/null
+++ b/dlls/winemac.drv/fg_presenter_metal.h
@@ -0,0 +1,547 @@
+/* Ember-owned Metal implementation, included by the thin winemac adapter after
+ * fg_draw/fg_submit. Opt-in only. No commit hook, no producer GPU completion wait.
+ * The depth-one submission drain is the same dispatch_sync class as legacy fill. */
+#include "fg_presenter.h"
+
+@interface EmberFGSerial : NSObject {
+@public
+    pthread_mutex_t lock, surface_lock;
+    BOOL surface_bound;
+    unsigned hooks;
+    ember_fg_presenter state;
+    dispatch_queue_t submit;
+    dispatch_semaphore_t released;
+    id<MTLDevice> device;
+    id<MTLCommandQueue> queue;
+    id<MTLCommandBuffer> last_producer;
+    id<MTLTexture> textures[EFP_SLOTS];
+    id<MTLEvent> events[EFP_SLOTS];
+    uint64_t values[EFP_SLOTS];
+    int previous;
+    NSUInteger width, height;
+    MTLPixelFormat format;
+    void *encoder;                 /* ANE submit is thread safe; other calls use submit queue. */
+    BOOL ane_enabled;
+    double logged;
+}
+- (id)initWithDevice:(id<MTLDevice>)dev;
+@end
+@implementation EmberFGSerial
+- (id)initWithDevice:(id<MTLDevice>)dev {
+    if ((self = [super init])) {
+        pthread_mutex_init(&lock, NULL); pthread_mutex_init(&surface_lock, NULL);
+        efp_init(&state); previous = -1;
+        device = [dev retain]; queue = [dev newCommandQueue];
+        submit = dispatch_queue_create("ember.fg.serial-presenter", DISPATCH_QUEUE_SERIAL);
+        released = dispatch_semaphore_create(0);
+        ane_enabled = fg_ane_source() && fge.ane_submit; /* 1|flowq|llfi */
+        /* Construct before publishing this state. No model compilation/prediction
+         * is allowed here; the engine's ANE worker owns that asynchronous work. */
+        if (ane_enabled) {
+            encoder = fge.create2((uint64_t)(uintptr_t)dev, NULL, 0, FGE_HOST_D3DMETAL);
+            if (!encoder) ane_enabled = NO;
+            fprintf(stderr, "ember-fg-presenter: ane source=%s enabled=%d\n", fg_ane_source(), ane_enabled);
+        }
+        for (unsigned i = 0; i < EFP_SLOTS; ++i) events[i] = [dev newEvent];
+        for (unsigned i = 0; i < EFP_SLOTS; ++i)
+            if (!queue || !events[i]) state.stopped = 1;
+    }
+    return self;
+}
+- (void)dealloc {
+    /* Every queued job and GPU completion owns self. No synchronous destructor
+     * drain, no producer wait, and no destruction of an in-use encoding context. */
+    if (encoder) fge.destroy(encoder);
+    for (unsigned i = 0; i < EFP_SLOTS; ++i) { [textures[i] release]; [events[i] release]; }
+    [last_producer release]; [queue release]; [device release];
+    dispatch_release(submit); dispatch_release(released);
+    fprintf(stderr, "ember-fg-presenter: shutdown lifecycle=%u lifecycle_cancel=%llu accepted=%llu completed=%llu\n",
+            state.lifecycle, (unsigned long long)state.lifecycle_cancel,
+            (unsigned long long)state.accepted, (unsigned long long)state.completed);
+    pthread_mutex_destroy(&surface_lock); pthread_mutex_destroy(&lock); [super dealloc];
+}
+@end
+
+static int fg_serial_requested(void) {
+    const char *v = getenv("EMBER_FG_PRESENTER");
+    int requested = v && !strcmp(v, "1");
+    if (requested) {
+        static dispatch_once_t logged;
+        dispatch_once(&logged, ^{
+            fprintf(stderr, "ember-fg-presenter: getenv EMBER_FG_PRESENTER=%s requested=1\n", v);
+        });
+    }
+    return requested;
+}
+/* Diagnostics only: keep the admission predicate below unchanged. No state,
+ * getters or logging added to the default path. The opt-in hook owns p's monitor. */
+static void fg_serial_gate(EmberFGLayer *p) {
+    if (!fg_serial_requested()) return;
+    int ctx = p->fge_ctx != NULL, smooth = p->fge_cfg.smooth != 0;
+    int meter = fg_meter(), mode = fg_present_mode();
+    int neural = p->neural != NULL, ahdr = p->ahdr != NULL;
+    int up = ember_up_enabled(), timeout = p->real.allowsNextDrawableTimeout;
+    unsigned mask = (!ctx << 0) | (smooth << 1) | (meter << 2) | ((mode != 1) << 3) |
+                    (neural << 4) | (ahdr << 5) | (up << 6) | (!timeout << 7);
+    if (p->serial_gate_seen && p->serial_gate_mask == mask && p->serial_gate_mode == mode) return;
+    p->serial_gate_seen = YES; p->serial_gate_mask = mask; p->serial_gate_mode = mode;
+    fprintf(stderr, "ember-fg-presenter: gate layer=%p observe=called requested=1 fge_ctx=%d smooth=%d "
+            "meter=%d present_mode=%d neural=%d ahdr=%d up=%d allowsNextDrawableTimeout=%d "
+            "eligible=%d blocked=0x%02x\n", (void *)p, ctx, smooth, meter, mode, neural, ahdr, up, timeout,
+            mask == 0, mask);
+}
+static void fg_serial_invalidate(EmberFGLayer *p) {
+    EmberFGSerial *s = p->serial;
+    if (!s) return;
+    pthread_mutex_lock(&s->lock);
+    efp_invalidate(&s->state);
+    if (s->previous >= 0) efp_unref(&s->state, s->previous);
+    s->previous = -1;
+    pthread_mutex_unlock(&s->lock);
+}
+static void fg_serial_fault(EmberFGSerial *s, unsigned reason) {
+    pthread_mutex_lock(&s->lock); efp_fault(&s->state, reason); pthread_mutex_unlock(&s->lock);
+}
+static void fg_serial_drawable_result(EmberFGSerial *s, BOOL failed) {
+    pthread_mutex_lock(&s->lock);
+    efp_drawable_result(&s->state, (int64_t)(CACurrentMediaTime() * 1e9), failed);
+    pthread_mutex_unlock(&s->lock);
+}
+static void fg_serial_log(EmberFGSerial *s, double now) {
+    pthread_mutex_lock(&s->lock);
+    if (now - s->logged >= 5) {
+        s->logged = now;
+        fprintf(stderr, "ember-fg-presenter: enabled=%u stopped=%u clean=%u pending=%u gpu=%u "
+                "lifecycle=%u lifecycle_cancel=%llu proof=%u accepted=%llu submitted=%llu completed=%llu bypass(queue/precommit/depth/slot/drawable/epoch/resource)="
+                "%llu/%llu/%llu/%llu/%llu/%llu/%llu cross_queue_risk=%llu\n",
+                s->state.enabled, s->state.stopped, s->state.clean, s->state.pending, s->state.inflight,
+                s->state.lifecycle, (unsigned long long)s->state.lifecycle_cancel,
+                efp_proofs(&s->state), (unsigned long long)s->state.accepted,
+                (unsigned long long)(s->state.submitted - s->state.lifecycle_cancel), (unsigned long long)s->state.completed,
+                (unsigned long long)s->state.bypass[EFP_QUEUE], (unsigned long long)s->state.bypass[EFP_PRECOMMIT],
+                (unsigned long long)s->state.bypass[EFP_DEPTH], (unsigned long long)s->state.bypass[EFP_SLOT],
+                (unsigned long long)s->state.bypass[EFP_DRAWABLE], (unsigned long long)s->state.bypass[EFP_EPOCH],
+                (unsigned long long)s->state.bypass[EFP_RESOURCE], (unsigned long long)s->state.risk_window);
+    }
+    pthread_mutex_unlock(&s->lock);
+}
+/* The pre-existing proxy/real-layer association can retain the wrapper after
+ * view destruction. Release terminal GPU allocations and log drain explicitly;
+ * correctness must not depend on either NSObject dealloc running. */
+static void fg_serial_cleanup(EmberFGSerial *s) {
+    dispatch_async(s->submit, ^{
+        pthread_mutex_lock(&s->lock);
+        if (s->state.lifecycle != EFP_ACTIVE && !s->state.inflight && !s->state.pending && !s->hooks) {
+            if (s->encoder) { fge.destroy(s->encoder); s->encoder = NULL; }
+            for (unsigned i = 0; i < EFP_SLOTS; ++i) {
+                [s->textures[i] release]; s->textures[i] = nil;
+                [s->events[i] release]; s->events[i] = nil;
+            }
+            [s->last_producer release]; s->last_producer = nil;
+            fprintf(stderr, "ember-fg-presenter: lifecycle-drained=%u lifecycle_cancel=%llu accepted=%llu completed=%llu\n",
+                    s->state.lifecycle, (unsigned long long)s->state.lifecycle_cancel,
+                    (unsigned long long)s->state.accepted, (unsigned long long)s->state.completed);
+        }
+        pthread_mutex_unlock(&s->lock);
+    });
+}
+/* Explicit lifecycle notification, never inferred from a timeout or resize. */
+static void fg_serial_end(EmberFGSerial *s, unsigned reason) {
+    if (!s) return;
+    pthread_mutex_lock(&s->lock);
+    efp_end_lifecycle(&s->state, reason);
+    if (s->previous >= 0) efp_unref(&s->state, s->previous);
+    s->previous = -1;
+    fprintf(stderr, "ember-fg-presenter: lifecycle-end=%u lifecycle_cancel=%llu pending=%u gpu=%u\n",
+            s->state.lifecycle, (unsigned long long)s->state.lifecycle_cancel,
+            s->state.pending, s->state.inflight);
+    pthread_mutex_unlock(&s->lock);
+    fg_serial_cleanup(s);
+}
+static BOOL fg_serial_ended(EmberFGSerial *s) {
+    pthread_mutex_lock(&s->lock);
+    BOOL ended = s->state.lifecycle != EFP_ACTIVE;
+    pthread_mutex_unlock(&s->lock); return ended;
+}
+/* The layer is retained by jobs, so its dealloc cannot be the only shutdown
+ * signal. The actual WineMetalView owns this token; destroying that view is an
+ * authoritative end-of-surface event. No view/window is retained by the token. */
+@interface EmberFGSurfaceLifetime : NSObject {
+@public
+    EmberFGSerial *owner;
+}
+@end
+@implementation EmberFGSurfaceLifetime
+- (void)dealloc {
+    fg_serial_end(owner, EFP_TERMINATED);
+    [owner release]; [super dealloc];
+}
+@end
+static char fg_serial_surface_key;
+static void fg_serial_bind_surface(EmberFGLayer *p, EmberFGSerial *s) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        id view = p->real.delegate;
+        if ([view isKindOfClass:[NSView class]] && [(NSView *)view layer] == p->real) {
+            EmberFGSurfaceLifetime *token = [[EmberFGSurfaceLifetime alloc] init];
+            token->owner = [s retain];
+            objc_setAssociatedObject(view, &fg_serial_surface_key, token, OBJC_ASSOCIATION_RETAIN);
+            [token release];
+            pthread_mutex_lock(&s->lock); s->surface_bound = YES; pthread_mutex_unlock(&s->lock);
+        } else {
+            fg_serial_fault(s, EFP_RESOURCE);
+            pthread_mutex_lock(&s->lock); s->state.stopped = 1; pthread_mutex_unlock(&s->lock);
+            fprintf(stderr, "ember-fg-presenter: no authoritative view lifecycle; legacy retained\n");
+        }
+    });
+}
