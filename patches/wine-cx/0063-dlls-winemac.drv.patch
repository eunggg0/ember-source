+/* Optional work is authorized by the game policy AND by a separate, presenter-
+ * confined encoding context. Legacy contexts/resources never race helper work.
+ * Its source snapshots/events are held until the helper GPU completion, even
+ * when the frame is invalidated while nextDrawable is blocked. */
+static void fg_serial_run(EmberFGSerialJob *job, uint64_t value, uint64_t previous_value,
+                          uint64_t epoch, double handed, double disp,
+                          struct fge_frame_plan plan, struct fge_frame_in input) {
+    EmberFGLayer *p = job->layer; EmberFGSerial *s = job->owner;
+    BOOL drawable_retry = NO; // A failed attempt drops this job's optional output only.
+    for (;;) {
+        @autoreleasepool {
+            /* Device setters first end the lifecycle, then take this lock. Never
+             * use a new-device drawable with the old queue. Timeout must be on at
+             * admission; nil/slow drawable alone NEVER ends the lifecycle. */
+            pthread_mutex_lock(&s->surface_lock);
+            if (fg_serial_ended(s)) {
+                pthread_mutex_unlock(&s->surface_lock);
+                [job cancel]; fg_serial_unpending(p); return;
+            }
+            if (p->real.device != s->device) {
+                fg_serial_end(s, p->real.device ? EFP_DEVICE_REPLACED : EFP_SURFACE_LOST);
+                pthread_mutex_unlock(&s->surface_lock);
+                [job cancel]; fg_serial_unpending(p); return;
+            }
+            double started = CACurrentMediaTime();
+            id<CAMetalDrawable> original = [p->real nextDrawable], generated = nil;
+            if (!original) {
+                drawable_retry = YES;
+                pthread_mutex_unlock(&s->surface_lock);
+                fg_serial_drawable_result(s, YES); fg_serial_log(s, CACurrentMediaTime());
+                usleep((useconds_t)(fmin(disp, 0.05) * 1e6)); continue;
+            }
+            if (original.texture.device != s->device || p->real.device != s->device) {
+                fg_serial_end(s, p->real.device ? EFP_DEVICE_REPLACED : EFP_SURFACE_LOST);
+                pthread_mutex_unlock(&s->surface_lock);
+                [job cancel]; fg_serial_unpending(p); return;
+            }
+            BOOL timely = CACurrentMediaTime() - started <= disp;
+            BOOL drawable_failed = !timely;
+            pthread_mutex_lock(&s->lock);
+            BOOL optional = timely && !drawable_retry && s->state.enabled && !s->state.stopped && epoch == s->state.epoch &&
+                            job->previous && (plan.flags & FGE_PLAN_GENERATE);
+            pthread_mutex_unlock(&s->lock);
+            /* Always reserve the original first. */
+            if (optional && p->real.maximumDrawableCount >= 3 && p->pending == 0) {
+                generated = [p->real nextDrawable];
+                if (!generated || generated.texture.device != s->device || CACurrentMediaTime() - started > disp) {
+                    drawable_failed = YES; optional = NO;
+                }
+            } else optional = NO;
+            fg_serial_drawable_result(s, drawable_failed);
+            pthread_mutex_lock(&s->lock);
+            optional = optional && s->state.enabled && !s->state.stopped && epoch == s->state.epoch;
+            pthread_mutex_unlock(&s->lock);
+            id<MTLCommandBuffer> output = [s->queue commandBuffer];
+            if (!output) {
+                pthread_mutex_unlock(&s->surface_lock);
+                fg_serial_fault(s, EFP_RESOURCE); usleep(1000); continue;
+            }
+            [output encodeWaitForEvent:job->ready value:value];
+            if (optional) {
+                if (!s->encoder) s->encoder = fge.create2((uint64_t)(uintptr_t)s->device, NULL, 0, FGE_HOST_D3DMETAL);
+                struct fge_frame_plan encoder_plan = {0}; encoder_plan.size = sizeof(encoder_plan);
+                if (s->encoder) fge.begin_frame(s->encoder, &input, &encoder_plan);
+                [output encodeWaitForEvent:job->previous_ready value:previous_value];
+                id<MTLTexture> mc = nil;
+                if (s->encoder && (plan.flags & FGE_PLAN_MC)) {
+                    struct fge_encode_in in = {0}; struct fge_encode_out out = {0};
+                    in.size = sizeof(in); out.size = sizeof(out);
+                    in.command_buffer = (uint64_t)(uintptr_t)output;
+                    in.current = (uint64_t)(uintptr_t)job->current;
+                    in.previous = (uint64_t)(uintptr_t)job->previous; in.alpha = plan.blend_weight;
+                    in.ane_pair_id = s->ane_enabled ? job->sequence : 0;
+                    if (fge.encode(s->encoder, &in, &out) && out.ok) mc = (id<MTLTexture>)(uintptr_t)out.texture;
+                }
+                optional = fg_draw(output, mc ? mc : job->current, mc ? mc : job->previous,
+                                   mc ? 0.0f : 1.0f - plan.blend_weight, generated.texture);
+                if (!optional) fg_serial_fault(s, EFP_RESOURCE);
+            }
+            if (!fg_draw(output, job->current, job->current, 0, original.texture)) {
+                /* An unencoded original is not a successful submission. Retry
+                 * while active; lifecycle end can interrupt this resource retry. */
+                pthread_mutex_unlock(&s->surface_lock);
+                fg_serial_fault(s, EFP_RESOURCE); usleep(1000); continue;
+            }
+            pthread_mutex_lock(&s->lock);
+            if (s->state.lifecycle != EFP_ACTIVE) {
+                pthread_mutex_unlock(&s->lock); pthread_mutex_unlock(&s->surface_lock);
+                [job cancel]; fg_serial_unpending(p); return;
+            }
+            optional = optional && s->state.enabled && !s->state.stopped && epoch == s->state.epoch;
+            if (optional) {
+                fg_stage(p, FGS_ENCODE_G); fg_submit(p, output, generated, 0, 0);
+                __sync_fetch_and_add(&p->count_out, 1); __sync_fetch_and_add(&p->gen_total, 1);
+            } else if (plan.flags & FGE_PLAN_GENERATE) {
+                __sync_fetch_and_add(&p->dropped, 1); fg_stage(p, FGS_CANCEL_STALE);
+            }
+            fg_stage(p, FGS_ENCODE_O); fg_observe_gpu(p, output, YES);
+            fg_submit(p, output, original,
+                      optional ? fmin(disp * 0.9, plan.cadence_hold > 0 ? plan.cadence_hold : disp * 0.9) : 0, handed);
+            [output addCompletedHandler:^(id<MTLCommandBuffer> done) {
+                if (done.status != MTLCommandBufferStatusCompleted) fg_serial_fault(s, EFP_RESOURCE);
+                [job finish];
+            }];
+            [output commit];
+            efp_submit(&s->state, job->sequence);
+            pthread_mutex_unlock(&s->lock); pthread_mutex_unlock(&s->surface_lock);
+            fg_serial_unpending(p); __sync_fetch_and_add(&p->count_out, 1);
+            return;
+        }
+    }
+}
