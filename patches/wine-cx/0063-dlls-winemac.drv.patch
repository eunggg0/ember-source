--- /dev/null
+++ b/dlls/winemac.drv/ember_fg.h
@@ -0,0 +1,462 @@
+/*
+ * ember_fg.h — EmberCore frame generation engine, public C ABI.
+ *
+ * Copyright 2026 Ember. All rights reserved. Proprietary — see EmberCore/LICENSE-NOTES.md.
+ *
+ * libEmberFG.dylib is a native macOS library (x86_64 for Rosetta runtimes, arm64 for native runtimes).
+ * Hosts (the DXMT presenter through winemetal's unix side, later the D3DMetal path in winemac.drv)
+ * load it with dlopen() and resolve the symbols below with dlsym(). If the library is missing, or
+ * ember_fg_abi_version() reports a different major version, the host must run with frame generation off.
+ *
+ * Hosts
+ *   EMBER_FG_HOST_DXMT     — DXMT presenter (PE side → winemetal.so → this library). Uses ember_fg_create (1.0).
+ *   EMBER_FG_HOST_D3DMETAL — winemac.drv proxy layer that intercepts D3DMetal's presented drawables (1.1, ember_fg_create2).
+ *     Same policy, MC and switches; log lines are tagged "d3dm-fg" instead of "dxmt-fg". It has no game-side frame limiter of
+ *     its own, so it calls ember_fg_pace_present for the stable mode (EMBER_FG_GAME_CAP).
+ *
+ * Versioning
+ *   ember_fg_abi_version() returns (EMBER_FG_ABI_MAJOR << 16) | EMBER_FG_ABI_MINOR.
+ *   A major bump means incompatible changes. A minor bump only appends fields at the END of structs or adds
+ *   functions. Every in/out struct starts with `size` (sizeof as the caller knows it); the library reads and
+ *   writes only the bytes the caller declared, so old hosts keep working with newer minor versions.
+ *   A readable uint32_t size header is required even for invalid input. Size 0 is rejected (no payload
+ *   read/write), rather than the old undocumented assumption that it means a full-sized buffer.
+ *
+ * Handles
+ *   Metal objects cross the ABI as ember_fg_handle (uint64_t holding an Objective-C object pointer,
+ *   e.g. (ember_fg_handle)(uintptr_t)(__bridge void *)texture). Structs contain no raw pointers so that the
+ *   same bytes can be marshalled from 32-bit (WoW64) and 64-bit PE code unchanged.
+ *
+ * Ownership
+ *   - Handles passed IN are borrowed: the library never releases them, and retains nothing past the call
+ *     except the device given to ember_fg_create (retained until ember_fg_destroy).
+ *   - Handles passed OUT (interpolated texture, its fence, ring slot textures) are owned by the context.
+ *     They stay valid until the next call that may replace them (ember_fg_encode for the interpolated
+ *     texture/fence, ember_fg_ring_acquire for a free slot's texture) or until ember_fg_destroy.
+ *     The host must not release them; it may retain them if it needs them longer.
+ *   - Strings returned into caller buffers are always NUL-terminated when cap > 0.
+ *
+ * Threads
+ *   ember_fg_begin_frame / ember_fg_encode / ember_fg_ring_acquire: the host's present-encoding thread
+ *   (one at a time). ember_fg_ring_release / ember_fg_note_drop: any thread (pacer). ember_fg_get_stats /
+ *   ember_fg_hud_text: any thread (snapshot, may be a frame old). ember_fg_ring_wait_idle: any thread except
+ *   the one that must release slots. ember_fg_destroy: after all other calls returned.
+ *
+ * Time
+ *   All timestamps are int64 nanoseconds from one monotonic clock chosen by the host (the DXMT host uses
+ *   std::chrono::steady_clock). The library never reads a clock itself, so decisions are reproducible.
+ *
+ * Logging
+ *   The library queues human-readable log lines; the host drains them with ember_fg_drain_log() and writes
+ *   them to its own log. Each line is "I <text>\n" (info) or "E <text>\n" (error).
+ */
+#ifndef EMBER_FG_H
+#define EMBER_FG_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define EMBER_FG_ABI_MAJOR 1
+#define EMBER_FG_ABI_MINOR 4
+#define EMBER_FG_ABI_VERSION ((EMBER_FG_ABI_MAJOR << 16) | EMBER_FG_ABI_MINOR)
+
+#if defined(__GNUC__) && !defined(_WIN32)
+#define EMBER_FG_EXPORT __attribute__((visibility("default")))
+#else
+#define EMBER_FG_EXPORT
+#endif
+
+typedef uint64_t ember_fg_handle;
+typedef struct ember_fg_ctx ember_fg_ctx;
+
+/* ---- configuration (read once from the environment at create) ---------------------------------------- */
+
+/* Static switches the host needs to set up presentation. Env names in brackets, defaults as listed. */
+typedef struct ember_fg_config {
+  uint32_t size;
+  uint32_t ring_enabled;      /* [EMBER_FG_RING]  != "0" → 1. Host renders into ring slots, a pacer presents.   */
+  uint32_t ring_drawables;    /* [EMBER_FG_RING_DRAWABLES] "2" → 2, else 3 (layer maximumDrawableCount with FG). */
+  uint32_t ring_sync;         /* [EMBER_FG_RING_SYNC] != "0" → 1, forced 0 when ring_phase != 0.               */
+  int32_t  ring_phase;        /* [EMBER_FG_PHASE] 0..3 (experimental vsync-phase pacing, default 0).          */
+  uint32_t ring_copy_draw;    /* [EMBER_FG_RING_COPY] == "draw" → 1 (slot→drawable copy by render pass).        */
+  double   ring_phase_lead;   /* [EMBER_FG_PHASE_LEAD] ms → seconds, default 0.003.                            */
+  uint32_t mc_enabled;        /* [EMBER_FG_MC] != "0" → 1 (motion-compensated interpolation).                  */
+  uint32_t queue_guard;       /* [EMBER_FG_QUEUE_GUARD] == "1" → 1 (host polls display latency every 250 ms).  */
+  uint32_t smooth;            /* [EMBER_FG_MODE|EMBER_D3DM_FG_MODE] == "smooth" → 1, else fill mode.           */
+  uint32_t log;               /* [EMBER_FG_LOG|EMBER_D3DM_FG_LOG] == "1" → 1 (5 s statistics lines).           */
+  uint32_t ring_slots;        /* number of ring slots (4).                                                     */
+  uint32_t ring_frames_ahead; /* game frames that may be in flight in the ring (2).                            */
+  /* 1.1 */
+  uint32_t host;              /* EMBER_FG_HOST_* given at create                                               */
+  uint32_t pad0;
+  double   game_cap_fps;      /* [EMBER_FG_GAME_CAP] fps the present-side limiter holds the game to (0 = off).    */
+} ember_fg_config;
+
+enum { EMBER_FG_HOST_DXMT = 0, EMBER_FG_HOST_D3DMETAL = 1 };
+
+/* ---- per game frame ------------------------------------------------------------------------------------ */
+
+enum {
+  EMBER_FG_IN_FRAMEGEN   = 1u << 0, /* interpolation is possible this frame (FG on, single-sampled, previous-frame copy exists) */
+  EMBER_FG_IN_PREV_VALID = 1u << 1, /* the host's previous-frame copy holds the previous game frame                            */
+  EMBER_FG_IN_TEST_DUP   = 1u << 2, /* diagnostic: host repeats the real frame instead of interpolating (EMBER_FG_TEST_DUP)   */
+  EMBER_FG_IN_PRE_UP     = 1u << 3, /* host interpolates before an upscaler (EMBER_FG_PRE_UPSCALE) — logged only              */
+};
+
+typedef struct ember_fg_frame_in {
+  uint32_t size;
+  uint32_t flags;               /* EMBER_FG_IN_* */
+  int64_t  now_ns;              /* time the host started presenting this game frame */
+  uint64_t frame_no;            /* host present counter, +1 per game frame */
+  double   display_interval;    /* seconds per display refresh the host targets (already clamped to the real refresh) */
+  double   display_latency_ms;  /* measured present→on-glass latency of real frames (0 = unknown) */
+  /* 1.2: optional feedback. Old hosts omit it and keep their original policy. All timestamps use now_ns's clock. */
+  int64_t  latency_sample_ns;   /* latest original presented callback observation; 0 = unknown */
+  int64_t  transport_start_ns;  /* oldest original awaiting presenter submission; 0 = none */
+  uint32_t transport_outstanding;
+  uint32_t telemetry_flags;     /* EMBER_FG_TELEMETRY_*; opt-in only for D3DMetal */
+} ember_fg_frame_in;
+
+enum { EMBER_FG_TELEMETRY_LATGUARD = 1u << 0 };
+
+enum {
+  EMBER_FG_PLAN_GENERATE      = 1u << 0, /* insert an interpolated frame before this real frame */
+  EMBER_FG_PLAN_MC            = 1u << 1, /* produce it with ember_fg_encode (motion compensation); else host blends */
+  EMBER_FG_PLAN_KEEP_PREVIOUS = 1u << 2, /* host must copy this real frame as "previous" for the next interpolation */
+  EMBER_FG_PLAN_LATGUARD_PAUSED = 1u << 3, /* 1.2: original-only drain/learning; no optional previous copy */
+};
+
+typedef struct ember_fg_frame_plan {
+  uint32_t size;
+  uint32_t flags;          /* EMBER_FG_PLAN_* */
+  float    blend_weight;   /* weight of the current frame in the interpolated one (0.5 by default) */
+  float    pad0;
+  double   defer;          /* seconds between the interpolated and the real frame (smooth: half game interval, fill: one refresh) */
+  double   cadence_hold;   /* seconds the interpolated frame must stay on screen before the real one (0 = next vsync) */
+} ember_fg_frame_plan;
+
+/* ---- interpolation (GPU) -------------------------------------------------------------------------------- */
+
+#define EMBER_FG_MAX_WAIT_FENCES 256   /* = every fence a DXMT encoder can wait for (4 parities x 64 lanes) */
+
+typedef struct ember_fg_encode_in {
+  uint32_t size;
+  uint32_t n_wait_fences;           /* fences the first pass reading `current` must wait for (fragment stage) */
+  ember_fg_handle command_buffer;   /* id<MTLCommandBuffer>, encoding happens into it */
+  ember_fg_handle current;          /* id<MTLTexture> current real frame (or 0 and current_iosurface) */
+  ember_fg_handle previous;         /* id<MTLTexture> previous real frame (same size) */
+  ember_fg_handle current_iosurface;/* IOSurfaceRef alternative to `current` (wrapped as current_format) */
+  uint64_t current_format;          /* MTLPixelFormat for current_iosurface */
+  float    alpha;                   /* time position of the interpolated frame (current-frame weight) */
+  float    pad0;
+  ember_fg_handle wait_fences[EMBER_FG_MAX_WAIT_FENCES]; /* id<MTLFence> */
+  /* Pair token from ember_fg_ane_submit; zero preserves legacy behavior. */
+  uint64_t ane_pair_id;
+} ember_fg_encode_in;
+
+/* Async optical-flow preflight. Caller owns and commits command_buffer; no wait/commit here.
+ * pair_id must increase for each immutable source pair (including resize/scene resets).
+ * Serialize all calls on a context (the helper worker owns only detached ANE state).
+ * Retain source CONTENTS unchanged through the later encode command's completion.
+ * deadline_ns uses mach_absolute_time converted to ns, and includes inference/copy time.
+ * Return 1 means admitted, not ready. A busy/missing/late result uses normal encode fallback.
+ * Optional, opt-in EMBER_FG_ANE=1 (legacy), flowq or llfi (VT LLFI via arm64 helper); uses CPUAndNeuralEngine (legacy macOS 13+, FlowQ macOS 14+).
+ * FlowQ supports midpoint exact pairs only and ignores reuse_previous.
+ */
+typedef struct ember_fg_ane_submit_in {
+  uint32_t size, n_wait_fences;
+  ember_fg_handle command_buffer, current, previous;
+  uint64_t pair_id;
+  int64_t deadline_ns;
+  ember_fg_handle wait_fences[EMBER_FG_MAX_WAIT_FENCES];
+  /* Optional v1.4 suffix: reuse_previous=1 retains this result for the NEXT pair.
+   * source_time_ns is current original arrival, interval_ns its source-pair gap.
+   * deadline_ns then expires inference only, never the original/optional present.
+   * Call submit for every pair even while busy; encode may consume the prior result.
+   * Zero/absent suffix preserves exact-pair semantics. */
+  int64_t source_time_ns, interval_ns;
+  uint32_t reuse_previous, reserved;
+} ember_fg_ane_submit_in;
+EMBER_FG_EXPORT int ember_fg_ane_submit(ember_fg_ctx *ctx, const ember_fg_ane_submit_in *in);
+/* Nonblocking exact-pair poll: -1 unavailable/expired, 0 pending, 1 ready,
+ * 2 successfully encoded. Poll never consumes or abandons a result. */
+EMBER_FG_EXPORT int ember_fg_ane_status(ember_fg_ctx *ctx, uint64_t pair_id);
+
+typedef struct ember_fg_encode_out {
+  uint32_t size;
+  uint32_t ok;                      /* 1 = interpolated frame encoded; 0 = host falls back (blend) */
+  ember_fg_handle texture;          /* id<MTLTexture> RGBA16Float, current-frame size (context-owned) */
+  ember_fg_handle fence;            /* id<MTLFence> updated after the last pass writing `texture` and reading `current` */
+} ember_fg_encode_out;
+
+/* ---- ring presentation ---------------------------------------------------------------------------------- */
+
+typedef struct ember_fg_ring_req {
+  uint32_t size;
+  uint32_t need_generated;          /* 1 = reserve a slot for the interpolated frame too */
+  uint64_t width, height;           /* drawable size */
+  uint64_t pixel_format;            /* MTLPixelFormat of the drawables */
+} ember_fg_ring_req;
+
+typedef struct ember_fg_ring_slots {
+  uint32_t size;
+  uint32_t ok;                      /* 0 = no ring this frame (texture allocation failed) — host presents directly */
+  int32_t  gen_slot, cur_slot;      /* -1 = none */
+  ember_fg_handle gen_texture, cur_texture; /* slot render targets (context-owned) */
+} ember_fg_ring_slots;
+
+enum {
+  EMBER_FG_DROP_STALE = 0,          /* pacer: next frame already finished on the GPU */
+  EMBER_FG_DROP_LATE = 1,           /* pacer: drawable arrived too late */
+  EMBER_FG_DROP_NO_DRAWABLE = 2,    /* pacer: no drawable (occluded / present stall) */
+  EMBER_FG_DROP_RING = 3,           /* host: no ring slot for the interpolated frame */
+};
+
+/* ---- statistics / HUD ----------------------------------------------------------------------------------- */
+
+typedef struct ember_fg_stats {
+  uint32_t size;
+  uint32_t guard_active;            /* 1 = guard holds interpolation off (real frames only) */
+  int32_t  guard_reason;            /* 0 none, 1 game too slow, 2 FG GPU cost, 3 back-off, 4 cost probe, 5 latency guard hold */
+  int32_t  backoff_level;
+  double   guard_cost;              /* learnt FG cost (game interval with FG / without) */
+  double   guard_native_fps;        /* game fps without FG (guard median) */
+  double   guard_hold_left;         /* seconds left of back-off wait */
+  uint32_t active;                  /* interpolation enabled by the game-speed check */
+  uint32_t fast;                    /* game already at refresh rate — interpolation skipped */
+  double   game_interval;           /* EMA game frame interval (s) */
+  double   mc_confidence;           /* EMA of mean MC confidence (-1 = none yet) */
+  double   dump_mean_conf;          /* mean confidence of the last MC frame (for frame dumps, -1 = none) */
+  /* 1.1 */
+  double   base_interval;           /* slot-budget base interval (s, 0 = FG inactive) */
+  uint64_t frames_in;               /* running counts since create: game frames seen with FG possible, */
+  uint64_t frames_generated;        /*   frames planned with an interpolated frame,                    */
+  uint64_t frames_budget_skipped;   /*   frames without one because the slot budget was short,         */
+  uint64_t frames_guard_blocked;    /*   frames the guard (or a probe) held to real frames only        */
+  double   cadence_hold;            /* last plan's cadence hold (s) */
+  int32_t  cadence_slots;           /* fixed-refresh cadence: refreshes between interpolated and real frame (1 or 2) */
+  uint32_t pad1;
+  /* 1.2: adaptive guard, cumulative counts; state 0 disabled, 1 learning, 2 running, 3 paused, 4 probe. */
+  uint32_t latguard_state;
+  uint32_t latguard_reason;        /* 0 none, 1 display latency, 2 native fps loss, 3 transport, 4 learning */
+  double   latguard_baseline_ms;
+  double   latguard_baseline_fps;
+  uint64_t latguard_pauses;
+  uint64_t latguard_skips;
+} ember_fg_stats;
+
+/* ---- 1.3 optional batch / measurement contract ----
+ * The existing begin_frame/encode/ring functions still describe at most ONE generated image.
+ * Future hosts must resolve the optional symbols AND negotiate capability bits before using batches.
+ * Every timestamp below is host-monotonic nanoseconds, including converted presented callbacks.
+ * A zero presented timestamp means an unsuccessful/unknown presentation, never an on-glass frame.
+ * Zero/short mandatory prefixes, unknown flags, count > 3, nonfinite/out-of-range t, and unordered
+ * targets are errors. Outputs are bounded by caller size; failed admission falls back to originals.
+ * Structures deliberately contain only fixed-width scalars, explicit padding and fixed arrays.
+ */
+#define EMBER_FG_MAX_GENERATED 3
+enum {
+  EMBER_FG_CAP_PLAN_BATCH = 1u << 0,
+  EMBER_FG_CAP_ENCODE_BATCH = 1u << 1,
+  EMBER_FG_CAP_OUTPUT_RELEASE = 1u << 2,
+  EMBER_FG_CAP_OUTPUT_FEEDBACK = 1u << 3,
+  EMBER_FG_CAP_ARBITRARY_T = 1u << 4,
+  EMBER_FG_CAP_BATCH_READY = 1u << 5,
+  EMBER_FG_CAP_ANE_ASYNC = 1u << 6 /* preflight API available, not a model/device readiness claim */
+};
+enum {
+  EMBER_FG_BATCH_OK = 0,
+  EMBER_FG_BATCH_INVALID = 1,
+  EMBER_FG_BATCH_UNSUPPORTED = 2,
+  EMBER_FG_BATCH_VETO = 3,
+  EMBER_FG_BATCH_RESOURCE = 4,
+  EMBER_FG_BATCH_DEADLINE = 5,
+  EMBER_FG_BATCH_OLD_EPOCH = 6
+};
+enum { EMBER_FG_MULTIPLIER_AUTO = 0, EMBER_FG_MULTIPLIER_2 = 2,
+       EMBER_FG_MULTIPLIER_3 = 3, EMBER_FG_MULTIPLIER_4 = 4 };
+enum {
+  EMBER_FG_BATCH_PREV_VALID = 1u << 0,
+  EMBER_FG_BATCH_SCENE_CUT = 1u << 1,
+  EMBER_FG_BATCH_TELEMETRY_FRESH = 1u << 2,
+  EMBER_FG_BATCH_ADMITTED = 1u << 3
+};
+
+typedef struct ember_fg_capabilities {
+  uint32_t size, flags;           /* EMBER_FG_CAP_* */
+  uint32_t max_generated, pad0;
+  float min_t, max_t;             /* only meaningful with ARBITRARY_T; endpoints excluded */
+  uint32_t pad1, pad2;
+} ember_fg_capabilities;
+
+typedef struct ember_fg_batch_in {
+  uint32_t size, flags;           /* EMBER_FG_BATCH_* */
+  uint64_t epoch, original_seq;
+  int64_t now_ns;
+  int64_t original_interval_ns;   /* learnt original-only interval, not FG-backpressured interval */
+  int64_t display_interval_ns;    /* effective screen/mode period, not advertised maximum */
+  int64_t previous_target_ns;
+  int64_t original_present_entry_ns;
+  int64_t baseline_latency_ns, latency_budget_ns;
+  int64_t native_gpu_p99_ns, optional_pair_p99_ns, optional_output_p99_ns;
+  int64_t gpu_jitter_ns, submit_jitter_ns, ready_estimate_ns;
+  int64_t latency_sample_ns, transport_start_ns;
+  uint32_t transport_outstanding, multiplier_limit; /* auto/2/3/4 */
+  uint32_t guard_state, guard_admission; /* 1.2 state; 0 veto, 1 permitted, 2 one-image probe */
+  uint32_t available_outputs, pad0;
+  int64_t baseline_sample_ns, cost_sample_ns; /* independently expire; freshness flag does not replace timestamps */
+  /* Optional stage-4 measured-path suffix. Without the complete suffix, n<=1.
+   * Costs are measured total per-path p99, including all optional transport. */
+  int64_t observed_interval_ns, observed_latency_ns;
+  int64_t optional_cost_p99_ns[4], legacy_cost_p99_ns[4];
+  uint32_t measured_paths, mc_path;
+} ember_fg_batch_in;
+
+typedef struct ember_fg_batch_plan {
+  uint32_t size, status;          /* EMBER_FG_BATCH_* result */
+  uint64_t epoch, original_seq;
+  uint32_t count, blocked_reason; /* informational plan count, never existing GENERATE semantics */
+  float t[EMBER_FG_MAX_GENERATED];
+  uint32_t pad0;
+  int64_t target_ns[EMBER_FG_MAX_GENERATED];
+  int64_t original_target_ns;     /* planned slot, separately from the last permissible deadline */
+  int64_t original_deadline_ns;
+  double fractional_credit;      /* phase only, [0,1); omitted outputs do not become a debt */
+} ember_fg_batch_plan;
+
+typedef struct ember_fg_batch_encode_in {
+  uint32_t size, flags;           /* flags reserved, must be zero */
+  uint64_t epoch, original_seq;
+  ember_fg_handle command_buffer, previous, current;
+  uint64_t input_ready_token;
+  uint32_t count, pad0;
+  float t[EMBER_FG_MAX_GENERATED];
+  uint32_t pad1;
+  int64_t target_ns[EMBER_FG_MAX_GENERATED];
+  int64_t original_target_ns, original_deadline_ns;
+  int64_t now_ns;                 /* same host monotonic clock as the accepted plan */
+} ember_fg_batch_encode_in;
+
+typedef struct ember_fg_batch_encode_out {
+  uint32_t size, status;
+  uint64_t epoch, original_seq;
+  uint32_t count, valid_mask;     /* original-copy fallback MUST NOT set a generated-valid bit */
+  ember_fg_handle texture[EMBER_FG_MAX_GENERATED];
+  uint64_t ready_token[EMBER_FG_MAX_GENERATED];
+  uint64_t consume_token[EMBER_FG_MAX_GENERATED];
+} ember_fg_batch_encode_out;
+
+enum {
+  EMBER_FG_FEEDBACK_GENERATED = 1u << 0,
+  EMBER_FG_FEEDBACK_VALID_CONTENT = 1u << 1,
+  EMBER_FG_FEEDBACK_PRESENTED = 1u << 2
+};
+/* Separate plan/encode/submit/GPU/consume/present observations; never count submission as presentation.
+ * Output index 0..count-1 names generated images, count names the protected original.
+ * Callbacks carry epoch+sequence+token so a future implementation can reject stale/duplicate callbacks. */
+typedef struct ember_fg_output_feedback {
+  uint32_t size, flags;           /* EMBER_FG_FEEDBACK_* */
+  uint64_t epoch, original_seq, output_token;
+  uint32_t output_index, drop_reason;
+  float t;
+  uint32_t pad0;
+  int64_t target_ns, encode_begin_ns, encode_end_ns;
+  int64_t ready_ns, submit_ns, gpu_complete_ns, consume_complete_ns, presented_ns;
+} ember_fg_output_feedback;
+
+typedef struct ember_fg_output_release {
+  uint32_t size, flags;           /* reserved, must be zero; GPU consumption must already be complete */
+  uint64_t epoch, original_seq, consume_token;
+  uint32_t output_index, pad0;
+  int64_t consume_complete_ns;
+} ember_fg_output_release;
+
+/* Optional dlsym signatures; hosts must negotiate the complete required capabilities. */
+typedef int (*ember_fg_capabilities_fn)(ember_fg_ctx *, ember_fg_capabilities *);
+typedef int (*ember_fg_plan_batch_fn)(ember_fg_ctx *, const ember_fg_batch_in *, ember_fg_batch_plan *);
+typedef int (*ember_fg_encode_batch_fn)(ember_fg_ctx *, const ember_fg_batch_encode_in *, ember_fg_batch_encode_out *);
+typedef int (*ember_fg_output_release_fn)(ember_fg_ctx *, const ember_fg_output_release *);
+typedef int (*ember_fg_output_feedback_fn)(ember_fg_ctx *, const ember_fg_output_feedback *);
+
+/* Stage 4: encode's valid_mask is provisional (zero). Query after the input command
+ * buffer completes. Ready/consume tokens identify the same durable output lease.
+ * Every generated lease needs exactly one release AND one feedback (zero timestamp
+ * for an unseen/drop output). Only then may another batch replace its resources.
+ * On encode failure, nonzero ready_token values require draining the input command
+ * buffer via batch_ready even though encode returned zero. Such tokens expose no
+ * texture/consume lease; completion always has RESOURCE status and zero valid_mask.
+ * Shared resources cannot be reused until batch_ready reports completed. Rejections
+ * before command-buffer retention return no tokens; later failures conservatively
+ * require draining. The caller must complete the input buffer.
+ * Original feedback identities are tracked independently across batch replacement;
+ * outstanding records are never evicted. Exhausting the bounded record store vetoes
+ * further batches until original feedback arrives. Each original needs one feedback.
+ * The host must drain these callbacks before destroy and reject expired targets
+ * before encode/submit; command submission is never evidence of presentation. */
+typedef struct ember_fg_batch_ready_in {
+  uint32_t size, flags;
+  uint64_t epoch, original_seq, ready_token;
+} ember_fg_batch_ready_in;
+typedef struct ember_fg_batch_ready_out {
+  uint32_t size, status;
+  uint64_t epoch, original_seq;
+  uint32_t count, valid_mask, completed, pad0;
+} ember_fg_batch_ready_out;
+typedef int (*ember_fg_batch_ready_fn)(ember_fg_ctx *, const ember_fg_batch_ready_in *, ember_fg_batch_ready_out *);
+
+/* ---- functions ------------------------------------------------------------------------------------------ */
+
+EMBER_FG_EXPORT uint32_t ember_fg_abi_version(void);
+
+/* device: id<MTLDevice>. env: "KEY=VALUE\0KEY=VALUE\0\0" snapshot of the environment the switches are read from,
+ * or NULL to use getenv(). Returns NULL on failure (host keeps FG off). */
+EMBER_FG_EXPORT ember_fg_ctx *ember_fg_create(ember_fg_handle device, const char *env, size_t env_len);
+EMBER_FG_EXPORT void ember_fg_destroy(ember_fg_ctx *ctx);
+EMBER_FG_EXPORT void ember_fg_get_config(ember_fg_ctx *ctx, ember_fg_config *out);
+
+/* Decide what to do with this game frame (activation, budget, guard, probes, cadence). Cheap, CPU only. */
+EMBER_FG_EXPORT int ember_fg_begin_frame(ember_fg_ctx *ctx, const ember_fg_frame_in *in, ember_fg_frame_plan *out);
+
+/* Encode the motion-compensated interpolated frame into in->command_buffer. Call only when the plan has
+ * EMBER_FG_PLAN_GENERATE | EMBER_FG_PLAN_MC. Returns out->ok. */
+EMBER_FG_EXPORT int ember_fg_encode(ember_fg_ctx *ctx, const ember_fg_encode_in *in, ember_fg_encode_out *out);
+
+/* Ring slots: acquire blocks while the ring is full (at most ring_frames_ahead frames in flight). */
+EMBER_FG_EXPORT int ember_fg_ring_acquire(ember_fg_ctx *ctx, const ember_fg_ring_req *in, ember_fg_ring_slots *out);
+/* Return a slot (slot < 0 allowed). frame_done = the real frame of that game frame has been presented. */
+EMBER_FG_EXPORT void ember_fg_ring_release(ember_fg_ctx *ctx, int32_t slot, int32_t frame_done);
+/* Block until every slot is free and no frame is in flight (before resizing / destroying the layer). */
+EMBER_FG_EXPORT void ember_fg_ring_wait_idle(ember_fg_ctx *ctx);
+
+EMBER_FG_EXPORT void ember_fg_note_drop(ember_fg_ctx *ctx, uint32_t kind);
+
+EMBER_FG_EXPORT void ember_fg_get_stats(ember_fg_ctx *ctx, int64_t now_ns, ember_fg_stats *out);
+/* HUD line for the overlay (starts with '\n', may be empty): "FG ON  OUT n" / "FG WAIT (GAME FAST)" / "FG CHECK" /
+ * "FG OFF (GPU xC)" / "FG RETRY ns" / "FG PAUSE (LOW FPS n)". generated_frames = host's running count of presented
+ * interpolated frames; game_fps = host's measured game fps over its HUD window. Returns strlen. */
+EMBER_FG_EXPORT size_t ember_fg_hud_text(ember_fg_ctx *ctx, int64_t now_ns, double game_fps, uint64_t generated_frames,
+                                         char *buf, size_t cap);
+
+/* Move queued log lines into buf. Returns bytes written (without NUL). */
+EMBER_FG_EXPORT size_t ember_fg_drain_log(ember_fg_ctx *ctx, char *buf, size_t cap);
+
+/* ---- 1.1 ------------------------------------------------------------------------------------------------- */
+
+/* ember_fg_create with a host kind (EMBER_FG_HOST_*). ember_fg_create(...) == ember_fg_create2(..., EMBER_FG_HOST_DXMT). */
+EMBER_FG_EXPORT ember_fg_ctx *ember_fg_create2(ember_fg_handle device, const char *env, size_t env_len, uint32_t host);
+
+/* Present-side frame limiter for the stable mode ([EMBER_FG_GAME_CAP] > 0): the game frame interval is held to
+ * max(1 / cap, display_interval), like DXMT's d3d11.gameFrameCap. Call once per game frame before ember_fg_begin_frame.
+ * Returns the host-clock time (ns) to wait until before presenting this frame, or 0 = present now. Pass the time the
+ * host actually resumed as ember_fg_frame_in.now_ns; the engine paces the next frame from it. */
+EMBER_FG_EXPORT int64_t ember_fg_pace_present(ember_fg_ctx *ctx, int64_t now_ns, double display_interval);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EMBER_FG_H */
diff --git a/dlls/winemac.drv/ember_fg_display_link.h b/dlls/winemac.drv/ember_fg_display_link.h
new file mode 100644
index 0000000..c3f001f
--- /dev/null
+++ b/dlls/winemac.drv/ember_fg_display_link.h
@@ -0,0 +1,85 @@
+/* Optional native display service ABI. Existing ember_fg.h layouts are unchanged.
+ * All times are CACurrentMediaTime seconds converted to signed nanoseconds.
+ * Fixed width handles carry native ObjC pointers; no PE-side object marshalling.
+ * get_api + complete capabilities + every function pointer are required.
+ */
+#ifndef EMBER_FG_DISPLAY_LINK_H
+#define EMBER_FG_DISPLAY_LINK_H
+#include "ember_fg.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define EMBER_FG_DL_VERSION 1u
+enum { EMBER_FG_DL_CAP_ENQUEUE = 1u, EMBER_FG_DL_CAP_LEASE = 2u,
+       EMBER_FG_DL_CAP_FEEDBACK = 4u, EMBER_FG_DL_CAP_EPOCH = 8u,
+       EMBER_FG_DL_CAP_ALL = 15u };
+enum { EMBER_FG_DL_LEGACY, EMBER_FG_DL_ARMING, EMBER_FG_DL_LINK_OWNS, EMBER_FG_DL_DRAINING };
+enum { EMBER_FG_DL_FULLSCREEN = 1u, EMBER_FG_DL_VISIBLE = 2u,
+       /* Historical name: bounded UNORM with non-extended colorspace, EDR allowed. */
+       EMBER_FG_DL_SDR = 4u, EMBER_FG_DL_LEGACY_IDLE = 8u };
+enum { EMBER_FG_DL_ORIGINAL = 1u, EMBER_FG_DL_GENERATED = 2u,
+       EMBER_FG_DL_DROPPED = 4u, EMBER_FG_DL_REPEAT = 8u };
+typedef struct ember_fg_dl ember_fg_dl;
+typedef struct ember_fg_dl_config {
+    uint32_t size, multiplier; /* 3 or 4, default/auto uses 3 */
+    ember_fg_handle device, layer;
+} ember_fg_dl_config;
+typedef struct ember_fg_dl_surface {
+    uint32_t size, flags; /* full screen + visible + SDR; IDLE is host ownership handshake */
+    uint64_t epoch; /* strictly increases on resize/format/device/screen/visibility/EDR/colorspace change */
+    /* width/height describe SOURCE pixels for candidate allocation/memory cap.
+     * The final linear render pass targets layer.drawableSize independently. */
+    uint32_t display_id, width, height, reserved;
+} ember_fg_dl_surface;
+typedef struct ember_fg_dl_source {
+    uint32_t size, reserved;
+    uint64_t epoch, sequence;
+    ember_fg_handle command_buffer, texture;
+    int64_t source_ns;
+} ember_fg_dl_source;
+typedef struct ember_fg_dl_feedback {
+    uint32_t size, flags;
+    uint64_t lease, epoch, sequence;
+    int64_t media_ns, ready_ns, target_ns, submit_ns, gpu_ns, presented_ns;
+} ember_fg_dl_feedback;
+typedef struct ember_fg_dl_status {
+    uint32_t size, state;
+    uint64_t epoch, accepted, rejected, submitted, presented, skipped, feedback_lost;
+    uint32_t pending, ready, in_flight, reserved;
+    int64_t content_delay_ns;
+} ember_fg_dl_status;
+typedef struct ember_fg_dl_api {
+    uint32_t size, version, capabilities, reserved;
+    ember_fg_dl *(*create)(const ember_fg_dl_config *);
+    /* Control-plane update never waits for GPU/presentation drain. It may briefly
+     * synchronize the CPU-only display clock callback. Returns ownership state.
+     * If the control lock is busy, conservatively returns DRAINING without
+     * changing state; keep suppressing legacy and retry the surface update.
+     * LEGACY_IDLE may only be asserted after ALL older legacy CBs/drawables drain.
+     * A surface mutation must revoke ownership first; host suppresses legacy until
+     * state becomes LEGACY. Eligible EDR/colorspace changes rearm without legacy;
+     * the host supplies a new epoch and quiesces until the barrier is clear.
+     * A new epoch always resumes with an original. */
+    uint32_t (*update)(ember_fg_dl *, const ember_fg_dl_surface *);
+    /* Try-only admission. On 1, service owns snapshot+lease until feedback. On 0,
+     * caller still owns source. In LINK_OWNS even rejection MUST NOT legacy-present;
+     * request drain and let this frame be explicitly dropped. Caller commits CB.
+     * A retained texture alone is insufficient: snapshot is encoded into this CB. */
+    int (*enqueue)(ember_fg_dl *, const ember_fg_dl_source *, uint64_t *lease);
+    int (*feedback)(ember_fg_dl *, ember_fg_dl_feedback *); /* bounded try-pop, 0 empty/busy */
+    int (*status)(ember_fg_dl *, ember_fg_dl_status *); /* try-snapshot */
+    /* DRAINING polls return 0; destroy succeeds only after all GPU/present callbacks.
+     * On timeout keep handle/library/device alive; never hot-unload. */
+    int (*destroy)(ember_fg_dl *);
+} ember_fg_dl_api;
+typedef int (*ember_fg_dl_get_api_fn)(uint32_t, ember_fg_dl_api *);
+EMBER_FG_EXPORT int ember_fg_display_link_get_api(uint32_t version, ember_fg_dl_api *out);
+static inline int ember_fg_dl_api_valid(const ember_fg_dl_api *a) {
