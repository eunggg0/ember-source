+/* Native host glue only: scheduling, texture leases and presentation policy live
+ * in libEmberFG. MRC, included by the isolated ember_framegen.m copy. */
+#ifndef EMBER_DISPLAY_LINK_ADAPTER_H
+#define EMBER_DISPLAY_LINK_ADAPTER_H
+#include "ember_fg_display_link.h"
+#include "fg_display_link_geometry.h"
+#include "fg_display_link_metadata.h"
+
+static ember_fg_dl_api fg_link_api;
+/* Retained until retire/drain finishes, so a direct real-layer present cannot
+ * race an adapter deallocation. retire explicitly breaks the layer cycle. */
+static char fg_link_adapter_key;
+static int fg_link_requested(void) {
+    const char *v = getenv("EMBER_FG_DISPLAY_LINK");
+    return v && !strcmp(v, "1");
+}
+static int fg_link_output8(void) {
+    const char *v = getenv("EMBER_FG_OUT8");
+    return !v || strcmp(v, "0");
+}
+static void fg_link_negotiate(void *library) {
+    ember_fg_dl_get_api_fn get = NULL;
+    if (!fg_link_requested()) return;
+    *(void **)&get = dlsym(library, "ember_fg_display_link_get_api");
+    ember_fg_dl_api a = { .size = sizeof(a) };
+    if (!get || !get(EMBER_FG_DL_VERSION, &a) || !ember_fg_dl_api_valid(&a)) {
+        fprintf(stderr, "ember-d3dm-link: optional ABI/capabilities unavailable; legacy\n");
+        return;
+    }
+    fg_link_api = a; /* fge_load keeps this library loaded for process lifetime. */
+}
+
+/* Observation only: never substitute a drawable or retire the service because
+ * the game's inherited proxy acquisition stalls. Each concurrent call has its
+ * own ticket; the watchdog neither uses the game thread nor calls Metal. */
+@interface EmberFGProxyAcquire : NSObject {
+@public
+    uint64_t sequence, epoch;
+    uint32_t owner;
+    double begin, logged;
+    void *proxy;
+    BOOL main_thread, trace;
+}
+@end
+@implementation EmberFGProxyAcquire
+@end
+
+@interface EmberDisplayLinkAdapter : NSObject {
+    CAMetalLayer *layer;
+    id<MTLDevice> device;
+    ember_fg_dl *service;
+    ember_fg_dl_surface surface;
+    uint32_t state;
+    uint64_t sequence, legacy_gpu, lease_accepted, feedback_count;
+    dispatch_queue_t acquisition_queue;
+    id<CAMetalDrawable> prefetched;
+    BOOL acquisition_busy;
+    uint64_t acquisition_generation, acquisition_timeouts;
+    uint64_t legacy_attempts, legacy_allowed, legacy_blocked, legacy_while_link;
+    NSMutableArray *proxy_acquisitions;
+    uint64_t proxy_sequence, proxy_returns, proxy_stalls;
+    uint32_t proxy_last_owner;
+    BOOL proxy_watchdog_pending;
+    double ownership_logged;
+    NSUInteger format, service_format, source_format;
+    uint32_t source_width, source_height;
+    CGSize drawable_extent;
+    BOOL source_compatible, create_failed;
+    NSString *last_diagnostic;
+    ember_fg_dl_metadata metadata;
+    CGColorSpaceRef metadata_color;
+    CGFloat backing_scale;
+    double screen_refresh[4]; // Main-thread capability snapshot; same-display mode changes rearm.
+    BOOL probe_pending, retired, poll_pending, needs_probe, logged_drain, host_hidden;
+    BOOL arming_barrier_recorded, metadata_paused, metadata_rearming;
+    unsigned arming_superseded;
+    double arming_started;
+    double meter_started, meter_latency_sum;
+    uint64_t meter_inputs, meter_presented, meter_latency_count;
+    NSWindow *observed_window; /* identity only; never messaged off main */
+}
+- (id)initWithLayer:(CAMetalLayer *)real;
+- (void)trackLegacy:(id<MTLCommandBuffer>)cb;
+- (void)trackLegacyPresentation:(id<MTLCommandBuffer>)cb drawable:(id<CAMetalDrawable>)drawable;
+- (id<CAMetalDrawable>)takeLegacyDrawable;
+- (EmberFGProxyAcquire *)beginProxyAcquisition:(void *)proxy;
+- (void)endProxyAcquisition:(EmberFGProxyAcquire *)ticket drawable:(BOOL)drawable;
+- (BOOL)allowLegacyPresent;
+- (void)logOwnership;
+- (BOOL)consume:(id<MTLCommandBuffer>)cb texture:(id<MTLTexture>)texture
+          time:(double)now legacyIdle:(BOOL)idle;
+- (void)revoke;
+- (void)revokeReason:(const char *)reason;
+- (void)metadataChanged;
+- (BOOL)mayMutate;
+- (void)hostHidden:(BOOL)hidden;
+- (void)retire;
+@end
+
+/* Every NSWindow/NSView access in this search is on the main thread. There is
+ * deliberately no mainScreen fallback: an unrelated display must not arm us. */
+static BOOL fg_link_view_contains(NSView *view, CALayer *target) {
+    for (CALayer *l = target; l; l = l.superlayer) if (l == view.layer) return YES;
+    for (NSView *child in view.subviews) if (fg_link_view_contains(child, target)) return YES;
+    return NO;
+}
+
+@implementation EmberDisplayLinkAdapter
+- (id)initWithLayer:(CAMetalLayer *)real {
+    if ((self = [super init])) {
+        acquisition_queue = dispatch_queue_create("ember.fg.legacy.acquire", DISPATCH_QUEUE_SERIAL);
+        layer = [real retain]; layer.allowsNextDrawableTimeout = YES;
+        surface.size = sizeof(surface); surface.epoch = 1;
+        state = EMBER_FG_DL_LEGACY; needs_probe = YES;
+        fprintf(stderr, "ember-d3dm-link: adapter created layer=%p; legacy pending main-thread/source probe\n", layer);
+        dispatch_async(dispatch_get_main_queue(), ^{ [self probe]; });
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        for (NSString *name in @[NSWindowDidResizeNotification, NSWindowDidMoveNotification,
+              NSWindowDidChangeScreenNotification, NSWindowDidChangeBackingPropertiesNotification,
+              NSWindowDidChangeOcclusionStateNotification, NSWindowDidMiniaturizeNotification,
+              NSWindowDidDeminiaturizeNotification, NSWindowDidEnterFullScreenNotification,
+              NSWindowDidExitFullScreenNotification, NSWindowWillCloseNotification,
+              NSApplicationDidChangeScreenParametersNotification,
+              NSApplicationDidHideNotification, NSApplicationDidUnhideNotification])
+            [nc addObserver:self selector:@selector(windowChanged:) name:name object:nil];
+        objc_setAssociatedObject(layer, &fg_link_adapter_key, self, OBJC_ASSOCIATION_RETAIN);
+    }
+    return self;
+}
+- (void)dealloc {
+    /* retire's asynchronous self-retains must outlive every outstanding callback. */
+    NSCAssert(!service, @"display link freed before drain");
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+    if (metadata_color) CGColorSpaceRelease(metadata_color);
+    [prefetched release]; [proxy_acquisitions release]; dispatch_release(acquisition_queue);
+    [last_diagnostic release]; [layer release]; [device release]; [super dealloc];
+}
+- (void)scheduleProxyWatchdog {
+    if (proxy_watchdog_pending || !proxy_acquisitions.count) return;
+    proxy_watchdog_pending = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC),
+                   dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        @synchronized (self) {
+            proxy_watchdog_pending = NO;
+            double now = CACurrentMediaTime();
+            for (EmberFGProxyAcquire *t in proxy_acquisitions) {
+                if (now - t->begin < .25 || (t->logged && now - t->logged < 1.0)) continue;
+                if (!t->logged) ++proxy_stalls;
+                t->logged = now;
+                fprintf(stderr, "ember-d3dm-link: proxy nextDrawable pending seq=%llu wait_ms=%.3f proxy=%p real=%p main=%d owner_begin=%u owner_now=%u epoch_begin=%llu epoch_now=%llu active=%lu; inherited CAMetalLayer acquisition has not returned\n",
+                    (unsigned long long)t->sequence, (now - t->begin) * 1000,
+                    t->proxy, layer, t->main_thread, t->owner, state,
+                    (unsigned long long)t->epoch, (unsigned long long)surface.epoch,
+                    (unsigned long)proxy_acquisitions.count);
+            }
+            [self scheduleProxyWatchdog];
+        }
+    });
+}
+- (EmberFGProxyAcquire *)beginProxyAcquisition:(void *)proxy {
+    @synchronized (self) {
+        EmberFGProxyAcquire *t = [[[EmberFGProxyAcquire alloc] init] autorelease];
+        t->sequence = ++proxy_sequence; t->epoch = surface.epoch; t->owner = state;
+        t->proxy = proxy; t->main_thread = [NSThread isMainThread]; t->begin = CACurrentMediaTime();
+        t->trace = proxy_sequence == 1 || proxy_last_owner != state;
+        proxy_last_owner = state;
+        if (!proxy_acquisitions) proxy_acquisitions = [NSMutableArray new];
+        [proxy_acquisitions addObject:t];
+        if (t->trace)
+            fprintf(stderr, "ember-d3dm-link: proxy nextDrawable begin seq=%llu proxy=%p real=%p main=%d owner=%u epoch=%llu active=%lu\n",
+                (unsigned long long)t->sequence, proxy, layer, t->main_thread, state,
+                (unsigned long long)t->epoch, (unsigned long)proxy_acquisitions.count);
+        [self scheduleProxyWatchdog];
+        return t;
+    }
+}
+- (void)endProxyAcquisition:(EmberFGProxyAcquire *)t drawable:(BOOL)drawable {
+    @synchronized (self) {
+        if (!t || ![proxy_acquisitions containsObject:t]) return;
+        double elapsed = CACurrentMediaTime() - t->begin;
+        ++proxy_returns;
+        if (t->trace || t->logged || elapsed >= .25)
+            fprintf(stderr, "ember-d3dm-link: proxy nextDrawable end seq=%llu wait_ms=%.3f drawable=%d owner_begin=%u owner_now=%u epoch_begin=%llu epoch_now=%llu\n",
+                (unsigned long long)t->sequence, elapsed * 1000, drawable, t->owner, state,
+                (unsigned long long)t->epoch, (unsigned long long)surface.epoch);
+        [proxy_acquisitions removeObjectIdenticalTo:t];
+    }
+}
+/* The slot is bounded to one drawable and one request. No caller waits on CA.
+ * ARMING drops the held slot and waits for any already-started acquisition before
+ * claiming the real layer. A timed-out request is never cancelled by pretending
+ * it returned: acquisition_busy stays set until the actual worker returns. */
+- (id<CAMetalDrawable>)takeLegacyDrawable {
+    @synchronized (self) {
+        if (state != EMBER_FG_DL_LEGACY) return nil;
+        id<CAMetalDrawable> result = [prefetched autorelease]; prefetched = nil;
+        if (!acquisition_busy) {
+            acquisition_busy = YES;
+            const uint64_t generation = ++acquisition_generation;
+            const uint64_t epoch = surface.epoch;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC),
+                           dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+                @synchronized (self) {
+                    if (acquisition_busy && generation == acquisition_generation) {
+                        ++acquisition_timeouts;
+                        fprintf(stderr, "ember-d3dm-link: legacy acquisition watchdog timeout=500ms worker=dedicated pending=1; retire and wait for real return\n");
+                        [self retire];
+                    }
+                }
+            });
+            dispatch_async(acquisition_queue, ^{ @autoreleasepool {
+                /* Nothing that waits on nextDrawable holds the adapter lock. */
+                const double begin = CACurrentMediaTime();
+                id<CAMetalDrawable> d;
+                @autoreleasepool { d = [[layer nextDrawable] retain]; }
+                /* Drain CA's autorelease before publishing idle; only this
+                 * explicit retain remains, transferred to the slot or released. */
+                @synchronized (self) {
+                    if (state == EMBER_FG_DL_LEGACY && epoch == surface.epoch) prefetched = d;
+                    else [d release];
+                    acquisition_busy = NO;
+                    if (CACurrentMediaTime() - begin >= .5)
+                        fprintf(stderr, "ember-d3dm-link: legacy acquisition returned wait_ms=%.3f main=%d state=%u\n",
+                            (CACurrentMediaTime() - begin) * 1000, [NSThread isMainThread], state);
+                    [self logOwnership];
+                }
+            }});
+        }
+        return result;
+    }
+}
+- (BOOL)allowLegacyPresent {
+    /* Caller holds this monitor through the actual present API call. */
+    ++legacy_attempts;
+    if (state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_DRAINING) {
+        ++legacy_blocked; [self logOwnership]; return NO;
+    }
+    ++legacy_allowed;
+    if (state == EMBER_FG_DL_LINK_OWNS) ++legacy_while_link;
+    return YES;
+}
+- (void)logOwnership {
+    double now = CACurrentMediaTime();
+    if (ownership_logged && now - ownership_logged < 5.0) return;
+    ownership_logged = now;
+    fprintf(stderr, "ember-d3dm-link: ownership legacy_attempts=%llu legacy_allowed=%llu legacy_blocked=%llu legacy_present_while_link=%llu acquisition_busy=%d held=%d acquisition_timeouts=%llu state=%u\n",
+        (unsigned long long)legacy_attempts, (unsigned long long)legacy_allowed,
+        (unsigned long long)legacy_blocked, (unsigned long long)legacy_while_link,
+        acquisition_busy, prefetched != nil, (unsigned long long)acquisition_timeouts, state);
+}
+- (void)flushFeedback {
+    ember_fg_dl_feedback f = { .size = sizeof(f) };
+    for (unsigned n = 0; service && n < 128 && fg_link_api.feedback(service, &f); ++n) {
+        ++feedback_count;
+        if (f.presented_ns > 0 && f.media_ns > 0 && f.presented_ns >= f.media_ns) {
+            meter_latency_sum += (double)(f.presented_ns - f.media_ns) / 1e6;
+            ++meter_latency_count;
+        }
+        const char *log = getenv("EMBER_FG_LOG");
+        if (log && !strcmp(log, "1"))
+            fprintf(stderr, "ember-d3dm-link: feedback lease=%llu epoch=%llu seq=%llu flags=%u "
+                    "media=%lld ready=%lld target=%lld submit=%lld gpu=%lld presented=%lld\n",
+                    (unsigned long long)f.lease, (unsigned long long)f.epoch,
+                    (unsigned long long)f.sequence, f.flags, (long long)f.media_ns,
+                    (long long)f.ready_ns, (long long)f.target_ns, (long long)f.submit_ns,
+                    (long long)f.gpu_ns, (long long)f.presented_ns);
+        f.size = sizeof(f);
+    }
+}
+- (void)logMeasurement {
+    /* Frame Check consumes this existing prefix. Meter observes callbacks/status
+     * only: it neither draws a HUD nor changes the display-link ownership gate. */
+    if (state != EMBER_FG_DL_LINK_OWNS) {
+        meter_started = 0; meter_inputs = meter_latency_count = 0; meter_latency_sum = 0; return;
+    }
+    ember_fg_dl_status s = { .size = sizeof(s) };
+    if (!fg_link_api.status(service, &s)) return;
+    double now = CACurrentMediaTime();
+    if (!meter_started) { meter_started = now; meter_presented = s.presented; meter_inputs = 0; return; }
+    double elapsed = now - meter_started;
+    if (elapsed < 5.0) return;
+    char latency[64] = "";
+    if (meter_latency_count) snprintf(latency, sizeof(latency), " lat=%.2fms", meter_latency_sum / meter_latency_count);
+    fprintf(stderr, "ember-d3dm-fg: in=%.1f/s out=%.1f/s active=1 path=display-link presented=%llu%s layer=%p\n",
+        meter_inputs / elapsed, (s.presented - meter_presented) / elapsed,
+        (unsigned long long)(s.presented - meter_presented), latency, layer);
+    meter_started = now; meter_presented = s.presented; meter_inputs = meter_latency_count = 0; meter_latency_sum = 0;
+}
+- (void)updateIdle:(BOOL)idle {
+    CGColorSpaceRef cs = layer.colorspace;
+    BOOL edr = layer.wantsExtendedDynamicRangeContent;
+    const ember_fg_dl_metadata old_metadata = metadata;
+    BOOL changed = ember_fg_dl_metadata_observe(&metadata, (uintptr_t)cs, edr);
+    if (cs) CGColorSpaceRetain(cs);
+    if (metadata_color) CGColorSpaceRelease(metadata_color);
+    metadata_color = cs;
+    if (changed) {
+        ++surface.epoch;
+        if (surface.flags) {
+            surface.flags &= ~EMBER_FG_DL_SDR;
+            if (ember_fg_dl_layer_sdr(layer.pixelFormat, edr, cs)) surface.flags |= EMBER_FG_DL_SDR;
+        }
+        metadata_rearming = service && (state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_ARMING);
+        // Existing legacy callbacks remain in the barrier. A metadata-only rearm
+        // never needs a new legacy present; the service also drains its readers.
+        arming_barrier_recorded = metadata_rearming;
+        arming_superseded = 0; arming_started = CACurrentMediaTime();
+        fprintf(stderr, "ember-d3dm-link: host metadata epoch=%llu reason=%s%s colorspace=%p->%p edr=%d->%d; rearm\n",
+            (unsigned long long)surface.epoch, old_metadata.color != (uintptr_t)cs ? "colorspace " : "",
+            old_metadata.edr != edr ? "edr" : "", (void *)old_metadata.color, cs, old_metadata.edr, edr);
+    }
+    if (!service) { state = EMBER_FG_DL_LEGACY; return; }
+    ember_fg_dl_surface s = surface;
+    if (state != EMBER_FG_DL_LEGACY && prefetched) { [prefetched release]; prefetched = nil; }
+    if (idle && !legacy_gpu && !acquisition_busy && !prefetched && state == EMBER_FG_DL_ARMING && arming_barrier_recorded)
+        s.flags |= EMBER_FG_DL_LEGACY_IDLE;
+    uint32_t old = state;
+    state = fg_link_api.update(service, &s);
+    if (old != EMBER_FG_DL_ARMING && state == EMBER_FG_DL_ARMING) {
+        arming_barrier_recorded = metadata_rearming; arming_superseded = 0;
+        arming_started = CACurrentMediaTime();
+    }
+    if (state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_LEGACY) metadata_rearming = NO;
+    [self flushFeedback];
+    [self logMeasurement];
+    [self logOwnership];
+    if (old != state) fprintf(stderr, "ember-d3dm-link: state=%u->%u epoch=%llu legacy_gpu=%llu\n",
+        old, state, (unsigned long long)s.epoch, (unsigned long long)legacy_gpu);
+}
+- (void)schedulePoll {
+    if (poll_pending) return;
+    poll_pending = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 16 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        @synchronized (self) {
+            poll_pending = NO;
+            if (!retired && service) [self probe];
+            [self updateIdle:NO];
+            if (retired && service) {
+                [self flushFeedback];
+                if (fg_link_api.destroy(service)) {
+                    service = NULL; state = EMBER_FG_DL_LEGACY;
+                    objc_setAssociatedObject(layer, &fg_link_adapter_key, nil, OBJC_ASSOCIATION_RETAIN);
+                    fprintf(stderr, "ember-d3dm-link: drained accepted=%llu feedback=%llu\n",
+                        (unsigned long long)lease_accepted, (unsigned long long)feedback_count);
+                } else if (!logged_drain) {
+                    logged_drain = YES;
+                    fprintf(stderr, "ember-d3dm-link: destroy pending; retaining service/layer/device until drain\n");
+                }
+            }
+            if (state == EMBER_FG_DL_DRAINING || (retired && service) ||
+                (service && (state == EMBER_FG_DL_LINK_OWNS || state == EMBER_FG_DL_ARMING) &&
+                 (!(surface.flags & EMBER_FG_DL_SDR) ||
+                  !ember_fg_dl_layer_sdr(layer.pixelFormat, layer.wantsExtendedDynamicRangeContent, layer.colorspace))))
+                [self schedulePoll];
+        }
+    });
+}
+- (void)metadataChanged {
+    @synchronized (self) {
+        /* Real-layer metadata can change outside proxy setters (D3DMetal HDR).
+         * Observe it synchronously before any further source admission. */
+        [self updateIdle:NO];
+        if (!probe_pending && !retired) {
+            probe_pending = YES;
+            dispatch_async(dispatch_get_main_queue(), ^{ [self probe]; });
+        }
+    }
+}
+- (void)revoke { [self revokeReason:"explicit/surface-setter"]; }
+- (void)revokeReason:(const char *)reason {
+    @synchronized (self) {
+        fprintf(stderr, "ember-d3dm-link: host revoke reason=%s epoch=%llu->%llu flags=0x%x->0 state=%u\n",
+            reason, (unsigned long long)surface.epoch, (unsigned long long)(surface.epoch + 1), surface.flags, state);
+        ++surface.epoch; surface.flags = 0; needs_probe = YES;
+        metadata_rearming = NO;
+        [self updateIdle:NO];
+        if (state == EMBER_FG_DL_DRAINING) [self schedulePoll];
+    }
+}
+- (BOOL)mayMutate {
+    @synchronized (self) {
+        [self updateIdle:NO];
+        if (acquisition_busy) return NO;
+        [prefetched release]; prefetched = nil;
+        return state != EMBER_FG_DL_LINK_OWNS && state != EMBER_FG_DL_DRAINING;
+    }
+}
+- (void)hostHidden:(BOOL)hidden {
+    @synchronized (self) {
+        if (host_hidden == hidden) return;
+        host_hidden = hidden; [self revokeReason:"host-hidden"];
+    }
+}
+- (void)windowChanged:(NSNotification *)note {
+    /* Notification delivery can originate outside main; never inspect it there. */
+    if (![NSThread isMainThread]) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self windowChanged:note]; }); return;
+    }
+    @synchronized (self) {
+        if (retired) return;
+        if ([note.object isKindOfClass:[NSWindow class]] && observed_window && note.object != observed_window) return;
+        // Notifications alone do not invalidate leases; probe compares the
+        // actual geometry/visibility. Closing still performs an explicit drain.
+        if ([note.name isEqualToString:NSWindowWillCloseNotification] && observed_window == note.object) {
+            [self retire]; return;
+        }
+        [self probe];
+    }
+}
+- (void)probe {
+    NSCAssert([NSThread isMainThread], @"AppKit access must be main-thread");
+    @synchronized (self) {
+        probe_pending = NO;
+        if (retired) return;
+        NSWindow *window = nil;
+        id delegate = layer.delegate;
+        if ([delegate isKindOfClass:[NSView class]]) window = [(NSView *)delegate window];
+        if (!window) for (NSWindow *candidate in [NSApp windows])
+            if (fg_link_view_contains(candidate.contentView, layer)) { window = candidate; break; }
+        NSScreen *screen = window.screen;
+        uint32_t display = [[screen.deviceDescription objectForKey:@"NSScreenNumber"] unsignedIntValue];
+        double refresh[4] = {0};
+        if (@available(macOS 12.0, *)) {
+            refresh[0] = screen.maximumFramesPerSecond;
+            refresh[1] = screen.minimumRefreshInterval;
+            refresh[2] = screen.maximumRefreshInterval;
+            refresh[3] = screen.displayUpdateGranularity;
+        }
+        BOOL refresh_changed = NO;
+        for (unsigned i = 0; i < 4; ++i) refresh_changed |= refresh[i] != screen_refresh[i];
+        NSRect wf = window ? window.frame : NSZeroRect, sf = screen ? screen.frame : NSZeroRect;
+        BOOL native_fullscreen = window && (window.styleMask & NSWindowStyleMaskFullScreen);
+        /* AppKit frames are points, never compare these to source/drawable pixels.
+         * Wine can create a titled screen-sized window without native fullscreen. */
+        BOOL fullscreen = window && screen && ember_fg_dl_covers_screen(native_fullscreen,
+            (ember_fg_dl_rect){wf.origin.x, wf.origin.y, wf.size.width, wf.size.height},
+            (ember_fg_dl_rect){sf.origin.x, sf.origin.y, sf.size.width, sf.size.height});
+        BOOL visible = window && window.visible && !window.miniaturized &&
+            (window.occlusionState & NSWindowOcclusionStateVisible) && !NSApp.hidden && !layer.hidden && !host_hidden &&
+            display && CGDisplayIsActive(display) && CGDisplayIsOnline(display);
+        CGColorSpaceRef cs = layer.colorspace;
+        BOOL extended = NO, itu2100 = NO;
+        if (@available(macOS 11.0, *)) {
+            extended = cs && CGColorSpaceUsesExtendedRange(cs);
+            itu2100 = cs && CGColorSpaceUsesITUR_2100TF(cs);
+        }
+        BOOL sdr = ember_fg_dl_layer_sdr(layer.pixelFormat, layer.wantsExtendedDynamicRangeContent, cs);
+        uint32_t flags = (fullscreen ? EMBER_FG_DL_FULLSCREEN : 0) |
+            (visible ? EMBER_FG_DL_VISIBLE : 0) | (sdr ? EMBER_FG_DL_SDR : 0);
+        CGSize extent = layer.drawableSize;
+        BOOL extent_valid = ember_fg_dl_output_extent_valid(source_width, source_height,
+            (uint32_t)extent.width, (uint32_t)extent.height, source_format, fg_link_output8());
+        if (!source_compatible || !extent_valid) flags = 0;
+        NSMutableArray *reasons = [NSMutableArray array];
+        if (!window || !screen) [reasons addObject:@"window/screen-missing"];
+        if (!fullscreen) [reasons addObject:@"window-does-not-cover-screen"];
+        if (!visible) [reasons addObject:@"not-visible"];
+        if (!sdr) [reasons addObject:@"format/colorspace-not-sdr"];
+        if (!source_width || !source_height) [reasons addObject:@"source-pending"];
+        else if (!source_compatible) [reasons addObject:@"source-format/device/sample-incompatible"];
+        if (source_width && source_height && !ember_fg_dl_source_fits(source_width, source_height, source_format, fg_link_output8()))
+            [reasons addObject:@"source-memory-cap"];
+        if (!extent.width || !extent.height) [reasons addObject:@"drawable-empty"];
+        NSString *color_name = cs ? (NSString *)CGColorSpaceCopyName(cs) : nil;
+        NSString *diagnostic = [NSString stringWithFormat:
+            @"eligible=%d reason=%@ native_fullscreen=%d fullscreen=%d window_pt=(%.3f,%.3f %.3fx%.3f) "
+             "screen_pt=(%.3f,%.3f %.3fx%.3f) drawable_px=%.0fx%.0f source_px=%ux%u "
+             "layerOpaque=%d windowOpaque=%d displaySync=%d transaction=%d direct_display=unverified "
+             "contentsScale=%.3f backingScale=%.3f source_bytes=%llu cap_bytes=%llu "
+             "pixelFormat=%lu sourceFormat=%lu colorspace=%@/%p sdr=%d edr=%d extended=%d itu2100=%d "
+             "visible=%d windowVisible=%d occluded=%d miniaturized=%d appHidden=%d layerHidden=%d hostHidden=%d display=%u online=%d active=%d",
+            flags == (EMBER_FG_DL_FULLSCREEN | EMBER_FG_DL_VISIBLE | EMBER_FG_DL_SDR),
+            reasons.count ? [reasons componentsJoinedByString:@","] : @"eligible", native_fullscreen, fullscreen,
+            wf.origin.x, wf.origin.y, wf.size.width, wf.size.height,
+            sf.origin.x, sf.origin.y, sf.size.width, sf.size.height,
+            extent.width, extent.height, source_width, source_height,
+            layer.opaque, window.opaque, layer.displaySyncEnabled, layer.presentsWithTransaction,
+            layer.contentsScale, window.backingScaleFactor,
+            (unsigned long long)ember_fg_dl_source_bytes(source_width, source_height, source_format, fg_link_output8()), 768ull * 1024 * 1024,
+            (unsigned long)layer.pixelFormat, (unsigned long)source_format, color_name ?: @"unspecified", cs, sdr,
+            layer.wantsExtendedDynamicRangeContent, extended, itu2100,
+            visible, window.visible, !(window.occlusionState & NSWindowOcclusionStateVisible), window.miniaturized,
+            NSApp.hidden, layer.hidden, host_hidden, display,
