+/* A cancelled job retires its pending cell immediately, but its snapshots and
+ * borrowed proxy live until producer GPU completion. Register that handler in
+ * the present hook, BEFORE the caller commits (never add one after commit). */
+@interface EmberFGSerialJob : NSObject {
+@public
+    EmberFGSerial *owner;
+    EmberFGLayer *layer;
+    id<MTLTexture> current, previous;
+    id<MTLEvent> ready, previous_ready;
+    id<CAMetalDrawable> borrowed;
+    int slot, prev_slot;
+    BOOL producer_done, cancelled, retired;
+    uint64_t sequence;
+}
+- (void)producerCompleted;
+- (void)cancel;
+- (void)finish;
+@end
+@implementation EmberFGSerialJob
+- (void)finishLocked {
+    if (retired) return;
+    retired = YES;
+    if (slot >= 0) efp_unref(&owner->state, slot);
+    if (prev_slot >= 0) efp_unref(&owner->state, prev_slot);
+    efp_complete(&owner->state);
+    if (owner->state.lifecycle != EFP_ACTIVE && !owner->state.inflight) fg_serial_cleanup(owner);
+    dispatch_semaphore_signal(owner->released);
+}
+- (void)producerCompleted {
+    pthread_mutex_lock(&owner->lock);
+    producer_done = YES;
+    if (cancelled) [self finishLocked];
+    pthread_mutex_unlock(&owner->lock);
+}
+- (void)finish {
+    pthread_mutex_lock(&owner->lock); [self finishLocked]; pthread_mutex_unlock(&owner->lock);
+}
+- (void)cancel {
+    pthread_mutex_lock(&owner->lock);
+    if (efp_cancel(&owner->state, sequence)) {
+        cancelled = YES;
+        if (producer_done) [self finishLocked];
+        fprintf(stderr, "ember-fg-presenter: lifecycle_cancel=%llu reason=%u sequence=%llu gpu_retired=%d\n",
+                (unsigned long long)owner->state.lifecycle_cancel, owner->state.lifecycle,
+                (unsigned long long)sequence, (int)retired);
+    }
+    pthread_mutex_unlock(&owner->lock);
+}
+- (void)dealloc {
+    [current release]; [previous release]; [ready release]; [previous_ready release];
+    [borrowed release]; [owner release]; [layer release]; [super dealloc];
+}
+@end
+static void fg_serial_unpending(EmberFGLayer *p) {
+    pthread_mutex_lock(&fg_stat_lock);
+    if (!--p->outstanding) p->transport_start = 0;
+    pthread_mutex_unlock(&fg_stat_lock);
+}
+/* The old direct route remains unchanged during warmup and when off. Entry also
+ * requires the legacy queue/presented callbacks to be empty, without draining it. */
+static void fg_serial_observe(EmberFGLayer *p, id<MTLCommandBuffer> cb, double now) {
+    fg_serial_gate(p);
+    if (!p->serial && fg_serial_requested() && p->fge_ctx && !p->fge_cfg.smooth &&
+        !fg_meter() && fg_present_mode() == 1 && !p->neural && !p->ahdr && !ember_up_enabled() &&
+        p->real.allowsNextDrawableTimeout) {
+        p->serial = [[EmberFGSerial alloc] initWithDevice:cb.device];
+        fg_serial_bind_surface(p, p->serial);
+        fprintf(stderr, "ember-fg-presenter: requested=1 observing (2s/120 presents); lifecycle cancellation enabled\n");
+    }
+    EmberFGSerial *s = p->serial;
+    if (!s || fg_serial_ended(s)) return;
+    pthread_mutex_lock(&s->lock);
+    if (cb.device != s->device) efp_fault(&s->state, EFP_RESOURCE);
+    int committed = !s->last_producer || s->last_producer.status >= MTLCommandBufferStatusCommitted;
+    efp_observe(&s->state, (uint64_t)(uintptr_t)cb.commandQueue, (uint64_t)(uintptr_t)cb,
+                committed, fge_ns(now), s->surface_bound && !fg_transport_pending(p) && !p->pending && cb.device == s->device);
+    [s->last_producer release]; s->last_producer = [cb retain];
+    pthread_mutex_unlock(&s->lock);
+    fg_serial_log(s, now);
+}
+static BOOL fg_serial_previous(EmberFGLayer *p) {
+    EmberFGSerial *s = p->serial; BOOL valid;
+    if (!s) return NO;
+    pthread_mutex_lock(&s->lock);
+    valid = s->state.enabled && !s->state.stopped && s->previous >= 0;
+    pthread_mutex_unlock(&s->lock); return valid;
+}
+static BOOL fg_serial_owns(EmberFGLayer *p) {
+    EmberFGSerial *s = p->serial; BOOL owns;
+    if (!s) return NO;
+    pthread_mutex_lock(&s->lock); owns = efp_owns_originals(&s->state); pthread_mutex_unlock(&s->lock);
+    return owns;
+}
