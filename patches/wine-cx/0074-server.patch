From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 74/74] server: Ember changes

Base: CrossOver 26.3.0 FOSS source, sources/wine (crossover-sources-26.3.0.tar.gz)
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/server/main.c b/server/main.c
index 19127ce..565ae6f 100644
--- a/server/main.c
+++ b/server/main.c
@@ -26,6 +26,7 @@
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <sys/time.h>
 #include <unistd.h>
 #ifdef HAVE_SYS_RESOURCE_H
@@ -35,6 +36,16 @@
 # include <sys/sysctl.h>
 #endif
 
+#ifdef __APPLE__
+#include <errno.h>
+#include <mach/mach_init.h>
+#include <mach/thread_act.h>
+#include <mach/mach_port.h>
+#include <mach/thread_policy.h>
+#include <mach/thread_info.h>
+#include <mach/policy.h>
