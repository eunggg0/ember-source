From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 93/95] programs-wineboot: Ember changes

Base: CrossOver 26.3.0 FOSS sources/wine
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index 5e702a5..f4f13f2 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -66,6 +66,7 @@
 #include <windows.h>
 #include <ws2tcpip.h>
 #include <winternl.h>
+#include <winsvc.h>
 #include <ddk/wdm.h>
 #include <sddl.h>
 #include <wine/svcctl.h>
@@ -1424,6 +1425,75 @@ static int ProcessWindowsFileProtection(void)
     return 1;
 }
 
+static void start_stub_process(const WCHAR *path)
+{
+    PROCESS_INFORMATION pi;
+    STARTUPINFOW si = { sizeof(si) };
+
+    if (!CreateProcessW(path, NULL, NULL, NULL, FALSE, DETACHED_PROCESS, NULL, NULL, &si, &pi))
+    {
+        WINE_ERR("Couldn't start %s: error %lu\n", wine_dbgstr_w(path), GetLastError());
+        return;
+    }
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+}
+
+/* Service-start helper adapted from Wine secur32/lsa.c, LGPL-2.1-or-later.
+ * Copyright 2004 Juan Lang; 2007 Kai Blin; 2017, 2018 Dmitry Timoshkov.
+ * Source snapshot: 7b3fff76fa5178f6ce0141b2c776afa2a822f101.
+ */
+static BOOL start_samss_service(void)
+{
+    SERVICE_STATUS_PROCESS status = {0};
+    SC_HANDLE scm, service;
+    BOOL ret = FALSE;
+
+    WINE_TRACE("\n");
+
+    if (!(scm = OpenSCManagerW(NULL, NULL, 0)))
+    {
+        WINE_ERR("Failed to open service manager\n");
+        return FALSE;
+    }
+
+    if (!(service = OpenServiceW(scm, L"SamSs", SERVICE_START | SERVICE_QUERY_STATUS)))
+    {
+        WINE_ERR("Failed to open SamSs service\n");
+        CloseServiceHandle( scm );
+        return FALSE;
+    }
+
+    if (StartServiceW(service, 0, NULL) || GetLastError() == ERROR_SERVICE_ALREADY_RUNNING)
+    {
+        ULONGLONG start_time = GetTickCount64();
+        do
+        {
+            DWORD dummy;
+
+            if (!QueryServiceStatusEx(service, SC_STATUS_PROCESS_INFO, (BYTE *)&status, sizeof(status), &dummy))
+                break;
+            if (status.dwCurrentState == SERVICE_RUNNING)
+            {
+                ret = TRUE;
+                break;
+            }
+            if (GetTickCount64() - start_time > 30000) break;
+            Sleep( 100 );
+
+        } while (status.dwCurrentState == SERVICE_START_PENDING);
+
+        if (status.dwCurrentState != SERVICE_RUNNING)
+            WINE_WARN("SamSs failed to start %lu\n", status.dwCurrentState);
+    }
+    else
+        WINE_ERR("Failed to start SamSs service\n");
+
+    CloseServiceHandle(service);
+    CloseServiceHandle(scm);
+    return ret;
+}
+
 static BOOL start_services_process(void)
 {
     static const WCHAR svcctl_started_event[] = SVCCTL_STARTED_EVENT;
@@ -1960,9 +2030,11 @@ int __cdecl main( int argc, char *argv[] )
     {
         ProcessRunKeys( HKEY_LOCAL_MACHINE, L"RunServices", FALSE, FALSE );
         start_services_process();
+        start_stub_process( L"C:\\windows\\system32\\csrss.exe" );
     }
 
     if (init || update) update_wineprefix( update );
+    if (init || (kill && !restart)) start_samss_service();
 
     create_volatile_environment_registry_key();
     create_known_dlls();
