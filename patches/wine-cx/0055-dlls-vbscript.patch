+        if(FAILED(hres))
+            return hres;
+        if(firstday < 0 || firstday > 7)
+            return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
+    }
+
+    if(args_cnt >= 4)
+    {
+        if(V_VT(args + 3) == VT_NULL)
+            return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
