+    TRACE("\n");
+
+    assert(args_cnt >= 2 && args_cnt <= 4);
+
+    if(V_VT(args) == VT_NULL)
+        return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
+
+    if(args_cnt >= 3)
+    {
+        if(V_VT(args + 2) == VT_NULL)
+            return MAKE_VBSERROR(VBSE_ILLEGAL_NULL_USE);
