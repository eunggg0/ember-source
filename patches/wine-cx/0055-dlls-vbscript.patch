+        if (!(member = script_disp_add_member(disp, str)))
+            return NULL;
+    }
+
+    member->type = SCRIPTDISP_HOSTPROP;
+    member->u.host.disp = disp_obj;
+    member->u.host.id = id;
+    return member;
