+static BOOL lookup_func_decls(compile_ctx_t *ctx, const WCHAR *name)
+{
+    function_decl_t *func_decl;
+
+    for(func_decl = ctx->func_decls; func_decl; func_decl = func_decl->next) {
+        if(!vbs_wcsicmp(func_decl->name, name))
+            return TRUE;
+    }
+
+    return FALSE;
