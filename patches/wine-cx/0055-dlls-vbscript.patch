+    else if(!wcsicmp(interval, L"m"))
+        result = ud.st.wMonth;
+    else if(!wcsicmp(interval, L"y"))
+        result = ud.wDayOfYear;
+    else if(!wcsicmp(interval, L"d"))
+        result = ud.st.wDay;
+    else if(!wcsicmp(interval, L"w"))
+        result = 1 + (ud.st.wDayOfWeek - firstday + 7) % 7;
