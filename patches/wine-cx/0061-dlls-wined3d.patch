         context_vk->compute.vk_pipeline = program->vk_pipeline;
         context_vk->compute.vk_set_layout = program->vk_set_layout;
         context_vk->compute.vk_pipeline_layout = program->vk_pipeline_layout;
+        return;
     }
-    else
