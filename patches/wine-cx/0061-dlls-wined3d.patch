From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 61/74] dlls-wined3d: Ember changes

Base: CrossOver 26.3.0 FOSS source, sources/wine (crossover-sources-26.3.0.tar.gz)
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/dlls/wined3d/adapter_vk.c b/dlls/wined3d/adapter_vk.c
index 665f9a7..510994c 100644
--- a/dlls/wined3d/adapter_vk.c
+++ b/dlls/wined3d/adapter_vk.c
@@ -508,6 +508,7 @@ static void adapter_vk_get_wined3d_caps(const struct wined3d_adapter *adapter, s
     const VkPhysicalDeviceLimits *limits = &adapter_vk->device_limits;
     bool sampler_anisotropy = limits->maxSamplerAnisotropy > 1.0f;
     const struct wined3d_vk_info *vk_info = &adapter_vk->vk_info;
+    VkFormatProperties properties;
 
     caps->ddraw_caps.dds_caps |= WINEDDSCAPS_BACKBUFFER
             | WINEDDSCAPS_COMPLEX
@@ -600,6 +601,10 @@ static void adapter_vk_get_wined3d_caps(const struct wined3d_adapter *adapter, s
             | WINED3DSTENCILCAPS_TWOSIDED;
 
     caps->DeclTypes |= WINED3DDTCAPS_FLOAT16_2 | WINED3DDTCAPS_FLOAT16_4;
+    VK_CALL(vkGetPhysicalDeviceFormatProperties(adapter_vk->physical_device,
+            VK_FORMAT_R8G8B8A8_USCALED, &properties));
+    if (!(properties.bufferFeatures & VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT))
+        caps->DeclTypes &= ~WINED3DDTCAPS_UBYTE4;
 
     caps->MaxPixelShader30InstructionSlots = WINED3DMAX30SHADERINSTRUCTIONS;
     caps->MaxVertexShader30InstructionSlots = WINED3DMAX30SHADERINSTRUCTIONS;
diff --git a/dlls/wined3d/context_vk.c b/dlls/wined3d/context_vk.c
index 540a88a..a856557 100644
--- a/dlls/wined3d/context_vk.c
+++ b/dlls/wined3d/context_vk.c
@@ -2685,6 +2685,29 @@ static VkFormat vk_format_from_component_type(enum wined3d_component_type compon
     return VK_FORMAT_UNDEFINED;
 }
 
+static VkFormat vk_vertex_format_from_wined3d(const struct wined3d_format *format,
+        const struct wined3d_shader *vertex_shader)
+{
+    /* SM1-3 and fixed-function vertex inputs convert unnormalized integers
+     * to floats. SM4+ inputs retain the declaration's integer type. */
+    if (!vertex_shader || vertex_shader->reg_maps.shader_version.major < 4)
+    {
+        switch (format->id)
+        {
+            case WINED3DFMT_R8G8B8A8_UINT:
+                return VK_FORMAT_R8G8B8A8_USCALED;
+            case WINED3DFMT_R16G16_SINT:
+                return VK_FORMAT_R16G16_SSCALED;
+            case WINED3DFMT_R16G16B16A16_SINT:
+                return VK_FORMAT_R16G16B16A16_SSCALED;
+            default:
+                break;
+        }
+    }
+
+    return wined3d_format_vk(format)->vk_format;
+}
+
 static bool wined3d_context_vk_update_graphics_pipeline_key(struct wined3d_context_vk *context_vk,
         const struct wined3d_state *state, VkPipelineLayout vk_pipeline_layout, uint32_t *null_buffer_binding)
 {
@@ -2728,6 +2751,7 @@ static bool wined3d_context_vk_update_graphics_pipeline_key(struct wined3d_conte
         VkVertexInputAttributeDescription *a;
         VkVertexInputBindingDescription *b;
 
+        vertex_shader = state->shader[WINED3D_SHADER_TYPE_VERTEX];
         wined3d_stream_info_from_declaration(&stream_info, state, d3d_info);
         divisor_count = 0;
         for (i = 0, mask = 0, attribute_count = 0, binding_count = 0; i < ARRAY_SIZE(stream_info.elements); ++i)
@@ -2745,7 +2769,7 @@ static bool wined3d_context_vk_update_graphics_pipeline_key(struct wined3d_conte
 
             a->location = i;
             a->binding = binding;
-            a->format = wined3d_format_vk(e->format)->vk_format;
+            a->format = vk_vertex_format_from_wined3d(e->format, vertex_shader);
             a->offset = (UINT_PTR)e->data.addr - state->streams[binding].offset;
 
             if (mask & (1u << binding))
@@ -2765,7 +2789,6 @@ static bool wined3d_context_vk_update_graphics_pipeline_key(struct wined3d_conte
             }
         }
 
-        vertex_shader = state->shader[WINED3D_SHADER_TYPE_VERTEX];
         if (vertex_shader && (mask = ~stream_info.use_map & vertex_shader->reg_maps.input_registers))
         {
             struct wined3d_shader_signature_element *element;
@@ -3748,6 +3771,26 @@ static VkPipeline wined3d_context_vk_get_graphics_pipeline(struct wined3d_contex
     if ((entry = wine_rb_get(&context_vk->graphics_pipelines, key)))
         return WINE_RB_ENTRY_VALUE(entry, struct wined3d_graphics_pipeline_vk, entry)->vk_pipeline;
 
+    /* Scaled formats are optional. Check new pipelines before handing an
+     * unsupported vertex format to the driver; cached pipelines are valid. */
+    for (unsigned int i = 0; i < key->input_desc.vertexAttributeDescriptionCount; ++i)
+    {
+        VkFormat format = key->attributes[i].format;
+        VkFormatProperties properties;
+
+        if (format != VK_FORMAT_R8G8B8A8_USCALED && format != VK_FORMAT_R16G16_SSCALED
+                && format != VK_FORMAT_R16G16B16A16_SSCALED)
+            continue;
+
+        VK_CALL(vkGetPhysicalDeviceFormatProperties(wined3d_adapter_vk(device_vk->d.adapter)->physical_device,
+                format, &properties));
+        if (!(properties.bufferFeatures & VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT))
+        {
+            ERR("Scaled vertex format %u is not supported.\n", format);
+            return VK_NULL_HANDLE;
+        }
+    }
+
     if (!(pipeline_vk = malloc(sizeof(*pipeline_vk))))
         return VK_NULL_HANDLE;
     pipeline_vk->key = *key;
diff --git a/dlls/wined3d/shader_spirv.c b/dlls/wined3d/shader_spirv.c
