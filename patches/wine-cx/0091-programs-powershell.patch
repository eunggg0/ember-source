From: Ember <ember@users.noreply.github.com>
Subject: [PATCH 91/95] programs-powershell: Ember changes

Base: CrossOver 26.3.0 FOSS sources/wine
License: same as the upstream file (LGPL-2.1-or-later for Wine/DXMT; see LICENSES/)
---
diff --git a/programs/powershell/main.c b/programs/powershell/main.c
index 25a4d13..ef3203c 100644
--- a/programs/powershell/main.c
+++ b/programs/powershell/main.c
@@ -23,6 +23,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(powershell);
 int __cdecl wmain(int argc, WCHAR *argv[])
 {
     int i;
+    WCHAR enabled[2];
 
     WINE_FIXME("stub.\n");
     for (i = 0; i < argc; i++)
@@ -44,5 +45,14 @@ int __cdecl wmain(int argc, WCHAR *argv[])
             }
         }
     }
+
+    /* HACK: Netmarble Launcher installer uses powershell to check if it's already running */
+    if (GetEnvironmentVariableW( L"EMBER_WINE_NETMARBLE_POWERSHELL", enabled, ARRAY_SIZE(enabled) ) == 1 &&
+        enabled[0] == '1' && argc > 2 && wcsstr(argv[2], L"Netmarble Launcher"))
+    {
+        WINE_FIXME("HACK: returning 1 for Netmarble Launcher.\n");
+        return 1;
+    }
+
     return 0;
 }
