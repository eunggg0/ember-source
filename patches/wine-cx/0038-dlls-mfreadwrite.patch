+/* Ember: 앱이 SetCurrentMediaType 뒤에 변환 출력 속성으로 공유를 요청하면 할당기를 그 설정으로 다시 만든다. */
+static void media_stream_update_allocator_sharing(struct source_reader *reader, struct media_stream *stream)
+{
+    IMFAttributes *attributes = NULL;
+    UINT32 mask;
+
+    if (!stream->allocator || stream->allocator_shared)
+        return;
+    if (!(mask = media_stream_get_shared_mask(reader, stream)))
+        return;
+
+    TRACE("stream %u: transform asked for shared textures (%#x), reinitializing allocator.\n", stream->index, mask);
+    IMFVideoSampleAllocatorEx_UninitializeSampleAllocator(stream->allocator);
+    if (SUCCEEDED(source_reader_create_sample_allocator_attributes(reader, stream, &attributes)))
+    {
+        if (FAILED(IMFVideoSampleAllocatorEx_InitializeSampleAllocatorEx(stream->allocator, 2, 8, attributes, stream->current)))
+            WARN("Failed to reinitialize sample allocator.\n");
+        IMFAttributes_Release(attributes);
+    }
+}
