+    mask = media_stream_get_shared_mask(reader, stream);
+    if (stream) stream->allocator_shared = mask;
+    shared = !!(mask & 1);
+    shared_without_mutex = !!(mask & 2);
 
     if (shared_without_mutex)
         hr = IMFAttributes_SetUINT32(*attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, TRUE);
