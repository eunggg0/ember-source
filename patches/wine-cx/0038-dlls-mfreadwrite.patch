+/* Ember: 공유 텍스처 요청은 리더 속성뿐 아니라 변환(디코더·영상 처리기)의 출력 스트림 속성으로도 온다.
+ * 유니티 WindowsVideoMedia 는 SetCurrentMediaType 뒤 IMFSourceReaderEx::GetTransformForStream 으로 변환을 받아
+ * GetOutputStreamAttributes 에 MF_SA_D3D11_SHARED_WITHOUT_MUTEX 를 건다. 윈도우 리더는 변환의 표본을 그대로 넘겨서
+ * 그 텍스처가 공유 가능하지만, Wine 리더는 자기 할당기 표본으로 복사하므로 그 요청을 여기서도 따라야 한다.
+ * 안 그러면 IDXGIResource::GetSharedHandle 이 NULL 이라 발헤임 인트로·메뉴가 검은 화면이었다(DXMT, 2026-10-02). */
+static UINT32 media_stream_get_shared_mask(const struct source_reader *reader, struct media_stream *stream)
+{
+    UINT32 shared = 0, shared_without_mutex = 0, value, mask = 0;
+    struct transform_entry *entry;
+    IMFAttributes *attributes;
+
+    if (reader->attributes)
+    {
+        IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED, &shared);
+        IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &shared_without_mutex);
+    }
+    if (shared) mask |= 1;
+    if (shared_without_mutex) mask |= 2;
+
+    if (stream)
+    {
+        LIST_FOR_EACH_ENTRY(entry, &stream->transforms, struct transform_entry, entry)
+        {
+            if (!entry->transform || FAILED(IMFTransform_GetOutputStreamAttributes(entry->transform, 0, &attributes)))
+                continue;
+            if (SUCCEEDED(IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED, &value)) && value) mask |= 1;
+            if (SUCCEEDED(IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &value)) && value) mask |= 2;
+            IMFAttributes_Release(attributes);
+        }
+    }
+    return mask;
+}
