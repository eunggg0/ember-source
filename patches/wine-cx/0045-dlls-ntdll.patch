+ *   EMBER_LS_HELPER  도우미 경로(시험용, 없으면 런타임 bin/ember-lsopen). */
+static const char *ember_ls_helper(void)
+{
+    static char *path;
+    static int checked;
+    const char *v = getenv( "EMBER_HOST_LS" );
+    struct stat st;
+
+    if (v && !strcmp( v, "0" )) return NULL;
+    if (!checked)
+    {
+        const char *over = getenv( "EMBER_LS_HELPER" );  /* 시험용: 도우미 경로를 직접 준다 */
+        checked = 1;
+        if (over && over[0] == '/') path = strdup( over );
+        else if (bin_dir && (path = malloc( strlen( bin_dir ) + sizeof("/ember-lsopen") )))
+        {
+            strcpy( path, bin_dir );
+            strcat( path, "/ember-lsopen" );
+        }
+        if (path && (stat( path, &st ) || !S_ISREG( st.st_mode ) || !(st.st_mode & S_IXUSR))) { free( path ); path = NULL; }
+    }
+    return path;
