+++ b/dlls/ntdll/thread.c
@@ -691,6 +691,14 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
 
     if (flags & 1)
     {
+        /* Ember: 콜백은 fls_section 을 놓고 부른다. 콜백(CRT _freefls 등)이 로더 잠금을 잡는 동안, 다른 스레드가
+         * 로더 잠금을 쥔 채(DllMain THREAD_ATTACH) FlsSetValue 로 fls_section 을 기다리면 교착이다.
+         * 실측(2026-09-24, 로아 FEX): fls_section 을 쥔 스레드 하나에 4개가 60초 넘게 막히고 loader_section 까지
+         * 얽혀 게임이 종료됐다. 먼저 잠금 안에서 (콜백, 인자) 쌍을 모으고 목록에서 뺀 뒤, 잠금 밖에서 호출한다. */
+        struct fls_call { PFLS_CALLBACK_FUNCTION callback; void *arg; };
+        struct fls_call stack_calls[64], *calls = stack_calls;
+        unsigned int ncalls = 0, cap = ARRAY_SIZE(stack_calls);
+
         lock_fls_data();
         for (i = 0; i < ARRAY_SIZE(fls->fls_data_chunks); ++i)
         {
@@ -701,24 +709,36 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
             for (index = 0; index < fls_chunk_size( i ); ++index)
             {
                 PFLS_CALLBACK_FUNCTION callback = fls_data.fls_callback_chunks[i]->callbacks[index].callback;
+                void *arg = fls->fls_data_chunks[i][index + 1];
 
-                if (!fls->fls_data_chunks[i][index + 1])
-                    continue;
-
-                if (callback && callback != (void *)~(ULONG_PTR)0)
+                if (!arg) continue;
+                fls->fls_data_chunks[i][index + 1] = NULL;
+                if (!callback || callback == (void *)~(ULONG_PTR)0) continue;
+                if (ncalls == cap)
                 {
-                    TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback,
-                            fls->fls_data_chunks[i][index + 1]);
-
-                    callback( fls->fls_data_chunks[i][index + 1] );
+                    struct fls_call *grown = RtlAllocateHeap( GetProcessHeap(), 0, cap * 2 * sizeof(*calls) );
+                    if (!grown) continue;
+                    memcpy( grown, calls, ncalls * sizeof(*calls) );
+                    if (calls != stack_calls) RtlFreeHeap( GetProcessHeap(), 0, calls );
+                    calls = grown;
+                    cap *= 2;
                 }
-                fls->fls_data_chunks[i][index + 1] = NULL;
+                calls[ncalls].callback = callback;
+                calls[ncalls].arg = arg;
+                ncalls++;
             }
         }
         /* Not using RemoveEntryList() as Windows does not zero list entry here. */
         fls->fls_list_entry.Flink->Blink = fls->fls_list_entry.Blink;
         fls->fls_list_entry.Blink->Flink = fls->fls_list_entry.Flink;
         unlock_fls_data();
+
+        for (i = 0; i < ncalls; ++i)
+        {
+            TRACE_(relay)("Calling FLS callback %p, arg %p.\n", calls[i].callback, calls[i].arg);
+            calls[i].callback( calls[i].arg );
+        }
+        if (calls != stack_calls) RtlFreeHeap( GetProcessHeap(), 0, calls );
     }
 
     if (flags & 2)
