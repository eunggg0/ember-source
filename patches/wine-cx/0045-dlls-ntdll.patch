+/* Ember: ember-lsopen 이 LaunchServices 로 띄운 호스트 쪽. EMBER_LS_HANDOFF 소켓에 붙어 Wine 자식이 갖고 있던
+ * cwd·환경·fd(번호 그대로 — WINESERVERSOCKET 포함)를 받아 그 자리를 이어받는다. 실패하면 바로 끝낸다(도우미가 예전 경로로 다시 띄움). */
+static int ember_ls_read( int s, void *buf, size_t n )
+{
+    char *p = buf;
+    while (n)
+    {
+        ssize_t r = read( s, p, n );
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) return 0;
+        p += r; n -= r;
+    }
+    return 1;
+}
+
+static char *ember_ls_read_str( int s )
+{
+    uint32_t n;
+    char *str;
+    if (!ember_ls_read( s, &n, 4 ) || n > (1u << 20) || !(str = malloc( n + 1 ))) return NULL;
+    if (!ember_ls_read( s, str, n )) { free( str ); return NULL; }
+    str[n] = 0;
+    return str;
+}
