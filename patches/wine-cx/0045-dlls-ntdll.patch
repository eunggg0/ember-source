+                                   "EMBER_AUTOHDR", "EMBER_AUTOHDR_STRENGTH", "EMBER_AUTOHDR_PEAK", "EMBER_AUTOHDR_GAMMA",
+                                   "EMBER_AUTOHDR_LOG",
+                                   /* (fexcompat1 10-08) 앱이 규칙 파일(.ember-exe-env)에 적는 값 중 윈도우 쪽(DXMT PE·kernelbase)이 읽는 나머지 —
+                                    * 보간 세부(박자·가드·링·VRR·MC·최소 fps…)·DXMT 박자(EMBER_D11_PACE)·CEF 인자(kernelbase 가 자식 CEF 에 붙임) */
+                                   "EMBER_D11_PACE", "EMBER_VSYNC_TRACE", "EMBER_FG_CADENCE", "EMBER_FG_DUMP", "EMBER_FG_DUMP_AT",
+                                   "EMBER_FG_DUMP_COUNT", "EMBER_FG_GUARD_MODE", "EMBER_FG_MAX_COST", "EMBER_FG_MC", "EMBER_FG_MC_MIN_FPS",
