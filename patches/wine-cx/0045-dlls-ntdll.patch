+    else path_name = (WCHAR *)search_path;
 
     RtlEnterCriticalSection( &loader_section );
 
@@ -4089,10 +4120,11 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrLoadDll(LPCWSTR path_name, DWORD flags,
             wm = NULL;
         }
     }
-    *hModule = (wm) ? wm->ldr.DllBase : NULL;
