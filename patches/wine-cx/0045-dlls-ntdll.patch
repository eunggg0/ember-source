+static int ember_ls_raise_nofile( rlim_t need )
+{
+    struct rlimit rl;
+
+    if (getrlimit( RLIMIT_NOFILE, &rl )) return 0;
+    if (rl.rlim_cur == RLIM_INFINITY || rl.rlim_cur >= need) return 1;
+    set_max_limit( RLIMIT_NOFILE );
+    if (getrlimit( RLIMIT_NOFILE, &rl )) return 0;
+    if (rl.rlim_cur == RLIM_INFINITY || rl.rlim_cur >= need) return 1;
+    /* set_max_limit 이 못 올렸으면 필요한 만큼만 시도 */
+    if (rl.rlim_max != RLIM_INFINITY && rl.rlim_max < need) return 0;
+    rl.rlim_cur = need;
+    return !setrlimit( RLIMIT_NOFILE, &rl );
+}
