+/* Ember: 게임 호스트로 가지 않는 프로세스(런처·도구)를 실행 도우미 번들의 주 실행파일로 exec 한다.
+ * macOS 는 번들 주 실행파일이 아닌 GUI 프로세스를 부모 앱의 정체로 등록한다 — Ember 가 띄운 스팀은 번들 ID 가
+ * dev.eung.ember 가 되고, Ember 가 꺼진 동안 사용자가 Ember 를 열면 새로 뜨지 않고 그 Wine 프로세스가 앞으로 왔다
+ * (2026-09-30 실측, lsappinfo). 첫 프로세스가 도우미 번들이면 자식도 그 정체를 따른다.
+ *   EMBER_WINE_LOADER  도우미 실행파일 절대 경로(옆에 ntdll.so 심볼릭 링크). 없으면 예전 그대로. */
+static const char *ember_wine_loader(void)
+{
+    const char *p = getenv( "EMBER_WINE_LOADER" );
+    struct stat st;
+
+    if (!p || p[0] != '/') return NULL;
+    if (stat( p, &st ) || !S_ISREG( st.st_mode ) || !(st.st_mode & S_IXUSR)) return NULL;
+    if (!ember_loader_has_ntdll( p )) return NULL;
+    return p;
+}
