+void ember_ls_report_exit( int code )
+{
+    if (ember_ls_status_fd >= 0)
+    {
+        ssize_t r = write( ember_ls_status_fd, &code, sizeof(code) );
+        (void)r;
+        close( ember_ls_status_fd );
+        ember_ls_status_fd = -1;
+    }
+}
