+ *   EMBER_HOST_LOADER  호스트 실행파일 절대 경로
+ *   EMBER_HOST_ROUTE   "1" 이면 이 프로세스를 호스트로 보낸다. 자식은 spawn_process 가
+ *                      ImagePathName 을 EMBER_HOST_EXE 목록과 비교해 매번 다시 정한다. */
+/* Ember: 호스트·도우미 번들 로더는 옆의 ntdll.so 심볼릭 링크로 런타임을 연다. 링크가 끊겼으면(앱 위치·구조가 바뀐 뒤
+ * 옛 규칙 파일이 가리키는 번들 — 2026-10-02 EmberCLI.app 구조 변경 뒤 Data/Apps 번들 30개가 끊김) exec 는 성공해도
+ * 로더가 ntdll 을 못 열고 죽어 CreateProcess 가 실패했다(스팀: OS Error 731). 그런 번들은 건너뛰고 일반 로더로 간다. */
+static int ember_loader_has_ntdll( const char *loader )
+{
+    char buf[1024];
+    const char *slash = strrchr( loader, '/' );
+    struct stat st;
+    size_t len;
+
+    if (!slash) return 0;
+    len = slash - loader + 1;
+    if (len + sizeof("ntdll.so") > sizeof(buf)) return 0;
+    memcpy( buf, loader, len );
+    memcpy( buf + len, "ntdll.so", sizeof("ntdll.so") );
+    if (stat( buf, &st ) || !S_ISREG( st.st_mode )) return 0;
+    /* 링크가 살아 있어도 다른 런타임의 ntdll 이면 안 된다. 게임 번들(Data/Apps/<게임>.app)은 엔진과 상관없이 게임 이름 하나라,
+     * 로제타로 띄우면 x86_64 CX 로더로 다시 만들어지고 FEX 보틀의 옛 규칙이 그 번들을 가리킨다 → 이미 떠 있는 FEX 스팀이
+     * 게임을 띄우면 다른 아키텍처 로더가 떠서 실패했다(2026-10-02 발헤임, 스팀 OS Error 731). 지금 ntdll 과 같은 것만 쓴다.
+     * fork 뒤라 malloc 하지 않는 realpath(버퍼 지정)만 쓴다. */
+    if (ntdll_dir)
+    {
+        char real[PATH_MAX];
+        size_t n = strlen( ntdll_dir );
+
+        if (!realpath( buf, real )) return 0;
+        if (strncmp( real, ntdll_dir, n ) || real[n] != '/' || strcmp( real + n + 1, "ntdll.so" )) return 0;
+    }
+    return 1;
+}
+
+static const char *ember_host_loader(void)
+{
+    const char *host = getenv( "EMBER_HOST_LOADER" ), *route = getenv( "EMBER_HOST_ROUTE" );
+    struct stat st;
+
+    if (!host || host[0] != '/' || !route || strcmp( route, "1" )) return NULL;
+    if (stat( host, &st ) || !S_ISREG( st.st_mode ) || !(st.st_mode & S_IXUSR)) return NULL;
+    if (!ember_loader_has_ntdll( host )) return NULL;
+    return host;
+}
