+{
+    char key[64]; const char *v = getenv( name );
+    snprintf( key, sizeof(key), "%s_GAME", name );
+    if (v && !getenv( key )) setenv( key, v, 1 );
+    if (plain) setenv( name, plain, 1 ); else unsetenv( name );
+}
+
+static void ember_unstash_env( const char *name )
+{
+    char key[64]; const char *v;
+    snprintf( key, sizeof(key), "%s_GAME", name );
+    if ((v = getenv( key ))) { setenv( name, v, 1 ); unsetenv( key ); }
