+++ b/dlls/ntdll/threadpool.c
@@ -3068,6 +3068,27 @@ VOID WINAPI TpSetTimer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LO
        tp_object_submit( this, FALSE );
 }
 
+/***********************************************************************
+ *           TpSetTimerEx    (NTDLL.@)
+ *
+ * Ember: 11.18 에서(윈도우 8+ SetThreadpoolTimerEx 가 부른다). 이전에 설정돼 있었는지 돌려준다.
+ */
+BOOL WINAPI TpSetTimerEx( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LONG window_length )
+{
+    struct threadpool_object *this = impl_from_TP_TIMER( timer );
+    BOOL was_timer_set;
+
+    TRACE( "%p %p %lu %lu\n", timer, timeout, period, window_length );
+
+    /* timerqueue.cs 는 재진입 가능 — 읽기와 설정을 한 번에 */
+    RtlEnterCriticalSection( &timerqueue.cs );
+    was_timer_set = this->u.timer.timer_set;
+    TpSetTimer( timer, timeout, period, window_length );
+    RtlLeaveCriticalSection( &timerqueue.cs );
+
+    return was_timer_set;
+}
+
 /***********************************************************************
  *           TpSetWait    (NTDLL.@)
  */
diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 105a6cf..90a0f03 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -29,6 +29,9 @@
 #include <string.h>
 #include <limits.h>
 #include <time.h>
+#if (defined(__x86_64__) || defined(__i386__)) && !defined(__arm64ec__)
+#include <intrin.h>
+#endif
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -380,8 +383,133 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
 /******************************************************************************
  *  RtlQueryPerformanceCounter   [NTDLL.@]
  */
+/* Ember perfpush2: QueryPerformanceCounter 를 시스템 호출 없이 읽는다.
+ * Wine 은 매번 NtQueryPerformanceCounter(유닉스 쪽 mach_continuous_time)를 불러 로제타 58ns·FEX 21ns 가 들었다(timeGetTime 도 이 길).
+ *  - x86_64(로제타, CPUID 상표 "VirtualApple"): rdtsc 가 1GHz(mach 시계, 7ns) → rdtsc/100 + 치우침.
+ *  - ARM64/ARM64EC: cntvct_el0(24MHz, mach 시계의 바탕) → ×10⁷/cntfrq + 치우침.
+ * 치우침 = 유닉스 단조 시계 − 하드웨어 시계. 처음에 한 번 재고, user_shared_data->InterruptTime(서버가 16ms 마다 같은 단조 시계로 씀)보다
+ * 50ms 넘게 뒤지면(맥이 잠들었다 깨 연속 시계만 앞서 간 것) 다시 잰다 — 치우침은 늘기만 해서 값이 뒤로 가지 않는다.
+ * 처음 잴 때 두 번 맞춰 봐서 1us 넘게 어긋나면 옛 길(시스템 호출). EMBER_QPC=0 이면 옛 길. */
+#if defined(__x86_64__) || defined(__i386__) || defined(__aarch64__) || defined(__arm64ec__)
+static LONGLONG ember_qpc_bias;
+static int ember_qpc_mode;            /* 0 = 아직, 1 = 하드웨어 시계, -1 = 시스템 호출 */
+#if defined(__aarch64__) || defined(__arm64ec__)
+static ULONGLONG ember_qpc_freq, ember_qpc_mul;   /* 틱 = (cntvct × mul) >> 64, mul = 10⁷·2⁶⁴ / cntfrq */
+#endif
+
+static inline ULONGLONG ember_qpc_raw(void)
+{
+#if defined(__aarch64__) || defined(__arm64ec__)
+    ULONGLONG c;
+    __asm__ __volatile__( "isb" ::: "memory" );   /* 앞선 읽기보다 먼저 시계를 읽지 않게(스레드 간 단조성) */
+    c = __builtin_arm_rsr64( "cntvct_el0" );
+    return (ULONGLONG)(((unsigned __int128)c * ember_qpc_mul) >> 64);
+#else
+    return __rdtsc() / 100;
+#endif
+}
+
+static inline ULONGLONG ember_qpc_interrupt_time(void)
+{
+    ULONG high, low;
+    do
+    {
+        high = user_shared_data->InterruptTime.High1Time;
+        low = user_shared_data->InterruptTime.LowPart;
+    }
+    while (high != user_shared_data->InterruptTime.High2Time);
+    return (ULONGLONG)high << 32 | low;
+}
+
+static void ember_qpc_resync(void)
+{
+    LARGE_INTEGER c;
+    LONGLONG bias;
+    NtQueryPerformanceCounter( &c, NULL );
+    bias = c.QuadPart - (LONGLONG)ember_qpc_raw();
+    if (bias > ember_qpc_bias) ember_qpc_bias = bias;    /* 늘기만(뒤로 가지 않게) */
+}
+
+static void ember_qpc_init(void)
+{
+    int mode = -1;
+    WCHAR buf[4];
+    SIZE_T len = 0;
+
+    if (!RtlQueryEnvironmentVariable( NULL, L"EMBER_QPC", 9, buf, ARRAY_SIZE(buf), &len ) && len && buf[0] == '0')
+        mode = -1;
+    else
+    {
+#if defined(__aarch64__) || defined(__arm64ec__)
+        ember_qpc_freq = __builtin_arm_rsr64( "cntfrq_el0" );
+        if (ember_qpc_freq >= 1000000 && ember_qpc_freq > TICKSPERSEC)
+        {
+            ember_qpc_mul = (ULONGLONG)(((unsigned __int128)TICKSPERSEC << 64) / ember_qpc_freq);
+            mode = 1;
+        }
+#else
+        int regs[4];
+        char brand[49];
+        unsigned int i;
+        __cpuid( regs, 0x80000000 );
+        if ((unsigned int)regs[0] >= 0x80000004)
+        {
+            for (i = 0; i < 3; i++) __cpuid( (int *)(brand + 16 * i), 0x80000002 + i );
+            brand[48] = 0;
+            if (strstr( brand, "VirtualApple" )) mode = 1;
+        }
+#endif
+        if (mode > 0)
+        {
+            LARGE_INTEGER c;
+            LONGLONG d;
+            int k, ok = 0;
+            ember_qpc_bias = LLONG_MIN;
+            for (k = 0; k < 3; k++) ember_qpc_resync();   /* 사이에 선점되면 치우침이 작게 나온다 → 최댓값 */
+            {
+                /* 반올림 위상이 시스템 호출판과 달라 1틱 뒤지는 일이 있다(32비트 로제타에서 잦음) → 뒤진 만큼(최대 1us) 올린다 */
+                LONGLONG deficit = 0;
+                for (k = 0; k < 16; k++)
+                {
+                    NtQueryPerformanceCounter( &c, NULL );
+                    d = c.QuadPart - ((LONGLONG)ember_qpc_raw() + ember_qpc_bias);
+                    if (d > deficit) deficit = d;
+                }
+#if defined(__aarch64__) || defined(__arm64ec__)
+                /* 24MHz→100ns 양자화 경계가 유닉스 쪽(×125/3÷100)과 어긋나 드물게(0.1%) 1틱 뒤진다 — 한 틱 앞당겨 둔다(뒤쪽 여유는 늘 1틱 있음) */
+                if (!deficit) deficit = 1;
+#endif
+                if (deficit <= 10) ember_qpc_bias += deficit;
+            }
+            for (k = 0; k < 4 && !ok; k++)                 /* 맞는지 확인(한 번이라도 1us 안이면 통과) */
+            {
+                NtQueryPerformanceCounter( &c, NULL );
+                d = (LONGLONG)ember_qpc_raw() + ember_qpc_bias - c.QuadPart;
+                if (d <= 10 && d >= -10) ok = 1;
+            }
+            if (!ok) mode = -1;
+        }
+    }
+    ember_qpc_mode = mode;
+}
+#endif
+
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(__x86_64__) || defined(__i386__) || defined(__aarch64__) || defined(__arm64ec__)
+    if (__builtin_expect( !ember_qpc_mode, 0 )) ember_qpc_init();
+    if (ember_qpc_mode > 0)
+    {
+        LONGLONG v = (LONGLONG)ember_qpc_raw() + ember_qpc_bias;
+        if (__builtin_expect( v + 500000 < (LONGLONG)ember_qpc_interrupt_time(), 0 ))
+        {
+            ember_qpc_resync();
+            v = (LONGLONG)ember_qpc_raw() + ember_qpc_bias;
+        }
+        counter->QuadPart = v;
+        return TRUE;
+    }
+#endif
     NtQueryPerformanceCounter( counter, NULL );
     return TRUE;
 }
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
